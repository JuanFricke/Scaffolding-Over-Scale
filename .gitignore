/benchmark/work/
# per-run artifacts are versioned (patches, grading logs, results, metrics); raw agent
# transcripts stay local (~370 MB)
/benchmark/runs/**/agent.stdout.log
/benchmark/runs/**/agent.stderr.log
/benchmark/runs/**/agent.session.json
# code-quality analysis: reviews, judge manifest and reports are thesis artifacts (workspaces are not)
!/benchmark/runs/quality/
/benchmark/runs/quality/workspaces/
/benchmark/.cache/
/benchmark/runs/pools.json
/benchmark/orchestrator/**/__pycache__/
/benchmark/quality/**/__pycache__/

# LaTeX build artifacts (main.pdf is versioned as the compiled article)
/tcc-artigo-template-latex/*.aux
/tcc-artigo-template-latex/*.bbl
/tcc-artigo-template-latex/*.blg
/tcc-artigo-template-latex/*.brf
/tcc-artigo-template-latex/*.fdb_latexmk
/tcc-artigo-template-latex/*.fls
/tcc-artigo-template-latex/*.lof
/tcc-artigo-template-latex/*.log
/tcc-artigo-template-latex/*.loq
/tcc-artigo-template-latex/*.lot
/tcc-artigo-template-latex/*.out
/tcc-artigo-template-latex/*.synctex.gz
/tcc-artigo-template-latex/*.toc
/tcc-artigo-template-latex/artigo-tcc-fricke-2026.pdf

# local-only files: working prompt, zip exports, manual-edit scratch copy
/docs/prompt-tcc-fable.md
/*.zip
/editado manualmente/

# Python bytecode
__pycache__/
