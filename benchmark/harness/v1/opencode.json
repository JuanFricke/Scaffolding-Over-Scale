{
    "$schema": "https://opencode.ai/config.json",
    "model": "opencode-go/muse-spark-1.3-contributor",
    "small_model": "opencode-go/muse-spark-1.3-contributor",
    "instructions": [
        "AGENTS.md"
    ],
    "lsp": {
        "php intelephense": {
            "command": [
                "intelephense",
                "--stdio"
            ],
            "extensions": [
                ".php",
                ".blade.php"
            ],
            "initialization": {
                "intelephense": {
                    "environment": {
                        "phpVersion": "8.4.0"
                    },
                    "files": {
                        "exclude": [
                            "**/.git/**",
                            "**/node_modules/**",
                            "**/vendor/**/Tests/**",
                            "**/vendor/**/tests/**",
                            "**/storage/**",
                            "**/bootstrap/cache/**"
                        ]
                    },
                    "telemetry": {
                        "enabled": false
                    }
                }
            }
        },
        "laravel-lsp": {
            "command": [
                "laravel-lsp"
            ],
            "extensions": [
                ".php",
                ".blade.php"
            ],
            "initialization": {
                "phpCommand": [
                    "php"
                ]
            }
        }
    }
}
