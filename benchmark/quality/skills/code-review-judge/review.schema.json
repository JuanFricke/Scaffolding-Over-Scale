{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "code-review-judge review",
  "type": "object",
  "additionalProperties": false,
  "required": ["scores", "overall", "confidence", "issues", "summary"],
  "properties": {
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "conventions", "security", "tests", "simplicity", "readability", "scope"],
      "properties": {
        "requirements": {"$ref": "#/$defs/score"},
        "conventions": {"$ref": "#/$defs/score"},
        "security": {"$ref": "#/$defs/score"},
        "tests": {"$ref": "#/$defs/score"},
        "simplicity": {"$ref": "#/$defs/score"},
        "readability": {"$ref": "#/$defs/score"},
        "scope": {"$ref": "#/$defs/score"}
      }
    },
    "overall": {"type": "integer", "minimum": 1, "maximum": 5},
    "confidence": {"enum": ["high", "medium", "low"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "dimension", "location", "explanation"],
        "properties": {
          "severity": {"enum": ["blocker", "major", "minor", "nit"]},
          "dimension": {"enum": ["requirements", "conventions", "security", "tests", "simplicity", "readability", "scope"]},
          "location": {"type": "string"},
          "explanation": {"type": "string"}
        }
      }
    },
    "summary": {"type": "string", "description": "two or three sentences: what the change does and the main reasons for the overall score"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "evidence"],
      "properties": {
        "score": {"type": "integer", "minimum": 1, "maximum": 5},
        "evidence": {"type": "string", "description": "path:line references or short quotes supporting the score"}
      }
    }
  }
}
