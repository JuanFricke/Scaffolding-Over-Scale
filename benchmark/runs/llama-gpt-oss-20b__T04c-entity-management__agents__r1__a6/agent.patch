+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Enums\UserRole;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use Livewire\Component;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Redirect;
+use Illuminate\Support\Facades\DB;
+
+class Settings extends Component
+{
+    public Entity $entity;
+    public string $name = '';
+    public string $slug = '';
+    public ?int $targetMembershipId = null;
+
+    public function mount(Entity $entity)
+    {
+        $this->authorize('manageSettings', $entity);
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save()
+    {
+        $this->validate([
+            'name' => 'required|string',
+            'slug' => 'required|string|unique:entities,slug,' . $this->entity->id . ',id,deleted_at,NULL',
+        ]);
+        $this->entity->update([
+            'name' => $this->name,
+            'slug' => $this->slug,
+        ]);
+        return Redirect::route('entity.dashboard', $this->entity);
+    }
+
+    public function delete()
+    {
+        $this->entity->delete();
+        // delete memberships
+        $this->entity->memberships()->delete();
+        // clear session if current
+        if (session('current_entity_id') === $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+        return Redirect::route('home');
+    }
+
+    public function transfer()
+    {
+        if (!$this->targetMembershipId) {
+            $this->addError('targetMembershipId', __('ui.select_owner'));
+            return;
+        }
+        $target = EntityMembership::findOrFail($this->targetMembershipId);
+        if ($target->entity_id !== $this->entity->id || $target->role !== UserRole::Admin) {
+            $this->addError('targetMembershipId', __('ui.invalid_target'));
+            return;
+        }
+        DB::transaction(function () use ($target) {
+            $currentOwner = $this->entity->owner()->first();
+            $currentOwner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+        });
+        return Redirect::route('entity.dashboard', $this->entity);
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.settings', [
+            'memberships' => $this->entity->memberships()->where('role', UserRole::Admin)->where('user_id', '!=', Auth::id())->get(),
+        ]);
+    }
+}
