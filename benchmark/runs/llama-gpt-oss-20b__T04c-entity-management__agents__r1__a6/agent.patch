@@ -0,0 +1,37 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Enums\UserRole;
+use App\Models\User;
+use Illuminate\Access\HandlesAuthorization;
+
+class EntityMembershipPolicy
+{
+    use HandlesAuthorization;
+
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        $current = $user->membershipFor($membership->entity_id);
+        return $current && in_array($current->role, [UserRole::Owner->value, UserRole::Admin->value])
+            && $membership->role !== UserRole::Owner->value;
+    }
+
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        $current = $user->membershipFor($membership->entity_id);
+        if (!$current) return false;
+        // Owner cannot delete own membership
+        if ($membership->role === UserRole::Owner->value) return false;
+        // If deleting self, allowed
+        if ($membership->user_id === $user->id) return true;
+        // Admin/Owner can delete other non-owner memberships
+        return in_array($current->role, [UserRole::Owner->value, UserRole::Admin->value]);
+    }
+}
