+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Enums\UserRole;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Livewire\Component;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+
+class Members extends Component
+{
+    public Entity $entity;
+    public string $email = '';
+
+    public function mount(Entity $entity)
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+    }
+
+    public function addMember()
+    {
+        $this->validate([
+            'email' => 'required|email|exists:users,email',
+        ]);
+        $user = User::where('email', $this->email)->first();
+        if ($user && $this->entity->membershipFor($user->id)) {
+            $this->addError('email', __('ui.member_already'));
+            return;
+        }
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+        $this->email = '';
+    }
+
+    public function assignRole($membershipId, string $role)
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+        if (!in_array($role, UserRole::manageable())) {
+            $this->addError('role', __('ui.role_invalid'));
+            return;
+        }
+        $this->authorize('assignRole', $membership);
+        $membership->update(['role' => $role]);
+    }
+
+    public function removeMember($membershipId)
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+        $this->authorize('delete', $membership);
+        $membership->delete();
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->get(),
+        ]);
+    }
+}
