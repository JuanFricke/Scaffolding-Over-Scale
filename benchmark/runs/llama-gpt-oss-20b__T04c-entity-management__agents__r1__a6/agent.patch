+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Redirect;
+use Illuminate\Support\Facades\Auth;
+
+class EntityController extends \Illuminate\Foundation\Http\Controller
+{
+    /**
+     * Store the current entity for the authenticated user.
+     */
+    public function pick(Entity $entity, Request $request)
+    {
+        $user = Auth::user();
+        $membership = $user->membershipFor($entity->id);
+        if (!$membership) {
+            return abort(403);
+        }
+        // Set session
+        session(['current_entity_id' => $entity->id]);
+        // Audit log
+        Log::channel('audit')->info('Entity selected', ['user_id' => $user->id, 'entity_id' => $entity->id]);
+        return Redirect::route('entity.dashboard', $entity);
+    }
+}
