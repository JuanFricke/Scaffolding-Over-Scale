+    $normalNew = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subMinutes(5)]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 2, 'issued_at' => now()->subMinutes(1), 'channel' => TicketChannel::Printed]);
