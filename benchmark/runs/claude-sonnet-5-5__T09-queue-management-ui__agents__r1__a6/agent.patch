+function serveEntityAs(string $role = 'owner'): array
+{
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->{$role}()->create();
+
+    test()->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    return [$entity, $user];
+}
+
+function grantCall(Entity $entity, User $user, Queue $queue): void
+{
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $user->membershipFor($entity->id)->id,
+        'queue_id' => $queue->id,
+    ]);
+}
+
+test('any member can open the serve page and the route exists', function () {
