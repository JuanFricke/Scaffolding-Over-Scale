+    Ticket::factory()->forQueue($ownQueue)->create(['code' => 'SECRET2']);
+
+    $id = match ($kind) {
+        'foreign' => $foreign->id,
+        'missing' => 999999,
+        'uncallable' => $ownQueue->id,
+    };
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $id)
+        ->assertDontSee('SECRET1')
+        ->assertDontSee('SECRET2')
+        ->assertSee(__('ui.serve_empty'));
+})->with(['foreign', 'missing', 'uncallable']);
