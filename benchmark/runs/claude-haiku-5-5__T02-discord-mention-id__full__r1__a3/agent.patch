diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
index 6a778a4..040c497 100644
--- a/tests/Feature/DiscordOpsAlertTest.php
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -121,3 +121,85 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends a user mention on its own line when a valid mention id is configured', function (string|int $mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed', ['queue' => 'asaas-webhooks']);
+
+    Http::assertSent(function (Request $request) use ($mentionId) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\nqueue=asaas-webhooks\n<@".trim((string) $mentionId).'>');
+    });
+})->with([
+    '12345678901234567',
+    '12345678901234567890',
+    ' 12345678901234567 ',
+    12345678901234567,
+]);
+
+test('adds no mention when the mention id is unset or not a discord snowflake', function (mixed $mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@')
+        && ($request['content'] ?? '') === "Queue error\nWorker failed");
+})->with([
+    null,
+    '',
+    '   ',
+    '@everyone',
+    '@here',
+    'abc',
+    '123',
+    '1234567890123456',
+    '123456789012345678901',
+    '12345678901234567x',
+    "123\n@everyone",
+    "123> \n@everyone",
+    '<@12345678901234567>',
+    '１２３４５６７８９０１２３４５６７８９',
+    -12345678901234567,
+    true,
+    'array' => [['12345678901234567']],
+]);
+
+test('keeps the mention within the 1800-character limit by truncating the alert body', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '12345678901234567',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return mb_strlen($content) === 1800
+            && str_ends_with($content, "\n<@12345678901234567>")
+            && str_starts_with($content, 'T'."\n".'xxx');
+    });
+});
