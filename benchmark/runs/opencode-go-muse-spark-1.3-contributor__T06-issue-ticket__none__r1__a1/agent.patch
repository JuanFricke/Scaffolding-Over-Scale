diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..844eb7a
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,147 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use LogicException;
+
+class Ticket extends Model
+{
+    use HasFactory;
+
+    protected $fillable = [
+        'queue_id',
+        'code',
+        'priority',
+        'channel',
+        'status',
+        'issued_at',
+        'called_at',
+        'called_by_user_id',
+    ];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        // Allocate the next display code when none was given (e.g. factory).
+        // Runs at save time so sequential creates (including count > 1 with
+        // forQueue) each see the previously inserted ticket.
+        static::creating(function (self $ticket) {
+            if (empty($ticket->code)) {
+                $ticket->code = static::nextCode((int) $ticket->queue_id);
+            }
+        });
+
+        // Write-once guard (defense in depth; Ticket::save() enforces the
+        // same rule even when events are disabled via saveQuietly()).
+        static::updating(function (self $ticket) {
+            static::assertMutableFields($ticket);
+        });
+    }
+
+    /**
+     * @throws LogicException when a write-once field was changed.
+     */
+    protected static function assertMutableFields(self $ticket): void
+    {
+        $dirty = $ticket->getDirty();
+        unset($dirty['updated_at']);
+
+        $allowed = ['status', 'called_at', 'called_by_user_id'];
+
+        foreach (array_keys($dirty) as $field) {
+            if (! in_array($field, $allowed, true)) {
+                throw new LogicException("Ticket field [{$field}] is immutable after issuance.");
+            }
+        }
+    }
+
+    public function save(array $options = [])
+    {
+        if ($this->exists) {
+            static::assertMutableFields($this);
+        }
+
+        return parent::save($options);
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for the queue: last valid code + 1 by insertion
+     * order (A001, A002, ... A999, A1000, ...). Malformed legacy codes
+     * (anything not matching A<digits>) are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = static::where('queue_id', $queueId)->orderBy('id')->pluck('code');
+
+        $last = null;
+
+        foreach ($codes as $code) {
+            if (is_string($code) && preg_match('/\AA(\d+)\z/', $code, $matches) === 1) {
+                $last = (int) $matches[1];
+            }
+        }
+
+        $next = $last === null ? 1 : $last + 1;
+
+        return 'A'.str_pad((string) $next, 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Mark the ticket as called exactly once.
+     *
+     * @throws LogicException when the ticket is not waiting.
+     * @throws AuthorizationException when the user is not a member of the ticket's entity.
+     */
+    public function call(User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Only waiting tickets can be called.');
+        }
+
+        $queue = $this->queue()->firstOrFail();
+
+        $isMember = EntityMembership::where('entity_id', $queue->entity_id)
+            ->where('user_id', $user->getKey())
+            ->exists();
+
+        if (! $isMember) {
+            throw new AuthorizationException('Only members of the ticket\'s entity may call tickets.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->getKey();
+        $this->save();
+    }
+}
