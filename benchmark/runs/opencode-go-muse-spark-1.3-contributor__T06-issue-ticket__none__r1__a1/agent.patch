@@ -0,0 +1,81 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        $attempts = 5;
+
+        for ($attempt = 1; $attempt <= $attempts; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    // Re-read the row inside the transaction (with a lock)
+                    // so a queue deactivated after the caller loaded it is
+                    // still rejected; nothing is persisted on rejection.
+                    $fresh = Queue::whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+                    if (! $fresh->is_active) {
+                        throw new InactiveQueueException('Cannot issue tickets for an inactive queue.');
+                    }
+
+                    $code = Ticket::nextCode($fresh->getKey());
+
+                    return Ticket::create([
+                        'queue_id' => $fresh->getKey(),
+                        'code' => $code,
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (InactiveQueueException $e) {
+                throw $e;
+            } catch (UniqueConstraintViolationException $e) {
+                if ($attempt >= $attempts) {
+                    throw $e;
+                }
+            } catch (QueryException $e) {
+                if (! self::isUniqueViolation($e)) {
+                    throw $e;
+                }
+
+                if ($attempt >= $attempts) {
+                    throw $e;
+                }
+            }
+        }
+
+        // Unreachable: the loop either returns or rethrows.
+        throw new QueryException('', [], new \Exception('Ticket issuance failed after retries.'));
+    }
+
+    protected static function isUniqueViolation(QueryException $e): bool
+    {
+        $message = $e->getMessage();
+
+        return $e->getCode() === '23000'
+            || str_contains($message, 'UNIQUE')
+            || str_contains($message, 'unique')
+            || str_contains($message, 'Duplicate');
+    }
+}
