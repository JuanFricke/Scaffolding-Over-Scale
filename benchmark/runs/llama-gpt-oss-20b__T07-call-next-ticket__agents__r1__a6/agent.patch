+<?php
+
+namespace App\Exceptions;
+
+use RuntimeException;
+
+class NoWaitingTicketsException extends RuntimeException
+{
+    public function __construct(string $message = 'No waiting tickets for the requested mode.')
+    {
+        parent::__construct($message);
+    }
+}
