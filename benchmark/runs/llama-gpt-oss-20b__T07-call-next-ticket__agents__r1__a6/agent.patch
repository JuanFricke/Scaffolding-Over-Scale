+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Exceptions\InactiveQueueException;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * Call the next ticket for a queue following business rules.
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Lock the queue row to read its current state and avoid race conditions
+            $queue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $queue->is_active) {
+                throw new InactiveQueueException('Queue is inactive.');
+            }
+
+            // Determine fairness restriction if mode is Any
+            $restrictedToNormal = false;
+            if ($mode === CallMode::Any) {
+                // Grab last 3 called tickets
+                $lastCalled = Ticket::query()
+                    ->where('queue_id', $queue->id)
+                    ->where('status', TicketStatus::Called) // status enum string? check
+                    ->orderByDesc('called_at')
+                    ->orderByDesc('id')
+                    ->limit(3)
+                    ->get();
+
+                if ($lastCalled->count() === 3 && $lastCalled->every(fn (Ticket $t) => $t->priority > 0)) {
+                    // At least one normal waiting ticket?
+                    $hasNormalWaiting = Ticket::query()
+                        ->where('queue_id', $queue->id)
+                        ->where('status', TicketStatus::Waiting)
+                        ->where('priority', 0)
+                        ->exists();
+
+                    if ($hasNormalWaiting) {
+                        $restrictedToNormal = true;
+                    }
+                }
+            }
+
+            // Build candidate query based on mode and restriction
+            $query = Ticket::query()
+                ->where('queue_id', $queue->id)
+                ->where('status', TicketStatus::Waiting)
+                ->lockForUpdate();
+
+            if ($restrictedToNormal) {
+                $query->where('priority', 0);
+            } else {
+                switch ($mode) {
+                    case CallMode::PriorityOnly:
+                        $query->where('priority', '>', 0);
+                        break;
+                    case CallMode::NormalOnly:
+                        $query->where('priority', 0);
+                        break;
+                    case CallMode::Any:
+                    default:
+                        // full ordering
+                        $query->orderByDesc('priority')
+                            ->orderBy('issued_at')
+                            ->orderBy('id');
+                        break;
+                }
+            }
+
+            // If mode is Any but restriction applied, we need ordering only among normals
+            if ($restrictedToNormal) {
+                $query->orderBy('issued_at')
+                    ->orderBy('id');
+            }
+
+            while (true) {
+                $candidate = $query->first();
+                if (! $candidate) {
+                    throw new NoWaitingTicketsException();
+                }
+                // Recheck status to guard against concurrent calls
+                if ($candidate->status !== TicketStatus::Waiting) {
+                    // Refresh and continue
+                    $candidate->refresh();
+                    continue;
+                }
+
+                // Call the ticket using its method (it has its own transaction)
+                $candidate->call($calledBy);
+
+                return $candidate;
+            }
+        });
+    }
+}
