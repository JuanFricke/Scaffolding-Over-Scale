@@ -0,0 +1,37 @@
+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('the archive channel is daily with 14 day retention', function () {
+    $daily = config('logging.channels.daily');
+
+    expect($daily['driver'])->toBe('daily')
+        ->and($daily['path'])->toEndWith('logs/laravel.log')
+        ->and((int) $daily['days'])->toBe(14);
+});
+
+test('the audit channel writes info and above to audit.log with 90 day retention', function () {
+    $audit = config('logging.channels.audit');
+
+    expect($audit['driver'])->toBe('daily')
+        ->and($audit['path'])->toEndWith('logs/audit.log')
+        ->and($audit['level'])->toBe('info')
+        ->and((int) $audit['days'])->toBe(90);
+});
+
+test('the default stack includes the daily channel', function () {
+    expect(config('logging.channels.stack.channels'))->toContain('daily');
+});
+
+test('there is no discord log channel', function () {
+    expect(config('logging.channels'))->not->toHaveKey('discord');
+});
+
+test('the discord webhook url is read from services config', function () {
+    expect(config('services.discord.webhook_url'))->toBe(env('DISCORD_WEBHOOK_URL'));
+});
+
+test('the audit channel accepts writes', function () {
+    expect(fn () => Log::channel('audit')->info('Subscription status changed', ['subscription_id' => 1]))
+        ->not->toThrow(Throwable::class);
+});
