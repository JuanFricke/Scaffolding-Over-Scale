diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..6a480ca
--- /dev/null
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -0,0 +1,144 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+const DISCORD_WEBHOOK = 'https://discord.com/api/webhooks/1234567890/super-secret-token';
+
+function fakeDiscordWebhook(string $url = DISCORD_WEBHOOK): void
+{
+    config(['services.discord.webhook_url' => $url]);
+}
+
+test('it is resolvable from the container without arguments', function () {
+    expect(app(DiscordOpsAlert::class))->toBeInstanceOf(DiscordOpsAlert::class);
+});
+
+test('it is a silent no-op when the webhook url is not configured', function () {
+    Http::fake();
+
+    foreach ([null, ''] as $url) {
+        config(['services.discord.webhook_url' => $url]);
+        app(DiscordOpsAlert::class)->send('Title', 'Message');
+    }
+
+    Http::assertNothingSent();
+});
+
+it('posts a json content payload with title, message and context lines', function () {
+    fakeDiscordWebhook();
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Payment webhook failing', 'Retries exhausted.', [
+        'entity_id' => 42,
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    Http::assertSent(function ($request) {
+        return $request->url() === DISCORD_WEBHOOK
+            && $request['content'] === "Payment webhook failing\nRetries exhausted.\nentity_id=42\nqueue=asaas-webhooks";
+    });
+});
+
+it('truncates long content to exactly 1800 characters', function () {
+    fakeDiscordWebhook();
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', str_repeat('a', 5000));
+
+    Http::assertSent(function ($request) {
+        return mb_strlen($request['content'], 'UTF-8') === 1800;
+    });
+});
+
+it('truncates multibyte content without splitting characters', function () {
+    fakeDiscordWebhook();
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', str_repeat('é', 5000));
+
+    Http::assertSent(function ($request) {
+        return mb_strlen($request['content'], 'UTF-8') === 1800;
+    });
+});
+
+it('redacts sensitive keys, bearer credentials and nested arrays', function () {
+    fakeDiscordWebhook();
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message', [
+        'password' => 'hunter2',
+        'X-Api-Key' => 'abc123',
+        'userToken' => 'tok_123',
+        'authorization' => 'Bearer should-not-leak',
+        'webhook_url' => 'https://example.com/hook',
+        'note' => 'Authorization: Bearer eyJhbGciOi...',
+        'queue' => 'asaas-webhooks',
+        'meta' => [
+            'secret' => 'shh',
+            'note' => 'Bearer abc.def',
+            'attempts' => 5,
+        ],
+    ]);
+
+    Http::assertSent(function ($request) {
+        $content = $request['content'];
+
+        return str_contains($content, 'password=[redacted]')
+            && str_contains($content, 'X-Api-Key=[redacted]')
+            && str_contains($content, 'userToken=[redacted]')
+            && str_contains($content, 'authorization=[redacted]')
+            && str_contains($content, 'webhook_url=[redacted]')
+            && str_contains($content, 'note=[redacted]')
+            && str_contains($content, 'queue=asaas-webhooks')
+            && str_contains($content, '"secret":"[redacted]"')
+            && str_contains($content, '"note":"[redacted]"')
+            && str_contains($content, '"attempts":5');
+    });
+});
+
+it('logs an error when discord answers with a non-2xx status', function () {
+    fakeDiscordWebhook();
+    Http::fake(['*' => Http::response('', 500)]);
+    Log::spy();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(function ($message, $context) {
+            return str_contains((string) $message, 'Discord ops alert failed')
+                && ($context['status'] ?? null) === 500;
+        });
+});
+
+it('catches transport errors and logs an error without leaking the webhook url', function () {
+    fakeDiscordWebhook();
+    Http::fake(function () {
+        throw new ConnectionException('cURL error 28: Operation timed out after '.DISCORD_WEBHOOK);
+    });
+    Log::spy();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(function ($message, $context) {
+            $logged = (string) $message.' '.json_encode($context);
+
+            return str_contains($logged, 'Discord ops alert failed')
+                && ! str_contains($logged, DISCORD_WEBHOOK)
+                && ! str_contains($logged, 'super-secret-token');
+        });
+});
+
+it('never throws, whatever happens', function () {
+    fakeDiscordWebhook();
+    Http::fake(function () {
+        throw new RuntimeException('boom');
+    });
+
+    expect(fn () => app(DiscordOpsAlert::class)->send('Title', 'Message'))->not->toThrow(Throwable::class);
+});
diff --git a/tests/Feature/LoggingConfigTest.php b/tests/Feature/LoggingConfigTest.php
