@@ -9,12 +9,16 @@ ## [Unreleased]
 
 ### Added
 
+- Discord ops alert notifier [`App\Ops\DiscordOpsAlert`](app/Ops/DiscordOpsAlert.php): explicit `send($title, $message, $context)` calls to a Discord incoming webhook (`DISCORD_WEBHOOK_URL` / `services.discord.webhook_url`), with context redaction, 1800-char truncation and soft-fail error logging (never throws, never leaks the webhook URL). Deliberately **not** a Monolog channel.
+- `audit` log channel (`storage/logs/audit.log`, daily rotation, 90-day retention, info+): durable who-changed-what trail.
+- Observability decision guide (archive / audit / alert lanes) in [`docs/ops/logging-and-alerting.md`](docs/ops/logging-and-alerting.md).
 - Database schema and Mermaid diagram in [`docs/database-schema.md`](docs/database-schema.md).
 - Business rules documentation in [`docs/business-rules.md`](docs/business-rules.md): MVP queue management, entity/subscription, roles (admin, owner, employee), tickets, priorities, fairness (3-ticket rule), deterministic call panel, and channels (Flutter totem, web TV, attendant).
 - This changelog (Keep a Changelog).
 
 ### Changed
 
+- Default logging now goes through the `stack` → `daily` channels (`LOG_STACK=daily`, 14-day retention) instead of `single`.
 - Documented architecture: PegaFilaWeb is a single repository for frontend, backend and totem API; Flutter remains only as a separate client.
 - Simplified model: ticket is single-use (one call; write-once except `called_at`/`called_by`) — removed `ticket_calls` table; ticket knows only its queue (no `totem_id`). `tickets.priority` is now an integer (higher = more prioritized).
 - Expanded financial model: `billing_accounts` (1:0..1 with entity) + `subscriptions` + `plans` isolate financial data. New tables: `payment_options` (cycle, method, discount, refund window) and `payments` (individual charges). `billing_accounts` has `cpf_cnpj`. Subscription 1:1 with `billing_account_id` (UK); history in `payments`. Added `tickets.code`, explicit unique constraints, and circular FK note for owner. Removed per-queue user access limit.
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..f6e6268
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,175 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+/**
+ * Explicit ops alerting to a Discord incoming webhook.
+ *
+ * This is NOT a Monolog channel: calling it is a deliberate decision by the
+ * caller that an incident is worth waking a human up for. Routine logging
+ * belongs on the "daily" (archive) or "audit" channels instead.
+ *
+ * Soft-fail contract: send() never throws and never breaks the caller.
+ */
+class DiscordOpsAlert
+{
+    /**
+     * Discord hard-limits message content at 2000 characters; keep headroom.
+     */
+    private const MAX_CONTENT_LENGTH = 1800;
+
+    private const REDACTED = '[redacted]';
+
+    /**
+     * Fragments matched (case-insensitively) against normalised context keys
+     * (lowercased, with "_" and "-" stripped) to detect sensitive values.
+     */
+    private const SENSITIVE_KEY_FRAGMENTS = [
+        'password',
+        'token',
+        'secret',
+        'authorization',
+        'apikey',
+        'webhook',
+    ];
+
+    /**
+     * Send one alert: a title, a message and an optional context array.
+     *
+     * When services.discord.webhook_url is not configured this is a no-op.
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (! is_string($url) || trim($url) === '') {
+            return;
+        }
+
+        try {
+            $content = mb_substr(
+                $this->buildContent($title, $message, $context),
+                0,
+                self::MAX_CONTENT_LENGTH,
+                'UTF-8'
+            );
+
+            $response = Http::timeout(5)
+                ->asJson()
+                ->post($url, ['content' => $content]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed with HTTP status '.$response->status(), [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (Throwable $e) {
+            $error = $this->scrub($e->getMessage(), $url);
+
+            Log::error('Discord ops alert failed: '.$error, [
+                'error' => $error,
+            ]);
+        }
+    }
+
+    /**
+     * Title, then message, then one "key=value" line per context entry.
+     */
+    private function buildContent(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->renderValue((string) $key, $value);
+        }
+
+        return implode("\n", $lines);
+    }
+
+    private function renderValue(string $key, mixed $value): string
+    {
+        if ($this->looksSensitive($key)) {
+            return self::REDACTED;
+        }
+
+        if (is_array($value)) {
+            return json_encode(
+                $this->redactArray($value),
+                JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE
+            ) ?: self::REDACTED;
+        }
+
+        if (is_string($value)) {
+            return $this->containsBearerToken($value) ? self::REDACTED : $value;
+        }
+
+        if ($value === null) {
+            return '';
+        }
+
+        if (is_bool($value)) {
+            return $value ? 'true' : 'false';
+        }
+
+        if (is_object($value)) {
+            return json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?: self::REDACTED;
+        }
+
+        return (string) $value;
+    }
+
+    /**
+     * Recursively redact nested arrays with the same rules.
+     *
+     * @return array<array-key, mixed>
+     */
+    private function redactArray(array $values): array
+    {
+        $redacted = [];
+
+        foreach ($values as $key => $value) {
+            $key = (string) $key;
+
+            if (is_array($value)) {
+                $redacted[$key] = $this->redactArray($value);
+            } elseif ($this->looksSensitive($key) || (is_string($value) && $this->containsBearerToken($value))) {
+                $redacted[$key] = self::REDACTED;
+            } else {
+                $redacted[$key] = $value;
+            }
+        }
+
+        return $redacted;
+    }
+
+    private function looksSensitive(string $key): bool
+    {
+        $normalised = strtolower(str_replace(['_', '-'], '', $key));
+
+        foreach (self::SENSITIVE_KEY_FRAGMENTS as $fragment) {
+            if (str_contains($normalised, $fragment)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function containsBearerToken(string $value): bool
+    {
+        return preg_match('/\bbearer\s+\S+/i', $value) === 1;
+    }
+
+    /**
+     * Remove the webhook URL (it embeds the webhook token) from text that is
+     * about to be logged.
+     */
+    private function scrub(string $text, string $url): string
+    {
+        return str_replace([$url, rawurlencode($url)], self::REDACTED, $text);
+    }
+}
