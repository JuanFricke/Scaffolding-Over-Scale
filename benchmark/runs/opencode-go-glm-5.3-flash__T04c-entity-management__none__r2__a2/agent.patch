+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class EntityPickController extends Controller
+{
+    /**
+     * Store the entity the user works in on the session.
+     */
+    public function __invoke(Request $request, Entity $entity): RedirectResponse
+    {
+        // Authorization first: a non-member must not get the session touched
+        // at all, not even to a stale value.
+        if ($request->user()->membershipFor($entity->id) === null) {
+            abort(403);
+        }
+
+        $request->session()->put('current_entity_id', $entity->id);
+
+        Log::channel('audit')->info('entity picked', [
+            'user_id' => $request->user()->getKey(),
+            'entity_id' => $entity->id,
+            'entity_slug' => $entity->slug,
+        ]);
+
+        return redirect()->route('entity.dashboard', $entity);
+    }
+}
