+test('transfer moves ownership to an admin of the same entity', function () {
+    [$entity, $owner, $ownerMembership] = makeEntity();
+    $admin = managerOf($entity);
+    $adminMembershipId = $admin->membershipFor($entity->id)->id;
+
+    $this->actingAs($owner);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $adminMembershipId)
+        ->call('transfer');
+
+    expect($entity->memberships()->owner()->first()->user_id)->toBe($admin->id)
+        ->and($entity->memberships()->whereKey($ownerMembership->id)->first()->role)->toBe(UserRole::Admin);
+});
+
+test('transfer only accepts admins other than the caller', function () {
+    [$entity, $owner, $ownerMembership] = makeEntity();
+    $employee = employeeOf($entity);
+    $employeeMembershipId = $employee->membershipFor($entity->id)->id;
+
+    $this->actingAs($owner);
+
+    // An employee is not a valid successor.
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $employeeMembershipId)
+        ->call('transfer')
+        ->assertForbidden();
+
+    // The caller's own (owner) membership is not an admin membership.
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $ownerMembership->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($entity->memberships()->owner()->first()->user_id)->toBe($owner->id)
+        ->and($employee->membershipFor($entity->id)->role)->toBe(UserRole::Employee);
+});
+
+test('transfer is refused when the owner row vanished in the meantime', function () {
+    [$entity, $owner, $ownerMembership] = makeEntity();
+    $admin = managerOf($entity);
+    $adminMembershipId = $admin->membershipFor($entity->id)->id;
+
+    // Simulate the race: the owner membership disappears from the database
+    // right between mount() authorization and the transfer call.
+    $this->actingAs($owner);
+    $component = Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $adminMembershipId);
+
+    $entity->memberships()->owner()->delete();
+
+    $component->call('transfer')
+        ->assertForbidden();
+
+    expect(EntityMembership::whereKey($adminMembershipId)->first()->role)->toBe(UserRole::Admin);
+});
