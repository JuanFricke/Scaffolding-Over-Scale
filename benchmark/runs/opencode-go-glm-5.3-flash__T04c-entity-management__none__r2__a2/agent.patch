diff --git a/tests/Feature/EntityManagementTest.php b/tests/Feature/EntityManagementTest.php
new file mode 100644
index 0000000..3a5a15d
--- /dev/null
+++ b/tests/Feature/EntityManagementTest.php
@@ -0,0 +1,566 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Route;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function makeEntity(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $membership = EntityMembership::factory()
+        ->owner()
+        ->create(['entity_id' => $entity->id, 'user_id' => $owner->id]);
+
+    return [$entity, $owner, $membership];
+}
+
+function managerOf(Entity $entity): User
+{
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+
+    return $admin;
+}
+
+function employeeOf(Entity $entity): User
+{
+    $employee = User::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $employee->id]);
+
+    return $employee;
+}
+
+// ----- data model -------------------------------------------------------------
+
+test('the database itself rejects a second owner in one entity', function () {
+    [$entity] = makeEntity();
+
+    expect(fn () => EntityMembership::factory()->owner()->create([
+        'entity_id' => $entity->id,
+        'user_id' => User::factory()->create()->id,
+    ]))->toThrow(QueryException::class);
+});
+
+test('memberships outside the owner role never trip the one-owner index', function () {
+    [$entity] = makeEntity();
+
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->count())->toBe(3)
+        ->and($entity->memberships()->owner()->count())->toBe(1)
+        ->and($entity->memberships()->admin()->count())->toBe(1)
+        ->and($entity->memberships()->employee()->count())->toBe(1);
+});
+
+test('membership factories and states build sensible rows', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin);
+});
+
+test('entity relations return memberships, users and the owner membership', function () {
+    [$entity, $owner, $ownerMembership] = makeEntity();
+    $employee = employeeOf($entity);
+
+    expect($entity->memberships->pluck('user_id'))->toContain($owner->id, $employee->id)
+        ->and($entity->users->pluck('id'))->toContain($owner->id, $employee->id)
+        ->and($entity->owner->is($ownerMembership))->toBeTrue();
+
+    expect($employee->membershipFor($entity->id)->role)->toBe(UserRole::Employee)
+        ->and($employee->membershipFor(Entity::factory()->create()->id))->toBeNull()
+        ->and($employee->entities->firstWhere('id', $entity->id))->not->toBeNull();
+});
+
+test('entities bind routes by slug', function () {
+    expect(Entity::factory()->create()->getRouteKeyName())->toBe('slug');
+});
+
+// ----- policies ---------------------------------------------------------------
+
+test('entity policy grants create to anyone and view only to members', function () {
+    $policy = new EntityPolicy;
+    [$entity] = makeEntity();
+    $outsider = User::factory()->create();
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+
+    expect($policy->create($outsider))->toBeTrue()
+        ->and($policy->view($outsider, $entity))->toBeFalse()
+        ->and($policy->view($admin, $entity))->toBeTrue();
+});
+
+test('entity policy allows owner and admin to update and delete, only owner to manage settings', function () {
+    $policy = new EntityPolicy;
+    [$entity, $owner] = makeEntity();
+    $admin = managerOf($entity);
+    $employee = employeeOf($entity);
+    $outsider = User::factory()->create();
+
+    foreach ([$owner, $admin] as $user) {
+        expect($policy->update($user, $entity))->toBeTrue()
+            ->and($policy->delete($user, $entity))->toBeTrue();
+    }
+
+    expect($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->update($outsider, $entity))->toBeFalse()
+        ->and($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse()
+        ->and($policy->manageSettings($employee, $entity))->toBeFalse()
+        ->and($policy->manageSettings($outsider, $entity))->toBeFalse();
+});
+
+test('membership policy restricts viewing to members and role assignment to owner/admin', function () {
+    $policy = new EntityMembershipPolicy;
+    [$entity, $owner, $ownerMembership] = makeEntity();
+    $employee = employeeOf($entity);
+    $employeeMembership = $employee->membershipFor($entity->id);
+    $outsider = User::factory()->create();
+
+    expect($policy->view($employee, $ownerMembership))->toBeTrue()
+        ->and($policy->view($outsider, $ownerMembership))->toBeFalse()
+        ->and($policy->assignRole($owner, $employeeMembership))->toBeTrue()
+        ->and($policy->assignRole($employee, $employeeMembership))->toBeFalse()
+        ->and($policy->assignRole($outsider, $employeeMembership))->toBeFalse();
+});
