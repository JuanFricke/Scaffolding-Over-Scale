diff --git a/app/Livewire/Entity/Members.php b/app/Livewire/Entity/Members.php
new file mode 100644
index 0000000..9354d04
--- /dev/null
+++ b/app/Livewire/Entity/Members.php
@@ -0,0 +1,130 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    public Entity $entity;
+
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    /**
+     * Add an existing user (by e-mail) as an employee member.
+     */
+    public function addMember(): void
+    {
+        // Managers only: authorize before touching anything else.
+        $this->authorize('assignRole', new EntityMembership([
+            'entity_id' => $this->entity->id,
+            'role' => UserRole::Employee,
+        ]));
+
+        $this->validate();
+
+        if (($user = User::firstWhere('email', $this->email)) === null) {
+            // Defensive: the validation rule `exists:users,email` already rejects
+            // unknown e-mails before this point.
+            $this->addError('email', __('ui.entity_members_not_found'));
+
+            return;
+        }
+
+        if ($this->entity->memberships()->where('user_id', $user->getKey())->exists()) {
+            $this->addError('email', __('ui.entity_members_already_member'));
+
+            return;
+        }
+
+        $this->entity->memberships()->create([
+            'user_id' => $user->getKey(),
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->email = '';
+    }
+
+    /**
+     * Change an existing member's role (admin/employee only).
+     */
+    public function assignRole(int $membershipId, string $role): void
+    {
+        // Anything outside admin/employee (e.g. `owner`) is a validation
+        // error on `role`; changing ownership lives in Settings::transfer().
+        Validator::make(['role' => $role], [
+            'role' => ['required', Rule::in(UserRole::manageable())],
+        ])->validate();
+
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        if ($membership->role === UserRole::Owner) {
+            // The owner's role never changes here; ownership is moved through
+            // the settings transfer flow instead.
+            abort(403);
+        }
+
+        $membership->update(['role' => UserRole::from($role)]);
+    }
+
+    /**
+     * Remove a member. Never the owner, never the last manager.
+     */
+    public function removeMember(int $membershipId): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        // Policy denies the owner's membership outright, allows self-removal,
+        // and otherwise requires the caller to be owner/admin.
+        $this->authorize('delete', $membership);
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)
+            && ! $this->entity->memberships()
+                ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+                ->whereKeyNot($membership->id)
+                ->exists()) {
+            // Would leave the entity without any manager.
+            abort(403);
+        }
+
+        $membership->delete();
+    }
+
+    /**
+     * Validation rules.
+     *
+     * @return array<string, array<int, mixed>>
+     */
+    protected function rules(): array
+    {
+        return [
+            'email' => ['required', 'string', 'email', 'exists:users,email'],
+        ];
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'entity' => $this->entity,
+            'memberships' => $this->entity->memberships()->with('user')->get(),
+        ]);
+    }
+}
