+test('membership policy never deletes the owner membership, allows self-removal, otherwise owner/admin only', function () {
+    $policy = new EntityMembershipPolicy;
+    [$entity, $owner, $ownerMembership] = makeEntity();
+    $employee = employeeOf($entity);
+    $employeeMembership = $employee->membershipFor($entity->id);
+    $outsider = User::factory()->create();
+
+    expect($policy->delete($owner, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($owner, $employeeMembership))->toBeTrue()
+        ->and($policy->delete($employee, $employeeMembership))->toBeTrue() // self-removal
+        ->and($policy->delete($employee, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($outsider, $employeeMembership))->toBeFalse();
+});
