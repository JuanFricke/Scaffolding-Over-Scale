@@ -0,0 +1,123 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    /** id of the membership that will receive ownership on transfer. */
+    public ?int $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        // Owner only, enforced at mount; the bound entity is re-authorized on
+        // every action, so it can never be swapped from the client.
+        $this->authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    /**
+     * Edit the entity's name and slug.
+     */
+    public function save(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $validated = $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => [
+                'required',
+                'string',
+                'max:255',
+                'alpha_dash',
+                Rule::unique('entities', 'slug')->ignore($this->entity->id),
+            ],
+        ]);
+
+        $this->entity->update($validated);
+
+        $this->redirect(route('entity.settings', $this->entity), navigate: true);
+    }
+
+    /**
+     * Soft-delete the entity together with its memberships.
+     */
+    public function delete(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        DB::transaction(function () {
+            EntityMembership::where('entity_id', $this->entity->id)->delete();
+
+            $this->entity->delete();
+        });
+
+        if (session('current_entity_id') === $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirect(route('home'), navigate: true);
+    }
+
+    /**
+     * Move ownership to another admin membership.
+     */
+    public function transfer(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $target = $this->entity->memberships()
+            ->whereKey($this->targetMembershipId)
+            ->first();
+
+        // Must be an admin of this entity, and not the caller.
+        abort_unless(
+            $target !== null
+                && $target->role === UserRole::Admin
+                && $target->user_id !== Auth::id(),
+            403,
+        );
+
+        DB::transaction(function () use ($target) {
+            $owner = $this->entity->memberships()->owner()->lockForUpdate()->first();
+
+            // The uniques index allows only one owner; if the owner row
+            // vanished meanwhile, refuse rather than create a broken state.
+            if ($owner === null) {
+                abort(403);
+            }
+
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+        });
+
+        $this->redirect(route('entity.dashboard', $this->entity), navigate: true);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'entity' => $this->entity,
+            'admins' => $this->entity->memberships()->admin()->with('user')->get(),
+        ]);
+    }
+}
