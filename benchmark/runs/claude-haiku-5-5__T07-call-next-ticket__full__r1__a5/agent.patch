+    expect(fn () => (new CallNextTicket)($queue, User::factory()->create(), CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('throws in normal_only mode when only priority tickets wait', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $priority = waitingTicket($queue, 10);
