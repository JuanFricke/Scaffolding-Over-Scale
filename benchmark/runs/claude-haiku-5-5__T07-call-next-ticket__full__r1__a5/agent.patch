+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * Consecutive priority calls after which the next call must be a normal ticket.
+     */
+    private const FAIRNESS_STREAK = 3;
+
+    /**
+     * Mark the next eligible waiting ticket of a queue as called.
+     *
+     * The caller is trusted: authorization happens outside this action.
+     *
+     * @throws InactiveQueueException when the queue is inactive; nothing changes.
+     * @throws NoWaitingTicketsException when no ticket is eligible for the mode; nothing changes.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Lock the queue row and read its state here, not from the passed instance
+            // (it may be stale), so calls serialize with issuance and deactivation.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            // Ticket::call() does not lock the queue, so a candidate can be called between
+            // selection and its row lock. Such candidates are skipped and the next one is picked.
+            $skipped = [];
+
+            while (($candidate = $this->candidate($lockedQueue, $mode, $skipped)) !== null) {
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket?->status === TicketStatus::Waiting) {
+                    $ticket->forceFill([
+                        'status' => TicketStatus::Called,
+                        'called_at' => now(),
+                        'called_by_user_id' => $calledBy->id,
+                    ])->save();
+
+                    return $ticket;
+                }
+
+                $skipped[] = $candidate->id;
+            }
+
+            throw new NoWaitingTicketsException('No waiting ticket is eligible for this call.');
+        });
+    }
+
+    /**
+     * The next waiting ticket for the mode, ignoring already-skipped ids.
+     *
+     * @param  list<int>  $skipped
+     */
+    private function candidate(Queue $queue, CallMode $mode, array $skipped): ?Ticket
+    {
+        // Full ordering: higher priority first, then oldest issued_at, then lowest id.
+        $waiting = fn () => Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->whereNotIn('id', $skipped)
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+
+        return match ($mode) {
+            CallMode::PriorityOnly => $waiting()->where('priority', '>', 0)->first(),
+            CallMode::NormalOnly => $waiting()->where('priority', 0)->first(),
+            CallMode::Any => $this->fairnessDue($queue)
+                ? ($waiting()->where('priority', 0)->first() ?? $waiting()->first())
+                : $waiting()->first(),
+        };
+    }
+
+    /**
+     * Whether the last FAIRNESS_STREAK calls in the queue were all priority calls.
+     *
+     * Calls in every mode count, so the streak is read from the call history rather
+     * than from the mode of the current call.
+     */
+    private function fairnessDue(Queue $queue): bool
+    {
+        $lastCalls = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::FAIRNESS_STREAK)
+            ->pluck('priority');
+
+        return $lastCalls->count() === self::FAIRNESS_STREAK
+            && $lastCalls->every(fn ($priority) => $priority > 0);
+    }
+}
