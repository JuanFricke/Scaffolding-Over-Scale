+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Carbon\CarbonInterface;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+
+uses(RefreshDatabase::class);
+
+function waitingTicket(Queue $queue, int $priority = 0, ?CarbonInterface $issuedAt = null): Ticket
+{
+    return Ticket::factory()->for($queue)->create([
+        'priority' => $priority,
+        'issued_at' => $issuedAt ?? now(),
+    ]);
+}
+
+function calledTicket(Queue $queue, User $user, int $priority, CarbonInterface $calledAt): Ticket
+{
+    return Ticket::factory()->for($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt,
+        'called_by_user_id' => $user->id,
+    ]);
+}
+
+it('calls the oldest normal ticket when no priority ticket waits', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $older = waitingTicket($queue, issuedAt: now()->subMinutes(10));
+    $newer = waitingTicket($queue, issuedAt: now()->subMinutes(5));
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($older))->toBeTrue()
+        ->and($called)
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($attendant->id)
+        ->called_at->not->toBeNull()
+        ->and($older->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($attendant->id)
+        ->priority->toBe(0)
+        ->and($newer->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls higher priority values first, regardless of age', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $normal = waitingTicket($queue, 0, now()->subMinutes(30));
+    $priority = waitingTicket($queue, 10, now()->subMinutes(5));
+    $highest = waitingTicket($queue, 20, now()->subMinute());
+
+    $action = new CallNextTicket;
+
+    expect($action($queue, $attendant)->is($highest))->toBeTrue()
+        ->and($action($queue, $attendant)->is($priority))->toBeTrue()
+        ->and($action($queue, $attendant)->is($normal))->toBeTrue();
+});
+
+it('breaks priority ties by oldest issued_at before lowest id', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $newerLowId = waitingTicket($queue, 10, now()->subMinute());
+    $olderHighId = waitingTicket($queue, 10, now()->subMinutes(9));
+
+    expect($newerLowId->id)->toBeLessThan($olderHighId->id)
+        ->and((new CallNextTicket)($queue, $attendant)->is($olderHighId))->toBeTrue();
+});
+
+it('breaks ties on the same priority and issued_at by lowest id', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $issuedAt = now()->subMinutes(5);
+    $first = waitingTicket($queue, 0, $issuedAt);
+    waitingTicket($queue, 0, $issuedAt);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($first))->toBeTrue();
+});
+
+it('ignores waiting tickets of other queues', function () {
+    $entity = Entity::factory()->create();
+    $otherQueue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    waitingTicket($otherQueue, 99, now()->subDay());
+    $ours = waitingTicket($queue);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($ours))->toBeTrue()
+        ->and(Ticket::query()->where('queue_id', $otherQueue->id)->value('status'))
+        ->toBe(TicketStatus::Waiting);
+});
+
+it('never calls a ticket that is already called', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    calledTicket($queue, $attendant, 50, now()->subMinute());
+    $waiting = waitingTicket($queue);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($waiting))->toBeTrue();
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('calls only priority tickets in priority_only mode, even if a normal is older', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $normal = waitingTicket($queue, 0, now()->subHour());
+    $priority = waitingTicket($queue, 10, now()->subMinute());
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue()
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls only normal tickets, oldest first, in normal_only mode', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $priority = waitingTicket($queue, 10, now()->subHour());
+    $olderNormal = waitingTicket($queue, 0, now()->subMinutes(10));
+    waitingTicket($queue, 0, now()->subMinutes(5));
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly);
+
+    expect($called->is($olderNormal))->toBeTrue()
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('throws and changes nothing when the queue is empty', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    expect(fn () => (new CallNextTicket)($queue, User::factory()->create()))
+        ->toThrow(NoWaitingTicketsException::class);
