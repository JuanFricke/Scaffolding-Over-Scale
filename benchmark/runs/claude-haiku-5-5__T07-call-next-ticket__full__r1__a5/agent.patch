+it('rejects calling from an inactive queue and changes nothing', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+    $ticket = waitingTicket($queue);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, User::factory()->create()))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Waiting)
+        ->called_by_user_id->toBeNull()
+        ->called_at->toBeNull();
+});
+
+it('skips a ticket called concurrently and calls the next candidate', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $other = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($other)->owner()->create();
+    $contested = waitingTicket($queue, issuedAt: now()->subMinutes(10));
+    $next = waitingTicket($queue, issuedAt: now()->subMinutes(5));
+
+    // Another attendant calls the contested ticket through Ticket::call() (which
+    // does not lock the queue) after it was selected but before its row is locked.
+    $raced = false;
+    Event::listen('eloquent.retrieved: '.Ticket::class, function (Ticket $ticket) use (&$raced, $contested, $other) {
+        if ($raced || ! $ticket->is($contested)) {
+            return;
+        }
+
+        $raced = true;
+        $ticket->call($other);
+    });
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($raced)->toBeTrue()
+        ->and($called->is($next))->toBeTrue()
+        ->and($contested->fresh()->called_by_user_id)->toBe($other->id)
+        ->and($next->fresh()->called_by_user_id)->toBe($attendant->id);
+});
