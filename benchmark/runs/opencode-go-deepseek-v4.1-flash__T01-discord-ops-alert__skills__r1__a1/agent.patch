diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..745922e
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,173 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use JsonSerializable;
+use Throwable;
+
+/**
+ * Sends explicit, human-pageable operations incidents to a Discord webhook.
+ *
+ * Discord is deliberately not a Monolog channel: callers decide when an
+ * incident is worth waking someone up. The notifier always soft-fails so an
+ * unavailable webhook can never break the code path that reported a problem.
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const TIMEOUT_SECONDS = 5;
+
+    private const SENSITIVE_KEY_PARTS = [
+        'password',
+        'token',
+        'secret',
+        'authorization',
+        'api_key',
+        'api-key',
+        'apikey',
+        'webhook',
+    ];
+
+    /**
+     * Send one alert. Does nothing when no webhook URL is configured.
+     *
+     * @param  array<string|int, mixed>  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhookUrl = config('services.discord.webhook_url');
+
+        if (! is_string($webhookUrl) || trim($webhookUrl) === '') {
+            return;
+        }
+
+        $text = $this->buildText($title, $message, $context);
+
+        try {
+            $response = Http::timeout(self::TIMEOUT_SECONDS)
+                ->asJson()
+                ->post($webhookUrl, ['content' => $text]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                    'title' => $this->scrub($title, $webhookUrl),
+                ]);
+            }
+        } catch (Throwable $exception) {
+            Log::error('Discord ops alert failed', [
+                'title' => $this->scrub($title, $webhookUrl),
+                'exception' => $this->scrub($exception->getMessage(), $webhookUrl),
+            ]);
+        }
+    }
+
+    /**
+     * @param  array<string|int, mixed>  $context
+     */
+    private function buildText(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->formatValue((string) $key, $value);
+        }
+
+        return Str::substr(implode("\n", $lines), 0, self::MAX_LENGTH);
+    }
+
+    private function formatValue(string $key, mixed $value): string
+    {
+        if ($this->isSensitiveKey($key)) {
+            return '[redacted]';
+        }
+
+        if (is_array($value)) {
+            return $this->encode($this->redactArray($value));
+        }
+
+        if (is_string($value)) {
+            return $this->containsBearer($value) ? '[redacted]' : $value;
+        }
+
+        return $this->stringify($value);
+    }
+
+    /**
+     * @param  array<string|int, mixed>  $data
+     * @return array<string|int, mixed>
+     */
+    private function redactArray(array $data): array
+    {
+        $redacted = [];
+
+        foreach ($data as $key => $value) {
+            if (is_string($key) && $this->isSensitiveKey($key)) {
+                $redacted[$key] = '[redacted]';
+            } elseif (is_array($value)) {
+                $redacted[$key] = $this->redactArray($value);
+            } elseif (is_string($value) && $this->containsBearer($value)) {
+                $redacted[$key] = '[redacted]';
+            } else {
+                $redacted[$key] = $value;
+            }
+        }
+
+        return $redacted;
+    }
+
+    private function isSensitiveKey(string $key): bool
+    {
+        return Str::contains(Str::lower($key), self::SENSITIVE_KEY_PARTS);
+    }
+
+    private function containsBearer(string $value): bool
+    {
+        return preg_match('/\bBearer\s+\S+/i', $value) === 1;
+    }
+
+    private function stringify(mixed $value): string
+    {
+        if ($value === null) {
+            return 'null';
+        }
+
+        if (is_bool($value)) {
+            return $value ? 'true' : 'false';
+        }
+
+        if (is_scalar($value) || $value instanceof JsonSerializable) {
+            return $this->encode($value);
+        }
+
+        if ($value instanceof \Stringable) {
+            return (string) $value;
+        }
+
+        return $this->encode($value);
+    }
+
+    private function encode(mixed $value): string
+    {
+        $encoded = json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+
+        return $encoded === false ? '"[unserializable]"' : $encoded;
+    }
+
+    /**
+     * Never let the webhook URL (which embeds the token) reach the log.
+     */
+    private function scrub(string $text, string $webhookUrl): string
+    {
+        $text = str_replace($webhookUrl, '[redacted]', $text);
+        $text = str_replace(rtrim($webhookUrl, '/'), '[redacted]', $text);
+
+        $text = preg_replace('~https?://\S*/webhooks/\S+~i', '[redacted]', $text);
+
+        return $text ?? '';
+    }
+}
