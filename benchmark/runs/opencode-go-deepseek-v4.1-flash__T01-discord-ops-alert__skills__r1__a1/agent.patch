diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..f446949
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,138 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+beforeEach(function () {
+    $this->webhookUrl = 'https://discord.com/api/webhooks/123456/secret-token';
+    config(['services.discord.webhook_url' => $this->webhookUrl]);
+});
+
+test('it is a no-op when the webhook is not configured', function (mixed $configured) {
+    config(['services.discord.webhook_url' => $configured]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message', ['entity_id' => 42]);
+
+    Http::assertNothingSent();
+})->with([
+    'null' => null,
+    'empty string' => '',
+    'blank string' => '   ',
+]);
+
+test('it posts the title, message and context to the configured webhook', function () {
+    Http::fake([
+        '*' => Http::response([], 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Job failed', 'The webhook job exhausted its retries.', [
+        'entity_id' => 42,
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        return $request->method() === 'POST'
+            && $request->url() === $this->webhookUrl
+            && $request['content'] === "Job failed\nThe webhook job exhausted its retries.\nentity_id=42\nqueue=asaas-webhooks";
+    });
+});
+
+test('it redacts sensitive values, bearer credentials and nested secrets', function () {
+    Http::fake([
+        '*' => Http::response([], 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Message', [
+        'password' => 'plain-password',
+        'PassWord_Confirmation' => 'another-password',
+        'token' => 'plain-token',
+        'secret' => 'plain-secret',
+        'authorization' => 'Bearer top-secret-token',
+        'api_key' => 'plain-api-key',
+        'api-key' => 'plain-api-key',
+        'apikey' => 'plain-api-key',
+        'webhook' => 'plain-webhook',
+        'note' => 'header was Bearer another-secret-token',
+        'queue' => 'asaas-webhooks',
+        'nested' => [
+            'token' => 'nested-token',
+            'safe' => 'readable',
+            'headers' => [
+                'authorization' => 'Bearer nested-secret-token',
+            ],
+        ],
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'];
+
+        return $content === implode("\n", [
+            'Alert',
+            'Message',
+            'password=[redacted]',
+            'PassWord_Confirmation=[redacted]',
+            'token=[redacted]',
+            'secret=[redacted]',
+            'authorization=[redacted]',
+            'api_key=[redacted]',
+            'api-key=[redacted]',
+            'apikey=[redacted]',
+            'webhook=[redacted]',
+            'note=[redacted]',
+            'queue=asaas-webhooks',
+            'nested={"token":"[redacted]","safe":"readable","headers":{"authorization":"[redacted]"}}',
+        ]);
+    });
+});
+
+test('it truncates long alerts to 1800 multibyte characters', function () {
+    Http::fake([
+        '*' => Http::response([], 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Long alert', str_repeat('á', 2500));
+
+    Http::assertSent(function (Request $request) {
+        return mb_strlen($request['content'], 'UTF-8') === 1800;
+    });
+});
+
+test('it logs non-2xx responses without exposing the webhook url', function () {
+    Http::fake([
+        '*' => Http::response(['message' => 'nope'], 500),
+    ]);
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(function (string $message, array $context = []) {
+            $logged = $message.' '.json_encode($context);
+
+            return ! str_contains($logged, $this->webhookUrl)
+                && ($context['status'] ?? null) === 500;
+        });
+});
+
+test('it soft-fails and scrubs transport exceptions', function () {
+    Http::fake(function () {
+        throw new ConnectionException("cURL error 7 while calling {$this->webhookUrl}");
+    });
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(function (string $message, array $context = []) {
+            $logged = $message.' '.json_encode($context);
+
+            return ! str_contains($logged, $this->webhookUrl)
+                && ! str_contains($logged, 'secret-token');
+        });
+});
diff --git a/tests/Feature/Ops/LoggingChannelsTest.php b/tests/Feature/Ops/LoggingChannelsTest.php
new file mode 100644
index 0000000..83bcd12
--- /dev/null
+++ b/tests/Feature/Ops/LoggingChannelsTest.php
@@ -0,0 +1,40 @@
+<?php
+
+use Illuminate\Log\Logger;
+use Illuminate\Support\Facades\Log;
+
+test('daily is the archive channel with fourteen day retention', function () {
+    $daily = config('logging.channels.daily');
+
+    expect($daily['driver'])->toBe('daily')
+        ->and($daily['path'])->toEndWith('logs/laravel.log')
+        ->and($daily['days'])->toEqual(14);
+});
+
+test('audit writes to its own rotated file with ninety day retention', function () {
+    $audit = config('logging.channels.audit');
+
+    expect($audit['driver'])->toBe('daily')
+        ->and($audit['path'])->toEndWith('logs/audit.log')
+        ->and($audit['level'])->toBe('info')
+        ->and($audit['days'])->toEqual(90);
+});
+
+test('the audit channel accepts writes', function () {
+    expect(Log::channel('audit'))->toBeInstanceOf(Logger::class);
+
+    Log::channel('audit')->info('Subscription status changed', [
+        'entity_id' => 42,
+    ]);
+
+    expect(true)->toBeTrue();
+});
+
+test('the default stack logs through the daily archive channel', function () {
+    expect(config('logging.channels.stack.channels'))->toContain('daily')
+        ->and(config('logging.channels.stack.channels'))->not->toContain('single');
+});
+
+test('there is no discord log channel', function () {
+    expect(config('logging.channels'))->not->toHaveKey('discord');
+});
