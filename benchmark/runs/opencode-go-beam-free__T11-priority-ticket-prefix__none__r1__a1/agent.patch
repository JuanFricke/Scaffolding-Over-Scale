+    protected static function booted(): void
+    {
+        static::saving(function (Queue $queue): void {
+            $map = $queue->priority_prefix_map;
+
+            if (is_array($map) && $map === []) {
+                $queue->priority_prefix_map = null;
+                $map = null;
+            }
+
+            self::validatePriorityPrefixMap($map);
+        });
+    }
+
+    /**
+     * Validate a priority prefix map, throwing InvalidArgumentException on failure.
+     *
+     * @param  array<mixed, mixed>|null  $map
+     */
+    public static function validatePriorityPrefixMap(?array $map): void
+    {
+        if ($map === null) {
+            return;
+        }
+
+        if (! is_array($map)) {
+            throw new InvalidArgumentException('priority_prefix_map must be an array or null.');
+        }
+
+        foreach (array_keys($map) as $key) {
+            $keyString = is_int($key) ? (string) $key : (is_string($key) ? $key : null);
+
+            if ($keyString === null || ! preg_match('/^(0|[1-9][0-9]*)$/', $keyString)) {
+                throw new InvalidArgumentException('priority_prefix_map keys must be non-negative integers in canonical form.');
+            }
+        }
+
+        foreach ($map as $value) {
+            if (! is_string($value) || ! preg_match('/^[A-Z]$/', $value)) {
+                throw new InvalidArgumentException('priority_prefix_map values must be a single uppercase letter A-Z.');
+            }
+        }
+
+        $letters = array_values($map);
+
+        foreach ([0, 10, 20] as $level) {
+            $levelKeyString = (string) $level;
+
+            $covered = array_key_exists($level, $map) || array_key_exists($levelKeyString, $map);
+
+            if (! $covered) {
+                $letters[] = self::DEFAULT_PREFIX_MAP[$level];
+            }
+        }
+
+        if (count($letters) !== count(array_unique($letters))) {
+            throw new InvalidArgumentException('priority_prefix_map effective prefixes must be unique.');
+        }
+    }
+
+    /**
+     * Resolve the default prefix for a priority value.
+     */
+    public static function defaultPrefixFor(int $priority): string
+    {
+        if (array_key_exists($priority, self::DEFAULT_PREFIX_MAP)) {
+            return self::DEFAULT_PREFIX_MAP[$priority];
+        }
+
+        if ($priority <= 0) {
+            return 'N';
+        }
+
+        if ($priority >= 20) {
+            return 'E';
+        }
+
+        return 'P';
+    }
+
+    /**
+     * Resolve the prefix for a priority, honouring the custom map.
+     */
+    public function prefixForPriority(int $priority): string
+    {
+        $map = $this->priority_prefix_map;
+
+        if (is_array($map)) {
+            foreach ([$priority, (string) $priority] as $key) {
+                if (array_key_exists($key, $map)) {
+                    return (string) $map[$key];
+                }
+            }
+        }
+
+        return self::defaultPrefixFor($priority);
+    }
+
     /**
      * @return BelongsTo<Entity, $this>
