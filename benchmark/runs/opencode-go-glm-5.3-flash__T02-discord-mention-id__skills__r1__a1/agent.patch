@@ -58,7 +58,7 @@ public function send(string $title, string $message, array $context = []): void
     /**
      * @param  array<string, mixed>  $context
      */
-    private function formatContent(string $title, string $message, array $context): string
+    private function formatContent(string $title, string $message, array $context, string $mention): string
     {
         $lines = [$title, $message];
 
@@ -66,7 +66,36 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $body = implode("\n", $lines);
+
+        if ($mention === '') {
+            return mb_substr($body, 0, self::MaxContentLength);
+        }
+
+        // Reserve room for the newline + mention so the whole content stays within the limit.
+        return mb_substr($body, 0, self::MaxContentLength - mb_strlen($mention) - 1)."\n".$mention;
+    }
+
+    /**
+     * Optional user mention from DISCORD_MENTION_ID.
+     *
+     * Only a Discord snowflake (17-20 digits, surrounding whitespace trimmed,
+     * integers accepted) becomes a mention; anything else is ignored so a
+     * misconfigured value can never ping @everyone/@here.
+     */
+    private function mention(): string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (is_int($id)) {
+            $id = (string) $id;
+        }
+
+        if (! is_string($id) || preg_match('/^\d{17,20}$/', trim($id)) !== 1) {
+            return '';
+        }
+
+        return '<@'.trim($id).'>';
     }
 
     private function safe(string $key, mixed $value): string
