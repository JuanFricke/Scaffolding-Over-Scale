+test('appends a configured user mention on its own line', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => '12345678901234567']);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', 'M', ['k' => 'v']);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n<@12345678901234567>")
+            && str_starts_with($content, "T\nM\nk=v");
+    });
+});
+
+test('adds no mention when the setting is null or empty', function (?string $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
