[45597] 4.50.096.097 W common_chat_peg_parse: unparsed peg-native output: <|channel|>functions.write<|channel|>commentary json<|message|>{"path": "app/Http/Controllers/TotemAuthController.php", "content": "<?php\n\nnamespace App\\Http\\Controllers;\n\nuse App\\Models\\TotemPreset;\nuse Illuminate\\Http\\Request;\nuse Illuminate\\Support\\Facades\\Log;\nuse Illuminate\\Support\\Facades\\Response;\nuse Illuminate\\Support\\Facades\\Validator;\nuse Illuminate\\Support\\Facades\\Cache;\nuse Illuminate\\Support\\Facades\\Config;\nuse Illuminate\\Support\\Facades\\DB;\n\nclass TotemAuthController extends Controller\n{\n    public function auth(Request $request)\n    {\n        $data = $request->only('code');\n        $validator = Validator::make($data, [\n            'code' => ['required', 'size:6', 'regex:/^\\d{6}$/'],\n        ]);\n        if ($validator->fails()) {\n            return Response::json(['code' => 'invalid_code_format'], 400);\n        }\n        $code = $data['code'];\n        $preset = TotemPreset::where('login_code', $code)\n            ->where('is_active', true)\n            ->where('login_code_expires_at', '>=', now())\n            ->whereNull('login_code_consumed_at')\n            ->first();\n        if (!$preset) {\n            return Response::json(['code' => 'invalid_pairing_code'], 401);\n        }\n        // Transaction with lock\n        $totem = DB::transaction(function () use ($preset) {\n            $preset->lockForUpdate();\n            if ($preset->login_code_expires_at < now() || $preset->login_code_consumed_at !== null) {\n                return null;\n            }\n            $preset->login_code_consumed_at = now();\n            $preset->save();\n            $totem = \App\\Models\\Totem::create([\n                'entity_id' => $preset->entity_id,\n                'name' => $preset->name,\n                'is_active' => true,\n                'last_seen_at' => now(),\n            ]);\n            return $totem;\n        });\n        if (!$totem) {\n            return Response::json(['code' => 'invalid_pairing_code'], 401);\n        }\n        $token = $this->generateJwt($totem, $preset);\n        Log::info(\"Totem paired: totem_id {$totem->id} preset_id {$preset->id}\");\n        return Response::json([\n            'token' => $token,\n            'token_type' => 'Bearer',\n            'expires_in' => Config::get('services.totem.jwt_ttl'),\n            'entity' => [\n                'slug' => $totem->entity->slug,\n                'name' => $totem->entity->name,\n            ],\n        ]);\n    }\n\n    private function generateJwt($totem, $preset): string\n    {\n        $now = time();\n        $ttl = config('services.totem.jwt_ttl');\n        $exp = $now + $ttl;\n        $queues = $preset->queues()->pluck('id')->toArray();\n        $header = ['alg' => 'HS256', 'typ' => 'JWT'];\n        $payload = [\n            'iss' => 'pegafila',\n            'iat' => $now,\n            'exp' => $exp,\n            'jti' => uniqid('', true),\n            'totem_id' => $totem->id,\n            'entity_id' => $totem->entity_id,\n            'preset_id' => $preset->id,\n            'queues' => $queues,\n        ];\n        $headerB64 = rtrim(strtr(base64_encode(json_encode($header)), '+/', '-_'), '=');\n        $payloadB64 = rtrim(strtr(base64_encode(json_encode($payload)), '+/', '-_'), '=');\n        $secret = config('services.totem.jwt_secret');\n        $signature = hash_hmac('sha256', $headerB64 . '.' . $payloadB64, $secret, true);\n        $signatureB64 = rtrim(strtr(base64_encode($signature), '+/', '-_'), '=');\n        return $headerB64 . '.' . $payloadB64 . '.' . $signatureB64;\n    }\n}\n"}
