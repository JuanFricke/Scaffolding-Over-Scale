+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class EntityController extends Controller
+{
+    /**
+     * List the entities the authenticated user belongs to.
+     */
+    public function switcher(Request $request): View
+    {
+        return view('entity.switcher', [
+            'entities' => $request->user()->entities()->orderBy('name')->get(),
+            'currentEntityId' => $request->session()->get('current_entity_id'),
+        ]);
+    }
+
+    /**
+     * Make the given entity the current tenant for this session.
+     */
+    public function pick(Request $request, Entity $entity): RedirectResponse
+    {
+        abort_unless($request->user()->membershipFor($entity->id) !== null, 403);
+
+        $request->session()->put('current_entity_id', $entity->id);
+
+        Log::channel('audit')->info('Entity selected', [
+            'entity_id' => $entity->id,
+            'actor_id' => $request->user()->id,
+        ]);
+
+        return redirect()->route('entity.dashboard', $entity);
+    }
+}
