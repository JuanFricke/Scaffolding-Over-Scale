@@ -0,0 +1,78 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('entities use the slug for route model binding and soft delete', function () {
+    $entity = Entity::factory()->create(['name' => 'Acme Corp', 'slug' => 'acme-corp']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme-corp');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('memberships connect users and entities with a role enum', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->admin()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($membership->entity->is($entity))->toBeTrue()
+        ->and($membership->user->is($user))->toBeTrue()
+        ->and($entity->memberships()->count())->toBe(1)
+        ->and($entity->users->first()->is($user))->toBeTrue()
+        ->and($user->entities->first()->is($entity))->toBeTrue()
+        ->and($user->membershipFor($entity->id)?->is($membership))->toBeTrue()
+        ->and($user->membershipFor(999))->toBeNull();
+});
+
+test('membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id])
+        ->and($entity->owner?->is($owner))->toBeTrue();
+});
+
+test('manageable roles exclude owner', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    try {
+        EntityMembership::factory()->owner()->for($entity)->create();
+        $this->fail('A second owner was accepted.');
+    } catch (UniqueConstraintViolationException) {
+        expect($entity->memberships()->count())->toBe(1);
+    }
+});
+
+test('the database allows several non-owner memberships for one entity', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->employee()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(3);
+});
