@@ -0,0 +1,71 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Tenancy\CurrentEntity;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class EnsureCurrentEntity
+{
+    /**
+     * Resolve the session's entity into the request-scoped tenant context.
+     *
+     * @param  Closure(Request): (Response)  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        abort_unless($user !== null, 403);
+
+        $context = app(CurrentEntity::class);
+        $entityId = $request->session()->get('current_entity_id');
+
+        if ($entityId === null) {
+            $memberships = $user->memberships()->with('entity')->get();
+
+            if ($memberships->isEmpty()) {
+                return redirect()->route('onboarding');
+            }
+
+            if ($memberships->count() > 1) {
+                return redirect()->route('entity.switcher');
+            }
+
+            $entity = $memberships->first()->entity;
+
+            abort_unless($entity instanceof Entity, 403);
+
+            $request->session()->put('current_entity_id', $entity->id);
+
+            return $this->continueWith($request, $next, $context, $entity);
+        }
+
+        $entity = Entity::find($entityId);
+
+        abort_unless(
+            $entity instanceof Entity && $user->membershipFor($entity->id) !== null,
+            403,
+        );
+
+        return $this->continueWith($request, $next, $context, $entity);
+    }
+
+    /**
+     * @param  Closure(Request): (Response)  $next
+     */
+    protected function continueWith(
+        Request $request,
+        Closure $next,
+        CurrentEntity $context,
+        Entity $entity,
+    ): Response {
+        $context->set($entity);
+        $request->attributes->set('current_entity', $entity);
+
+        return $next($request);
+    }
+}
