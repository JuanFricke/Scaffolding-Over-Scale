--- /dev/null
+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,51 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $this->roleFor($user, $membership->entity_id) !== null;
+    }
+
+    /**
+     * Owners and admins may assign roles.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->isManager($this->roleFor($user, $membership->entity_id));
+    }
+
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        // The owner cannot be removed while owning the entity.
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        // Any member may remove themselves.
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->isManager($this->roleFor($user, $membership->entity_id));
+    }
+
+    protected function roleFor(User $user, int $entityId): ?UserRole
+    {
+        return $user->membershipFor($entityId)?->role;
+    }
+
+    protected function isManager(?UserRole $role): bool
+    {
+        return in_array($role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
