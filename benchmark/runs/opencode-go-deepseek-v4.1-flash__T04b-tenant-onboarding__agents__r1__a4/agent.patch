@@ -0,0 +1,104 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    /**
+     * Create the entity and make the authenticated user its owner.
+     */
+    public function submit(): void
+    {
+        $validated = $this->validate();
+        $user = Auth::user();
+
+        $entity = $this->createEntity($validated['name'], $user->id);
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session()->put('current_entity_id', $entity->id);
+
+        $this->redirect(route('entity.dashboard', $entity));
+    }
+
+    /**
+     * Persist the entity and owner membership in one transaction, retrying if a
+     * concurrent request claims the slug between the check and the insert.
+     */
+    protected function createEntity(string $name, int $userId): Entity
+    {
+        $attempts = 5;
+
+        for ($attempt = 1; $attempt <= $attempts; $attempt++) {
+            try {
+                return DB::transaction(function () use ($name, $userId): Entity {
+                    $entity = Entity::create([
+                        'name' => $name,
+                        'slug' => $this->uniqueSlug($name),
+                    ]);
+
+                    $entity->memberships()->create([
+                        'user_id' => $userId,
+                        'role' => UserRole::Owner,
+                    ]);
+
+                    return $entity;
+                });
+            } catch (UniqueConstraintViolationException $exception) {
+                if ($attempt === $attempts) {
+                    throw $exception;
+                }
+            }
+        }
+
+        // The loop always returns or throws; this keeps static analysis happy.
+        throw new \LogicException('Unable to create the entity.');
+    }
+
+    /**
+     * Build the first available slug for the given name.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name);
+
+        if ($base === '') {
+            $base = 'entity';
+        }
+
+        $slug = $base;
+        $suffix = 2;
+
+        while (Entity::withTrashed()->where('slug', $slug)->exists()) {
+            $slug = $base.'-'.$suffix;
+            $suffix++;
+        }
+
+        return $slug;
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')
+            ->title(__('ui.onboarding_title'));
+    }
+}
