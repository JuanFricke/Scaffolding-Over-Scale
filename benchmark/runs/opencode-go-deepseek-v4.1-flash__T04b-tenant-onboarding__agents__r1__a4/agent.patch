--- /dev/null
+++ b/app/Tenancy/CurrentEntity.php
@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Tenancy;
+
+use App\Models\Entity;
+
+/**
+ * Request-scoped tenant context resolved from the session by middleware.
+ *
+ * Application services read the entity from here instead of touching the
+ * session directly.
+ */
+class CurrentEntity
+{
+    protected ?Entity $entity = null;
+
+    public function set(Entity $entity): void
+    {
+        $this->entity = $entity;
+    }
+
+    public function get(): ?Entity
+    {
+        return $this->entity;
+    }
+
+    public function entity(): ?Entity
+    {
+        return $this->entity;
+    }
+
+    public function id(): ?int
+    {
+        return $this->entity?->id;
+    }
+
+    public function check(): bool
+    {
+        return $this->entity !== null;
+    }
+}
