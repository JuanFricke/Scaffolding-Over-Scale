+
+uses(RefreshDatabase::class);
+
+test('guests are redirected from onboarding', function () {
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+});
+
+test('unverified users are redirected from onboarding', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('onboarding'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('onboarding renders the localized title and heading', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Crie sua entidade')
+        ->assertSee('Crie sua empresa');
+});
+
+test('submitting onboarding creates the entity and owner membership', function () {
+    $user = User::factory()->create();
+    Event::fake([MessageLogged::class]);
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', Entity::first()));
+
+    $entity = Entity::first();
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->slug)->toBe('acme-corp')
+        ->and(EntityMembership::where('entity_id', $entity->id)->where('user_id', $user->id)->first()->role)
+        ->toBe(UserRole::Owner)
+        ->and(session('current_entity_id'))->toBe($entity->id);
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($entity, $user) {
+        return $log->level === 'info'
+            && $log->message === 'Entity created'
+            && $log->context['entity_id'] === $entity->id
+            && $log->context['actor_id'] === $user->id;
+    });
+});
+
+test('onboarding validates the name', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', '')
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('onboarding generates the next available slug', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['name' => 'Acme Corp', 'slug' => 'acme-corp']);
+    Entity::factory()->create(['name' => 'Acme Corp 2', 'slug' => 'acme-corp-2']);
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    expect(Entity::where('name', 'Acme Corp')->latest('id')->first()->slug)->toBe('acme-corp-3');
+});
+
+test('onboarding retries when the slug collides at insert time', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['name' => 'Taken', 'slug' => 'taken']);
+
+    $component = new class extends CreateEntity
+    {
+        public int $calls = 0;
+
+        protected function uniqueSlug(string $name): string
+        {
+            $this->calls++;
+
+            return $this->calls === 1 ? 'taken' : 'eventually-free';
+        }
+    };
+
+    Livewire::actingAs($user)
+        ->test($component)
+        ->set('name', 'Taken')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect(Entity::where('slug', 'eventually-free')->exists())->toBeTrue();
+});
+
+test('the creator is always the owner', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme')
+        ->call('submit');
+
+    $entity = Entity::first();
+
+    expect(EntityMembership::where('entity_id', $entity->id)->sole()->user_id)->toBe($user->id)
+        ->and($entity->owner->user_id)->toBe($user->id);
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..d04fbe5
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,71 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function entityPolicyMembershipFor(Entity $entity, string $role): EntityMembership
+{
+    return EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'role' => UserRole::from($role),
+    ]);
+}
+
+test('entity policy follows membership and role rules', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityPolicyMembershipFor($entity, 'owner')->user;
+    $admin = entityPolicyMembershipFor($entity, 'admin')->user;
+    $employee = entityPolicyMembershipFor($entity, 'employee')->user;
+    $outsider = User::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->create($outsider))->toBeTrue()
+        ->and($policy->view($owner, $entity))->toBeTrue()
+        ->and($policy->view($employee, $entity))->toBeTrue()
+        ->and($policy->view($outsider, $entity))->toBeFalse()
+        ->and($policy->update($owner, $entity))->toBeTrue()
+        ->and($policy->update($admin, $entity))->toBeTrue()
+        ->and($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->delete($admin, $entity))->toBeTrue()
+        ->and($policy->delete($employee, $entity))->toBeFalse()
+        ->and($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse();
+});
+
+test('entity policies are discovered by the gate', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityPolicyMembershipFor($entity, 'owner')->user;
+    $outsider = User::factory()->create();
+
+    expect($owner->can('view', $entity))->toBeTrue()
+        ->and($owner->can('manageSettings', $entity))->toBeTrue()
+        ->and($outsider->can('view', $entity))->toBeFalse()
+        ->and($outsider->can('create', Entity::class))->toBeTrue();
+});
+
+test('membership policy follows ownership and self removal rules', function () {
+    $entity = Entity::factory()->create();
+    $ownerMembership = entityPolicyMembershipFor($entity, 'owner');
+    $adminMembership = entityPolicyMembershipFor($entity, 'admin');
+    $employeeMembership = entityPolicyMembershipFor($entity, 'employee');
+    $outsider = User::factory()->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($employeeMembership->user, $adminMembership))->toBeTrue()
+        ->and($policy->view($outsider, $adminMembership))->toBeFalse()
+        ->and($policy->assignRole($ownerMembership->user, $employeeMembership))->toBeTrue()
+        ->and($policy->assignRole($adminMembership->user, $employeeMembership))->toBeTrue()
+        ->and($policy->assignRole($employeeMembership->user, $employeeMembership))->toBeFalse()
+        ->and($policy->delete($ownerMembership->user, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($employeeMembership->user, $employeeMembership))->toBeTrue()
+        ->and($policy->delete($adminMembership->user, $employeeMembership))->toBeTrue()
+        ->and($policy->delete($employeeMembership->user, $adminMembership))->toBeFalse()
+        ->and($policy->delete($outsider, $employeeMembership))->toBeFalse();
+});
diff --git a/tests/Feature/EntityTenantTest.php b/tests/Feature/EntityTenantTest.php
new file mode 100644
index 0000000..4f7aa9e
--- /dev/null
+++ b/tests/Feature/EntityTenantTest.php
@@ -0,0 +1,214 @@
+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function tenantJoinEntity(Entity $entity, User $user, UserRole $role = UserRole::Employee): EntityMembership
+{
+    return EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'role' => $role,
+    ]);
+}
+
+test('home sends a user without entities to onboarding', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('home selects the only entity and redirects to its dashboard', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    tenantJoinEntity($entity, $user, UserRole::Owner);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertSessionHas('current_entity_id', $entity->id)
+        ->assertRedirect(route('entity.dashboard', $entity));
+});
+
+test('home sends a user with several entities to the switcher', function () {
+    $user = User::factory()->create();
+    tenantJoinEntity(Entity::factory()->create(), $user, UserRole::Owner);
+    tenantJoinEntity(Entity::factory()->create(), $user);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('the current entity middleware sends users without entities to onboarding', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', Entity::factory()->create()))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('the current entity middleware selects the only membership', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    tenantJoinEntity($entity, $user);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSessionHas('current_entity_id', $entity->id)
+        ->assertSee($entity->name);
+});
+
+test('the current entity middleware sends multiple memberships to the switcher', function () {
+    $user = User::factory()->create();
+    tenantJoinEntity(Entity::factory()->create(), $user, UserRole::Owner);
+    tenantJoinEntity(Entity::factory()->create(), $user);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', Entity::factory()->create()))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('the dashboard shows the current entity name', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Acme Corp']);
+    tenantJoinEntity($entity, $user, UserRole::Owner);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $entity->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Acme Corp');
+});
+
+test('the dashboard rejects an entity the user does not belong to even with another session entity', function () {
+    $user = User::factory()->create();
+    $allowed = Entity::factory()->create();
+    $forbidden = Entity::factory()->create();
+    tenantJoinEntity($allowed, $user, UserRole::Owner);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $allowed->id])
+        ->get(route('entity.dashboard', $forbidden))
+        ->assertForbidden();
+});
+
+test('the middleware rejects a session entity the user does not belong to', function () {
+    $user = User::factory()->create();
+    $own = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    tenantJoinEntity($own, $user, UserRole::Owner);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $other->id])
+        ->get(route('entity.dashboard', $own))
+        ->assertForbidden();
+});
+
+test('picking an entity updates the session, writes an audit log and redirects', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    tenantJoinEntity($entity, $user, UserRole::Admin);
+    Event::fake([MessageLogged::class]);
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id)
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($entity, $user) {
+        return $log->level === 'info'
+            && $log->context['entity_id'] === $entity->id
+            && $log->context['actor_id'] === $user->id;
+    });
+});
+
+test('picking a foreign entity is forbidden and leaves the session untouched', function () {
+    $user = User::factory()->create();
+    $own = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    tenantJoinEntity($own, $user, UserRole::Owner);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $own->id])
+        ->post(route('entity.pick', $other))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $own->id);
+});
+
+test('the switcher lists only the users entities and marks the current one', function () {
+    $user = User::factory()->create();
+    $first = Entity::factory()->create(['name' => 'First Entity']);
+    $second = Entity::factory()->create(['name' => 'Second Entity']);
+    $foreign = Entity::factory()->create(['name' => 'Foreign Entity']);
+    tenantJoinEntity($first, $user, UserRole::Owner);
+    tenantJoinEntity($second, $user);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $first->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Trocar de entidade')
+        ->assertSee('First Entity')
+        ->assertSee('Second Entity')
+        ->assertDontSee('Foreign Entity')
+        ->assertSee('button is-fullwidth is-link', false)
+        ->assertSee('data-current="1"', false)
+        ->assertSee('button is-fullwidth is-light', false);
+});
+
+test('the navbar shows the switcher link only for users with more than one membership', function () {
+    $single = User::factory()->create();
+    $singleEntity = Entity::factory()->create(['name' => 'Single']);
+    tenantJoinEntity($singleEntity, $single, UserRole::Owner);
+
+    $this->actingAs($single)
+        ->withSession(['current_entity_id' => $singleEntity->id])
+        ->get(route('entity.dashboard', $singleEntity))
+        ->assertDontSee(route('entity.switcher'));
+
+    $multi = User::factory()->create();
+    $first = Entity::factory()->create();
+    tenantJoinEntity($first, $multi, UserRole::Owner);
+    tenantJoinEntity(Entity::factory()->create(), $multi);
+
+    $this->actingAs($multi)
+        ->withSession(['current_entity_id' => $first->id])
+        ->get(route('entity.dashboard', $first))
+        ->assertSee(route('entity.switcher'));
+});
+
+test('guests are redirected from tenant pages', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.switcher'))->assertRedirect(route('login'));
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+});
+
+test('the dashboard component authorizes its entity argument directly', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Direct Dashboard']);
+    tenantJoinEntity($entity, $user);
+
+    Livewire::actingAs($user)
+        ->test(Dashboard::class, ['entity' => $entity])
+        ->assertSee('Direct Dashboard');
+
+    $foreign = Entity::factory()->create();
+
+    Livewire::actingAs($user)
+        ->test(Dashboard::class, ['entity' => $foreign])
+        ->assertForbidden();
+});
