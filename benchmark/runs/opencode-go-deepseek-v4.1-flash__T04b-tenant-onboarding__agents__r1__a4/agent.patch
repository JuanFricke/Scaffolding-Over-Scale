+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Any authenticated user may start their own entity.
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    /**
+     * Any member of the entity may view it.
+     */
+    public function view(User $user, Entity $entity): bool
+    {
+        return $this->roleFor($user, $entity) !== null;
+    }
+
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->isManager($this->roleFor($user, $entity));
+    }
+
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->isManager($this->roleFor($user, $entity));
+    }
+
+    /**
+     * Only the owner manages entity settings (ownership, billing, deletion).
+     */
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $this->roleFor($user, $entity) === UserRole::Owner;
+    }
+
+    protected function roleFor(User $user, Entity $entity): ?UserRole
+    {
+        return $user->membershipFor($entity->id)?->role;
+    }
+
+    protected function isManager(?UserRole $role): bool
+    {
+        return in_array($role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
