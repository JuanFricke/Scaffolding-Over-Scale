@@ -0,0 +1,54 @@
+name: Deploy Dev
+
+on:
+  push:
+    branches: [main, master]
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: Git ref to deploy
+        required: false
+        type: string
+      skip_tests:
+        description: Skip the Pest gate
+        required: false
+        type: boolean
+        default: false
+  workflow_call:
+    inputs:
+      ref:
+        required: false
+        type: string
+    secrets:
+      HOSTINGER_API:
+        required: true
+
+jobs:
+  deploy:
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.ref || github.ref }}
+
+      - name: Start local stack
+        if: ${{ !inputs.skip_tests }}
+        run: ./bin/pf up
+
+      - name: Pest gate
+        if: ${{ !inputs.skip_tests }}
+        run: ./bin/pf shell php artisan test
+
+      - name: Stop local stack
+        if: ${{ always() && !inputs.skip_tests }}
+        run: ./bin/pf down
+
+      - name: Deploy to the VPS
+        env:
+          HOSTINGER_API: ${{ secrets.HOSTINGER_API }}
+          PF_GIT_REF: ${{ inputs.ref || github.ref_name }}
+        run: ./bin/pf deploy
+
+      - name: Smoke test
+        run: ./bin/pf smoke
