+++ b/app/Livewire/Entity/Settings.php
@@ -0,0 +1,113 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    public $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->entity = $entity;
+
+        Gate::authorize('manageSettings', $entity);
+
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        Gate::authorize('manageSettings', $this->entity);
+
+        $validated = $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => ['required', 'string', 'max:255', Rule::unique('entities', 'slug')->ignore($this->entity->id)],
+        ]);
+
+        $this->entity->update([
+            'name' => $validated['name'],
+            'slug' => $validated['slug'],
+        ]);
+    }
+
+    public function delete(): void
+    {
+        Gate::authorize('manageSettings', $this->entity);
+
+        $entity = $this->entity;
+
+        $entity->memberships()->delete();
+        $entity->delete();
+
+        if (session('current_entity_id') === $entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirect(route('home'));
+    }
+
+    public function transfer(): void
+    {
+        Gate::authorize('manageSettings', $this->entity);
+
+        $target = EntityMembership::where('entity_id', $this->entity->id)
+            ->find($this->targetMembershipId);
+
+        // Must be an admin of this entity other than the caller.
+        $callerMembership = auth()->user()->membershipFor($this->entity->id);
+
+        if (
+            ! $target
+            || $target->role !== UserRole::Admin
+            || $target->user_id === auth()->user()->id
+            || $callerMembership === null
+            || $callerMembership->role !== UserRole::Owner
+        ) {
+            abort(403);
+        }
+
+        // Owner row must still exist.
+        $ownerMembership = $this->entity->memberships()->where('role', UserRole::Owner->value)->first();
+        if (! $ownerMembership || $ownerMembership->id !== $callerMembership->id) {
+            abort(403);
+        }
+
+        \Illuminate\Support\Facades\DB::transaction(function () use ($target, $callerMembership) {
+            $callerMembership->update(['role' => UserRole::Admin->value]);
+            $target->update(['role' => UserRole::Owner->value]);
+        });
+
+        $this->redirect(route('entity.dashboard', ['entity' => $this->entity->fresh()]));
+    }
+
+    public function render(): View
+    {
+        $admins = $this->entity->memberships()
+            ->with('user')
+            ->where('role', UserRole::Admin->value)
+            ->get();
+
+        return view('livewire.entity.settings', [
+            'admins' => $admins,
+        ]);
+    }
+}
