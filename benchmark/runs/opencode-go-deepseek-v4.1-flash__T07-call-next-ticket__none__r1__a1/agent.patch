+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function makeCallNextWaitingTicket(Queue $queue, int $priority, string $issuedAt, array $attributes = []): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create(array_merge([
+        'priority' => $priority,
+        'issued_at' => $issuedAt,
+        'status' => TicketStatus::Waiting,
+    ], $attributes));
+}
+
+function makeCallNextCalledTicket(Queue $queue, int $priority, string $calledAt, array $attributes = []): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create(array_merge([
+        'priority' => $priority,
+        'issued_at' => $calledAt,
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt,
+        'called_by_user_id' => User::factory()->create()->id,
+    ], $attributes));
+}
+
+it('calls the highest priority waiting ticket first', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    $normal = makeCallNextWaitingTicket($queue, 0, '2026-01-01 08:00:00');
+    $priority = makeCallNextWaitingTicket($queue, 10, '2026-01-01 09:00:00');
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($priority->id)
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_by_user_id)->toBe($attendant->id)
+        ->and($called->called_at)->not->toBeNull()
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('orders by priority, then oldest issuance, then lowest id', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    $newerHigh = makeCallNextWaitingTicket($queue, 20, '2026-01-01 09:00:00');
+    $olderHigh = makeCallNextWaitingTicket($queue, 20, '2026-01-01 08:00:00');
+    $olderLow = makeCallNextWaitingTicket($queue, 10, '2026-01-01 07:00:00');
+
+    $first = (new CallNextTicket)($queue, $attendant);
+    $second = (new CallNextTicket)($queue, $attendant);
+    $third = (new CallNextTicket)($queue, $attendant);
+
+    expect($first->id)->toBe($olderHigh->id)
+        ->and($second->id)->toBe($newerHigh->id)
+        ->and($third->id)->toBe($olderLow->id);
+});
+
+it('uses the lowest id when priority and issuance are equal', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    $first = makeCallNextWaitingTicket($queue, 10, '2026-01-01 08:00:00');
+    $second = makeCallNextWaitingTicket($queue, 10, '2026-01-01 08:00:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($first->id)
+        ->and((new CallNextTicket)($queue, $attendant)->id)->toBe($second->id);
+});
+
+it('calls only priority tickets in priority_only mode', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    $normal = makeCallNextWaitingTicket($queue, 0, '2026-01-01 07:00:00');
+    $priority = makeCallNextWaitingTicket($queue, 10, '2026-01-01 09:00:00');
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->id)->toBe($priority->id)
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls the oldest normal ticket in normal_only mode', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    $olderNormal = makeCallNextWaitingTicket($queue, 0, '2026-01-01 07:00:00');
+    $newerNormal = makeCallNextWaitingTicket($queue, 0, '2026-01-01 09:00:00');
+    $priority = makeCallNextWaitingTicket($queue, 20, '2026-01-01 06:00:00');
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly);
+
+    expect($called->id)->toBe($olderNormal->id)
+        ->and($newerNormal->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('forces a normal ticket after three consecutive priority calls in any mode', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:00:00');
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:01:00');
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:02:00');
+
+    $normal = makeCallNextWaitingTicket($queue, 0, '2026-01-01 11:00:00');
+    $priority = makeCallNextWaitingTicket($queue, 20, '2026-01-01 09:00:00');
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($normal->id)
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('does not apply fairness with fewer than three prior calls', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:00:00');
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:01:00');
+
+    makeCallNextWaitingTicket($queue, 0, '2026-01-01 11:00:00');
+    $priority = makeCallNextWaitingTicket($queue, 20, '2026-01-01 09:00:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($priority->id);
+});
+
+it('resets the priority streak when a normal ticket was called', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:00:00');
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:01:00');
+    makeCallNextCalledTicket($queue, 0, '2026-01-01 10:02:00');
+
+    makeCallNextWaitingTicket($queue, 0, '2026-01-01 11:00:00');
+    $priority = makeCallNextWaitingTicket($queue, 20, '2026-01-01 09:00:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($priority->id);
+});
+
+it('counts priority_only calls in the fairness history', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    makeCallNextWaitingTicket($queue, 10, '2026-01-01 08:00:00');
+    makeCallNextWaitingTicket($queue, 10, '2026-01-01 08:01:00');
+    makeCallNextWaitingTicket($queue, 10, '2026-01-01 08:02:00');
+    $normal = makeCallNextWaitingTicket($queue, 0, '2026-01-01 09:00:00');
+    makeCallNextWaitingTicket($queue, 20, '2026-01-01 07:00:00');
+
+    (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+    (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+    (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    // Another priority is still waiting, but the streak now forces the normal.
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($normal->id);
+});
+
+it('keeps calling priority tickets when no normal ticket is waiting', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:00:00');
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:01:00');
+    makeCallNextCalledTicket($queue, 10, '2026-01-01 10:02:00');
+
+    $priority = makeCallNextWaitingTicket($queue, 20, '2026-01-01 09:00:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($priority->id);
+});
+
+it('ignores tickets from other queues and already called tickets', function () {
+    $queue = Queue::factory()->create();
+    $otherQueue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    makeCallNextWaitingTicket($otherQueue, 99, '2026-01-01 06:00:00');
+    makeCallNextCalledTicket($queue, 50, '2026-01-01 10:00:00');
+    $waiting = makeCallNextWaitingTicket($queue, 10, '2026-01-01 08:00:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($waiting->id);
+});
+
+it('rejects an inactive queue using its persisted state', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+    $attendant = User::factory()->create();
+    $ticket = makeCallNextWaitingTicket($queue, 0, '2026-01-01 08:00:00');
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('throws when no ticket is eligible for the requested mode', function (CallMode $mode, array $priorities) {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+
+    foreach ($priorities as $index => $priority) {
+        makeCallNextWaitingTicket($queue, $priority, '2026-01-01 08:0'.$index.':00');
+    }
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, $mode))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect(Ticket::query()->where('status', TicketStatus::Waiting->value)->count())->toBe(count($priorities));
+})->with([
+    'empty queue' => [CallMode::Any, []],
+    'only normals in priority mode' => [CallMode::PriorityOnly, [0, 0]],
+    'only priorities in normal mode' => [CallMode::NormalOnly, [10, 20]],
+]);
+
+it('changes only the call fields on the returned ticket', function () {
+    $queue = Queue::factory()->create();
+    $attendant = User::factory()->create();
+    $ticket = makeCallNextWaitingTicket($queue, 10, '2026-01-01 08:00:00');
+
+    $originalCode = $ticket->code;
+    $originalPriority = $ticket->priority;
+    $originalIssuedAt = $ticket->issued_at;
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->code)->toBe($originalCode)
+        ->and($called->priority)->toBe($originalPriority)
+        ->and($called->issued_at->equalTo($originalIssuedAt))->toBeTrue()
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_at)->not->toBeNull()
+        ->and($called->called_by_user_id)->toBe($attendant->id);
+});
