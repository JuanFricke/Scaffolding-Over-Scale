+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Lock the queue before reading its state: the passed model may be
+            // stale and concurrent calls must be serialized per queue.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            while (true) {
+                $candidateId = $this->nextCandidateId($lockedQueue->id, $mode);
+
+                if ($candidateId === null) {
+                    throw new NoWaitingTicketsException('No waiting ticket is eligible for the requested call mode.');
+                }
+
+                // Ticket::call() does not lock the queue, so the candidate may
+                // have been called after selection. Lock and re-check it before
+                // mutating; if it lost the race, select again.
+                $candidate = Ticket::query()
+                    ->whereKey($candidateId)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($candidate === null || $candidate->status !== TicketStatus::Waiting) {
+                    continue;
+                }
+
+                $candidate->status = TicketStatus::Called;
+                $candidate->called_at = now();
+                $candidate->called_by_user_id = $calledBy->id;
+                $candidate->save();
+
+                return $candidate;
+            }
+        });
+    }
+
+    /**
+     * Resolve the next eligible waiting ticket id.
+     *
+     * This is a locking read so a candidate called concurrently through
+     * Ticket::call() is not hidden by a stale REPEATABLE READ snapshot.
+     */
+    private function nextCandidateId(int $queueId, CallMode $mode): ?int
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting->value);
+
+        if ($mode === CallMode::Any) {
+            $this->applyAnyOrdering($query, $queueId);
+        } elseif ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0)
+                ->orderByDesc('priority')
+                ->orderBy('issued_at')
+                ->orderBy('id');
+        } else {
+            $query->where('priority', 0)
+                ->orderBy('issued_at')
+                ->orderBy('id');
+        }
+
+        $id = $query->lockForUpdate()->value('id');
+
+        return $id === null ? null : (int) $id;
+    }
+
+    /**
+     * Apply full ordering, including the 3-consecutive-priority fairness guard.
+     */
+    private function applyAnyOrdering(Builder $query, int $queueId): void
+    {
+        if ($this->fairnessRequiresNormal($queueId)) {
+            $query->where('priority', 0)
+                ->orderBy('issued_at')
+                ->orderBy('id');
+
+            return;
+        }
+
+        $query->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+    }
+
+    /**
+     * After three consecutive priority calls, a waiting normal ticket takes
+     * precedence. Calls from every mode count in this history.
+     */
+    private function fairnessRequiresNormal(int $queueId): bool
+    {
+        $lastCalls = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called->value)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->get(['priority']);
+
+        if ($lastCalls->count() < 3 || $lastCalls->contains(fn (Ticket $ticket) => $ticket->priority <= 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting->value)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
