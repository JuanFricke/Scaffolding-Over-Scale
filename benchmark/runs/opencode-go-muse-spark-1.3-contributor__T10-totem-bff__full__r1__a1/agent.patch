+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('answers preflight from a localhost origin with the requesting origin', function () {
+    $response = $this->call(
+        'OPTIONS', '/api/totem/auth', [],
+        [], [],
+        ['HTTP_ORIGIN' => 'http://localhost:8081', 'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST']
+    );
+
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+});
+
+it('echoes loopback origins on actual api responses', function () {
+    foreach (['http://localhost:3000', 'https://127.0.0.1:8443'] as $origin) {
+        $preset = TotemPreset::factory()->create();
+
+        $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code], ['Origin' => $origin]);
+        $response->assertOk();
+        expect($response->headers->get('Access-Control-Allow-Origin'))->toBe($origin);
+    }
+});
+
+it('sends no allow-origin header for foreign origins', function () {
+    $response = $this->postJson('/api/totem/auth', ['code' => '000000'], ['Origin' => 'https://evil.example.com']);
+
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+});
+
+it('allows the configured TOTEM_WEB_ORIGIN', function () {
+    config(['cors.allowed_origins' => ['https://totem.pegafila.xyz']]);
+
+    $response = $this->call(
+        'OPTIONS', '/api/totem/auth', [],
+        [], [],
+        ['HTTP_ORIGIN' => 'https://totem.pegafila.xyz', 'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST']
+    );
+
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('https://totem.pegafila.xyz');
+});
