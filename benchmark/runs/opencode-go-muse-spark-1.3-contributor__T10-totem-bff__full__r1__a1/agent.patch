+<?php
+
+namespace App\Totem;
+
+/**
+ * Backend-owned priority levels — the single source used both by the
+ * priorities endpoint and by ticket-issuance validation.
+ */
+final class TotemPriorities
+{
+    /**
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function all(): array
+    {
+        return [
+            ['value' => 0, 'label' => 'Normal', 'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1]],
+            ['value' => 10, 'label' => 'Prioritário', 'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2]],
+            ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => ['color' => '#1565C0', 'icon' => 'priority-plus', 'order' => 3]],
+        ];
+    }
+
+    /**
+     * @return list<int>
+     */
+    public static function values(): array
+    {
+        return array_column(self::all(), 'value');
+    }
+
+    /**
+     * @return array{value: int, label: string, visual: array{color: string, icon: string, order: int}}|null
+     */
+    public static function find(int $value): ?array
+    {
+        foreach (self::all() as $priority) {
+            if ($priority['value'] === $value) {
+                return $priority;
+            }
+        }
+
+        return null;
+    }
+}
