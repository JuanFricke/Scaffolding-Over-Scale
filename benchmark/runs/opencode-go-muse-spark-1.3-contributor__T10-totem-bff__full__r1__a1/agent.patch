+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+
+uses(RefreshDatabase::class);
+
+function pairToken(TotemPreset $preset, string $code): string
+{
+    $response = test()->postJson('/api/totem/auth', ['code' => $code]);
+
+    $response->assertOk();
+
+    return $response->json('token');
+}
+
+it('generates a pairing code with a 10 minute window', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => null,
+        'login_code_expires_at' => null,
+    ]);
+
+    $exit = Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+    $output = Artisan::output();
+
+    expect($exit)->toBe(0)
+        ->and($output)->toMatch('/\d{6}/');
+
+    $preset->refresh();
+
+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->login_code_expires_at)->not->toBeNull();
+
+    $skew = $preset->login_code_expires_at->diffInSeconds(now()->addMinutes(10), true);
+    expect($skew)->toBeLessThan(60);
+});
+
+it('regenerating a pairing code replaces the previous one', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $first = $preset->login_code;
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    expect($preset->refresh()->login_code)->not->toBe($first)
+        ->and($preset->login_code_consumed_at)->toBeNull();
+});
+
+it('fails the pairing command for an unknown preset', function () {
+    $exit = Artisan::call('totem:pairing-code', ['preset' => 999999]);
+
+    expect($exit)->not->toBe(0)
+        ->and(Artisan::output())->not->toBe('');
+});
+
+it('pairs with a valid code and returns a bearer token with the entity', function () {
+    $preset = TotemPreset::factory()->create();
+    $preset->queues()->attach(Queue::factory()->for($preset->entity)->create());
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonStructure(['token', 'token_type', 'expires_in', 'entity' => ['slug', 'name']])
+        ->assertJson([
+            'token_type' => 'Bearer',
+            'expires_in' => 3600,
+            'entity' => ['slug' => $preset->entity->slug, 'name' => $preset->entity->name],
+        ]);
+
+    expect($response->json('token'))->toBeString()->not->toBe('');
+
+    $preset->refresh();
+    expect($preset->login_code_consumed_at)->not->toBeNull();
+
+    $totem = Totem::query()->where('entity_id', $preset->entity_id)->firstOrFail();
+    expect($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull();
+});
+
+it('rejects a consumed pairing code', function () {
+    $preset = TotemPreset::factory()->create();
+    $code = $preset->login_code;
+
+    $this->postJson('/api/totem/auth', ['code' => $code])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => $code])->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('rejects malformed pairing codes with invalid_code_format', function ($code) {
+    TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $code])->assertStatus(400)
+        ->assertJson(['code' => 'invalid_code_format']);
+})->with([
+    'empty' => [''],
+    'missing' => [null],
+    'short' => ['12345'],
+    'long' => ['1234567'],
+    'letters' => ['abcdef'],
+    'mixed' => ['12a456'],
+]);
+
+it('rejects unknown, expired and inactive-preset codes with the same 401', function () {
+    $expired = TotemPreset::factory()->create(['login_code_expires_at' => now()->subMinute()]);
+    $consumed = TotemPreset::factory()->create(['login_code_consumed_at' => now()]);
+    $inactive = TotemPreset::factory()->create(['is_active' => false]);
+
+    foreach ([$expired->login_code, $consumed->login_code, $inactive->login_code, '000000'] as $code) {
+        $this->postJson('/api/totem/auth', ['code' => $code])->assertStatus(401)
+            ->assertJson(['code' => 'invalid_pairing_code']);
+    }
+});
+
+it('rate limits pairing attempts', function () {
+    $preset = TotemPreset::factory()->create();
+
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(429)
+        ->assertJson(['code' => 'rate_limited']);
+});
+
+it('ignores billing state and never sends entity_suspended', function () {
+    $preset = TotemPreset::factory()->create();
