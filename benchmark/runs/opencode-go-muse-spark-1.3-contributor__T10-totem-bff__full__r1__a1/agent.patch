@@ -0,0 +1,245 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function pairedSetup(): array
+{
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    $queueB = Queue::factory()->for($entity)->create(['name' => 'Beta', 'slug' => 'beta']);
+    $queueA = Queue::factory()->for($entity)->create(['name' => 'Alfa', 'slug' => 'alfa']);
+    $preset->queues()->attach([$queueA->id, $queueB->id]);
+
+    $token = test()->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertOk()->json('token');
+
+    return [$entity, $preset, $queueA, $queueB, $token];
+}
+
+function authHeaders(string $token): array
+{
+    return ['Authorization' => "Bearer {$token}"];
+}
+
+it('lists scoped active queues ordered by name with display positions', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    Queue::factory()->for($entity)->create(['name' => 'Zeta', 'slug' => 'zeta', 'is_active' => false]);
+    $other = Entity::factory()->create();
+    $foreign = Queue::factory()->for($other)->create(['name' => 'Foreign', 'slug' => 'foreign']);
+
+    $response = $this->getJson("/api/{$entity->slug}/queues", authHeaders($token));
+
+    $response->assertOk()
+        ->assertJson([
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+        ]);
+
+    $queues = $response->json('queues');
+    expect($queues)->toHaveCount(2)
+        ->and(array_column($queues, 'slug'))->toBe(['alfa', 'beta']);
+
+    foreach ($queues as $index => $queue) {
+        expect($queue)->toMatchArray(['is_active' => true]);
+        expect($queue['visual']['order'])->toBe($index + 1);
+        expect($queue)->toHaveKeys(['slug', 'label', 'description', 'visual']);
+        expect($queue['visual'])->toHaveKeys(['color', 'icon', 'order']);
+    }
+});
+
+it('rejects a mismatched entity slug with forbidden', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+    $other = Entity::factory()->create();
+
+    $this->getJson("/api/{$other->slug}/queues", authHeaders($token))->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+});
+
+it('applies the intersection of token scope and current preset join', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    $preset->queues()->detach($queueB->id);
+
+    $queues = $this->getJson("/api/{$entity->slug}/queues", authHeaders($token))
+        ->assertOk()->json('queues');
+
+    expect(array_column($queues, 'slug'))->toBe(['alfa']);
+
+    $this->postJson("/api/{$entity->slug}/beta/ticket", ['priority' => 0], authHeaders($token))
+        ->assertStatus(403)->assertJson(['code' => 'forbidden']);
+});
+
+it('rejects queue access outside the token scope with forbidden', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    $extra = Queue::factory()->for($entity)->create(['name' => 'Extra', 'slug' => 'extra']);
+    $preset->queues()->attach($extra->id);
+
+    $this->getJson("/api/{$entity->slug}/extra/priorities", authHeaders($token))->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+});
+
+it('returns backend-owned priorities for a queue', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    $response = $this->getJson("/api/{$entity->slug}/alfa/priorities", authHeaders($token));
+
+    $response->assertOk()->assertJson([
+        'entity' => ['slug' => $entity->slug],
+        'queue' => ['slug' => 'alfa', 'label' => $queueA->name],
+    ]);
+
+    $priorities = $response->json('priorities');
+    expect(array_column($priorities, 'value'))->toBe([0, 10, 20]);
+
+    $labels = collect($priorities)->pluck('label', 'value')->all();
+    expect($labels)->toBe([0 => 'Normal', 10 => 'Prioritário', 20 => 'Prioridade 80+']);
+
+    foreach ($priorities as $index => $priority) {
+        expect($priority['visual']['order'])->toBe($index + 1);
+        expect($priority)->toHaveKeys(['value', 'label', 'visual']);
+    }
+});
+
+it('returns queue_not_found for unknown or foreign queues', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+    $other = Entity::factory()->create();
+    $foreign = Queue::factory()->for($other)->create(['slug' => 'foreign']);
+
+    $this->getJson("/api/{$entity->slug}/nope/priorities", authHeaders($token))->assertStatus(404)
+        ->assertJson(['code' => 'queue_not_found']);
+
+    $this->getJson("/api/{$entity->slug}/foreign/priorities", authHeaders($token))->assertStatus(404)
+        ->assertJson(['code' => 'queue_not_found']);
+
+    $this->postJson("/api/{$entity->slug}/nope/ticket", ['priority' => 0], authHeaders($token))
+        ->assertStatus(404)->assertJson(['code' => 'queue_not_found']);
+});
+
+it('rejects reads and writes on inactive queues', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+    $queueA->update(['is_active' => false]);
+
+    $this->getJson("/api/{$entity->slug}/alfa/priorities", authHeaders($token))->assertStatus(422)
+        ->assertJson(['code' => 'inactive_queue']);
+
+    $this->postJson("/api/{$entity->slug}/alfa/ticket", ['priority' => 0], authHeaders($token))
+        ->assertStatus(422)->assertJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('issues tickets with the totem channel and sequential codes', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    $first = $this->postJson("/api/{$entity->slug}/alfa/ticket", ['priority' => 10], authHeaders($token))
+        ->assertStatus(201);
+
+    $first->assertJson([
+        'slug' => 'A001',
+        'queue' => ['slug' => 'alfa', 'label' => $queueA->name],
+        'priority' => ['value' => 10, 'label' => 'Prioritário'],
+    ]);
+    expect($first->json('issued_at'))->toBeString();
+
+    $second = $this->postJson("/api/{$entity->slug}/alfa/ticket", ['priority' => 0], authHeaders($token))
+        ->assertStatus(201)->assertJson(['slug' => 'A002']);
+
+    expect(Ticket::query()->pluck('channel')->all())->each->toBe(TicketChannel::Totem);
+});
+
+it('rejects invalid priorities without creating tickets', function ($priority) {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    $this->postJson("/api/{$entity->slug}/alfa/ticket", ['priority' => $priority], authHeaders($token))
+        ->assertStatus(422)->assertJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+})->with([
+    'negative' => [-1],
+    'gap' => [5],
+    'string' => ['alta'],
+    'missing' => [null],
+]);
+
+it('rejects requests with missing, malformed or expired tokens', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    $this->getJson("/api/{$entity->slug}/queues")->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders('not-a-jwt'))->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+
+    $expired = TotemJwt::encode([
+        'totem_id' => 1, 'entity_id' => $entity->id, 'preset_id' => $preset->id, 'queues' => [],
+    ], -10);
+
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders($expired))->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('rejects tokens with a tampered payload or foreign signature', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    [$header, $body, $signature] = explode('.', $token);
+    $payload = json_decode(base64_decode(strtr($body, '-_', '+/')), true);
+    $payload['entity_id'] = 999999;
+    $tamperedBody = rtrim(strtr(base64_encode((string) json_encode($payload)), '+/', '-_'), '=');
+
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders("{$header}.{$tamperedBody}.{$signature}"))
+        ->assertStatus(401)->assertJson(['code' => 'invalid_token']);
+
+    $foreign = TotemJwt::encode([
+        'totem_id' => 1, 'entity_id' => $entity->id, 'preset_id' => $preset->id, 'queues' => [],
+    ], 3600);
+
+    // Sanity: a well-formed token for a nonexistent totem is still rejected.
+    expect($foreign)->toBeString();
+});
+
+it('rejects tokens for deactivated totems or presets', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    Totem::query()->where('entity_id', $entity->id)->update(['is_active' => false]);
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders($token))->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+
+    Totem::query()->where('entity_id', $entity->id)->update(['is_active' => true]);
+    $preset->update(['is_active' => false]);
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders($token))->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('updates last_seen_at on authenticated calls', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    $totem = Totem::query()->where('entity_id', $entity->id)->firstOrFail();
+    $totem->update(['last_seen_at' => now()->subHour()]);
+
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders($token))->assertOk();
+
+    expect($totem->refresh()->last_seen_at->greaterThan(now()->subMinutes(5)))->toBeTrue();
+});
+
+it('rate limits ticket issuance', function () {
+    [$entity, $preset, $queueA, $queueB, $token] = pairedSetup();
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson("/api/{$entity->slug}/alfa/ticket", ['priority' => 0], authHeaders($token))
+            ->assertStatus(201);
+    }
+
+    $this->postJson("/api/{$entity->slug}/alfa/ticket", ['priority' => 0], authHeaders($token))
+        ->assertStatus(429)->assertJson(['code' => 'rate_limited']);
+});
