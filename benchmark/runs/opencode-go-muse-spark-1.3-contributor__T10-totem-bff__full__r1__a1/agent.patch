+<?php
+
+use App\Http\Controllers\TotemAuthController;
+use App\Http\Controllers\TotemQueueController;
+use Illuminate\Support\Facades\Route;
+
+Route::post('totem/auth', [TotemAuthController::class, 'store'])
+    ->middleware('throttle:totem-auth');
+
+Route::middleware('totem.auth')->group(function (): void {
+    Route::get('{entity}/queues', [TotemQueueController::class, 'queues']);
+    Route::get('{entity}/{queue}/priorities', [TotemQueueController::class, 'priorities']);
+    Route::post('{entity}/{queue}/ticket', [TotemQueueController::class, 'ticket'])
+        ->middleware('throttle:totem-ticket');
+});
