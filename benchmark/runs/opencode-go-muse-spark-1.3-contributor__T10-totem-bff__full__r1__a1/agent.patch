@@ -0,0 +1,77 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Throwable;
+
+/**
+ * Validates the totem Bearer JWT on every call: malformed/expired token,
+ * missing or inactive totem, missing or inactive preset, or an entity
+ * mismatch between claims, totem and preset all yield invalid_token.
+ *
+ * The effective queue scope is the intersection of the JWT queues claim
+ * with the preset's current queue join, so removing a queue from the
+ * preset takes effect immediately for existing tokens.
+ */
+class TotemAuth
+{
+    /**
+     * Validate the totem Bearer JWT and scope the request to its claims.
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+        $claims = $token === null ? null : TotemJwt::decode($token);
+
+        if ($claims === null) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $totem = Totem::query()->find($claims['totem_id']);
+        $preset = TotemPreset::query()->find($claims['preset_id']);
+        $entity = Entity::query()->find($claims['entity_id']);
+
+        if (! $totem || ! $preset || ! $entity) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        if (! $totem->is_active || ! $preset->is_active) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        if ($totem->entity_id !== $entity->id || $preset->entity_id !== $entity->id) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $claimQueues = array_values(array_unique(array_map(
+            'intval',
+            is_array($claims['queues'] ?? null) ? $claims['queues'] : []
+        )));
+
+        $currentPresetQueues = $preset->queues()->pluck('queues.id')->map(
+            fn ($id): int => (int) $id
+        )->all();
+
+        $scope = array_values(array_intersect($claimQueues, $currentPresetQueues));
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_scope', $scope);
+
+        try {
+            $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+        } catch (Throwable) {
+            // Presence tracking must never break an authenticated call.
+        }
+
+        return $next($request);
+    }
+}
