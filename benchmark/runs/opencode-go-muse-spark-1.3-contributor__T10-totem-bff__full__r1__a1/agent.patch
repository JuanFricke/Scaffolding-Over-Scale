diff --git a/app/Support/TotemJwt.php b/app/Support/TotemJwt.php
new file mode 100644
index 0000000..5ab3971
--- /dev/null
+++ b/app/Support/TotemJwt.php
@@ -0,0 +1,95 @@
+<?php
+
+namespace App\Support;
+
+use UnexpectedValueException;
+
+/**
+ * Minimal, correct HS256 JWT codec for totem device tokens.
+ *
+ * Claims: totem_id, entity_id, preset_id, queues (allowed queue ids at
+ * pairing time), iat, exp, jti. No external dependency on purpose.
+ */
+final class TotemJwt
+{
+    /**
+     * @param  array<string, mixed>  $claims
+     */
+    public static function encode(array $claims, ?int $ttl = null): string
+    {
+        $now = time();
+        $payload = array_merge($claims, [
+            'iat' => $now,
+            'exp' => $now + ($ttl ?? (int) config('services.totem.jwt_ttl', 3600)),
+            'jti' => bin2hex(random_bytes(16)),
+        ]);
+
+        $header = self::base64UrlEncode((string) json_encode(['alg' => 'HS256', 'typ' => 'JWT']));
+        $body = self::base64UrlEncode((string) json_encode($payload));
+        $signature = self::base64UrlEncode(hash_hmac('sha256', "{$header}.{$body}", self::secret(), true));
+
+        return "{$header}.{$body}.{$signature}";
+    }
+
+    /**
+     * @return array<string, mixed>|null Null when malformed, mis-signed or expired.
+     */
+    public static function decode(string $token): ?array
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            return null;
+        }
+
+        [$header, $body, $signature] = $parts;
+
+        $expected = self::base64UrlEncode(hash_hmac('sha256', "{$header}.{$body}", self::secret(), true));
+
+        if (! hash_equals($expected, $signature)) {
+            return null;
+        }
+
+        $decodedHeader = json_decode(self::base64UrlDecode($header), true);
+        $payload = json_decode(self::base64UrlDecode($body), true);
+
+        if (! is_array($decodedHeader) || ($decodedHeader['alg'] ?? null) !== 'HS256' || ! is_array($payload)) {
+            return null;
+        }
+
+        foreach (['totem_id', 'entity_id', 'preset_id', 'exp'] as $claim) {
+            if (! array_key_exists($claim, $payload)) {
+                return null;
+            }
+        }
+
+        if (! is_numeric($payload['exp']) || (int) $payload['exp'] < time()) {
+            return null;
+        }
+
+        return $payload;
+    }
+
+    private static function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if ($secret === '') {
+            throw new UnexpectedValueException('Totem JWT secret is not configured (TOTEM_JWT_SECRET).');
+        }
+
+        return $secret;
+    }
+
