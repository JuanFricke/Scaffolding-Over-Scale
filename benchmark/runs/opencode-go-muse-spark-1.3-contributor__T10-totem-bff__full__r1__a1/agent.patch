@@ -0,0 +1,96 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Totem pairing login: exchanges a single-use preset code for a JWT.
+ */
+class TotemAuthController extends Controller
+{
+    /**
+     * Exchange a single-use preset pairing code for a scoped JWT.
+     */
+    public function store(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (is_int($code)) {
+            $code = (string) $code;
+        }
+
+        if (! is_string($code) || preg_match('/^\d{6}$/', $code) !== 1) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $result = DB::transaction(function () use ($code) {
+            /** @var TotemPreset|null $preset */
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (! $preset || ! $preset->is_active
+                || $preset->login_code_expires_at === null
+                || $preset->login_code_expires_at->isPast()
+                || $preset->login_code_consumed_at !== null) {
+                return null;
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = $preset->entity->totems()->create([
+                'name' => "Totem {$preset->name}",
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()->pluck('queues.id')->map(
+                fn ($id): int => (int) $id
+            )->all();
+
+            $ttl = (int) config('services.totem.jwt_ttl', 3600);
+
+            $token = TotemJwt::encode([
+                'totem_id' => $totem->id,
+                'entity_id' => $preset->entity_id,
+                'preset_id' => $preset->id,
+                'queues' => $queueIds,
+            ], $ttl);
+
+            return [$preset, $totem, $token, $ttl];
+        });
+
+        if ($result === null) {
+            Log::channel('audit')->warning('Totem pairing failed', [
+                'code_hint' => '****'.substr($code, -2),
+            ]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        [$preset, $totem, $token, $ttl] = $result;
+
+        Log::channel('audit')->info('Totem paired', [
+            'preset_id' => $preset->id,
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => $ttl,
+            'entity' => [
+                'slug' => $preset->entity->slug,
+                'name' => $preset->entity->name,
+            ],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/TotemQueueController.php b/app/Http/Controllers/TotemQueueController.php
new file mode 100644
index 0000000..b3e5a53
--- /dev/null
+++ b/app/Http/Controllers/TotemQueueController.php
@@ -0,0 +1,169 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Totem\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Authenticated totem endpoints (middleware totem.auth).
+ */
+class TotemQueueController extends Controller
+{
+    /**
+     * @return array<string, mixed>
+     */
+    private function queueVisual(Queue $queue, int $order): array
+    {
+        $labels = is_array($queue->labels_i18n) ? $queue->labels_i18n : [];
+
+        return [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => is_string($labels['description'] ?? null) ? $labels['description'] : '',
+            'visual' => [
+                'color' => is_string($labels['color'] ?? null) ? $labels['color'] : '#0055FF',
+                'icon' => is_string($labels['icon'] ?? null) ? $labels['icon'] : 'ticket',
+                'order' => $order,
+            ],
+            'is_active' => true,
+        ];
+    }
+
+    private function entityMismatch(Request $request, Entity $entity): ?JsonResponse
+    {
+        /** @var Entity $tokenEntity */
+        $tokenEntity = $request->attributes->get('totem_entity');
+
+        if ($entity->id !== $tokenEntity->id) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return null;
+    }
+
+    /**
+     * Resolve a queue slug within the entity and the effective token scope.
+     *
+     * @return array{0: JsonResponse|Queue}
+     */
+    private function resolveQueue(Request $request, Entity $entity, string $queueSlug): array
+    {
+        $queue = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $queueSlug)
+            ->first();
+
+        if (! $queue) {
+            return [response()->json(['code' => 'queue_not_found'], 404)];
+        }
+
+        /** @var list<int> $scope */
+        $scope = $request->attributes->get('totem_scope', []);
+
+        if (! in_array($queue->id, $scope, true)) {
+            return [response()->json(['code' => 'forbidden'], 403)];
+        }
+
+        return [$queue];
+    }
+
+    /**
+     * List the preset-scoped active queues of the token's entity.
+     */
+    public function queues(Request $request, Entity $entity): JsonResponse
+    {
+        if ($denied = $this->entityMismatch($request, $entity)) {
+            return $denied;
+        }
+
+        /** @var list<int> $scope */
+        $scope = $request->attributes->get('totem_scope', []);
+
+        $queues = Queue::query()
+            ->whereIn('id', $scope)
+            ->where('entity_id', $entity->id)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        $payload = $queues->values()->map(
+            fn (Queue $queue, int $index): array => $this->queueVisual($queue, $index + 1)
+        )->all();
+
+        return response()->json([
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+            'queues' => $payload,
+        ]);
+    }
+
+    /**
+     * List the backend-owned priority levels for one scoped queue.
+     */
+    public function priorities(Request $request, Entity $entity, string $queue): JsonResponse
+    {
+        if ($denied = $this->entityMismatch($request, $entity)) {
+            return $denied;
+        }
+
+        [$resolved] = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        if (! $resolved->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $entity->slug],
+            'queue' => ['slug' => $resolved->slug, 'label' => $resolved->name],
+            'priorities' => TotemPriorities::all(),
+        ]);
+    }
+
+    /**
+     * Issue a ticket in one scoped queue via the IssueTicket domain action.
+     */
+    public function ticket(Request $request, Entity $entity, string $queue, IssueTicket $issue): JsonResponse
+    {
+        if ($denied = $this->entityMismatch($request, $entity)) {
+            return $denied;
+        }
+
+        [$resolved] = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        $priority = $request->input('priority');
+        $validated = filter_var($priority, FILTER_VALIDATE_INT);
+
+        if ($validated === false || TotemPriorities::find((int) $validated) === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = $issue($resolved, (int) $validated, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priorityEntry = TotemPriorities::find($ticket->priority);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $resolved->slug, 'label' => $resolved->name],
+            'priority' => ['value' => $ticket->priority, 'label' => $priorityEntry['label']],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+}
