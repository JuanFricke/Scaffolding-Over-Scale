@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\ValidationException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Support\Str;
+use Illuminate\Database\QueryException;
+
+class CreateQueue
+{
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        $name = trim($name);
+        if ($name === '' || strlen($name) > 255) {
+            throw ValidationException::withMessages([
+                'name' => ['The name must be between 1 and 255 characters.'],
+            ]);
+        }
+
+        $slug = $slug !== null ? trim($slug) : $name;
+        $slug = Str::slug($slug);
+
+        // Validate uniqueness within entity
+        if (Queue::where('entity_id', $entity->id)->where('slug', $slug)->exists()) {
+            throw ValidationException::withMessages([
+                'slug' => ['The slug has already been taken for this entity.'],
+            ]);
+        }
+
+        try {
+            return Queue::create([
+                'entity_id' => $entity->id,
+                'name' => $name,
+                'slug' => $slug,
+                'is_active' => true,
+            ]);
+        } catch (QueryException $e) {
+            // Unique index race
+            throw ValidationException::withMessages([
+                'slug' => ['The slug has already been taken for this entity.'],
+            ]);
+        }
+    }
+}
diff --git a/app/Actions/SetQueueAccess.php b/app/Actions/SetQueueAccess.php
new file mode 100644
index 0000000..0bba932
--- /dev/null
+++ b/app/Actions/SetQueueAccess.php
@@ -0,0 +1,72 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Exceptions\AuthorizationException;
+use App\Exceptions\ValidationException;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use App\Models\Queue;
+use App\Models\User;
+use App\Models\QueueAccess;
+use App\Models\UserRole;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Database\Eloquent\Model;
+
+class SetQueueAccess
+{
+    public function __invoke(EntityMembership $targetMembership, Queue $queue, User $actor, array $permissions): void
+    {
+        // Ensure same entity
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity' => ['Membership and queue belong to different entities.'],
+            ]);
+        }
+
+        // Validate actor is owner/admin of the entity
+        $isManager = EntityMembership::where('entity_id', $queue->entity_id)
+            ->where('user_id', $actor->id)
+            ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+            ->exists();
+        if (! $isManager) {
+            throw new AuthorizationException('Only managers can modify queue access.');
+        }
+
+        // Validate permissions array
+        foreach ($permissions as $perm) {
+            if (! is_string($perm) || ! in_array($perm, Arr::pluck(QueuePermission::cases(), 'value'), true)) {
+                throw ValidationException::withMessages([
+                    'permissions' => ['Invalid permission value.'],
+                ]);
+            }
+        }
+
+        $row = QueueAccess::firstOrNew([
+            'entity_membership_id' => $targetMembership->id,
+            'queue_id' => $queue->id,
+        ]);
+
+        if ($permissions === []) {
+            // Revoke
+            if ($row->exists) {
+                $row->delete();
+                Log::channel('audit')->info('queue.access.revoked', [
+                    'actor_id' => $actor->id,
+                    'queue_id' => $queue->id,
+                    'entity_membership_id' => $targetMembership->id,
+                ]);
+            }
+        } else {
+            $row->permissions = $permissions;
+            $row->save();
+            Log::channel('audit')->info('queue.access.granted', [
+                'actor_id' => $actor->id,
+                'queue_id' => $queue->id,
+                'entity_membership_id' => $targetMembership->id,
+            ]);
+        }
+    }
+}
