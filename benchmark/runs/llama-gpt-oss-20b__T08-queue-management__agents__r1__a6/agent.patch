diff --git a/app/Policies/QueuePolicy.php b/app/Policies/QueuePolicy.php
new file mode 100644
index 0000000..634fc55
--- /dev/null
+++ b/app/Policies/QueuePolicy.php
@@ -0,0 +1,72 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use App\Enums\QueuePermission;
+use App\Models\UserRole;
+use Illuminate\Support\Arr;
+use Illuminate\Contracts\Auth\HandlesAuthorization;
+
+class QueuePolicy
+{
+    use HandlesAuthorization;
+
+    /**
+     * Determine whether the user can create a queue for the given entity.
+     */
+    public function create(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    /**
+     * Determine whether the user can update the queue.
+     */
+    public function update(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, $queue->entity);
+    }
+
+    /**
+     * Determine whether the user can manage access for the queue.
+     */
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, $queue->entity);
+    }
+
+    /**
+     * Determine whether the user can call the queue.
+     */
+    public function call(User $user, Queue $queue): bool
+    {
+        // Manager always allowed
+        if ($this->isManager($user, $queue->entity)) {
+            return true;
+        }
+
+        // Employee with call permission
+        $access = $queue->access()->whereHas('membership', function ($q) use ($user, $queue) {
+            $q->where('entity_id', $queue->entity_id)
+                ->where('user_id', $user->id);
+        })->first();
+
+        if ($access && is_array($access->permissions) && in_array(QueuePermission::Call->value, $access->permissions, true)) {
+            return true;
+        }
+
+        return false;
+    }
+
+    protected function isManager(User $user, Entity $entity): bool
+    {
+        return EntityMembership::where('entity_id', $entity->id)
+            ->where('user_id', $user->id)
+            ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+            ->exists();
+    }
+}
