@@ -0,0 +1,57 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\ValidationException;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Support\Str;
+use Illuminate\Database\QueryException;
+
+class UpdateQueue
+{
+    public function __invoke(Queue $queue, User $actor, ?string $name = null, ?string $slug = null, ?bool $isActive = null): Queue
+    {
+        $attributes = [];
+
+        if ($name !== null) {
+            $trimmed = trim($name);
+            if ($trimmed === '' || strlen($trimmed) > 255) {
+                throw ValidationException::withMessages([
+                    'name' => ['The name must be between 1 and 255 characters.'],
+                ]);
+            }
+            $attributes['name'] = $trimmed;
+        }
+
+        if ($slug !== null) {
+            $slug = trim($slug);
+            $slug = Str::slug($slug);
+            // Uniqueness check if slug differs
+            if ($slug !== $queue->slug) {
+                if (Queue::where('entity_id', $queue->entity_id)->where('slug', $slug)->exists()) {
+                    throw ValidationException::withMessages([
+                        'slug' => ['The slug has already been taken for this entity.'],
+                    ]);
+                }
+            }
+            $attributes['slug'] = $slug;
+        }
+
+        if ($isActive !== null) {
+            $attributes['is_active'] = $isActive;
+        }
+
+        if ($attributes !== []) {
+            try {
+                $queue->update($attributes);
+            } catch (QueryException $e) {
+                throw ValidationException::withMessages([
+                    'slug' => ['The slug has already been taken for this entity.'],
+                ]);
+            }
+        }
+
+        return $queue;
+    }
+}
