+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    public function __invoke(Queue $queue, User $actor, ?string $name = null, ?string $slug = null, ?bool $isActive = null): Queue
+    {
+        if ($name !== null) {
+            $name = trim($name);
+            if (strlen($name) < 1 || strlen($name) > 255) {
+                throw ValidationException::withMessages(['name' => 'Name must be between 1 and 255 characters']);
+            }
+            $queue->name = $name;
+        }
+        if ($slug !== null) {
+            $slug = Str::slug($slug);
+            if ($slug === '') {
+                throw ValidationException::withMessages(['slug' => 'Slug cannot be empty']);
+            }
+            // Ensure uniqueness within entity except this queue
+            $exists = Queue::where('entity_id', $queue->entity_id)
+                ->where('slug', $slug)
+                ->where('id', '!=', $queue->id)
+                ->exists();
+            if ($exists) {
+                throw ValidationException::withMessages(['slug' => 'Slug must be unique within the entity']);
+            }
+            $queue->slug = $slug;
+        }
+        if ($isActive !== null) {
+            $queue->is_active = $isActive;
+        }
+        $queue->save();
+        return $queue;
+    }
+}
