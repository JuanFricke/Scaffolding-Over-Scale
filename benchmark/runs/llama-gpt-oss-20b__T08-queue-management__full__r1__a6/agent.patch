--- /dev/null
+++ b/app/Policies/QueuePolicy.php
@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Policies;
+
+use App\Enums\QueuePermission;
+use App\Models\UserRole;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use App\Models\QueueAccess;
+use Illuminate\Auth\Access\HandlesAuthorization;
+
+class QueuePolicy
+{
+    use HandlesAuthorization;
+
+    /**
+     * Determine whether the user can create queues for the entity.
+     */
+    public function create(User $user, Entity $entity): bool
+    {
+        $membership = $user->membershipFor($entity->id);
+        return $membership && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    /**
+     * Determine whether the user can update a queue.
+     */
+    public function update(User $user, Queue $queue): bool
+    {
+        return $this->create($user, $queue->entity);
+    }
+
+    /**
+     * Determine whether the user can manage access for a queue.
+     */
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->create($user, $queue->entity);
+    }
+
+    /**
+     * Determine whether the user can call tickets from a queue.
+     */
+    public function call(User $user, Queue $queue): bool
+    {
+        $membership = $user->membershipFor($queue->entity_id);
+        if (! $membership) {
+            return false;
+        }
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            return true;
+        }
+        // Employee: check queue_access
+        return QueueAccess::where('queue_id', $queue->id)
+            ->where('entity_membership_id', $membership->id)
+            ->whereJsonContains('permissions', QueuePermission::Call->value)
+            ->exists();
+    }
+}
