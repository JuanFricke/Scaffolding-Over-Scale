@@ -0,0 +1,40 @@
+<?php
+
+namespace App\Actions;
+
+// use App\Enums\QueuePermission; // not needed but import
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Illuminate\Validation\ValidationException;
+
+class CreateQueue
+{
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        $name = trim($name);
+        if (strlen($name) < 1 || strlen($name) > 255) {
+            throw ValidationException::withMessages(['name' => 'Name must be between 1 and 255 characters']);
+        }
+        $slug = $slug ? Str::slug($slug) : Str::slug($name);
+        if ($slug === '') {
+            throw ValidationException::withMessages(['slug' => 'Slug cannot be empty']);
+        }
+        try {
+            return Queue::create([
+                'entity_id' => $entity->id,
+                'name' => $name,
+                'slug' => $slug,
+                'is_active' => true,
+            ]);
+        } catch (\\Illuminate\\Database\\QueryException $e) {
+            // Handle duplicate slug error
+            if ($e->getCode() === '23000') {
+                throw ValidationException::withMessages(['slug' => 'Slug must be unique within the entity']);
+            }
+            throw $e;
+        }
+    }
+}
diff --git a/app/Actions/SetQueueAccess.php b/app/Actions/SetQueueAccess.php
new file mode 100644
index 0000000..24e21f8
--- /dev/null
+++ b/app/Actions/SetQueueAccess.php
@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\UserRole;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Illuminate\Auth\Access\AuthorizationException;
+
+class SetQueueAccess
+{
+    public function __invoke(EntityMembership $targetMembership, Queue $queue, User $actor, array $permissions): void
+    {
+        // Authorization: actor must be manager (owner/admin) of the queue's entity
+        $actorMembership = $actor->membershipFor($queue->entity_id);
+        if (! $actorMembership || ! in_array($actorMembership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            throw new \Illuminate\Auth\Access\AuthorizationException('Only entity managers can grant access.');
+        }
+        // Ensure same entity
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages(['entity' => 'Membership and queue belong to different entities']);
+        }
+        // Validate permissions array
+        $validValues = array_map(fn(QueuePermission $p) => $p->value, QueuePermission::cases());
+        foreach ($permissions as $p) {
+            if (!is_string($p) || !in_array($p, $validValues, true)) {
+                throw ValidationException::withMessages(['permissions' => 'Invalid permission values']);
+            }
+        }
+        if (empty($permissions)) {
+            // Revoke: delete if exists
+            $deleted = QueueAccess::where('entity_membership_id', $targetMembership->id)
+                ->where('queue_id', $queue->id)
+                ->delete();
+            if ($deleted) {
+                Log::channel('audit')->info('queue.access.revoked', [
+                    'actor_id' => $actor->id,
+                    'queue_id' => $queue->id,
+                    'entity_membership_id' => $targetMembership->id,
+                ]);
+            }
+            return;
+        }
+        // Grant or update
+        QueueAccess::updateOrCreate(
+            ['entity_membership_id' => $targetMembership->id, 'queue_id' => $queue->id],
+            ['permissions' => $permissions]
+        );
+        Log::channel('audit')->info('queue.access.granted', [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+        ]);
+    }
+}
