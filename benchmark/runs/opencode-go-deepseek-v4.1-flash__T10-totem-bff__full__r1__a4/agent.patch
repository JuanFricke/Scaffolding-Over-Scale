+<?php
+
+use App\Models\Entity;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\Support\TotemTestKit;
+
+uses(RefreshDatabase::class);
+
+it('rejects requests without a bearer token', function () {
+    $this->getJson('/api/loja-centro/queues')
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects malformed and tampered tokens', function (string $token) {
+    $this->withToken($token)->getJson('/api/loja-centro/queues')
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+})->with([
+    'not a jwt' => ['not-a-jwt'],
+    'empty segments' => ['..'],
+]);
+
+it('rejects a token with a bad signature', function () {
+    [, , $totem] = TotemTestKit::middlewareFixture();
+    $token = TotemTestKit::token(TotemPreset::query()->first(), $totem);
+
+    $this->withToken($token.'x')->getJson('/api/loja-centro/queues')
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects expired tokens', function () {
+    [$entity, $preset, $totem] = TotemTestKit::middlewareFixture();
+
+    $token = TotemTestKit::token($preset, $totem, expiresIn: -1);
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects tokens for an inactive totem', function () {
+    [$entity, $preset, $totem] = TotemTestKit::middlewareFixture();
+    $totem->update(['is_active' => false]);
+
+    $this->withToken(TotemTestKit::token($preset, $totem))->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects tokens for an inactive preset', function () {
+    [$entity, $preset, $totem] = TotemTestKit::middlewareFixture();
+    $preset->update(['is_active' => false]);
+
+    $this->withToken(TotemTestKit::token($preset, $totem))->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects tokens whose preset belongs to another entity', function () {
+    [$entity, , $totem] = TotemTestKit::middlewareFixture();
+    $otherPreset = TotemPreset::factory()->create();
+
+    $token = TotemTestKit::token($otherPreset, $totem, claimOverrides: ['entity_id' => $entity->id]);
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects tokens whose claims entity does not match the totem', function () {
+    [$entity, $preset, $totem] = TotemTestKit::middlewareFixture();
+    $other = Entity::factory()->create();
+
+    $token = TotemTestKit::token($preset, $totem, claimOverrides: ['entity_id' => $other->id]);
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects tokens for a deleted totem', function () {
+    [$entity, $preset, $totem] = TotemTestKit::middlewareFixture();
+    $token = TotemTestKit::token($preset, $totem);
+    $totem->delete();
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('updates last_seen_at on authenticated calls', function () {
+    [$entity, $preset, $totem] = TotemTestKit::middlewareFixture();
+    $totem->update(['last_seen_at' => now()->subDay()]);
+
+    $this->withToken(TotemTestKit::token($preset, $totem))->getJson("/api/{$entity->slug}/queues")
+        ->assertOk();
+
+    expect($totem->fresh()->last_seen_at->greaterThan(now()->subMinute()))->toBeTrue();
+});
+
+it('returns forbidden when the path entity differs from the token entity', function () {
+    [, $preset, $totem] = TotemTestKit::middlewareFixture();
+
+    $this->withToken(TotemTestKit::token($preset, $totem))->getJson('/api/outra-loja/queues')
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('shrinks the effective scope when a queue is detached from the preset', function () {
+    [$entity, $preset, $totem, $first, $second] = TotemTestKit::middlewareFixture();
+    $token = TotemTestKit::token($preset, $totem);
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/queues")
+        ->assertOk()
+        ->assertJsonCount(2, 'queues');
+
+    $preset->queues()->detach($second->id);
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/queues")
+        ->assertOk()
+        ->assertJsonCount(1, 'queues')
+        ->assertJsonPath('queues.0.slug', $first->slug);
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/{$second->slug}/priorities")
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('rejects tokens scoped to a queue outside the preset', function () {
+    [$entity, $preset, $totem, , $second] = TotemTestKit::middlewareFixture();
+    $preset->queues()->detach($second->id);
+
+    $token = TotemTestKit::token($preset, $totem, queueIds: [$second->id]);
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/{$second->slug}/priorities")
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
