+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+it('creates the totem tables with the contract columns', function () {
+    expect(Schema::hasColumns('totems', [
+        'id', 'entity_id', 'name', 'is_active', 'last_seen_at', 'created_at', 'updated_at',
+    ]))->toBeTrue()
+        ->and(Schema::hasColumns('totem_presets', [
+            'id', 'entity_id', 'name', 'login_code', 'login_code_expires_at',
+            'login_code_consumed_at', 'appearance', 'is_active', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasColumns('totem_preset_queue', [
+            'preset_id', 'queue_id', 'created_at', 'updated_at',
+        ]))->toBeTrue();
+});
+
+it('builds a ready-to-use preset with its factory', function () {
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_expires_at)->not->toBeNull()
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->is_active)->toBeTrue()
+        ->and($preset->entity)->toBeInstanceOf(Entity::class);
+});
+
+it('attaches and detaches preset queues through the join table', function () {
+    $preset = TotemPreset::factory()->create();
+    $queues = Queue::factory()->count(2)->create(['entity_id' => $preset->entity_id]);
+
+    $preset->queues()->attach($queues);
+
+    expect($preset->fresh()->queues)->toHaveCount(2);
+
+    $preset->queues()->detach($queues->first()->id);
+
+    expect($preset->fresh()->queues)->toHaveCount(1)
+        ->and($preset->fresh()->queues->first()->is($queues->last()))->toBeTrue();
+});
+
+it('exposes entity totems and presets relations', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->create(['entity_id' => $entity->id]);
+    $preset = TotemPreset::factory()->create(['entity_id' => $entity->id]);
+
+    expect($entity->totems)->toHaveCount(1)
+        ->and($entity->totems->first()->is($totem))->toBeTrue()
+        ->and($entity->totemPresets)->toHaveCount(1)
+        ->and($entity->totemPresets->first()->is($preset))->toBeTrue();
+});
