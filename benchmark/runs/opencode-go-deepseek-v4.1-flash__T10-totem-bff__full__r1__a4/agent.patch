+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\Support\TotemTestKit;
+
+uses(RefreshDatabase::class);
+
+it('issues a totem ticket with the chosen priority', function () {
+    [$entity, $preset, $totem, $queue] = TotemTestKit::ticketFixture();
+
+    $response = $this->withToken(TotemTestKit::token($preset, $totem))
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 10]);
+
+    $response->assertStatus(201)
+        ->assertJsonPath('slug', 'A001')
+        ->assertJsonPath('queue.slug', 'geral')
+        ->assertJsonPath('queue.label', 'Geral')
+        ->assertJsonPath('priority.value', 10)
+        ->assertJsonPath('priority.label', 'Prioritário');
+
+    expect($response->json('issued_at'))->toBeString();
+
+    $ticket = Ticket::query()->sole();
+
+    expect($ticket)
+        ->queue_id->toBe($queue->id)
+        ->code->toBe('A001')
+        ->priority->toBe(10)
+        ->channel->toBe(TicketChannel::Totem)
+        ->status->toBe(TicketStatus::Waiting);
+});
+
+it('allocates sequential codes per queue', function () {
+    [$entity, $preset, $totem, $queue] = TotemTestKit::ticketFixture();
+    $token = TotemTestKit::token($preset, $totem);
+
+    $this->withToken($token)
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(201)
+        ->assertJsonPath('slug', 'A001');
+
+    $this->withToken($token)
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 20])
+        ->assertStatus(201)
+        ->assertJsonPath('slug', 'A002');
+});
+
+it('rejects priorities outside the backend-owned values', function (mixed $priority) {
+    [$entity, $preset, $totem, $queue] = TotemTestKit::ticketFixture();
+
+    $payload = $priority === '__missing__' ? [] : ['priority' => $priority];
+
+    $this->withToken(TotemTestKit::token($preset, $totem))
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", $payload)
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+})->with([
+    'missing' => ['__missing__'],
+    'negative' => [-1],
+    'unknown' => [5],
+    'string' => ['10'],
+    'float' => [10.5],
+    'null' => [null],
+]);
+
+it('rejects an inactive queue', function () {
+    [$entity, $preset, $totem, $queue] = TotemTestKit::ticketFixture();
+    $queue->update(['is_active' => false]);
+
+    $this->withToken(TotemTestKit::token($preset, $totem))
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('rejects a queue outside the effective scope', function () {
+    [$entity, $preset, $totem, $queue] = TotemTestKit::ticketFixture();
+
+    $this->withToken(TotemTestKit::token($preset, $totem, queueIds: []))
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('does not leak queues from another entity', function () {
+    [$entity, $preset, $totem] = TotemTestKit::ticketFixture();
+    $other = Entity::factory()->create();
+    Queue::factory()->for($other)->create(['slug' => 'outra']);
+
+    $this->withToken(TotemTestKit::token($preset, $totem))
+        ->postJson("/api/{$entity->slug}/outra/ticket", ['priority' => 0])
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+});
+
+it('rejects the wrong entity in the path', function () {
+    [, $preset, $totem, $queue] = TotemTestKit::ticketFixture();
+
+    $this->withToken(TotemTestKit::token($preset, $totem))
+        ->postJson("/api/outra-loja/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('rate limits ticket issuance', function () {
+    [$entity, $preset, $totem, $queue] = TotemTestKit::ticketFixture();
+    $token = TotemTestKit::token($preset, $totem);
+
+    for ($attempt = 0; $attempt < 30; $attempt++) {
+        $this->withToken($token)
+            ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 5])
+            ->assertStatus(422);
+    }
+
+    $this->withToken($token)
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 5])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
