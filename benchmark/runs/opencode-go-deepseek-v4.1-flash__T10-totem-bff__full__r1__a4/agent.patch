@@ -0,0 +1,65 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\Support\TotemTestKit;
+
+uses(RefreshDatabase::class);
+
+it('answers preflight requests from localhost with CORS headers', function (string $origin) {
+    $response = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+        'HTTP_ACCESS_CONTROL_REQUEST_HEADERS' => 'content-type, authorization',
+    ]);
+
+    $response->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', $origin)
+        ->assertHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
+
+    expect($response->headers->get('Access-Control-Allow-Credentials'))->toBeNull();
+})->with([
+    'localhost port' => ['http://localhost:8081'],
+    'localhost no port' => ['http://localhost'],
+    'localhost https' => ['https://localhost:3000'],
+    'loopback port' => ['http://127.0.0.1:8081'],
+    'loopback https' => ['https://127.0.0.1:5173'],
+]);
+
+it('sends no allow-origin header for other origins', function () {
+    $response = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'https://evil.example',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    $response->assertStatus(204);
+
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+});
+
+it('allows the optional TOTEM_WEB_ORIGIN', function () {
+    config()->set('services.totem.web_origin', 'https://totem.example.com');
+
+    $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'https://totem.example.com',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ])->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem.example.com');
+});
+
+it('adds CORS headers to authenticated API responses', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+    $totem = Totem::factory()->create(['entity_id' => $entity->id]);
+
+    $this->withToken(TotemTestKit::token($preset, $totem))
+        ->withHeader('Origin', 'http://localhost:8081')
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertOk()
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+});
