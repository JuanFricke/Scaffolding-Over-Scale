diff --git a/tests/Feature/Totem/TotemAuthTest.php b/tests/Feature/Totem/TotemAuthTest.php
new file mode 100644
index 0000000..9f773d4
--- /dev/null
+++ b/tests/Feature/Totem/TotemAuthTest.php
@@ -0,0 +1,169 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+it('rejects codes that are not exactly six digits', function (mixed $code) {
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with([
+    'empty' => [''],
+    'too short' => ['12345'],
+    'too long' => ['1234567'],
+    'letters' => ['abcdef'],
+    'number' => [123456],
+    'null' => [null],
+    'missing key' => [null],
+]);
+
+it('rejects unknown pairing codes', function () {
+    $this->postJson('/api/totem/auth', ['code' => '654321'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('rejects expired pairing codes', function () {
+    TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->subSecond(),
+    ]);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('rejects already consumed pairing codes', function () {
+    TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->addMinutes(10),
+        'login_code_consumed_at' => now(),
+    ]);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('rejects codes from inactive presets', function () {
+    TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->addMinutes(10),
+        'is_active' => false,
+    ]);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('pairs a totem and returns a scoped JWT', function () {
+    $entity = Entity::factory()->create(['name' => 'Loja Centro', 'slug' => 'loja-centro']);
+    $preset = TotemPreset::factory()->for($entity)->create([
+        'name' => 'Entrada principal',
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->addMinutes(10),
+    ]);
+    $queues = Queue::factory()->for($entity)->count(2)->create();
+    $preset->queues()->attach($queues);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+    $response->assertOk()
+        ->assertJsonStructure([
+            'token',
+            'token_type',
+            'expires_in',
+            'entity' => ['slug', 'name'],
+        ])
+        ->assertJson([
+            'token_type' => 'Bearer',
+            'expires_in' => 3600,
+            'entity' => ['slug' => 'loja-centro', 'name' => 'Loja Centro'],
+        ]);
+
+    expect($response->json('token'))->toBeString()->not->toBeEmpty();
+
+    $claims = TotemJwt::decode($response->json('token'));
+    $totem = Totem::query()->sole();
+
+    expect($claims['totem_id'])->toBe($totem->id)
+        ->and($claims['entity_id'])->toBe($entity->id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['queues'])->toEqualCanonicalizing($queues->modelKeys())
+        ->and($claims['exp'] - $claims['iat'])->toBe(3600)
+        ->and($claims['jti'])->toBeString()->not->toBeEmpty();
+
+    expect($totem)
+        ->entity_id->toBe($entity->id)
+        ->name->toBe('Entrada principal')
+        ->is_active->toBeTrue()
+        ->last_seen_at->not->toBeNull();
+
+    expect($preset->fresh()->login_code_consumed_at)->not->toBeNull();
+});
+
+it('does not allow the same pairing code twice', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->addMinutes(10),
+    ]);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('rate limits pairing attempts', function () {
+    for ($attempt = 0; $attempt < 10; $attempt++) {
+        $this->postJson('/api/totem/auth', ['code' => 'bad'])
+            ->assertStatus(400);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => 'bad'])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('audits pairing success and failure without logging the full code', function () {
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('warning')
+        ->with('totem.pairing.failed', Mockery::on(
+            fn (array $context): bool => $context['reason'] === 'unknown'
+        ))
+        ->once();
+    Log::shouldReceive('info')
+        ->with('totem.paired', Mockery::on(
+            fn (array $context): bool => ! array_key_exists('code', $context)
+        ))
+        ->once();
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(401);
+
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->addMinutes(10),
+    ]);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertOk();
+});
diff --git a/tests/Feature/Totem/TotemAuthenticationTest.php b/tests/Feature/Totem/TotemAuthenticationTest.php
