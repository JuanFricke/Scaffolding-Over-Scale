+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Context\TotemContext;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+abstract class TotemApiController extends Controller
+{
+    protected function context(Request $request): TotemContext
+    {
+        /** @var TotemContext $context */
+        $context = $request->attributes->get(TotemContext::class);
+
+        return $context;
+    }
+
+    protected function entityMismatch(Request $request, TotemContext $context): bool
+    {
+        return (string) $request->route('entity') !== $context->entity->slug;
+    }
+
+    /**
+     * Resolve a queue slug within the token's entity only.
+     */
+    protected function resolveQueue(Request $request, TotemContext $context): ?Queue
+    {
+        return Queue::query()
+            ->where('entity_id', $context->entity->id)
+            ->where('slug', (string) $request->route('queue'))
+            ->first();
+    }
+
+    /**
+     * @return array{slug: string, label: string}
+     */
+    protected function queuePair(Queue $queue): array
+    {
+        return [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+        ];
+    }
+
+    protected function error(string $code, int $status): JsonResponse
+    {
+        return response()->json(['code' => $code], $status);
+    }
+}
