+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class OpenTotemPairingWindow
+{
+    /**
+     * Generate (or replace) a preset's single-use pairing code.
+     */
+    public function __invoke(TotemPreset $preset): string
+    {
+        return DB::transaction(function () use ($preset): string {
+            $locked = TotemPreset::query()
+                ->whereKey($preset->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            do {
+                $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+            } while ($code === $locked->login_code || TotemPreset::query()
+                ->where('login_code', $code)
+                ->whereKeyNot($locked->id)
+                ->exists());
+
+            $locked->forceFill([
+                'login_code' => $code,
+                'login_code_expires_at' => now()->addMinutes(10),
+                'login_code_consumed_at' => null,
+            ])->save();
+
+            Log::channel('audit')->info('totem.pairing_code.generated', [
+                'preset_id' => $locked->id,
+                'entity_id' => $locked->entity_id,
+                'expires_at' => $locked->login_code_expires_at?->toIso8601String(),
+            ]);
+
+            return $code;
+        });
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
new file mode 100644
index 0000000..d1429c1
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,128 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+
+class PairTotem
+{
+    /**
+     * Consume a pairing code and issue a totem JWT.
+     *
+     * The preset row is locked so a code can only ever be consumed once, even
+     * when two devices submit it concurrently.
+     *
+     * @return array{token: string, expires_in: int, totem: Totem, preset: TotemPreset, entity: Entity}
+     *
+     * @throws InvalidPairingCodeException
+     */
+    public function __invoke(string $code): array
+    {
+        return DB::transaction(function () use ($code): array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null) {
+                $this->auditFailure('unknown');
+
+                throw new InvalidPairingCodeException;
+            }
+
+            $reason = $this->rejectionReason($preset);
+
+            if ($reason !== null) {
+                $this->auditFailure($reason, $preset);
+
+                throw new InvalidPairingCodeException;
+            }
+
+            $entity = $preset->entity;
+
+            if ($entity === null) {
+                $this->auditFailure('unknown_entity', $preset);
+
+                throw new InvalidPairingCodeException;
+            }
+
+            $queues = $preset->queues()
+                ->pluck('queues.id')
+                ->map(static fn ($id): int => (int) $id)
+                ->all();
+
+            // The name is the operator label of the paired preset; the row
+            // represents this one physical device.
+            $totem = Totem::query()->create([
+                'entity_id' => $entity->id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $ttl = (int) config('services.totem.jwt_ttl', 3600);
+            $issuedAt = now()->timestamp;
+
+            $token = TotemJwt::encode([
+                'totem_id' => $totem->id,
+                'entity_id' => $entity->id,
+                'preset_id' => $preset->id,
+                'queues' => $queues,
+                'iat' => $issuedAt,
+                'exp' => $issuedAt + $ttl,
+                'jti' => (string) Str::uuid(),
+            ]);
+
+            Log::channel('audit')->info('totem.paired', [
+                'totem_id' => $totem->id,
+                'preset_id' => $preset->id,
+                'entity_id' => $entity->id,
+                'ip' => request()->ip(),
+            ]);
+
+            return [
+                'token' => $token,
+                'expires_in' => $ttl,
+                'totem' => $totem,
+                'preset' => $preset,
+                'entity' => $entity,
+            ];
+        });
+    }
+
+    private function rejectionReason(TotemPreset $preset): ?string
+    {
+        if (! $preset->is_active) {
+            return 'inactive_preset';
+        }
+
+        if ($preset->login_code_consumed_at !== null) {
+            return 'consumed';
+        }
+
+        if ($preset->login_code_expires_at === null || $preset->login_code_expires_at->isPast()) {
+            return 'expired';
+        }
+
+        return null;
+    }
+
+    private function auditFailure(string $reason, ?TotemPreset $preset = null): void
+    {
+        Log::channel('audit')->warning('totem.pairing.failed', [
+            'reason' => $reason,
+            'preset_id' => $preset?->id,
+            'entity_id' => $preset?->entity_id,
+            'ip' => request()->ip(),
+        ]);
+    }
+}
