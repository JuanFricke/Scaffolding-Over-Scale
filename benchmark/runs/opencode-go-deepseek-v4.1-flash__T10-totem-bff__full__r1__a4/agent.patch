+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned ticket priority levels (higher = more prioritized).
+ *
+ * Single source for the totem priorities endpoint and ticket issuance
+ * validation; per-entity custom priorities are out of scope for now.
+ */
+enum TicketPriority: int
+{
+    case Normal = 0;
+    case Priority = 10;
+    case Priority80 = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Priority => 'Prioritário',
+            self::Priority80 => 'Prioridade 80+',
+        };
+    }
+
+    /**
+     * @return array{color: string, icon: string, order: int}
+     */
+    public function visual(): array
+    {
+        return match ($this) {
+            self::Normal => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            self::Priority => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            self::Priority80 => ['color' => '#6A1B9A', 'icon' => 'priority_80', 'order' => 3],
+        };
+    }
+
+    /**
+     * @return array{value: int, label: string, visual: array{color: string, icon: string, order: int}}
+     */
+    public function toArray(): array
+    {
+        return [
+            'value' => $this->value,
+            'label' => $this->label(),
+            'visual' => $this->visual(),
+        ];
+    }
+
+    /**
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function options(): array
+    {
+        return array_map(static fn (self $priority): array => $priority->toArray(), self::cases());
+    }
+}
