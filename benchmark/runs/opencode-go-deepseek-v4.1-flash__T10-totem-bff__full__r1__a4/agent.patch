+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+it('opens a ten-minute pairing window and prints the code', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => null,
+        'login_code_expires_at' => null,
+        'login_code_consumed_at' => now()->subMinute(),
+    ]);
+
+    $exitCode = Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    $code = trim(Artisan::output());
+    $fresh = $preset->fresh();
+
+    expect($exitCode)->toBe(0)
+        ->and($code)->toMatch('/^\d{6}$/')
+        ->and($fresh->login_code)->toBe($code)
+        ->and($fresh->login_code_consumed_at)->toBeNull()
+        ->and($fresh->login_code_expires_at)->not->toBeNull()
+        ->and($fresh->login_code_expires_at->between(
+            now()->addMinutes(9),
+            now()->addMinutes(11),
+        ))->toBeTrue();
+});
+
+it('replaces the previous code when a window is reopened', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '111111',
+        'login_code_consumed_at' => now(),
+    ]);
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+    $newCode = trim(Artisan::output());
+
+    expect($newCode)->toMatch('/^\d{6}$/')
+        ->and($newCode)->not->toBe('111111')
+        ->and($preset->fresh()->login_code)->toBe($newCode)
+        ->and($preset->fresh()->login_code_consumed_at)->toBeNull();
+});
+
+it('fails with a message for an unknown preset', function () {
+    $exitCode = Artisan::call('totem:pairing-code', ['preset' => 999999]);
+    $output = Artisan::output();
+
+    expect($exitCode)->toBe(1)
+        ->and($output)->toContain('not found');
+});
+
+it('writes an audit entry when generating a code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')
+        ->with('totem.pairing_code.generated', Mockery::on(
+            fn (array $context): bool => $context['preset_id'] === $preset->id
+        ))
+        ->once();
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+});
