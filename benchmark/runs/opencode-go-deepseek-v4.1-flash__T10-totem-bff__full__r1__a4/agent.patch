+use Tests\Support\TotemTestKit;
+
+uses(RefreshDatabase::class);
+
+it('returns the backend-owned priorities with visual specs', function () {
+    $entity = Entity::factory()->create(['slug' => 'loja-centro']);
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral']);
