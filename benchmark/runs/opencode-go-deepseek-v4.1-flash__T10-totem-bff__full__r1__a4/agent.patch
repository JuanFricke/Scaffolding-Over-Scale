+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Exceptions\InactiveQueueException;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemTicketController extends TotemApiController
+{
+    public function __invoke(Request $request, IssueTicket $issueTicket): JsonResponse
+    {
+        $context = $this->context($request);
+
+        if ($this->entityMismatch($request, $context)) {
+            return $this->error('forbidden', 403);
+        }
+
+        $queue = $this->resolveQueue($request, $context);
+
+        if ($queue === null) {
+            return $this->error('queue_not_found', 404);
+        }
+
+        if (! $context->allowsQueue($queue->id)) {
+            return $this->error('forbidden', 403);
+        }
+
+        if (! $queue->is_active) {
+            return $this->error('inactive_queue', 422);
+        }
+
+        $value = $request->input('priority');
+        $priority = is_int($value) ? TicketPriority::tryFrom($value) : null;
+
+        if ($priority === null) {
+            return $this->error('invalid_priority', 422);
+        }
+
+        try {
+            $ticket = $issueTicket($queue, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return $this->error('inactive_queue', 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => $this->queuePair($queue),
+            'priority' => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+            ],
+            'issued_at' => $ticket->issued_at?->toIso8601String(),
+        ], 201);
+    }
+}
diff --git a/app/Http/Middleware/AuthenticateTotem.php b/app/Http/Middleware/AuthenticateTotem.php
new file mode 100644
index 0000000..a6ebeec
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,86 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Context\TotemContext;
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use InvalidArgumentException;
+use Symfony\Component\HttpFoundation\Response;
+
+class AuthenticateTotem
+{
+    /**
+     * Validate the bearer token and load the totem/preset/entity context.
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            return $this->invalidToken();
+        }
+
+        try {
+            $claims = TotemJwt::decode($token);
+        } catch (InvalidArgumentException) {
+            return $this->invalidToken();
+        }
+
+        $totemId = $claims['totem_id'] ?? null;
+        $entityId = $claims['entity_id'] ?? null;
+        $presetId = $claims['preset_id'] ?? null;
+        $claimedQueues = $claims['queues'] ?? null;
+
+        if (! is_int($totemId) || ! is_int($entityId) || ! is_int($presetId) || ! is_array($claimedQueues)) {
+            return $this->invalidToken();
+        }
+
+        $totem = Totem::query()->find($totemId);
+        $preset = TotemPreset::query()->find($presetId);
+        $entity = Entity::query()->find($entityId);
+
+        if ($totem === null || $preset === null || $entity === null) {
+            return $this->invalidToken();
+        }
+
+        if ($totem->entity_id !== $entity->id
+            || $preset->entity_id !== $entity->id
+            || ! $totem->is_active
+            || ! $preset->is_active) {
+            return $this->invalidToken();
+        }
+
+        $currentQueues = $preset->queues()
+            ->pluck('queues.id')
+            ->map(static fn ($id): int => (int) $id)
+            ->all();
+
+        $claimedQueues = array_values(array_unique(array_filter(
+            array_map(static fn ($id): int => (int) $id, $claimedQueues),
+            static fn (int $id): bool => $id > 0,
+        )));
+
+        $queueIds = array_values(array_intersect($claimedQueues, $currentQueues));
+
+        $request->attributes->set(TotemContext::class, new TotemContext(
+            $totem,
+            $preset,
+            $entity,
+            $queueIds,
+        ));
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        return $next($request);
+    }
+
+    private function invalidToken(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
