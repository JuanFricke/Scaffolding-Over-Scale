+                ],
+                [
+                    'value' => 10,
+                    'label' => 'Prioritário',
+                    'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+                ],
+                [
+                    'value' => 20,
+                    'label' => 'Prioridade 80+',
+                    'visual' => ['color' => '#6A1B9A', 'icon' => 'priority_80', 'order' => 3],
+                ],
+            ],
+        ]);
+});
+
+it('rejects priorities of an inactive queue', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral', 'is_active' => false]);
+    $preset->queues()->attach($queue);
+    $totem = Totem::factory()->create(['entity_id' => $entity->id]);
+
+    $this->withToken(TotemTestKit::token($preset, $totem))
+        ->getJson("/api/{$entity->slug}/{$queue->slug}/priorities")
+        ->assertStatus(422)
