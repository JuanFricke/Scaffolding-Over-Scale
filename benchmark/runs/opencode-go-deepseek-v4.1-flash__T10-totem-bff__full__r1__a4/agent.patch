+<?php
+
+namespace App\Context;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+
+/**
+ * In-request totem context, populated by the totem.auth middleware.
+ *
+ * The queue ids are the effective scope: the intersection of the JWT claim and
+ * the preset's current join, so removing a queue from a preset applies to
+ * already-issued tokens immediately.
+ */
+final class TotemContext
+{
+    /**
+     * @param  list<int>  $queueIds
+     */
+    public function __construct(
+        public readonly Totem $totem,
+        public readonly TotemPreset $preset,
+        public readonly Entity $entity,
+        public readonly array $queueIds,
+    ) {}
+
+    public function allowsQueue(int $queueId): bool
+    {
+        return in_array($queueId, $this->queueIds, true);
+    }
+}
