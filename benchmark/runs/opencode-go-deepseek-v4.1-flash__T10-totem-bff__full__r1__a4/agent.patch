+<?php
+
+namespace Tests\Support;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Support\Str;
+
+final class TotemTestKit
+{
+    /**
+     * Sign a totem JWT for feature tests.
+     *
+     * @param  list<int>|null  $queueIds
+     * @param  array<string, mixed>  $claimOverrides
+     */
+    public static function token(
+        TotemPreset $preset,
+        ?Totem $totem = null,
+        ?array $queueIds = null,
+        ?int $expiresIn = null,
+        array $claimOverrides = [],
+    ): string {
+        $totem ??= Totem::factory()->create(['entity_id' => $preset->entity_id]);
+
+        $queueIds ??= $preset->queues()
+            ->pluck('queues.id')
+            ->map(static fn ($id): int => (int) $id)
+            ->all();
+
+        $issuedAt = now()->timestamp;
+
+        return TotemJwt::encode(array_merge([
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => $queueIds,
+            'iat' => $issuedAt,
+            'exp' => $issuedAt + ($expiresIn ?? (int) config('services.totem.jwt_ttl', 3600)),
+            'jti' => (string) Str::uuid(),
+        ], $claimOverrides));
+    }
+
+    /**
+     * @return array{Entity, TotemPreset, Totem, Queue, Queue}
+     */
+    public static function middlewareFixture(): array
+    {
+        $entity = Entity::factory()->create(['slug' => 'loja-centro']);
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $first = Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+        $second = Queue::factory()->for($entity)->create(['name' => 'Prioridade', 'slug' => 'prioridade']);
+        $preset->queues()->attach([$first->id, $second->id]);
+
+        $totem = Totem::factory()->create(['entity_id' => $entity->id]);
+
+        return [$entity, $preset, $totem, $first, $second];
+    }
+
+    /**
+     * @return array{Entity, TotemPreset, Totem, Queue}
+     */
+    public static function ticketFixture(): array
+    {
+        $entity = Entity::factory()->create(['slug' => 'loja-centro']);
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+        $preset->queues()->attach($queue);
+        $totem = Totem::factory()->create(['entity_id' => $entity->id]);
+
+        return [$entity, $preset, $totem, $queue];
+    }
+}
