+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends TotemApiController
+{
+    public function __invoke(Request $request, PairTotem $pairTotem): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || preg_match('/^\d{6}\z/', $code) !== 1) {
+            Log::channel('audit')->warning('totem.pairing.failed', [
+                'reason' => 'invalid_code_format',
+                'ip' => $request->ip(),
+            ]);
+
+            return $this->error('invalid_code_format', 400);
+        }
+
+        try {
+            $result = $pairTotem($code);
+        } catch (InvalidPairingCodeException) {
+            return $this->error('invalid_pairing_code', 401);
+        }
+
+        return response()->json([
+            'token' => $result['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => $result['expires_in'],
+            'entity' => [
+                'slug' => $result['entity']->slug,
+                'name' => $result['entity']->name,
+            ],
+        ]);
+    }
+}
