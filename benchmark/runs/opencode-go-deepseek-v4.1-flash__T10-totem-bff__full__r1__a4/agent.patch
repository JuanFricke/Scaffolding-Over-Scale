+<?php
+
+namespace App\Support;
+
+/**
+ * Presentation-only visual specs for totem queue cards.
+ *
+ * The queue table has no color/icon/order columns (operator UI for presets is
+ * out of scope), so the backend derives them deterministically. `order` is the
+ * 1-based display position; color is stable per slug; every queue uses the
+ * same ticket icon until per-queue appearance lands.
+ */
+final class QueueVisual
+{
+    /**
+     * @var list<string>
+     */
+    private const COLORS = [
+        '#0055FF',
+        '#00897B',
+        '#6A1B9A',
+        '#EF6C00',
+        '#2E7D32',
+        '#C62828',
+    ];
+
+    /**
+     * @return array{color: string, icon: string, order: int}
+     */
+    public static function for(string $slug, int $order): array
+    {
+        $index = (int) (sprintf('%u', crc32($slug)) % count(self::COLORS));
+
+        return [
+            'color' => self::COLORS[$index],
+            'icon' => 'ticket',
+            'order' => $order,
+        ];
+    }
+}
diff --git a/app/Support/TotemJwt.php b/app/Support/TotemJwt.php
new file mode 100644
index 0000000..37d8234
--- /dev/null
+++ b/app/Support/TotemJwt.php
@@ -0,0 +1,123 @@
+<?php
+
+namespace App\Support;
+
+use InvalidArgumentException;
+use RuntimeException;
+
+/**
+ * Minimal HS256 JWT encoder/decoder for the totem API.
+ *
+ * Only the algorithms the totem contract needs are supported: no "none",
+ * no asymmetric keys, no key discovery. Signature verification uses
+ * hash_equals() and expiry is enforced on decode.
+ */
+final class TotemJwt
+{
+    /**
+     * @param  array<string, mixed>  $claims
+     */
+    public static function encode(array $claims): string
+    {
+        $segments = [
+            self::base64UrlEncode(self::json(['alg' => 'HS256', 'typ' => 'JWT'])),
+            self::base64UrlEncode(self::json($claims)),
+        ];
+
+        $signature = hash_hmac('sha256', implode('.', $segments), self::secret(), true);
+        $segments[] = self::base64UrlEncode($signature);
+
+        return implode('.', $segments);
+    }
+
+    /**
+     * @return array<string, mixed>
+     *
+     * @throws InvalidArgumentException when the token is malformed, tampered with or expired
+     */
+    public static function decode(string $token): array
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            throw new InvalidArgumentException('Malformed token.');
+        }
+
+        [$header64, $payload64, $signature64] = $parts;
+
+        $header = self::decodeJson(self::base64UrlDecode($header64));
+        $payload = self::decodeJson(self::base64UrlDecode($payload64));
+
+        if (($header['alg'] ?? null) !== 'HS256') {
+            throw new InvalidArgumentException('Unsupported token algorithm.');
+        }
+
+        $expected = hash_hmac('sha256', $header64.'.'.$payload64, self::secret(), true);
+        $signature = self::base64UrlDecode($signature64);
+
+        if (! hash_equals($expected, $signature)) {
+            throw new InvalidArgumentException('Invalid token signature.');
+        }
+
+        $expiresAt = $payload['exp'] ?? null;
+
+        if (! is_int($expiresAt) || $expiresAt <= now()->timestamp) {
+            throw new InvalidArgumentException('Expired token.');
+        }
+
+        return $payload;
+    }
+
+    private static function secret(): string
+    {
+        $secret = config('services.totem.jwt_secret');
+
+        if (! is_string($secret) || $secret === '') {
+            throw new RuntimeException('services.totem.jwt_secret is not configured.');
+        }
+
+        return $secret;
+    }
+
+    /**
+     * @param  array<string, mixed>  $value
+     */
+    private static function json(array $value): string
+    {
+        return json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR);
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    private static function decodeJson(string $json): array
+    {
+        try {
+            $decoded = json_decode($json, true, 512, JSON_THROW_ON_ERROR);
+        } catch (\JsonException) {
+            throw new InvalidArgumentException('Malformed token payload.');
+        }
+
+        if (! is_array($decoded)) {
+            throw new InvalidArgumentException('Malformed token payload.');
+        }
+
+        return $decoded;
+    }
+
+    private static function base64UrlEncode(string $value): string
+    {
+        return rtrim(strtr(base64_encode($value), '+/', '-_'), '=');
+    }
+
+    private static function base64UrlDecode(string $value): string
+    {
+        $decoded = base64_decode(strtr($value, '-_', '+/'), true);
+
+        if ($decoded === false) {
+            throw new InvalidArgumentException('Malformed token encoding.');
+        }
+
+        return $decoded;
+    }
+}
