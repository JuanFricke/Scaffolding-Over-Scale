+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Models\Queue;
+use App\Support\QueueVisual;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController extends TotemApiController
+{
+    public function __invoke(Request $request): JsonResponse
+    {
+        $context = $this->context($request);
+
+        if ($this->entityMismatch($request, $context)) {
+            return $this->error('forbidden', 403);
+        }
+
+        $queues = Queue::query()
+            ->where('entity_id', $context->entity->id)
+            ->where('is_active', true)
+            ->whereIn('id', $context->queueIds)
+            ->orderBy('name')
+            ->orderBy('id')
+            ->get()
+            ->values();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $context->entity->slug,
+                'name' => $context->entity->name,
+            ],
+            'queues' => $queues->map(function (Queue $queue, int $index): array {
+                return [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => is_array($queue->labels_i18n)
+                        ? ($queue->labels_i18n['description'] ?? null)
+                        : null,
+                    'visual' => QueueVisual::for($queue->slug, $index + 1),
+                    'is_active' => true,
+                ];
+            })->all(),
+        ]);
+    }
+}
