+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\Support\TotemTestKit;
+
+uses(RefreshDatabase::class);
+
+it('lists only active in-scope queues ordered by name with display positions', function () {
+    $entity = Entity::factory()->create(['name' => 'Loja Centro', 'slug' => 'loja-centro']);
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $totem = Totem::factory()->create(['entity_id' => $entity->id]);
+
+    $zebra = Queue::factory()->for($entity)->create([
+        'name' => 'Zebra',
+        'slug' => 'zebra',
+        'labels_i18n' => ['description' => 'Atendimento zebra'],
+    ]);
+    $alpha = Queue::factory()->for($entity)->create(['name' => 'Alpha', 'slug' => 'alpha']);
+    $middle = Queue::factory()->for($entity)->create(['name' => 'Middle', 'slug' => 'middle']);
+    $inactive = Queue::factory()->for($entity)->create(['name' => 'Beta', 'is_active' => false]);
+    $outOfScope = Queue::factory()->for($entity)->create(['name' => 'Delta']);
+
+    $preset->queues()->attach([$zebra->id, $alpha->id, $middle->id, $inactive->id]);
+
+    $response = $this->withToken(TotemTestKit::token($preset, $totem))
+        ->getJson("/api/{$entity->slug}/queues");
+
+    $response->assertOk()
+        ->assertJsonPath('entity.slug', 'loja-centro')
+        ->assertJsonPath('entity.name', 'Loja Centro')
+        ->assertJsonCount(3, 'queues')
+        ->assertJsonPath('queues.0.slug', 'alpha')
+        ->assertJsonPath('queues.1.slug', 'middle')
+        ->assertJsonPath('queues.2.slug', 'zebra')
+        ->assertJsonPath('queues.0.visual.order', 1)
+        ->assertJsonPath('queues.1.visual.order', 2)
+        ->assertJsonPath('queues.2.visual.order', 3)
+        ->assertJsonPath('queues.0.label', 'Alpha')
+        ->assertJsonPath('queues.2.description', 'Atendimento zebra')
+        ->assertJsonPath('queues.0.is_active', true);
+
+    expect($response->json('queues.0.visual.color'))->toBeString()->toStartWith('#')
+        ->and($response->json('queues.0.visual.icon'))->toBe('ticket');
+
+    expect($response->json('queues'))->not->toContain(['slug' => $outOfScope->slug]);
+});
+
+it('returns an empty list when the preset has no queues', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $totem = Totem::factory()->create(['entity_id' => $entity->id]);
+
+    $this->withToken(TotemTestKit::token($preset, $totem))
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertOk()
+        ->assertJsonCount(0, 'queues');
+});
