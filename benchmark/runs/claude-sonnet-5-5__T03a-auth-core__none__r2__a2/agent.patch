+++ b/app/Livewire/Auth/Login.php
@@ -0,0 +1,56 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Component;
+
+class Login extends Component
+{
+    public string $email = '';
+
+    public string $password = '';
+
+    public bool $remember = false;
+
+    public function submit()
+    {
+        $this->validate([
+            'email' => ['required', 'string', 'email:rfc,strict'],
+            'password' => ['required', 'string'],
+        ]);
+
+        $key = Str::transliterate(Str::lower($this->email).'|'.request()->ip());
+
+        if (RateLimiter::tooManyAttempts($key, 5)) {
+            throw ValidationException::withMessages([
+                'email' => __('auth.throttle', ['seconds' => RateLimiter::availableIn($key)]),
+            ]);
+        }
+
+        if (! Auth::attempt(['email' => $this->email, 'password' => $this->password], $this->remember)) {
+            RateLimiter::hit($key);
+
+            $this->reset('password');
+
+            throw ValidationException::withMessages([
+                'email' => __('auth.failed'),
+            ]);
+        }
+
+        RateLimiter::clear($key);
+
+        session()->regenerate();
+
+        return $this->redirectIntended(route('home'));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.auth.login')->title(__('ui.login.title'));
+    }
+}
