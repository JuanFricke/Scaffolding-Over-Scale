diff --git a/tests/Feature/AuthTest.php b/tests/Feature/AuthTest.php
new file mode 100644
index 0000000..2f4be6d
--- /dev/null
+++ b/tests/Feature/AuthTest.php
@@ -0,0 +1,254 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\URL;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('locale is pt_BR in tests', function () {
+    expect(app()->getLocale())->toBe('pt_BR');
+});
+
+test('login page is localized', function () {
+    $this->get(route('login'))->assertOk()->assertSee('Entrar')->assertSee('Senha')->assertSee('Esqueceu a senha?');
+
+    app()->setLocale('en');
+    $this->get(route('login'))->assertOk()->assertSee('Log in')->assertDontSee('Esqueceu')->assertDontSee('Senha');
+});
+
+test('user can log in and session is regenerated', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('wrong credentials fail and are throttled', function () {
+    $user = User::factory()->create();
+
+    foreach (range(1, 5) as $_) {
+        Livewire::test(Login::class)
+            ->set('email', $user->email)
+            ->set('password', 'wrong')
+            ->call('submit')
+            ->assertHasErrors(['email' => __('auth.failed')]);
+    }
+
+    Livewire::test(Login::class)
+        ->set('email', strtoupper($user->email))
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    $this->assertGuest();
+});
+
+test('login rejects malformed emails', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'x')
+        ->call('submit')
+        ->assertHasErrors('email');
+});
+
+test('authenticated users are redirected away from login', function () {
+    $this->actingAs(User::factory()->create())->get(route('login'))->assertRedirect(route('home'));
+});
+
+test('home access rules', function () {
+    $this->get(route('home'))->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->unverified()->create())->get(route('home'))->assertRedirect(route('verification.notice'));
+    $this->actingAs(User::factory()->create())->get(route('home'))->assertOk();
+});
+
+test('registration creates an unverified user', function () {
+    Event::fake([Registered::class]);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria')
+        ->set('email', 'Maria@Example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::firstWhere('email', 'maria@example.com');
+    expect($user)->not->toBeNull()->and($user->hasVerifiedEmail())->toBeFalse();
+    $this->assertAuthenticatedAs($user);
+    Event::assertDispatched(Registered::class);
+});
+
+test('registration sends the verification mail', function () {
+    Notification::fake();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit');
+
+    Notification::assertSentTo(User::first(), VerifyEmail::class);
+});
+
+test('registration validates password rules and confirmation', function () {
+    $component = Livewire::test(Register::class)
+        ->set('name', 'Maria')
+        ->set('email', 'maria@example.com');
+
+    $component->set('password', 'secret123')->set('password_confirmation', 'secret123')->call('submit')->assertHasErrors('password');
+    $component->set('password', 'Secret123')->set('password_confirmation', 'Other123')->call('submit')->assertHasErrors(['password' => 'confirmed']);
+    expect(User::count())->toBe(0);
+});
+
+test('registration email must be unique', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria')
+        ->set('email', $user->email)
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors('email');
+});
+
+test('registration is rate limited by ip', function () {
+    $key = str()->transliterate('register|127.0.0.1');
+    foreach (range(1, 5) as $_) {
+        RateLimiter::hit($key);
+    }
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    expect(User::count())->toBe(0);
+});
+
+test('logout invalidates the session', function () {
+    $this->actingAs(User::factory()->create())->post(route('logout'))->assertRedirect(route('login'));
+    $this->assertGuest();
+    $this->post(route('logout'))->assertRedirect(route('login'));
+});
+
+test('forgot password never reveals whether the email exists', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])->assertSessionHas('status', __('passwords.sent'));
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+    Notification::assertCount(1);
+});
+
+test('forgot password is throttled', function () {
+    foreach (range(1, 6) as $_) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertRedirect();
+    }
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertStatus(429);
+});
+
+test('reset password form has a single email input', function () {
+    $html = $this->get(route('password.reset', ['token' => 'abc', 'email' => 'a@b.com']))->assertOk()->getContent();
+    expect(substr_count($html, 'name="email"'))->toBe(1);
+});
+
+test('password can be reset and remember token rotates', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create();
+    $old = $user->remember_token;
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertRedirect(route('login'))->assertSessionHas('status');
+
+    $user->refresh();
+    expect($user->remember_token)->not->toBe($old)
+        ->and(Hash::check('NewSecret123', $user->password))->toBeTrue();
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('password reset rejects bad token and weak password', function () {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => 'bad', 'email' => $user->email,
+        'password' => 'NewSecret123', 'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors('email');
+
+    $this->post(route('password.update'), [
+        'token' => Password::createToken($user), 'email' => $user->email,
+        'password' => 'weak', 'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+});
+
+test('email can be verified through the signed link', function () {
+    $user = User::factory()->unverified()->create();
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), ['id' => $user->id, 'hash' => sha1($user->email)]);
+
+    $this->actingAs($user)->get($url)->assertRedirect(route('home'));
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('tampered verification links return 403 and verify nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), ['id' => $other->id, 'hash' => sha1($other->email)]);
+
+    $this->actingAs($user)->get($url)->assertForbidden();
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+
+    $this->actingAs($user)->get(route('verification.verify', ['id' => $user->id, 'hash' => sha1($user->email)]))->assertForbidden();
+});
+
+test('verification notice and resend', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(route('verification.notice'))->assertOk();
+    $this->actingAs($user)->post(route('verification.send'))->assertSessionHas('status');
+    Notification::assertSentTo($user, VerifyEmail::class);
+
+    Notification::fake();
+    $verified = User::factory()->create();
+    $this->actingAs($verified)->post(route('verification.send'))->assertRedirect(route('home'));
+    Notification::assertNothingSent();
+});
+
+test('views never hardcode paths', function () {
+    $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator(resource_path('views')));
+    foreach ($files as $file) {
+        if ($file->isFile()) {
+            expect(file_get_contents($file->getPathname()))->not->toMatch('/(href|action)="\//');
+        }
+    }
+});
