@@ -0,0 +1,66 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Priority must be greater than or equal to 0.');
+        }
+
+        $attempts = 0;
+        $maxAttempts = 5;
+
+        while (true) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    $lockedQueue = Queue::lockForUpdate()->find($queue->id);
+
+                    if ($lockedQueue === null || ! $lockedQueue->is_active) {
+                        throw new InactiveQueueException('Queue is inactive.');
+                    }
+
+                    $code = Ticket::nextCode($lockedQueue->id);
+
+                    return Ticket::create([
+                        'queue_id' => $lockedQueue->id,
+                        'code' => $code,
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => \App\Enums\TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (\Illuminate\Database\QueryException $exception) {
+                $attempts++;
+
+                if ($attempts >= $maxAttempts || ! $this->isUniqueViolation($exception)) {
+                    throw $exception;
+                }
+            }
+        }
+    }
+
+    protected function isUniqueViolation(\Illuminate\Database\QueryException $exception): bool
+    {
+        $sqlState = $exception->getCode();
+        $message = $exception->getMessage();
+
+        if (in_array($sqlState, ['23000', '23505', 23000, 23505], true)) {
+            return true;
+        }
+
+        return str_contains($message, 'UNIQUE constraint failed')
+            || str_contains($message, 'Duplicate entry')
+            || str_contains($message, 'unique constraint');
+    }
+}
