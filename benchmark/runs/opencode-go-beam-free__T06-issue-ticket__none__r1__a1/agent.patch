+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\HasMany;
+
+#[Fillable(['entity_id', 'name', 'slug', 'is_active', 'labels_i18n'])]
+class Queue extends Model
+{
+    use HasFactory;
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'is_active' => 'boolean',
+            'labels_i18n' => 'array',
+        ];
+    }
+
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    public function tickets(): HasMany
+    {
+        return $this->hasMany(Ticket::class);
+    }
+}
diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..2025d3f
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,117 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use App\Models\User;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        static::updating(function (self $ticket) {
+            $allowed = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+            foreach (array_keys($ticket->getDirty()) as $attribute) {
+                if (! in_array($attribute, $allowed, true)) {
+                    throw new LogicException('Ticket fields are immutable after issuance.');
+                }
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Compute the next display code for the given queue, based on insertion order.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $lastValidNumber = 0;
+
+        $tickets = static::where('queue_id', $queueId)
+            ->orderBy('id')
+            ->get(['code']);
+
+        foreach ($tickets as $ticket) {
+            $code = $ticket->code;
+
+            if (is_string($code) && preg_match('/^A(\d+)$/', $code, $matches)) {
+                $lastValidNumber = (int) $matches[1];
+            }
+        }
+
+        $next = $lastValidNumber + 1;
+
+        return 'A' . str_pad((string) $next, 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call this ticket once, recording the calling user.
+     */
+    public function call(User $user): void
+    {
+        DB::transaction(function () use ($user) {
+            $locked = static::lockForUpdate()->find($this->id);
+
+            if ($locked === null) {
+                throw new \RuntimeException('Ticket not found.');
+            }
+
+            $entityId = $locked->queue()->firstOrFail()->entity_id;
+
+            $isMember = $user->memberships()
+                ->where('entity_id', $entityId)
+                ->exists();
+
+            if (! $isMember) {
+                throw new AuthorizationException('You are not a member of this entity.');
+            }
+
+            if ($locked->status !== TicketStatus::Waiting) {
+                throw new LogicException('Only waiting tickets can be called.');
+            }
+
+            $this->status = TicketStatus::Called;
+            $this->called_at = now();
+            $this->called_by_user_id = $user->id;
+
+            $this->save();
+        });
+    }
+}
