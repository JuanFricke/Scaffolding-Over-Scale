+<?php
+
+namespace App\Console\Commands;
+
+use App\Actions\OpenTotemPairingWindow;
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+use InvalidArgumentException;
+
+#[Signature('totem:pairing-code {preset}')]
+#[Description('Open a pairing window for a totem preset and print its 6-digit code')]
+class TotemPairingCode extends Command
+{
+    /**
+     * Execute the console command.
+     */
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+        $preset = TotemPreset::query()->find($presetId);
+
+        if ($preset === null) {
+            $this->error("Totem preset [{$presetId}] not found.");
+
+            return self::FAILURE;
+        }
+
+        try {
+            $code = (new OpenTotemPairingWindow)($preset);
+        } catch (InvalidArgumentException $e) {
+            $this->error($e->getMessage());
+
+            return self::FAILURE;
+        }
+
+        $this->info("Pairing code for \"{$preset->name}\": {$code}");
+        $this->line('Valid for '.TotemPreset::PAIRING_CODE_TTL_MINUTES.' minutes; regenerating replaces it.');
+
+        return self::SUCCESS;
+    }
+}
