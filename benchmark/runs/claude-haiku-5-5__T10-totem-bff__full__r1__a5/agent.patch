+<?php
+
+namespace App\Exceptions;
+
+use RuntimeException;
+
+/**
+ * Totem API failure carrying the stable error code and HTTP status. Rendered as
+ * {"code": "..."} by bootstrap/app.php.
+ */
+class TotemApiException extends RuntimeException
+{
+    /**
+     * @param  array<string, string>  $headers
+     */
+    public function __construct(
+        public readonly string $errorCode,
+        public readonly int $status,
+        public readonly array $headers = [],
+    ) {
+        parent::__construct($errorCode);
+    }
+
+    public static function invalidCodeFormat(): self
+    {
+        return new self('invalid_code_format', 400);
+    }
+
+    public static function invalidToken(): self
+    {
+        return new self('invalid_token', 401, ['WWW-Authenticate' => 'Bearer']);
+    }
+
+    public static function forbidden(): self
+    {
+        return new self('forbidden', 403);
+    }
+
+    public static function queueNotFound(): self
+    {
+        return new self('queue_not_found', 404);
+    }
+
+    public static function invalidPriority(): self
+    {
+        return new self('invalid_priority', 422);
+    }
+}
