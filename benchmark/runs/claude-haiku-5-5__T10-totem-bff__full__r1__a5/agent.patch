+<?php
+
+namespace App\Context;
+
+use App\Exceptions\TotemApiException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+
+/**
+ * Authenticated totem for the current API request.
+ *
+ * Bound by the totem.auth middleware, mirroring Tenant. Holds the effective queue
+ * scope: the JWT queues claim intersected with the preset's current queues.
+ */
+class TotemContext
+{
+    /**
+     * @param  list<int>  $queueIds
+     */
+    public function __construct(
+        public readonly Totem $totem,
+        public readonly TotemPreset $preset,
+        public readonly Entity $entity,
+        public readonly array $queueIds,
+    ) {}
+
+    /**
+     * @throws TotemApiException forbidden when the path entity is not the token entity
+     */
+    public function assertEntity(string $slug): void
+    {
+        if ($slug !== $this->entity->slug) {
+            throw TotemApiException::forbidden();
+        }
+    }
+
+    /**
+     * Resolves a queue slug inside the token entity only.
+     *
+     * @throws TotemApiException queue_not_found (404) when absent from the entity, forbidden (403) when outside the scope
+     */
+    public function queue(string $slug): Queue
+    {
+        $queue = $this->entity->queues()->where('slug', $slug)->first();
+
+        if ($queue === null) {
+            throw TotemApiException::queueNotFound();
+        }
+
+        if (! in_array((int) $queue->id, $this->queueIds, true)) {
+            throw TotemApiException::forbidden();
+        }
+
+        return $queue;
+    }
+}
