+<?php
+
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create(['slug' => 'loja-centro']);
+    $this->preset = TotemPreset::factory()->for($this->entity)->create();
+
+    $this->geral = Queue::factory()->for($this->entity)->create(['name' => 'Geral', 'slug' => 'geral', 'is_active' => true]);
+    $this->preset->queues()->attach($this->geral);
+
+    $this->token = pairTotem($this->preset);
+});
+
+it('issues a ticket through IssueTicket with the totem channel and returns 201', function () {
+    $this->freezeTime();
+
+    $response = $this->withToken($this->token)
+        ->postJson('/api/loja-centro/geral/ticket', ['priority' => 10])
+        ->assertStatus(201)
+        ->assertExactJson([
+            'slug' => 'A001',
+            'queue' => ['slug' => 'geral', 'label' => 'Geral'],
+            'priority' => ['value' => 10, 'label' => 'Prioritário'],
+            'issued_at' => now()->toIso8601ZuluString(),
+        ]);
+
+    $ticket = Ticket::query()->sole();
+
+    expect($ticket->queue_id)->toBe($this->geral->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and($response->json('issued_at'))->toBe($ticket->issued_at->toIso8601ZuluString());
+});
+
+it('allocates sequential codes per queue', function () {
+    $this->withToken($this->token)->postJson('/api/loja-centro/geral/ticket', ['priority' => 0])->assertStatus(201)->assertJsonPath('slug', 'A001');
+    $this->withToken($this->token)->postJson('/api/loja-centro/geral/ticket', ['priority' => 0])->assertStatus(201)->assertJsonPath('slug', 'A002');
+});
+
+it('accepts each backend-owned priority value', function (int $value, string $label) {
+    $this->withToken($this->token)
+        ->postJson('/api/loja-centro/geral/ticket', ['priority' => $value])
+        ->assertStatus(201)
+        ->assertJsonPath('priority.value', $value)
+        ->assertJsonPath('priority.label', $label);
+})->with([
+    [0, 'Normal'],
+    [10, 'Prioritário'],
+    [20, 'Prioridade 80+'],
+]);
+
+it('rejects a priority outside the backend-owned values with 422 and creates nothing', function (mixed $priority) {
+    $this->withToken($this->token)
+        ->postJson('/api/loja-centro/geral/ticket', ['priority' => $priority])
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+})->with([
+    'unknown value' => [5],
+    'above the list' => [30],
+    'negative' => [-10],
+    'numeric string' => ['10'],
+    'boolean' => [true],
+    'null' => [null],
+]);
+
+it('rejects a request without a priority with 422 invalid_priority', function () {
+    $this->withToken($this->token)
+        ->postJson('/api/loja-centro/geral/ticket', [])
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 422 inactive_queue and creates nothing when the queue is inactive', function () {
+    $this->geral->update(['is_active' => false]);
+
+    $this->withToken($this->token)
+        ->postJson('/api/loja-centro/geral/ticket', ['priority' => 0])
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 404 queue_not_found for unknown and foreign queue slugs', function () {
+    $foreign = Queue::factory()->create(['slug' => 'alheia', 'is_active' => true]);
+    $this->preset->queues()->attach($foreign);
+
+    $this->withToken($this->token)
+        ->postJson('/api/loja-centro/nao-existe/ticket', ['priority' => 0])
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    $this->withToken($this->token)
+        ->postJson('/api/loja-centro/alheia/ticket', ['priority' => 0])
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 403 forbidden for an entity queue outside the preset scope', function () {
+    Queue::factory()->for($this->entity)->create(['slug' => 'balcao', 'is_active' => true]);
+
+    $this->withToken($this->token)
+        ->postJson('/api/loja-centro/balcao/ticket', ['priority' => 0])
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 403 forbidden when the path entity is not the token entity', function () {
+    Entity::factory()->create(['slug' => 'outra-loja']);
+
+    $this->withToken($this->token)
+        ->postJson('/api/outra-loja/geral/ticket', ['priority' => 0])
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('requires a valid token', function () {
+    $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 0])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('throttles issuance to 30 per minute per totem with a JSON 429', function () {
+    for ($i = 0; $i < 30; $i++) {
+        $this->withToken($this->token)
+            ->postJson('/api/loja-centro/geral/ticket', ['priority' => 0])
+            ->assertStatus(201);
+    }
+
+    $this->withToken($this->token)
+        ->postJson('/api/loja-centro/geral/ticket', ['priority' => 0])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('rejects a float priority even when it equals a valid value', function () {
+    // postJson() would encode 10.0 as 10, so send the raw JSON body to keep the float.
+    $this->call('POST', '/api/loja-centro/geral/ticket', [], [], [], [
+        'HTTP_AUTHORIZATION' => 'Bearer '.$this->token,
+        'CONTENT_TYPE' => 'application/json',
+        'HTTP_ACCEPT' => 'application/json',
+    ], '{"priority": 10.0}')
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
