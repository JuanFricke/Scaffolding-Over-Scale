index 0000000..63611ae
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,76 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\PairedTotem;
+use App\Totem\TotemToken;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class PairTotem
+{
+    /**
+     * Consumes a pairing code and registers the totem it was opened for.
+     *
+     * The preset row is locked for the whole check-and-consume, so two requests
+     * with the same code cannot both succeed. Every unusable code raises the same
+     * exception; the reason is only written to the audit log.
+     *
+     * @throws InvalidPairingCodeException
+     */
+    public function __invoke(string $code): PairedTotem
+    {
+        return DB::transaction(function () use ($code): PairedTotem {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            $reason = match (true) {
+                $preset === null => 'unknown_code',
+                $preset->login_code_consumed_at !== null => 'consumed',
+                $preset->login_code_expires_at === null || ! $preset->login_code_expires_at->isFuture() => 'expired',
+                ! $preset->is_active => 'inactive_preset',
+                $preset->entity === null => 'entity_missing',
+                default => null,
+            };
+
+            if ($reason !== null) {
+                Log::channel('audit')->warning('Totem pairing failed', [
+                    'reason' => $reason,
+                    'preset_id' => $preset?->id,
+                ]);
+
+                throw new InvalidPairingCodeException("Pairing code rejected: {$reason}.");
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()
+                ->pluck('queues.id')
+                ->map(fn ($id): int => (int) $id)
+                ->values()
+                ->all();
+
+            $token = TotemToken::issue($totem, $preset, $queueIds);
+
+            Log::channel('audit')->info('Totem paired', [
+                'totem_id' => $totem->id,
+                'entity_id' => $preset->entity_id,
+                'preset_id' => $preset->id,
+            ]);
+
+            return new PairedTotem($totem, $preset, $token);
+        });
+    }
+}
