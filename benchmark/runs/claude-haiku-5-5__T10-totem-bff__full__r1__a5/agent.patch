+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Context\TotemContext;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+
+class QueueController extends Controller
+{
+    /**
+     * Active queues of the preset scope for the entity, ordered by name (GET api/{entity}/queues).
+     */
+    public function __invoke(string $entity, TotemContext $context): JsonResponse
+    {
+        $context->assertEntity($entity);
+
+        $queues = $context->entity->queues()
+            ->where('is_active', true)
+            ->whereIn('id', $context->queueIds)
+            ->orderBy('name')
+            ->get();
+
+        return response()->json([
+            'entity' => ['slug' => $context->entity->slug, 'name' => $context->entity->name],
+            'queues' => $queues->values()->map(function (Queue $queue, int $index) use ($context): array {
+                $visual = $context->preset->queueVisual($queue);
+
+                return [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => $visual['description'],
+                    'visual' => [
+                        'color' => $visual['color'],
+                        'icon' => $visual['icon'],
+                        'order' => $index + 1,
+                    ],
+                    'is_active' => true,
+                ];
+            })->all(),
+        ]);
+    }
+}
