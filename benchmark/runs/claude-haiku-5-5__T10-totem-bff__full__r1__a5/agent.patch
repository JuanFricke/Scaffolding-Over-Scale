+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Actions\IssueTicket;
+use App\Context\TotemContext;
+use App\Enums\TicketChannel;
+use App\Enums\TotemPriority;
+use App\Exceptions\TotemApiException;
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TicketController extends Controller
+{
+    /**
+     * Issues a ticket with a backend-owned priority; the server picks the code (POST api/{entity}/{queue}/ticket).
+     */
+    public function __invoke(Request $request, string $entity, string $queue, TotemContext $context): JsonResponse
+    {
+        $context->assertEntity($entity);
+
+        $queueModel = $context->queue($queue);
+
+        $priority = $request->input('priority');
+        $level = is_int($priority) ? TotemPriority::tryFrom($priority) : null;
+
+        if ($level === null) {
+            throw TotemApiException::invalidPriority();
+        }
+
+        // IssueTicket re-checks queue activity under lock and throws InactiveQueueException.
+        $ticket = (new IssueTicket)($queueModel, $level->value, TicketChannel::Totem);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => ['value' => $level->value, 'label' => $level->label()],
+            'issued_at' => $ticket->issued_at->toIso8601ZuluString(),
+        ], 201);
+    }
+}
diff --git a/app/Http/Middleware/AuthenticateTotem.php b/app/Http/Middleware/AuthenticateTotem.php
new file mode 100644
index 0000000..dd39969
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,73 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Context\TotemContext;
+use App\Exceptions\TotemApiException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemToken;
+use Closure;
+use DomainException;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use UnexpectedValueException;
+
+/**
+ * Authenticates a totem call from its Bearer JWT (alias: totem.auth).
+ *
+ * Re-checks the device and preset on every call, so deactivation takes effect
+ * immediately, and narrows the queue scope to the preset's current queues.
+ * Every failure is the same invalid_token response.
+ */
+class AuthenticateTotem
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null) {
+            throw TotemApiException::invalidToken();
+        }
+
+        try {
+            $claims = TotemToken::decode($token);
+        } catch (UnexpectedValueException|DomainException) {
+            throw TotemApiException::invalidToken();
+        }
+
+        $totemId = $claims->totem_id ?? null;
+        $entityId = $claims->entity_id ?? null;
+        $presetId = $claims->preset_id ?? null;
+        $queues = $claims->queues ?? null;
+
+        if (! is_int($totemId) || ! is_int($entityId) || ! is_int($presetId)
+            || ! is_array($queues) || ! collect($queues)->every(fn ($id) => is_int($id))) {
+            throw TotemApiException::invalidToken();
+        }
+
+        // Soft-deleted entities are excluded by the relation, so a removed entity fails here.
+        $totem = Totem::query()->whereKey($totemId)->where('is_active', true)->first();
+        $preset = TotemPreset::query()->whereKey($presetId)->where('is_active', true)->first();
+        $entity = $preset?->entity;
+
+        if ($totem === null || $preset === null || $entity === null
+            || (int) $totem->entity_id !== $entityId
+            || (int) $preset->entity_id !== $entityId) {
+            throw TotemApiException::invalidToken();
+        }
+
+        $presetQueueIds = $preset->queues()
+            ->pluck('queues.id')
+            ->map(fn ($id): int => (int) $id)
+            ->all();
+
+        $scope = array_values(array_intersect($queues, $presetQueueIds));
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        app()->instance(TotemContext::class, new TotemContext($totem, $preset, $entity, $scope));
+
+        return $next($request);
+    }
+}
