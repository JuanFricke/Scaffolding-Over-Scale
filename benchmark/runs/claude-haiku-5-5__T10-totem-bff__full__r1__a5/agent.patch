+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create(['name' => 'Loja Centro', 'slug' => 'loja-centro']);
+    $this->preset = TotemPreset::factory()->for($this->entity)->create([
+        'appearance' => [
+            'queues' => [
+                'geral' => ['description' => 'Atendimento geral', 'color' => '#2E7D32', 'icon' => 'person'],
+            ],
+        ],
+    ]);
+
+    $this->geral = Queue::factory()->for($this->entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+    $this->caixa = Queue::factory()->for($this->entity)->create(['name' => 'Caixa', 'slug' => 'caixa']);
+    $inactive = Queue::factory()->for($this->entity)->create(['name' => 'Fechada', 'slug' => 'fechada', 'is_active' => false]);
+    $outOfScope = Queue::factory()->for($this->entity)->create(['name' => 'Balcao', 'slug' => 'balcao']);
+
+    $this->preset->queues()->attach([$this->geral->id, $this->caixa->id, $inactive->id]);
+    $this->token = pairTotem($this->preset);
+});
+
+it('lists only active queues in the preset scope, ordered by name, with visual specs', function () {
+    $this->withToken($this->token)
+        ->getJson('/api/loja-centro/queues')
+        ->assertOk()
+        ->assertExactJson([
+            'entity' => ['slug' => 'loja-centro', 'name' => 'Loja Centro'],
+            'queues' => [
+                [
+                    'slug' => 'caixa',
+                    'label' => 'Caixa',
+                    'description' => null,
+                    'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => 1],
+                    'is_active' => true,
+                ],
+                [
+                    'slug' => 'geral',
+                    'label' => 'Geral',
+                    'description' => 'Atendimento geral',
+                    'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 2],
+                    'is_active' => true,
+                ],
+            ],
+        ]);
+});
+
+it('follows the preset current queue join for existing tokens', function () {
+    $this->preset->queues()->detach($this->geral->id);
+
+    $this->withToken($this->token)
+        ->getJson('/api/loja-centro/queues')
+        ->assertOk()
+        ->assertJsonCount(1, 'queues')
+        ->assertJsonPath('queues.0.slug', 'caixa');
+});
+
+it('never returns a queue the token was not issued for', function () {
+    $otherPreset = TotemPreset::factory()->for($this->entity)->create();
+    $otherToken = pairTotem($otherPreset);
+
+    $this->withToken($otherToken)
+        ->getJson('/api/loja-centro/queues')
+        ->assertOk()
+        ->assertJsonCount(0, 'queues');
+});
+
+it('answers 403 when the entity slug is not the token entity', function () {
+    Entity::factory()->create(['slug' => 'outra-loja']);
+
+    $this->withToken($this->token)
+        ->getJson('/api/outra-loja/queues')
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
