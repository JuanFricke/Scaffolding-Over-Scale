--- /dev/null
+++ b/app/Actions/OpenTotemPairingWindow.php
@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use InvalidArgumentException;
+
+class OpenTotemPairingWindow
+{
+    /**
+     * Opens (or re-opens) a preset's pairing window and returns the new code.
+     *
+     * Regenerating replaces the previous code immediately. Only reached from the
+     * operator CLI (`totem:pairing-code`), so no per-user authorization applies here.
+     */
+    public function __invoke(TotemPreset $preset): string
+    {
+        return DB::transaction(function () use ($preset): string {
+            $locked = TotemPreset::query()
+                ->whereKey($preset->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $locked->is_active) {
+                throw new InvalidArgumentException('Totem preset is inactive and cannot pair.');
+            }
+
+            $code = $this->newCode();
+
+            // System-set login fields are not fillable by design.
+            $locked->forceFill([
+                'login_code' => $code,
+                'login_code_expires_at' => now()->addMinutes(TotemPreset::PAIRING_CODE_TTL_MINUTES),
+                'login_code_consumed_at' => null,
+            ])->save();
+
+            Log::channel('audit')->info('Totem pairing window opened', [
+                'preset_id' => $locked->id,
+                'entity_id' => $locked->entity_id,
+                'expires_at' => $locked->login_code_expires_at->toIso8601ZuluString(),
+            ]);
+
+            return $code;
+        });
+    }
+
+    /**
+     * Cryptographically random 6-digit code, zero-padded, unused by any preset
+     * (codes are unique across presets so a code alone identifies its preset).
+     */
+    private function newCode(): string
+    {
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while (TotemPreset::query()->where('login_code', $code)->exists());
+
+        return $code;
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
