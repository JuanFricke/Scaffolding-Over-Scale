@@ -0,0 +1,66 @@
+<?php
+
+namespace App\Totem;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use Illuminate\Support\Str;
+use RuntimeException;
+use stdClass;
+
+/**
+ * HS256 totem tokens. Claims: totem_id, entity_id, preset_id, queues, iat, exp, jti.
+ *
+ * Timestamps come from Carbon so tests can freeze time; verification uses
+ * php-jwt, which reads the real clock.
+ */
+final class TotemToken
+{
+    private const string ALGORITHM = 'HS256';
+
+    private const int MIN_SECRET_LENGTH = 32;
+
+    /**
+     * @param  list<int>  $queueIds  queues the preset allowed at pairing time
+     */
+    public static function issue(Totem $totem, TotemPreset $preset, array $queueIds): string
+    {
+        $issuedAt = now()->getTimestamp();
+
+        return JWT::encode([
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => $queueIds,
+            'iat' => $issuedAt,
+            'exp' => $issuedAt + self::ttl(),
+            'jti' => Str::uuid()->toString(),
+        ], self::secret(), self::ALGORITHM);
+    }
+
+    /**
+     * @throws \UnexpectedValueException|\DomainException when the token is malformed, mis-signed or expired
+     */
+    public static function decode(string $jwt): stdClass
+    {
+        return JWT::decode($jwt, new Key(self::secret(), self::ALGORITHM));
+    }
+
+    public static function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl');
+    }
+
+    private static function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if (strlen($secret) < self::MIN_SECRET_LENGTH) {
+            throw new RuntimeException('TOTEM_JWT_SECRET must be at least '.self::MIN_SECRET_LENGTH.' characters.');
+        }
+
+        return $secret;
+    }
+}
