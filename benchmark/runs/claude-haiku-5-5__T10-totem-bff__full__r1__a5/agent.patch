+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Context\TotemContext;
+use App\Enums\TotemPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+
+class PriorityController extends Controller
+{
+    /**
+     * Backend-owned priority levels for one queue (GET api/{entity}/{queue}/priorities).
+     */
+    public function __invoke(string $entity, string $queue, TotemContext $context): JsonResponse
+    {
+        $context->assertEntity($entity);
+
+        $queueModel = $context->queue($queue);
+
+        if (! $queueModel->is_active) {
+            throw new InactiveQueueException('Cannot list priorities for an inactive queue.');
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $context->entity->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => array_map(
+                fn (TotemPriority $priority): array => [
+                    'value' => $priority->value,
+                    'label' => $priority->label(),
+                    'visual' => $priority->visual(),
+                ],
+                TotemPriority::cases(),
+            ),
+        ]);
+    }
+}
