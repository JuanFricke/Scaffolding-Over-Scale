+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned priority levels. The priorities endpoint lists them and the
+ * ticket endpoint accepts only these values (higher value = more prioritized).
+ */
+enum TotemPriority: int
+{
+    case Normal = 0;
+    case Priority = 10;
+    case Over80 = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Priority => 'Prioritário',
+            self::Over80 => 'Prioridade 80+',
+        };
+    }
+
+    /**
+     * @return array{color: string, icon: string, order: int}
+     */
+    public function visual(): array
+    {
+        return match ($this) {
+            self::Normal => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            self::Priority => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            self::Over80 => ['color' => '#6A1B9A', 'icon' => 'elderly', 'order' => 3],
+        };
+    }
+}
