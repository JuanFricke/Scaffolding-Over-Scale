+<?php
+
+use App\Actions\OpenTotemPairingWindow;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Event;
+
+uses(RefreshDatabase::class);
+
+function pairingCodeFromOutput(): string
+{
+    expect(preg_match('/\b(\d{6})\b/', Artisan::output(), $matches))->toBe(1);
+
+    return $matches[1];
+}
+
+it('opens a pairing window with a fresh zero-padded 6-digit code valid for 10 minutes', function () {
+    $this->freezeTime();
+
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->subMinute(),
+        'login_code_consumed_at' => now()->subMinutes(5),
+    ]);
+
+    $exit = Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    $code = pairingCodeFromOutput();
+    $preset->refresh();
+
+    expect($exit)->toBe(0)
+        ->and($code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code)->toBe($code)
+        ->and($preset->login_code_expires_at->timestamp)->toBe(now()->addMinutes(10)->timestamp)
+        ->and($preset->login_code_consumed_at)->toBeNull();
+});
+
+it('keeps leading zeros on every generated code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    // About 10% of uniform 6-digit codes start with zeros; 300 draws make a missing pad obvious.
+    $codes = collect(range(1, 300))->map(function () use ($preset) {
+        return (new OpenTotemPairingWindow)($preset);
+    });
+
+    expect($codes->every(fn (string $code) => preg_match('/\A\d{6}\z/', $code) === 1))->toBeTrue()
+        ->and($codes->filter(fn (string $code) => str_starts_with($code, '0'))->count())->toBeGreaterThan(0);
+});
+
+it('replaces the previous code when regenerated', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '111111']);
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    expect($preset->refresh()->login_code)->not->toBe('111111')
+        ->and(pairingCodeFromOutput())->toBe($preset->login_code);
+});
+
+it('fails with a non-zero exit code for an unknown preset', function () {
+    $exit = Artisan::call('totem:pairing-code', ['preset' => 999999]);
+
+    expect($exit)->not->toBe(0)
+        ->and(Artisan::output())->toContain('999999');
+});
+
+it('refuses to open a window for an inactive preset', function () {
+    $preset = TotemPreset::factory()->create(['is_active' => false, 'login_code' => '424242']);
+
+    $exit = Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    expect($exit)->not->toBe(0)
+        ->and($preset->refresh()->login_code)->toBe('424242');
+});
+
+it('writes an audit entry for the window without logging the code', function () {
+    Event::fake([MessageLogged::class]);
+
+    $preset = TotemPreset::factory()->create();
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    $code = pairingCodeFromOutput();
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($preset) {
+        return $log->message === 'Totem pairing window opened'
+            && $log->context['preset_id'] === $preset->id;
+    });
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($code) {
+        return ! str_contains(json_encode($log->context), $code)
+            && ! str_contains($log->message, $code);
+    });
+});
diff --git a/tests/Feature/Totem/TotemAuthenticationTest.php b/tests/Feature/Totem/TotemAuthenticationTest.php
new file mode 100644
index 0000000..07bf032
--- /dev/null
+++ b/tests/Feature/Totem/TotemAuthenticationTest.php
@@ -0,0 +1,206 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Signs an arbitrary claim set so tests can build tokens the pairing flow never would.
+ */
+function forgeTotemToken(array $claims, ?string $secret = null): string
+{
+    $defaults = ['iat' => time(), 'exp' => time() + 3600, 'jti' => 'test-jti'];
+
+    return JWT::encode(
+        array_merge($defaults, $claims),
+        $secret ?? config('services.totem.jwt_secret'),
+        'HS256',
+    );
+}
+
+/**
+ * @return array{entity: Entity, preset: TotemPreset, token: string}
+ */
+function pairedFixture(): array
+{
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'geral', 'is_active' => true]);
+    $preset->queues()->attach($queue);
+
+    return ['entity' => $preset->entity, 'preset' => $preset, 'token' => pairTotem($preset)];
+}
+
+it('rejects a request without a bearer token', function () {
+    ['entity' => $entity] = pairedFixture();
+
+    $this->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertHeader('WWW-Authenticate', 'Bearer')
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a malformed token', function () {
+    ['entity' => $entity] = pairedFixture();
+
+    $this->withToken('not-a-jwt')
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token signed with another secret', function () {
+    ['entity' => $entity, 'preset' => $preset] = pairedFixture();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = forgeTotemToken([
+        'totem_id' => $totem->id,
+        'entity_id' => $entity->id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+    ], secret: str_repeat('x', 40));
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects an expired token', function () {
+    ['entity' => $entity, 'preset' => $preset] = pairedFixture();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = forgeTotemToken([
+        'totem_id' => $totem->id,
+        'entity_id' => $entity->id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+        'iat' => time() - 7200,
+        'exp' => time() - 3600,
+    ]);
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token once the configured TTL has passed', function () {
+    ['entity' => $entity, 'token' => $token] = pairedFixture();
+
+    // php-jwt reads the real clock, so move its clock past the 3600s TTL instead of Carbon's.
+    JWT::$timestamp = time() + 3601;
+
+    try {
+        $this->withToken($token)
+            ->getJson("/api/{$entity->slug}/queues")
+            ->assertStatus(401)
+            ->assertExactJson(['code' => 'invalid_token']);
+    } finally {
+        JWT::$timestamp = null;
+    }
+});
+
+it('rejects a token with malformed claims', function () {
+    ['entity' => $entity, 'preset' => $preset] = pairedFixture();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = forgeTotemToken([
+        'totem_id' => $totem->id,
+        'entity_id' => $entity->id,
+        'preset_id' => $preset->id,
+        'queues' => 'geral',
+    ]);
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose totem no longer exists', function () {
+    ['entity' => $entity, 'token' => $token] = pairedFixture();
+
+    Totem::query()->delete();
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose totem has been deactivated', function () {
+    ['entity' => $entity, 'token' => $token] = pairedFixture();
+
+    Totem::query()->update(['is_active' => false]);
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose preset has been deactivated', function () {
+    ['entity' => $entity, 'preset' => $preset, 'token' => $token] = pairedFixture();
+
+    $preset->update(['is_active' => false]);
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose preset has been deleted', function () {
+    ['entity' => $entity, 'preset' => $preset, 'token' => $token] = pairedFixture();
+
+    $preset->delete();
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose entity claim does not match the totem and preset', function () {
+    ['entity' => $entity, 'preset' => $preset] = pairedFixture();
+    $other = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = forgeTotemToken([
+        'totem_id' => $totem->id,
+        'entity_id' => $other->id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+    ]);
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose entity has been soft-deleted', function () {
+    ['entity' => $entity, 'token' => $token] = pairedFixture();
+
+    $entity->delete();
+
+    $this->withToken($token)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('quietly updates last_seen_at on every authenticated call', function () {
+    $this->freezeTime();
+    ['entity' => $entity, 'token' => $token] = pairedFixture();
+
+    $this->travel(5)->minutes();
+    $this->withToken($token)->getJson("/api/{$entity->slug}/queues")->assertOk();
+
+    expect(Totem::query()->sole()->last_seen_at->timestamp)->toBe(now()->timestamp);
+});
