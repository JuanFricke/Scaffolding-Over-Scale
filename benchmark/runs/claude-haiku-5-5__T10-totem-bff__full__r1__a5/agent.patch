+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('creates a preset with its entity and a ready-to-use pairing code', function () {
+    $this->freezeTime();
+
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->entity)->toBeInstanceOf(Entity::class)
+        ->and($preset->login_code)->toMatch('/\A\d{6}\z/')
+        ->and($preset->login_code_expires_at->timestamp)->toBe(now()->addMinutes(10)->timestamp)
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->is_active)->toBeTrue();
+});
+
+it('gives each factory preset a distinct login code', function () {
+    $codes = TotemPreset::factory()->count(20)->create()->pluck('login_code');
+
+    expect($codes->unique())->toHaveCount(20);
+});
+
+it('creates an active totem for an entity', function () {
+    $totem = Totem::factory()->create();
+
+    expect($totem->entity)->toBeInstanceOf(Entity::class)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->toBeNull();
+});
+
+it('exposes totems and presets on the entity', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    expect($entity->totems)->toHaveCount(1)
+        ->and($entity->totems->first()->is($totem))->toBeTrue()
+        ->and($entity->totemPresets)->toHaveCount(1)
+        ->and($entity->totemPresets->first()->is($preset))->toBeTrue();
+});
+
+it('attaches and detaches queues through the preset join', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue);
+
+    expect($preset->queues()->pluck('queues.id')->all())->toBe([$queue->id]);
+
+    $preset->queues()->detach($queue);
+
+    expect($preset->queues()->count())->toBe(0);
+});
