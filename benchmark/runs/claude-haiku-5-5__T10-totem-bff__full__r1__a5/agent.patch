+<?php
+
+namespace App\Models;
+
+use Database\Factories\TotemPresetFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\BelongsToMany;
+
+/**
+ * Limited totem settings bundle: which queues a paired totem may see and how it looks.
+ *
+ * login_code_* fields are system-set by App\Actions\OpenTotemPairingWindow and
+ * App\Actions\PairTotem, so they are deliberately not fillable.
+ */
+#[Fillable(['entity_id', 'name', 'appearance', 'is_active'])]
+class TotemPreset extends Model
+{
+    /** @use HasFactory<TotemPresetFactory> */
+    use HasFactory;
+
+    /** Lifetime of a pairing window. */
+    public const int PAIRING_CODE_TTL_MINUTES = 10;
+
+    /** Visual defaults for a queue without an entry in appearance.queues. */
+    public const string DEFAULT_QUEUE_COLOR = '#0055FF';
+
+    public const string DEFAULT_QUEUE_ICON = 'ticket';
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'is_active' => 'boolean',
+            'appearance' => 'array',
+            'login_code_expires_at' => 'datetime',
+            'login_code_consumed_at' => 'datetime',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Queues this preset can see and issue from (join: totem_preset_queue).
+     *
+     * @return BelongsToMany<Queue, $this>
+     */
+    public function queues(): BelongsToMany
+    {
+        return $this->belongsToMany(Queue::class, 'totem_preset_queue', 'preset_id', 'queue_id')
+            ->withTimestamps();
+    }
+
+    /**
+     * Display spec for one queue, read from appearance.queues.<slug>.
+     *
+     * @return array{description: ?string, color: string, icon: string}
+     */
+    public function queueVisual(Queue $queue): array
+    {
+        $queues = $this->appearance['queues'] ?? [];
+        $spec = is_array($queues[$queue->slug] ?? null) ? $queues[$queue->slug] : [];
+
+        return [
+            'description' => $spec['description'] ?? null,
+            'color' => $spec['color'] ?? self::DEFAULT_QUEUE_COLOR,
+            'icon' => $spec['icon'] ?? self::DEFAULT_QUEUE_ICON,
+        ];
+    }
+}
