+<?php
+
+use App\Http\Controllers\Totem\AuthController;
+use App\Http\Controllers\Totem\PriorityController;
+use App\Http\Controllers\Totem\QueueController;
+use App\Http\Controllers\Totem\TicketController;
+use Illuminate\Support\Facades\Route;
+
+// Totem API (prefix /api). Every path is validated against the totem JWT; see docs/api/totem.md.
+Route::post('totem/auth', AuthController::class)->middleware('throttle:10,1');
+
+Route::middleware('totem.auth')->group(function () {
+    Route::get('{entity}/queues', QueueController::class);
+    Route::get('{entity}/{queue}/priorities', PriorityController::class);
+    Route::post('{entity}/{queue}/ticket', TicketController::class)->middleware('throttle:totem-ticket');
+});
diff --git a/tests/Feature/Totem/PairTotemTest.php b/tests/Feature/Totem/PairTotemTest.php
new file mode 100644
index 0000000..29bedb5
--- /dev/null
+++ b/tests/Feature/Totem/PairTotemTest.php
@@ -0,0 +1,212 @@
+<?php
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Event;
+
+uses(RefreshDatabase::class);
+
+it('pairs a totem with a valid code and returns a signed token', function () {
+    $this->freezeTime();
+
+    $preset = TotemPreset::factory()->create(['name' => 'Entrada principal']);
+    $queue = $preset->entity->queues()->create(['name' => 'Geral', 'slug' => 'geral', 'is_active' => true]);
+    $preset->queues()->attach($queue);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonStructure(['token', 'token_type', 'expires_in', 'entity' => ['slug', 'name']])
+        ->assertJson([
+            'token_type' => 'Bearer',
+            'expires_in' => 3600,
+            'entity' => ['slug' => $preset->entity->slug, 'name' => $preset->entity->name],
+        ]);
+
+    $totem = Totem::query()->sole();
+    $claims = JWT::decode($response->json('token'), new Key(config('services.totem.jwt_secret'), 'HS256'));
+
+    expect($totem->entity_id)->toBe($preset->entity_id)
+        ->and($totem->name)->toBe('Entrada principal')
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at->timestamp)->toBe(now()->timestamp)
+        ->and($claims->totem_id)->toBe($totem->id)
+        ->and($claims->entity_id)->toBe($preset->entity_id)
+        ->and($claims->preset_id)->toBe($preset->id)
+        ->and($claims->queues)->toBe([$queue->id])
+        ->and($claims->iat)->toBe(now()->timestamp)
+        ->and($claims->exp)->toBe(now()->addSeconds(3600)->timestamp)
+        ->and($claims->jti)->not->toBeEmpty();
+
+    expect($preset->refresh()->login_code_consumed_at)->not->toBeNull();
+});
+
+it('rejects a code that is not exactly six digits with 400', function (mixed $code) {
+    $preset = TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+
+    expect(Totem::query()->count())->toBe(0)
+        ->and($preset->refresh()->login_code_consumed_at)->toBeNull();
+})->with([
+    'empty string' => [''],
+    'missing' => [null],
+    'five digits' => ['12345'],
+    'seven digits' => ['1234567'],
+    'letters' => ['12a456'],
+    'spaces' => ['123 56'],
+    'json number' => [123456],
+    'array' => [['123456']],
+]);
+
+it('rejects a request without a code key with 400', function () {
+    $this->postJson('/api/totem/auth', [])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+});
+
+it('answers the same 401 for unknown, expired, consumed and inactive codes', function (string $case) {
+    $preset = TotemPreset::factory()->create(['login_code' => '123456']);
+
+    match ($case) {
+        'unknown' => null,
+        'expired' => $preset->forceFill(['login_code_expires_at' => now()->subSecond()])->save(),
+        'consumed' => $preset->forceFill(['login_code_consumed_at' => now()])->save(),
+        'inactive' => $preset->update(['is_active' => false]),
+    };
+
+    $this->postJson('/api/totem/auth', ['code' => $case === 'unknown' ? '654321' : '123456'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with(['unknown', 'expired', 'consumed', 'inactive']);
+
+it('does not accept a code a second time', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('stops accepting the previous code once the window is regenerated', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '123456']);
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+    $fresh = $preset->refresh()->login_code;
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401);
+
+    $this->postJson('/api/totem/auth', ['code' => $fresh])
+        ->assertOk();
+});
+
+it('throttles pairing attempts to 10 per minute with a JSON 429', function () {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('audits pairing success and failure without ever logging the code', function () {
+    Event::fake([MessageLogged::class]);
+
+    $preset = TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => '654321'])->assertStatus(401);
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) {
+        return $log->message === 'Totem pairing failed'
+            && $log->level === 'warning'
+            && $log->context['reason'] === 'unknown_code';
+    });
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($preset) {
+        return $log->message === 'Totem paired'
+            && $log->context['preset_id'] === $preset->id
+            && $log->context['entity_id'] === $preset->entity_id;
+    });
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) {
+        return ! str_contains(json_encode($log->context), '123456')
+            && ! str_contains(json_encode($log->context), '654321')
+            && ! str_contains($log->message, '123456');
+    });
+});
+
+it('answers CORS preflight for localhost origins with 204', function (string $origin) {
+    $this->withHeaders([
+        'Origin' => $origin,
+        'Access-Control-Request-Method' => 'POST',
+        'Access-Control-Request-Headers' => 'content-type',
+    ])->options('/api/totem/auth')
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', $origin)
+        ->assertHeaderMissing('Access-Control-Allow-Credentials');
+})->with([
+    'localhost with port' => ['http://localhost:8081'],
+    'https localhost' => ['https://localhost'],
+    'loopback with port' => ['http://127.0.0.1:5000'],
+]);
+
+it('does not answer CORS for other origins', function () {
+    $this->withHeaders([
+        'Origin' => 'https://evil.example.test',
+        'Access-Control-Request-Method' => 'POST',
+    ])->options('/api/totem/auth')
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+
+    $this->withHeaders(['Origin' => 'https://evil.example.test'])
+        ->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+});
+
+it('allows the configured TOTEM_WEB_ORIGIN', function () {
+    config(['cors.allowed_origins' => ['https://totem.pegafila.test']]);
+
+    $this->withHeaders([
+        'Origin' => 'https://totem.pegafila.test',
+        'Access-Control-Request-Method' => 'POST',
+    ])->options('/api/totem/auth')
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem.pegafila.test');
+});
+
+it('sends the allowed origin on the actual response, without credentials', function () {
+    $this->withHeaders(['Origin' => 'http://localhost:8081'])
+        ->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(401)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081')
+        ->assertHeaderMissing('Access-Control-Allow-Credentials');
+});
+
+it('allows the Authorization header on preflight for the data endpoints', function () {
+    $response = $this->withHeaders([
+        'Origin' => 'http://127.0.0.1:8081',
+        'Access-Control-Request-Method' => 'GET',
+        'Access-Control-Request-Headers' => 'authorization',
+    ])->options('/api/loja-centro/queues')
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://127.0.0.1:8081')
+        ->assertHeaderMissing('Access-Control-Allow-Credentials');
+
+    expect(explode(', ', $response->headers->get('Access-Control-Allow-Headers')))->toContain('authorization');
+});
