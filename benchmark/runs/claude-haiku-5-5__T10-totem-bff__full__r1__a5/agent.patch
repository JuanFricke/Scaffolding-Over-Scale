@@ -0,0 +1,39 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Actions\PairTotem;
+use App\Exceptions\TotemApiException;
+use App\Http\Controllers\Controller;
+use App\Totem\TotemToken;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class AuthController extends Controller
+{
+    /**
+     * Exchanges a preset pairing code for a totem JWT (POST api/totem/auth).
+     */
+    public function __invoke(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        // \A...\z rather than ^...$: `$` also matches before a trailing newline.
+        if (! is_string($code) || preg_match('/\A\d{6}\z/', $code) !== 1) {
+            Log::channel('audit')->warning('Totem pairing failed', ['reason' => 'invalid_format']);
+
+            throw TotemApiException::invalidCodeFormat();
+        }
+
+        $paired = (new PairTotem)($code);
+        $entity = $paired->preset->entity;
+
+        return response()->json([
+            'token' => $paired->token,
+            'token_type' => 'Bearer',
+            'expires_in' => TotemToken::ttl(),
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+        ]);
+    }
+}
