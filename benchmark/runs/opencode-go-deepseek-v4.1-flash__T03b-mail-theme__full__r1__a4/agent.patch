diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..c80b68c
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,81 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+test('the verification notification builds its URL from the named route', function () {
+    $user = User::factory()->unverified()->create();
+
+    $mail = (new VerifyEmail)->toMail($user);
+
+    expect($mail->actionUrl)
+        ->toContain(route('verification.verify', [
+            'id' => $user->id,
+            'hash' => sha1($user->email),
+        ], false))
+        ->toContain('signature=');
+});
+
+test('a signed link verifies the logged-in user', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $this->actingAs($user)
+        ->get($url)
+        ->assertRedirect('/');
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link for another user is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $other->id,
+        'hash' => sha1($other->email),
+    ]);
+
+    $this->actingAs($user)
+        ->get($url)
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a mismatched hash is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($other->email),
+    ]);
+
+    $this->actingAs($user)
+        ->get($url)
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', [
+            'id' => $user->id,
+            'hash' => sha1($user->email),
+        ]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
diff --git a/tests/Feature/Auth/MailNotificationsTest.php b/tests/Feature/Auth/MailNotificationsTest.php
new file mode 100644
index 0000000..c7a8fdd
--- /dev/null
+++ b/tests/Feature/Auth/MailNotificationsTest.php
@@ -0,0 +1,76 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the application is pinned to pt-BR and the PegaFila brand', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('the environment example and test runner use the same locale', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)
+        ->toContain('APP_NAME=PegaFila')
+        ->toContain('APP_LOCALE=pt_BR')
+        ->toContain('APP_FALLBACK_LOCALE=en');
+
+    $phpunit = file_get_contents(base_path('phpunit.xml'));
+
+    expect($phpunit)
+        ->toContain('name="APP_NAME" value="PegaFila"')
+        ->toContain('name="APP_LOCALE" value="pt_BR"')
+        ->toContain('name="APP_FALLBACK_LOCALE" value="en"');
+});
+
+test('markdown mail uses the PegaFila theme', function () {
+    $theme = resource_path('views/vendor/mail/html/themes/pegafila.css');
+
+    expect(config('mail.markdown.theme'))->toBe('pegafila')
+        ->and($theme)->toBeFile()
+        ->and(file_get_contents($theme))->toContain('#0f7490');
+});
+
+test('the password reset notification is translated and themed', function () {
+    app()->setLocale('pt_BR');
+
+    $user = User::factory()->create();
+    $mail = (new ResetPassword('plain-token'))->toMail($user);
+
+    expect($mail->subject)->toBe('Redefina sua senha')
+        ->and($mail->actionText)->toBe('Redefinir senha');
+
+    $html = (string) $mail->render();
+
+    expect($html)
+        ->toContain('PegaFila')
+        ->toContain('Olá!')
+        ->toContain('Redefinir senha')
+        ->toContain('Você recebeu esse e-mail')
+        ->toContain('Se você estiver tendo problemas')
+        ->not->toContain('having trouble clicking')
+        ->toContain('#0f7490');
+});
+
+test('the email verification notification is translated and themed', function () {
+    app()->setLocale('pt_BR');
+
+    $user = User::factory()->unverified()->create();
+    $mail = (new VerifyEmail)->toMail($user);
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($mail->actionText)->toBe('Verifique o endereço de e-mail');
+
+    $html = (string) $mail->render();
+
+    expect($html)
+        ->toContain('PegaFila')
+        ->toContain('Verifique o endereço de e-mail')
+        ->toContain('#0f7490');
+});
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..b23b0de
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,125 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the forgot password form', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('Esqueci minha senha')
+        ->assertSee('name="email"', false)
+        ->assertSee('Enviar link de redefinição');
+});
+
+test('a reset link is sent when the e-mail belongs to a user', function () {
+    Notification::fake();
+
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown e-mail gets the same response and no notification', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('the e-mail is required and must be valid', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+});
+
+test('password reset requests are throttled', function () {
+    Notification::fake();
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+            ->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset form shows the token and the e-mail', function () {
+    $this->get(route('password.reset', ['token' => 'plain-token', 'email' => 'user@example.com']))
+        ->assertOk()
+        ->assertSee('Redefinir senha')
+        ->assertSee('name="token"', false)
+        ->assertSee('value="plain-token"', false)
+        ->assertSee('value="user@example.com"', false)
+        ->assertSee('name="password_confirmation"', false);
+});
+
+test('a valid token resets the password', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create(['remember_token' => 'old-token']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'NewPassword123',
+    ])
+        ->assertRedirect('/')
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewPassword123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token');
+
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token does not reset the password', function () {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => 'invalid-token',
+        'email' => $user->email,
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'NewPassword123',
+    ])
+        ->assertSessionHasErrors('email');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+});
+
+test('the new password must be strong and confirmed', function (array $password) {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), array_merge([
+        'token' => $token,
+        'email' => $user->email,
+    ], $password))
+        ->assertSessionHasErrors('password');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+})->with([
+    'too short' => [['password' => 'Ab1', 'password_confirmation' => 'Ab1']],
+    'without letters' => [['password' => '12345678', 'password_confirmation' => '12345678']],
+    'without numbers' => [['password' => 'PasswordX', 'password_confirmation' => 'PasswordX']],
+    'without mixed case' => [['password' => 'password123', 'password_confirmation' => 'password123']],
+    'not confirmed' => [['password' => 'NewPassword123', 'password_confirmation' => 'Another123']],
+]);
