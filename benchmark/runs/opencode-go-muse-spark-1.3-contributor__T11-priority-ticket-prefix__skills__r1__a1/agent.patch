diff --git a/tests/Feature/TicketCodePrefixTest.php b/tests/Feature/TicketCodePrefixTest.php
new file mode 100644
index 0000000..233af94
--- /dev/null
+++ b/tests/Feature/TicketCodePrefixTest.php
@@ -0,0 +1,150 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function prefixOwner(Entity $entity): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+it('resolves default prefixes by range', function () {
+    expect(Queue::DEFAULT_PREFIX_MAP)->toBe([0 => 'N', 10 => 'P', 20 => 'E'])
+        ->and(Queue::defaultPrefixFor(0))->toBe('N')
+        ->and(Queue::defaultPrefixFor(10))->toBe('P')
+        ->and(Queue::defaultPrefixFor(20))->toBe('E')
+        ->and(Queue::defaultPrefixFor(-5))->toBe('N')
+        ->and(Queue::defaultPrefixFor(5))->toBe('P')
+        ->and(Queue::defaultPrefixFor(25))->toBe('E');
+
+    $queue = Queue::factory()->create();
+
+    expect($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(7))->toBe('P')
+        ->and($queue->prefixForPriority(20))->toBe('E');
+});
+
+it('prefers the custom map over defaults', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe(['0' => 'X', '10' => 'Y', '20' => 'Z'])
+        ->and($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(5))->toBe('P');
+});
+
+it('rejects invalid prefix maps on save', function () {
+    foreach ([['foo' => 'A'], ['-1' => 'A'], ['010' => 'A'], ['0' => 'xx'], ['0' => 'n'], ['0' => 'AB'], ['0' => 'N', '10' => 'N'], ['0' => 'E']] as $bad) {
+        $queue = Queue::factory()->make(['priority_prefix_map' => $bad]);
+
+        expect(fn () => $queue->save())->toThrow(InvalidArgumentException::class);
+    }
+});
+
+it('stores an empty map as null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('sequences prefixes independently and restarts daily', function () {
+    $queue = Queue::factory()->create();
+    Carbon::setTestNow(Carbon::parse('2026-09-28 10:00:00'));
+
+    $n1 = (new IssueTicket)($queue, 0);
+    $n2 = (new IssueTicket)($queue, 0);
+    $p1 = (new IssueTicket)($queue, 10);
+    $p2 = (new IssueTicket)($queue, 10);
+
+    expect($n1->code)->toBe('N001')
+        ->and($n2->code)->toBe('N002')
+        ->and($p1->code)->toBe('P001')
+        ->and($p2->code)->toBe('P002')
+        ->and($n1->issue_date->toDateString())->toBe('2026-09-28');
+
+    Carbon::setTestNow(Carbon::parse('2026-09-29 09:00:00'));
+
+    expect((new IssueTicket)($queue, 0)->code)->toBe('N001')
+        ->and((new IssueTicket)($queue, 10)->code)->toBe('P001');
+
+    Carbon::setTestNow();
+});
+
+it('ignores legacy codes and skips malformed codes', function () {
+    $queue = Queue::factory()->create();
+    Carbon::setTestNow(Carbon::parse('2026-09-28 10:00:00'));
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+
+    expect((new IssueTicket)($queue, 0)->code)->toBe('N001');
+
+    Carbon::setTestNow();
+});
+
+it('does not reuse gaps from deleted tickets', function () {
+    $queue = Queue::factory()->create();
+
+    (new IssueTicket)($queue, 0);
+    $second = (new IssueTicket)($queue, 0);
+    (new IssueTicket)($queue, 0);
+    $second->delete();
+
+    expect((new IssueTicket)($queue, 0)->code)->toBe('N004');
+});
+
+it('allocates factory codes for the ticket day and priority', function () {
+    $queue = Queue::factory()->create();
+    Carbon::setTestNow(Carbon::parse('2026-10-01 10:00:00'));
+    (new IssueTicket)($queue, 0);
+
+    $past = Ticket::factory()->for($queue)->create(['issued_at' => Carbon::parse('2026-09-28 10:00:00')]);
+
+    expect($past->code)->toBe('N001')
+        ->and($past->issue_date->toDateString())->toBe('2026-09-28');
+
+    $explicit = Ticket::factory()->for($queue)->create(['code' => 'N999', 'issued_at' => Carbon::parse('2026-09-28 11:00:00')]);
+
+    expect($explicit->code)->toBe('N999')
+        ->and($explicit->issue_date->toDateString())->toBe('2026-09-28');
+
+    $priority = Ticket::factory()->for($queue)->create(['priority' => 10]);
+
+    expect($priority->code)->toStartWith('P');
+
+    Carbon::setTestNow();
+});
+
+it('manages the map through UpdateQueue', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    $updated = (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X', '10' => 'Y', '20' => 'Z']);
+
+    expect($updated->fresh()->priority_prefix_map)->toBe(['0' => 'X', '10' => 'Y', '20' => 'Z']);
+
+    $unchanged = (new UpdateQueue)($updated->fresh(), $owner, name: 'New Name');
+
+    expect($unchanged->priority_prefix_map)->toBe(['0' => 'X', '10' => 'Y', '20' => 'Z']);
+
+    $cleared = (new UpdateQueue)($unchanged->fresh(), $owner, priorityPrefixMap: []);
+
+    expect($cleared->fresh()->priority_prefix_map)->toBeNull();
+
+    expect(fn () => (new UpdateQueue)($cleared->fresh(), $owner, priorityPrefixMap: ['0' => 'N', '10' => 'N']))
+        ->toThrow(ValidationException::class);
+
+    expect($cleared->fresh()->priority_prefix_map)->toBeNull();
+});
