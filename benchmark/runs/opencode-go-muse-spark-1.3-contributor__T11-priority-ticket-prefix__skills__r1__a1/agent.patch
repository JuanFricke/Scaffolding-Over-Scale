+
+    /**
+     * Validate a priority -> prefix map. Throws on invalid.
+     *
+     * @param  array<mixed, mixed>|null  $map
+     */
+    public static function validatePriorityPrefixMap(?array $map): void
+    {
+        if ($map === null) {
+            return;
+        }
+
+        if ($map === []) {
+            return;
+        }
+
+        foreach ($map as $key => $value) {
+            if (is_int($key)) {
+                if ($key < 0) {
+                    throw new InvalidArgumentException('Invalid priority_prefix_map: keys must be non-negative integers.');
+                }
+            } elseif (is_string($key)) {
+                if (! preg_match('/^(0|[1-9][0-9]*)$/', $key)) {
+                    throw new InvalidArgumentException('Invalid priority_prefix_map: keys must be non-negative integers in canonical form.');
+                }
+            } else {
+                throw new InvalidArgumentException('Invalid priority_prefix_map: keys must be non-negative integers.');
+            }
+
+            if (! is_string($value) || ! preg_match('/^[A-Z]$/', $value)) {
+                throw new InvalidArgumentException('Invalid priority_prefix_map: values must be exactly one uppercase letter A-Z.');
+            }
+        }
+
+        // Effective prefixes must be unique: custom entries plus the default
+        // fallback for the uncovered levels 0/10/20.
+        $normalizedKeys = [];
+        foreach (array_keys($map) as $key) {
+            $normalizedKeys[] = (int) $key;
+        }
+
+        $effective = array_values($map);
+        foreach ([0, 10, 20] as $level) {
+            if (! in_array($level, $normalizedKeys, true)) {
+                $effective[] = self::defaultPrefixFor($level);
+            }
+        }
+
+        if (count(array_unique($effective)) !== count($effective)) {
+            throw new InvalidArgumentException('Invalid priority_prefix_map: effective prefixes must be unique.');
+        }
+    }
+
