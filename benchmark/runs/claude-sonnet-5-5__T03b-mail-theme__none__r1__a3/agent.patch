+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+
+test('the app runs as PegaFila in pt_BR', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(app()->getLocale())->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en')
+        ->and(config('mail.markdown.theme'))->toBe('pegafila');
+});
+
+test('reset mail is in pt-BR with the brand colour', function () {
+    $user = User::factory()->create();
+    $mail = (new ResetPassword('token'))->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Redefina sua senha');
+    expect($html)->toContain('PegaFila', 'Olá!', 'Redefinir senha', 'Você recebeu esse e-mail', '#0f7490')
+        ->not->toContain('having trouble clicking');
+});
+
+test('verification mail is in pt-BR', function () {
+    $user = User::factory()->unverified()->create();
+    $notification = new VerifyEmail;
+    $mail = $notification->toMail($user);
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail');
+    expect((string) $mail->render())->toContain('Verifique o endereço de e-mail', '#0f7490');
+});
+
+test('forgot password form is shown to guests only', function () {
+    $this->get(route('password.request'))->assertOk();
+    $this->actingAs(User::factory()->create())->get(route('password.request'))->assertRedirect();
+});
+
+test('reset link is sent to existing users and the response never reveals it', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->from('/forgot-password')->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect('/forgot-password')
+        ->assertSessionHas('status', __('passwords.sent'));
+    Notification::assertSentTo($user, ResetPassword::class);
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertSessionHas('status', __('passwords.sent'));
+    Notification::assertCount(1);
+
+    $this->post(route('password.email'), ['email' => 'invalid'])->assertSessionHasErrors('email');
+});
+
+test('reset form prefills the e-mail', function () {
+    $this->get(route('password.reset', ['token' => 'abc', 'email' => 'a@b.com']))
+        ->assertOk()
+        ->assertSee('value="a@b.com"', false)
+        ->assertSee('value="abc"', false);
+});
+
+test('password can be reset with a valid token', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ])->assertRedirect('/')->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NovaSenha123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old');
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('password reset rejects bad tokens and weak passwords', function () {
+    $user = User::factory()->create();
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => 'wrong', 'email' => $user->email,
+        'password' => 'NovaSenha123', 'password_confirmation' => 'NovaSenha123',
+    ])->assertSessionHasErrors('email');
+
+    foreach (['short1A', 'alllowercase1', 'ALLUPPERCASE1', 'NoNumbersHere'] as $weak) {
+        $this->post(route('password.update'), [
+            'token' => $token, 'email' => $user->email,
+            'password' => $weak, 'password_confirmation' => $weak,
+        ])->assertSessionHasErrors('password');
+    }
+
+    $this->post(route('password.update'), [
+        'token' => $token, 'email' => $user->email,
+        'password' => 'NovaSenha123', 'password_confirmation' => 'Different123',
+    ])->assertSessionHasErrors('password');
+});
