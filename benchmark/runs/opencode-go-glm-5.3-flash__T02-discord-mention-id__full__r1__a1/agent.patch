 class DiscordOpsAlert
 {
@@ -66,7 +70,32 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $suffix = $this->mention() === '' ? '' : "\n".$this->mention();
+
+        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength - mb_strlen($suffix)).$suffix;
+    }
+
+    /**
+     * Mention of the configured Discord user, e.g. "<@1234567890123456789>".
+     *
+     * Only a Discord snowflake (17-20 ASCII digits, surrounding whitespace
+     * trimmed, integers accepted) is accepted; anything else — including
+     * "@everyone"/"@here" or values with embedded characters — yields no
+     * mention so the content stays ping-safe.
+     */
+    private function mention(): string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (is_int($id)) {
+            $id = (string) $id;
+        }
+
+        if (! is_string($id) || preg_match('/\A\d{17,20}\z/', $id = trim($id)) !== 1) {
+            return '';
+        }
+
+        return '<@'.$id.'>';
     }
 
     private function safe(string $key, mixed $value): string
