+<?php
+
+namespace App\Models;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use App\Models\UserRole;
+
+class EntityMembership extends Model
+{
+    use HasFactory;
+
+    protected $fillable = ['entity_id', 'user_id', 'role'];
+
+    protected function casts(): array
+    {
+        return [
+            'role' => UserRole::class,
+        ];
+    }
+
+    /**
+     * Scope for owner role.
+     */
+    public function scopeOwner($query)
+    {
+        return $query->where('role', UserRole::Owner->value);
+    }
+
+    /**
+     * Scope for admin role.
+     */
+    public function scopeAdmin($query)
+    {
+        return $query->where('role', UserRole::Admin->value);
+    }
+
+    /**
+     * Scope for employee role.
+     */
+    public function scopeEmployee($query)
+    {
+        return $query->where('role', UserRole::Employee->value);
+    }
+
+    /**
+     * Relationship to entity.
+     */
+    public function entity()
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Relationship to user.
+     */
+    public function user()
+    {
+        return $this->belongsTo(User::class);
+    }
+}
