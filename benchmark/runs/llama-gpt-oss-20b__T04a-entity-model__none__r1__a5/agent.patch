+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+use Illuminate\Support\Facades\DB;
+
+class CreateEntityMembershipsTable extends Migration
+{
+    public function up(): void
+    {
+        Schema::create('entity_memberships', function (Blueprint $table) {
+            $table->id();
+            $table->foreignId('entity_id')->constrained()->cascadeOnDelete();
+            $table->foreignId('user_id')->constrained()->cascadeOnDelete();
+            $table->string('role')->default('employee');
+            $table->timestamps();
+
+            // Unique per entity-user pair
+            $table->unique(['entity_id', 'user_id'], 'entity_memberships_entity_user_unique');
+        });
+
+        // Add generated column and unique index for owner enforcement
+        $driver = Schema::getConnection()->getDriverName();
+        if ($driver === 'mysql') {
+            DB::statement(
+                "ALTER TABLE entity_memberships ADD COLUMN owner_seq INT GENERATED ALWAYS AS (CASE WHEN role = 'owner' THEN 1 END) STORED;"
+            );
+        } else {
+            // SQLite
+            DB::statement(
+                "ALTER TABLE entity_memberships ADD COLUMN owner_seq INTEGER;"
+            );
+            DB::statement(
+                "UPDATE entity_memberships SET owner_seq = CASE WHEN role = 'owner' THEN 1 END;"
+            );
+            // Since SQLite cannot generate column, we rely on application to set it; for uniqueness we add trigger
+            DB::statement(
+                "CREATE TRIGGER trg_entity_memberships_owner_seq_update AFTER UPDATE OF role ON entity_memberships BEGIN UPDATE entity_memberships SET owner_seq = CASE WHEN NEW.role = 'owner' THEN 1 ELSE NULL END WHERE id = NEW.id; END;
+CREATE TRIGGER trg_entity_memberships_owner_seq_insert AFTER INSERT ON entity_memberships BEGIN UPDATE entity_memberships SET owner_seq = CASE WHEN NEW.role = 'owner' THEN 1 ELSE NULL END WHERE id = NEW.id; END;"
+            );
+        }
+        // Unique index on entity_id, owner_seq to enforce single owner
+        DB::statement("CREATE UNIQUE INDEX entity_memberships_one_owner ON entity_memberships(entity_id, owner_seq);");
+    }
+
+    public function down(): void
+    {
+        Schema::dropIfExists('entity_memberships');
+    }
+}
