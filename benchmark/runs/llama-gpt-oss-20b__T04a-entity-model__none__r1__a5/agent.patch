+<?php
+
+namespace App\Models;
+
+use App\Models\EntityMembership;
+use Illuminate\Database\Eloquent\Attributes\SoftDeletes;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use App\Models\UserRole;
+
+class Entity extends Model
+{
+    use HasFactory, SoftDeletes;
+
+    protected $fillable = ['name', 'slug'];
+
+    /**
+     * Get the route key name for model binding.
+     */
+    public function getRouteKeyName(): string
+    {
+        return 'slug';
+    }
+
+    /**
+     * Relationship to memberships.
+     */
+    public function memberships()
+    {
+        return $this->hasMany(EntityMembership::class);
+    }
+
+    /**
+     * Users that belong to this entity.
+     */
+    public function users()
+    {
+        return $this->belongsToMany(User::class, 'entity_memberships');
+    }
+
+    /**
+     * Owner membership for this entity.
+     */
+    public function owner()
+    {
+        return $this->hasOne(EntityMembership::class)->where('role', UserRole::Owner->value);
+    }
+}
