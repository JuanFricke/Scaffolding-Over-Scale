+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Carbon\Carbon;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+afterEach(function () {
+    Carbon::setTestNow();
+});
+
+it('defaults issue_date to today', function () {
+    Carbon::setTestNow('2026-10-29 12:00:00');
+
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-10-29');
+});
+
+it('derives issue_date from an overridden issued_at', function () {
+    Carbon::setTestNow('2026-10-29 12:00:00');
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create(['issued_at' => '2026-09-28 10:00:00']);
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($ticket->code)->toBe('N001');
+});
+
+it('allocates the code for the ticket day even when today already has the same prefix', function () {
+    Carbon::setTestNow('2026-10-29 12:00:00');
+    $queue = Queue::factory()->create();
+
+    $today = Ticket::factory()->for($queue)->create();
+    $past = Ticket::factory()->for($queue)->create(['issued_at' => '2026-09-28 10:00:00']);
+
+    expect($today->code)->toBe('N001')
+        ->and($past->code)->toBe('N001')
+        ->and($past->issue_date->toDateString())->toBe('2026-09-28');
+});
+
+it('allocates the prefix from the ticket priority', function (int $priority, string $code) {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create(['priority' => $priority]);
+
+    expect($ticket->code)->toBe($code);
+})->with([
+    [0, 'N001'],
+    [10, 'P001'],
+    [20, 'E001'],
+]);
+
+it('allocates the prefix from the queue custom map', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+
+    $ticket = Ticket::factory()->for($queue)->create();
+
+    expect($ticket->code)->toBe('X001');
+});
+
+it('keeps an explicit code', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create(['code' => 'N999']);
+
+    expect($ticket->code)->toBe('N999');
+});
+
+it('accepts an explicit issue_date that matches issued_at', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create([
+        'issued_at' => '2026-09-28 10:00:00',
+        'issue_date' => '2026-09-28',
+    ]);
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-09-28');
+});
+
+it('rejects an explicit issue_date that differs from issued_at', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => Ticket::factory()->for($queue)->create([
+        'issued_at' => '2026-09-28 10:00:00',
+        'issue_date' => '2026-09-29',
+    ]))->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
