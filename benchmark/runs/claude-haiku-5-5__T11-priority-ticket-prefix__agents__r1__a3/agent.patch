+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+return new class extends Migration
+{
+    /**
+     * Run the migrations.
+     *
+     * Codes restart every day per prefix, so uniqueness moves from
+     * (queue_id, code) to (queue_id, code, issue_date).
+     */
+    public function up(): void
+    {
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->date('issue_date')->nullable()->after('issued_at');
+        });
+
+        DB::table('tickets')->update(['issue_date' => DB::raw('DATE(issued_at)')]);
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->date('issue_date')->nullable(false)->change();
+        });
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropUnique(['queue_id', 'code']);
+            $table->unique(['queue_id', 'code', 'issue_date']);
+        });
+    }
+
+    /**
+     * Reverse the migrations.
+     *
+     * Refuses to roll back while the same code exists on more than one day,
+     * because restoring unique(queue_id, code) would fail on that data.
+     */
+    public function down(): void
+    {
+        $duplicated = DB::table('tickets')
+            ->groupBy('queue_id', 'code')
+            ->havingRaw('COUNT(*) > 1')
+            ->exists();
+
+        if ($duplicated) {
+            throw new RuntimeException(
+                'Cannot roll back tickets.issue_date: the same ticket code exists on more than one day for a queue.'
+            );
+        }
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropUnique(['queue_id', 'code', 'issue_date']);
+            $table->unique(['queue_id', 'code']);
+        });
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropColumn('issue_date');
+        });
+    }
+};
