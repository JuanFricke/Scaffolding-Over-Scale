diff --git a/tests/Feature/PriorityPrefixTest.php b/tests/Feature/PriorityPrefixTest.php
new file mode 100644
index 0000000..b7fa7c0
--- /dev/null
+++ b/tests/Feature/PriorityPrefixTest.php
@@ -0,0 +1,183 @@
+<?php
+
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('defaults the prefix by priority level and falls back by range', function (int $priority, string $prefix) {
+    expect(Queue::defaultPrefixFor($priority))->toBe($prefix);
+})->with([
+    [0, 'N'],
+    [10, 'P'],
+    [20, 'E'],
+    [-5, 'N'],
+    [5, 'P'],
+    [15, 'P'],
+    [25, 'E'],
+    [100, 'E'],
+]);
+
+it('uses the custom map entry before the default and the default for uncovered priorities', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['10' => 'Y', '5' => 'Q']]);
+
+    expect($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(5))->toBe('Q')
+        ->and($queue->prefixForPriority(6))->toBe('P')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('E');
+});
+
+it('uses the defaults when no map is set', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->priority_prefix_map)->toBeNull()
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(10))->toBe('P')
+        ->and($queue->prefixForPriority(20))->toBe('E');
+});
+
+it('accepts valid maps and round-trips integer priority keys', function (array $map) {
+    $queue = Queue::factory()->create(['priority_prefix_map' => $map]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe($map);
+})->with([
+    [['0' => 'X', '10' => 'Y', '20' => 'Z']],
+    [['0' => 'X']],
+    [['5' => 'Q']],
+    [['0' => 'E', '20' => 'N']],
+]);
+
+it('rejects invalid priority keys', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+})->with([
+    [['foo' => 'X']],
+    [[-1 => 'X']],
+    [['010' => 'X']],
+    [['1.5' => 'X']],
+]);
+
+it('rejects values that are not exactly one uppercase letter', function (mixed $letter) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => ['0' => $letter]]))
+        ->toThrow(InvalidArgumentException::class);
+})->with(['xx', 'x', '1', 5, '', 'X1', "X\n"]);
+
+it('rejects effective prefixes that repeat a letter', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+})->with([
+    [['0' => 'N', '10' => 'N']],
+    [['0' => 'E']],
+    [['5' => 'N']],
+    [['0' => 'X', '5' => 'X']],
+]);
+
+it('stores an empty map as null on every save', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+
+    $queue->priority_prefix_map = ['0' => 'X'];
+    $queue->save();
+
+    $queue->priority_prefix_map = [];
+    $queue->save();
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('keeps the stored map when a save with an invalid map is rejected', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+
+    $queue->priority_prefix_map = ['0' => 'N', '10' => 'N'];
+
+    expect(fn () => $queue->save())->toThrow(InvalidArgumentException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+});
+
+it('sets, keeps and clears the map through UpdateQueue', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X']);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+
+    (new UpdateQueue)($queue->fresh(), $owner, name: 'Renomeada');
+
+    expect($queue->fresh()->name)->toBe('Renomeada')
+        ->and($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+
+    (new UpdateQueue)($queue->fresh(), $owner, priorityPrefixMap: []);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects an invalid map from UpdateQueue and leaves the queue unchanged', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'priority_prefix_map' => ['0' => 'X']]);
+
+    expect(fn () => (new UpdateQueue)($queue, $owner, name: 'Outro', priorityPrefixMap: ['0' => 'N', '10' => 'N']))
+        ->toThrow(function (ValidationException $e) {
+            expect($e->errors())->toHaveKey('priority_prefix_map');
+        });
+
+    expect($queue->fresh()->name)->toBe('Geral')
+        ->and($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+});
+
+it('keeps owner and admin authorization for the prefix map', function () {
+    $entity = Entity::factory()->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $outsider = User::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(fn () => (new UpdateQueue)($queue, $employee, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(fn () => (new UpdateQueue)($queue, $outsider, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('stores issue_date as a non-nullable date and keys codes by day', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->for($queue)->create(['code' => 'N001', 'issued_at' => '2026-09-28 10:00:00']);
+
+    expect($first->issue_date->toDateString())->toBe('2026-09-28');
+
+    Ticket::factory()->for($queue)->create(['code' => 'N001', 'issued_at' => '2026-09-29 10:00:00']);
+
+    expect(fn () => Ticket::factory()->for($queue)->create(['code' => 'N001', 'issued_at' => '2026-09-28 11:00:00']))
+        ->toThrow(QueryException::class);
+
+    expect(fn () => DB::table('tickets')->insert([
+        'queue_id' => $queue->id,
+        'code' => 'N002',
+        'priority' => 0,
+        'channel' => 'virtual',
+        'status' => 'waiting',
+        'issued_at' => now(),
+        'issue_date' => null,
+    ]))->toThrow(QueryException::class);
+});
