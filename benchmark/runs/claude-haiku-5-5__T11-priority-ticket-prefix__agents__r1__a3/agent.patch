     /** @use HasFactory<QueueFactory> */
     use HasFactory;
 
+    /**
+     * Default ticket code letter per priority level (docs/business-rules.md).
+     *
+     * @var array<int, string>
+     */
+    public const DEFAULT_PREFIX_MAP = [0 => 'N', 10 => 'P', 20 => 'E'];
+
+    protected static function booted(): void
+    {
+        static::saving(function (Queue $queue): void {
+            $queue->priority_prefix_map = self::normalizePriorityPrefixMap($queue->priority_prefix_map);
+        });
+    }
+
+    /**
+     * Default ticket code letter for a priority: exact level first, then by range.
+     */
+    public static function defaultPrefixFor(int $priority): string
+    {
+        return self::DEFAULT_PREFIX_MAP[$priority]
+            ?? match (true) {
+                $priority <= 0 => 'N',
+                $priority >= 20 => 'E',
+                default => 'P',
+            };
+    }
+
+    /**
+     * Validate a custom priority -> letter map and return its canonical form.
+     *
+     * An empty map means "use the defaults" and normalizes to null. Keys must be
+     * canonical non-negative integers, values exactly one uppercase letter, and
+     * the effective prefixes must be unique: the custom entries plus the default
+     * for every level 0/10/20 the map does not cover.
+     *
+     * @return array<int, string>|null
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function normalizePriorityPrefixMap(mixed $map): ?array
+    {
+        if ($map === null || $map === []) {
+            return null;
+        }
+
+        if (! is_array($map)) {
+            throw new InvalidArgumentException('Priority prefix map must be an array.');
+        }
+
+        $normalized = [];
+
+        foreach ($map as $key => $letter) {
+            $priority = is_int($key) ? $key : self::parseCanonicalKey($key);
+
+            if ($priority === null || $priority < 0) {
+                throw new InvalidArgumentException('Priority prefix map keys must be non-negative integers.');
+            }
+
+            if (! is_string($letter) || preg_match('/^[A-Z]\z/', $letter) !== 1) {
+                throw new InvalidArgumentException('Priority prefix map values must be a single uppercase letter (A-Z).');
+            }
+
+            $normalized[$priority] = $letter;
+        }
+
+        $effective = array_values($normalized);
+
+        foreach (self::DEFAULT_PREFIX_MAP as $level => $letter) {
+            if (! array_key_exists($level, $normalized)) {
+                $effective[] = $letter;
+            }
+        }
+
+        if (count(array_unique($effective)) !== count($effective)) {
+            throw new InvalidArgumentException('Priority prefixes must be unique within a queue.');
+        }
+
+        ksort($normalized);
+
+        return $normalized;
+    }
+
+    /**
+     * Ticket code letter for a priority: the queue's custom entry, else the default.
+     */
+    public function prefixForPriority(int $priority): string
+    {
+        return $this->priority_prefix_map[$priority] ?? self::defaultPrefixFor($priority);
+    }
+
+    /**
+     * Canonical non-negative integer string ("0", "10"), or null for anything else
+     * ("010", "-1", "foo", overflowing values).
+     */
+    private static function parseCanonicalKey(string $key): ?int
+    {
+        if (! ctype_digit($key) || (string) (int) $key !== $key) {
+            return null;
+        }
+
+        return (int) $key;
+    }
+
