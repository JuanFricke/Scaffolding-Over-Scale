+});
+
+test('five failed attempts lock the e-mail and IP, even for the right password', function () {
+    $user = User::factory()->create(['password' => 'Senha1234']);
+
+    $component = Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Errada1234');
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component->call('submit');
+        expect($component->errors()->first('email'))->toBe(__('auth.failed'));
+    }
+
+    $component->set('password', 'Senha1234')->call('submit');
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas');
+    $this->assertGuest();
+});
+
+test('a successful login clears the failed attempts', function () {
+    $user = User::factory()->create(['password' => 'Senha1234']);
+
+    $component = Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Errada1234');
+
+    for ($attempt = 0; $attempt < 4; $attempt++) {
+        $component->call('submit');
+    }
+
+    $component->set('password', 'Senha1234')->call('submit')->assertRedirect(route('home'));
+
+    Auth::logout();
+
+    $component->set('password', 'Errada1234');
+
+    for ($attempt = 0; $attempt < 4; $attempt++) {
+        $component->call('submit');
+        expect($component->errors()->first('email'))->toBe(__('auth.failed'));
+    }
+});
+
+test('remember me keeps the user signed in with a remember token', function () {
+    $user = User::factory()->create(['password' => 'Senha1234', 'remember_token' => null]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Senha1234')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect($user->refresh()->remember_token)->not->toBeNull();
+});
+
+test('failed logins are written to the audit channel', function () {
+    $audit = Mockery::spy();
+    Log::spy()->shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    $user = User::factory()->create(['password' => 'Senha1234']);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Errada1234')
+        ->call('submit');
+
+    $audit->shouldHaveReceived('info')->with('Login failed', Mockery::type('array'))->once();
+});
+
+test('authenticated users visiting the login page are redirected home', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..4de47f2
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,123 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password page is shown in Brazilian Portuguese by default', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('Esqueceu a senha?')
+        ->assertSee('Enviar link de redefinição');
+});
+
+test('requesting a reset link for an existing e-mail sends the notification', function () {
+    Notification::fake();
+
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('requesting a reset link for an unknown e-mail gives the same answer and sends nothing', function () {
+    Notification::fake();
+
+    User::factory()->create(['email' => 'known@pegafila.test']);
+
+    $this->post(route('password.email'), ['email' => 'unknown@pegafila.test'])
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('the reset link request is throttled to 6 per minute', function () {
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('password.email'), ['email' => 'unknown@pegafila.test'])
+            ->assertSessionHas('status');
+    }
+
+    $this->post(route('password.email'), ['email' => 'unknown@pegafila.test'])
+        ->assertStatus(429);
+});
+
+test('the reset form asks for the e-mail exactly once', function () {
+    $response = $this->get(route('password.reset', ['token' => 'abc123', 'email' => 'maria@pegafila.test']))
+        ->assertOk();
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('a valid token sets the new password, rotates remember_token and redirects to login', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create(['remember_token' => 'old-token']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NovaSenha123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token')
+        ->and($user->remember_token)->not->toBeNull();
+
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token is rejected on the e-mail field', function () {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => 'not-a-real-token',
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ])
+        ->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect(Hash::check('NovaSenha123', $user->refresh()->password))->toBeFalse();
+});
+
+test('the new password must follow the default rule', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'fraca',
+        'password_confirmation' => 'fraca',
+    ])
+        ->assertSessionHasErrors(['password']);
+});
+
+test('the new password must be confirmed', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'OutraSenha123',
+    ])
+        ->assertSessionHasErrors(['password']);
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..8cc13ef
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,116 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the register page is shown in Brazilian Portuguese by default', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSee('Criar conta')
+        ->assertSee('Confirmar senha');
+});
+
+test('a user can register, is logged in and receives the verification e-mail', function () {
+    Notification::fake();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@pegafila.test')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'maria@pegafila.test')->firstOrFail();
+
+    expect($user->name)->toBe('Maria Silva')
+        ->and($user->email_verified_at)->toBeNull()
+        ->and($user->password)->not->toBe('Senha1234');
+
+    $this->assertAuthenticatedAs($user);
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('the e-mail is stored in lowercase', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'Maria@PegaFila.test')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit');
+
+    $this->assertDatabaseHas('users', ['email' => 'maria@pegafila.test']);
+});
+
+test('the password must follow the default rule', function (string $password) {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@pegafila.test')
+        ->set('password', $password)
+        ->set('password_confirmation', $password)
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    $this->assertDatabaseMissing('users', ['email' => 'maria@pegafila.test']);
+})->with([
+    'too short' => ['Abc123'],
+    'no numbers' => ['SenhaForte'],
+    'no uppercase letters' => ['senha1234'],
+    'no lowercase letters' => ['SENHA1234'],
+    'no letters' => ['12345678'],
+]);
+
+test('a mismatched confirmation fails the confirmed rule on the password', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@pegafila.test')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha12345')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+});
+
+test('the e-mail must be strict and unique', function () {
+    User::factory()->create(['email' => 'taken@pegafila.test']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'taken@pegafila.test')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria pegafila.test')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+});
+
+test('registration is limited to 5 attempts per IP', function () {
+    $component = Livewire::test(Register::class);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component->call('submit')->assertHasErrors(['name' => 'required']);
+    }
+
+    $component->call('submit');
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas');
+    expect(User::count())->toBe(0);
+});
+
+test('authenticated users visiting the register page are redirected home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
