diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..9458b52
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,125 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationLink(User $user): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('unverified users are sent to the verification notice from home', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('home'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('guests are sent to the login page from home', function () {
+    $this->get(route('home'))->assertRedirect(route('login'));
+});
+
+test('the verification notice is shown in Brazilian Portuguese to unverified users', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee('Verifique seu e-mail')
+        ->assertSee('Reenviar e-mail de verificação');
+});
+
+test('a valid verification link verifies the logged-in user and redirects home', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationLink($user))
+        ->assertRedirect(route('home'));
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a verification link with a tampered id returns 403 and verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $tamperedLink = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $other->getKey(),
+        'hash' => sha1($other->getEmailForVerification()),
+    ]);
+
+    $this->actingAs($user)
+        ->get($tamperedLink)
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a verification link whose signature was edited is rejected', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $edited = str_replace('/email/verify/'.$user->getKey().'/', '/email/verify/'.$other->getKey().'/', verificationLink($user));
+
+    $this->actingAs($user)
+        ->get($edited)
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('resending the verification e-mail sends it and flashes the status', function () {
+    Notification::fake();
+
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertSessionHas('status', 'verification-link-sent');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('verified users get no verification e-mail and are redirected home', function () {
+    Notification::fake();
+
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('resending the verification e-mail is throttled to 6 per minute', function () {
+    Notification::fake();
+
+    $user = User::factory()->unverified()->create();
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->actingAs($user)->post(route('verification.send'));
+    }
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertStatus(429);
+});
+
+test('the verification pages require a login', function () {
+    $this->post(route('verification.send'))->assertRedirect(route('login'));
+    $this->get(route('verification.notice'))->assertRedirect(route('login'));
+});
+
+test('a verified user who opens the notice is sent home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('home'));
+});
