@@ -0,0 +1,68 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Determine whether the user can view the membership (any member of its entity).
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $this->roleIn($user, $membership) !== null;
+    }
+
+    /**
+     * Determine whether the user can assign a role to the membership.
+     *
+     * The owner's role never changes through assignment: ownership moves only by transfer,
+     * so demoting the owner would leave the entity without one.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        return $this->canManage($user, $membership);
+    }
+
+    /**
+     * Determine whether the user can delete the membership.
+     *
+     * The owner's membership is never deletable. Any member may remove their own membership;
+     * otherwise only the owner or an admin of the entity may remove it.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->getKey()) {
+            return true;
+        }
+
+        return $this->canManage($user, $membership);
+    }
+
+    /**
+     * Determine whether the user is an owner or admin of the membership's entity.
+     */
+    private function canManage(User $user, EntityMembership $membership): bool
+    {
+        return in_array($this->roleIn($user, $membership), [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    /**
+     * The user's role in the membership's entity, or null when they are not a member of it.
+     */
+    private function roleIn(User $user, EntityMembership $membership): ?UserRole
+    {
+        return $user->membershipFor($membership->entity_id)?->role;
+    }
+}
