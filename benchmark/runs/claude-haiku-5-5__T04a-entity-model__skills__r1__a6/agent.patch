+<?php
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->policy = new EntityPolicy;
+    $this->entity = Entity::factory()->create();
+});
+
+test('any authenticated user may create an entity', function () {
+    expect($this->policy->create(User::factory()->create()))->toBeTrue();
+});
+
+test('any member of an entity may view it', function (string $role) {
+    expect($this->policy->view(memberWith($this->entity, $role), $this->entity))->toBeTrue();
+})->with(['owner', 'admin', 'employee']);
+
+test('owner and admin may update and delete an entity', function (string $role) {
+    $user = memberWith($this->entity, $role);
+
+    expect($this->policy->update($user, $this->entity))->toBeTrue()
+        ->and($this->policy->delete($user, $this->entity))->toBeTrue();
+})->with(['owner', 'admin']);
+
+test('an employee may not update or delete an entity', function () {
+    $user = memberWith($this->entity, 'employee');
+
+    expect($this->policy->update($user, $this->entity))->toBeFalse()
+        ->and($this->policy->delete($user, $this->entity))->toBeFalse();
+});
+
+test('only the owner may manage settings', function () {
+    expect($this->policy->manageSettings(memberWith($this->entity, 'owner'), $this->entity))->toBeTrue()
+        ->and($this->policy->manageSettings(memberWith($this->entity, 'admin'), $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings(memberWith($this->entity, 'employee'), $this->entity))->toBeFalse();
+});
+
+test('non-members get nothing on an entity', function () {
+    $outsider = User::factory()->create();
+
+    expect($this->policy->view($outsider, $this->entity))->toBeFalse()
+        ->and($this->policy->update($outsider, $this->entity))->toBeFalse()
+        ->and($this->policy->delete($outsider, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($outsider, $this->entity))->toBeFalse();
+});
+
+test('an owner or admin of another entity gets nothing on this one', function () {
+    $other = memberWith(Entity::factory()->create(), 'owner');
+    $admin = memberWith(Entity::factory()->create(), 'admin');
+
+    expect($this->policy->view($other, $this->entity))->toBeFalse()
+        ->and($this->policy->update($admin, $this->entity))->toBeFalse()
+        ->and($this->policy->delete($admin, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($other, $this->entity))->toBeFalse();
+});
+
+test('the policy is discovered for the Entity model', function () {
+    $admin = memberWith($this->entity, 'admin');
+
+    expect(Gate::forUser($admin)->allows('update', $this->entity))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('manageSettings', $this->entity))->toBeFalse();
+});
diff --git a/tests/Feature/EntitySchemaTest.php b/tests/Feature/EntitySchemaTest.php
new file mode 100644
index 0000000..4020427
--- /dev/null
+++ b/tests/Feature/EntitySchemaTest.php
@@ -0,0 +1,138 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array<string, array{columns: list<string>, unique: bool}>
+ */
+function indexesOf(string $table): array
+{
+    $indexes = [];
+
+    foreach (Schema::getIndexes($table) as $index) {
+        $indexes[$index['name']] = $index;
+    }
+
+    return $indexes;
+}
+
+test('entities slug has a unique index with the agreed name', function () {
+    $index = indexesOf('entities')['entities_slug_unique'] ?? null;
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['slug']);
+});
+
+test('entities soft deletes and timestamps', function () {
+    expect(Schema::hasColumns('entities', ['id', 'name', 'slug', 'created_at', 'updated_at', 'deleted_at']))
+        ->toBeTrue();
+});
+
+test('entity memberships have the agreed columns and unique (entity, user) index', function () {
+    expect(Schema::hasColumns('entity_memberships', ['id', 'entity_id', 'user_id', 'role', 'created_at', 'updated_at']))
+        ->toBeTrue();
+
+    $index = indexesOf('entity_memberships')['entity_memberships_entity_user_unique'] ?? null;
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['entity_id', 'user_id']);
+});
+
+test('the owner sequence column has a unique (entity, owner_seq) index', function () {
+    $index = indexesOf('entity_memberships')['entity_memberships_one_owner'] ?? null;
+
+    expect(Schema::hasColumn('entity_memberships', 'owner_seq'))->toBeTrue()
+        ->and($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['entity_id', 'owner_seq']);
+});
+
+test('role defaults to employee when the database inserts without one', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    expect(DB::table('entity_memberships')->value('role'))->toBe('employee');
+});
+
+test('the database rejects a duplicate membership for the same entity and user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(QueryException::class);
+});
+
+test('the database rejects a slug that is already taken, even by a soft-deleted entity', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+    $entity->delete();
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))
+        ->toThrow(QueryException::class);
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->create([
+        'entity_id' => $owner->entity_id,
+    ]))->toThrow(QueryException::class);
+});
+
+test('different entities may each have their own owner', function () {
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect(EntityMembership::query()->owner()->count())->toBe(2);
+});
+
+test('an entity may have any number of non-owner memberships', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->count(2)->for($entity)->create();
+    EntityMembership::factory()->employee()->count(3)->for($entity)->create();
+
+    expect(EntityMembership::query()->where('entity_id', $entity->id)->count())->toBe(6);
+});
+
+test('the owner slot is freed once the owner is demoted', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    $owner->update(['role' => 'admin']);
+
+    expect(fn () => EntityMembership::factory()->owner()->create([
+        'entity_id' => $owner->entity_id,
+    ]))->not->toThrow(QueryException::class);
+});
+
+test('a deleted user takes their memberships with them', function () {
+    $membership = EntityMembership::factory()->create();
+
+    DB::table('users')->where('id', $membership->user_id)->delete();
+
+    expect(EntityMembership::query()->whereKey($membership->id)->exists())->toBeFalse();
+});
+
+test('a force-deleted entity takes its memberships with it', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    Entity::query()->whereKey($membership->entity_id)->forceDelete();
+
+    expect(EntityMembership::query()->whereKey($membership->id)->exists())->toBeFalse();
+});
