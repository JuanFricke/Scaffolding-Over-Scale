+
+test('the membership factory states set the matching role', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('the role is cast to UserRole', function () {
+    $membership = EntityMembership::factory()->create();
+
+    DB::table('entity_memberships')->where('id', $membership->id)->update(['role' => 'admin']);
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('owner, admin and employee scopes filter by role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect(EntityMembership::query()->owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::query()->admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::query()->employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('a membership belongs to its entity and its user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity->is(Entity::query()->find($membership->entity_id)))->toBeTrue()
+        ->and($membership->user->is(User::query()->find($membership->user_id)))->toBeTrue();
+});
+
+test('entity_id, user_id and role are mass assignable and owner_seq is not', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    $membership = EntityMembership::query()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'role' => UserRole::Admin,
+        'owner_seq' => 1,
+    ]);
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin)
+        ->and($membership->fresh()->owner_seq)->toBeNull();
+});
+
+test('a user exposes its memberships, entities and the membership for one entity', function () {
+    $user = User::factory()->create();
+    $first = EntityMembership::factory()->admin()->for($user)->create();
+    $second = EntityMembership::factory()->employee()->for($user)->create();
+    EntityMembership::factory()->create();
+
+    expect($user->memberships()->pluck('id')->sort()->values()->all())
+        ->toBe([$first->id, $second->id])
+        ->and($user->entities()->pluck('entities.id')->sort()->values()->all())
+        ->toBe([$first->entity_id, $second->entity_id])
+        ->and($user->membershipFor($first->entity_id)?->is($first))->toBeTrue()
+        ->and($user->membershipFor(Entity::factory()->create()->id))->toBeNull();
+});
+
+test('a user with no memberships has no membership to resolve', function () {
+    $user = User::factory()->create();
+
+    expect($user->memberships)->toHaveCount(0)
+        ->and($user->membershipFor(1))->toBeNull();
+});
diff --git a/tests/Feature/EntityMembershipPolicyTest.php b/tests/Feature/EntityMembershipPolicyTest.php
new file mode 100644
index 0000000..2ceb224
--- /dev/null
+++ b/tests/Feature/EntityMembershipPolicyTest.php
@@ -0,0 +1,99 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->policy = new EntityMembershipPolicy;
+    $this->entity = Entity::factory()->create();
+    $this->owner = EntityMembership::factory()->owner()->for($this->entity)->create();
+    // The entity already has its owner, so "owner" must act as that membership, not a new one.
+    $this->memberIn = fn (string $role): User => $role === 'owner' ? $this->owner->user : memberWith($this->entity, $role);
+});
+
+test('any member of the same entity may view a membership', function (string $role) {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+    $viewer = ($this->memberIn)($role);
+
+    expect($this->policy->view($viewer, $target))->toBeTrue();
+})->with(['owner', 'admin', 'employee']);
+
+test('a non-member may not view a membership', function () {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+    $other = memberWith(Entity::factory()->create(), 'owner');
+
+    expect($this->policy->view(User::factory()->create(), $target))->toBeFalse()
+        ->and($this->policy->view($other, $target))->toBeFalse();
+});
+
+test('owner and admin may assign roles to other members', function (string $role) {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+
+    expect($this->policy->assignRole(($this->memberIn)($role), $target))->toBeTrue();
+})->with(['owner', 'admin']);
+
+test('an employee may not assign roles', function () {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+
+    expect($this->policy->assignRole(memberWith($this->entity, 'employee'), $target))->toBeFalse();
+});
+
+test('the owner role is never reassigned through assignRole', function () {
+    $admin = memberWith($this->entity, 'admin');
+
+    expect($this->policy->assignRole($this->owner->user, $this->owner))->toBeFalse()
+        ->and($this->policy->assignRole($admin, $this->owner))->toBeFalse();
+});
+
+test('assigning roles in another entity is not allowed', function () {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+    $otherAdmin = memberWith(Entity::factory()->create(), 'admin');
+
+    expect($this->policy->assignRole($otherAdmin, $target))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    $admin = memberWith($this->entity, 'admin');
+
+    expect($this->policy->delete($this->owner->user, $this->owner))->toBeFalse()
+        ->and($this->policy->delete($admin, $this->owner))->toBeFalse();
+});
+
+test('any member may remove their own non-owner membership', function (string $role) {
+    $membership = EntityMembership::factory()->{$role}()->for($this->entity)->create();
+
+    expect($this->policy->delete($membership->user, $membership))->toBeTrue();
+})->with(['admin', 'employee']);
+
+test('owner and admin may remove other non-owner members', function (string $role) {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+
+    expect($this->policy->delete(($this->memberIn)($role), $target))->toBeTrue();
+})->with(['owner', 'admin']);
+
+test('an employee may not remove other members', function () {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+    $employee = memberWith($this->entity, 'employee');
+
+    expect($this->policy->delete($employee, $target))->toBeFalse();
+});
+
+test('an admin of another entity may not remove members here', function () {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+    $otherAdmin = memberWith(Entity::factory()->create(), 'admin');
+
+    expect($this->policy->delete($otherAdmin, $target))->toBeFalse();
+});
+
+test('the policy is discovered for the EntityMembership model', function () {
+    $target = EntityMembership::factory()->employee()->for($this->entity)->create();
+
+    expect(Gate::forUser($this->owner->user)->allows('delete', $target))->toBeTrue()
+        ->and(Gate::forUser($target->user)->allows('delete', $this->owner))->toBeFalse();
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..5aa16fd
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,84 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('an entity is routed by its slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme-store']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->resolveRouteBinding('acme-store')?->is($entity))->toBeTrue();
+});
+
+test('the entity factory creates a named entity with a unique slug', function () {
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    expect($first->name)->not->toBeEmpty()
+        ->and($first->slug)->not->toBeEmpty()
+        ->and($first->slug)->not->toBe($second->slug);
+});
+
+test('an entity exposes its memberships and the users behind them', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->memberships()->pluck('id')->sort()->values()->all())
+        ->toBe([$owner->id, $employee->id]);
+
+    expect($entity->users()->pluck('users.id')->sort()->values()->all())
+        ->toBe([$owner->user_id, $employee->user_id]);
+});
+
+test('the users relation exposes the membership role on the pivot', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+
+    $user = $entity->users()->first();
+
+    expect($user->pivot->role)->toBe('admin');
+});
+
+test('an entity owner returns the owner membership or null', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->owner()->first())->toBeNull();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect($entity->owner()->first()?->is($owner))->toBeTrue()
+        ->and($entity->owner()->first()->role)->toBe(UserRole::Owner);
+});
+
+test('the owner relation can be eager loaded', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+
+    $loaded = Entity::query()->with('owner')->findOrFail($entity->id);
+
+    expect($loaded->owner?->is($owner))->toBeTrue();
+});
+
+test('a soft-deleted entity is hidden from the user entities relation', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $user = $membership->user;
+    $entity = $membership->entity;
+
+    $entity->delete();
+
+    expect($user->entities()->count())->toBe(0)
+        ->and(Entity::withTrashed()->whereKey($entity->id)->exists())->toBeTrue();
+});
+
+test('UserRole has the agreed values and manageable roles', function () {
+    expect(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee')
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
