+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('answers a preflight from a local web origin with 204 and the exact origin', function () {
+    $response = $this->options('/api/totem/auth', [], [
+        'Origin' => 'http://localhost:8081',
+        'Access-Control-Request-Method' => 'POST',
+    ]);
+
+    $response->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+
+    expect($response->headers->get('Access-Control-Allow-Credentials'))->toBeNull();
+});
+
+it('answers a preflight from an https 127.0.0.1 origin on any port', function () {
+    $response = $this->options('/api/{entity}/queues', [], [
+        'Origin' => 'https://127.0.0.1:9090',
+        'Access-Control-Request-Method' => 'GET',
+    ]);
+
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('https://127.0.0.1:9090');
+});
+
+it('sends no allow-origin for a foreign origin', function () {
+    $preflight = $this->options('/api/totem/auth', [], [
+        'Origin' => 'https://evil.example',
+        'Access-Control-Request-Method' => 'POST',
+    ]);
+
+    expect($preflight->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+
+    ['preset' => $preset] = totemFixture(['Geral']);
+    $actual = $this->withToken(totemToken($preset))
+        ->get('/api/some-entity/queues', ['Origin' => 'https://evil.example']);
+
+    expect($actual->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+});
+
+it('stamps an allow-origin on actual responses from an allowed origin', function () {
+    ['entity' => $entity, 'preset' => $preset] = totemFixture(['Geral']);
+
+    $response = $this->withToken(totemToken($preset))
+        ->getJson("/api/{$entity->slug}/queues", ['Origin' => 'http://localhost:3000']);
+
+    $response->assertOk();
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:3000');
+});
+
+it('allows the extra TOTEM_WEB_ORIGIN origin', function () {
+    config(['cors.allowed_origins' => ['https://totem.example.com']]);
+
+    $response = $this->options('/api/totem/auth', [], [
+        'Origin' => 'https://totem.example.com',
+        'Access-Control-Request-Method' => 'POST',
+    ]);
+
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('https://totem.example.com');
+});
diff --git a/tests/Feature/Totem/TotemJwtTest.php b/tests/Feature/Totem/TotemJwtTest.php
new file mode 100644
index 0000000..41aa9f7
--- /dev/null
+++ b/tests/Feature/Totem/TotemJwtTest.php
@@ -0,0 +1,73 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Firebase\JWT\JWT;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('issues a token with the pairing claims and echoes the configured ttl', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $preset->queues()->attach($queue->id);
+
+    ['token' => $token, 'expires_in' => $expiresIn] = app(TotemJwt::class)->issue($totem, $preset, [$queue->id, 999]);
+
+    expect($expiresIn)->toBe(3600);
+
+    $claims = app(TotemJwt::class)->decode($token);
+    expect($claims['totem_id'])->toBe($totem->id)
+        ->and($claims['entity_id'])->toBe($entity->id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['queues'])->toBe([$queue->id, 999])
+        ->and($claims['iat'])->toBeInt()
+        ->and($claims['exp'])->toBe($claims['iat'] + 3600);
+});
+
+it('encodes with alg hs256', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    $token = app(TotemJwt::class)->issue($totem, $preset, [])['token'];
+
+    $header = json_decode(base64_decode(strtr(explode('.', $token)[0], '-_', '+/')), true);
+    expect($header['alg'])->toBe('HS256')
+        ->and($header['typ'])->toBe('JWT');
+});
+
+it('refuses to decode a token signed with a different secret', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    $token = JWT::encode(
+        ['totem_id' => $totem->id, 'entity_id' => $entity->id, 'preset_id' => $preset->id, 'queues' => [], 'iat' => now()->getTimestamp(), 'exp' => now()->addHour()->getTimestamp(), 'jti' => 'j'],
+        'wrong-secret-at-least-32-characters-long!!',
+        'HS256',
+    );
+
+    expect(app(TotemJwt::class)->decode($token))->toBeNull();
+});
+
+it('refuses to decode tampered payloads', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    $token = app(TotemJwt::class)->issue($totem, $preset, [])['token'];
+    [$head, $payload, $signature] = explode('.', $token);
+
+    $claims = json_decode(base64_decode(strtr($payload, '-_', '+/')), true);
+    $claims['entity_id']++;
+    $forged = $head.'.'.base64_encode(json_encode($claims)).'.'.$signature;
+
+    expect(app(TotemJwt::class)->decode($forged))->toBeNull()
+        ->and(app(TotemJwt::class)->decode('definitely-not-a-jwt'))->toBeNull();
+});
diff --git a/tests/Feature/Totem/TotemPairingTest.php b/tests/Feature/Totem/TotemPairingTest.php
new file mode 100644
index 0000000..6b88dad
--- /dev/null
+++ b/tests/Feature/Totem/TotemPairingTest.php
@@ -0,0 +1,168 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Facades\Log;
+use Psr\Log\LoggerInterface;
+
+uses(RefreshDatabase::class);
+
+it('opens a pairing window with a fresh 6-digit code', function () {
+    Carbon::setTestNow('2026-10-28 12:00:00');
+    $preset = TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+        ->assertExitCode(0);
+
+    $preset->refresh();
+    expect(preg_match('/^\d{6}$/', (string) $preset->login_code))->toBe(1)
+        ->and($preset->login_code_expires_at->format('Y-m-d H:i:s'))->toBe('2026-10-28 12:10:00')
+        ->and($preset->login_code_consumed_at)->toBeNull();
+});
+
+it('audits the pairing window without logging the code', function () {
+    Carbon::setTestNow('2026-10-28 12:00:00');
+    $spy = Mockery::spy(LoggerInterface::class);
+    Log::partialMock()->shouldReceive('channel')->with('audit')->andReturn($spy);
+
+    $preset = TotemPreset::factory()->create();
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id]);
+    $code = $preset->fresh()->login_code;
+
+    $spy->shouldHaveReceived('info', ['Totem pairing code generated', Mockery::on(function (array $context) use ($code, $preset) {
+        return ($context['preset_id'] ?? null) === $preset->id
+            && ! isset($context['code'])
+            && ! str_contains(json_encode($context), $code);
+    })]);
+});
+
+it('fails for an unknown preset id', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999999999])
+        ->assertExitCode(1);
+});
+
+it('pairs a device and returns the token plus the entity', function () {
+    ['entity' => $entity, 'preset' => $preset] = totemFixture(['Geral']);
+    $queue = Queue::query()->sole();
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('entity.name', $entity->name);
+
+    $token = $response->json('token');
+    expect($token)->toBeString()->not->toBeEmpty();
+
+    $claims = app(TotemJwt::class)->decode($token);
+    expect($claims['entity_id'])->toBe($entity->id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['queues'])->toBe([$queue->id])
+        ->and($claims['jti'])->toBeString();
+
+    $totem = Totem::query()->sole();
+    expect($totem->entity_id)->toBe($entity->id)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull();
+
+    $preset->refresh();
+    expect($preset->login_code_consumed_at)->not->toBeNull();
+});
+
+it('rejects codes that are not exactly six digits', function (string $code) {
+    TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertJson(['code' => 'invalid_code_format']);
+})->with([
+    'too short' => '12345',
+    'too long' => '1234567',
+    'letters' => 'abc123',
+    'empty' => '',
+    'spaces' => '12 456',
+    'plus sign' => '+123456',
+]);
+
+it('rejects a body without a code', function () {
+    $this->postJson('/api/totem/auth', [])
+        ->assertStatus(400)
+        ->assertJson(['code' => 'invalid_code_format']);
+});
+
+it('marks an already consumed pairing code as unusable', function () {
+    $preset = TotemPreset::factory()->create();
+    $code = $preset->login_code;
+
+    $this->postJson('/api/totem/auth', ['code' => $code])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('rejects an expired pairing code', function () {
+    $preset = TotemPreset::factory()->create(['login_code_expires_at' => now()->subMinute()]);
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('rejects an inactive preset attempt', function () {
+    $preset = TotemPreset::factory()->create(['is_active' => false]);
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('rejects an unknown pairing code', function () {
+    TotemPreset::factory()->create(['login_code' => '111111']);
+
+    $this->postJson('/api/totem/auth', ['code' => '222222'])
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('audits pairing success and failure without logging codes', function () {
+    $spy = Mockery::spy(LoggerInterface::class);
+    Log::partialMock()->shouldReceive('channel')->with('audit')->andReturn($spy);
+
+    $preset = TotemPreset::factory()->create();
+    $code = $preset->login_code;
+
+    $this->postJson('/api/totem/auth', ['code' => $code])->assertOk();
+    $totem = Totem::query()->sole();
+
+    // Success audit carries ids, never the code.
+    $spy->shouldHaveReceived('info', ['Totem paired', Mockery::on(function (array $context) use ($code, $preset, $totem) {
+        return ($context['preset_id'] ?? null) === $preset->id
+            && ($context['totem_id'] ?? null) === $totem->id
+            && ! isset($context['code'])
+            && ! str_contains(json_encode($context), $code);
+    })]);
+
+    // Failure audit for the rejected retry.
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(401);
+
+    $spy->shouldHaveReceived('warning', ['Totem pairing failed', Mockery::on(fn (array $context) => isset($context['reason']) && ! isset($context['code']))]);
+});
+
+it('throttles pairing attempts at ten per minute', function () {
+    $preset = TotemPreset::factory()->create();
+
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertUnauthorized();
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(429)
+        ->assertJson(['code' => 'rate_limited']);
+});
