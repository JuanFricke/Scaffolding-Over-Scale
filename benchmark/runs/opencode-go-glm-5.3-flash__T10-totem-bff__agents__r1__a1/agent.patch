+
+it('rejects a token whose preset was deactivated', function () {
+    ['entity' => $entity, 'preset' => $preset] = totemFixture(['Geral']);
+    $token = totemToken($preset);
+    $preset->update(['is_active' => false]);
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/queues")
