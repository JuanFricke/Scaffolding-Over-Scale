+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned priority levels served to the totem and used to validate
+ * ticket issuance (single source for both).
+ */
+enum TotemPriority: int
+{
+    case Normal = 0;
+    case Preferential = 10;
+    case Preferential80 = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Preferential => 'Prioritário',
+            self::Preferential80 => 'Prioridade 80+',
+        };
+    }
+
+    public function color(): string
+    {
+        return match ($this) {
+            self::Normal => '#2E7D32',
+            self::Preferential => '#C62828',
+            self::Preferential80 => '#6A1B9A',
+        };
+    }
+
+    public function icon(): string
+    {
+        return match ($this) {
+            self::Normal => 'person',
+            self::Preferential => 'priority',
+            self::Preferential80 => 'elderly',
+        };
+    }
+
+    /**
+     * 1-based display position in the totem list (ascending with value).
+     */
+    public function order(): int
+    {
+        return array_search($this, self::cases(), true) + 1;
+    }
+
+    /**
+     * @return array<int, array<string, mixed>>
+     */
+    public static function visualSpecs(): array
+    {
+        return array_map(
+            fn (self $priority): array => $priority->toArray(),
+            self::cases(),
+        );
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    public function toArray(): array
+    {
+        return [
+            'value' => $this->value,
+            'label' => $this->label(),
+            'visual' => [
+                'color' => $this->color(),
+                'icon' => $this->icon(),
+                'order' => $this->order(),
+            ],
+        ];
+    }
+}
diff --git a/app/Http/Controllers/Totem/AuthController.php b/app/Http/Controllers/Totem/AuthController.php
new file mode 100644
index 0000000..2e958e2
--- /dev/null
+++ b/app/Http/Controllers/Totem/AuthController.php
@@ -0,0 +1,97 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Pairing login: POST /api/totem/auth (no Bearer yet).
+ */
+class AuthController extends Controller
+{
+    public function login(Request $request): JsonResponse
+    {
+        $code = (string) $request->input('code');
+
+        // Always validate the shape first: exactly 6 digits, incl. empty.
+        if (! preg_match('/^\d{6}$/', $code)) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $preset = TotemPreset::query()
+            ->where('login_code', $code)
+            ->whereNull('login_code_consumed_at')
+            ->where('login_code_expires_at', '>', now())
+            ->where('is_active', true)
+            ->first();
+
+        if ($preset === null) {
+            Log::channel('audit')->warning('Totem pairing failed', [
+                'reason' => 'unknown_or_unusable_code',
+            ]);
+
+            // Same response for unknown / expired / consumed / inactive preset — no oracle.
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        return DB::transaction(function () use ($preset, $code): JsonResponse {
+            // Lock the preset row so concurrent redemption is truly single-use.
+            $preset = TotemPreset::query()
+                ->whereKey($preset->getKey())
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if ($preset->login_code !== $code
+                || $preset->is_active === false
+                || $preset->login_code_consumed_at !== null
+                || $preset->login_code_expires_at === null
+                || $preset->login_code_expires_at->lte(now())
+            ) {
+                Log::channel('audit')->warning('Totem pairing failed', [
+                    'reason' => 'unknown_or_unusable_code',
+                    'preset_id' => (int) $preset->getKey(),
+                ]);
+
+                return response()->json(['code' => 'invalid_pairing_code'], 401);
+            }
+
+            $preset->login_code_consumed_at = now();
+            $preset->save();
+
+            // Every pairing registers a new device row for the preset's entity.
+            $totem = Totem::create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $token = (new TotemJwt)->issue($totem, $preset, $preset->queues()->allRelatedIds()->all());
+            $entity = $preset->entity;
+
+            // Audit: never log the code itself.
+            Log::channel('audit')->info('Totem paired', [
+                'preset_id' => (int) $preset->getKey(),
+                'totem_id' => (int) $totem->getKey(),
+                'entity_id' => (int) $entity->getKey(),
+            ]);
+
+            return response()->json([
+                'token' => $token['token'],
+                'token_type' => 'Bearer',
+                'expires_in' => $token['expires_in'],
+                'entity' => [
+                    'slug' => $entity->slug,
+                    'name' => $entity->name,
+                ],
+            ]);
+        });
+    }
+}
