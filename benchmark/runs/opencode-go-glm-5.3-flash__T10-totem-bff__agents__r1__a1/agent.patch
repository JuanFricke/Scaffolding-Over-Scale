+<?php
+
+use App\Http\Controllers\Totem\AuthController;
+use App\Http\Controllers\Totem\QueueController;
+use App\Http\Controllers\Totem\TicketController;
+use Illuminate\Support\Facades\Route;
+
+// Pairing login — the only tokenless totem call.
+Route::post('totem/auth', [AuthController::class, 'login'])
+    ->middleware('throttle:totem-auth')
+    ->name('totem.auth');
+
+// Authenticated totem surface: {entity}/{queue} are path slugs validated
+// against the JWT context, never route-bound models.
+Route::middleware('totem.auth')->group(function () {
+    Route::get('{entity}/queues', [QueueController::class, 'queues']);
+    Route::get('{entity}/{queue}/priorities', [QueueController::class, 'priorities']);
+    Route::post('{entity}/{queue}/ticket', [TicketController::class, 'store'])
+        ->middleware('throttle:totem-ticket');
+});
