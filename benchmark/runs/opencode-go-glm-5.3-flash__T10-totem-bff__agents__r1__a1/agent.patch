+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TotemPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TicketController extends Controller
+{
+    use ResolvesTotemPath;
+
+    /**
+     * POST /api/{entity}/{queue}/ticket — issue a ticket via the totem.
+     */
+    public function store(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolvedEntity = $this->resolveTotemEntity($request, $entity);
+
+        if ($resolvedEntity instanceof JsonResponse) {
+            return $resolvedEntity;
+        }
+
+        $resolvedQueue = $this->resolveTotemQueue($request, $resolvedEntity, $queue);
+
+        if ($resolvedQueue instanceof JsonResponse) {
+            return $resolvedQueue;
+        }
+
+        $priority = self::parsePriority($request->input('priority'));
+
+        // Backend-owned values only; anything else is rejected before any write.
+        if ($priority === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            // Reuses the domain action: inactive-queue rule, locking and
+            // sequential code allocation all live there.
+            $ticket = (new IssueTicket)($resolvedQueue, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $resolvedQueue->slug,
+                'label' => $resolvedQueue->name,
+            ],
+            'priority' => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+
+    /**
+     * Accept only true integers (JSON) or plain digit strings (form data).
+     */
+    private static function parsePriority(mixed $input): ?TotemPriority
+    {
+        if (is_int($input)) {
+            return TotemPriority::tryFrom($input);
+        }
+
+        if (is_string($input) && preg_match('/^\d+$/', $input) === 1) {
+            return TotemPriority::tryFrom((int) $input);
+        }
+
+        return null;
+    }
+}
