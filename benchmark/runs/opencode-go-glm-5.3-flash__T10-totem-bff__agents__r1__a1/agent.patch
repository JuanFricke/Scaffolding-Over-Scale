+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Enums\TotemPriority;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Collection;
+
+class QueueController extends Controller
+{
+    use ResolvesTotemPath;
+
+    private const QUEUE_COLOR = '#0055FF';
+
+    private const QUEUE_ICON = 'ticket';
+
+    /**
+     * GET /api/{entity}/queues — active queues inside the token's scope.
+     */
+    public function queues(Request $request, string $entity): JsonResponse
+    {
+        $resolved = $this->resolveTotemEntity($request, $entity);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        $queues = Queue::query()
+            ->whereIn('id', (array) $request->attributes->get('totem_queues', []))
+            ->where('entity_id', $resolved->getKey())
+            ->where('is_active', true)
+            ->orderByRaw('lower(name) asc')
+            ->get();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $resolved->slug,
+                'name' => $resolved->name,
+            ],
+            'queues' => $queues->values()->map(fn (Queue $queue, int $index): array => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => null,
+                'visual' => [
+                    'color' => self::QUEUE_COLOR,
+                    'icon' => self::QUEUE_ICON,
+                    'order' => $index + 1,
+                ],
+                'is_active' => $queue->is_active,
+            ])->all(),
+        ]);
+    }
+
+    /**
+     * GET /api/{entity}/{queue}/priorities — backend-owned priority levels.
+     */
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolvedEntity = $this->resolveTotemEntity($request, $entity);
+
+        if ($resolvedEntity instanceof JsonResponse) {
+            return $resolvedEntity;
+        }
+
+        $resolvedQueue = $this->resolveTotemQueue($request, $resolvedEntity, $queue);
+
+        if ($resolvedQueue instanceof JsonResponse) {
+            return $resolvedQueue;
+        }
+
+        if (! $resolvedQueue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        /** @var Collection<int, array<string, mixed>> $priorities */
+        $priorities = collect(TotemPriority::cases())->map(fn (TotemPriority $priority): array => $priority->toArray());
+
+        return response()->json([
+            'entity' => ['slug' => $resolvedEntity->slug],
+            'queue' => [
+                'slug' => $resolvedQueue->slug,
+                'label' => $resolvedQueue->name,
+            ],
+            'priorities' => $priorities->values()->all(),
+        ]);
+    }
+}
