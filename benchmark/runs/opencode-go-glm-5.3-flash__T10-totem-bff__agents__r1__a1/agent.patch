+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+class TotemPairingCode extends Command
+{
+    /**
+     * Usage: php artisan totem:pairing-code {preset} — {preset} is the
+     * totem preset id.
+     *
+     * @var string
+     */
+    protected $signature = 'totem:pairing-code {preset}';
+
+    protected $description = 'Open a totem pairing window: generate the preset\'s 6-digit pairing code (10 min TTL)';
+
+    /**
+     * Execute the console command.
+     */
+    public function handle(): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if ($preset === null) {
+            $this->error('Preset not found: no totem preset with id ['.(string) $this->argument('preset').'].');
+
+            return Command::FAILURE;
+        }
+
+        $preset->openPairingWindow();
+
+        $this->info('Pairing code for preset "'.$preset->name.'" (id '.$preset->id.'):');
+        $this->line($preset->login_code);
+        $this->comment('Valid for 10 minutes — single use. Regenerating replaces the previous code.');
+
+        // Audit trail without the code itself.
+        Log::channel('audit')->info('Totem pairing code generated', [
+            'preset_id' => (int) $preset->id,
+            'entity_id' => (int) $preset->entity_id,
+            'expires_at' => $preset->login_code_expires_at->toIso8601String(),
+        ]);
+
+        return Command::SUCCESS;
+    }
+}
