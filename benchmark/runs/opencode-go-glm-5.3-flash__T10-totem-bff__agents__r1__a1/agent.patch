--- /dev/null
+++ b/app/Http/Middleware/TotemAuth.php
@@ -0,0 +1,71 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Closure;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Totem BFF guard. Validates the Bearer JWT, the totem + preset rows and the
+ * entity identity (claims vs. rows), then exposes the resolved context as
+ * request attributes and refreshes the device heartbeat.
+ */
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $claims = app(TotemJwt::class)->decode((string) $request->bearerToken());
+
+        if ($claims === null) {
+            return $this->unauthorized();
+        }
+
+        $totem = Totem::query()->find((int) $claims['totem_id']);
+        $preset = TotemPreset::query()->find((int) $claims['preset_id']);
+
+        if ($totem === null || $preset === null
+            || ! $totem->is_active
+            || ! $preset->is_active
+            || (int) $claims['entity_id'] !== $totem->entity_id
+            || (int) $claims['entity_id'] !== $preset->entity_id
+        ) {
+            return $this->unauthorized();
+        }
+
+        $entity = $totem->entity;
+
+        if ($entity === null) {
+            return $this->unauthorized();
+        }
+
+        // Effective scope = pairing-time queue claim ∩ the preset's CURRENT
+        // queue join, so preset edits apply to already-issued tokens.
+        $queueIds = array_values(array_intersect(
+            array_map(intval(...), (array) $claims['queues']),
+            $preset->queues()->allRelatedIds()->all(),
+        ));
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_queues', $queueIds);
+
+        // Quiet heartbeat: straight query update, no model events.
+        Totem::query()->whereKey($totem->getKey())->update(['last_seen_at' => now()]);
+
+        return $next($request);
+    }
+
+    /**
+     * One indistinguishable 401 for every auth failure (no oracle).
+     */
+    private function unauthorized(): JsonResponse
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
