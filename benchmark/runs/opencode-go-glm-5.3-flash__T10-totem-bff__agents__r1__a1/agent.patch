+    $entityB = Entity::factory()->create();
+    $totem = Totem::factory()->for($entityA)->create();
+    $preset = TotemPreset::factory()->for($entityB)->create();
+
+    $token = app(TotemJwt::class)->issue($totem, $preset, [])['token'];
