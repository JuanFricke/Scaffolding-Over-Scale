+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('lists only active queues of the preset scope, ordered by name', function () {
+    ['entity' => $entity, 'preset' => $preset] = totemFixture([
+        ['name' => 'Mango'],
+        ['name' => 'alpha'],
+        ['name' => 'Bravo'],
+        ['name' => 'Hidden', 'is_active' => false],
+        ['name' => 'Not shown'],
+    ]);
+
+    // 'Hidden' is attached but inactive; 'Not shown' is not in the preset scope.
+    $outer = Queue::query()->where('name', 'Not shown')->firstOrFail();
+    $preset->queues()->detach($outer->id);
+
+    $preset = $preset->fresh();
+
+    $response = $this->withToken(totemToken($preset))->getJson("/api/{$entity->slug}/queues");
+
+    $response->assertOk()
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('entity.name', $entity->name);
+
+    $expected = $preset->queues()->get()
+        ->filter(fn ($queue) => $queue->is_active)
+        ->sortBy(fn ($queue) => strtolower($queue->name))
+        ->values();
+
+    expect($response->json('queues.*.slug'))->toBe($expected->pluck('slug')->all())
+        ->and($response->json('queues.*.label'))->toBe($expected->pluck('name')->all())
+        ->and($response->json('queues.*.visual.order'))->toBe([1, 2, 3]);
+
+    $first = $response->json('queues.0');
+    expect($first)->toHaveKey('description')
+        ->and($first['visual'])->toHaveKey('color')->toHaveKey('icon')
+        ->and($first['is_active'])->toBeTrue();
+});
+
+it('hides a queue detached from the preset after the token was issued', function () {
+    ['entity' => $entity, 'preset' => $preset, 'queues' => [$first]] = totemFixture(['Alpha']);
+    $second = Queue::factory()->for($entity)->create(['name' => 'Second']);
+    $preset->queues()->attach($second->id);
+
+    // Token issued while both queues were attached...
+    $token = totemToken($preset);
+
+    // ...then the second queue is removed from the preset.
+    $preset->queues()->detach($second->id);
+
+    expect($this->withToken($token)->getJson("/api/{$entity->slug}/queues")->json('queues.*.slug'))
+        ->toBe([$first->slug]);
+});
+
+it('hides a queue attached to the preset after the token was issued', function () {
+    ['entity' => $entity, 'preset' => $preset] = totemFixture();
+    $token = totemToken($preset);
+
+    $lazy = Queue::factory()->for($entity)->create(['name' => 'Lazy']);
+    $preset->queues()->attach($lazy->id);
+
+    expect($this->withToken($token)->getJson("/api/{$entity->slug}/queues")->json('queues'))
+        ->toBe([]);
+});
+
+it('answers 403 for a body entity that is not the token entity', function () {
+    ['entity' => $entity, 'preset' => $preset] = totemFixture(['Alpha']);
+    $foreign = Entity::factory()->create();
+
+    $this->withToken(totemToken($preset))->getJson("/api/{$foreign->slug}/queues")
+        ->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+
+    // Unknown slug — could never equal the token entity either.
+    $this->withToken(totemToken($preset))->getJson('/api/nope/queues')
+        ->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+});
