@@ -0,0 +1,53 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Shared path-parameter resolution for the three authenticated totem
+ * endpoints: entity equality with the token and queue scoping.
+ */
+trait ResolvesTotemPath
+{
+    /**
+     * {entity} must be the token's entity (unknown slug counts as mismatch).
+     */
+    protected function resolveTotemEntity(Request $request, string $entitySlug): Entity|JsonResponse
+    {
+        $tokenEntity = $request->attributes->get('totem_entity');
+
+        $entity = Entity::query()->where('slug', $entitySlug)->first();
+
+        if ($entity === null || $tokenEntity === null || $entity->isNot($tokenEntity)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return $entity;
+    }
+
+    /**
+     * {queue} is a slug resolved within the entity; it must be inside the
+     * token's effective queue scope (pairing claim ∩ preset's current join).
+     */
+    protected function resolveTotemQueue(Request $request, Entity $entity, string $queueSlug): Queue|JsonResponse
+    {
+        $queue = Queue::query()
+            ->where('entity_id', $entity->getKey())
+            ->where('slug', $queueSlug)
+            ->first();
+
+        if ($queue === null) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! in_array((int) $queue->getKey(), (array) $request->attributes->get('totem_queues', []), true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return $queue;
+    }
+}
