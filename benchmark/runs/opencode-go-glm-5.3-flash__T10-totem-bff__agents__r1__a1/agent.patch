+
+/**
+ * Create fixtures ready for a totem pairing: an entity, a preset with its
+ * queues attached, and every queue bound to that entity.
+ *
+ * @param  array<int, string|array<string, mixed>>  $queues
+ * @return array{entity: Entity, preset: TotemPreset, queues: list<Queue>}
+ */
+function totemFixture(array $queues = []): array
+{
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $created = [];
+
+    foreach ($queues as $queue) {
+        $attributes = is_string($queue) ? ['name' => $queue] : $queue;
+
+        $queued = Queue::factory()->for($entity)->create([
+            'name' => $attributes['name'] ?? fake()->words(2, true),
+            'slug' => $attributes['slug'] ?? Str::slug($attributes['name'] ?? fake()->words(2, true)),
+            'is_active' => $attributes['is_active'] ?? true,
+        ]);
+
+        // A preset can hold inactive queues (operator toggles); the API filters.
+        $preset->queues()->attach($queued->id);
+
+        $created[] = $queued;
+    }
+
+    return ['entity' => $entity, 'preset' => $preset, 'queues' => $created];
+}
+
+/**
+ * Sign a totem JWT exactly like the pairing endpoint does, after that
+ * preset's current queue join. Returns the claims-bearing token.
+ */
+function totemToken(TotemPreset $preset): string
+{
+    $totem = Totem::factory()->for($preset->entity)->create();
+
+    return app(TotemJwt::class)->issue($totem, $preset, $preset->queues()->allRelatedIds()->all())['token'];
+}
