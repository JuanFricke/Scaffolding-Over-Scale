diff --git a/app/Services/TotemJwt.php b/app/Services/TotemJwt.php
new file mode 100644
index 0000000..cad68f7
--- /dev/null
+++ b/app/Services/TotemJwt.php
@@ -0,0 +1,90 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use Illuminate\Support\Str;
+use RuntimeException;
+use Throwable;
+
+/**
+ * Totem device JWT (HS256). Claims are fixed at pairing time.
+ *
+ * Runtime re-validation (active totem/preset, live queue scope) happens in
+ * App\Http\Middleware\TotemAuth; the token only carries trusted anchors.
+ */
+final class TotemJwt
+{
+    /**
+     * Sign a device token scoped to ($totem, $preset, $queueIds).
+     *
+     * @param  list<int>  $queueIds  Allowed queue ids at pairing time
+     * @return array{token: string, expires_in: int}
+     */
+    public function issue(Totem $totem, TotemPreset $preset, array $queueIds): array
+    {
+        $ttl = $this->ttl();
+        $now = now()->getTimestamp();
+
+        $claims = [
+            'totem_id' => (int) $totem->getKey(),
+            'entity_id' => (int) $totem->entity_id,
+            'preset_id' => (int) $preset->getKey(),
+            'queues' => array_values(array_map(intval(...), $queueIds)),
+            'iat' => $now,
+            'exp' => $now + $ttl,
+            'jti' => (string) Str::uuid(),
+        ];
+
+        return [
+            'token' => JWT::encode($claims, $this->secret(), 'HS256'),
+            'expires_in' => $ttl,
+        ];
+    }
+
+    /**
+     * Decode and verify a signed token; any failure (signature, claims,
+     * expiry) returns null without leaking the reason.
+     *
+     * @return array<string, mixed>|null
+     */
+    public function decode(string $token): ?array
+    {
+        if ($token === '') {
+            return null;
+        }
+
+        try {
+            $claims = (array) JWT::decode($token, new Key($this->secret(), 'HS256'));
+        } catch (Throwable) {
+            return null;
+        }
+
+        foreach (['totem_id', 'entity_id', 'preset_id', 'queues', 'iat', 'exp', 'jti'] as $claim) {
+            if (! array_key_exists($claim, $claims)) {
+                return null;
+            }
+        }
+
+        return $claims;
+    }
+
+    private function ttl(): int
+    {
+        return (int) (config('services.totem.jwt_ttl') ?: 3600);
+    }
+
+    private function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if ($secret === '') {
+            throw new RuntimeException('TOTEM_JWT_SECRET is not configured.');
+        }
+
+        return $secret;
+    }
+}
