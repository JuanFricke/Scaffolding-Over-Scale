+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $fairnessRestrictsToNormals = $mode === CallMode::Any
+                && $this->fairnessApplies($lockedQueue->id);
+
+            // Winner ids already seen as stale inside this transaction (called
+            // concurrently via Ticket::call(), which takes no queue lock).
+            $skippedIds = [];
+
+            while (true) {
+                $candidates = Ticket::query()
+                    ->where('queue_id', $lockedQueue->id)
+                    ->where('status', TicketStatus::Waiting)
+                    ->when($skippedIds !== [], fn ($query) => $query->whereNotIn('id', $skippedIds));
+
+                match ($mode) {
+                    CallMode::PriorityOnly => $candidates->where('priority', '>', 0),
+                    CallMode::NormalOnly => $candidates->where('priority', 0),
+                    CallMode::Any => $candidates->when(
+                        $fairnessRestrictsToNormals,
+                        fn ($query) => $query->where('priority', 0),
+                    ),
+                };
+
+                $candidate = $candidates
+                    ->orderByDesc('priority')
+                    ->orderBy('issued_at')
+                    ->orderBy('id')
+                    ->first();
+
+                if ($candidate === null) {
+                    throw new NoWaitingTicketsException('No waiting tickets eligible for this call mode.');
+                }
+
+                // Lock the winner row and re-check status: the candidate read
+                // above is not protected against a concurrent Ticket::call().
+                $winner = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->firstOrFail();
+
+                if ($winner->status !== TicketStatus::Waiting) {
+                    $skippedIds[] = $winner->id;
+
+                    continue;
+                }
+
+                $winner->status = TicketStatus::Called;
+                $winner->called_at = now();
+                $winner->called_by_user_id = $calledBy->id;
+                $winner->save();
+
+                return $winner;
+            }
+        });
+    }
+
+    private function fairnessApplies(int $queueId): bool
+    {
+        $recentPriorities = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->pluck('priority');
+
+        // Query-builder pluck() bypasses Eloquent casts, so the DB driver —
+        // not the 'integer' cast on Ticket — decides the scalar type. Compare
+        // type-safely so a string "0" from another driver cannot break this.
+        if ($recentPriorities->count() < 3 || $recentPriorities->contains(fn ($priority) => (int) $priority === 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
