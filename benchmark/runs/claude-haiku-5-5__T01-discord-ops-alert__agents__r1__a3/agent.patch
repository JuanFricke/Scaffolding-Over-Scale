+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('daily archive channel rotates storage/logs/laravel.log for 14 days', function () {
+    expect(config('logging.channels.daily'))
+        ->toMatchArray(['driver' => 'daily', 'days' => 14])
+        ->and(config('logging.channels.daily.path'))->toEndWith('logs/laravel.log');
+});
+
+test('audit channel rotates storage/logs/audit.log for 90 days at info level', function () {
+    expect(config('logging.channels.audit'))
+        ->toMatchArray(['driver' => 'daily', 'days' => 90, 'level' => 'info'])
+        ->and(config('logging.channels.audit.path'))->toEndWith('logs/audit.log');
+});
+
+test('default stack channel is pinned to daily instead of single in tests', function () {
+    expect(config('logging.channels.stack.channels'))
+        ->toContain('daily')
+        ->not->toContain('single');
+});
+
+test('there is no discord log channel', function () {
+    expect(config('logging.channels'))->not->toHaveKey('discord');
+});
+
+test('audit channel accepts info writes and drops debug', function () {
+    // The daily driver writes "<name>-<Y-m-d>.<ext>", so read the dated file it creates.
+    $base = storage_path('framework/testing/audit-'.uniqid());
+    config(['logging.channels.audit.path' => $base.'.log']);
+
+    Log::channel('audit')->debug('Ignored debug entry');
+    Log::channel('audit')->info('Subscription status changed', ['subscription_id' => 7]);
+
+    $path = $base.'-'.date('Y-m-d').'.log';
+    $contents = file_get_contents($path);
+
+    expect($contents)
+        ->toContain('Subscription status changed')
+        ->toContain('"subscription_id":7')
+        ->not->toContain('Ignored debug entry');
+
+    @unlink($path);
+});
