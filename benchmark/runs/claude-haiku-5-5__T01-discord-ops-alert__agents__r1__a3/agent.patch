diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..49d04e4
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,164 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+const DISCORD_TEST_WEBHOOK = 'https://discord.com/api/webhooks/123456/super-secret-token';
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => DISCORD_TEST_WEBHOOK]);
+    Http::preventStrayRequests();
+});
+
+/**
+ * Stubs Discord to answer with the given status. Stubs are appended, so each test registers its own.
+ */
+function discordReplies(int $status = 204): void
+{
+    Http::fake(['discord.com/*' => Http::response('', $status)]);
+}
+
+/**
+ * Sends one alert and returns the `content` text that was POSTed to Discord.
+ */
+function sentContent(string $title, string $message, array $context = []): string
+{
+    discordReplies();
+
+    (new DiscordOpsAlert)->send($title, $message, $context);
+
+    $content = null;
+    Http::assertSent(function (Request $request) use (&$content) {
+        $content = $request['content'];
+
+        return true;
+    });
+
+    return $content;
+}
+
+test('does nothing when the webhook url is null', function () {
+    config(['services.discord.webhook_url' => null]);
+    discordReplies();
+
+    (new DiscordOpsAlert)->send('Job failed', 'Retries exhausted');
+
+    Http::assertNothingSent();
+});
+
+test('does nothing when the webhook url is an empty string', function () {
+    config(['services.discord.webhook_url' => '']);
+    discordReplies();
+
+    (new DiscordOpsAlert)->send('Job failed', 'Retries exhausted');
+
+    Http::assertNothingSent();
+});
+
+test('posts a json content body to exactly the configured url', function () {
+    discordReplies();
+
+    (new DiscordOpsAlert)->send('Job failed', 'Retries exhausted');
+
+    Http::assertSent(fn (Request $request) => $request->url() === DISCORD_TEST_WEBHOOK
+        && $request->method() === 'POST'
+        && $request['content'] === "Job failed\nRetries exhausted");
+});
+
+test('renders each context entry as a key=value line after the message', function () {
+    $content = sentContent('Entity blocked', 'Plan limit reached', ['entity_id' => 42, 'queue' => 'asaas-webhooks']);
+
+    expect($content)->toBe("Entity blocked\nPlan limit reached\nentity_id=42\nqueue=asaas-webhooks");
+});
+
+test('renders booleans and nulls readably', function () {
+    $content = sentContent('Flag', 'State', ['active' => true, 'retry' => false, 'owner' => null]);
+
+    expect($content)->toContain("active=true\n")
+        ->toContain("retry=false\n")
+        ->toContain('owner=null');
+});
+
+test('truncates long text to exactly 1800 multibyte characters', function () {
+    $content = sentContent('Title', str_repeat('é', 3000));
+
+    expect(mb_strlen($content))->toBe(1800)
+        ->and(mb_check_encoding($content, 'UTF-8'))->toBeTrue();
+});
+
+test('replaces values of sensitive keys with [redacted] case-insensitively', function () {
+    $content = sentContent('Auth', 'Details', [
+        'Password' => 'hunter2',
+        'access_token' => 'abc',
+        'client-secret' => 'xyz',
+        'Authorization' => 'Basic dXNlcjpwYXNz',
+        'api_key' => 'k1',
+        'api-key' => 'k2',
+        'APIKEY' => 'k3',
+        'webhook' => 'https://example.test/hook',
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    expect($content)
+        ->not->toContain('hunter2')
+        ->not->toContain('abc')
+        ->not->toContain('xyz')
+        ->not->toContain('dXNlcjpwYXNz')
+        ->not->toContain('k1')
+        ->not->toContain('k2')
+        ->not->toContain('k3')
+        ->not->toContain('example.test')
+        ->toContain('Password=[redacted]')
+        ->toContain('Authorization=[redacted]')
+        ->toContain('queue=asaas-webhooks');
+});
+
+test('redacts any string value carrying a bearer credential regardless of its key', function () {
+    $content = sentContent('Upstream', 'Rejected', ['header' => 'Bearer eyJhbGciOi.payload.sig', 'queue' => 'asaas-webhooks']);
+
+    expect($content)
+        ->not->toContain('eyJhbGciOi')
+        ->toContain('header=[redacted]')
+        ->toContain('queue=asaas-webhooks');
+});
+
+test('redacts sensitive keys and bearer strings recursively inside nested arrays as json', function () {
+    $content = sentContent('Payload', 'Nested', [
+        'event' => [
+            'token' => 'leaked',
+            'queue' => 'asaas-webhooks',
+            'meta' => ['secret' => 'leaked-too', 'note' => 'Bearer abc123'],
+        ],
+    ]);
+
+    expect($content)
+        ->not->toContain('leaked')
+        ->not->toContain('abc123')
+        ->toContain('event={"token":"[redacted]","queue":"asaas-webhooks","meta":{"secret":"[redacted]","note":"[redacted]"}}');
+});
+
+test('logs an error without the webhook url when discord answers non-2xx', function () {
+    discordReplies(429);
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('Job failed', 'Retries exhausted');
+
+    Log::shouldHaveReceived('error')
+        ->withArgs(fn (string $message, array $context) => $message === 'Discord ops alert failed'
+            && $context['status'] === 429
+            && ! str_contains(json_encode([$message, $context]), 'super-secret-token'));
+});
+
+test('catches transport exceptions and logs an error without the webhook url', function () {
+    Http::fake(fn () => throw new ConnectionException('cURL error 28: timed out for '.DISCORD_TEST_WEBHOOK));
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('Job failed', 'Retries exhausted');
+
+    Log::shouldHaveReceived('error')
+        ->withArgs(fn (string $message, array $context) => $message === 'Discord ops alert failed'
+            && ! str_contains(json_encode([$message, $context]), 'super-secret-token'));
+});
