@@ -12,9 +12,14 @@ ### Added
 - Database schema and Mermaid diagram in [`docs/database-schema.md`](docs/database-schema.md).
 - Business rules documentation in [`docs/business-rules.md`](docs/business-rules.md): MVP queue management, entity/subscription, roles (admin, owner, employee), tickets, priorities, fairness (3-ticket rule), deterministic call panel, and channels (Flutter totem, web TV, attendant).
 - This changelog (Keep a Changelog).
+- Ops logging lanes (archive, audit, alert) and decision guide in [`docs/ops/logging.md`](docs/ops/logging.md).
+- `App\Ops\DiscordOpsAlert`: explicit, soft-failing Discord webhook notifier for ops incidents (no-op when `DISCORD_WEBHOOK_URL` is empty; redacts secrets; 1800-character cap).
+- `audit` log channel (`storage/logs/audit.log`, 90-day daily retention, `info` minimum level).
 
 ### Changed
 
+- Default log stack is now `daily` (`storage/logs/laravel.log`, 14-day retention via `LOG_DAILY_DAYS`) instead of `single`; `LOG_STACK=daily` in `.env.example` and `phpunit.xml`.
+
 - Documented architecture: PegaFilaWeb is a single repository for frontend, backend and totem API; Flutter remains only as a separate client.
 - Simplified model: ticket is single-use (one call; write-once except `called_at`/`called_by`) — removed `ticket_calls` table; ticket knows only its queue (no `totem_id`). `tickets.priority` is now an integer (higher = more prioritized).
 - Expanded financial model: `billing_accounts` (1:0..1 with entity) + `subscriptions` + `plans` isolate financial data. New tables: `payment_options` (cycle, method, discount, refund window) and `payments` (individual charges). `billing_accounts` has `cpf_cnpj`. Subscription 1:1 with `billing_account_id` (UK); history in `payments`. Added `tickets.code`, explicit unique constraints, and circular FK note for owner. Removed per-queue user access limit.
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..33d9ef8
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,103 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Stringable;
+use Throwable;
+
+/**
+ * Sends one human-pageable ops incident to a Discord incoming webhook.
+ *
+ * This is an explicit call made by code that decides an incident is worth waking someone up for;
+ * it is not a Monolog channel. It soft-fails: it never throws into the caller, and failures are
+ * written to the archive log without the webhook URL (it embeds the token).
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const REDACTED = '[redacted]';
+
+    private const SENSITIVE_KEYS = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const BEARER = '/\bBearer\s+\S+/i';
+
+    /**
+     * Post "title", "message" and one `key=value` line per context entry to the configured webhook.
+     *
+     * No-op when `services.discord.webhook_url` is not set. The text is capped at 1800 characters.
+     *
+     * @param  array<string, mixed>  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhook = config('services.discord.webhook_url');
+
+        if (blank($webhook)) {
+            return;
+        }
+
+        $lines = [$this->scrubText($title), $this->scrubText($message)];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->render($this->redact((string) $key, $value));
+        }
+
+        $content = mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH, 'UTF-8');
+
+        try {
+            $response = Http::timeout(5)->asJson()->post($webhook, ['content' => $content]);
+        } catch (Throwable $e) {
+            Log::error('Discord ops alert failed', [
+                'error' => str_replace($webhook, self::REDACTED, $e->getMessage()),
+                'exception' => $e::class,
+            ]);
+
+            return;
+        }
+
+        if (! $response->successful()) {
+            Log::error('Discord ops alert failed', ['status' => $response->status()]);
+        }
+    }
+
+    private function redact(string $key, mixed $value): mixed
+    {
+        if (preg_match(self::SENSITIVE_KEYS, $key)) {
+            return self::REDACTED;
+        }
+
+        if (is_array($value)) {
+            $redacted = [];
+
+            foreach ($value as $itemKey => $item) {
+                $redacted[$itemKey] = $this->redact((string) $itemKey, $item);
+            }
+
+            return $redacted;
+        }
+
+        return is_string($value) ? $this->scrubText($value) : $value;
+    }
+
+    private function scrubText(string $text): string
+    {
+        return preg_match(self::BEARER, $text) ? self::REDACTED : $text;
+    }
+
+    private function render(mixed $value): string
+    {
+        if (is_array($value)) {
+            return json_encode($value, JSON_UNESCAPED_UNICODE | JSON_INVALID_UTF8_SUBSTITUTE) ?: '[unencodable]';
+        }
+
+        return match (true) {
+            is_bool($value) => $value ? 'true' : 'false',
+            $value === null => 'null',
+            is_scalar($value), $value instanceof Stringable => (string) $value,
+            default => get_debug_type($value),
+        };
+    }
+}
