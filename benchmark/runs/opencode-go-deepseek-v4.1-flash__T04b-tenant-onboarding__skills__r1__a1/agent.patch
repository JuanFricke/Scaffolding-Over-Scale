+
+    expect(Entity::orderBy('id')->pluck('slug')->all())
+        ->toBe(['acme-corp', 'acme-corp-2']);
+});
+
+test('onboarding retries when a slug collides at insert time', function () {
+    PegaFilaTestCollidingCreateEntity::$calls = 0;
+
+    Entity::factory()->create(['slug' => 'taken-slug']);
+
+    $this->actingAs(User::factory()->create());
