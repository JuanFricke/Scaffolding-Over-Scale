+        ->call('submit');
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($user) {
+        return $log->level === 'info'
+            && $log->message === 'Entity created'
+            && $log->context['entity_id'] === Entity::where('slug', 'acme-corp')->value('id')
+            && $log->context['actor_id'] === $user->id;
+    });
+});
+
+test('an existing soft-deleted slug is not reused', function () {
+    $deleted = Entity::factory()->create(['name' => 'Acme', 'slug' => 'acme-corp']);
+    $deleted->delete();
+
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    expect(Entity::withTrashed()->where('slug', 'acme-corp')->count())->toBe(1)
+        ->and(Entity::where('slug', 'acme-corp-2')->exists())->toBeTrue();
+});
diff --git a/tests/Feature/EntityTenantTest.php b/tests/Feature/EntityTenantTest.php
new file mode 100644
index 0000000..e8579c7
--- /dev/null
+++ b/tests/Feature/EntityTenantTest.php
@@ -0,0 +1,205 @@
+<?php
+
+use App\Http\Middleware\ResolveCurrentEntity;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('guests are redirected from every entity page', function (string $route, string $method) {
+    $entity = Entity::factory()->create();
+
+    $this->{$method}(route($route, $entity))
+        ->assertRedirect(route('login'));
+})->with([
+    ['onboarding', 'get'],
+    ['entity.switcher', 'get'],
+    ['entity.pick', 'post'],
+    ['entity.dashboard', 'get'],
+    ['home', 'get'],
+]);
+
+test('unverified users are redirected to email verification', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(route('home'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('home sends a user without memberships to onboarding', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('home sets the session and redirects a single-member user to the dashboard', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+
+    $response = $this->actingAs($membership->user)->get(route('home'));
+
+    $response->assertRedirect(route('entity.dashboard', $membership->entity));
+    $response->assertSessionHas('current_entity_id', $membership->entity_id);
+});
+
+test('home sends a multi-entity user to the switcher', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($user)->create();
+    EntityMembership::factory()->for($user)->create();
+
+    $this->actingAs($user)->get(route('home'))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('home keeps using a valid current entity session', function () {
+    $user = User::factory()->create();
+    $first = EntityMembership::factory()->owner()->for($user)->create();
+    EntityMembership::factory()->admin()->for($user)->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $first->entity_id])
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $first->entity));
+});
+
+test('the current entity middleware resolves a single membership', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    $response = $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $membership->entity));
+
+    $response->assertOk()
+        ->assertSee($membership->entity->name);
+    $response->assertSessionHas('current_entity_id', $membership->entity_id);
+});
+
+test('the current entity middleware sends zero memberships to onboarding', function () {
+    $entity = Entity::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('the current entity middleware sends multiple memberships to the switcher', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->for($user)->create();
+    EntityMembership::factory()->for($user)->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $membership->entity))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('a user that is not a member of the session entity gets forbidden', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($user)->create();
+    $foreign = EntityMembership::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $foreign->entity_id])
+        ->get(route('entity.dashboard', $foreign->entity))
+        ->assertForbidden();
+});
+
+test('the dashboard forbids an entity where the user has no membership', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->owner()->for($user)->create();
+    $foreign = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($foreign)->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $membership->entity_id])
+        ->get(route('entity.dashboard', $foreign))
+        ->assertForbidden();
+});
+
+test('picking an entity stores the session, logs audited and redirects', function () {
+    $user = User::factory()->create();
+    $first = EntityMembership::factory()->for($user)->create();
+    $second = EntityMembership::factory()->owner()->for($user)->create();
+
+    $response = $this->actingAs($user)
+        ->withSession(['current_entity_id' => $first->entity_id])
+        ->post(route('entity.pick', $second->entity));
+
+    $response->assertRedirect(route('entity.dashboard', $second->entity));
+    $response->assertSessionHas('current_entity_id', $second->entity_id);
+});
+
+test('picking a foreign entity is forbidden and leaves the session untouched', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->for($user)->create();
+    $foreign = EntityMembership::factory()->create();
+
+    $response = $this->actingAs($user)
+        ->withSession(['current_entity_id' => $membership->entity_id])
+        ->post(route('entity.pick', $foreign->entity));
+
+    $response->assertForbidden();
+    $response->assertSessionHas('current_entity_id', $membership->entity_id);
+});
+
+test('the switcher lists only the user entities and marks the current one', function () {
+    $user = User::factory()->create();
+    $current = EntityMembership::factory()->owner()->for($user)->create();
+    $other = EntityMembership::factory()->employee()->for($user)->create();
+    $foreign = EntityMembership::factory()->create();
+
+    $response = $this->actingAs($user)
+        ->withSession(['current_entity_id' => $current->entity_id])
+        ->get(route('entity.switcher'));
+
+    $response->assertOk()
+        ->assertSee(__('ui.switch_entity'))
+        ->assertSee($current->entity->name)
+        ->assertSee($other->entity->name)
+        ->assertDontSee($foreign->entity->name)
+        ->assertSee('button is-fullwidth is-link', false)
+        ->assertSee('data-current="1"', false)
+        ->assertSee('button is-fullwidth is-light', false)
+        ->assertSee(route('entity.pick', $current->entity), false)
+        ->assertSee(route('entity.pick', $other->entity), false);
+});
+
+test('the navbar shows the switcher only for users with more than one membership', function () {
+    $single = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($single->user)
+        ->withSession(['current_entity_id' => $single->entity_id])
+        ->get(route('entity.dashboard', $single->entity))
+        ->assertOk()
+        ->assertDontSee(route('entity.switcher'), false);
+
+    $multiUser = User::factory()->create();
+    EntityMembership::factory()->for($multiUser)->create();
+    EntityMembership::factory()->for($multiUser)->create();
+
+    $this->actingAs($multiUser)
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee(route('entity.switcher'), false)
+        ->assertSee(__('ui.switch_entity'));
+});
+
+test('entity screen text is translated in both locales', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($membership->user)
+        ->withSession(['current_entity_id' => $membership->entity_id])
+        ->get(route('entity.switcher'))
+        ->assertSee('Trocar de entidade');
+
+    app()->setLocale('en');
+
+    $this->actingAs($membership->user)
+        ->withSession(['current_entity_id' => $membership->entity_id])
+        ->get(route('entity.switcher'))
+        ->assertSee('Switch entity');
+});
+
+test('the current entity middleware is registered as an alias', function () {
+    expect(app('router')->getMiddleware()['current_entity'] ?? null)
+        ->toBe(ResolveCurrentEntity::class);
+});
