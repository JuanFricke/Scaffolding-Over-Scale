+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+#[Fillable(['entity_id', 'user_id', 'role'])]
+class EntityMembership extends Model
+{
+    /** @use HasFactory<EntityMembershipFactory> */
+    use HasFactory;
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'role' => UserRole::class,
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * @return BelongsTo<User, $this>
+     */
+    public function user(): BelongsTo
+    {
+        return $this->belongsTo(User::class);
+    }
+
+    /**
+     * @param  Builder<self>  $query
+     */
+    public function scopeOwner(Builder $query): void
+    {
+        $query->where('role', UserRole::Owner->value);
+    }
+
+    /**
+     * @param  Builder<self>  $query
+     */
+    public function scopeAdmin(Builder $query): void
+    {
+        $query->where('role', UserRole::Admin->value);
+    }
+
+    /**
+     * @param  Builder<self>  $query
+     */
+    public function scopeEmployee(Builder $query): void
+    {
+        $query->where('role', UserRole::Employee->value);
+    }
+}
