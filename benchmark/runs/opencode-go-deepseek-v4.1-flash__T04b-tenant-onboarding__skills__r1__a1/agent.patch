+class PegaFilaTestCollidingCreateEntity extends CreateEntity
+{
+    public static int $calls = 0;
+
+    protected function uniqueSlug(string $name): string
+    {
+        static::$calls++;
+
+        if (static::$calls === 1) {
+            return 'taken-slug';
+        }
+
+        return parent::uniqueSlug($name);
+    }
+}
+
+test('the onboarding page renders its title and heading in both locales', function () {
