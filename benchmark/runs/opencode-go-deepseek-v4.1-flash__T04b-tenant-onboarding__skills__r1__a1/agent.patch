diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..fbd7b37
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,136 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities use soft deletes and bind routes by slug', function () {
+    $entity = Entity::factory()->create(['name' => 'Acme', 'slug' => 'acme']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme')
+        ->and(Schema::hasColumn('entities', 'deleted_at'))->toBeTrue();
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('entity memberships cast the role to the user role enum', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+});
+
+test('membership scopes filter by role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('an entity exposes memberships, users and its owner', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(2)
+        ->and($entity->users()->count())->toBe(2)
+        ->and($entity->owner->id)->toBe($owner->id)
+        ->and($entity->owner->user_id)->toBe($owner->user_id)
+        ->and($entity->owner->id)->not->toBe($employee->id);
+});
+
+test('a user can resolve entities and memberships', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->owner()->for($entity)->for($user)->create();
+
+    expect($user->memberships()->count())->toBe(1)
+        ->and($user->entities()->count())->toBe(1)
+        ->and($user->membershipFor($entity->id)?->id)->toBe($membership->id)
+        ->and($user->membershipFor(999999))->toBeNull();
+});
+
+test('the manageable roles exclude the owner', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('the database rejects duplicate memberships for the same entity and user', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    expect(fn () => EntityMembership::factory()->admin()->for($entity)->for($user)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('deleting an entity cascades to its memberships', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('the entity policy enforces the role matrix', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $employee = EntityMembership::factory()->employee()->for($entity)->create()->user;
+    $outsider = User::factory()->create();
+
+    $policy = new EntityPolicy;
+
+    expect($policy->create($outsider))->toBeTrue()
+        ->and($policy->view($outsider, $entity))->toBeFalse()
+        ->and($policy->view($employee, $entity))->toBeTrue()
+        ->and($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->update($admin, $entity))->toBeTrue()
+        ->and($policy->delete($employee, $entity))->toBeFalse()
+        ->and($policy->delete($admin, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse()
+        ->and($policy->manageSettings($owner, $entity))->toBeTrue();
+});
+
+test('the membership policy protects the owner and allows self removal', function () {
+    $entity = Entity::factory()->create();
+    $ownerMembership = EntityMembership::factory()->owner()->for($entity)->create();
+    $adminMembership = EntityMembership::factory()->admin()->for($entity)->create();
+    $employeeMembership = EntityMembership::factory()->employee()->for($entity)->create();
+    $otherEmployeeMembership = EntityMembership::factory()->employee()->for($entity)->create();
+    $outsider = User::factory()->create();
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($ownerMembership->user, $employeeMembership))->toBeTrue()
+        ->and($policy->view($outsider, $employeeMembership))->toBeFalse()
+        ->and($policy->assignRole($adminMembership->user, $employeeMembership))->toBeTrue()
+        ->and($policy->assignRole($employeeMembership->user, $otherEmployeeMembership))->toBeFalse()
+        ->and($policy->delete($ownerMembership->user, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($employeeMembership->user, $employeeMembership))->toBeTrue()
+        ->and($policy->delete($employeeMembership->user, $otherEmployeeMembership))->toBeFalse()
+        ->and($policy->delete($adminMembership->user, $otherEmployeeMembership))->toBeTrue();
+});
