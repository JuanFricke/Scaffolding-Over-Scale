@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $this->membershipForEntity($user, $membership->entity_id) !== null;
+    }
+
+    /**
+     * Owners and admins may assign roles inside the entity.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->isOwnerOrAdmin($user, $membership->entity_id);
+    }
+
+    /**
+     * The owner can never be removed. A member may always remove themselves;
+     * otherwise only an owner or admin may remove the membership.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->getKey()) {
+            return true;
+        }
+
+        return $this->isOwnerOrAdmin($user, $membership->entity_id);
+    }
+
+    private function membershipForEntity(User $user, int $entityId): ?EntityMembership
+    {
+        return $user->membershipFor($entityId);
+    }
+
+    private function isOwnerOrAdmin(User $user, int $entityId): bool
+    {
+        $role = $this->membershipForEntity($user, $entityId)?->role;
+
+        return in_array($role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
