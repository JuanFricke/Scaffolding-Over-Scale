--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,95 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+use RuntimeException;
+
+#[Layout('layouts::default-page')]
+class CreateEntity extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $validated = $this->validate();
+
+        $this->authorize('create', Entity::class);
+
+        $user = Auth::user();
+        $entity = null;
+        $lastException = null;
+
+        for ($attempt = 0; $attempt < 10; $attempt++) {
+            $slug = $this->uniqueSlug($validated['name']);
+
+            try {
+                $entity = DB::transaction(function () use ($validated, $user, $slug): Entity {
+                    $entity = Entity::create([
+                        'name' => $validated['name'],
+                        'slug' => $slug,
+                    ]);
+
+                    $entity->memberships()->create([
+                        'user_id' => $user->getKey(),
+                        'role' => UserRole::Owner,
+                    ]);
+
+                    return $entity;
+                });
+
+                break;
+            } catch (UniqueConstraintViolationException $exception) {
+                // Another request inserted this slug between the check and the insert.
+                $lastException = $exception;
+            }
+        }
+
+        if (! $entity instanceof Entity) {
+            throw $lastException ?? new RuntimeException('Could not create the entity.');
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->getKey(),
+            'actor_id' => $user->getKey(),
+        ]);
+
+        session(['current_entity_id' => $entity->getKey()]);
+
+        $this->redirect(route('entity.dashboard', $entity));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')
+            ->layoutData(['title' => __('ui.create_entity_title')]);
+    }
+
+    /**
+     * Build a slug that is not used yet. Called on every insert attempt.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name) ?: 'entity';
+        $slug = $base;
+        $suffix = 1;
+
+        while (Entity::withTrashed()->where('slug', $slug)->exists()) {
+            $suffix++;
+            $slug = $base.'-'.$suffix;
+        }
+
+        return $slug;
+    }
+}
