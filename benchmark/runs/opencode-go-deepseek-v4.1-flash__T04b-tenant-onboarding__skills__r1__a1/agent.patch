--- /dev/null
+++ b/app/Http/Middleware/ResolveCurrentEntity.php
@@ -0,0 +1,65 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\User;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class ResolveCurrentEntity
+{
+    /**
+     * Resolve the entity stored in the session into this request's tenant context.
+     *
+     * @param  Closure(Request): (Response)  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        if (! $user instanceof User) {
+            return $next($request);
+        }
+
+        $entityId = $request->session()->get('current_entity_id');
+
+        if ($entityId !== null) {
+            $membership = $user->membershipFor((int) $entityId);
+            $entity = $membership?->entity;
+
+            if ($entity === null) {
+                abort(403);
+            }
+
+            return $this->continueWith($request, $next, $entity);
+        }
+
+        $memberships = $user->memberships()->with('entity')->get();
+
+        if ($memberships->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($memberships->count() > 1) {
+            return redirect()->route('entity.switcher');
+        }
+
+        $entity = $memberships->first()->entity;
+        $request->session()->put('current_entity_id', $entity->getKey());
+
+        return $this->continueWith($request, $next, $entity);
+    }
+
+    /**
+     * @param  Closure(Request): (Response)  $next
+     */
+    private function continueWith(Request $request, Closure $next, Entity $entity): Response
+    {
+        $request->attributes->set('current_entity', $entity);
+        app()->instance('current_entity', $entity);
+
+        return $next($request);
+    }
+}
