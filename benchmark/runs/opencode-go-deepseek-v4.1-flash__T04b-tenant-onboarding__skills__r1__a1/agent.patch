+        ->assertOk()
+        ->assertSee('Crie sua entidade')
+        ->assertSee('Crie sua empresa')
+        ->assertSee('wire:model="name"', false);
+
+    app()->setLocale('en');
+
+    $this->actingAs($user)
+        ->get(route('onboarding'))
+        ->assertSee('Create your entity')
+        ->assertSee('Create your company');
+});
+
+test('onboarding requires a name', function () {
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', '')
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('onboarding creates the entity and makes the creator its owner', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user);
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect();
+
+    $entity = Entity::where('slug', 'acme-corp')->firstOrFail();
+    $membership = $user->membershipFor($entity->id);
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($membership)->not->toBeNull()
+        ->and($membership->role)->toBe(UserRole::Owner)
+        ->and($entity->owner->user_id)->toBe($user->id)
+        ->and($entity->memberships()->count())->toBe(1);
+});
+
+test('onboarding stores the new entity in the session and redirects to its dashboard', function () {
+    $this->actingAs(User::factory()->create());
+
+    $component = Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    $entity = Entity::where('slug', 'acme-corp')->firstOrFail();
+
+    $component->assertRedirect(route('entity.dashboard', $entity));
+    $component->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('onboarding derives a unique slug from the name', function () {
+    $first = User::factory()->create();
+    $second = User::factory()->create();
+
+    $this->actingAs($first);
