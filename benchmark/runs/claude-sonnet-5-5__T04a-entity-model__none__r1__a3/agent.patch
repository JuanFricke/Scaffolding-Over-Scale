+
+it('applies membership policy rules', function () {
+    $entity = Entity::factory()->create();
+    $owner = memberOf($entity, 'owner');
+    $admin = memberOf($entity, 'admin');
+    $employee = memberOf($entity, 'employee');
+    $outsider = User::factory()->create();
+    $other = Entity::factory()->create();
+    $otherAdmin = memberOf($other, 'admin');
+    $policy = new EntityMembershipPolicy;
+
+    $ownerM = $owner->membershipFor($entity->id);
+    $adminM = $admin->membershipFor($entity->id);
+    $employeeM = $employee->membershipFor($entity->id);
+
+    foreach ([$owner, $admin, $employee] as $member) {
+        expect($policy->view($member, $employeeM))->toBeTrue();
+    }
+    expect($policy->view($outsider, $employeeM))->toBeFalse()
+        ->and($policy->view($otherAdmin, $employeeM))->toBeFalse()
+        ->and($policy->assignRole($owner, $employeeM))->toBeTrue()
+        ->and($policy->assignRole($admin, $employeeM))->toBeTrue()
+        ->and($policy->assignRole($employee, $employeeM))->toBeFalse()
+        ->and($policy->assignRole($otherAdmin, $employeeM))->toBeFalse()
+        ->and($policy->delete($owner, $ownerM))->toBeFalse()
+        ->and($policy->delete($admin, $ownerM))->toBeFalse()
+        ->and($policy->delete($owner, $adminM))->toBeTrue()
+        ->and($policy->delete($admin, $employeeM))->toBeTrue()
+        ->and($policy->delete($admin, $adminM))->toBeTrue()
+        ->and($policy->delete($employee, $employeeM))->toBeTrue()
+        ->and($policy->delete($employee, $adminM))->toBeFalse()
+        ->and($policy->delete($otherAdmin, $employeeM))->toBeFalse()
+        ->and($policy->delete($outsider, $employeeM))->toBeFalse();
+});
+
+it('discovers the policies through the gate', function () {
+    expect(Gate::getPolicyFor(Entity::class))->toBeInstanceOf(EntityPolicy::class)
+        ->and(Gate::getPolicyFor(EntityMembership::class))->toBeInstanceOf(EntityMembershipPolicy::class);
