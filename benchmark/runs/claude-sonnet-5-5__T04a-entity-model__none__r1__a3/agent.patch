diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..afd5777
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,180 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Entity $entity, string $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->{$role}()->create(['entity_id' => $entity->id, 'user_id' => $user->id]);
+
+    return $user;
+}
+
+it('binds entities by slug and soft deletes them', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->name)->not->toBeEmpty();
+
+    $entity->delete();
+    expect(Entity::withTrashed()->find($entity->id)->trashed())->toBeTrue();
+});
+
+it('creates distinct slugs and defaults to the employee role', function () {
+    $a = Entity::factory()->create();
+    $b = Entity::factory()->create();
+    $membership = EntityMembership::factory()->create();
+
+    expect($a->slug)->not->toBe($b->slug)
+        ->and($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+
+    $raw = EntityMembership::query()->insertGetId([
+        'entity_id' => $a->id, 'user_id' => User::factory()->create()->id,
+    ]);
+    expect(EntityMembership::find($raw)->role)->toBe(UserRole::Employee);
+});
+
+it('exposes manageable roles', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+it('resolves owner, users and memberships relations', function () {
+    $entity = Entity::factory()->create();
+    expect($entity->owner()->first())->toBeNull();
+
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue()
+        ->and($entity->memberships)->toHaveCount(3)
+        ->and($entity->users)->toHaveCount(3)
+        ->and(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(1)
+        ->and($owner->user->entities)->toHaveCount(1)
+        ->and($owner->user->memberships)->toHaveCount(1)
+        ->and($owner->user->membershipFor($entity->id)->is($owner))->toBeTrue()
+        ->and($owner->user->membershipFor($entity->id + 100))->toBeNull();
+});
+
+it('names the indexes as specified', function () {
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique');
+
+    $names = collect(Schema::getIndexes('entity_memberships'))->pluck('name');
+    expect($names)->toContain('entity_memberships_entity_user_unique', 'entity_memberships_one_owner');
+});
+
+it('rejects a second owner per entity at database level', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]))
+        ->toThrow(QueryException::class);
+
+    // promoting an existing member to a second owner is rejected too
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    expect(fn () => $admin->update(['role' => UserRole::Owner]))->toThrow(QueryException::class);
+});
+
+it('allows one owner per entity and any number of non-owners', function () {
+    $a = Entity::factory()->create();
+    $b = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $a->id]);
+    EntityMembership::factory()->owner()->create(['entity_id' => $b->id]);
+    EntityMembership::factory()->count(3)->admin()->create(['entity_id' => $a->id]);
+    EntityMembership::factory()->count(3)->employee()->create(['entity_id' => $a->id]);
+
+    expect(EntityMembership::where('entity_id', $a->id)->count())->toBe(7);
+});
+
+it('rejects the same user twice in an entity and cascades deletes', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(QueryException::class);
+
+    $membership->user->delete();
+    expect(EntityMembership::count())->toBe(0);
+});
+
+it('applies entity policy rules', function () {
+    $entity = Entity::factory()->create();
+    $owner = memberOf($entity, 'owner');
+    $admin = memberOf($entity, 'admin');
+    $employee = memberOf($entity, 'employee');
+    $outsider = User::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->create($outsider))->toBeTrue()
