diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..de7d0c4
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,194 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    public function send(string $title, string $message, array $context = []): void
+    {
+        try {
+            $webhookUrl = config('services.discord.webhook_url');
+
+            if (! is_string($webhookUrl) || trim($webhookUrl) === '') {
+                return;
+            }
+
+            $lines = [$title, $message];
+
+            foreach ($context as $key => $value) {
+                $lines[] = $key.'='.$this->renderValue((string) $key, $value);
+            }
+
+            $text = implode("\n", $lines);
+
+            if (mb_strlen($text, 'UTF-8') > self::MAX_LENGTH) {
+                $text = mb_substr($text, 0, self::MAX_LENGTH, 'UTF-8');
+            }
+
+            try {
+                $response = Http::timeout(5)->post($webhookUrl, [
+                    'content' => $text,
+                ]);
+            } catch (Throwable $e) {
+                Log::error('Discord ops alert failed', [
+                    'exception' => $this->scrub($e->getMessage(), $webhookUrl),
+                ]);
+
+                return;
+            }
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (Throwable $e) {
+            try {
+                Log::error('Discord ops alert failed', [
+                    'exception' => $this->scrub($e->getMessage(), null),
+                ]);
+            } catch (Throwable) {
+                // Never break the caller.
+            }
+        }
+    }
+
+    private function renderValue(string $key, mixed $value): string
+    {
+        if (self::isSensitiveKey($key)) {
+            return '[redacted]';
+        }
+
+        if (is_string($value) && self::containsBearer($value)) {
+            return '[redacted]';
+        }
+
+        if (is_array($value)) {
+            $encoded = json_encode($this->redactArray($value), JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+
+            return $encoded === false ? '[redacted]' : $encoded;
+        }
+
+        if (is_bool($value)) {
+            return $value ? 'true' : 'false';
+        }
+
+        if (is_null($value)) {
+            return 'null';
+        }
+
+        if (is_scalar($value)) {
+            return (string) $value;
+        }
+
+        $encoded = json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+
+        return $encoded === false ? '[redacted]' : $encoded;
+    }
+
+    /**
+     * @param  array<array-key, mixed>  $data
+     * @return array<array-key, mixed>
+     */
+    private function redactArray(array $data): array
+    {
+        $redacted = [];
+
+        foreach ($data as $key => $value) {
+            $stringKey = (string) $key;
+
+            if (self::isSensitiveKey($stringKey)) {
+                $redacted[$key] = '[redacted]';
+
+                continue;
+            }
+
+            if (is_string($value) && self::containsBearer($value)) {
+                $redacted[$key] = '[redacted]';
+
+                continue;
+            }
+
+            if (is_array($value)) {
+                $redacted[$key] = $this->redactArray($value);
+
+                continue;
+            }
+
+            $redacted[$key] = $value;
+        }
+
+        return $redacted;
+    }
+
+    private static function isSensitiveKey(string $key): bool
+    {
+        $lower = strtolower($key);
+
+        if (
+            str_contains($lower, 'password')
+            || str_contains($lower, 'token')
+            || str_contains($lower, 'secret')
+            || str_contains($lower, 'authorization')
+            || str_contains($lower, 'webhook')
+        ) {
+            return true;
+        }
+
+        $normalized = str_replace(['-', '_', ' '], '', $lower);
+
+        return str_contains($normalized, 'apikey');
+    }
+
+    private static function containsBearer(string $value): bool
+    {
+        return preg_match('/Bearer\s+\S+/i', $value) === 1;
+    }
+
+    private function scrub(string $message, ?string $webhookUrl): string
+    {
+        try {
+            $configured = $webhookUrl;
+
+            if ($configured === null) {
+                $configured = config('services.discord.webhook_url');
+            }
+
+            if (is_string($configured) && $configured !== '') {
+                $message = str_replace($configured, '[redacted]', $message);
+
+                $withoutScheme = preg_replace('#^https?://#i', '', $configured);
+
+                if (is_string($withoutScheme) && $withoutScheme !== '' && $withoutScheme !== $configured) {
+                    $message = str_replace($withoutScheme, '[redacted]', $message);
+                }
+
+                $path = parse_url($configured, PHP_URL_PATH);
+
+                if (is_string($path) && $path !== '' && $path !== '/') {
+                    $message = str_replace($path, '[redacted]', $message);
+
+                    $basename = basename($path);
+
+                    if ($basename !== '' && $basename !== '/') {
+                        $message = str_replace($basename, '[redacted]', $message);
+                    }
+                }
+            }
+        } catch (Throwable) {
+            // Fall through with the original message.
+        }
+
+        // Belt and braces: the webhook URL embeds its token, so never let
+        // anything that looks like a URL reach the logs from this path.
+        $scrubbed = preg_replace('#https?://\S+#i', '[redacted]', $message);
+
+        return is_string($scrubbed) ? $scrubbed : $message;
+    }
+}
