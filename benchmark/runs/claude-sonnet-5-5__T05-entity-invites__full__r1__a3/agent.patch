+        'email' => $invite->email,
+    ]))->toThrow(QueryException::class);
+});
+
+test('the factory defaults to an employee invite expiring in 7 days and has an expired state', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->entity)->toBeInstanceOf(Entity::class)
+        ->and($invite->role)->toBe(UserRole::Employee)
+        ->and($invite->expires_at->isFuture())->toBeTrue()
+        ->and((int) round(now()->diffInDays($invite->expires_at, true)))->toBe(7)
+        ->and($invite->isPending())->toBeTrue()
+        ->and(EntityInvite::factory()->make()->email)->not->toBe($invite->email);
+
+    $expired = EntityInvite::factory()->expired()->create();
+
+    expect($expired->isExpired())->toBeTrue()
+        ->and($expired->isPending())->toBeFalse()
+        ->and(EntityInvite::pending()->pluck('id')->all())->toBe([$invite->id]);
+});
+
+test('accepted invites are not pending', function () {
+    $invite = EntityInvite::factory()->create(['accepted_at' => now()]);
+
+    expect($invite->isPending())->toBeFalse()
+        ->and(EntityInvite::pending()->count())->toBe(0);
+});
+
+test('e-mails are stored lowercase and trimmed on every write path', function () {
+    $entity = Entity::factory()->create();
+
+    $created = EntityInvite::factory()->for($entity)->create(['email' => '  Ana@Example.COM ']);
+    expect($created->email)->toBe('ana@example.com');
+
+    $created->update(['email' => ' BOB@Example.com']);
+    expect($created->fresh()->email)->toBe('bob@example.com');
+
+    $created->email = 'CARL@EXAMPLE.COM ';
+    $created->save();
+    expect(DB::table('entity_invites')->value('email'))->toBe('carl@example.com');
+});
+
+test('entities expose their invites and cascade on delete', function () {
