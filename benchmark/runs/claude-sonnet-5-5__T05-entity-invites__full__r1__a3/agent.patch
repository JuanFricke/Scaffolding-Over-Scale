@@ -0,0 +1,103 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Livewire\Component;
+
+/**
+ * The signed-in user's pending entity invites, with Accept / Decline.
+ */
+class PendingInvites extends Component
+{
+    public function accept($inviteId): void
+    {
+        $invite = $this->inviteFor($inviteId);
+
+        // Idempotent: a second accept (double click, stale page) changes nothing.
+        if ($invite->isAccepted()) {
+            return;
+        }
+
+        if ($invite->isExpired()) {
+            $this->addError('invite', __('ui.invite_expired'));
+
+            return;
+        }
+
+        $user = auth()->user();
+
+        DB::transaction(function () use ($invite, $user) {
+            // The invite role is never owner (not invitable); never mint a second owner.
+            $role = $invite->role === UserRole::Owner ? UserRole::Employee : $invite->role;
+
+            try {
+                EntityMembership::firstOrCreate(
+                    ['entity_id' => $invite->entity_id, 'user_id' => $user->id],
+                    ['role' => $role->value],
+                );
+            } catch (UniqueConstraintViolationException) {
+                // A concurrent accept created it first: the membership exists, which is the goal.
+            }
+
+            $invite->update(['accepted_at' => now()]);
+        });
+
+        Log::channel('audit')->info('Invite accepted', [
+            'entity_id' => $invite->entity_id,
+            'invite_id' => $invite->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session(['current_entity_id' => $invite->entity_id]);
+
+        $this->redirect(route('entity.dashboard', $invite->entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $invite = $this->inviteFor($inviteId);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'invite_id' => $invite->id,
+            'actor_id' => auth()->id(),
+        ]);
+    }
+
+    public function render(): View
+    {
+        $invites = EntityInvite::query()
+            ->pending()
+            ->forEmail(auth()->user()->email)
+            ->whereHas('entity')
+            ->with('entity')
+            ->latest('id')
+            ->get();
+
+        return view('livewire.entity.pending-invites', ['invites' => $invites]);
+    }
+
+    /**
+     * Resolve an invite of a live entity and make sure it is addressed to the signed-in user.
+     */
+    protected function inviteFor($inviteId): EntityInvite
+    {
+        $invite = EntityInvite::whereHas('entity')->with('entity')->findOrFail($inviteId);
+
+        abort_unless(
+            auth()->check() && $invite->email === mb_strtolower(trim(auth()->user()->email)),
+            403,
+        );
+
+        return $invite;
+    }
+}
