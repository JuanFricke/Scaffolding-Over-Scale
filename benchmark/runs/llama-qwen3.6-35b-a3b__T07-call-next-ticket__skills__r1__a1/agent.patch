diff --git a/tests/Feature/CallNextTicketTest.php b/tests/Feature/CallNextTicketTest.php
new file mode 100644
index 0000000..b751803
--- /dev/null
+++ b/tests/Feature/CallNextTicketTest.php
@@ -0,0 +1,315 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->queue = Queue::factory()->for($this->entity)->create(['is_active' => true]);
+    $this->user = User::factory()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->user)->owner()->create();
+});
+
+/*
+|--------------------------------------------------------------------------
+| Basic behaviour
+|--------------------------------------------------------------------------
+*/
+
+it('calls the highest-priority waiting ticket in any mode', function () {
+    (new IssueTicket)($this->queue, priority: 10);
+    (new IssueTicket)($this->queue, priority: 5);
+    (new IssueTicket)($this->queue);
+
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_by_user_id)->toBe($this->user->id)
+        ->and($ticket->called_at)->not->toBeNull();
+});
+
+it('rejects calling from an inactive queue', function () {
+    $this->queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->user))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('throws when no tickets match the requested mode', function () {
+    (new IssueTicket)($this->queue, priority: 5);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->user, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('throws when the queue has no waiting tickets', function () {
+    expect(fn () => (new CallNextTicket)($this->queue, $this->user))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+/*
+|--------------------------------------------------------------------------
+| Ordering
+|--------------------------------------------------------------------------
+*/
+
+it('orders by highest priority first', function () {
+    (new IssueTicket)($this->queue, priority: 1);
+    (new IssueTicket)($this->queue, priority: 10);
+    (new IssueTicket)($this->queue, priority: 5);
+
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    expect($ticket->priority)->toBe(10);
+});
+
+it('orders by oldest issued_at within the same priority', function () {
+    $a = (new IssueTicket)($this->queue, priority: 5);
+    $b = (new IssueTicket)($this->queue, priority: 5);
+
+    expect($a->id)->toBeLessThan($b->id);
+
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    expect($ticket->id)->toBe($a->id);
+});
+
+it('uses lowest id as final tie-breaker', function () {
+    // Same priority, same issued_at (both created in same second).
+    $a = (new IssueTicket)($this->queue, priority: 5);
+    $b = (new IssueTicket)($this->queue, priority: 5);
+
+    expect($a->id)->toBeLessThan($b->id);
+
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    expect($ticket->id)->toBe($a->id);
+});
+
+/*
+|--------------------------------------------------------------------------
+| Mode filters
+|--------------------------------------------------------------------------
+*/
+
+it('priority_only mode calls only priority tickets', function () {
+    (new IssueTicket)($this->queue); // normal
+    (new IssueTicket)($this->queue, priority: 10); // priority
+    (new IssueTicket)($this->queue, priority: 5); // priority
+
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::PriorityOnly);
+
+    expect($ticket->priority)->toBe(10);
+    expect($ticket->status)->toBe(TicketStatus::Called);
+});
+
+it('normal_only mode calls only normal tickets', function () {
+    (new IssueTicket)($this->queue); // normal
+    (new IssueTicket)($this->queue, priority: 10); // priority
+    (new IssueTicket)($this->queue); // normal
+
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::NormalOnly);
+
+    expect($ticket->priority)->toBe(0);
+    expect($ticket->status)->toBe(TicketStatus::Called);
+});
+
+it('priority_only throws when no priority tickets are waiting', function () {
+    (new IssueTicket)($this->queue);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->user, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('normal_only throws when no normal tickets are waiting', function () {
+    (new IssueTicket)($this->queue, priority: 10);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->user, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+/*
+|--------------------------------------------------------------------------
+| Fairness
+|--------------------------------------------------------------------------
+*/
+
+it('forces normal after 3 consecutive priority calls in any mode', function () {
+    // Issue 3 priority tickets and call them.
+    $p1 = (new IssueTicket)($this->queue, priority: 10);
+    $p2 = (new IssueTicket)($this->queue, priority: 10);
+    $p3 = (new IssueTicket)($this->queue, priority: 10);
+
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    // Now issue a normal ticket.
+    $n1 = (new IssueTicket)($this->queue);
+
+    // Call next in any mode — fairness should force normal.
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    expect($ticket->priority)->toBe(0);
+    expect($ticket->id)->toBe($n1->id);
+});
+
+it('normal call resets the fairness streak', function () {
+    // 3 priority calls.
+    for ($i = 0; $i < 3; $i++) {
+        (new IssueTicket)($this->queue, priority: 10);
+        (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    }
+
+    // Issue normal + priority.
+    (new IssueTicket)($this->queue); // normal
+    (new IssueTicket)($this->queue, priority: 10); // priority
+
+    // Fairness forces normal.
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    expect($ticket->priority)->toBe(0);
+
+    // Now issue only 2 more priority tickets (not enough to fill last 3).
+    (new IssueTicket)($this->queue, priority: 10);
+    (new IssueTicket)($this->queue, priority: 10);
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    // Issue another normal.
+    (new IssueTicket)($this->queue);
+
+    // Last 3 calls = [P, P, N] — fairness should NOT trigger.
+    // Highest priority waiting is 10.
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    expect($ticket->priority)->toBe(10);
+});
+
+it('does not force fairness when fewer than 3 calls exist', function () {
+    // Issue 3 priority + 1 normal, call 2 priority (only 2 calls in history).
+    (new IssueTicket)($this->queue, priority: 10);
+    (new IssueTicket)($this->queue, priority: 10);
+    (new IssueTicket)($this->queue, priority: 10);
+    (new IssueTicket)($this->queue); // normal
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    // Only 2 priority calls in history — fairness should NOT trigger.
+    // 2 priority tickets + 1 normal still waiting.
+    // Highest priority waiting is 10.
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    expect($ticket->priority)->toBe(10);
+});
+
+it('does not force fairness when a non-priority ticket is in history', function () {
+    // Build history: 2 priority calls, then 1 normal call (3 calls total, but not all priority).
+    (new IssueTicket)($this->queue, priority: 10);
+    (new IssueTicket)($this->queue, priority: 10);
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    (new IssueTicket)($this->queue); // normal
+    (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+
+    // History: 3 calls, last 3 = [normal, priority, priority] — not all priority.
+    // Issue 1 priority + 1 normal; fairness should NOT trigger.
+    (new IssueTicket)($this->queue, priority: 5); // priority
+    (new IssueTicket)($this->queue); // normal
+
+    // Fairness should NOT trigger (history has a normal call).
+    // Highest priority waiting is 5.
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    expect($ticket->priority)->toBe(5);
+});
+
+it('priority_only and normal_only count in fairness history', function () {
+    // Make 3 priority calls via priority_only.
+    for ($i = 0; $i < 3; $i++) {
+        (new IssueTicket)($this->queue, priority: 10);
+        (new CallNextTicket)($this->queue, $this->user, CallMode::PriorityOnly);
+    }
+
+    (new IssueTicket)($this->queue); // normal
+
+    // Fairness should force normal even though calls came from priority_only.
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    expect($ticket->priority)->toBe(0);
+});
+
+it('when fairness forces normal but no normal is waiting, priority is called', function () {
+    // 3 priority calls.
+    for ($i = 0; $i < 3; $i++) {
+        (new IssueTicket)($this->queue, priority: 10);
+        (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    }
+
+    // Only priority tickets waiting.
+    (new IssueTicket)($this->queue, priority: 5);
+
+    // Fairness would force normal, but none waiting — call priority.
+    $ticket = (new CallNextTicket)($this->queue, $this->user, CallMode::Any);
+    expect($ticket->priority)->toBe(5);
+});
+
+/*
+|--------------------------------------------------------------------------
+| Exactly-once / concurrency
+|--------------------------------------------------------------------------
+*/
+
+it('rejects calling a ticket already called by a concurrent request', function () {
+    $ticket = (new IssueTicket)($this->queue);
+
+    // Simulate concurrent call: mark as called outside the action.
+    DB::transaction(function () use ($ticket) {
+        $locked = Ticket::query()->whereKey($ticket->id)->lockForUpdate()->firstOrFail();
+        $locked->status = TicketStatus::Called;
+        $locked->called_at = now();
+        $locked->called_by_user_id = $this->user->id;
+        $locked->save();
+    });
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->user))
+        ->toThrow(RuntimeException::class);
+});
+
+it('uses stale queue model but re-reads state from DB', function () {
+    $stale = Queue::query()->findOrFail($this->queue->id);
+
+    $this->queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $this->user))
+        ->toThrow(InactiveQueueException::class);
+});
+
+/*
+|--------------------------------------------------------------------------
+| Write-once / returned model
+|--------------------------------------------------------------------------
+*/
+
+it('returns the updated ticket with call fields populated', function () {
+    $ticket = (new IssueTicket)($this->queue);
+
+    $called = (new CallNextTicket)($this->queue, $this->user);
+
+    expect($called->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_at->not->toBeNull()
+        ->called_by_user_id->toBe($this->user->id);
+});
