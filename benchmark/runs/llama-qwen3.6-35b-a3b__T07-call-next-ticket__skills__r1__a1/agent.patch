index 0000000..96f79c8
--- /dev/null
+++ b/app/Actions/CallNextTicket.php
@@ -0,0 +1,130 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\Facades\DB;
+use RuntimeException;
+
+class CallNextTicket
+{
+    /**
+     * Call the next ticket for a queue in the given mode.
+     *
+     * @param  \App\Models\Queue  $queue
+     * @param  \App\Models\User  $calledBy
+     * @param  \App\Enums\CallMode  $mode
+     * @return \App\Models\Ticket
+     */
+    public function __invoke(Queue $queue, \App\Models\User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Re-read queue state from DB (may be stale) and lock the row.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            // Determine whether fairness forces normal-only.
+            $forceNormal = $this->isFairnessForced($lockedQueue->id);
+
+            // Build the candidate query.
+            $candidates = Ticket::query()
+                ->where('queue_id', $lockedQueue->id)
+                ->where('status', TicketStatus::Waiting);
+
+            // Apply mode filters.
+            if ($mode === CallMode::PriorityOnly) {
+                $candidates->where('priority', '>', 0);
+            } elseif ($mode === CallMode::NormalOnly) {
+                $candidates->where('priority', 0);
+            } elseif ($forceNormal) {
+                $candidates->where('priority', 0);
+            }
+
+            // Order: highest priority first, oldest issued_at first, lowest id last.
+            $candidates->orderByDesc('priority')
+                ->orderBy('issued_at', 'asc')
+                ->orderBy('id', 'asc');
+
+            // Pick the first candidate.
+            $candidate = $candidates->first();
+
+            if (! $candidate) {
+                throw new NoWaitingTicketsException(
+                    "No waiting tickets available for mode '{$mode->value}' in queue #{$lockedQueue->id}."
+                );
+            }
+
+            // Lock the candidate row and re-check it is still waiting (concurrent call protection).
+            $winner = Ticket::query()
+                ->whereKey($candidate->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if ($winner->status !== TicketStatus::Waiting) {
+                throw new RuntimeException(
+                    'Ticket was already called by a concurrent request.'
+                );
+            }
+
+            // Mark as called.
+            $winner->status = TicketStatus::Called;
+            $winner->called_at = now();
+            $winner->called_by_user_id = $calledBy->id;
+            $winner->save();
+
+            return $winner;
+        });
+    }
+
+    /**
+     * Check whether fairness forces normal-only in "any" mode.
+     *
+     * A normal ticket may not wait behind more than 3 consecutive priority
+     * calls. Look at the last 3 tickets called in this queue (most recent
+     * first by called_at, then by id). If all 3 are priority tickets and
+     * at least one normal ticket is waiting, force normal.
+     */
+    private function isFairnessForced(int $queueId): bool
+    {
+        // Last 3 called tickets, most recent first.
+        $lastThree = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->take(3)
+            ->get();
+
+        // We need exactly 3 called tickets to trigger fairness.
+        if ($lastThree->count() < 3) {
+            return false;
+        }
+
+        // All 3 must be priority tickets.
+        $allPriority = $lastThree->every(fn (Ticket $t): bool => $t->priority > 0);
+        if (! $allPriority) {
+            return false;
+        }
+
+        // At least one normal ticket must be waiting.
+        $hasNormalWaiting = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+
+        return $hasNormalWaiting;
+    }
+}
