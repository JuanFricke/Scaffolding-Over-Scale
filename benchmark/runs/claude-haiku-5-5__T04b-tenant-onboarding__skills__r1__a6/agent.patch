+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Simulates a concurrent request taking the first slug: the first attempt
+ * collides at insert time, so submit() must come back through uniqueSlug().
+ */
+class CreateEntityWithRacedSlug extends CreateEntity
+{
+    private int $attempts = 0;
+
+    protected function uniqueSlug(string $name): string
+    {
+        return ++$this->attempts === 1 ? 'acme-corp' : parent::uniqueSlug($name);
+    }
+}
+
+/**
+ * Every attempt collides, so submit() must stop instead of looping forever.
+ */
+class CreateEntityAlwaysColliding extends CreateEntity
+{
+    protected function uniqueSlug(string $name): string
+    {
+        return 'acme-corp';
+    }
+}
+
+test('guests are redirected to login', function () {
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+});
+
+test('unverified users are redirected to the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(route('onboarding'))->assertRedirect(route('verification.notice'));
+});
+
+test('onboarding renders the English copy', function () {
+    app()->setLocale('en');
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Create your entity')
+        ->assertSee('Create your company');
+});
+
+test('onboarding renders the Portuguese copy', function () {
+    app()->setLocale('pt_BR');
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Crie sua entidade')
+        ->assertSee('Crie sua empresa');
+
+    app()->setLocale('en');
+});
+
+test('the name is required', function () {
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', '')
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('the name is limited to 255 characters', function () {
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', str_repeat('a', 256))
+        ->call('submit')
+        ->assertHasErrors(['name' => 'max']);
+});
+
+test('creating an entity makes the creator its owner and sets the session', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    $entity = Entity::sole();
+    $membership = EntityMembership::sole();
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->slug)->toBe('acme-corp')
+        ->and($membership->entity_id)->toBe($entity->id)
+        ->and($membership->user_id)->toBe($user->id)
+        ->and($membership->role)->toBe(UserRole::Owner)
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('onboarding redirects to the new entity dashboard', function () {
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertRedirect(route('entity.dashboard', Entity::sole()));
+});
+
+test('creating an entity writes an audit line', function () {
+    $user = User::factory()->create();
+
+    Event::fake([MessageLogged::class]);
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    Event::assertDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->level === 'info'
+        && $log->message === 'Entity created'
+        && $log->context === ['entity_id' => Entity::sole()->id, 'actor_id' => $user->id]);
+});
+
+test('a taken slug gets the next numeric suffix', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+    Entity::factory()->create(['slug' => 'acme-corp-2']);
+
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    expect(Entity::where('name', 'Acme Corp')->value('slug'))->toBe('acme-corp-3');
+});
+
+test('a soft-deleted entity still holds its slug', function () {
+    Entity::factory()->create(['slug' => 'acme-corp'])->delete();
+
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    expect(Entity::where('name', 'Acme Corp')->value('slug'))->toBe('acme-corp-2');
+});
+
+test('the switcher route slug is reserved', function () {
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', 'Switcher')
+        ->call('submit');
+
+    expect(Entity::sole()->slug)->toBe('switcher-2');
+});
+
+test('a slug taken between the check and the insert is retried', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntityWithRacedSlug::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect(Entity::where('name', 'Acme Corp')->value('slug'))->toBe('acme-corp-2')
+        ->and(Entity::count())->toBe(2);
+});
+
+test('submit gives up after repeated slug collisions', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntityAlwaysColliding::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+})->throws(UniqueConstraintViolationException::class);
+
+test('a failed attempt leaves no partial entity or membership behind', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    try {
+        Livewire::actingAs(User::factory()->create())
+            ->test(CreateEntityAlwaysColliding::class)
+            ->set('name', 'Acme Corp')
+            ->call('submit');
+    } catch (UniqueConstraintViolationException) {
+        // expected: the retry budget is exhausted
+    }
+
+    expect(Entity::count())->toBe(1)
+        ->and(EntityMembership::count())->toBe(0);
+});
