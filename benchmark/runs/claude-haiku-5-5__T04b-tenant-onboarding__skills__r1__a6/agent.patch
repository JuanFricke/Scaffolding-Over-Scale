+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Any authenticated user may create an entity and becomes its owner.
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    /**
+     * Any member of the entity, whatever their role, may view it.
+     */
+    public function view(User $user, Entity $entity): bool
+    {
+        return $user->membershipFor($entity->id) !== null;
+    }
+
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->isOwnerOrAdmin($user, $entity);
+    }
+
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->isOwnerOrAdmin($user, $entity);
+    }
+
+    /**
+     * Settings (billing, plan, ownership) belong to the owner alone.
+     */
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $user->membershipFor($entity->id)?->role === UserRole::Owner;
+    }
+
+    private function isOwnerOrAdmin(User $user, Entity $entity): bool
+    {
+        return in_array($user->membershipFor($entity->id)?->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
diff --git a/app/Tenancy/CurrentEntity.php b/app/Tenancy/CurrentEntity.php
new file mode 100644
