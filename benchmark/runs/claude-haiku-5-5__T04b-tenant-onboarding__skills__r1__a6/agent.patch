+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+});
+
+test('any authenticated user may create an entity', function () {
+    expect(Gate::forUser(User::factory()->create())->allows('create', Entity::class))->toBeTrue();
+});
+
+test('the entity abilities follow the role matrix', function (?UserRole $role, bool $view, bool $update, bool $delete, bool $manageSettings) {
+    $user = User::factory()->create();
+
+    if ($role) {
+        EntityMembership::factory()->create(['entity_id' => $this->entity->id, 'user_id' => $user->id, 'role' => $role]);
+    }
+
+    $gate = Gate::forUser($user);
+
+    expect($gate->allows('view', $this->entity))->toBe($view)
+        ->and($gate->allows('update', $this->entity))->toBe($update)
+        ->and($gate->allows('delete', $this->entity))->toBe($delete)
+        ->and($gate->allows('manageSettings', $this->entity))->toBe($manageSettings);
+})->with([
+    'owner' => [UserRole::Owner, true, true, true, true],
+    'admin' => [UserRole::Admin, true, true, true, false],
+    'employee' => [UserRole::Employee, true, false, false, false],
+    'stranger' => [null, false, false, false, false],
+]);
+
+test('members of another entity have no access to this one', function () {
+    $other = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $other->id, 'user_id' => $user->id]);
+
+    expect(Gate::forUser($user)->allows('view', $this->entity))->toBeFalse()
+        ->and(Gate::forUser($user)->allows('update', $this->entity))->toBeFalse();
+});
