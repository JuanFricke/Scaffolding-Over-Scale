diff --git a/tests/Feature/Entity/EntitySwitcherTest.php b/tests/Feature/Entity/EntitySwitcherTest.php
new file mode 100644
index 0000000..ede8b3e
--- /dev/null
+++ b/tests/Feature/Entity/EntitySwitcherTest.php
@@ -0,0 +1,106 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return list<DOMElement>
+ */
+function switcherButtons(string $html): array
+{
+    $dom = new DOMDocument;
+    libxml_use_internal_errors(true);
+    $dom->loadHTML($html);
+    libxml_clear_errors();
+
+    return iterator_to_array((new DOMXPath($dom))->query('//form//button'));
+}
+
+test('guests are redirected to login', function () {
+    $this->get(route('entity.switcher'))->assertRedirect(route('login'));
+});
+
+test('unverified users are redirected to the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(route('entity.switcher'))->assertRedirect(route('verification.notice'));
+});
+
+test('the switcher lists only the entities the user belongs to', function () {
+    $user = User::factory()->create();
+    $mine = EntityMembership::factory()->count(2)->create(['user_id' => $user->id])->map->entity;
+    $foreign = Entity::factory()->create(['name' => 'Empresa Alheia']);
+
+    $this->actingAs($user)
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee(__('ui.switch_entity'))
+        ->assertSee($mine[0]->name)
+        ->assertSee($mine[1]->name)
+        ->assertDontSee($foreign->name);
+});
+
+test('the current entity is highlighted and the others are plain', function () {
+    $user = User::factory()->create();
+    $current = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $other = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+
+    $response = $this->actingAs($user)
+        ->withSession(['current_entity_id' => $current->id])
+        ->get(route('entity.switcher'))
+        ->assertOk();
+
+    $buttons = switcherButtons($response->getContent());
+    $byName = fn (string $name) => collect($buttons)->first(fn (DOMElement $button) => trim($button->textContent) === $name);
+
+    expect($byName($current->name)->getAttribute('class'))->toBe('button is-fullwidth is-link')
+        ->and($byName($current->name)->getAttribute('data-current'))->toBe('1')
+        ->and($byName($other->name)->getAttribute('class'))->toBe('button is-fullwidth is-light')
+        ->and($byName($other->name)->hasAttribute('data-current'))->toBeFalse();
+});
+
+test('each entity is a POST form to entity.pick with a CSRF token', function () {
+    $user = User::factory()->create();
+    $entity = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+
+    $response = $this->actingAs($user)->get(route('entity.switcher'))->assertOk();
+
+    $dom = new DOMDocument;
+    libxml_use_internal_errors(true);
+    $dom->loadHTML($response->getContent());
+    libxml_clear_errors();
+    $xpath = new DOMXPath($dom);
+    $form = $xpath->query('//form[@action="'.route('entity.pick', $entity).'"]')->item(0);
+
+    expect($form)->not->toBeNull()
+        ->and($form->getAttribute('method'))->toBe('POST')
+        ->and($xpath->query('//form[@action="'.route('entity.pick', $entity).'"]//input[@name="_token"]')->length)->toBe(1);
+});
+
+test('the navbar links to the switcher only for users with several entities', function () {
+    $single = EntityMembership::factory()->create()->user;
+    $this->actingAs($single)
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertDontSeeHtml('href="'.route('entity.switcher').'"');
+
+    $multiple = User::factory()->create();
+    EntityMembership::factory()->count(2)->create(['user_id' => $multiple->id]);
+    $this->actingAs($multiple)
+        ->get(route('entity.switcher'))
+        ->assertSeeHtml('href="'.route('entity.switcher').'"');
+});
+
+test('the switcher renders the Portuguese title', function () {
+    app()->setLocale('pt_BR');
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.switcher'))
+        ->assertSee('Trocar de entidade');
+
+    app()->setLocale('en');
+});
diff --git a/tests/Feature/Models/EntityModelTest.php b/tests/Feature/Models/EntityModelTest.php
new file mode 100644
index 0000000..74b5514
--- /dev/null
+++ b/tests/Feature/Models/EntityModelTest.php
@@ -0,0 +1,173 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('schema names the slug and membership unique indexes', function () {
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique')
+        ->and(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_entity_user_unique', 'entity_memberships_one_owner');
+});
+
+test('entities are routed by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme-corp');
+});
+
+test('entity slugs are unique', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme-corp']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('a user has at most one membership per entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the owner guard holds for raw inserts that bypass Eloquent', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+
+    expect(fn () => DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => User::factory()->create()->id,
+        'role' => 'owner',
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]))->toThrow(UniqueConstraintViolationException::class)
+        ->and($entity->owner()->first()->is($owner))->toBeTrue();
+});
+
+test('an entity may have many non-owner memberships', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->count(3)->employee()->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->count())->toBe(4);
+});
+
+test('the role column defaults to employee', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(EntityMembership::query()->sole()->role)->toBe(UserRole::Employee);
+});
+
+test('the membership factory creates its entity and user as an employee', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->role)->toBe(UserRole::Employee);
+});
+
+test('role scopes filter memberships by role', function () {
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->admin()->create();
+    EntityMembership::factory()->count(2)->employee()->create();
+
+    expect(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(2);
+});
+
+test('the owner relation returns the owner membership', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue()
+        ->and($entity->owner->is($owner))->toBeTrue();
+});
+
+test('an entity exposes its users through memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity->users()->first()->is($membership->user))->toBeTrue();
+});
+
+test('user relations list memberships and entities and resolve one membership', function () {
+    $user = User::factory()->create();
+    $owned = EntityMembership::factory()->owner()->create(['user_id' => $user->id]);
+    $joined = EntityMembership::factory()->create(['user_id' => $user->id]);
+
+    expect($user->memberships)->toHaveCount(2)
+        ->and($user->entities)->toHaveCount(2)
+        ->and($user->membershipFor($owned->entity_id)->is($owned))->toBeTrue()
+        ->and($user->membershipFor($joined->entity_id)->is($joined))->toBeTrue()
+        ->and($user->membershipFor(999999))->toBeNull();
+});
+
+test('memberships of deleted entities are not tenant memberships', function () {
+    $membership = EntityMembership::factory()->create();
+    $user = $membership->user;
+
+    $membership->entity->delete();
+
+    expect($user->entities)->toBeEmpty()
+        ->and($user->membershipFor($membership->entity_id))->toBeNull();
+});
+
+test('deleting an entity keeps its row and memberships until it is force deleted', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $entity = $membership->entity;
+
+    $entity->delete();
+
+    expect(Entity::withTrashed()->count())->toBe(1)
+        ->and(EntityMembership::count())->toBe(1);
+
+    $entity->forceDelete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('deleting a user removes their memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and(Entity::count())->toBe(1);
+});
+
+test('user roles store the expected values', function () {
+    expect(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee');
+});
+
+test('admins and employees are the manageable roles', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
diff --git a/tests/Feature/Policies/EntityMembershipPolicyTest.php b/tests/Feature/Policies/EntityMembershipPolicyTest.php
new file mode 100644
index 0000000..0b07f03
--- /dev/null
+++ b/tests/Feature/Policies/EntityMembershipPolicyTest.php
@@ -0,0 +1,61 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+
+    $this->ownerMembership = EntityMembership::factory()->owner()->create(['entity_id' => $this->entity->id]);
+    $this->adminMembership = EntityMembership::factory()->admin()->create(['entity_id' => $this->entity->id]);
+    $this->employeeMembership = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+    $this->otherEmployeeMembership = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+
+    $this->stranger = User::factory()->create();
+});
+
+test('any member of the entity can view its memberships', function () {
+    expect(Gate::forUser($this->employeeMembership->user)->allows('view', $this->adminMembership))->toBeTrue()
+        ->and(Gate::forUser($this->stranger)->allows('view', $this->adminMembership))->toBeFalse();
+});
+
+test('owners and admins can assign roles, employees and strangers cannot', function () {
+    expect(Gate::forUser($this->ownerMembership->user)->allows('assignRole', $this->employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->adminMembership->user)->allows('assignRole', $this->employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->employeeMembership->user)->allows('assignRole', $this->otherEmployeeMembership))->toBeFalse()
+        ->and(Gate::forUser($this->stranger)->allows('assignRole', $this->employeeMembership))->toBeFalse();
+});
+
+test('the owner role can never be reassigned through a membership', function () {
+    expect(Gate::forUser($this->ownerMembership->user)->allows('assignRole', $this->ownerMembership))->toBeFalse()
+        ->and(Gate::forUser($this->adminMembership->user)->allows('assignRole', $this->ownerMembership))->toBeFalse();
+});
+
+test('an admin of another entity cannot assign roles here', function () {
+    $otherEntity = Entity::factory()->create();
+    $outsider = EntityMembership::factory()->admin()->create(['entity_id' => $otherEntity->id]);
+
+    expect(Gate::forUser($outsider->user)->allows('assignRole', $this->employeeMembership))->toBeFalse();
+});
+
+test('the owner membership is never deletable, not even by the owner', function () {
+    expect(Gate::forUser($this->ownerMembership->user)->allows('delete', $this->ownerMembership))->toBeFalse()
+        ->and(Gate::forUser($this->adminMembership->user)->allows('delete', $this->ownerMembership))->toBeFalse();
+});
+
+test('any member can remove their own membership', function () {
+    expect(Gate::forUser($this->employeeMembership->user)->allows('delete', $this->employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->adminMembership->user)->allows('delete', $this->adminMembership))->toBeTrue();
+});
+
+test('owners and admins can remove other memberships, employees cannot', function () {
+    expect(Gate::forUser($this->ownerMembership->user)->allows('delete', $this->adminMembership))->toBeTrue()
+        ->and(Gate::forUser($this->adminMembership->user)->allows('delete', $this->employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->employeeMembership->user)->allows('delete', $this->otherEmployeeMembership))->toBeFalse()
+        ->and(Gate::forUser($this->stranger)->allows('delete', $this->employeeMembership))->toBeFalse();
+});
diff --git a/tests/Feature/Policies/EntityPolicyTest.php b/tests/Feature/Policies/EntityPolicyTest.php
