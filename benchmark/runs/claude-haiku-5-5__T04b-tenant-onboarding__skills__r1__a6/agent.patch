@@ -0,0 +1,32 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+class CreateEntity
+{
+    /**
+     * Creates the entity and makes the creator its owner, in one transaction. The
+     * role is fixed here, so no caller input can make someone else the owner.
+     *
+     * @throws UniqueConstraintViolationException when the slug was taken after the caller checked it
+     */
+    public function handle(User $user, string $name, string $slug): Entity
+    {
+        Gate::forUser($user)->authorize('create', Entity::class);
+
+        return DB::transaction(function () use ($user, $name, $slug) {
+            $entity = Entity::create(['name' => $name, 'slug' => $slug]);
+
+            $entity->memberships()->create(['user_id' => $user->id, 'role' => UserRole::Owner]);
+
+            return $entity;
+        });
+    }
+}
