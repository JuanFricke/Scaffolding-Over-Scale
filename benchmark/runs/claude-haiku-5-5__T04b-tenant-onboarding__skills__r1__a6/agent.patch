--- /dev/null
+++ b/app/Tenancy/CurrentEntity.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Tenancy;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Http\RedirectResponse;
+
+/**
+ * The entity a user works in, kept in the session under SESSION_KEY.
+ *
+ * Only the HTTP layer reads the session key (this class, the current_entity
+ * middleware and the entity controllers). Everything else gets the entity from
+ * the TenantContext bound for the request.
+ */
+final class CurrentEntity
+{
+    public const SESSION_KEY = 'current_entity_id';
+
+    /**
+     * The membership the session points at, or null when the session is empty
+     * or the user no longer belongs to that entity.
+     */
+    public static function fromSession(User $user): ?EntityMembership
+    {
+        $entityId = session(self::SESSION_KEY);
+
+        return $entityId === null ? null : $user->membershipFor((int) $entityId);
+    }
+
+    public static function put(Entity $entity): void
+    {
+        session([self::SESSION_KEY => $entity->id]);
+    }
+
+    /**
+     * The membership to work in: the session's, or the user's only entity (which
+     * is then written to the session). Users with no entity or several are sent
+     * to onboarding or the switcher instead.
+     */
+    public static function resolve(User $user): EntityMembership|RedirectResponse
+    {
+        if ($membership = self::fromSession($user)) {
+            return $membership;
+        }
+
+        $memberships = $user->memberships()->whereHas('entity')->get();
+
+        if ($memberships->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($memberships->count() > 1) {
+            return redirect()->route('entity.switcher');
+        }
+
+        $membership = $memberships->sole();
+        self::put($membership->entity);
+
+        return $membership;
+    }
+}
