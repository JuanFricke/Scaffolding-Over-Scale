+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Tenancy\TenantContext;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('home sends a user without entities to onboarding', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('onboarding'));
+
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('home sets the session for a single entity and opens its dashboard', function () {
+    $membership = EntityMembership::factory()->create();
+    $entity = $membership->entity;
+
+    $this->actingAs($membership->user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    $this->assertSame($entity->id, session('current_entity_id'));
+});
+
+test('home sends a user with several entities to the switcher without picking one', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->count(2)->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('entity.switcher'));
+
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('home keeps a valid session entity', function () {
+    $user = User::factory()->create();
+    $first = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    EntityMembership::factory()->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $first->id])
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $first));
+});
+
+test('home ignores a stale session entity and dispatches by membership count', function () {
+    $user = User::factory()->create();
+    $stale = Entity::factory()->create();
+    $membership = EntityMembership::factory()->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $stale->id])
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $membership->entity));
+
+    $this->assertSame($membership->entity_id, session('current_entity_id'));
+});
+
+test('the dashboard route sends a user without entities to onboarding', function () {
+    $entity = Entity::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('the dashboard route sends a user with several entities to the switcher when the session is empty', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->count(2)->create(['user_id' => $user->id]);
+    $entity = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('the dashboard route sets the session for a single entity and continues', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $membership->entity))
+        ->assertOk();
+
+    $this->assertSame($membership->entity_id, session('current_entity_id'));
+});
+
+test('the dashboard route binds the tenant context for the request', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $membership->entity))
+        ->assertOk();
+
+    expect(app(TenantContext::class)->entity->is($membership->entity))->toBeTrue()
+        ->and(app(TenantContext::class)->membership->is($membership))->toBeTrue();
+});
+
+test('a session entity the user does not belong to aborts with 403', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->create(['user_id' => $user->id]);
+    $foreign = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $foreign->id])
+        ->get(route('entity.dashboard', $foreign))
+        ->assertForbidden();
+});
