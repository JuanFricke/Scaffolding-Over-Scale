@@ -0,0 +1,36 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Tenancy\CurrentEntity;
+use App\Tenancy\TenantContext;
+use Closure;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class EnsureCurrentEntity
+{
+    /**
+     * Binds the request's TenantContext. A session entity the user is not a
+     * member of is refused with 403; an empty session is resolved (see CurrentEntity::resolve).
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        if ($request->session()->has(CurrentEntity::SESSION_KEY) && CurrentEntity::fromSession($user) === null) {
+            abort(403);
+        }
+
+        $resolved = CurrentEntity::resolve($user);
+
+        if ($resolved instanceof RedirectResponse) {
+            return $resolved;
+        }
+
+        app()->instance(TenantContext::class, new TenantContext($resolved->entity, $resolved));
+
+        return $next($request);
+    }
+}
diff --git a/app/Livewire/Entity/CreateEntity.php b/app/Livewire/Entity/CreateEntity.php
new file mode 100644
index 0000000..7d31d3e
--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,90 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateEntity as CreateEntityAction;
+use App\Models\Entity;
+use App\Models\User;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    /** Attempts before a persistent slug collision is reported instead of retried. */
+    private const SLUG_ATTEMPTS = 5;
+
+    /** Slugs that routes own: an entity with one of these would be unreachable. */
+    private const RESERVED_SLUGS = ['switcher'];
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->authorize('create', Entity::class);
+
+        $validated = $this->validate();
+
+        $entity = $this->createEntity($validated['name'], auth()->user());
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => auth()->id(),
+        ]);
+
+        CurrentEntity::put($entity);
+
+        $this->redirectRoute('entity.dashboard', ['entity' => $entity]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->title(__('ui.create_entity_title'));
+    }
+
+    /**
+     * A slug that no entity uses, soft-deleted ones included: the unique index keeps them.
+     * Callers still have to handle a collision at insert time (see createEntity()).
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::limit(Str::slug($name), 200, '') ?: 'entity';
+        $slug = $base;
+
+        for ($suffix = 2; $this->slugIsTaken($slug); $suffix++) {
+            $slug = "{$base}-{$suffix}";
+        }
+
+        return $slug;
+    }
+
+    /**
+     * Another request can take the slug between uniqueSlug() and the insert. The
+     * transaction rolls back, and we pick a fresh slug and try again.
+     */
+    private function createEntity(string $name, User $user): Entity
+    {
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return app(CreateEntityAction::class)->handle($user, $name, $this->uniqueSlug($name));
+            } catch (UniqueConstraintViolationException $exception) {
+                if ($attempt === self::SLUG_ATTEMPTS) {
+                    throw $exception;
+                }
+            }
+        }
+    }
+
+    private function slugIsTaken(string $slug): bool
+    {
+        return in_array($slug, self::RESERVED_SLUGS, true)
+            || Entity::withTrashed()->where('slug', $slug)->exists();
+    }
+}
