+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('guests are redirected to login', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+});
+
+test('unverified users are redirected to the verification notice', function () {
+    $membership = EntityMembership::factory()->create();
+    $membership->user->forceFill(['email_verified_at' => null])->save();
+
+    $this->actingAs($membership->user->refresh())
+        ->get(route('entity.dashboard', $membership->entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('a member sees the entity name on its dashboard', function () {
+    $entity = Entity::factory()->create(['name' => 'Padaria Central']);
+    $membership = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Padaria Central');
+});
+
+test('a non-member gets 403 for an entity they do not belong to', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->create(['user_id' => $user->id]);
+    $entity = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertForbidden();
+});
+
+test('a valid session for another entity does not grant access to this dashboard', function () {
+    $user = User::factory()->create();
+    $mine = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.dashboard', $theirs))
+        ->assertForbidden();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.dashboard', $mine))
+        ->assertOk();
+});
+
+test('the entity cannot be swapped from the client', function () {
+    $membership = EntityMembership::factory()->create();
+    $other = Entity::factory()->create();
+
+    Livewire::actingAs($membership->user)
+        ->test(Dashboard::class, ['entity' => $membership->entity])
+        ->set('entity', $other);
+})->throws(CannotUpdateLockedPropertyException::class);
