+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+test('issues a waiting ticket with defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $issuedAt = now();
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull()
+        ->and($ticket->issued_at->lessThanOrEqualTo(now()))->toBeTrue()
+        ->and((int) $issuedAt->diffInSeconds($ticket->issued_at))->toBeLessThan(5);
+});
+
+test('issues a ticket with custom priority and channel', function () {
+    $ticket = (new IssueTicket)(Queue::factory()->create(), 10, TicketChannel::Printed);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Printed);
+});
+
+test('negative priority is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->create();
+
+    try {
+        (new IssueTicket)($queue, -1);
+        $this->fail('InvalidArgumentException was not thrown.');
+    } catch (InvalidArgumentException) {
+    }
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('issuing into an inactive queue is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    try {
+        (new IssueTicket)($queue);
+        $this->fail('InactiveQueueException was not thrown.');
+    } catch (InactiveQueueException) {
+    }
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('a queue deactivated after the caller loaded it is rejected', function () {
+    $queue = Queue::factory()->create(); // caller loads an active queue
+
+    DB::table('queues')->update(['is_active' => false]);
+
+    try {
+        (new IssueTicket)($queue);
+        $this->fail('InactiveQueueException was not thrown.');
+    } catch (InactiveQueueException) {
+    }
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('retries when a concurrent issuance steals the allocated code', function () {
+    $queue = Queue::factory()->create();
+    $row = ['queue_id' => $queue->id, 'priority' => 0, 'channel' => 'virtual', 'status' => 'waiting', 'issued_at' => now()];
+
+    // A code A001 already exists (committed outside any transaction).
+    DB::table('tickets')->insert([...$row, 'code' => 'A001']);
+
+    $poison = true;
+    // First attempt: pretend the counter is stale and choose A001 anyway,
+    // colliding with the existing row; the action must retry, not crash.
+    Ticket::creating(function (Ticket $ticket) use (&$poison) {
+        if ($poison) {
+            $poison = false;
+            $ticket->code = 'A001';
+        }
+    });
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->code)->toBe('A002')
+        ->and(Ticket::query()->count())->toBe(2)
+        ->and(Ticket::query()->where('code', 'A002')->exists())->toBeTrue();
+});
