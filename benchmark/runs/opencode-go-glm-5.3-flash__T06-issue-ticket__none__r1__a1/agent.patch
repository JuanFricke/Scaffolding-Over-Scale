index 0000000..f2d8600
--- /dev/null
+++ b/app/Actions/IssueTicket.php
@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    private const MAX_ATTEMPTS = 3;
+
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be greater than or equal to zero.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel): Ticket {
+                    // The queue state is read from the database inside the
+                    // transaction — never trust the possibly stale model
+                    // instance the caller loaded.
+                    $lockedQueue = Queue::query()
+                        ->whereKey($queue->getKey())
+                        ->lockForUpdate()
+                        ->first();
+
+                    if ($lockedQueue === null || ! $lockedQueue->is_active) {
+                        throw new InactiveQueueException(
+                            sprintf('Queue [%s] is inactive or no longer exists.', $queue->getKey()),
+                        );
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $lockedQueue->getKey(),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (QueryException $exception) {
+                if ($attempt >= self::MAX_ATTEMPTS || ! self::isUniqueCollision($exception)) {
+                    throw $exception;
+                }
+            }
+        }
+    }
+
+    /**
+     * Detect a (queue_id, code) uniqueness violation from a concurrent
+     * issuance so the next code can be recomputed and retried.
+     */
+    private static function isUniqueCollision(QueryException $exception): bool
+    {
+        return ($exception->errorInfo[0] ?? null) === '23000'
+            || str_contains(strtolower($exception->getMessage()), 'unique constraint failed')
+            || str_contains($exception->getMessage(), '(unique)') || str_contains($exception->getMessage(), 'Duplicate entry');
+    }
+}
