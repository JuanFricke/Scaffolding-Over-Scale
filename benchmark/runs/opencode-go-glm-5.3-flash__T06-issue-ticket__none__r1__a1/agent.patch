+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+test('queue_id is immutable after issuance', function () {
+    $original = Queue::factory()->create();
+    $target = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($original)->create();
+
+    $ticket->queue_id = $target->id;
+    $ticket->save();
+})->throws(LogicException::class);
+
+test('code is immutable after issuance', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->code = 'A002';
+    $ticket->save();
+})->throws(LogicException::class);
+
+test('priority is immutable after issuance', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->priority = 5;
+    $ticket->save();
+})->throws(LogicException::class);
+
+test('issued_at is immutable after issuance', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->issued_at = $ticket->issued_at->addMinute();
+    $ticket->save();
+})->throws(LogicException::class);
+
+test('a rejected save leaves the stored ticket unchanged', function () {
+    $ticket = Ticket::factory()->create();
+
+    try {
+        $ticket->code = 'A002';
+        $ticket->priority = 7;
+        $ticket->save();
+        $this->fail('LogicException was not thrown.');
+    } catch (LogicException) {
+    }
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->code)->toBe('A001')
+        ->and($fresh->priority)->toBe(0);
+});
+
+test('identity fields stay writable so calling works directly', function () {
+    $ticket = Ticket::factory()->create();
+    $caller = User::factory()->create();
+
+    $ticket->status = TicketStatus::Called;
+    $ticket->called_at = now();
+    $ticket->called_by_user_id = $caller->id;
+    $ticket->save();
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and(DB::table('tickets')->where('id', $ticket->id)->value('called_by_user_id'))->toBe($caller->id);
+});
