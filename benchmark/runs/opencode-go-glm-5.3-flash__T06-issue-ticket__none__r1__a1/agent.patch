+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+test('an entity member can call a waiting ticket exactly once', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    EntityMembership::factory()->create(['entity_id' => $queue->entity_id, 'user_id' => $user->id]);
+
+    $ticket->call($user);
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_by_user_id)->toBe($user->id)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and((int) $ticket->called_at->diffInSeconds(now()))->toBeLessThan(5)
+        ->and(DB::table('tickets')->where('id', $ticket->id)->value('status'))->toBe('called');
+});
+
+test('any role member (employee) may call', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    EntityMembership::factory()->create(['entity_id' => $queue->entity_id, 'user_id' => $user->id, 'role' => 'employee']);
+
+    $ticket->call($user);
+
+    expect($ticket->status)->toBe(TicketStatus::Called);
+});
+
+test('a non-member cannot call and the ticket is unchanged', function () {
+    $outsider = User::factory()->create();
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    try {
+        $ticket->call($outsider);
+        $this->fail('AuthorizationException was not thrown.');
+    } catch (AuthorizationException) {
+    }
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->status)->toBe(TicketStatus::Waiting)
+        ->and($fresh->called_at)->toBeNull()
+        ->and($fresh->called_by_user_id)->toBeNull();
+});
+
+test('calling an already-called ticket throws', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    EntityMembership::factory()->create(['entity_id' => $queue->entity_id, 'user_id' => $user->id]);
+
+    $ticket->call($user);
+
+    $ticket->call($user);
+})->throws(LogicException::class);
