+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+test('factory issues sequential codes per queue', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002');
+});
+
+test('an explicit code given to the factory is kept', function () {
+    $ticket = Ticket::factory()->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X');
+});
+
+test('codes are unique per queue, independent across queues', function () {
+    $queueA = Queue::factory()->create();
+    $queueB = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queueA)->create();
+    Ticket::factory()->forQueue($queueB)->create();
+
+    expect(DB::table('tickets')->where('code', 'A001')->count())->toBe(2);
+});
+
+test('next code grows past A999', function () {
+    $queue = Queue::factory()->create();
+    $row = ['queue_id' => $queue->id, 'priority' => 0, 'channel' => 'virtual', 'status' => 'waiting', 'issued_at' => now()];
+
+    for ($i = 999; $i >= 1; $i--) { // A1000 later than A999, proving insertion order
+        DB::table('tickets')->insert([...$row, 'code' => 'A'.str_pad((string) $i, 3, '0', STR_PAD_LEFT)]);
+    }
+    DB::table('tickets')->insert([...$row, 'code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('a deleted ticket number is never reused', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(); // A001
+    $toDelete = Ticket::factory()->forQueue($queue)->create(); // A002
+    Ticket::factory()->forQueue($queue)->create(); // A003
+    Ticket::query()->whereKey($toDelete->getKey())->delete();
+
+    expect(Ticket::factory()->forQueue($queue)->create()->code)->toBe('A004');
+});
+
+test('malformed legacy codes are skipped', function () {
+    $onlyMalformed = Queue::factory()->create();
+    DB::table('tickets')->insert([
+        'queue_id' => $onlyMalformed->id,
+        'code' => 'A-X',
+        'priority' => 0,
+        'channel' => 'virtual',
+        'status' => 'waiting',
+        'issued_at' => now(),
+    ]);
+
+    expect(Ticket::nextCode($onlyMalformed->id))->toBe('A001');
+
+    $afterMalformed = Queue::factory()->create();
+    $row = ['queue_id' => $afterMalformed->id, 'priority' => 0, 'channel' => 'virtual', 'status' => 'waiting', 'issued_at' => now()];
+    DB::table('tickets')->insert([...$row, 'code' => 'A001']);
+    DB::table('tickets')->insert([...$row, 'code' => 'A-X']);
+
+    expect(Ticket::nextCode($afterMalformed->id))->toBe('A002');
+});
+
+test('next code follows insertion order, not string order', function () {
+    $queue = Queue::factory()->create();
+    $row = ['queue_id' => $queue->id, 'priority' => 0, 'channel' => 'virtual', 'status' => 'waiting', 'issued_at' => now()];
+
+    DB::table('tickets')->insert([...$row, 'code' => 'A999']);
+    DB::table('tickets')->insert([...$row, 'code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
