+<?php
+
+namespace Database\Factories;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Factories\Factory;
+use Illuminate\Support\Carbon;
+
+/**
+ * @extends Factory<Ticket>
+ */
+class TicketFactory extends Factory
+{
+    /**
+     * Define the model's default state. The display code is allocated by
+     * the model's creating event (Ticket::nextCode) when none is given,
+     * which also happens for issuance through App\Actions\IssueTicket.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'queue_id' => Queue::factory(),
+            'priority' => 0,
+            'channel' => TicketChannel::Virtual,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => Carbon::now(),
+        ];
+    }
+
+    /**
+     * Attach the ticket to a specific queue.
+     */
+    public function forQueue(Queue $queue): static
+    {
+        return $this->for($queue);
+    }
+
+    public function called(User $caller): static
+    {
+        return $this->state(fn (array $attributes) => [
+            'status' => TicketStatus::Called,
+            'called_at' => Carbon::now(),
+            'called_by_user_id' => $caller->getKey(),
+        ]);
+    }
+}
