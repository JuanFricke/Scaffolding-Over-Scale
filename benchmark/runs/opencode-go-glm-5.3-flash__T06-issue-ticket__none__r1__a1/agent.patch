diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..e79ec8d
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,152 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields that may change after issuance (only the call itself).
+     *
+     * @var list<string>
+     */
+    private const FIELDS_MUTABLE_AFTER_ISSUE = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    private const CODE_PREFIX = 'A';
+
+    private const CODE_MIN_DIGITS = 3;
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string|class-string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        // Single allocation point for display codes: every write path
+        // (action, factory, manual create) agrees on per-queue sequences.
+        static::creating(function (self $ticket) {
+            if ($ticket->code === null) {
+                $ticket->code = static::nextCode((int) $ticket->queue_id);
+            }
+        });
+
+        // Write-once invariant: after issuance no existing field may change
+        // except the call-related ones (status, called_at, called_by_user_id).
+        static::updating(function (self $ticket) {
+            $changed = array_values(array_diff(array_keys($ticket->getDirty()), self::FIELDS_MUTABLE_AFTER_ISSUE));
+
+            if ($changed !== []) {
+                throw new LogicException(
+                    sprintf('Ticket fields [%s] are immutable after issuance.', implode(', ', $changed)),
+                );
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: the last well-formed code ("A" +
+     * digits) in insertion order, plus one — not the string-wise maximum
+     * (A999 → A1000 stays — next is A1001). Deleted numbers are never
+     * reused; malformed legacy codes are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $rows = static::query()
+            ->where('queue_id', $queueId)
+            ->select('code')
+            ->orderByDesc('id')
+            ->cursor();
+
+        foreach ($rows as $row) {
+            if (preg_match('/^'.self::CODE_PREFIX.'(\d+)$/', (string) $row->getAttribute('code'), $matches) === 1) {
+                $number = (int) $matches[1] + 1;
+
+                return self::CODE_PREFIX.str_pad((string) $number, self::CODE_MIN_DIGITS, '0', STR_PAD_LEFT);
+            }
+        }
+
+        return self::CODE_PREFIX.str_pad('1', self::CODE_MIN_DIGITS, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call this ticket exactly once. Only members of the ticket's entity
+     * may call; the entity membership is checked before anything changes.
+     */
+    public function call(User $user): void
+    {
+        $this->authorizeCaller($user);
+
+        DB::transaction(function () use ($user): void {
+            // Fresh state under a row lock, not the possibly stale instance.
+            $current = static::query()
+                ->whereKey($this->getKey())
+                ->lockForUpdate()
+                ->first();
+
+            if ($current?->status !== TicketStatus::Waiting) {
+                throw new LogicException(
+                    sprintf('Ticket [%s] can only be called once.', $this->code),
+                );
+            }
+
+            $this->forceFill([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+            ])->save();
+        });
+    }
+
+    /**
+     * @throws AuthorizationException when the user is not an entity member
+     */
+    private function authorizeCaller(User $user): void
+    {
+        $entityId = $this->queue->entity_id;
+
+        $isMember = EntityMembership::query()
+            ->where('entity_id', $entityId)
+            ->where('user_id', $user->getKey())
+            ->exists();
+
+        if (! $isMember) {
+            throw new AuthorizationException(
+                'You are not a member of the entity that owns this queue.',
+            );
+        }
+    }
+}
