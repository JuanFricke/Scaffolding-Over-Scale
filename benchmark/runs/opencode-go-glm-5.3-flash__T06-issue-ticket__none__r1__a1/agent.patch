+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues and tickets tables have required columns', function () {
+    $this->assertTrue(Schema::hasTable('queues'));
+    $this->assertTrue(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasTable('tickets'));
+    $this->assertTrue(Schema::hasColumns('tickets', [
+        'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+        'issued_at', 'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+    ]));
+});
+
+test('queues and tickets tables have the expected unique constraints and index', function () {
+    $this->assertTrue(Schema::hasIndex('queues', 'queues_entity_slug_unique'));
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_code_unique'));
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_status_priority_issued_index'));
+});
+
+test('queue slug is unique within an entity only', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->create(['entity_id' => $entity->id, 'slug' => 'counter-1']);
+
+    // Same slug, different entity: allowed.
+    Queue::factory()->create(['slug' => 'counter-1']);
+    expect(DB::table('queues')->where('slug', 'counter-1')->count())->toBe(2);
+
+    // Same slug, same entity: rejected.
+    $rejected = false;
+    try {
+        Queue::factory()->create(['entity_id' => $entity->id, 'slug' => 'counter-1']);
+    } catch (Throwable) {
+        $rejected = true;
+    }
+    expect($rejected)->toBeTrue();
+});
+
+test('queues.is_active defaults to true', function () {
+    $entity = Entity::factory()->create();
+
+    $id = DB::table('queues')->insertGetId([
+        'entity_id' => $entity->id,
+        'name' => 'Suporte',
+        'slug' => 'suporte',
+    ]);
+
+    expect((bool) DB::table('queues')->where('id', $id)->value('is_active'))->toBeTrue();
+});
+
+test('deleting an entity cascades to its queues and tickets', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    Ticket::factory()->forQueue($queue)->create();
+    $caller = User::factory()->create();
+    $called = Ticket::factory()->for($queue)->create();
+    $called->forceFill(['status' => 'called', 'called_at' => now(), 'called_by_user_id' => $caller->id])->save();
+
+    expect(Ticket::count())->toBe(2)->and(Queue::count())->toBe(1);
+
+    $entity->forceDelete();
+
+    expect(Ticket::count())->toBe(0)->and(Queue::count())->toBe(0);
+});
+
+test('deleting a queue cascades to its tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->for($queue)->create();
+
+    $queue->delete();
+
+    expect(Ticket::count())->toBe(0)->and(Queue::count())->toBe(0);
+});
