diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..eafc9ac
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,114 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+test('forgot password page renders', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee(route('password.email'), false)
+        ->assertSee('name="email"', false);
+});
+
+test('reset link is sent to existing users', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('unknown emails get the same answer and nothing is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('forgot password validates the email', function () {
+    $this->post(route('password.email'), ['email' => 'nope'])
+        ->assertSessionHasErrors('email');
+});
+
+test('forgot password is throttled to 6 per minute', function () {
+    foreach (range(1, 6) as $_) {
+        $this->post(route('password.email'), ['email' => 'ghost@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])->assertStatus(429);
+});
+
+test('reset page asks for the email once and prefills it', function () {
+    $html = $this->get(route('password.reset', ['token' => 'abc', 'email' => 'a@example.com']))
+        ->assertOk()
+        ->assertSee(route('password.update'), false)
+        ->assertSee('value="abc"', false)
+        ->assertSee('a@example.com')
+        ->getContent();
+
+    expect(substr_count($html, 'name="email"'))->toBe(1);
+});
+
+test('password can be reset and remember token rotates', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old-token']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NewSecret123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token')
+        ->and($user->remember_token)->not->toBeEmpty();
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('invalid token does not change the password', function () {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => 'bad',
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors('email');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+});
+
+test('reset enforces the default password rule and confirmation', function () {
+    $user = User::factory()->create();
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'weak',
+        'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'Other123x',
+    ])->assertSessionHasErrors('password');
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..6dda7f3
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,110 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+function registerWith(array $overrides = [])
+{
+    $data = array_merge([
+        'name' => 'Maria Souza',
+        'email' => 'maria@example.com',
+        'password' => 'Secret123',
+        'password_confirmation' => 'Secret123',
+    ], $overrides);
+
+    $component = Livewire::test(Register::class);
+    foreach ($data as $field => $value) {
+        $component->set($field, $value);
+    }
+
+    return $component->call('submit');
+}
+
+test('register page renders', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSeeHtml('wire:model="name"')
+        ->assertSeeHtml('wire:model="password_confirmation"')
+        ->assertSee(route('login'), false);
+});
+
+test('user can register, is logged in and gets a verification mail', function () {
+    Notification::fake();
+    Event::fake([Registered::class]);
+
+    registerWith()->assertHasNoErrors()->assertRedirect(route('home'));
+
+    Event::assertDispatched(Registered::class);
+    $user = User::where('email', 'maria@example.com')->firstOrFail();
+    expect($user->email_verified_at)->toBeNull()
+        ->and(Hash::check('Secret123', $user->password))->toBeTrue();
+    $this->assertAuthenticatedAs($user);
+});
+
+test('registration sends the verification notification', function () {
+    Notification::fake();
+
+    registerWith();
+
+    Notification::assertSentTo(User::firstOrFail(), VerifyEmail::class);
+});
+
+test('registration regenerates the session', function () {
+    $oldId = session()->getId();
+
+    registerWith();
+
+    expect(session()->getId())->not->toBe($oldId);
+});
+
+test('mismatched confirmation fails with confirmed', function () {
+    registerWith(['password_confirmation' => 'Different123'])
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('password follows the default rule', function (string $password) {
+    registerWith(['password' => $password, 'password_confirmation' => $password])
+        ->assertHasErrors(['password']);
+})->with(['short1A', 'alllowercase1', 'ALLUPPERCASE1', 'NoNumbersHere', '12345678']);
+
+test('email must be strict and unique', function () {
+    User::factory()->create(['email' => 'maria@example.com']);
+
+    registerWith()->assertHasErrors(['email' => 'unique']);
+    registerWith(['email' => 'nope'])->assertHasErrors(['email']);
+});
+
+test('name is required', function () {
+    registerWith(['name' => ''])->assertHasErrors(['name' => 'required']);
+});
+
+test('registration is rate limited by ip', function () {
+    $key = str()->transliterate('register|127.0.0.1');
+    foreach (range(1, 5) as $_) {
+        RateLimiter::hit($key);
+    }
+
+    registerWith()->assertHasErrors(['email']);
+
+    expect(User::count())->toBe(0);
+    $this->assertGuest();
+});
+
+test('sixth registration from the same ip is blocked', function () {
+    foreach (range(1, 5) as $i) {
+        auth()->logout();
+        registerWith(['email' => "user{$i}@example.com"])->assertHasNoErrors();
+    }
+
+    registerWith(['email' => 'user6@example.com'])->assertHasErrors(['email']);
+    expect(User::count())->toBe(5);
+});
