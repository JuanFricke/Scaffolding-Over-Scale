+<?php
+
+test('views never hardcode internal hrefs or form actions', function () {
+    $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator(resource_path('views')));
+
+    foreach ($files as $file) {
+        if (! $file->isFile() || ! str_ends_with($file->getFilename(), '.blade.php')) {
+            continue;
+        }
+
+        expect(file_get_contents($file->getPathname()))
+            ->not->toMatch('/(href|action)\s*=\s*["\']\//', $file->getPathname());
+    }
+});
+
+test('auth classes redirect with named routes only', function () {
+    $files = array_merge(
+        glob(app_path('Http/Controllers/*.php')),
+        glob(app_path('Http/Controllers/Auth/*.php')),
+        glob(app_path('Livewire/Auth/*.php')),
+    );
+
+    foreach ($files as $file) {
+        expect(file_get_contents($file))->not->toMatch('/redirect\(\s*[\'"]\//', $file);
+    }
+});
+
+test('locale files have the same ui keys', function () {
+    $en = require lang_path('en/ui.php');
+    $pt = require lang_path('pt_BR/ui.php');
+
+    expect(array_keys($pt))->toEqualCanonicalizing(array_keys($en));
+});
+
+test('env example ships the product locale', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)->toContain("APP_NAME=PegaFila\n")
+        ->toContain("APP_LOCALE=pt_BR\n")
+        ->toContain("APP_FALLBACK_LOCALE=en\n");
+});
