@@ -0,0 +1,139 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+test('login page renders in pt_BR', function () {
+    expect(config('app.locale'))->toBe('pt_BR');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?')
+        ->assertSeeHtml('wire:model="email"')
+        ->assertSee(route('password.request'), false);
+});
+
+test('login page renders in english without portuguese', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha');
+});
+
+test('guests only can see login and register', function () {
+    $this->actingAs(User::factory()->create());
+
+    $this->get(route('login'))->assertRedirect(route('home'));
+    $this->get(route('register'))->assertRedirect(route('home'));
+});
+
+test('user can log in and the session is regenerated', function () {
+    $user = User::factory()->create();
+    $oldId = session()->getId();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+    expect(session()->getId())->not->toBe($oldId);
+});
+
+test('login redirects to the intended url', function () {
+    $user = User::factory()->create();
+    session()->put('url.intended', route('verification.notice'));
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('remember me sets the recaller', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->set('remember', true)
+        ->call('submit');
+
+    expect(Auth::user()->getRememberToken())->not->toBeEmpty();
+});
+
+test('wrong credentials fail on the email field', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')])
+        ->assertNoRedirect();
+
+    $this->assertGuest();
+    expect(__('auth.failed'))->toStartWith('Essas credenciais não correspondem');
+});
+
+test('invalid email is rejected', function (string $email) {
+    Livewire::test(Login::class)
+        ->set('email', $email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email']);
+})->with(['', 'not-an-email', 'a@b', 'user@@example.com']);
+
+test('password is required', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'a@example.com')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'required']);
+});
+
+test('failed attempts are throttled per lowercase email and ip', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com']);
+
+    $component = Livewire::test(Login::class)->set('password', 'wrong-password');
+
+    foreach (range(1, 5) as $_) {
+        $component->set('email', 'STAFF@example.com')->call('submit')
+            ->assertHasErrors(['email' => __('auth.failed')]);
+    }
+
+    // Even the right password is refused while locked.
+    $component->set('email', 'staff@example.com')->set('password', 'password')->call('submit')
+        ->assertHasErrors('email');
+
+    expect(collect($component->errors()->get('email'))->first())
+        ->toContain('Muitas tentativas');
+    $this->assertGuest();
+
+    // Another e-mail is not affected.
+    RateLimiter::clear(str()->transliterate('staff@example.com|127.0.0.1'));
+    Livewire::test(Login::class)
+        ->set('email', $user->email)->set('password', 'password')->call('submit')
+        ->assertRedirect(route('home'));
+});
+
+test('successful login clears the throttle', function () {
+    $user = User::factory()->create();
+    $key = str()->transliterate(str()->lower($user->email).'|127.0.0.1');
+    RateLimiter::hit($key);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)->set('password', 'password')->call('submit');
+
+    expect(RateLimiter::attempts($key))->toBe(0);
+});
