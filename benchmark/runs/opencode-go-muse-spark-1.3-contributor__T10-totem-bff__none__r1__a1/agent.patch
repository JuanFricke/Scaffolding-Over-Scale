+++ b/app/Totem/TotemPriorities.php
@@ -0,0 +1,66 @@
+<?php
+
+namespace App\Totem;
+
+/**
+ * Backend-owned priority levels: the single source used by both the
+ * priorities endpoint and issuance validation.
+ */
+final class TotemPriorities
+{
+    /**
+     * @var list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public const LEVELS = [
+        [
+            'value' => 0,
+            'label' => 'Normal',
+            'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+        ],
+        [
+            'value' => 10,
+            'label' => 'Prioritário',
+            'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+        ],
+        [
+            'value' => 20,
+            'label' => 'Prioridade 80+',
+            'visual' => ['color' => '#6A1B9A', 'icon' => 'star', 'order' => 3],
+        ],
+    ];
+
+    /**
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function all(): array
+    {
+        return self::LEVELS;
+    }
+
+    /**
+     * @return list<int>
+     */
+    public static function values(): array
+    {
+        return array_map(static fn (array $level): int => $level['value'], self::LEVELS);
+    }
+
+    /**
+     * @return array{value: int, label: string, visual: array{color: string, icon: string, order: int}}|null
+     */
+    public static function find(int $value): ?array
+    {
+        foreach (self::LEVELS as $level) {
+            if ($level['value'] === $value) {
+                return $level;
+            }
+        }
+
+        return null;
+    }
+
+    public static function labelFor(int $value): ?string
+    {
+        return self::find($value)['label'] ?? null;
+    }
+}
