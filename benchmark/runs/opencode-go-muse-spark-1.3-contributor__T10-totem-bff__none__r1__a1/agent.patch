+<?php
+
+use App\Http\Controllers\Api\TotemAuthController;
+use App\Http\Controllers\Api\TotemQueueController;
+use Illuminate\Support\Facades\Route;
+
+Route::post('/totem/auth', [TotemAuthController::class, 'store'])->middleware('throttle:10,1,totem-auth');
+
+Route::middleware('totem.auth')->group(function () {
+    Route::get('/{entity}/queues', [TotemQueueController::class, 'index']);
+    Route::get('/{entity}/{queue}/priorities', [TotemQueueController::class, 'priorities']);
+    Route::post('/{entity}/{queue}/ticket', [TotemQueueController::class, 'store'])->middleware('throttle:30,1,totem-ticket');
+});
diff --git a/tests/Feature/TotemApiTest.php b/tests/Feature/TotemApiTest.php
new file mode 100644
index 0000000..d0240f8
--- /dev/null
+++ b/tests/Feature/TotemApiTest.php
@@ -0,0 +1,221 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function totemPairToken(TotemPreset $preset): string
+{
+    $response = test()->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertStatus(200);
+
+    return $response->json('token');
+}
+
+it('pairs a preset and serves the totem endpoints', function () {
+    $preset = TotemPreset::factory()->create();
+    Queue::factory()->for($preset->entity)->create(['name' => 'Beta', 'slug' => 'beta']);
+    $alfa = Queue::factory()->for($preset->entity)->create(['name' => 'Alfa', 'slug' => 'alfa']);
+    $preset->queues()->attach(Queue::query()->where('entity_id', $preset->entity_id)->pluck('id')->all());
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertExitCode(0);
+    $preset->refresh();
+    expect($preset->login_code)->toMatch('/^\d{6}$/');
+
+    $token = totemPairToken($preset);
+    $headers = ['Authorization' => 'Bearer '.$token];
+
+    // consumed codes cannot be reused
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertStatus(401);
+
+    // queues ordered by name, 1-based visual order
+    $queues = $this->getJson("/api/{$preset->entity->slug}/queues", $headers)->assertStatus(200);
+    expect($queues->json('entity.slug'))->toBe($preset->entity->slug)
+        ->and($queues->json('queues.0.slug'))->toBe('alfa')
+        ->and($queues->json('queues.0.visual.order'))->toBe(1)
+        ->and($queues->json('queues.1.visual.order'))->toBe(2)
+        ->and($queues->json('queues.0.is_active'))->toBeTrue();
+
+    // priorities come from the backend-owned set
+    $priorities = $this->getJson("/api/{$preset->entity->slug}/alfa/priorities", $headers)->assertStatus(200);
+    expect($priorities->json('priorities'))->toHaveCount(3);
+
+    // tickets are sequential per queue, channel totem
+    $first = $this->postJson("/api/{$preset->entity->slug}/alfa/ticket", ['priority' => 10], $headers)->assertStatus(201);
+    expect($first->json('slug'))->toBe('A001')
+        ->and($first->json('priority.value'))->toBe(10);
+    $second = $this->postJson("/api/{$preset->entity->slug}/alfa/ticket", ['priority' => 0], $headers)->assertStatus(201);
+    expect($second->json('slug'))->toBe('A002');
+    expect(Ticket::query()->first()->channel->value)->toBe('totem');
+
+    // removing a queue from the preset takes effect for existing tokens
+    $preset->queues()->detach($alfa->id);
+    $this->getJson("/api/{$preset->entity->slug}/alfa/priorities", $headers)->assertStatus(403);
+});
+
+it('rejects malformed pairing codes with 400', function () {
+    TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => 'abc'])->assertStatus(400)->assertJson(['code' => 'invalid_code_format']);
+    $this->postJson('/api/totem/auth', [])->assertStatus(400)->assertJson(['code' => 'invalid_code_format']);
+    $this->postJson('/api/totem/auth', ['code' => '12345'])->assertStatus(400)->assertJson(['code' => 'invalid_code_format']);
+});
+
+it('rejects unknown, expired, consumed and inactive pairing codes without oracle', function () {
+    $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401)->assertJson(['code' => 'invalid_pairing_code']);
+
+    $expired = TotemPreset::factory()->create(['login_code_expires_at' => now()->subMinute()]);
+    $this->postJson('/api/totem/auth', ['code' => $expired->login_code])->assertStatus(401)->assertJson(['code' => 'invalid_pairing_code']);
+
+    $consumed = TotemPreset::factory()->create(['login_code_consumed_at' => now()]);
+    $this->postJson('/api/totem/auth', ['code' => $consumed->login_code])->assertStatus(401)->assertJson(['code' => 'invalid_pairing_code']);
+
+    $inactive = TotemPreset::factory()->create(['is_active' => false]);
+    $this->postJson('/api/totem/auth', ['code' => $inactive->login_code])->assertStatus(401)->assertJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('fails pairing for an unknown preset', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999999])->assertExitCode(1);
+});
+
+it('regenerating a pairing code replaces the previous one', function () {
+    $preset = TotemPreset::factory()->create();
+    $old = $preset->login_code;
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertExitCode(0);
+    $preset->refresh();
+
+    expect($preset->login_code)->not->toBe($old)
+        ->and($preset->login_code_consumed_at)->toBeNull();
+
+    $this->postJson('/api/totem/auth', ['code' => $old])->assertStatus(401);
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertStatus(200);
+});
+
+it('throttles pairing attempts at 10 per minute', function () {
+    TotemPreset::factory()->create();
+
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(429)->assertJson(['code' => 'rate_limited']);
+});
+
+it('throttles ticket issuance at 30 per minute', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'geral']);
+    $preset->queues()->attach($queue->id);
+    $headers = ['Authorization' => 'Bearer '.totemPairToken($preset->refresh())];
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson("/api/{$preset->entity->slug}/geral/ticket", ['priority' => 0], $headers)->assertStatus(201);
+    }
+
+    $this->postJson("/api/{$preset->entity->slug}/geral/ticket", ['priority' => 0], $headers)
+        ->assertStatus(429)->assertJson(['code' => 'rate_limited']);
+});
+
+it('rejects invalid tokens and inactive devices', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'geral']);
+    $preset->queues()->attach($queue->id);
+    $token = totemPairToken($preset->refresh());
+    $url = "/api/{$preset->entity->slug}/queues";
+
+    $this->getJson($url)->assertStatus(401)->assertJson(['code' => 'invalid_token']);
+    $this->getJson($url, ['Authorization' => 'Bearer garbage'])->assertStatus(401)->assertJson(['code' => 'invalid_token']);
+    $this->getJson($url, ['Authorization' => 'Bearer '.$token.'tampered'])->assertStatus(401)->assertJson(['code' => 'invalid_token']);
+
+    $payload = json_decode(TotemJwt::base64UrlDecode(explode('.', $token)[1]), true);
+    $expired = TotemJwt::encode(array_merge($payload, ['exp' => time() - 10]));
+    $this->getJson($url, ['Authorization' => 'Bearer '.$expired])->assertStatus(401)->assertJson(['code' => 'invalid_token']);
+
+    Totem::query()->update(['is_active' => false]);
+    $this->getJson($url, ['Authorization' => 'Bearer '.$token])->assertStatus(401)->assertJson(['code' => 'invalid_token']);
+
+    Totem::query()->update(['is_active' => true]);
+    $preset->update(['is_active' => false]);
+    $this->getJson($url, ['Authorization' => 'Bearer '.$token])->assertStatus(401)->assertJson(['code' => 'invalid_token']);
+    $preset->update(['is_active' => true]);
+
+    $mismatched = TotemJwt::encode(array_merge($payload, [
+        'entity_id' => TotemPreset::factory()->create()->entity_id,
+        'exp' => time() + 3600,
+    ]));
+    $this->getJson($url, ['Authorization' => 'Bearer '.$mismatched])->assertStatus(401)->assertJson(['code' => 'invalid_token']);
+});
+
+it('refreshes last_seen_at on authenticated calls', function () {
+    $preset = TotemPreset::factory()->create();
+    $preset->queues()->attach(Queue::factory()->for($preset->entity)->create()->id);
+    $token = totemPairToken($preset->refresh());
+    $headers = ['Authorization' => 'Bearer '.$token];
+
+    $before = Totem::query()->firstOrFail()->last_seen_at;
+    $this->travel(5)->minutes();
+    $this->getJson("/api/{$preset->entity->slug}/queues", $headers)->assertStatus(200);
+
+    expect(Totem::query()->firstOrFail()->last_seen_at->gt($before))->toBeTrue();
+});
+
+it('enforces entity and queue scope on totem endpoints', function () {
+    $preset = TotemPreset::factory()->create();
+    $scoped = Queue::factory()->for($preset->entity)->create(['slug' => 'scoped']);
+    $unscoped = Queue::factory()->for($preset->entity)->create(['slug' => 'unscoped']);
+    $preset->queues()->attach($scoped->id);
+    $headers = ['Authorization' => 'Bearer '.totemPairToken($preset->refresh())];
+
+    $this->getJson('/api/other-slug/queues', $headers)->assertStatus(403)->assertJson(['code' => 'forbidden']);
+    $this->getJson("/api/{$preset->entity->slug}/unscoped/priorities", $headers)->assertStatus(403)->assertJson(['code' => 'forbidden']);
+    $this->postJson("/api/{$preset->entity->slug}/unscoped/ticket", ['priority' => 0], $headers)->assertStatus(403);
+
+    $foreign = Queue::factory()->create(['slug' => 'foreign']);
+    $this->getJson("/api/{$preset->entity->slug}/foreign/priorities", $headers)->assertStatus(404)->assertJson(['code' => 'queue_not_found']);
+    expect($foreign->entity_id)->not->toBe($preset->entity_id);
+});
+
+it('rejects invalid priorities and inactive queues without creating tickets', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'geral']);
+    $preset->queues()->attach($queue->id);
+    $headers = ['Authorization' => 'Bearer '.totemPairToken($preset->refresh())];
+
+    $this->postJson("/api/{$preset->entity->slug}/geral/ticket", ['priority' => 5], $headers)
+        ->assertStatus(422)->assertJson(['code' => 'invalid_priority']);
+    $this->postJson("/api/{$preset->entity->slug}/geral/ticket", [], $headers)
+        ->assertStatus(422)->assertJson(['code' => 'invalid_priority']);
+    expect(Ticket::query()->count())->toBe(0);
+
+    $queue->update(['is_active' => false]);
+    $this->getJson("/api/{$preset->entity->slug}/geral/priorities", $headers)
+        ->assertStatus(422)->assertJson(['code' => 'inactive_queue']);
+    $this->postJson("/api/{$preset->entity->slug}/geral/ticket", ['priority' => 0], $headers)
+        ->assertStatus(422)->assertJson(['code' => 'inactive_queue']);
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers CORS only for totem web origins on api paths', function () {
+    $preset = TotemPreset::factory()->create();
+    $preset->queues()->attach(Queue::factory()->for($preset->entity)->create()->id);
+    $headers = ['Authorization' => 'Bearer '.totemPairToken($preset->refresh())];
+
+    $preflight = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'http://localhost:8081',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+    expect($preflight->getStatusCode())->toBe(204)
+        ->and($preflight->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+
+    $allowed = $this->getJson("/api/{$preset->entity->slug}/queues", array_merge($headers, ['Origin' => 'http://localhost:8081']));
+    expect($allowed->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+
+    $denied = $this->getJson("/api/{$preset->entity->slug}/queues", array_merge($headers, ['Origin' => 'https://evil.example.com']));
+    expect($denied->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+});
