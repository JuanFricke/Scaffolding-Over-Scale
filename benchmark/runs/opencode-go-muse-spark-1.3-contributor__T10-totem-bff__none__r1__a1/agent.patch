new file mode 100644
index 0000000..90e916f
--- /dev/null
+++ b/app/Console/Commands/TotemPairingCodeCommand.php
@@ -0,0 +1,75 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Log;
+
+class TotemPairingCodeCommand extends Command
+{
+    /**
+     * @var string
+     */
+    protected $signature = 'totem:pairing-code {preset}';
+
+    /**
+     * @var string
+     */
+    protected $description = 'Open a pairing window for a totem preset by generating a 6-digit login code (10 min TTL).';
+
+    public function handle(): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if (! $preset) {
+            $this->error("Preset [{$this->argument('preset')}] not found.");
+
+            return 1;
+        }
+
+        // Cryptographically random, zero-padded. Regenerating replaces the
+        // previous code and clears any consumption marker. Retry on the
+        // (unlikely) unique collision with another preset's code.
+        for ($attempt = 1; ; $attempt++) {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+            try {
+                $preset->forceFill([
+                    'login_code' => $code,
+                    'login_code_expires_at' => now()->addMinutes(10),
+                    'login_code_consumed_at' => null,
+                ])->save();
+
+                break;
+            } catch (QueryException $e) {
+                if ($attempt >= 5 || ! self::isUniqueViolation($e)) {
+                    throw $e;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('totem.pairing_code_generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'code_suffix' => substr($code, -2),
+        ]);
+
+        $this->line($code);
+
+        return 0;
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemAuthController.php b/app/Http/Controllers/Api/TotemAuthController.php
new file mode 100644
index 0000000..e7e02be
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemAuthController.php
@@ -0,0 +1,100 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+
+class TotemAuthController extends Controller
+{
+    public function store(Request $request): JsonResponse
+    {
+        $raw = $request->input('code');
+
+        if (is_int($raw)) {
+            $raw = (string) $raw;
+        }
+
+        if (! is_string($raw) || preg_match('/^\d{6}$/', $raw) !== 1) {
+            Log::channel('audit')->warning('totem.pairing_failed', ['reason' => 'invalid_code_format']);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $code = $raw;
+
+        $result = DB::transaction(function () use ($code) {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (! $preset
+                || ! $preset->is_active
+                || $preset->login_code_consumed_at !== null
+                || $preset->login_code_expires_at === null
+                || $preset->login_code_expires_at->isPast()) {
+                return null;
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = $preset->entity->totems()->create([
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+
+            $now = time();
+            $ttl = TotemJwt::ttl();
+
+            $token = TotemJwt::encode([
+                'totem_id' => $totem->id,
+                'entity_id' => $preset->entity_id,
+                'preset_id' => $preset->id,
+                'queues' => $queueIds,
+                'iat' => $now,
+                'exp' => $now + $ttl,
+                'jti' => Str::random(32),
+            ]);
+
+            return [$totem, $preset, $token, $ttl];
+        });
+
+        if ($result === null) {
+            Log::channel('audit')->warning('totem.pairing_failed', [
+                'reason' => 'invalid_pairing_code',
+                'code_suffix' => substr($code, -2),
+            ]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        [$totem, $preset, $token, $ttl] = $result;
+
+        Log::channel('audit')->info('totem.pairing_succeeded', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'totem_id' => $totem->id,
+            'code_suffix' => substr($code, -2),
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => $ttl,
+            'entity' => [
+                'slug' => $preset->entity->slug,
+                'name' => $preset->entity->name,
+            ],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemQueueController.php b/app/Http/Controllers/Api/TotemQueueController.php
new file mode 100644
index 0000000..5c32146
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemQueueController.php
@@ -0,0 +1,161 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Totem\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController extends Controller
+{
+    public function index(Request $request, string $entity): JsonResponse
+    {
+        /** @var Entity $tokenEntity */
+        $tokenEntity = $request->attributes->get('totem_entity');
+
+        if ($entity !== $tokenEntity->slug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        /** @var list<int> $effective */
+        $effective = array_map('intval', (array) $request->attributes->get('totem_queues', []));
+
+        $queues = $effective === []
+            ? collect()
+            : Queue::query()
+                ->where('entity_id', $tokenEntity->id)
+                ->where('is_active', true)
+                ->whereIn('id', $effective)
+                ->orderBy('name')
+                ->get();
+
+        $payload = $queues->values()->map(fn (Queue $queue, int $position) => $this->queuePayload($queue, $position + 1))->all();
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug, 'name' => $tokenEntity->name],
+            'queues' => $payload,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolution = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolution instanceof JsonResponse) {
+            return $resolution;
+        }
+
+        [$tokenEntity, $target] = $resolution;
+
+        if (! $target->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug],
+            'queue' => ['slug' => $target->slug, 'label' => $target->name],
+            'priorities' => TotemPriorities::all(),
+        ]);
+    }
+
+    public function store(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolution = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolution instanceof JsonResponse) {
+            return $resolution;
+        }
+
+        [, $target] = $resolution;
+
+        $priority = $request->input('priority');
+
+        if (is_string($priority) && ctype_digit($priority)) {
+            $priority = (int) $priority;
+        }
+
+        if (! is_int($priority) || TotemPriorities::find($priority) === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = (new IssueTicket)($target, $priority, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $level = TotemPriorities::find($priority);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $target->slug, 'label' => $target->name],
+            'priority' => ['value' => $level['value'], 'label' => $level['label']],
+            'issued_at' => $ticket->issued_at->toISO8601String(),
+        ], 201);
+    }
+
+    /**
+     * @return array{0: Entity, 1: Queue}|JsonResponse
+     */
+    private function resolveQueue(Request $request, string $entity, string $queue): array|JsonResponse
+    {
+        /** @var Entity $tokenEntity */
+        $tokenEntity = $request->attributes->get('totem_entity');
+
+        if ($entity !== $tokenEntity->slug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $target = Queue::query()
+            ->where('entity_id', $tokenEntity->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $target) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        /** @var list<int> $effective */
+        $effective = $request->attributes->get('totem_queues', []);
+
+        if (! in_array((int) $target->id, array_map('intval', $effective), true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return [$tokenEntity, $target];
+    }
+
+    /**
+     * @return array{slug: string, label: string, description: string|null, visual: array{color: string, icon: string, order: int}, is_active: bool}
+     */
+    private function queuePayload(Queue $queue, int $order): array
+    {
+        $labels = $queue->labels_i18n;
+
+        if (! is_array($labels)) {
+            $labels = [];
+        }
+
+        $description = $labels['description'] ?? null;
+        $color = $labels['color'] ?? '#0055FF';
+        $icon = $labels['icon'] ?? 'ticket';
+
+        return [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => is_string($description) ? $description : null,
+            'visual' => [
+                'color' => is_string($color) ? $color : '#0055FF',
+                'icon' => is_string($icon) ? $icon : 'ticket',
+                'order' => $order,
+            ],
+            'is_active' => true,
+        ];
+    }
+}
diff --git a/app/Http/Middleware/TotemAuthenticate.php b/app/Http/Middleware/TotemAuthenticate.php
new file mode 100644
index 0000000..5db4354
--- /dev/null
+++ b/app/Http/Middleware/TotemAuthenticate.php
@@ -0,0 +1,101 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Throwable;
+
+/**
+ * Validates the totem JWT on every authenticated call.
+ *
+ * Missing/invalid/expired token, unknown or inactive totem, unknown or
+ * inactive preset, or entity mismatch between claims, totem and preset all
+ * answer 401 {"code":"invalid_token"}. Quietly refreshes last_seen_at.
+ */
+class TotemAuthenticate
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $claims = $this->claims($request);
+
+        if ($claims === null) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        if (! isset($claims['totem_id'], $claims['entity_id'], $claims['preset_id'])) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $totem = Totem::query()->find($claims['totem_id']);
+        $preset = TotemPreset::query()->find($claims['preset_id']);
+        $entity = Entity::query()->find($claims['entity_id']);
+
+        if (! $totem || ! $preset || ! $entity) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        if (! $totem->is_active || ! $preset->is_active) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        if ((int) $totem->entity_id !== (int) $entity->id
+            || (int) $preset->entity_id !== (int) $entity->id) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        try {
+            $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+        } catch (Throwable) {
+            // Quiet: a last-seen write failure must not fail the request.
+        }
+
+        $presetQueueIds = $preset->queues()->pluck('queues.id')->all();
+        $claimQueues = $claims['queues'] ?? [];
+        $claimQueues = is_array($claimQueues) ? $claimQueues : [];
+
+        $effective = array_values(array_intersect(
+            array_map('intval', $claimQueues),
+            array_map('intval', $presetQueueIds),
+        ));
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_claims', $claims);
+        $request->attributes->set('totem_queues', $effective);
+
+        return $next($request);
+    }
+
+    /**
+     * @return array<string, mixed>|null
+     */
+    private function claims(Request $request): ?array
+    {
+        $header = (string) $request->headers->get('Authorization', '');
+
+        if (! preg_match('/^Bearer\s+(.+)$/i', trim($header), $matches)) {
+            return null;
+        }
+
+        $token = trim($matches[1]);
+
+        if ($token === '') {
+            return null;
+        }
+
+        try {
+            $claims = TotemJwt::decode($token);
+        } catch (Throwable) {
+            return null;
+        }
+
+        return is_array($claims) ? $claims : null;
+    }
+}
