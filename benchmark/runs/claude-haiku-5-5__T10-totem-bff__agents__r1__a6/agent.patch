+<?php
+
+use App\Http\Controllers\Api\TotemAuthController;
+use App\Http\Controllers\Api\TotemController;
+use Illuminate\Support\Facades\Route;
+
+// Totem API (prefix /api). Pairing is public and rate-limited per IP; everything
+// else requires the totem JWT (totem.auth) and is re-validated per call.
+Route::post('totem/auth', [TotemAuthController::class, 'store'])
+    ->middleware('throttle:10,1')
+    ->name('api.totem.auth');
+
+Route::middleware('totem.auth')->group(function () {
+    Route::get('{entity}/queues', [TotemController::class, 'queues'])
+        ->name('api.totem.queues');
+
+    Route::get('{entity}/{queue}/priorities', [TotemController::class, 'priorities'])
+        ->name('api.totem.priorities');
+
+    Route::post('{entity}/{queue}/ticket', [TotemController::class, 'issueTicket'])
+        ->middleware('throttle:30,1')
+        ->name('api.totem.tickets');
+});
