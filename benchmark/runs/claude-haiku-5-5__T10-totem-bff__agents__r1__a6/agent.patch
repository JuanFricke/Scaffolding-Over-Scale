@@ -0,0 +1,77 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemToken;
+use Firebase\JWT\JWT;
+use Tests\TestCase;
+
+uses(TestCase::class);
+
+function unitToken(array $claims, string $alg = 'HS256'): string
+{
+    $encode = fn (array $part): string => rtrim(strtr(base64_encode(json_encode($part)), '+/', '-_'), '=');
+
+    return $encode(['alg' => $alg, 'typ' => 'JWT']).'.'.$encode($claims).'.';
+}
+
+function unitPreset(): array
+{
+    $entity = new Entity(['slug' => 'loja-centro', 'name' => 'Loja Centro']);
+    $entity->id = 7;
+
+    $preset = new TotemPreset;
+    $preset->id = 3;
+    $preset->entity_id = $entity->id;
+
+    $totem = new Totem;
+    $totem->id = 11;
+    $totem->entity_id = $entity->id;
+
+    return [$preset, $totem];
+}
+
+it('issues an HS256 token whose claims round-trip', function () {
+    [$preset, $totem] = unitPreset();
+
+    $token = TotemToken::issue($totem, $preset, [5, 9]);
+    $header = json_decode(base64_decode(strtr(explode('.', $token)[0], '-_', '+/')), true);
+    $claims = TotemToken::decode($token);
+
+    expect($header['alg'])->toBe('HS256')
+        ->and($claims)->toMatchArray([
+            'totem_id' => 11,
+            'entity_id' => 7,
+            'preset_id' => 3,
+            'queues' => [5, 9],
+        ])
+        ->and($claims)->toHaveKeys(['iat', 'exp', 'jti'])
+        ->and($claims['exp'] - $claims['iat'])->toBe(3600);
+});
+
+it('uses the configured TTL for expiry', function () {
+    config(['services.totem.jwt_ttl' => 120]);
+    [$preset, $totem] = unitPreset();
+
+    $claims = TotemToken::decode(TotemToken::issue($totem, $preset, []));
+
+    expect($claims['exp'] - $claims['iat'])->toBe(120);
+});
+
+it('returns null for tokens signed with another secret, unsigned tokens and garbage', function () {
+    [$preset, $totem] = unitPreset();
+    $forged = JWT::encode(totemClaims($preset, $totem), str_repeat('x', 40), 'HS256');
+
+    expect(TotemToken::decode($forged))->toBeNull()
+        ->and(TotemToken::decode(unitToken(totemClaims($preset, $totem), 'none')))->toBeNull()
+        ->and(TotemToken::decode('garbage'))->toBeNull();
+});
+
+it('refuses to sign or verify with a secret shorter than 32 characters', function () {
+    config(['services.totem.jwt_secret' => 'too-short']);
+    [$preset, $totem] = unitPreset();
+
+    expect(fn () => TotemToken::issue($totem, $preset, []))->toThrow(RuntimeException::class)
+        ->and(fn () => TotemToken::decode('a.b.c'))->toThrow(RuntimeException::class);
+});
