diff --git a/app/Http/Controllers/Api/TotemAuthController.php b/app/Http/Controllers/Api/TotemAuthController.php
new file mode 100644
index 0000000..4de0596
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemAuthController.php
@@ -0,0 +1,62 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use App\Http\Controllers\Controller;
+use App\Support\TotemToken;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    /**
+     * Exchange a preset's pairing code for a totem JWT.
+     *
+     * Only a JSON string of exactly six digits is a valid shape: a JSON number
+     * would drop leading zeros, so it is rejected rather than coerced.
+     */
+    public function store(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || ! preg_match('/^[0-9]{6}$/D', $code)) {
+            Log::channel('audit')->warning('Totem pairing rejected', [
+                'reason' => 'invalid_code_format',
+                'ip' => $request->ip(),
+            ]);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        try {
+            ['totem' => $totem, 'preset' => $preset, 'token' => $token] = (new PairTotem)($code);
+        } catch (InvalidPairingCodeException) {
+            Log::channel('audit')->warning('Totem pairing rejected', [
+                'reason' => 'invalid_pairing_code',
+                'ip' => $request->ip(),
+            ]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        Log::channel('audit')->info('Totem paired', [
+            'totem_id' => $totem->id,
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'ip' => $request->ip(),
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => TotemToken::ttl(),
+            'entity' => [
+                'slug' => $preset->entity->slug,
+                'name' => $preset->entity->name,
+            ],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemController.php b/app/Http/Controllers/Api/TotemController.php
new file mode 100644
index 0000000..5b69aa7
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemController.php
@@ -0,0 +1,167 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Context\TotemPrincipal;
+use App\Enums\TicketChannel;
+use App\Enums\TotemPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * The three authenticated totem reads/writes. Every path value is checked against
+ * the JWT scope: the entity slug must be the token's, and the queue slug is resolved
+ * inside that entity and must be in the effective queue scope.
+ */
+class TotemController extends Controller
+{
+    public function queues(string $entity, TotemPrincipal $principal): JsonResponse
+    {
+        if ($entity !== $principal->entity->slug) {
+            return $this->forbidden();
+        }
+
+        $queues = Queue::query()
+            ->where('entity_id', $principal->entity->id)
+            ->where('is_active', true)
+            ->whereIn('id', $principal->queueIds)
+            ->orderBy('name')
+            ->orderBy('id')
+            ->get();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $principal->entity->slug,
+                'name' => $principal->entity->name,
+            ],
+            'queues' => $queues->values()->map(function (Queue $queue, int $index) use ($principal): array {
+                $visual = $principal->preset->queueVisual($queue);
+
+                return [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => $visual['description'],
+                    'visual' => [
+                        'color' => $visual['color'],
+                        'icon' => $visual['icon'],
+                        'order' => $index + 1,
+                    ],
+                    'is_active' => true,
+                ];
+            })->all(),
+        ]);
+    }
+
+    public function priorities(string $entity, string $queue, TotemPrincipal $principal): JsonResponse
+    {
+        $resolved = $this->resolveQueue($entity, $queue, $principal);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        if (! $resolved->is_active) {
+            return $this->inactiveQueue();
+        }
+
+        $priorities = collect(TotemPriority::cases())
+            ->map(fn (TotemPriority $priority, int $index): array => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+                'visual' => [
+                    'color' => $priority->color(),
+                    'icon' => $priority->icon(),
+                    'order' => $index + 1,
+                ],
+            ])
+            ->values()
+            ->all();
+
+        return response()->json([
+            'entity' => ['slug' => $principal->entity->slug],
+            'queue' => [
+                'slug' => $resolved->slug,
+                'label' => $resolved->name,
+            ],
+            'priorities' => $priorities,
+        ]);
+    }
+
+    public function issueTicket(Request $request, string $entity, string $queue, TotemPrincipal $principal): JsonResponse
+    {
+        $resolved = $this->resolveQueue($entity, $queue, $principal);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        // Strict int: a numeric string or float is not one of the backend-owned values.
+        $value = $request->input('priority');
+        $priority = is_int($value) ? TotemPriority::tryFrom($value) : null;
+
+        if ($priority === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            // IssueTicket re-checks the queue state under its own lock, so a
+            // deactivation that races this request is still rejected.
+            $ticket = (new IssueTicket)($resolved, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return $this->inactiveQueue();
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $resolved->slug,
+                'label' => $resolved->name,
+            ],
+            'priority' => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601ZuluString(),
+        ], 201);
+    }
+
+    /**
+     * Entity must match the token, then the queue must exist in that entity and
+     * be in the token's effective scope. Returns the error response on failure.
+     */
+    private function resolveQueue(string $entity, string $slug, TotemPrincipal $principal): Queue|JsonResponse
+    {
+        if ($entity !== $principal->entity->slug) {
+            return $this->forbidden();
+        }
+
+        $queue = Queue::query()
+            ->where('entity_id', $principal->entity->id)
+            ->where('slug', $slug)
+            ->first();
+
+        if (! $queue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! $principal->allowsQueue($queue)) {
+            return $this->forbidden();
+        }
+
+        return $queue;
+    }
+
+    private function forbidden(): JsonResponse
+    {
+        return response()->json(['code' => 'forbidden'], 403);
+    }
+
+    private function inactiveQueue(): JsonResponse
+    {
+        return response()->json(['code' => 'inactive_queue'], 422);
+    }
+}
diff --git a/app/Http/Middleware/AuthenticateTotem.php b/app/Http/Middleware/AuthenticateTotem.php
new file mode 100644
index 0000000..77e47aa
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,75 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Context\TotemPrincipal;
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemToken;
+use Closure;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Authenticates every totem API call from its Bearer JWT.
+ *
+ * Re-validates the totem, its preset and the entity on each request, so
+ * deactivating a totem or preset takes effect immediately. The effective queue
+ * scope is the token's queues claim intersected with the preset's current queues.
+ */
+class AuthenticateTotem
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+        $claims = $token === null ? null : TotemToken::decode($token);
+
+        if (! $this->hasWellFormedClaims($claims)) {
+            return $this->invalidToken();
+        }
+
+        $totem = Totem::query()->whereKey($claims['totem_id'])->where('is_active', true)->first();
+        $preset = TotemPreset::query()->whereKey($claims['preset_id'])->where('is_active', true)->first();
+        $entity = Entity::query()->whereKey($claims['entity_id'])->first();
+
+        if (! $totem || ! $preset || ! $entity) {
+            return $this->invalidToken();
+        }
+
+        if ($totem->entity_id !== $entity->id || $preset->entity_id !== $entity->id) {
+            return $this->invalidToken();
+        }
+
+        Totem::query()->whereKey($totem->id)->update(['last_seen_at' => now()]);
+
+        $presetQueueIds = $preset->queues()
+            ->pluck('queues.id')
+            ->map(fn (mixed $id): int => (int) $id)
+            ->all();
+
+        $queueIds = array_values(array_intersect(array_map('intval', $claims['queues']), $presetQueueIds));
+
+        app()->instance(TotemPrincipal::class, new TotemPrincipal($totem, $preset, $entity, $queueIds));
+
+        return $next($request);
+    }
+
+    /**
+     * @param  array<string, mixed>|null  $claims
+     */
+    private function hasWellFormedClaims(?array $claims): bool
+    {
+        return $claims !== null
+            && is_int($claims['totem_id'] ?? null)
+            && is_int($claims['entity_id'] ?? null)
+            && is_int($claims['preset_id'] ?? null)
+            && is_array($claims['queues'] ?? null);
+    }
+
+    private function invalidToken(): JsonResponse
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
