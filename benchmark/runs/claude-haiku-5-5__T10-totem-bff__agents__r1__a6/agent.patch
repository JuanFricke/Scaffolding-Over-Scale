+it('answers 422 inactive_queue and creates nothing for an inactive queue', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'parada', 'is_active' => false]);
+    ['token' => $token] = totemSession($preset, [$queue]);
+
+    $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/parada/ticket", ['priority' => 0])
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 403 forbidden for a queue outside the preset scope', function () {
+    $preset = TotemPreset::factory()->create();
+    Queue::factory()->for($preset->entity)->create(['slug' => 'fora', 'is_active' => true]);
+    ['token' => $token] = totemSession($preset);
+
+    $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/fora/ticket", ['priority' => 0])
+        ->assertForbidden()
+        ->assertExactJson(['code' => 'forbidden']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 404 queue_not_found for an unknown slug', function () {
+    $preset = TotemPreset::factory()->create();
+    ['token' => $token] = totemSession($preset);
+
+    $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/nao-existe/ticket", ['priority' => 0])
+        ->assertNotFound()
+        ->assertExactJson(['code' => 'queue_not_found']);
+});
+
+it('answers 403 forbidden when the entity slug is not the token entity', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'geral', 'is_active' => true]);
+    ['token' => $token] = totemSession($preset, [$queue]);
+    $other = Entity::factory()->create();
+
+    $this->withToken($token)
+        ->postJson("/api/{$other->slug}/geral/ticket", ['priority' => 0])
+        ->assertForbidden()
+        ->assertExactJson(['code' => 'forbidden']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('rate-limits issuance to 30 per minute with a JSON 429', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'geral', 'is_active' => true]);
+    ['token' => $token] = totemSession($preset, [$queue]);
+    $path = "/api/{$preset->entity->slug}/geral/ticket";
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->withToken($token)->postJson($path, ['priority' => 0])->assertCreated();
+    }
+
+    $this->withToken($token)
+        ->postJson($path, ['priority' => 0])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
