+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('lists active preset queues of the entity by name with a 1-based visual order', function () {
+    $preset = TotemPreset::factory()->create();
+    $geral = Queue::factory()->for($preset->entity)->create(['name' => 'Geral', 'slug' => 'geral', 'is_active' => true]);
+    $caixa = Queue::factory()->for($preset->entity)->create(['name' => 'Caixa', 'slug' => 'caixa', 'is_active' => true]);
+    $antiga = Queue::factory()->for($preset->entity)->create(['name' => 'Antiga', 'slug' => 'antiga', 'is_active' => false]);
