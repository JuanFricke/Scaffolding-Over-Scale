+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('answers a preflight from a local origin with 204 and echoes the origin', function (string $origin) {
+    $this->withHeaders([
+        'Origin' => $origin,
+        'Access-Control-Request-Method' => 'POST',
+        'Access-Control-Request-Headers' => 'authorization,content-type',
+    ])
+        ->options('/api/totem/auth')
+        ->assertNoContent()
+        ->assertHeader('Access-Control-Allow-Origin', $origin);
+})->with([
+    'localhost with port' => ['http://localhost:8081'],
+    'https localhost' => ['https://localhost'],
+    '127.0.0.1' => ['http://127.0.0.1'],
+    '127.0.0.1 with port' => ['http://127.0.0.1:5000'],
+]);
+
+it('sends no allow-origin header for other origins', function () {
+    $this->withHeaders([
+        'Origin' => 'https://evil.example',
+        'Access-Control-Request-Method' => 'POST',
+    ])
+        ->options('/api/totem/auth')
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+});
+
+it('sends no allow-origin header for look-alike hosts', function () {
+    $this->withHeaders(['Origin' => 'http://localhost.evil.example'])
+        ->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+});
+
+it('adds the allow-origin header to actual API responses for local origins', function () {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->withHeaders(['Origin' => 'http://localhost:8081'])
+        ->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertOk()
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081')
+        ->assertHeaderMissing('Access-Control-Allow-Credentials');
+});
+
+it('allows the origin configured as TOTEM_WEB_ORIGIN', function () {
+    config(['cors.allowed_origins' => ['https://totem.example.test']]);
+
+    $this->withHeaders([
+        'Origin' => 'https://totem.example.test',
+        'Access-Control-Request-Method' => 'POST',
+    ])
+        ->options('/api/totem/auth')
+        ->assertNoContent()
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem.example.test');
+});
