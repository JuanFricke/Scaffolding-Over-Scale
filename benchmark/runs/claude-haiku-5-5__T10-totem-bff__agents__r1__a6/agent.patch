+
+/**
+ * Attach queues to a preset and issue a JWT for a totem of the same entity.
+ *
+ * @param  list<Queue>  $queues
+ * @return array{totem: Totem, token: string}
+ */
+function totemSession(TotemPreset $preset, array $queues = [], ?Totem $totem = null): array
+{
+    $queueIds = array_map(fn (Queue $queue): int => $queue->id, $queues);
+
+    $preset->queues()->syncWithoutDetaching($queueIds);
+
+    $totem ??= Totem::factory()->for($preset->entity)->create();
+
+    return [
+        'totem' => $totem,
+        'token' => TotemToken::issue($totem, $preset, $queueIds),
+    ];
+}
+
+/**
+ * Claims for a hand-signed token (used to build forged/expired/mismatched tokens).
+ *
+ * @param  array<string, mixed>  $overrides
+ * @return array<string, mixed>
+ */
+function totemClaims(TotemPreset $preset, Totem $totem, array $overrides = []): array
+{
+    return array_merge([
+        'totem_id' => $totem->id,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+        'iat' => time(),
+        'exp' => time() + 3600,
+        'jti' => 'test-jti',
+    ], $overrides);
+}
+
+/**
+ * Capture every write to the audit channel. Returns the collected lines.
+ *
+ * @return ArrayObject<int, string>
+ */
+function captureAuditLog(): ArrayObject
+{
+    $lines = new ArrayObject;
+    $audit = Mockery::mock();
+
+    $audit->shouldReceive('info', 'warning', 'error')
+        ->andReturnUsing(function (string $message, array $context = []) use ($lines): void {
+            $lines[] = $message.' '.json_encode($context);
+        });
+
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    return $lines;
+}
