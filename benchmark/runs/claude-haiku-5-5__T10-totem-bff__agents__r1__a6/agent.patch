@@ -0,0 +1,79 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use DomainException;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use Illuminate\Support\Str;
+use RuntimeException;
+use UnexpectedValueException;
+
+/**
+ * HS256 runtime credential for a paired totem.
+ *
+ * Claims: totem_id, entity_id, preset_id, queues (scope at pairing time), iat,
+ * exp, jti. Secret and TTL come from config('services.totem').
+ */
+final class TotemToken
+{
+    private const ALGORITHM = 'HS256';
+
+    private const MIN_SECRET_LENGTH = 32;
+
+    /**
+     * @param  list<int>  $queueIds
+     */
+    public static function issue(Totem $totem, TotemPreset $preset, array $queueIds): string
+    {
+        $issuedAt = time();
+
+        return JWT::encode([
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => array_values($queueIds),
+            'iat' => $issuedAt,
+            'exp' => $issuedAt + self::ttl(),
+            'jti' => (string) Str::uuid(),
+        ], self::secret(), self::ALGORITHM);
+    }
+
+    /**
+     * Verified claims, or null when the token is malformed, forged, unsigned or expired.
+     *
+     * @return array<string, mixed>|null
+     */
+    public static function decode(string $token): ?array
+    {
+        $key = new Key(self::secret(), self::ALGORITHM);
+
+        try {
+            return (array) JWT::decode($token, $key);
+        } catch (UnexpectedValueException|DomainException) {
+            return null;
+        }
+    }
+
+    public static function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl');
+    }
+
+    /**
+     * Refuses to run with a short secret: an empty or weak HMAC key would make
+     * every token forgeable, so this fails loudly rather than signing.
+     */
+    private static function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if (strlen($secret) < self::MIN_SECRET_LENGTH) {
+            throw new RuntimeException('TOTEM_JWT_SECRET must be at least '.self::MIN_SECRET_LENGTH.' characters.');
+        }
+
+        return $secret;
+    }
+}
