+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+
+uses(RefreshDatabase::class);
+
+it('opens a pairing window with a fresh 6-digit code and prints it', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => null, 'login_code_expires_at' => null]);
+
+    expect(Artisan::call('totem:pairing-code', ['preset' => $preset->id]))->toBe(0);
+
+    $preset->refresh();
+
+    expect($preset->login_code)->toMatch('/^[0-9]{6}$/')
+        ->and($preset->login_code_expires_at->between(now()->addMinutes(9), now()->addMinutes(10)))->toBeTrue()
+        ->and(Artisan::output())->toContain($preset->login_code);
+});
+
+it('replaces the previous code and reopens a consumed window', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code_expires_at' => now()->addMinute(),
+        'login_code_consumed_at' => now()->subMinute(),
+    ]);
+    $previousCode = $preset->login_code;
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    $preset->refresh();
+
+    expect($preset->login_code)->not->toBe($previousCode)
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->login_code_expires_at->between(now()->addMinutes(9), now()->addMinutes(10)))->toBeTrue();
+});
+
+it('fails with a message for an unknown preset', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999999])
+        ->expectsOutputToContain('not found')
+        ->assertExitCode(1);
+});
+
+it('refuses to open a window for an inactive preset', function () {
+    $preset = TotemPreset::factory()->create([
+        'is_active' => false,
+        'login_code' => null,
+        'login_code_expires_at' => null,
+    ]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+        ->expectsOutputToContain('inactive')
+        ->assertExitCode(1);
+
+    expect($preset->fresh()->login_code)->toBeNull();
+});
+
+it('audits the window opening without writing the code to the log', function () {
+    $preset = TotemPreset::factory()->create();
+    $lines = captureAuditLog();
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    $preset->refresh();
+
+    expect(implode("\n", $lines->getArrayCopy()))
+        ->toContain('Totem pairing window opened')
+        ->not->toContain($preset->login_code);
+});
