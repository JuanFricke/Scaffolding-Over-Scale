+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned priority levels for totem issuance. Single source for both the
+ * priorities endpoint and ticket validation; values are stored on tickets.priority.
+ */
+enum TotemPriority: int
+{
+    case Normal = 0;
+    case Priority = 10;
+    case EightyPlus = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Priority => 'Prioritário',
+            self::EightyPlus => 'Prioridade 80+',
+        };
+    }
+
+    public function color(): string
+    {
+        return match ($this) {
+            self::Normal => '#2E7D32',
+            self::Priority => '#C62828',
+            self::EightyPlus => '#6A1B9A',
+        };
+    }
+
+    public function icon(): string
+    {
+        return match ($this) {
+            self::Normal => 'person',
+            self::Priority => 'priority',
+            self::EightyPlus => 'star',
+        };
+    }
+}
