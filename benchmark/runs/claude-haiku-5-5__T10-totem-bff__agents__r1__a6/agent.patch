@@ -0,0 +1,42 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Actions\OpenTotemPairing;
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+
+#[Signature('totem:pairing-code {preset : The totem preset id to open pairing for}')]
+#[Description('Open a 10-minute pairing window for a totem preset and print its code')]
+class TotemPairingCode extends Command
+{
+    /**
+     * Execute the console command.
+     */
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+        $preset = TotemPreset::query()->find($presetId);
+
+        if (! $preset) {
+            $this->error("Totem preset [{$presetId}] not found.");
+
+            return self::FAILURE;
+        }
+
+        if (! $preset->is_active) {
+            $this->error("Totem preset [{$preset->id}] is inactive.");
+
+            return self::FAILURE;
+        }
+
+        $code = (new OpenTotemPairing)($preset);
+
+        $this->info("Pairing code for \"{$preset->name}\": {$code}");
+        $this->line('Valid for '.OpenTotemPairing::CODE_TTL_MINUTES.' minutes. Regenerating replaces it.');
+
+        return self::SUCCESS;
+    }
+}
