@@ -0,0 +1,56 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Opens a pairing window for a preset: issues its own fresh 6-digit code.
+ *
+ * Regenerating replaces the previous code and reopens a consumed window.
+ */
+class OpenTotemPairing
+{
+    public const CODE_TTL_MINUTES = 10;
+
+    /**
+     * @return string The new code (display once; never logged).
+     */
+    public function __invoke(TotemPreset $preset): string
+    {
+        return DB::transaction(function () use ($preset): string {
+            $locked = TotemPreset::query()->whereKey($preset->id)->lockForUpdate()->firstOrFail();
+
+            $code = $this->newCode();
+
+            $locked->fill([
+                'login_code' => $code,
+                'login_code_expires_at' => now()->addMinutes(self::CODE_TTL_MINUTES),
+                'login_code_consumed_at' => null,
+            ])->save();
+
+            Log::channel('audit')->info('Totem pairing window opened', [
+                'preset_id' => $locked->id,
+                'entity_id' => $locked->entity_id,
+                'expires_at' => $locked->login_code_expires_at->toIso8601String(),
+            ]);
+
+            return $code;
+        });
+    }
+
+    /**
+     * login_code is unique across presets, so no two presets may hold the same
+     * code at once. Checking every row (not just open windows) keeps it that way.
+     */
+    private function newCode(): string
+    {
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while (TotemPreset::query()->where('login_code', $code)->exists());
+
+        return $code;
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
new file mode 100644
index 0000000..164ab63
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemToken;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Redeems a pairing code: consumes it, creates the totem row for the preset's
+ * entity and signs the JWT that the totem uses for every later call.
+ */
+class PairTotem
+{
+    /**
+     * @return array{totem: Totem, preset: TotemPreset, token: string}
+     *
+     * @throws InvalidPairingCodeException
+     */
+    public function __invoke(string $code): array
+    {
+        return DB::transaction(function () use ($code): array {
+            // Locking the preset row serializes concurrent redemptions of the same code.
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (! $preset || ! $this->isRedeemable($preset)) {
+                throw new InvalidPairingCodeException('Pairing code is not redeemable.');
+            }
+
+            $preset->update(['login_code_consumed_at' => now()]);
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()
+                ->pluck('queues.id')
+                ->map(fn (mixed $id): int => (int) $id)
+                ->all();
+
+            return [
+                'totem' => $totem,
+                'preset' => $preset,
+                'token' => TotemToken::issue($totem, $preset, $queueIds),
+            ];
+        });
+    }
+
+    private function isRedeemable(TotemPreset $preset): bool
+    {
+        return $preset->is_active
+            && $preset->login_code_consumed_at === null
+            && $preset->login_code_expires_at?->isFuture() === true;
+    }
+}
