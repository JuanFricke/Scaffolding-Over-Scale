+<?php
+
+namespace App\Context;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+
+/**
+ * The paired totem behind the current API request, after token and row checks.
+ *
+ * Bound to the container by the AuthenticateTotem middleware, mirroring Tenant.
+ */
+final readonly class TotemPrincipal
+{
+    /**
+     * @param  list<int>  $queueIds  Effective scope: JWT queues claim ∩ the preset's current queues.
+     */
+    public function __construct(
+        public Totem $totem,
+        public TotemPreset $preset,
+        public Entity $entity,
+        public array $queueIds,
+    ) {}
+
+    public function allowsQueue(Queue $queue): bool
+    {
+        return $queue->entity_id === $this->entity->id
+            && in_array($queue->id, $this->queueIds, true);
+    }
+}
