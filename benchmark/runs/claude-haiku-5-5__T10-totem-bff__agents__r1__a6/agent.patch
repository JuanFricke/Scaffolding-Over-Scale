+
+    ['token' => $token] = totemSession($preset, [$geral, $caixa, $antiga, $foreign]);
+
+    $preset->update(['appearance' => ['queues' => [
+        $geral->id => ['description' => 'Atendimento geral', 'color' => '#112233', 'icon' => 'star'],
