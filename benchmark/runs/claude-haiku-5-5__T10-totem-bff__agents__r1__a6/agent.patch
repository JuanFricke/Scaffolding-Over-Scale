+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('lists the backend-owned priorities with visuals for an in-scope active queue', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['name' => 'Geral', 'slug' => 'geral', 'is_active' => true]);
+    ['token' => $token] = totemSession($preset, [$queue]);
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/geral/priorities")
+        ->assertOk()
+        ->assertExactJson([
+            'entity' => ['slug' => $preset->entity->slug],
+            'queue' => ['slug' => 'geral', 'label' => 'Geral'],
+            'priorities' => [
+                ['value' => 0, 'label' => 'Normal', 'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1]],
+                ['value' => 10, 'label' => 'Prioritário', 'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2]],
+                ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => ['color' => '#6A1B9A', 'icon' => 'star', 'order' => 3]],
+            ],
+        ]);
+});
+
+it('answers 422 inactive_queue for an inactive queue', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'parada', 'is_active' => false]);
+    ['token' => $token] = totemSession($preset, [$queue]);
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/parada/priorities")
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+});
+
+it('answers 403 forbidden for a queue outside the preset scope', function () {
+    $preset = TotemPreset::factory()->create();
+    Queue::factory()->for($preset->entity)->create(['slug' => 'fora', 'is_active' => true]);
+    ['token' => $token] = totemSession($preset);
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/fora/priorities")
+        ->assertForbidden()
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('answers 404 queue_not_found, including for another entity’s queue slug', function () {
+    $preset = TotemPreset::factory()->create();
+    $foreign = Queue::factory()->create(['slug' => 'geral', 'is_active' => true]);
+    ['token' => $token] = totemSession($preset, [$foreign]);
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/geral/priorities")
+        ->assertNotFound()
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/nao-existe/priorities")
+        ->assertNotFound()
+        ->assertExactJson(['code' => 'queue_not_found']);
+});
+
+it('answers 403 forbidden when the entity slug is not the token entity', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['slug' => 'geral', 'is_active' => true]);
+    ['token' => $token] = totemSession($preset, [$queue]);
+    $other = Entity::factory()->create();
+
+    $this->withToken($token)
+        ->getJson("/api/{$other->slug}/geral/priorities")
+        ->assertForbidden()
+        ->assertExactJson(['code' => 'forbidden']);
+});
