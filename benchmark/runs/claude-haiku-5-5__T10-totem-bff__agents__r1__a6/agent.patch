+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+it('gives a preset factory an active, unconsumed 6-digit code expiring in ten minutes', function () {
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->login_code)->toMatch('/^[0-9]{6}$/')
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->is_active)->toBeTrue()
+        ->and($preset->login_code_expires_at->between(now()->addMinutes(9), now()->addMinutes(10)))->toBeTrue();
+});
+
+it('never serializes the login code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->toArray())->not->toHaveKey('login_code');
+});
+
+it('links presets to queues through totem_preset_queue', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue);
+
+    expect($preset->queues()->pluck('queues.id')->all())->toBe([$queue->id])
+        ->and(DB::table('totem_preset_queue')->where(['preset_id' => $preset->id, 'queue_id' => $queue->id])->value('created_at'))
+        ->not->toBeNull();
+
+    $preset->queues()->detach($queue);
+
+    expect($preset->queues()->count())->toBe(0);
+});
+
+it('belongs to an entity and is listed on it', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    expect($preset->entity->is($entity))->toBeTrue()
+        ->and($entity->totemPresets->pluck('id')->all())->toBe([$preset->id]);
+});
+
+it('creates an active totem for an entity by default', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+
+    expect($totem->is_active)->toBeTrue()
+        ->and($totem->entity->is($entity))->toBeTrue()
+        ->and($entity->totems->pluck('id')->all())->toBe([$totem->id]);
+});
