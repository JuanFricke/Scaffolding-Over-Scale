+                [
+                    'slug' => 'caixa',
+                    'label' => 'Caixa',
+                    'description' => null,
+                    'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => 1],
+                    'is_active' => true,
+                ],
+                [
+                    'slug' => 'geral',
+                    'label' => 'Geral',
+                    'description' => 'Atendimento geral',
+                    'visual' => ['color' => '#112233', 'icon' => 'star', 'order' => 2],
+                    'is_active' => true,
+                ],
+            ],
+        ]);
+});
+
+it('answers 403 forbidden when the entity slug is not the token entity', function () {
+    $preset = TotemPreset::factory()->create();
+    ['token' => $token] = totemSession($preset);
+    $other = Entity::factory()->create();
+
+    $this->withToken($token)
+        ->getJson("/api/{$other->slug}/queues")
+        ->assertForbidden()
+        ->assertExactJson(['code' => 'forbidden']);
+});
