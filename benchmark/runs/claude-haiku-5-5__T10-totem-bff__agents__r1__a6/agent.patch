+    $queue = Queue::factory()->for($preset->entity)->create(['is_active' => true]);
+    $preset->queues()->attach($queue);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+    $response->assertOk()
+        ->assertJsonStructure(['token', 'token_type', 'expires_in', 'entity' => ['slug', 'name']])
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $preset->entity->slug)
+        ->assertJsonPath('entity.name', $preset->entity->name);
+
+    $claims = TotemToken::decode($response->json('token'));
+    $totem = Totem::query()->sole();
+
+    expect($claims['totem_id'])->toBe($totem->id)
+        ->and($claims['entity_id'])->toBe($preset->entity_id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['queues'])->toBe([$queue->id])
+        ->and($claims['exp'] - $claims['iat'])->toBe(3600)
+        ->and($totem->entity_id)->toBe($preset->entity_id)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull()
+        ->and($preset->fresh()->login_code_consumed_at)->not->toBeNull();
+});
+
+it('rejects malformed codes with 400 invalid_code_format', function (array $payload) {
+    $this->postJson('/api/totem/auth', $payload)
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+})->with([
+    'empty' => [['code' => '']],
+    'missing' => [[]],
+    'five digits' => [['code' => '12345']],
+    'seven digits' => [['code' => '1234567']],
+    'letters' => [['code' => '12345a']],
+    'leading space' => [['code' => ' 123456']],
+    'trailing newline' => [['code' => "123456\n"]],
+    'json integer' => [['code' => 123456]],
+]);
+
+it('answers 401 invalid_pairing_code for an unknown code', function () {
+    $this->postJson('/api/totem/auth', ['code' => '999999'])
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('answers the same 401 for expired, consumed or inactive codes', function (array $attributes) {
+    TotemPreset::factory()->create(['login_code' => '654321', ...$attributes]);
+
+    $this->postJson('/api/totem/auth', ['code' => '654321'])
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+})->with([
+    'expired' => [['login_code_expires_at' => now()->subSecond()]],
+    'consumed' => [['login_code_consumed_at' => now()->subMinute()]],
+    'inactive preset' => [['is_active' => false]],
+]);
+
+it('accepts a code only once', function () {
+    TotemPreset::factory()->create(['login_code' => '111222']);
+
+    $this->postJson('/api/totem/auth', ['code' => '111222'])->assertOk();
+
+    $this->postJson('/api/totem/auth', ['code' => '111222'])
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('rate-limits pairing attempts to 10 per minute with a JSON 429', function () {
+    for ($attempt = 0; $attempt < 10; $attempt++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertUnauthorized();
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('audits successful pairings and failures without logging the code', function () {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+    $lines = captureAuditLog();
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => '000001'])->assertUnauthorized();
+
+    expect(implode("\n", $lines->getArrayCopy()))
+        ->toContain('Totem paired')
+        ->toContain('Totem pairing rejected')
+        ->not->toContain('123456')
+        ->not->toContain('000001');
+});
diff --git a/tests/Feature/Totem/TotemAuthenticationTest.php b/tests/Feature/Totem/TotemAuthenticationTest.php
new file mode 100644
index 0000000..ab3ce86
--- /dev/null
+++ b/tests/Feature/Totem/TotemAuthenticationTest.php
@@ -0,0 +1,144 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function unsignedTotemToken(array $claims): string
+{
+    $encode = fn (array $part): string => rtrim(strtr(base64_encode(json_encode($part)), '+/', '-_'), '=');
+
+    return $encode(['alg' => 'none', 'typ' => 'JWT']).'.'.$encode($claims).'.';
+}
+
+it('rejects requests without a bearer token', function () {
+    $entity = Entity::factory()->create();
+
+    $this->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects malformed, forged, expired and unsigned tokens', function (Closure $makeToken) {
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->for($preset->entity)->create();
+    $secret = config('services.totem.jwt_secret');
+
+    $this->withToken($makeToken($preset, $totem, $secret))
+        ->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+})->with([
+    'malformed' => [fn () => 'not-a-jwt'],
+    'forged signature' => [fn ($preset, $totem) => JWT::encode(totemClaims($preset, $totem), str_repeat('x', 40), 'HS256')],
+    'expired' => [fn ($preset, $totem, $secret) => JWT::encode(totemClaims($preset, $totem, ['exp' => time() - 10]), $secret, 'HS256')],
+    'unsigned alg none' => [fn ($preset, $totem) => unsignedTotemToken(totemClaims($preset, $totem))],
+]);
+
+it('rejects a token whose totem is missing or inactive', function (Closure $arrange) {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['is_active' => true]);
+    ['totem' => $totem, 'token' => $token] = totemSession($preset, [$queue]);
+
+    $arrange($totem);
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+})->with([
+    'inactive totem' => [fn (Totem $totem) => $totem->update(['is_active' => false])],
+    'deleted totem' => [fn (Totem $totem) => $totem->delete()],
+]);
+
+it('rejects a token whose preset is missing or inactive', function (Closure $arrange) {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['is_active' => true]);
+    ['token' => $token] = totemSession($preset, [$queue]);
+
+    $arrange($preset);
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+})->with([
+    'inactive preset' => [fn (TotemPreset $preset) => $preset->update(['is_active' => false])],
+    'deleted preset' => [fn (TotemPreset $preset) => $preset->delete()],
+]);
+
+it('rejects a token whose entity claim disagrees with the totem or preset', function () {
+    $preset = TotemPreset::factory()->create();
+    $other = Entity::factory()->create();
+    $totem = Totem::factory()->for($preset->entity)->create();
+
+    $token = JWT::encode(
+        totemClaims($preset, $totem, ['entity_id' => $other->id]),
+        config('services.totem.jwt_secret'),
+        'HS256',
+    );
+
+    $this->withToken($token)
+        ->getJson("/api/{$other->slug}/queues")
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose entity was deleted', function () {
+    $preset = TotemPreset::factory()->create();
+    ['token' => $token] = totemSession($preset);
+
+    $preset->entity->delete();
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('refreshes last_seen_at on every authenticated call', function () {
+    $preset = TotemPreset::factory()->create();
+    ['totem' => $totem, 'token' => $token] = totemSession($preset);
+
+    expect($totem->last_seen_at)->toBeNull();
+
+    $this->withToken($token)->getJson("/api/{$preset->entity->slug}/queues")->assertOk();
+
+    expect($totem->fresh()->last_seen_at)->not->toBeNull();
+});
+
+it('limits queues to the intersection of the token claim and the preset’s current queues', function () {
+    $preset = TotemPreset::factory()->create();
+    $kept = Queue::factory()->for($preset->entity)->create(['name' => 'Alpha', 'is_active' => true]);
+    $removed = Queue::factory()->for($preset->entity)->create(['name' => 'Beta', 'is_active' => true]);
+    ['token' => $token] = totemSession($preset, [$kept, $removed]);
+    $path = "/api/{$preset->entity->slug}/queues";
+
+    $this->withToken($token)->getJson($path)->assertJsonCount(2, 'queues');
+
+    $preset->queues()->detach($removed);
+
+    $this->withToken($token)
+        ->getJson($path)
+        ->assertJsonCount(1, 'queues')
+        ->assertJsonPath('queues.0.slug', $kept->slug);
+});
+
+it('does not expose a queue added to the preset after pairing to an existing token', function () {
+    $preset = TotemPreset::factory()->create();
+    $paired = Queue::factory()->for($preset->entity)->create(['is_active' => true]);
+    $later = Queue::factory()->for($preset->entity)->create(['is_active' => true]);
+    ['token' => $token] = totemSession($preset, [$paired]);
+
+    $preset->queues()->attach($later);
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertJsonCount(1, 'queues')
+        ->assertJsonPath('queues.0.slug', $paired->slug);
+});
