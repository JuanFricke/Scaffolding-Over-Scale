+                    $validKey = true;
+                    $intKey = (int) $key;
+                }
+            }
+
+            if (! $validKey || $intKey === null) {
+                throw new InvalidArgumentException('Invalid priority prefix map key.');
+            }
+
+            if (! is_string($value) || ! preg_match('/^[A-Z]$/', $value)) {
+                throw new InvalidArgumentException('Invalid priority prefix map value.');
+            }
+
+            // Duplicate int keys cannot happen in PHP arrays (last wins),
+            // but guard anyway.
+            $normalized[$intKey] = $value;
+        }
+
+        $effective = array_values($normalized);
+
+        foreach ([0, 10, 20] as $level) {
+            if (! array_key_exists($level, $normalized)) {
+                $effective[] = self::defaultPrefixFor($level);
+            }
+        }
