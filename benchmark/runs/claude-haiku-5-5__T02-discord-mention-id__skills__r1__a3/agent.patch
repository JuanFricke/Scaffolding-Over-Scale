@@ -121,3 +121,131 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends a mention of the configured user on its own line', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '123456789012345678',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed', ['queue' => 'asaas-webhooks']);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "queue=asaas-webhooks\n<@123456789012345678>");
+    });
+});
+
+test('accepts an integer mention id and trims surrounding whitespace', function (int|string $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@123456789012345678>"));
+})->with([
+    '123456789012345678',
+    '  123456789012345678 ',
+    123456789012345678,
+]);
+
+test('accepts snowflakes between 17 and 20 digits', function (string $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@{$id}>"));
+})->with([
+    str_repeat('1', 17),
+    str_repeat('9', 20),
+]);
+
+test('does not mention anyone when the mention id is unset or empty', function (?string $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '', '   ']);
+
+test('ignores mention ids that are not a discord snowflake', function (string $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@') && ! str_contains($content, '@everyone');
+    });
+})->with([
+    '@everyone',
+    '@here',
+    'abc',
+    '123',
+    str_repeat('1', 16),
+    str_repeat('1', 21),
+    '123456789012345678x',
+    "123\n@everyone",
+    "123> \n@everyone",
+    '<@123456789012345678>',
+]);
+
+test('keeps the mention within the 1800 character limit when the alert is truncated', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '12345678901234567890',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000), ['note' => str_repeat('y', 2000)]);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return mb_strlen($content) === 1800
+            && str_starts_with($content, "T\n".str_repeat('x', 100))
+            && str_ends_with($content, "\n<@12345678901234567890>");
+    });
+});
