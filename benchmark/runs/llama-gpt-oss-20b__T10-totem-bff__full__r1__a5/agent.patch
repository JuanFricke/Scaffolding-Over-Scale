+use Illuminate\Support\Facades\Route;
+
+// Preflight CORS for totem auth
+Route::options('/totem/auth', function () {
+    return response('', 204)->header('Access-Control-Allow-Origin', request()->header('Origin'));
+})->middleware('cors');
+
+// Pairing code endpoint
+Route::post('/totem/auth', [TotemAuthController::class, 'auth'])->middleware('throttle:10,1');
+
+Route::middleware(['throttle:30,1', 'totem.auth'])->group(function () {
+    Route::get('/{entity:slug}/queues', [TotemApiController::class, 'queues']);
+    Route::get('/{entity:slug}/{queue:slug}/priorities', [TotemApiController::class, 'priorities']);
+    Route::post('/{entity:slug}/{queue:slug}/ticket', [TotemApiController::class, 'ticket']);
