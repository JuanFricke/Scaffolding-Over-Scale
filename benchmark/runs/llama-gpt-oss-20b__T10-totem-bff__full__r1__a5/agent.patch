--- /dev/null
+++ b/app/Http/Middleware/TotemAuth.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $authHeader = $request->header('Authorization');
+        if (!$authHeader || !str_starts_with($authHeader, 'Bearer ')) {
+            return $this->unauthorized();
+        }
+        $token = substr($authHeader, 7);
+        $claims = $this->decodeToken($token);
+        if (!$claims) {
+            return $this->unauthorized();
+        }
+        $totem = Totem::find($claims['totem_id']);
+        if (!$totem || !$totem->is_active) {
+            return $this->unauthorized();
+        }
+        // Validate preset active
+        $preset = TotemPreset::find($claims['preset_id']);
+        if (!$preset || !$preset->is_active) {
+            return $this->unauthorized();
+        }
+        // Entity match
+        if ($claims['entity_id'] !== $totem->entity_id) {
+            return $this->unauthorized();
+        }
+        // Update last_seen_at
+        $totem->update(['last_seen_at' => now()]);
+        // Store attributes
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('preset', $preset);
+        $request->attributes->set('jwt_queues', $claims['queues'] ?? []);
+
+        return $next($request);
+    }
+
+    private function unauthorized(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+
+    private function decodeToken(string $jwt): ?array
+    {
+        $parts = explode('.', $jwt);
+        if (count($parts) !== 3) {
+            return null;
+        }
+        [$headerB64, $payloadB64, $signatureB64] = $parts;
+        $header = json_decode(base64_decode(strtr($headerB64, '-_', '+/')), true);
+        $payload = json_decode(base64_decode(strtr($payloadB64, '-_', '+/')), true);
+        if (!$header || !$payload) {
+            return null;
+        }
+        $secret = config('services.totem.jwt_secret');
+        $alg = $header['alg'] ?? '';
+        if ($alg !== 'HS256') {
+            return null;
+        }
+        $calc = hash_hmac('sha256', $headerB64 . '.' . $payloadB64, $secret, true);
+        $calcB64 = rtrim(strtr(base64_encode($calc), '+/', '-_'), '=');
+        if (!hash_equals($calcB64, $signatureB64)) {
+            return null;
+        }
+        if (isset($payload['exp']) && time() > $payload['exp']) {
+            return null;
+        }
+        return $payload;
+    }
+}
