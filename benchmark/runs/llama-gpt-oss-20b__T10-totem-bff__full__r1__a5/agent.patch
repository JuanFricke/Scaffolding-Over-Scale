@@ -0,0 +1,90 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\TotemPreset;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Symfony\Component\HttpFoundation\Response;
+
+class TotemAuthController
+{
+    public function auth(Request $request): Response
+    {
+        $code = $request->input('code', '');
+        if (!preg_match('/^[0-9]{6}$/', $code)) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $preset = TotemPreset::where('login_code', $code)
+            ->where('login_code_expires_at', '>', now())
+            ->whereNull('login_code_consumed_at')
+            ->first();
+        if (!$preset || ! $preset->is_active) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        // Consume code atomically
+        DB::transaction(function () use ($preset) {
+            $preset->login_code_consumed_at = now();
+            $preset->save();
+        });
+
+        // Create totem
+        $totem = $preset->entity->totems()->create([
+            'name' => $preset->name,
+            'is_active' => true,
+        ]);
+
+        $queues = $preset->queues->pluck('id')->toArray();
+
+        $jwt = $this->createJwt($totem, $preset, $queues);
+
+        // Log success
+        Log::info("Totem paired: totem {$totem->id} preset {$preset->id}");
+
+        return response()->json([
+            'token' => $jwt,
+            'token_type' => 'Bearer',
+            'expires_in' => config('services.totem.jwt_ttl', 3600),
+            'entity' => [
+                'slug' => $preset->entity->slug,
+                'name' => $preset->entity->name,
+            ],
+        ], 200);
+    }
+
+    private function createJwt($totem, $preset, array $queues): string
+    {
+        $payload = [
+            'totem_id' => $totem->id,
+            'entity_id' => $totem->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => $queues,
+            'iat' => time(),
+            'exp' => time() + config('services.totem.jwt_ttl', 3600),
+            'jti' => uniqid('', true),
+        ];
+        $header = ['alg' => 'HS256', 'typ' => 'JWT'];
+        $secret = config('services.totem.jwt_secret');
+        $jwt = $this->base64UrlEncode(json_encode($header)) . '.' .
+                $this->base64UrlEncode(json_encode($payload)) . '.' .
+                $this->base64UrlEncode(
+                    hash_hmac('sha256',
+                        $this->base64UrlEncode(json_encode($header)) . '.' .
+                        $this->base64UrlEncode(json_encode($payload)),
+                        $secret, true)
+                );
+        return $jwt;
+    }
+
+    private function base64UrlEncode(string $data): string
+    {
+        return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');
+    }
+}
