@@ -0,0 +1,106 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Actions\IssueTicket;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class TotemApiController
+{
+    public function queues(Request $request, Entity $entity): Response
+    {
+        // Preset from auth middleware
+        $preset = $request->attributes->get('preset');
+        $allowedQueues = $preset->queues->pluck('id')->toArray();
+        $queues = $entity->queues()->where('is_active', true)
+            ->whereIn('id', $allowedQueues)
+            ->orderBy('name')
+            ->get(['id', 'slug', 'name', 'description', 'visual', 'is_active']);
+        $data = $queues->map(function ($q) {
+            return [
+                'slug' => $q->slug,
+                'label' => $q->name,
+                'description' => $q->description,
+                'visual' => $q->visual ?? [],
+                'is_active' => $q->is_active,
+            ];
+        });
+        return response()->json([
+            'entity' => [
+                'slug' => $entity->slug,
+                'name' => $entity->name,
+            ],
+            'queues' => $data,
+        ]);
+    }
+
+    public function priorities(Request $request, Entity $entity, Queue $queue): Response
+    {
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+        // Check scope
+        $preset = $request->attributes->get('preset');
+        if (! $preset->queues()->where('queue_id', $queue->id)->exists()) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+        $priorities = [
+            ['value' => 0, 'label' => 'Normal', 'visual' => []],
+            ['value' => 10, 'label' => 'Prioritário', 'visual' => []],
+            ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => []],
+        ];
+        return response()->json([
+            'entity' => ['slug' => $entity->slug],
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priorities' => $priorities,
+        ]);
+    }
+
+    public function ticket(Request $request, Entity $entity, Queue $queue): Response
+    {
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+        $preset = $request->attributes->get('preset');
+        if (! $preset->queues()->where('queue_id', $queue->id)->exists()) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+        $priority = $request->input('priority');
+        $valid = [0, 10, 20];
+        if (! in_array($priority, $valid, true)) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+        $ticket = app(IssueTicket::class)($queue, $priority, TicketChannel::Totem);
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priority' => [
+                'value' => $priority,
+                'label' => collect($this->priorityLabels())->firstWhere('value', $priority)['label'],
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+
+    private function priorityLabels(): array
+    {
+        return [
+            ['value' => 0, 'label' => 'Normal'],
+            ['value' => 10, 'label' => 'Prioritário'],
+            ['value' => 20, 'label' => 'Prioridade 80+'],
+        ];
+    }
+}
