+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+class PairTotemCode extends Command
+{
+    protected $signature = 'totem:pairing-code {preset}';
+    protected $description = 'Generate a pairing code for a totem preset';
+
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+        $preset = TotemPreset::find($presetId);
+        if (! $preset) {
+            $this->error('Preset not found.');
+            return 1;
+        }
+
+        $code = str_pad(random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        $preset->login_code = $code;
+        $preset->login_code_expires_at = now()->addMinutes(10);
+        $preset->login_code_consumed_at = null;
+        $preset->save();
+
+        $this->info("Pairing code generated: {$code}");
+        Log::info("Pairing code generated for preset {$preset->id}");
+        return 0;
+    }
+}
