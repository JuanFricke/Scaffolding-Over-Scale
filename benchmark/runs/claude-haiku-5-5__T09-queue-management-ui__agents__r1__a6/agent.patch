+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('queues and serve routes are named under the current entity', function () {
+    expect(route('entity.queues', 'acme'))->toEndWith('/e/acme/queues')
+        ->and(route('entity.serve', 'acme'))->toEndWith('/e/acme/serve');
+});
+
+test('navbar links to queues for managers and to serve for every member', function () {
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertOk()
+        ->assertSeeText(__('ui.nav_queues'))
+        ->assertSeeText(__('ui.nav_serve'))
+        ->assertSee(route('entity.queues', $entity->slug), false)
+        ->assertSee(route('entity.serve', $entity->slug), false);
+});
+
+test('navbar hides the queues link from employees but keeps serve', function () {
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertOk()
+        ->assertDontSee(route('entity.queues', $entity->slug), false)
+        ->assertDontSeeText(__('ui.nav_queues'))
+        ->assertSee(route('entity.serve', $entity->slug), false);
+});
+
+test('a member can reach the serve page through its route', function () {
+    $employee = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.serve', $entity->slug))->assertOk();
+});
+
+test('a non-member cannot reach the queues or serve pages', function () {
+    $entity = Entity::factory()->create();
+    $outsider = User::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($outsider)->owner()->create();
+
+    $this->actingAs($outsider);
+
+    $this->get(route('entity.queues', $entity->slug))->assertForbidden();
+    $this->get(route('entity.serve', $entity->slug))->assertForbidden();
