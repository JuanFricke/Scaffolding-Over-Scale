diff --git a/app/Livewire/Entity/Queues.php b/app/Livewire/Entity/Queues.php
new file mode 100644
index 0000000..8a42d88
--- /dev/null
+++ b/app/Livewire/Entity/Queues.php
@@ -0,0 +1,305 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateQueue;
+use App\Actions\SetQueueAccess;
+use App\Actions\UpdateQueue;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Queues extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    /**
+     * Draft name for a new queue. Only persisted via create().
+     */
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    /**
+     * Whether the create modal is open. Client-writable flag — every action
+     * re-authorizes server-side.
+     */
+    public bool $creating = false;
+
+    /**
+     * Queue shown in the detail modal. Untrusted client state — always
+     * re-resolved scoped to the entity before use.
+     */
+    public ?int $viewingQueueId = null;
+
+    /**
+     * Whether the deactivate/reactivate confirmation is open for the viewed queue.
+     */
+    public bool $confirmingToggle = false;
+
+    /**
+     * Queue being renamed in the detail modal. Untrusted client state.
+     */
+    public ?int $editingQueueId = null;
+
+    /**
+     * Draft name edited in the rename form. Only persisted via rename().
+     */
+    #[Validate('required|string|max:255')]
+    public string $renameName = '';
+
+    /**
+     * Queue whose access grants are managed. Untrusted client state — always
+     * re-resolved scoped to the entity before use.
+     */
+    public ?int $accessQueueId = null;
+
+    /**
+     * Whether the access modal is open.
+     */
+    public bool $managingAccess = false;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('create', [Queue::class, $entity]);
+        $this->entity = $entity;
+    }
+
+    /**
+     * Open the create modal.
+     */
+    public function openCreate(): void
+    {
+        $this->authorize('create', [Queue::class, $this->entity]);
+
+        $this->resetValidation('name');
+        $this->creating = true;
+    }
+
+    /**
+     * Close the create modal and discard the draft.
+     */
+    public function closeCreate(): void
+    {
+        $this->reset('name', 'creating');
+        $this->resetValidation('name');
+    }
+
+    /**
+     * Create a queue through CreateQueue (slug derived from the name). Domain
+     * errors, including a duplicate slug, are reported on the name field.
+     */
+    public function create(): void
+    {
+        $this->authorize('create', [Queue::class, $this->entity]);
+        $this->validateOnly('name');
+
+        try {
+            (new CreateQueue)($this->entity, auth()->user(), $this->name);
+        } catch (ValidationException $e) {
+            $this->addError('name', $this->firstError($e));
+
+            return;
+        }
+
+        $this->reset('name');
+        $this->creating = false;
+    }
+
+    /**
+     * Open the detail modal for a queue of this entity.
+     */
+    public function openQueue($queueId): void
+    {
+        $queue = $this->scopedQueue($queueId);
+        $this->authorize('update', $queue);
+
+        $this->closeQueue();
+        $this->viewingQueueId = $queue->id;
+    }
+
+    /**
+     * Close the detail modal and every nested state (rename, confirmation, access).
+     */
+    public function closeQueue(): void
+    {
+        $this->reset(
+            'viewingQueueId',
+            'confirmingToggle',
+            'editingQueueId',
+            'renameName',
+            'accessQueueId',
+            'managingAccess',
+        );
+        $this->resetValidation('renameName');
+    }
+
+    /**
+     * Start renaming a queue, drafting its current name.
+     */
+    public function startRename($queueId): void
+    {
+        $queue = $this->scopedQueue($queueId);
+        $this->authorize('update', $queue);
+
+        $this->editingQueueId = $queue->id;
+        $this->renameName = $queue->name;
+        $this->resetValidation('renameName');
+    }
+
+    public function cancelRename(): void
+    {
+        $this->reset('editingQueueId', 'renameName');
+        $this->resetValidation('renameName');
+    }
+
+    /**
+     * Rename through UpdateQueue with the slug re-derived from the new name.
+     * Domain errors, including a slug collision, are reported on the rename field.
+     */
+    public function rename(): void
+    {
+        $queue = $this->scopedQueue($this->editingQueueId);
+        $this->authorize('update', $queue);
+        $this->validateOnly('renameName');
+
+        try {
+            (new UpdateQueue)(
+                $queue,
+                auth()->user(),
+                name: $this->renameName,
+                slug: Str::slug($this->renameName),
+            );
+        } catch (ValidationException $e) {
+            $this->addError('renameName', $this->firstError($e));
+
+            return;
+        }
+
+        $this->cancelRename();
+    }
+
+    /**
+     * Ask for confirmation before deactivating or reactivating the viewed queue.
+     */
+    public function confirmToggle(): void
+    {
+        $queue = $this->scopedQueue($this->viewingQueueId);
+        $this->authorize('update', $queue);
+
+        $this->confirmingToggle = true;
+    }
+
+    public function cancelToggle(): void
+    {
+        $this->confirmingToggle = false;
+    }
+
+    /**
+     * Flip the queue's active flag through UpdateQueue.
+     */
+    public function toggleActive($queueId): void
+    {
+        $queue = $this->scopedQueue($queueId);
+        $this->authorize('update', $queue);
+
+        (new UpdateQueue)($queue, auth()->user(), isActive: ! $queue->is_active);
+
+        $this->confirmingToggle = false;
+    }
+
+    /**
+     * Open the access modal for a queue of this entity.
+     */
+    public function openAccess($queueId): void
+    {
+        $queue = $this->scopedQueue($queueId);
+        $this->authorize('manageAccess', $queue);
+
+        $this->accessQueueId = $queue->id;
+        $this->managingAccess = true;
+    }
+
+    public function closeAccess(): void
+    {
+        $this->reset('accessQueueId', 'managingAccess');
+    }
+
+    /**
+     * Grant the call permission to a membership of this entity.
+     */
+    public function grantAccess($membershipId): void
+    {
+        $this->setAccess($membershipId, [QueuePermission::Call]);
+    }
+
+    /**
+     * Revoke every queue permission from a membership of this entity.
+     */
+    public function revokeAccess($membershipId): void
+    {
+        $this->setAccess($membershipId, []);
+    }
+
+    /**
+     * @param  array<int, QueuePermission>  $permissions
+     */
+    private function setAccess($membershipId, array $permissions): void
+    {
+        $queue = $this->scopedQueue($this->accessQueueId);
+        $this->authorize('manageAccess', $queue);
+
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        (new SetQueueAccess)($membership, $queue, auth()->user(), $permissions);
+    }
+
+    /**
+     * Resolve a client-supplied queue id, scoped to the entity (foreign ids are not found).
+     */
+    private function scopedQueue($queueId): Queue
+    {
+        return $this->entity->queues()->findOrFail($queueId ?? 0);
+    }
+
+    private function firstError(ValidationException $e): string
+    {
+        return collect($e->errors())->flatten()->first();
+    }
+
+    public function render(): View
+    {
+        $viewing = $this->viewingQueueId === null
+            ? null
+            : $this->entity->queues()->find($this->viewingQueueId);
+
+        // Empty unless the access modal is open for a queue of this entity.
+        $accessQueue = $this->managingAccess && $this->accessQueueId !== null
+            ? $this->entity->queues()->find($this->accessQueueId)
+            : null;
+
+        $accessGrants = $accessQueue
+            ? QueueAccess::query()
+                ->where('queue_id', $accessQueue->id)
+                ->get()
+                ->keyBy('entity_membership_id')
+            : collect();
+
+        return view('livewire.entity.queues', [
+            'queues' => $this->entity->queues()->orderBy('name')->get(),
+            'viewing' => $viewing,
+            'accessQueue' => $accessQueue,
+            'accessGrants' => $accessGrants,
+            'memberships' => $this->entity->memberships()->with('user')->latest('id')->get(),
+        ]);
+    }
+}
diff --git a/app/Livewire/Entity/Serve.php b/app/Livewire/Entity/Serve.php
new file mode 100644
index 0000000..34c0340
--- /dev/null
+++ b/app/Livewire/Entity/Serve.php
@@ -0,0 +1,161 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Serve extends Component
+{
+    /**
+     * Waiting tickets shown per queue (first N in call order).
+     */
+    private const WAITING_LIMIT = 30;
+
+    /**
+     * Successful calls allowed per user and entity within the decay window.
+     */
+    private const CALLS_PER_MINUTE = 10;
+
+    #[Locked]
+    public Entity $entity;
+
+    /**
+     * Queue whose waiting list is shown. Untrusted client state — only queues
+     * the user may call are ever read (see callableQueues()).
+     */
+    public ?int $selectedQueueId = null;
+
+    /**
+     * Call mode: any, priority_only or normal_only (matches CallMode values).
+     */
+    #[Validate('required|in:any,priority_only,normal_only')]
+    public string $mode = 'any';
+
+    /**
+     * Last ticket this panel called. Server-only: the client cannot write it.
+     */
+    #[Locked]
+    public ?int $lastCalledTicketId = null;
+
+    /**
+     * Feedback line for the attendant (translated, escaped on render).
+     */
+    public ?string $notice = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+
+        $this->selectedQueueId = $this->callableQueues()->first()?->id;
+    }
+
+    /**
+     * Call the next ticket of the selected queue through CallNextTicket.
+     * Authorization failures are not caught: they surface as a 403.
+     */
+    public function callNext(): void
+    {
+        $this->notice = null;
+        $this->validateOnly('mode');
+
+        if ($this->selectedQueueId === null) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+        $limiterKey = 'serve-call:'.$this->entity->id.':'.auth()->id();
+
+        if (RateLimiter::tooManyAttempts($limiterKey, self::CALLS_PER_MINUTE)) {
+            $this->notice = __('ui.serve_rate_limited');
+
+            return;
+        }
+
+        try {
+            $ticket = (new CallNextTicket)($queue, auth()->user(), CallMode::from($this->mode));
+        } catch (InactiveQueueException) {
+            $this->notice = __('ui.serve_inactive');
+
+            return;
+        } catch (NoWaitingTicketsException) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        RateLimiter::hit($limiterKey, 60);
+
+        $this->lastCalledTicketId = $ticket->id;
+        $this->notice = __('ui.serve_last_called', ['code' => $ticket->code]);
+    }
+
+    /**
+     * Active queues of this entity the current user may call (all for managers,
+     * granted queues for employees).
+     *
+     * @return Collection<int, Queue>
+     */
+    private function callableQueues(): Collection
+    {
+        $user = auth()->user();
+
+        return $this->entity->queues()
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->filter(fn (Queue $queue): bool => $user->can('call', $queue))
+            ->values();
+    }
+
+    /**
+     * Waiting tickets in call order (priority desc, issued_at, id), filtered by mode.
+     *
+     * @return Collection<int, Ticket>
+     */
+    private function waitingTickets(Queue $queue): Collection
+    {
+        $mode = CallMode::tryFrom($this->mode) ?? CallMode::Any;
+
+        return Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->when($mode === CallMode::PriorityOnly, fn ($query) => $query->where('priority', '>', 0))
+            ->when($mode === CallMode::NormalOnly, fn ($query) => $query->where('priority', 0))
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id')
+            ->limit(self::WAITING_LIMIT)
+            ->get();
+    }
+
+    public function render(): View
+    {
+        $queues = $this->callableQueues();
+
+        // A foreign, missing, inactive or not-callable selection matches nothing.
+        $queue = $queues->firstWhere('id', $this->selectedQueueId);
+
+        return view('livewire.entity.serve', [
+            'queues' => $queues,
+            'tickets' => $queue ? $this->waitingTickets($queue) : collect(),
+        ]);
+    }
+}
