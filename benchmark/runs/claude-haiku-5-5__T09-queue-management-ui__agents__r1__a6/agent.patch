diff --git a/tests/Feature/Entity/ServeTest.php b/tests/Feature/Entity/ServeTest.php
new file mode 100644
index 0000000..be60aa4
--- /dev/null
+++ b/tests/Feature/Entity/ServeTest.php
@@ -0,0 +1,361 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array{0: User, 1: Entity}
+ */
+function serveOwnerAndEntity(): array
+{
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Acme']);
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    return [$owner, $entity];
+}
+
+function serveTicket(Queue $queue, array $attributes = []): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create($attributes + [
+        'status' => TicketStatus::Waiting,
+        'channel' => TicketChannel::Virtual,
+        'issued_at' => now(),
+    ]);
+}
+
+test('any member can open the serve panel', function () {
+    [, $entity] = serveOwnerAndEntity();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])->assertOk();
+    $this->get(route('entity.serve', $entity->slug))->assertOk();
+});
+
+test('a non-member cannot open the serve panel', function () {
+    [, $entity] = serveOwnerAndEntity();
+    $outsider = User::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($outsider)->owner()->create();
+
+    $this->actingAs($outsider);
+
+    Livewire::test(Serve::class, ['entity' => $entity])->assertForbidden();
+});
+
+test('selected queue defaults to the first active queue the owner may call', function () {
+    [$owner, $entity] = serveOwnerAndEntity();
+    Queue::factory()->for($entity)->create(['name' => 'Zeta', 'is_active' => true]);
+    Queue::factory()->for($entity)->create(['name' => 'Alfa', 'is_active' => false]);
+    $alfa = Queue::factory()->for($entity)->create(['name' => 'Beta', 'is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $alfa->id);
+
+    expect($component->viewData('queues')->pluck('name')->all())->toBe(['Beta', 'Zeta']);
+});
+
+test('an employee sees only the active queues they hold a call grant for', function () {
+    [, $entity] = serveOwnerAndEntity();
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $granted = Queue::factory()->for($entity)->create(['name' => 'Liberada']);
+    Queue::factory()->for($entity)->create(['name' => 'Fechada']);
+    QueueAccess::factory()->create(['entity_membership_id' => $membership->id, 'queue_id' => $granted->id]);
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $granted->id);
+
+    expect($component->viewData('queues')->pluck('id')->all())->toBe([$granted->id]);
+});
+
+test('employee without any grant has no selection and no tickets', function () {
+    [, $entity] = serveOwnerAndEntity();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    serveTicket($queue, ['code' => 'A001']);
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', null);
+
+    expect($component->viewData('tickets'))->toBeEmpty();
+    $component->assertSee(__('ui.serve_empty'));
+});
+
+test('waiting list follows call order: priority first, then issue time', function () {
+    [$owner, $entity] = serveOwnerAndEntity();
+    $queue = Queue::factory()->for($entity)->create();
+
+    serveTicket($queue, ['code' => 'A001', 'priority' => 0, 'issued_at' => now()->subMinutes(30)]);
+    serveTicket($queue, ['code' => 'A002', 'priority' => 5, 'issued_at' => now()->subMinutes(5)]);
+    serveTicket($queue, ['code' => 'A003', 'priority' => 5, 'issued_at' => now()->subMinutes(10)]);
+    serveTicket($queue, ['code' => 'A004', 'priority' => 0, 'issued_at' => now()]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id);
+
+    expect($component->viewData('tickets')->pluck('code')->all())
+        ->toBe(['A003', 'A002', 'A001', 'A004']);
+});
+
+test('mode filters the waiting list', function () {
+    [$owner, $entity] = serveOwnerAndEntity();
+    $queue = Queue::factory()->for($entity)->create();
+    serveTicket($queue, ['code' => 'A001', 'priority' => 0]);
+    serveTicket($queue, ['code' => 'A002', 'priority' => 3]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id);
+
+    $component->set('mode', 'priority_only');
+    expect($component->viewData('tickets')->pluck('code')->all())->toBe(['A002']);
+
+    $component->set('mode', 'normal_only');
+    expect($component->viewData('tickets')->pluck('code')->all())->toBe(['A001']);
+
+    $component->set('mode', 'any');
+    expect($component->viewData('tickets')->pluck('code')->all())->toBe(['A002', 'A001']);
+});
