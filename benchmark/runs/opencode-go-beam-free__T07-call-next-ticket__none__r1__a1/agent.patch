+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read queue state from the database inside the transaction, locking
+            // the row so concurrent callers/issuance/deactivation are serialized.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $queueId = $lockedQueue->id;
+
+            // Fairness (any mode only): a normal ticket may not wait behind more
+            // than 3 consecutive priority calls.
+            $restrictToNormal = false;
+
+            if ($mode === CallMode::Any) {
+                $recentCalled = Ticket::query()
+                    ->where('queue_id', $queueId)
+                    ->where('status', TicketStatus::Called)
+                    ->orderByDesc('called_at')
+                    ->orderByDesc('id')
+                    ->limit(3)
+                    ->get();
+
+                $hasWaitingNormal = Ticket::query()
+                    ->where('queue_id', $queueId)
+                    ->where('status', TicketStatus::Waiting)
+                    ->where('priority', 0)
+                    ->exists();
+
+                if (
+                    $recentCalled->count() === 3
+                    && $recentCalled->every(fn (Ticket $ticket): bool => $ticket->priority > 0)
+                    && $hasWaitingNormal
+                ) {
+                    $restrictToNormal = true;
+                }
+            }
+
+            // Build the candidate id list in deterministic order.
+            $query = Ticket::query()
+                ->where('queue_id', $queueId)
+                ->where('status', TicketStatus::Waiting);
+
+            if ($mode === CallMode::PriorityOnly) {
+                $query->where('priority', '>', 0);
+            } elseif ($mode === CallMode::NormalOnly) {
+                $query->where('priority', 0);
+            } elseif ($restrictToNormal) {
+                $query->where('priority', 0);
+            }
+
+            if ($mode === CallMode::NormalOnly || $restrictToNormal) {
+                $query->orderBy('issued_at')->orderBy('id');
+            } else {
+                $query->orderByDesc('priority')->orderBy('issued_at')->orderBy('id');
+            }
+
+            $candidateIds = $query->pluck('id');
+
+            foreach ($candidateIds as $candidateId) {
+                $ticket = Ticket::query()
+                    ->whereKey($candidateId)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+
+            throw new NoWaitingTicketsException('No waiting tickets eligible for the requested call mode.');
+        });
+    }
+}
