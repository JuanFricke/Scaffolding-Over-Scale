diff --git a/tests/Feature/EmailVerificationTest.php b/tests/Feature/EmailVerificationTest.php
new file mode 100644
index 0000000..c1547fe
--- /dev/null
+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,60 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user, ?string $hash = null, ?int $id = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $id ?? $user->getKey(),
+        'hash' => $hash ?? sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('the notification points to the verification route', function () {
+    $user = User::factory()->unverified()->create();
+
+    $mail = (new VerifyEmail)->toMail($user);
+
+    expect($mail->actionUrl)->toContain("/email/verify/{$user->id}/".sha1($user->email));
+});
+
+test('the logged-in user is verified with a valid link', function () {
+    Event::fake([Verified::class]);
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($user))->assertRedirect('/');
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeTrue();
+    Event::assertDispatched(Verified::class);
+});
+
+test('a wrong hash is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($user, hash: sha1('other@example.com')))->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('another user id is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($other))->assertForbidden();
+
+    expect($other->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $url = route('verification.verify', ['id' => $user->id, 'hash' => sha1($user->email)]);
+
+    $this->actingAs($user)->get($url)->assertForbidden();
+});
diff --git a/tests/Feature/PasswordResetTest.php b/tests/Feature/PasswordResetTest.php
new file mode 100644
index 0000000..bb04b9b
--- /dev/null
+++ b/tests/Feature/PasswordResetTest.php
@@ -0,0 +1,126 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password form renders', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('name="email"', false)
+        ->assertSee('for="email"', false);
+});
+
+test('a reset link is sent to an existing user', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->from(route('password.request'))
+        ->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown address gets the same response and no mail', function () {
+    Notification::fake();
+
+    $this->from(route('password.request'))
+        ->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('the reset link request validates the e-mail', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+
+    $this->post(route('password.email'), [])
+        ->assertSessionHasErrors('email');
+});
+
+test('the reset link request is throttled', function () {
+    for ($i = 0; $i < 6; $i++) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertStatus(429);
+});
+
+test('the reset form renders with a single e-mail input', function () {
+    $this->get(route('password.reset', ['token' => 'abc', 'email' => 'a@example.com']))
+        ->assertOk()
+        ->assertSee('value="a@example.com"', false)
+        ->assertSee('name="token"', false)
+        ->assertSee('value="abc"', false);
+
+    expect(substr_count($this->get(route('password.reset', 'abc'))->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('the password can be reset with a valid token', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old-token']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPassw0rd',
+        'password_confirmation' => 'NewPassw0rd',
+    ])
+        ->assertRedirect('/')
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NewPassw0rd', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token');
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token does not reset the password', function () {
+    $user = User::factory()->create();
+    $old = $user->password;
+
+    $this->post(route('password.update'), [
+        'token' => 'invalid',
+        'email' => $user->email,
+        'password' => 'NewPassw0rd',
+        'password_confirmation' => 'NewPassw0rd',
+    ])->assertSessionHasErrors('email');
+
+    expect($user->refresh()->password)->toBe($old);
+});
+
+test('the new password must be strong and confirmed', function (string $password, ?string $confirmation) {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => Password::createToken($user),
+        'email' => $user->email,
+        'password' => $password,
+        'password_confirmation' => $confirmation ?? $password,
+    ])->assertSessionHasErrors('password');
+})->with([
+    'too short' => ['Ab1', null],
+    'no numbers' => ['Abcdefghij', null],
+    'no letters' => ['12345678', null],
+    'no mixed case' => ['abcdefg1', null],
+    'not confirmed' => ['NewPassw0rd', 'Different1'],
+]);
+
+test('guests-only routes redirect authenticated users', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('password.request'))->assertRedirect();
+});
