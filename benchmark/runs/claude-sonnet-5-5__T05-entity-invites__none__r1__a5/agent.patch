@@ -0,0 +1,111 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    /**
+     * Render an <hr> above the list (onboarding box); never rendered when empty.
+     */
+    #[Locked]
+    public bool $divider = false;
+
+    public function accept($inviteId): void
+    {
+        $user = $this->invitee();
+        $invite = EntityInvite::with('entity')->findOrFail($inviteId);
+
+        $this->authorizeInvitee($user, $invite);
+
+        // Idempotent: a double click or a second tab must not error or duplicate anything.
+        if ($invite->isAccepted()) {
+            return;
+        }
+
+        if ($invite->isExpired()) {
+            $this->addError('invite', __('ui.invite_expired'));
+
+            return;
+        }
+
+        DB::transaction(function () use ($user, $invite) {
+            $locked = EntityInvite::whereKey($invite->id)->lockForUpdate()->first();
+
+            if (! $locked || $locked->isAccepted()) {
+                return;
+            }
+
+            // The owner role is never granted through an invite.
+            $role = $locked->role === UserRole::Owner ? UserRole::Employee : $locked->role;
+
+            EntityMembership::firstOrCreate(
+                ['entity_id' => $locked->entity_id, 'user_id' => $user->id],
+                ['role' => $role->value],
+            );
+
+            $locked->update(['accepted_at' => now()]);
+        });
+
+        Log::channel('audit')->info('Invite accepted', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $user->id,
+            'invite_id' => $invite->id,
+        ]);
+
+        session(['current_entity_id' => $invite->entity_id]);
+
+        $this->redirect(route('entity.dashboard', $invite->entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $user = $this->invitee();
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorizeInvitee($user, $invite);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $user->id,
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        $user = auth()->user();
+
+        // An unverified address proves nothing about who owns it.
+        $invites = $user?->hasVerifiedEmail()
+            ? EntityInvite::with('entity')->pending()->forEmail($user->email)->latest('id')->get()
+            : collect();
+
+        return view('livewire.entity.pending-invites', ['invites' => $invites]);
+    }
+
+    protected function invitee(): User
+    {
+        $user = auth()->user();
+
+        abort_unless($user instanceof User && $user->hasVerifiedEmail(), 403);
+
+        return $user;
+    }
+
+    protected function authorizeInvitee(User $user, EntityInvite $invite): void
+    {
+        abort_unless($invite->email === mb_strtolower(trim($user->email)), 403);
+    }
+}
