diff --git a/tests/Feature/Entity/InvitesTest.php b/tests/Feature/Entity/InvitesTest.php
new file mode 100644
index 0000000..583fe5d
--- /dev/null
+++ b/tests/Feature/Entity/InvitesTest.php
@@ -0,0 +1,183 @@
+<?php
+
+use App\Livewire\Entity\PendingInvites;
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('invite e-mails are normalized by the model and unique per entity', function () {
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => '  Foo@Example.COM ']);
+
+    expect($invite->fresh()->email)->toBe('foo@example.com')
+        ->and($invite->role)->toBe(UserRole::Employee)
+        ->and($entity->invites()->count())->toBe(1);
+
+    expect(fn () => EntityInvite::factory()->for($entity)->create(['email' => 'FOO@example.com']))
+        ->toThrow(QueryException::class);
+});
+
+test('factory defaults and the expired state', function () {
+    $pending = EntityInvite::factory()->create();
+    $expired = EntityInvite::factory()->expired()->create();
+
+    expect($pending->isPending())->toBeTrue()
+        ->and($expired->isPending())->toBeFalse()
+        ->and(EntityInvite::pending()->count())->toBe(1);
+});
+
+test('deleting an entity cascades its invites', function () {
+    $invite = EntityInvite::factory()->create();
+    $invite->entity->forceDelete();
+
+    expect(EntityInvite::count())->toBe(0);
+});
+
+test('the pending list matches the e-mail case-insensitively and hides expired or foreign invites', function () {
+    $user = User::factory()->create(['email' => 'Ana@Example.com']);
+    $mine = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+    EntityInvite::factory()->expired()->create(['email' => 'ana@example.com']);
+    $other = EntityInvite::factory()->create(['email' => 'bia@example.com']);
+
+    Livewire::actingAs($user)->test(PendingInvites::class)
+        ->assertSee($mine->entity->name)
+        ->assertDontSee($other->entity->name);
+});
+
+test('the invitee accepts: membership with the invite role, accepted_at, tenant session, redirect', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com', 'role' => 'admin']);
+
+    Livewire::actingAs($user)->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', $invite->entity->slug));
+
+    $membership = EntityMembership::where('entity_id', $invite->entity_id)->where('user_id', $user->id)->first();
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull()
+        ->and(session('current_entity_id'))->toBe($invite->entity_id);
+});
+
+test('accepting twice is an idempotent no-op', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    $component = Livewire::actingAs($user)->test(PendingInvites::class)->call('accept', $invite->id);
+    $component->call('accept', $invite->id)->assertHasNoErrors();
+
+    expect(EntityMembership::where('user_id', $user->id)->count())->toBe(1);
+});
+
+test('accepting an expired invite errors on the invite key and creates nothing', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->expired()->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($user)->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasErrors('invite');
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+test('accepting an invite never duplicates an existing membership', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
