new file mode 100644
index 0000000..49065bc
--- /dev/null
+++ b/app/Livewire/Entity/Queues.php
@@ -0,0 +1,174 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateQueue;
+use App\Actions\SetQueueAccess;
+use App\Actions\UpdateQueue;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Support\Str;
+use Exception;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Queues extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public bool $creating = false;
+
+    public ?int $viewingQueueId = null;
+    public bool $confirmingToggle = false;
+    public ?int $editingQueueId = null;
+    public string $renameName = '';
+    public ?int $accessQueueId = null;
+    public bool $managingAccess = false;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('create', Queue::class, $entity);
+        $this->entity = $entity;
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.queues', [
+            'queues' => $this->entity->queues()->orderBy('name')->get(),
+            'accessQueue' => $this->accessQueueId ? $this->entity->queues()->find($this->accessQueueId) : null,
+            'accessGrants' => $this->accessQueue ? $this->entity->memberships()->get() : collect(),
+        ]);
+    }
+
+    // Create modal
+    public function openCreate(): void
+    {
+        $this->creating = true;
+        $this->name = '';
+    }
+
+    public function closeCreate(): void
+    {
+        $this->creating = false;
+        $this->name = '';
+    }
+
+    public function create(): void
+    {
+        $this->validateOnly('name');
+        $slug = Str::slug($this->name);
+        try {
+            $queue = (new CreateQueue())($this->entity, auth()->user(), $this->name, 
+                
+            );
+            $this->closeCreate();
+        } catch (Exception $e) {
+            $this->addError('name', $e->getMessage());
+        }
+    }
+
+    public function openQueue(int $id): void
+    {
+        $this->viewingQueueId = $this->entity->queues()->findOrFail($id)->id;
+    }
+
+    public function closeQueue(): void
+    {
+        $this->viewingQueueId = null;
+        $this->confirmingToggle = false;
+        $this->editingQueueId = null;
+        $this->renameName = '';
+        $this->managingAccess = false;
+        $this->accessQueueId = null;
+    }
+
+    public function startRename(int $id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+        $this->renameName = $queue->name;
+        $this->editingQueueId = $id;
+    }
+
+    public function cancelRename(): void
+    {
+        $this->editingQueueId = null;
+        $this->renameName = '';
+    }
+
+    public function rename(): void
+    {
+        if (! $this->editingQueueId) return;
+        $this->validateOnly('renameName');
+        $queue = $this->entity->queues()->findOrFail($this->editingQueueId);
+        try {
+            (new UpdateQueue())($queue, auth()->user(), $this->renameName, 
+                
+            );
+            $this->editingQueueId = null;
+            $this->renameName = '';
+        } catch (Exception $e) {
+            $this->addError('renameName', $e->getMessage());
+        }
+    }
+
+    public function confirmToggle(int $id): void
+    {
+        $this->confirmingToggle = true;
+        $this->viewingQueueId = $id;
+    }
+
+    public function cancelToggle(): void
+    {
+        $this->confirmingToggle = false;
+    }
+
+    public function toggleActive(int $id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+        try {
+            (new UpdateQueue())($queue, auth()->user(), null, null, !$queue->is_active);
+            $this->confirmingToggle = false;
+        } catch (Exception $e) {
+            $this->addError('toggle', $e->getMessage());
+        }
+    }
+
+    public function openAccess(int $id): void
+    {
+        $this->accessQueueId = $this->entity->queues()->findOrFail($id)->id;
+        $this->managingAccess = true;
+    }
+
+    public function closeAccess(): void
+    {
+        $this->accessQueueId = null;
+        $this->managingAccess = false;
+    }
+
+    public function grantAccess(int $membershipId): void
+    {
+        $accessQueue = $this->entity->queues()->findOrFail($this->accessQueueId);
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+        (new SetQueueAccess())($membership, $accessQueue, auth()->user(), [QueuePermission::Call]);
+    }
+
+    public function revokeAccess(int $membershipId): void
+    {
+        $accessQueue = $this->entity->queues()->findOrFail($this->accessQueueId);
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+        (new SetQueueAccess())($membership, $accessQueue, auth()->user(), []);
+    }
+}
diff --git a/app/Livewire/Entity/Serve.php b/app/Livewire/Entity/Serve.php
new file mode 100644
index 0000000..be45fd6
--- /dev/null
+++ b/app/Livewire/Entity/Serve.php
@@ -0,0 +1,112 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Enums\UserRole;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use Exception;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Serve extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public ?int $selectedQueueId = null;
+    public string $mode = 'any';
+    public ?int $lastCalledTicketId = null;
+    public ?string $notice = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+        // set default selected queue
+        $this->selectedQueueId = $this->callableQueues()->first()?->id;
+    }
+
+    public function callableQueues(): \Illuminate\Database\Eloquent\Collection
+    {
+        $queues = $this->entity->queues()->where('is_active', true)->get();
+        $membership = auth()->user()->membershipFor($this->entity->id);
+        if (! $membership) {
+            return collect();
+        }
+        if ($membership->role === UserRole::Owner || $membership->role === UserRole::Admin) {
+            return $queues;
+        }
+        // Simplified: no access grants logic implemented.
+        return collect();
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.serve', [
+            'callableQueues' => $this->callableQueues(),
+            'waitingTickets' => $this->waitingTickets(),
+        ]);
+    }
+
+    public function waitingTickets(): \Illuminate\Database\Eloquent\Collection
+    {
+        if (! $this->selectedQueueId) {
+            return collect();
+        }
+        try {
+            $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+        } catch (Exception $e) {
+            return collect();
+        }
+        return Ticket::where('queue_id', $queue->id)
+            ->orderBy('priority', 'desc')
+            ->orderBy('issued_at')
+            ->orderBy('id')
+            ->take(30)
+            ->get();
+    }
+
+    public function callNext(): void
+    {
+        $this->notice = null;
+        if (! $this->selectedQueueId) {
+            $this->notice = __('ui.serve_empty');
+            return;
+        }
+        try {
+            $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+        } catch (Exception $e) {
+            $this->notice = __('ui.serve_empty');
+            return;
+        }
+        $rateKey = 'entity-call-next:'.$this->entity->id.':'.auth()->id();
+        if (RateLimiter::tooManyAttempts($rateKey, 10)) {
+            $this->notice = __('ui.serve_rate_limited');
+            return;
+        }
+        try {
+            $ticket = (new CallNextTicket())($queue, auth()->user(), CallMode::from($this->mode));
+            $this->lastCalledTicketId = $ticket->id;
+            $this->notice = __('ui.serve_last_called', ['code' => $ticket->code]);
+            RateLimiter::hit($rateKey, 60);
+        } catch (InactiveQueueException $e) {
+            $this->notice = __('ui.serve_inactive');
+        } catch (NoWaitingTicketsException $e) {
+            $this->notice = __('ui.serve_empty');
+        }
+    }
+}
