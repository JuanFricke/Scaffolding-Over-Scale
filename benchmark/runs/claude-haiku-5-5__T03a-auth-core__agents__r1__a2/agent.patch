+test('the login page renders in pt-BR by default', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeLivewire(Login::class)
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('the login page renders in English without Portuguese when the locale is en', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu');
+});
+
+test('authenticated users visiting login are redirected home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('a valid login authenticates the user and redirects home', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('the e-mail is matched regardless of letter case', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com', 'password' => 'Secret123']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'Staff@Example.COM')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('remember me provisions a remember token for the account', function () {
+    $user = User::factory()->create(['password' => 'Secret123', 'remember_token' => null]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Secret123')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect($user->refresh()->remember_token)->not->toBeNull();
+});
+
+test('wrong credentials raise the auth.failed message on email and keep the guest guest', function () {
+    User::factory()->create(['email' => 'staff@example.com', 'password' => 'Secret123']);
+
+    $component = Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'wrong-password')
+        ->call('submit');
+
+    $component->assertHasErrors(['email'])
+        ->assertSet('password', '');
+
+    expect($component->errors()->first('email'))->toBe(__('auth.failed'));
+    $this->assertGuest();
+});
+
+test('a malformed e-mail is rejected by validation before any credential check', function () {
+    $component = Livewire::test(Login::class)
+        ->set('email', 'javascript:alert(1)')
+        ->set('password', 'Secret123')
+        ->call('submit');
+
+    $component->assertHasErrors(['email' => 'email']);
+    $this->assertGuest();
+});
+
+test('five failed attempts lock out the e-mail and IP with the auth.throttle message', function () {
+    User::factory()->create(['email' => 'staff@example.com', 'password' => 'Secret123']);
+
+    $component = Livewire::test(Login::class);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component->set('email', 'staff@example.com')->set('password', 'wrong-password')->call('submit');
+        expect($component->errors()->first('email'))->toBe(__('auth.failed'));
+    }
+
+    $component->set('email', 'staff@example.com')->set('password', 'Secret123')->call('submit');
+
+    expect($component->errors()->first('email'))->toStartWith('Muitas tentativas de login.');
+    $this->assertGuest();
+});
+
+test('the lockout is scoped to the e-mail, so other accounts still get auth.failed', function () {
+    User::factory()->create(['email' => 'staff@example.com', 'password' => 'Secret123']);
+
+    $component = Livewire::test(Login::class);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component->set('email', 'staff@example.com')->set('password', 'wrong-password')->call('submit');
+    }
+
+    $component->set('email', 'other@example.com')->set('password', 'wrong-password')->call('submit');
+
+    expect($component->errors()->first('email'))->toBe(__('auth.failed'));
+});
+
+test('failed logins go to the audit channel without the e-mail address', function () {
+    $audit = Mockery::mock();
+    $audit->shouldReceive('info')
+        ->once()
+        ->withArgs(fn (string $message, array $context) => ! str_contains(json_encode($context), 'ghost@example.com'));
+
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ghost@example.com')
+        ->set('password', 'Secret123')
+        ->call('submit');
+});
+
+test('an authenticated user cannot submit the login form to switch accounts', function () {
+    $current = User::factory()->create(['password' => 'Secret123']);
+    $other = User::factory()->create(['password' => 'Secret123']);
+
+    Livewire::actingAs($current)
+        ->test(Login::class)
+        ->set('email', $other->email)
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect(Auth::id())->toBe($current->id);
+});
diff --git a/tests/Feature/Auth/LogoutTest.php b/tests/Feature/Auth/LogoutTest.php
new file mode 100644
index 0000000..cbc7921
--- /dev/null
+++ b/tests/Feature/Auth/LogoutTest.php
@@ -0,0 +1,33 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('authenticated users can log out and are sent to login', function () {
+    $this->actingAs(User::factory()->create())
+        ->post(route('logout'))
+        ->assertRedirect(route('login'));
+
+    $this->assertGuest();
+});
+
+test('logging out regenerates the CSRF token', function () {
+    $this->actingAs(User::factory()->create())
+        ->withSession(['_token' => 'token-before-logout'])
+        ->post(route('logout'))
+        ->assertRedirect(route('login'));
+
+    expect(session()->token())->not->toBe('token-before-logout');
+});
+
+test('guests cannot log out and are sent to login', function () {
+    $this->post(route('logout'))->assertRedirect(route('login'));
+});
+
+test('logout is only available over POST', function () {
+    $this->actingAs(User::factory()->create())
+        ->get('/logout')
+        ->assertStatus(405);
+});
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..43edaa6
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,139 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password form posts to the named route', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('Esqueceu a senha?')
+        ->assertSee(route('password.email'), false);
+});
+
+test('a reset link is sent to an existing user with the generic status', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown e-mail gets the same status and no mail is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('malformed e-mails are rejected by validation', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+});
+
+test('the forgot password endpoint is throttled to six requests per minute', function () {
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('password.email'), ['email' => 'ghost@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])->assertStatus(429);
+});
+
+test('the reset form asks for the e-mail exactly once', function () {
+    $response = $this->get(route('password.reset', ['token' => 'abc123', 'email' => 'ana@example.com']))
+        ->assertOk();
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('a valid token resets the password, rotates remember_token and redirects to login', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create(['password' => 'OldSecret123']);
+    $user->setRememberToken('remember-before-reset');
+    $user->save();
+
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewSecret123', $user->password))->toBeTrue()
+        ->and($user->getRememberToken())->not->toBe('remember-before-reset');
+
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token is rejected and the password is unchanged', function () {
+    $user = User::factory()->create(['password' => 'OldSecret123']);
+
+    $this->post(route('password.update'), [
+        'token' => 'forged-token',
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect(Hash::check('OldSecret123', $user->refresh()->password))->toBeTrue();
+});
+
+test('a token issued to one user cannot reset a different e-mail', function () {
+    $owner = User::factory()->create(['password' => 'OldSecret123']);
+    $victim = User::factory()->create(['password' => 'OldSecret123']);
+
+    $token = Password::broker()->createToken($owner);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $victim->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors('email');
+
+    expect(Hash::check('OldSecret123', $victim->refresh()->password))->toBeTrue();
+});
+
+test('the new password must follow the default password rule', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'weak',
+        'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+});
+
+test('a mismatched password confirmation is rejected on password', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'Different123',
+    ])->assertSessionHasErrors('password');
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..c3a4235
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,127 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function registrationData(array $overrides = []): array
+{
+    return array_merge([
+        'name' => 'Ana Souza',
+        'email' => 'ana@example.com',
+        'password' => 'Secret123',
+        'password_confirmation' => 'Secret123',
+    ], $overrides);
+}
+
+function fillRegistration($component, array $data)
+{
+    foreach ($data as $field => $value) {
+        $component->set($field, $value);
+    }
+
+    return $component;
+}
+
+test('the register page renders in pt-BR for guests', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSeeLivewire(Register::class)
+        ->assertSee('Criar conta');
+});
+
+test('registering creates an unverified user, sends the verification mail and logs them in', function () {
+    Notification::fake();
+
+    fillRegistration(Livewire::test(Register::class), registrationData())
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'ana@example.com')->firstOrFail();
+
+    expect($user->name)->toBe('Ana Souza')
+        ->and($user->email_verified_at)->toBeNull();
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+    $this->assertAuthenticatedAs($user);
+});
+
+test('the e-mail is stored in lowercase', function () {
+    Notification::fake();
+
+    fillRegistration(Livewire::test(Register::class), registrationData(['email' => 'Ana@Example.COM']))
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect(User::where('email', 'ana@example.com')->exists())->toBeTrue();
+});
+
+test('passwords must follow the app-wide default rule', function () {
+    $component = fillRegistration(Livewire::test(Register::class), registrationData([
+        'password' => 'abcdefgh',
+        'password_confirmation' => 'abcdefgh',
+    ]))->call('submit');
+
+    $component->assertHasErrors(['password']);
+    expect(User::count())->toBe(0);
+});
+
+test('a mismatched password confirmation fails the confirmed rule on password', function () {
+    $component = fillRegistration(Livewire::test(Register::class), registrationData([
+        'password_confirmation' => 'Other12345',
+    ]))->call('submit');
+
+    $component->assertHasErrors(['password' => 'confirmed']);
+    expect(User::count())->toBe(0);
+});
+
+test('a duplicate e-mail is rejected on email', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    fillRegistration(Livewire::test(Register::class), registrationData())
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+});
+
+test('five registration attempts from one IP exhaust the limiter and error on email', function () {
+    $component = Livewire::test(Register::class);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component->call('submit');
+    }
+
+    $component->call('submit');
+
+    expect($component->errors()->first('email'))->toStartWith('Muitas tentativas de login.');
+    expect(User::count())->toBe(0);
+});
+
+test('an authenticated user cannot register another account through the form', function () {
+    Notification::fake();
+    $current = User::factory()->create();
+
+    Livewire::actingAs($current)
+        ->test(Register::class)
+        ->set('name', 'Intruso')
+        ->set('email', 'intruso@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect(User::where('email', 'intruso@example.com')->exists())->toBeFalse();
+});
+
+test('an oversized name is rejected by validation', function () {
+    fillRegistration(Livewire::test(Register::class), registrationData(['name' => str_repeat('A', 300)]))
+        ->call('submit')
+        ->assertHasErrors(['name' => 'max']);
+
+    expect(User::count())->toBe(0);
+});
