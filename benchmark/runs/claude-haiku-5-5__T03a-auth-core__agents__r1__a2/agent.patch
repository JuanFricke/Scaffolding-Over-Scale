diff --git a/tests/Feature/Auth/AuthConfigurationTest.php b/tests/Feature/Auth/AuthConfigurationTest.php
new file mode 100644
index 0000000..ba372f2
--- /dev/null
+++ b/tests/Feature/Auth/AuthConfigurationTest.php
@@ -0,0 +1,59 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Contracts\Auth\MustVerifyEmail;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Facades\File;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rules\Password;
+
+test('the test suite runs with the pt_BR locale and en fallback', function () {
+    expect(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('phpunit pins the locale variables', function () {
+    $phpunit = file_get_contents(base_path('phpunit.xml'));
+
+    expect($phpunit)->toContain('<env name="APP_LOCALE" value="pt_BR"/>')
+        ->and($phpunit)->toContain('<env name="APP_FALLBACK_LOCALE" value="en"/>');
+});
+
+test('.env.example ships the PegaFila name and the pt_BR locale', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)->toContain('APP_NAME=PegaFila')
+        ->and($env)->toContain('APP_LOCALE=pt_BR')
+        ->and($env)->toContain('APP_FALLBACK_LOCALE=en');
+});
+
+test('users must verify their e-mail', function () {
+    expect(new User)->toBeInstanceOf(MustVerifyEmail::class);
+});
+
+test('the app-wide password default requires 8 characters with letters, mixed case and numbers', function () {
+    $rules = ['password' => [Password::defaults()]];
+
+    expect(Validator::make(['password' => 'Abcdefg1'], $rules)->passes())->toBeTrue()
+        ->and(Validator::make(['password' => 'Abcde1'], $rules)->fails())->toBeTrue()
+        ->and(Validator::make(['password' => 'abcdefg1'], $rules)->fails())->toBeTrue()
+        ->and(Validator::make(['password' => 'Abcdefgh'], $rules)->fails())->toBeTrue();
+});
+
+test('the ui translations have the same keys in en and pt_BR', function () {
+    $en = Arr::dot(require lang_path('en/ui.php'));
+    $ptBr = Arr::dot(require lang_path('pt_BR/ui.php'));
+
+    expect(array_keys($ptBr))->toEqual(array_keys($en));
+});
+
+test('no view hardcodes a root-relative href or form action', function () {
+    $offenders = collect(File::allFiles(resource_path('views')))
+        ->filter(fn (SplFileInfo $file) => str_ends_with($file->getFilename(), '.blade.php'))
+        ->filter(fn (SplFileInfo $file) => preg_match('/(href|action)="\//', file_get_contents($file->getPathname())))
+        ->map(fn (SplFileInfo $file) => $file->getPathname())
+        ->values()
+        ->all();
+
+    expect($offenders)->toBe([]);
+});
diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..13d6258
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,127 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function signedVerificationUrl(User $user, ?int $id = null, ?string $hash = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $id ?? $user->getKey(),
+        'hash' => $hash ?? sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('the verification notice is shown to unverified users', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee('Verifique seu e-mail')
+        ->assertSee(route('verification.send'), false);
+});
+
+test('verified users visiting the notice are sent home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('home'));
+});
+
+test('guests are sent to login from the verification notice', function () {
+    $this->get(route('verification.notice'))->assertRedirect(route('login'));
+});
+
+test('a signed link verifies the logged-in user and redirects home', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user))
+        ->assertRedirect(route('home'));
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link whose id was tampered with returns 403 and verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user, id: $other->getKey()))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link with a wrong hash returns 403', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user, hash: sha1('someone-else@example.com')))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned verification link returns 403', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('the verification link requires a logged-in user', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->get(signedVerificationUrl($user))->assertRedirect(route('login'));
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('resending sends the verification mail and flashes the status', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect()
+        ->assertSessionHas('status');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('resending for an already verified user sends nothing and redirects home', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('resending is throttled to six requests per minute', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->actingAs($user)->post(route('verification.send'))->assertRedirect();
+    }
+
+    $this->actingAs($user)->post(route('verification.send'))->assertStatus(429);
+});
+
+test('guests cannot resend a verification mail', function () {
+    Notification::fake();
+
+    $this->post(route('verification.send'))->assertRedirect(route('login'));
+
+    Notification::assertNothingSent();
+});
