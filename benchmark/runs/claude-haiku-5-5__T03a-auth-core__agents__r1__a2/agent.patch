diff --git a/app/Livewire/Auth/Login.php b/app/Livewire/Auth/Login.php
new file mode 100644
index 0000000..fe07c5b
--- /dev/null
+++ b/app/Livewire/Auth/Login.php
@@ -0,0 +1,82 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('components.layouts.auth')]
+class Login extends Component
+{
+    private const MAX_ATTEMPTS = 5;
+
+    private const DECAY_SECONDS = 60;
+
+    #[Validate('required|string|email:rfc,strict|max:255')]
+    public string $email = '';
+
+    #[Validate('required|string')]
+    public string $password = '';
+
+    public bool $remember = false;
+
+    /**
+     * Authenticate the staff member and redirect to the intended page (or home).
+     */
+    public function submit(): void
+    {
+        $this->resetErrorBag();
+
+        if (Auth::check()) {
+            $this->redirectRoute('home');
+
+            return;
+        }
+
+        $this->email = Str::lower(trim($this->email));
+        $this->validate();
+
+        $throttleKey = $this->throttleKey();
+
+        if (RateLimiter::tooManyAttempts($throttleKey, self::MAX_ATTEMPTS)) {
+            Log::channel('audit')->warning('Login locked out', ['ip' => request()->ip()]);
+
+            $this->addError('email', __('auth.throttle', ['seconds' => RateLimiter::availableIn($throttleKey)]));
+
+            return;
+        }
+
+        if (! Auth::attempt(['email' => $this->email, 'password' => $this->password], $this->remember)) {
+            RateLimiter::hit($throttleKey, self::DECAY_SECONDS);
+            Log::channel('audit')->info('Login failed', ['ip' => request()->ip()]);
+
+            $this->reset('password');
+            $this->addError('email', __('auth.failed'));
+
+            return;
+        }
+
+        RateLimiter::clear($throttleKey);
+        session()->regenerate();
+
+        $this->redirectIntended(route('home'));
+    }
+
+    /**
+     * Rate-limit key per (lowercase e-mail, IP), so one account cannot lock out another.
+     */
+    private function throttleKey(): string
+    {
+        return Str::transliterate(Str::lower($this->email).'|'.request()->ip());
+    }
+
+    public function render()
+    {
+        return view('livewire.auth.login')->title(__('ui.login.title'));
+    }
+}
