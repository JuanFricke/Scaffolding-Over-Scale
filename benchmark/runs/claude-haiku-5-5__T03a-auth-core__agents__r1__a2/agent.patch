@@ -0,0 +1,88 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rules\Password;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('components.layouts.auth')]
+class Register extends Component
+{
+    private const MAX_ATTEMPTS = 5;
+
+    private const DECAY_SECONDS = 60;
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    #[Validate('required|string|email:rfc,strict|max:255|unique:users,email')]
+    public string $email = '';
+
+    public string $password = '';
+
+    public string $password_confirmation = '';
+
+    /**
+     * Password rules come from the app-wide default (Password::defaults()).
+     *
+     * @return array<string, array<int, mixed>>
+     */
+    protected function rules(): array
+    {
+        return [
+            'password' => ['required', 'confirmed', Password::defaults()],
+        ];
+    }
+
+    /**
+     * Create the staff account, log it in and send the verification mail.
+     */
+    public function submit(): void
+    {
+        $this->resetErrorBag();
+
+        if (Auth::check()) {
+            $this->redirectRoute('home');
+
+            return;
+        }
+
+        $rateLimitKey = str()->transliterate('register|'.request()->ip());
+
+        if (RateLimiter::tooManyAttempts($rateLimitKey, self::MAX_ATTEMPTS)) {
+            $this->addError('email', __('auth.throttle', ['seconds' => RateLimiter::availableIn($rateLimitKey)]));
+
+            return;
+        }
+
+        RateLimiter::hit($rateLimitKey, self::DECAY_SECONDS);
+
+        $this->email = Str::lower(trim($this->email));
+        $this->validate();
+
+        $user = User::create([
+            'name' => $this->name,
+            'email' => $this->email,
+            'password' => $this->password,
+        ]);
+
+        event(new Registered($user));
+
+        Auth::login($user);
+        session()->regenerate();
+
+        $this->redirectRoute('home');
+    }
+
+    public function render()
+    {
+        return view('livewire.auth.register')->title(__('ui.register.title'));
+    }
+}
