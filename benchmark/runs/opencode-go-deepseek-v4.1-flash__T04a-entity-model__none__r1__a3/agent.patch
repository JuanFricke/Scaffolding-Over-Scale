@@ -0,0 +1,50 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the same entity may view a membership.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Owners and admins of the entity may assign roles.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->isOwnerOrAdminOf($user, $membership);
+    }
+
+    /**
+     * The owner's membership can never be deleted. A member may always remove
+     * themselves; otherwise only an owner or admin of the entity may delete it.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->getKey()) {
+            return true;
+        }
+
+        return $this->isOwnerOrAdminOf($user, $membership);
+    }
+
+    private function isOwnerOrAdminOf(User $user, EntityMembership $membership): bool
+    {
+        $role = $user->membershipFor($membership->entity_id)?->role;
+
+        return in_array($role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
