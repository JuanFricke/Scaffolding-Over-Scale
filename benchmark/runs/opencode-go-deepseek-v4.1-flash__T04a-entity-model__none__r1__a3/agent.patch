+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('creates entities with a unique slug and binds them by slug', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->name)->not->toBeEmpty()
+        ->and($entity->slug)->not->toBeEmpty()
+        ->and($entity->getRouteKeyName())->toBe('slug');
+});
+
+it('creates memberships with their entity and user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
