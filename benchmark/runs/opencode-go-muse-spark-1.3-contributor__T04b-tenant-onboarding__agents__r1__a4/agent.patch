@@ -0,0 +1,72 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class EnsureCurrentEntity
+{
+    /**
+     * Handle an incoming request.
+     *
+     * @param  Closure(Request): (Response)  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        if ($user === null) {
+            return $next($request);
+        }
+
+        $sessionEntityId = $request->session()->get('current_entity_id');
+
+        if ($sessionEntityId !== null) {
+            $membership = $user->membershipFor((int) $sessionEntityId);
+
+            if ($membership === null) {
+                abort(403);
+            }
+
+            $entity = Entity::find($sessionEntityId);
+
+            if ($entity === null) {
+                abort(403);
+            }
+
+            $this->setTenantContext($request, $entity);
+
+            return $next($request);
+        }
+
+        $memberships = $user->memberships()->get();
+
+        if ($memberships->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($memberships->count() === 1) {
+            $entityId = $memberships->firstOrFail()->entity_id;
+            $request->session()->put('current_entity_id', $entityId);
+
+            $entity = Entity::find($entityId);
+
+            if ($entity !== null) {
+                $this->setTenantContext($request, $entity);
+            }
+
+            return $next($request);
+        }
+
+        return redirect()->route('entity.switcher');
+    }
+
+    protected function setTenantContext(Request $request, Entity $entity): void
+    {
+        $request->attributes->set('current_entity', $entity);
+        app()->instance('current_entity', $entity);
+    }
+}
