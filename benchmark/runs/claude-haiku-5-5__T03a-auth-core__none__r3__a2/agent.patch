+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('login page is shown in portuguese by default', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('login page is shown in english with the en locale', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha');
+});
+
+test('authenticated users are redirected from login to home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('users can log in and are redirected home', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('wrong credentials raise the auth.failed error on email', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')])
+        ->assertSet('password', '');
+
+    $this->assertGuest();
+});
+
+test('the e-mail must be a strict e-mail address', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+});
+
+test('the e-mail is case-insensitive', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ANA@Example.com')
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('login is locked after five failed attempts', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    $component = Livewire::test(Login::class)->set('email', 'ana@example.com');
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component->set('password', 'wrong-password')
+            ->call('submit')
+            ->assertHasErrors(['email' => __('auth.failed')]);
+    }
+
+    $component->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email']);
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas');
+
+    $this->assertGuest();
+});
+
+test('remember me rotates the remember token on login', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com', 'remember_token' => null]);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'password')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect($user->fresh()->remember_token)->not->toBeNull();
+});
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
