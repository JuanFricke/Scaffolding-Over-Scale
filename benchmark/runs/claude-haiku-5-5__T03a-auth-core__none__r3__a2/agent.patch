diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..c43a639
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,109 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrlFor(User $user): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('unverified users see the verification notice', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee('Confirme seu e-mail');
+});
+
+test('verified users are sent from the notice to home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('home'));
+});
+
+test('a signed link verifies the logged-in user and redirects home', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrlFor($user))
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link whose id was tampered with returns 403 and verifies nobody', function () {
+    $owner = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $tampered = str_replace(
+        '/email/verify/'.$owner->getKey().'/',
+        '/email/verify/'.$other->getKey().'/',
+        verificationUrlFor($owner),
+    );
+
+    $this->actingAs($owner)->get($tampered)->assertForbidden();
+
+    expect($owner->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a validly signed link for another user is rejected and verifies nobody', function () {
+    $owner = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($owner)->get(verificationUrlFor($other))->assertForbidden();
+
+    expect($owner->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('verification links require a signature', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->getEmailForVerification())]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('resending sends the verification e-mail and flashes the status', function () {
+    Notification::fake();
+
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('verification.notice'))
+        ->assertSessionHas('status', 'verification-link-sent');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('resending for a verified user sends nothing and redirects home', function () {
+    Notification::fake();
+
+    $this->actingAs(User::factory()->create())
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('resending the verification e-mail is throttled', function () {
+    $user = User::factory()->unverified()->create();
+
+    for ($request = 0; $request < 6; $request++) {
+        $this->actingAs($user)->post(route('verification.send'))->assertRedirect();
+    }
+
+    $this->actingAs($user)->post(route('verification.send'))->assertStatus(429);
+});
