+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('forgot password page is shown in portuguese', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('Esqueci minha senha');
+});
+
+test('a reset link request answers the same whether or not the account exists', function () {
+    Notification::fake();
+
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    $this->post(route('password.email'), ['email' => 'ana@example.com'])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+    Notification::assertSentTimes(ResetPassword::class, 1);
+});
+
+test('the forgot password request is throttled to six per minute', function () {
+    for ($request = 0; $request < 6; $request++) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertStatus(429);
+});
+
+test('the reset form asks for the e-mail exactly once', function () {
+    $response = $this->get(route('password.reset', ['token' => 'token-123', 'email' => 'ana@example.com']));
+
+    $response->assertOk();
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('a valid token resets the password, rotates remember_token and redirects to login', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create(['email' => 'ana@example.com', 'remember_token' => 'old-token']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => 'ana@example.com',
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewSecret123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token');
+
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token is rejected with the token message on e-mail', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    $this->post(route('password.update'), [
+        'token' => 'invalid-token',
+        'email' => 'ana@example.com',
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+});
+
+test('an unknown e-mail gets the same message as an invalid token', function () {
+    $this->post(route('password.update'), [
+        'token' => 'invalid-token',
+        'email' => 'nobody@example.com',
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+});
+
+test('the new password must follow the default rule', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => 'ana@example.com',
+        'password' => 'weak',
+        'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+});
