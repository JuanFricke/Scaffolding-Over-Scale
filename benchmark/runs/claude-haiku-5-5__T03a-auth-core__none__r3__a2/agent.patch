+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Contracts\Auth\MustVerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rules\Password;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+// Fills the register form with valid data, overridden per test.
+function fillRegistrationForm($component, array $overrides = [])
+{
+    foreach (array_merge([
+        'name' => 'Ana Souza',
+        'email' => 'ana@example.com',
+        'password' => 'Secret123',
+        'password_confirmation' => 'Secret123',
+    ], $overrides) as $property => $value) {
+        $component->set($property, $value);
+    }
+
+    return $component;
+}
+
+test('user model must verify e-mail', function () {
+    expect(new User)->toBeInstanceOf(MustVerifyEmail::class);
+});
+
+test('register page is shown in portuguese by default', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSee('Criar conta');
+});
+
+test('authenticated users are redirected from register to home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
+
+test('users can register, are logged in unverified and receive the verification e-mail', function () {
+    Notification::fake();
+
+    fillRegistrationForm(Livewire::test(Register::class), ['email' => 'ANA@example.com'])
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'ana@example.com')->firstOrFail();
+
+    expect($user->hasVerifiedEmail())->toBeFalse();
+    $this->assertAuthenticatedAs($user);
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('a mismatched confirmation fails with the confirmed rule on password', function () {
+    fillRegistrationForm(Livewire::test(Register::class), ['password_confirmation' => 'Other123'])
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    $this->assertGuest();
+});
+
+test('passwords must follow the default rule', function () {
+    fillRegistrationForm(Livewire::test(Register::class), ['password' => 'short', 'password_confirmation' => 'short'])
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    fillRegistrationForm(Livewire::test(Register::class), ['password' => 'alllowercase1', 'password_confirmation' => 'alllowercase1'])
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    fillRegistrationForm(Livewire::test(Register::class), ['password' => 'NoNumbersHere', 'password_confirmation' => 'NoNumbersHere'])
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('the default password rule is min 8, letters, mixed case and numbers', function () {
+    $rule = Password::defaults();
+
+    expect(Validator::make(['p' => 'Secret123'], ['p' => $rule])->passes())->toBeTrue()
+        ->and(Validator::make(['p' => 'Sec12'], ['p' => $rule])->fails())->toBeTrue()
+        ->and(Validator::make(['p' => 'SECRET123'], ['p' => $rule])->fails())->toBeTrue();
+});
+
+test('the e-mail must be unique', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    fillRegistrationForm(Livewire::test(Register::class))
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+});
+
+test('the e-mail must be a strict e-mail address', function () {
+    fillRegistrationForm(Livewire::test(Register::class), ['email' => 'ana@'])
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+});
+
+test('registration is limited to five attempts per ip', function () {
+    $component = Livewire::test(Register::class);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component->set('name', '')->call('submit')->assertHasErrors(['name' => 'required']);
+    }
+
+    fillRegistrationForm($component)
+        ->call('submit')
+        ->assertHasErrors(['email']);
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas');
+
+    expect(User::count())->toBe(0);
+});
