+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+describe('Ticket Code Generation', function () {
+    it('generates A001 for the first ticket', function () {
+        $queue = Queue::factory()->create();
+        $code = Ticket::nextCode($queue->id);
+        expect($code)->toBe('A001');
+    });
+
+    it('generates A002 after A001', function () {
+        $queue = Queue::factory()->create();
+        Ticket::factory()->forQueue($queue)->create();
+
+        $code = Ticket::nextCode($queue->id);
+        expect($code)->toBe('A002');
+    });
+
+    it('generates A003 after A001 and A002', function () {
+        $queue = Queue::factory()->create();
+        Ticket::factory()->forQueue($queue)->create();
+        Ticket::factory()->forQueue($queue)->create();
+
+        $code = Ticket::nextCode($queue->id);
+        expect($code)->toBe('A003');
+    });
+
+    it('generates A1000 after A999', function () {
+        $queue = Queue::factory()->create();
+        for ($i = 1; $i <= 999; $i++) {
+            Ticket::factory()->forQueue($queue)->create(['code' => 'A'.str_pad($i, 3, '0', STR_PAD_LEFT)]);
+        }
+
+        $code = Ticket::nextCode($queue->id);
+        expect($code)->toBe('A1000');
+    });
+
+    it('generates A1001 after A1000', function () {
+        $queue = Queue::factory()->create();
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+        $code = Ticket::nextCode($queue->id);
+        expect($code)->toBe('A1001');
+    });
+
+    it('skips malformed codes', function () {
+        $queue = Queue::factory()->create();
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+        $code = Ticket::nextCode($queue->id);
+        expect($code)->toBe('A001');
+    });
+
+    it('continues after valid code following malformed code', function () {
+        $queue = Queue::factory()->create();
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+        $code = Ticket::nextCode($queue->id);
+        expect($code)->toBe('A002');
+    });
+
+    it('generates unique codes per queue', function () {
+        $queue1 = Queue::factory()->create();
+        $queue2 = Queue::factory()->create();
+
+        Ticket::factory()->forQueue($queue1)->create();
+
+        $code1 = Ticket::nextCode($queue1->id);
+        $code2 = Ticket::nextCode($queue2->id);
+
+        expect($code1)->toBe('A002');
+        expect($code2)->toBe('A001');
+    });
+});
+
+describe('Issue Ticket Action', function () {
+    it('creates a ticket with default parameters', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket;
+
+        $ticket = $action($queue);
+
+        expect($ticket->queue_id)->toBe($queue->id);
+        expect($ticket->code)->toBe('A001');
+        expect($ticket->priority)->toBe(0);
+        expect($ticket->channel)->toBe(TicketChannel::Virtual);
+        expect($ticket->status)->toBe(TicketStatus::Waiting);
+        expect($ticket->issued_at)->not->toBeNull();
+    });
+
+    it('creates a ticket with custom priority', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket;
+
+        $ticket = $action($queue, 10);
+
+        expect($ticket->priority)->toBe(10);
+    });
+
+    it('creates a ticket with custom channel', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket;
+
+        $ticket = $action($queue, 0, TicketChannel::Totem);
+
+        expect($ticket->channel)->toBe(TicketChannel::Totem);
+    });
+
+    it('rejects negative priority', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket;
+
+        expect(fn () => $action($queue, -1))->toThrow(InvalidArgumentException::class);
+    });
+
+    it('rejects inactive queue', function () {
+        $queue = Queue::factory()->create(['is_active' => false]);
+        $action = new IssueTicket;
+
+        expect(fn () => $action($queue))->toThrow(InactiveQueueException::class);
+    });
+
+    it('rejects queue deactivated after load', function () {
+        $queue = Queue::factory()->create(['is_active' => true]);
+        Queue::find($queue->id)->update(['is_active' => false]);
+
+        $action = new IssueTicket;
+        expect(fn () => $action($queue))->toThrow(InactiveQueueException::class);
+    });
+
+    it('retries on unique constraint collision', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket;
+
+        $ticket1 = $action($queue);
+        $ticket2 = $action($queue);
+
+        expect($ticket1->code)->toBe('A001');
+        expect($ticket2->code)->toBe('A002');
+        expect(Ticket::count())->toBe(2);
+    });
+});
+
+describe('Ticket Immutability', function () {
+    it('allows updating status, called_at, called_by_user_id', function () {
+        $user = User::factory()->create();
+        $ticket = Ticket::factory()->create();
+
+        $ticket->status = TicketStatus::Called;
+        $ticket->called_at = now();
+        $ticket->called_by_user_id = $user->id;
+        $ticket->save();
+
+        $ticket->refresh();
+        expect($ticket->status)->toBe(TicketStatus::Called);
+    });
+
+    it('prevents updating code', function () {
+        $ticket = Ticket::factory()->create(['code' => 'A001']);
+
+        $ticket->code = 'A002';
+        expect(fn () => $ticket->save())->toThrow(LogicException::class);
+    });
+
+    it('prevents updating priority', function () {
+        $ticket = Ticket::factory()->create(['priority' => 0]);
+
+        $ticket->priority = 10;
+        expect(fn () => $ticket->save())->toThrow(LogicException::class);
+    });
