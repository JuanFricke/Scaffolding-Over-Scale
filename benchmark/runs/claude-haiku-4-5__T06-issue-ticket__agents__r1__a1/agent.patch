+        $afterCall = now();
+
+        expect($ticket->called_at)->toBeInstanceOf(DateTime::class);
+        expect($ticket->called_at->getTimestamp())->toBeGreaterThanOrEqual($beforeCall->getTimestamp());
+        expect($ticket->called_at->getTimestamp())->toBeLessThanOrEqual($afterCall->getTimestamp());
