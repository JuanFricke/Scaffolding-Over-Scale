@@ -0,0 +1,102 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    protected $guarded = ['id', 'created_at', 'updated_at'];
+
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    public static function nextCode(int $queueId): string
+    {
+        $tickets = self::where('queue_id', $queueId)
+            ->orderBy('id')
+            ->pluck('code');
+
+        $lastNumber = 0;
+
+        foreach ($tickets as $code) {
+            if (preg_match('/^A(\d+)$/', $code, $matches)) {
+                $lastNumber = (int) $matches[1];
+            }
+        }
+
+        $nextNumber = $lastNumber + 1;
+
+        return 'A'.str_pad($nextNumber, 3, '0', STR_PAD_LEFT);
+    }
+
+    public function call(User $user): void
+    {
+        $this->authorize($user);
+
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new \LogicException('Can only call a waiting ticket');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->save();
+    }
+
+    protected function authorize(User $user): void
+    {
+        $membership = $user->membershipFor($this->queue->entity_id);
+        if (! $membership) {
+            throw new AuthorizationException;
+        }
+    }
+
+    public function saveQuietly(array $options = [])
+    {
+        return parent::saveQuietly($options);
+    }
+
+    public function save(array $options = [])
+    {
+        if ($this->exists && $this->isDirty()) {
+            $mutableFields = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+            $changedFields = array_keys($this->getDirty());
+
+            foreach ($changedFields as $field) {
+                if (! in_array($field, $mutableFields)) {
+                    throw new \LogicException("Cannot modify immutable field: $field");
+                }
+            }
+        }
+
+        return parent::save($options);
+    }
+}
