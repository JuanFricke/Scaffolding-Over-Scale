@@ -0,0 +1,52 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+
+class IssueTicket
+{
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new \InvalidArgumentException('Priority must be non-negative');
+        }
+
+        $maxRetries = 5;
+        $attempt = 0;
+
+        while ($attempt < $maxRetries) {
+            $attempt++;
+
+            $queueRow = Queue::lockForUpdate()->find($queue->id);
+
+            if (! $queueRow?->is_active) {
+                throw new InactiveQueueException('Queue is inactive');
+            }
+
+            $code = Ticket::nextCode($queue->id);
+
+            try {
+                return Ticket::create([
+                    'queue_id' => $queue->id,
+                    'code' => $code,
+                    'priority' => $priority,
+                    'channel' => $channel,
+                    'status' => 'waiting',
+                    'issued_at' => now(),
+                ]);
+            } catch (QueryException $e) {
+                $isUniqueConstraint = str_contains($e->getMessage(), 'UNIQUE constraint failed');
+                if ($attempt >= $maxRetries || ! $isUniqueConstraint) {
+                    throw $e;
+                }
+            }
+        }
+
+        throw new \RuntimeException('Failed to issue ticket after retries');
+    }
+}
