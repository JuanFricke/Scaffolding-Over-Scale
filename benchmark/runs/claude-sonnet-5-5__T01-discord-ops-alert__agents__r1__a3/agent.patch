diff --git a/tests/Feature/LoggingConfigTest.php b/tests/Feature/LoggingConfigTest.php
new file mode 100644
index 0000000..e0cafe0
--- /dev/null
+++ b/tests/Feature/LoggingConfigTest.php
@@ -0,0 +1,26 @@
+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('daily is the archive channel', function () {
+    expect(config('logging.channels.daily'))
+        ->toMatchArray(['driver' => 'daily', 'days' => 14])
+        ->and(config('logging.channels.daily.path'))->toEndWith('logs/laravel.log');
+});
+
+test('audit is a separate rotated channel', function () {
+    expect(config('logging.channels.audit'))
+        ->toMatchArray(['driver' => 'daily', 'days' => 90, 'level' => 'info'])
+        ->and(config('logging.channels.audit.path'))->toEndWith('logs/audit.log');
+});
+
+test('the stack uses daily and discord is not a log channel', function () {
+    expect(config('logging.channels.stack.channels'))->toContain('daily')->not->toContain('single')
+        ->and(config('logging.channels'))->not->toHaveKey('discord');
+});
+
+test('the audit channel accepts writes', function () {
+    Log::channel('audit')->info('Subscription status changed', ['from' => 'trial', 'to' => 'active']);
+
+    expect(Log::channel('audit'))->not->toBeNull();
+});
diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..f8596b8
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,103 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+const DISCORD_TEST_URL = 'https://discord.com/api/webhooks/123/SECRET-TOKEN';
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => DISCORD_TEST_URL]);
+});
+
+function sentContent(): string
+{
+    $content = null;
+    Http::assertSent(function (Request $request) use (&$content) {
+        $content = $request['content'];
+
+        return true;
+    });
+
+    return $content;
+}
+
+test('it is a silent no-op when the webhook url is not configured', function (?string $url) {
+    config(['services.discord.webhook_url' => $url]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertNothingSent();
+})->with([null, '']);
+
+test('it posts the json content to the configured url', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Job failed', 'Retries exhausted', ['entity_id' => 42, 'queue' => 'asaas-webhooks']);
+
+    Http::assertSent(fn (Request $request) => $request->method() === 'POST'
+        && $request->url() === DISCORD_TEST_URL
+        && $request->isJson()
+        && $request['content'] === "Job failed\nRetries exhausted\nentity_id=42\nqueue=asaas-webhooks");
+});
+
+test('it truncates the text to 1800 multibyte characters', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', str_repeat('é', 5000));
+
+    expect(mb_strlen(sentContent()))->toBe(1800);
+});
+
+test('it redacts sensitive keys, bearer values and nested arrays', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', 'M', [
+        'Password' => 'hunter2',
+        'asaas_token' => 'abc',
+        'Authorization' => 'x',
+        'api-key' => 'k1',
+        'apikey' => 'k2',
+        'discord_webhook' => 'https://discord.com/api/webhooks/1/x',
+        'header' => 'Bearer abc.def',
+        'queue' => 'asaas-webhooks',
+        'nested' => ['secret' => 's3', 'note' => 'Bearer zzz', 'ok' => 'fine'],
+    ]);
+
+    $content = sentContent();
+
+    expect($content)
+        ->toContain('Password=[redacted]', 'asaas_token=[redacted]', 'Authorization=[redacted]')
+        ->toContain('api-key=[redacted]', 'apikey=[redacted]', 'discord_webhook=[redacted]')
+        ->toContain('header=[redacted]', 'queue=asaas-webhooks')
+        ->toContain('nested={"secret":"[redacted]","note":"[redacted]","ok":"fine"}')
+        ->not->toContain('hunter2', 'abc.def', 'zzz', 's3');
+});
+
+test('it logs an error without the webhook url when discord answers non-2xx', function () {
+    Http::fake(['*' => Http::response('nope '.DISCORD_TEST_URL, 500)]);
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function (string $message, array $context = []) {
+        return str_contains($message, 'Discord ops alert failed')
+            && ($context['status'] ?? null) === 500
+            && ! str_contains($message.json_encode($context), 'SECRET-TOKEN');
+    });
+});
+
+test('it swallows transport exceptions and scrubs the url from the log', function () {
+    Http::fake(fn () => throw new ConnectionException('cURL error 28 for '.DISCORD_TEST_URL));
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function (string $message, array $context = []) {
+        return ! str_contains($message.json_encode($context), 'SECRET-TOKEN')
+            && ! str_contains($message.json_encode($context), 'discord.com/api/webhooks');
+    });
+});
