diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..6f62e2e
--- /dev/null
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -0,0 +1,104 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => 'https://discord.example/webhook/token']);
+});
+
+it('is a no-op when webhook url is not configured', function () {
+    config(['services.discord.webhook_url' => null]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message', ['entity_id' => 42]);
+
+    Http::assertNothingSent();
+});
+
+it('is a no-op when webhook url is empty string', function () {
+    config(['services.discord.webhook_url' => '']);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertNothingSent();
+});
+
+it('posts json content with title message and context', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message', ['entity_id' => 42, 'queue' => 'asaas-webhooks']);
+
+    Http::assertSent(function ($request) {
+        return $request->url() === 'https://discord.example/webhook/token'
+            && $request['content'] === "Title\nMessage\nentity_id=42\nqueue=asaas-webhooks";
+    });
+});
+
+it('truncates to 1800 characters', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', str_repeat('a', 2000));
+
+    Http::assertSent(function ($request) {
+        return mb_strlen($request['content']) === 1800;
+    });
+});
+
+it('redacts sensitive keys and bearer values', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message', [
+        'password' => 'secret123',
+        'api_key' => 'abc',
+        'token' => 'xyz',
+        'safe' => 'Bearer abc123',
+        'nested' => ['password' => 'x', 'foo' => 'bar'],
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    Http::assertSent(function ($request) {
+        $content = $request['content'];
+
+        return str_contains($content, 'password=[redacted]')
+            && str_contains($content, 'api_key=[redacted]')
+            && str_contains($content, 'token=[redacted]')
+            && str_contains($content, 'safe=[redacted]')
+            && str_contains($content, 'queue=asaas-webhooks')
+            && str_contains($content, 'nested='.json_encode(['password' => '[redacted]', 'foo' => 'bar']));
+    });
+});
+
+it('logs error on non-2xx status without url', function () {
+    Http::fake(['*' => Http::response('', 500)]);
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')->once();
+});
+
+it('logs error on transport exception without url', function () {
+    Http::fake(function () {
+        throw new ConnectionException('boom https://discord.example/webhook/token');
+    });
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')->once();
+});
+
+it('never throws', function () {
+    Http::fake(function () {
+        throw new RuntimeException('x');
+    });
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    expect(true)->toBeTrue();
+});
