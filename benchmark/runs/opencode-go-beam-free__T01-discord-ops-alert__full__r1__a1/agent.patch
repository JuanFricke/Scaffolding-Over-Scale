diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..b3a23c3
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,92 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+class DiscordOpsAlert
+{
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (empty($url)) {
+            return;
+        }
+
+        $text = $this->buildText($title, $message, $context);
+        $text = mb_substr($text, 0, 1800);
+
+        try {
+            $response = Http::timeout(3)->post($url, ['content' => $text]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (\Throwable $e) {
+            $scrubbed = str_replace((string) $url, '[redacted]', $e->getMessage());
+
+            try {
+                Log::error('Discord ops alert failed', ['exception' => $scrubbed]);
+            } catch (\Throwable) {
+                // Never propagate logging failures.
+            }
+        }
+    }
+
+    protected function buildText(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $redacted = $this->redactValue($key, $value);
+
+            if (is_array($redacted)) {
+                $rendered = json_encode($redacted);
+            } else {
+                $rendered = (string) $redacted;
+            }
+
+            $lines[] = $key.'='.$rendered;
+        }
+
+        return implode("\n", $lines);
+    }
+
+    protected function redactValue(mixed $key, mixed $value): mixed
+    {
+        if ($this->isSensitiveKey((string) $key)) {
+            return '[redacted]';
+        }
+
+        if (is_array($value)) {
+            $redacted = [];
+
+            foreach ($value as $childKey => $childValue) {
+                $redacted[$childKey] = $this->redactValue($childKey, $childValue);
+            }
+
+            return $redacted;
+        }
+
+        if (is_string($value) && preg_match('/Bearer\s+\S+/i', $value)) {
+            return '[redacted]';
+        }
+
+        return $value;
+    }
+
+    protected function isSensitiveKey(string $key): bool
+    {
+        $normalized = strtolower(str_replace(['-', '_'], '', $key));
+
+        foreach (['password', 'token', 'secret', 'authorization', 'apikey', 'webhook'] as $needle) {
+            if (str_contains($normalized, $needle)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+}
