@@ -0,0 +1,176 @@
+<?php
+
+use App\Livewire\Entity\CreateEntity;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Exceptions\PublicPropertyNotFoundException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Simulates a concurrent insert: the slugs handed out are not checked against the
+ * database first, so the insert itself has to detect the collision and retry.
+ */
+class CreateEntityWithSlugs extends CreateEntity
+{
+    /** @var list<string> */
+    public static array $slugs = [];
+
+    public static int $calls = 0;
+
+    protected function uniqueSlug(string $name): string
+    {
+        static::$calls++;
+
+        return array_shift(static::$slugs) ?? parent::uniqueSlug($name);
+    }
+}
+
+beforeEach(function () {
+    CreateEntityWithSlugs::$slugs = [];
+    CreateEntityWithSlugs::$calls = 0;
+});
+
+test('a verified user creates their first entity as its owner and enters it', function () {
+    $audit = Mockery::spy();
+    Log::shouldReceive('channel')->with('audit')->once()->andReturn($audit);
+
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $entity = Entity::where('slug', 'acme-corp')->firstOrFail();
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->owner->user_id)->toBe($user->id)
+        ->and($entity->owner->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::where('entity_id', $entity->id)->count())->toBe(1);
+
+    $audit->shouldHaveReceived('info')->with('Entity created', [
+        'entity_id' => $entity->id,
+        'actor_id' => $user->id,
+    ])->once();
+});
+
+test('onboarding redirects to the new dashboard and stores the entity in the session', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertRedirect(route('entity.dashboard', Entity::where('slug', 'acme-corp')->firstOrFail()));
+
+    expect(session('current_entity_id'))->toBe(Entity::where('slug', 'acme-corp')->value('id'));
+});
+
+test('a repeated name gets a numbered slug', function () {
+    $user = User::factory()->create();
+
+    foreach (['Acme Corp', 'Acme Corp', 'Acme Corp'] as $name) {
+        Livewire::actingAs($user)->test(CreateEntity::class)
+            ->set('name', $name)
+            ->call('submit');
+    }
+
+    expect(Entity::orderBy('id')->pluck('slug')->all())
+        ->toBe(['acme-corp', 'acme-corp-2', 'acme-corp-3']);
+});
+
+test('the slug of a soft deleted entity stays taken', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['name' => 'Acme Corp', 'slug' => 'acme-corp'])->delete();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    expect(Entity::where('name', 'Acme Corp')->value('slug'))->toBe('acme-corp-2');
+});
+
+test('accents are transliterated and the reserved switcher path is never used as a slug', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)->set('name', 'Ação Ltda')->call('submit');
+    Livewire::actingAs($user)->test(CreateEntity::class)->set('name', 'Switcher')->call('submit');
+
+    expect(Entity::orderBy('id')->pluck('slug')->all())->toBe(['acao-ltda', 'switcher-2']);
+});
+
+test('a name is required and limited to 255 characters', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', '')
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required']);
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', str_repeat('a', 256))
+        ->call('submit')
+        ->assertHasErrors(['name' => 'max']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('guests cannot create an entity', function () {
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertNoRedirect();
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('the client cannot choose the role of the creator', function () {
+    $user = User::factory()->create();
+
+    expect(fn () => Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('role', 'employee'))
+        ->toThrow(PublicPropertyNotFoundException::class);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('a slug that collides at insert time is retried with a fresh slug', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    CreateEntityWithSlugs::$slugs = ['acme-corp', 'acme-corp-2'];
+
+    Livewire::actingAs($user)->test(CreateEntityWithSlugs::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $entity = Entity::where('name', 'Acme Corp')->firstOrFail();
+
+    expect($entity->slug)->toBe('acme-corp-2')
+        ->and($entity->owner->user_id)->toBe($user->id)
+        ->and(CreateEntityWithSlugs::$calls)->toBe(2)
+        ->and(Entity::count())->toBe(2);
+});
+
+test('giving up after repeated collisions leaves no partial entity behind', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    CreateEntityWithSlugs::$slugs = array_fill(0, 10, 'acme-corp');
+
+    expect(fn () => Livewire::actingAs($user)->test(CreateEntityWithSlugs::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit'))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    expect(CreateEntityWithSlugs::$calls)->toBe(5)
+        ->and(Entity::count())->toBe(1)
+        ->and(EntityMembership::count())->toBe(0);
+});
diff --git a/tests/Feature/CurrentEntityTest.php b/tests/Feature/CurrentEntityTest.php
new file mode 100644
index 0000000..4f4caa8
--- /dev/null
+++ b/tests/Feature/CurrentEntityTest.php
@@ -0,0 +1,220 @@
+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function currentEntityUser(): User
+{
+    return User::factory()->create();
+}
+
+test('guests are redirected to login from every entity page', function (string $method, string $uri) {
+    $entity = Entity::factory()->create();
+    $path = str_replace('{slug}', $entity->slug, $uri);
+
+    $this->call($method, $path)->assertRedirect(route('login'));
+})->with([
+    ['GET', '/home'],
+    ['GET', '/onboarding'],
+    ['GET', '/e/switcher'],
+    ['GET', '/e/{slug}'],
+    ['POST', '/e/{slug}/pick'],
+]);
+
+test('unverified users are sent to email verification', function () {
+    $user = User::factory()->unverified()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+    $this->actingAs($user)->get(route('onboarding'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('home sends a user without entities to onboarding', function () {
+    $this->actingAs(currentEntityUser())->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('home enters the only entity, whatever the role, and stores it in the session', function (string $state) {
+    $user = currentEntityUser();
+    $membership = EntityMembership::factory()->{$state}()->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $membership->entity))
+        ->assertSessionHas('current_entity_id', $membership->entity_id);
+})->with(['owner', 'admin', 'employee']);
+
+test('home sends a user with several entities to the switcher without picking one', function () {
+    $user = currentEntityUser();
+    EntityMembership::factory()->count(2)->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)->get(route('home'))
+        ->assertRedirect(route('entity.switcher'))
+        ->assertSessionMissing('current_entity_id');
+});
+
+test('home goes to the dashboard of the entity already in the session', function () {
+    $user = currentEntityUser();
+    EntityMembership::factory()->count(2)->create(['user_id' => $user->id]);
+    $chosen = EntityMembership::factory()->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $chosen->entity_id])
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $chosen->entity));
+});
+
+test('a session entity the user does not belong to is forbidden', function () {
+    $user = currentEntityUser();
+    $mine = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $foreign = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $foreign->id])
+        ->get(route('entity.dashboard', $mine))
+        ->assertForbidden();
+});
+
+test('the dashboard forbids another entity even with a valid session for a different one', function () {
+    $user = currentEntityUser();
+    $mine = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $other = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.dashboard', $other))
+        ->assertForbidden();
+});
+
+test('a member sees the entity dashboard with the entity name', function () {
+    $user = currentEntityUser();
+    $entity = Entity::factory()->create(['name' => 'Padaria Central']);
+    EntityMembership::factory()->employee()->for($entity)->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $entity->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Padaria Central')
+        ->assertSee('wire:snapshot', false);
+});
+
+test('the dashboard component does not render an entity the user does not belong to', function () {
+    $user = currentEntityUser();
+    EntityMembership::factory()->create(['user_id' => $user->id]);
+    $other = Entity::factory()->create(['name' => 'Confidencial Ltda']);
+
+    Livewire::actingAs($user)->test(Dashboard::class, ['entity' => $other])
+        ->assertDontSee('Confidencial Ltda');
+});
+
+test('the dashboard entity cannot be tampered with from the client', function () {
+    $user = currentEntityUser();
+    $mine = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $other = Entity::factory()->create();
+
+    expect(fn () => Livewire::actingAs($user)->test(Dashboard::class, ['entity' => $mine])
+        ->set('entity', $other))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
+
+test('the switcher lists only the entities of the user, each as a pick form', function () {
+    $user = currentEntityUser();
+    $first = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $second = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $stranger = Entity::factory()->create(['name' => 'Entidade Alheia']);
+
+    $html = $this->actingAs($user)->withSession(['current_entity_id' => $second->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee($first->name)
+        ->assertSee($second->name)
+        ->assertDontSee($stranger->name)
+        ->content();
+
+    libxml_use_internal_errors(true);
+    $document = new DOMDocument;
+    $document->loadHTML($html);
+    $dom = new DOMXPath($document);
+    $buttonFor = fn (Entity $entity) => $dom->query('//form[@action="'.route('entity.pick', $entity).'"]/button')->item(0);
+
+    expect($buttonFor($first)->getAttribute('class'))->toBe('button is-fullwidth is-light')
+        ->and($buttonFor($first)->hasAttribute('data-current'))->toBeFalse()
+        ->and($buttonFor($second)->getAttribute('class'))->toBe('button is-fullwidth is-link')
+        ->and($buttonFor($second)->getAttribute('data-current'))->toBe('1')
+        ->and($dom->query('//button[@data-current="1"]'))->toHaveCount(1)
+        ->and($dom->query('//form[@action="'.route('entity.pick', $first).'"]/input[@name="_token"]'))->toHaveCount(1);
+});
+
+test('the switcher title is translated', function () {
+    $user = currentEntityUser();
+    EntityMembership::factory()->count(2)->create(['user_id' => $user->id]);
+
+    app()->setLocale('en');
+
+    $this->actingAs($user)->get(route('entity.switcher'))
+        ->assertSee('Switch entity');
+
+    app()->setLocale('pt_BR');
+
+    $this->actingAs($user)->get(route('entity.switcher'))
+        ->assertSee('Trocar de entidade');
+});
+
+test('the navbar links to the switcher only for users with several entities', function () {
+    $user = currentEntityUser();
+    EntityMembership::factory()->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)->get(route('onboarding'))
+        ->assertOk()
+        ->assertDontSee(route('entity.switcher'));
+
+    EntityMembership::factory()->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee(route('entity.switcher'));
+});
+
+test('picking an entity stores it in the session, audits it and redirects to its dashboard', function () {
+    $audit = Mockery::spy();
+    Log::shouldReceive('channel')->with('audit')->once()->andReturn($audit);
+
+    $user = currentEntityUser();
+    $entity = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+
+    $this->actingAs($user)->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+
+    $audit->shouldHaveReceived('info')->with('Entity switched', [
+        'entity_id' => $entity->id,
+        'actor_id' => $user->id,
+    ])->once();
+});
+
+test('picking an entity the user does not belong to is forbidden and leaves the session alone', function () {
+    $user = currentEntityUser();
+    $mine = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $foreign = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $mine->id])
+        ->post(route('entity.pick', $foreign))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->id);
+});
+
+test('picking a deleted entity is not found', function () {
+    $user = currentEntityUser();
+    $entity = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $entity->delete();
+
+    $this->actingAs($user)->post(route('entity.pick', $entity))
+        ->assertNotFound();
+});
diff --git a/tests/Feature/EntityDataModelTest.php b/tests/Feature/EntityDataModelTest.php
new file mode 100644
index 0000000..b37539a
--- /dev/null
+++ b/tests/Feature/EntityDataModelTest.php
@@ -0,0 +1,161 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+function indexNamed(string $table, string $name): ?array
+{
+    return collect(Schema::getIndexes($table))->firstWhere('name', $name);
+}
+
+test('entities are routed by slug and soft deleted', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme-corp');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('the entity slug has a unique index with the agreed name', function () {
+    expect(indexNamed('entities', 'entities_slug_unique'))->not->toBeNull()
+        ->and(indexNamed('entities', 'entities_slug_unique')['unique'])->toBeTrue();
+
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme-corp']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('a user holds at most one membership per entity', function () {
+    expect(indexNamed('entity_memberships', 'entity_memberships_entity_user_unique')['unique'])->toBeTrue();
+
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('memberships default to the employee role', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(DB::table('entity_memberships')->value('role'))->toBe('employee');
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    expect(indexNamed('entity_memberships', 'entity_memberships_one_owner')['unique'])->toBeTrue();
+
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the one-owner rule does not limit admins, employees or owners of other entities', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->admin()->for($entity)->count(2)->create();
+    EntityMembership::factory()->employee()->for($entity)->count(2)->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect(EntityMembership::query()->where('entity_id', $entity->id)->count())->toBe(4)
+        ->and(EntityMembership::owner()->count())->toBe(1);
+});
+
+test('owner_seq is 1 for owners and null for every other role', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(DB::table('entity_memberships')->where('role', 'owner')->value('owner_seq'))->toBe(1)
+        ->and(DB::table('entity_memberships')->where('role', '!=', 'owner')->pluck('owner_seq')->all())
+        ->toBe([null, null]);
+});
+
+test('deleting a user or hard deleting an entity removes its memberships', function () {
+    $fromUser = EntityMembership::factory()->create();
+    $fromEntity = EntityMembership::factory()->create();
+
+    $fromUser->user->delete();
+    $fromEntity->entity->forceDelete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('the role is cast to UserRole and exposes scopes', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id])
+        ->and($owner->entity)->toBeInstanceOf(Entity::class)
+        ->and($owner->user)->toBeInstanceOf(User::class);
+});
+
+test('UserRole lists the roles a manager may assign', function () {
+    expect(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee')
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('an entity exposes its owner membership, members and users', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->owner->is($owner))->toBeTrue()
+        ->and($entity->memberships)->toHaveCount(2)
+        ->and($entity->users->modelKeys())->toEqualCanonicalizing([$owner->user_id, $employee->user_id]);
+});
+
+test('a user finds the membership for an entity, but not for a deleted one', function () {
+    $membership = EntityMembership::factory()->create();
+    $user = $membership->user;
+    $other = Entity::factory()->create();
+
+    expect($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor($other->id))->toBeNull();
+
+    $membership->entity->delete();
+
+    expect($user->membershipFor($membership->entity_id))->toBeNull()
+        ->and($user->entities)->toHaveCount(0);
+});
+
+test('a user lists only the entities they belong to', function () {
+    $user = User::factory()->create();
+    $mine = Entity::factory()->create();
+    EntityMembership::factory()->for($mine)->create(['user_id' => $user->id]);
+    EntityMembership::factory()->create(['user_id' => $user->id]);
+
+    expect($user->memberships)->toHaveCount(2)
+        ->and($user->entities->modelKeys())->toHaveCount(2)
+        ->and($user->entities->modelKeys())->toContain($mine->id);
+});
diff --git a/tests/Feature/EntityLocalizationTest.php b/tests/Feature/EntityLocalizationTest.php
new file mode 100644
index 0000000..4142122
