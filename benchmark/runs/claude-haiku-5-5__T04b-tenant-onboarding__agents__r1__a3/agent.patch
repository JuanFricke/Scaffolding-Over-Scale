+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('entity screen texts exist in both locales with the agreed wording', function (string $key, string $en, string $ptBr) {
+    expect(__("ui.{$key}", [], 'en'))->toBe($en)
+        ->and(__("ui.{$key}", [], 'pt_BR'))->toBe($ptBr);
+})->with([
+    ['switch_entity', 'Switch entity', 'Trocar de entidade'],
+    ['onboarding_title', 'Create your entity', 'Crie sua entidade'],
+    ['onboarding_heading', 'Create your company', 'Crie sua empresa'],
+]);
+
+test('the locale files define the same ui keys', function () {
+    expect(array_keys(require lang_path('en/ui.php')))
+        ->toEqualCanonicalizing(array_keys(require lang_path('pt_BR/ui.php')));
+});
+
+test('the onboarding page renders its title and heading in Brazilian Portuguese', function () {
+    app()->setLocale('pt_BR');
+
+    $this->actingAs(User::factory()->create())->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Crie sua entidade')
+        ->assertSee('Crie sua empresa');
+});
+
+test('the onboarding page renders in English when the locale is English', function () {
+    app()->setLocale('en');
+
+    $this->actingAs(User::factory()->create())->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Create your entity')
+        ->assertSee('Create your company')
+        ->assertDontSee('Crie sua empresa');
+});
diff --git a/tests/Feature/EntityPoliciesTest.php b/tests/Feature/EntityPoliciesTest.php
new file mode 100644
index 0000000..623328c
--- /dev/null
+++ b/tests/Feature/EntityPoliciesTest.php
@@ -0,0 +1,109 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = EntityMembership::factory()->owner()->for($this->entity)->create();
+    $this->admin = EntityMembership::factory()->admin()->for($this->entity)->create();
+    $this->employee = EntityMembership::factory()->employee()->for($this->entity)->create();
+    $this->outsider = User::factory()->create();
+});
+
+test('policies are discovered for the models', function () {
+    expect(Gate::getPolicyFor(Entity::class))->toBeInstanceOf(EntityPolicy::class)
+        ->and(Gate::getPolicyFor(EntityMembership::class))->toBeInstanceOf(EntityMembershipPolicy::class);
+});
+
+test('any authenticated user may create an entity', function () {
+    expect((new EntityPolicy)->create($this->outsider))->toBeTrue();
+});
+
+test('every member of an entity may view it, outsiders may not', function () {
+    $policy = new EntityPolicy;
+
+    expect($policy->view($this->owner->user, $this->entity))->toBeTrue()
+        ->and($policy->view($this->admin->user, $this->entity))->toBeTrue()
+        ->and($policy->view($this->employee->user, $this->entity))->toBeTrue()
+        ->and($policy->view($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('only owners and admins may update or delete an entity', function (string $ability) {
+    $policy = new EntityPolicy;
+
+    expect($policy->{$ability}($this->owner->user, $this->entity))->toBeTrue()
+        ->and($policy->{$ability}($this->admin->user, $this->entity))->toBeTrue()
+        ->and($policy->{$ability}($this->employee->user, $this->entity))->toBeFalse()
+        ->and($policy->{$ability}($this->outsider, $this->entity))->toBeFalse();
+})->with(['update', 'delete']);
+
+test('only the owner may manage entity settings', function () {
+    $policy = new EntityPolicy;
+
+    expect($policy->manageSettings($this->owner->user, $this->entity))->toBeTrue()
+        ->and($policy->manageSettings($this->admin->user, $this->entity))->toBeFalse()
+        ->and($policy->manageSettings($this->employee->user, $this->entity))->toBeFalse()
+        ->and($policy->manageSettings($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('a member of a deleted entity cannot act on it', function () {
+    $this->entity->delete();
+
+    expect((new EntityPolicy)->view($this->owner->user, $this->entity))->toBeFalse()
+        ->and((new EntityPolicy)->update($this->owner->user, $this->entity))->toBeFalse();
+});
+
+test('members of the same entity may view each other memberships', function () {
+    $policy = new EntityMembershipPolicy;
+    $elsewhere = EntityMembership::factory()->employee()->create();
+
+    expect($policy->view($this->employee->user, $this->owner))->toBeTrue()
+        ->and($policy->view($this->outsider, $this->owner))->toBeFalse()
+        ->and($policy->view($this->owner->user, $elsewhere))->toBeFalse();
+});
+
+test('owners and admins may assign roles to other members', function () {
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->assignRole($this->owner->user, $this->employee))->toBeTrue()
