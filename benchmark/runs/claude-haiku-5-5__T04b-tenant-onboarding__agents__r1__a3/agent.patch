@@ -0,0 +1,33 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+class CreateEntity
+{
+    /**
+     * Creates the entity and makes the actor its owner, in one transaction. The owner role
+     * is fixed here and never comes from input. A slug taken at insert time raises
+     * UniqueConstraintViolationException and rolls the whole write back.
+     */
+    public function handle(User $actor, string $name, string $slug): Entity
+    {
+        Gate::forUser($actor)->authorize('create', Entity::class);
+
+        return DB::transaction(function () use ($actor, $name, $slug) {
+            $entity = Entity::create(['name' => $name, 'slug' => $slug]);
+
+            $entity->memberships()->create([
+                'user_id' => $actor->id,
+                'role' => UserRole::Owner,
+            ]);
+
+            return $entity;
+        });
+    }
+}
