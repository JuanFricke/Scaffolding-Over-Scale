@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Tenancy\TenantContext;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class ResolveCurrentEntity
+{
+    public function __construct(private TenantContext $tenant) {}
+
+    /**
+     * Resolves the entity the user works in from the session into the tenant context.
+     *
+     * With no entity in the session, a user with exactly one entity enters it, a user with
+     * none goes to onboarding and a user with several is sent to the switcher. A session
+     * entity the user does not belong to is forbidden.
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+        $entityId = $request->session()->get('current_entity_id');
+
+        if ($entityId !== null) {
+            $membership = $user->membershipFor((int) $entityId) ?? abort(403);
+        } else {
+            $memberships = $user->memberships()->whereHas('entity')->get();
+
+            if ($memberships->count() !== 1) {
+                return redirect()->route($memberships->isEmpty() ? 'onboarding' : 'entity.switcher');
+            }
+
+            $membership = $memberships->first();
+            $request->session()->put('current_entity_id', $membership->entity_id);
+        }
+
+        $this->tenant->set($membership);
+
+        return $next($request);
+    }
+}
diff --git a/app/Livewire/Entity/CreateEntity.php b/app/Livewire/Entity/CreateEntity.php
new file mode 100644
index 0000000..f51677b
--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,83 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateEntity as CreateEntityAction;
+use App\Models\Entity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class CreateEntity extends Component
+{
+    /** A slug can still be taken between the uniqueness check and the insert, so retry a few times. */
+    private const SLUG_ATTEMPTS = 5;
+
+    /** Slugs that would shadow a named route under /e/{entity:slug}. */
+    private const RESERVED_SLUGS = ['switcher'];
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    /**
+     * Creates the entity with its owner, enters it and goes to its dashboard.
+     */
+    public function submit(): void
+    {
+        $this->authorize('create', Entity::class);
+
+        $validated = $this->validate();
+        $actor = auth()->user();
+        $entity = null;
+
+        for ($attempt = 1; $entity === null; $attempt++) {
+            try {
+                $entity = app(CreateEntityAction::class)->handle(
+                    $actor,
+                    $validated['name'],
+                    $this->uniqueSlug($validated['name']),
+                );
+            } catch (UniqueConstraintViolationException $exception) {
+                if ($attempt >= self::SLUG_ATTEMPTS) {
+                    throw $exception;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $actor->id,
+        ]);
+
+        session()->put('current_entity_id', $entity->id);
+
+        $this->redirectRoute('entity.dashboard', $entity);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')
+            ->layoutData(['title' => __('ui.onboarding_title')]);
+    }
+
+    /**
+     * A URL-safe slug from the name, numbered while taken: acme-corp, acme-corp-2, ...
+     * Soft deleted entities keep their slug because the unique index still covers them.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::limit(Str::slug($name), 200, '') ?: 'entity';
+        $slug = $base;
+
+        for ($n = 2; in_array($slug, self::RESERVED_SLUGS, true) || Entity::withTrashed()->where('slug', $slug)->exists(); $n++) {
+            $slug = $base.'-'.$n;
+        }
+
+        return $slug;
+    }
+}
