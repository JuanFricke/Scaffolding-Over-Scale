+<?php
+
+namespace App\Models;
+
+use Database\Factories\EntityFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsToMany;
+use Illuminate\Database\Eloquent\Relations\HasMany;
+use Illuminate\Database\Eloquent\Relations\HasOne;
+use Illuminate\Database\Eloquent\SoftDeletes;
+
+#[Fillable(['name', 'slug'])]
+class Entity extends Model
+{
+    /** @use HasFactory<EntityFactory> */
+    use HasFactory, SoftDeletes;
+
+    /**
+     * The attribute used to resolve the entity from a route, e.g. /e/{entity:slug}.
+     */
+    public function getRouteKeyName(): string
+    {
+        return 'slug';
+    }
+
+    /**
+     * @return HasMany<EntityMembership, $this>
+     */
+    public function memberships(): HasMany
+    {
+        return $this->hasMany(EntityMembership::class);
+    }
+
+    /**
+     * The members of the entity, through their memberships.
+     *
+     * @return BelongsToMany<User, $this>
+     */
+    public function users(): BelongsToMany
+    {
+        return $this->belongsToMany(User::class, 'entity_memberships')
+            ->withPivot('role')
+            ->withTimestamps();
+    }
+
+    /**
+     * The owner membership: exactly one per entity.
+     *
+     * @return HasOne<EntityMembership, $this>
+     */
+    public function owner(): HasOne
+    {
+        return $this->hasOne(EntityMembership::class)->owner();
+    }
+}
