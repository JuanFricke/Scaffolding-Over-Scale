+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+
+test('the app is pinned to PegaFila, pt_BR with an English fallback', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('markdown mail uses the pegafila theme', function () {
+    expect(config('mail.markdown.theme'))->toBe('pegafila')
+        ->and(resource_path('views/vendor/mail/html/themes/pegafila.css'))->toBeFile();
+});
+
+test('the reset password mail is rendered in brazilian portuguese with the brand colour', function () {
+    $user = User::factory()->make(['email' => 'ana@example.com']);
+
+    $mail = (new ResetPassword('token-123'))->toMail($user);
+
+    expect($mail->subject)->toBe('Redefina sua senha')
+        ->and($mail->actionText)->toBe('Redefinir senha')
+        ->and($mail->actionUrl)->toContain('/reset-password/token-123?email=');
+
+    $html = (string) $mail->render();
+
+    expect($html)->toContain('Olá!')
+        ->toContain('PegaFila')
+        ->toContain('Você recebeu esse e-mail porque foi solicitado uma redefinição de senha na sua conta.')
+        ->toContain('copie e cole a URL abaixo')
+        ->not->toContain('having trouble clicking')
+        ->and(preg_match('/<a[^>]*class="button button-primary"[^>]*style="[^"]*background-color: ?#0f7490/', $html))->toBe(1);
+});
+
+test('the verification mail is rendered in brazilian portuguese with the brand colour', function () {
+    $user = User::factory()->make(['id' => 1, 'email' => 'ana@example.com']);
+
+    $mail = (new VerifyEmail)->toMail($user);
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($mail->actionText)->toBe('Verifique o endereço de e-mail');
+
+    $html = (string) $mail->render();
+
+    expect($html)->toContain('Olá!')
+        ->toContain('Por favor, clique no botão abaixo para verificar seu endereço de e-mail.')
+        ->not->toContain('having trouble clicking')
+        ->and(preg_match('/<a[^>]*class="button button-primary"[^>]*style="[^"]*background-color: ?#0f7490/', $html))->toBe(1);
+});
diff --git a/tests/Feature/EmailVerificationTest.php b/tests/Feature/EmailVerificationTest.php
new file mode 100644
index 0000000..5290165
--- /dev/null
+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,83 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user, ?string $hash = null, ?int $id = null, ?Carbon $expiresAt = null): string
+{
+    return URL::temporarySignedRoute(
+        'verification.verify',
+        $expiresAt ?? now()->addMinutes(60),
+        [
+            'id' => $id ?? $user->getKey(),
+            'hash' => $hash ?? sha1($user->getEmailForVerification()),
+        ]
+    );
+}
+
+test('the signed link verifies the logged-in user and redirects home', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link whose hash does not match the email is forbidden', function () {
+    $user = User::factory()->unverified()->create(['email' => 'ana@example.com']);
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user, hash: sha1('other@example.com')))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link for another user id is forbidden even when correctly signed', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user, id: $other->getKey()))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an expired link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user, expiresAt: now()->subMinute()))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an already verified user is redirected home and keeps the original timestamp', function () {
+    $user = User::factory()->create(['email_verified_at' => now()->subDay()]);
+    $verifiedAt = $user->email_verified_at->toDateTimeString();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->refresh()->email_verified_at->toDateTimeString())->toBe($verifiedAt);
+});
diff --git a/tests/Feature/PasswordResetTest.php b/tests/Feature/PasswordResetTest.php
new file mode 100644
index 0000000..0f38f36
--- /dev/null
+++ b/tests/Feature/PasswordResetTest.php
@@ -0,0 +1,201 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('guests see the forgot password form with a labelled email field', function () {
+    $response = $this->get('/forgot-password');
+
+    $response->assertOk()
+        ->assertSee('action="'.route('password.email').'"', false)
+        ->assertSee('for="email"', false)
+        ->assertSee('type="email"', false);
+});
+
+test('authenticated users are redirected away from the forgot password form', function () {
+    $this->actingAs(User::factory()->create())
+        ->get('/forgot-password')
+        ->assertRedirect('/');
+});
+
+test('a registered address gets a reset notification and a status flash', function () {
+    Notification::fake();
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    $this->from('/forgot-password')
+        ->post('/forgot-password', ['email' => 'ana@example.com'])
+        ->assertRedirect('/forgot-password')
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown address gets the same response and no notification', function () {
+    Notification::fake();
+
+    $this->from('/forgot-password')
+        ->post('/forgot-password', ['email' => 'ghost@example.com'])
+        ->assertRedirect('/forgot-password')
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('the forgot password email must be present and well formed', function (string $email) {
+    Notification::fake();
+
+    $this->from('/forgot-password')
+        ->post('/forgot-password', ['email' => $email])
+        ->assertRedirect('/forgot-password')
+        ->assertSessionHasErrors('email')
+        ->assertSessionMissing('status');
+
+    Notification::assertNothingSent();
+})->with(['', 'not-an-email']);
+
+test('the forgot password endpoint is throttled to six requests a minute', function () {
+    Notification::fake();
+
+    foreach (range(1, 6) as $_) {
+        $this->from('/forgot-password')->post('/forgot-password', ['email' => 'ana@example.com']);
+    }
+
+    $this->from('/forgot-password')
+        ->post('/forgot-password', ['email' => 'ana@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset form carries the token and a single email field', function () {
+    $response = $this->get('/reset-password/token-123?email=ana@example.com');
+
+    $response->assertOk()
+        ->assertSee('action="'.route('password.update').'"', false)
+        ->assertSee('name="token"', false)
+        ->assertSee('value="token-123"', false)
+        ->assertSee('value="ana@example.com"', false)
+        ->assertSee('name="password"', false)
+        ->assertSee('name="password_confirmation"', false);
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('a valid token resets the password, rotates the remember token and redirects home', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['email' => 'ana@example.com', 'remember_token' => 'old-token']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post('/reset-password', [
+        'token' => $token,
+        'email' => 'ana@example.com',
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ])
+        ->assertRedirect('/')
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NovaSenha123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token')
+        ->and(Password::broker()->tokenExists($user, $token))->toBeFalse();
+
+    Event::assertDispatched(PasswordReset::class, fn (PasswordReset $event) => $event->user->is($user));
+});
+
+test('an invalid token is rejected and the password is left alone', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $before = $user->password;
+
+    $this->from('/reset-password/bad-token')
+        ->post('/reset-password', [
+            'token' => 'bad-token',
+            'email' => 'ana@example.com',
+            'password' => 'NovaSenha123',
+            'password_confirmation' => 'NovaSenha123',
+        ])
+        ->assertRedirectBack()
+        ->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect($user->refresh()->password)->toBe($before);
+    Event::assertNotDispatched(PasswordReset::class);
+});
+
+test('a token issued to one account cannot reset another account', function () {
+    $victim = User::factory()->create(['email' => 'victim@example.com']);
+    $attacker = User::factory()->create(['email' => 'attacker@example.com']);
+    $before = $victim->password;
+    $token = Password::broker()->createToken($attacker);
+
+    $this->from('/reset-password/'.$token)
+        ->post('/reset-password', [
+            'token' => $token,
+            'email' => 'victim@example.com',
+            'password' => 'NovaSenha123',
+            'password_confirmation' => 'NovaSenha123',
+        ])
+        ->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect($victim->refresh()->password)->toBe($before);
+});
+
+test('the new password must be long, mixed case, numeric, letter-based and confirmed', function (string $password, string $confirmation) {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $before = $user->password;
+    $token = Password::broker()->createToken($user);
+
+    $this->from('/reset-password/'.$token)
+        ->post('/reset-password', [
+            'token' => $token,
+            'email' => 'ana@example.com',
+            'password' => $password,
+            'password_confirmation' => $confirmation,
+        ])
+        ->assertSessionHasErrors('password');
+
+    expect($user->refresh()->password)->toBe($before);
+})->with([
+    'too short' => ['Ab1cdef', 'Ab1cdef'],
+    'no uppercase' => ['senhaforte123', 'senhaforte123'],
+    'no lowercase' => ['SENHAFORTE123', 'SENHAFORTE123'],
+    'no numbers' => ['SenhaForte', 'SenhaForte'],
+    'no letters' => ['12345678', '12345678'],
+    'confirmation mismatch' => ['NovaSenha123', 'OutraSenha123'],
+]);
+
+test('a required token is validated', function () {
+    $this->from('/reset-password/x')
+        ->post('/reset-password', [
+            'email' => 'ana@example.com',
+            'password' => 'NovaSenha123',
+            'password_confirmation' => 'NovaSenha123',
+        ])
+        ->assertSessionHasErrors('token');
+});
+
+test('authenticated users cannot use the reset endpoints', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $before = $user->password;
+    $token = Password::broker()->createToken($user);
+
+    $this->actingAs($user)
+        ->post('/reset-password', [
+            'token' => $token,
+            'email' => 'ana@example.com',
+            'password' => 'NovaSenha123',
+            'password_confirmation' => 'NovaSenha123',
+        ])
+        ->assertRedirect('/');
+
+    expect($user->refresh()->password)->toBe($before);
+});
