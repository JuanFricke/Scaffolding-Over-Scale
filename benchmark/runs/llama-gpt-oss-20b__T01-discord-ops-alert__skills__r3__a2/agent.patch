diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..67eba66
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,122 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Config;
+
+class DiscordOpsAlert
+{
+    /**
+     * Send an ops alert to Discord via incoming webhook.
+     *
+     * @param string $title   The alert title.
+     * @param string $message The main message.
+     * @param array  $context Optional context data.
+     *
+     * @return void
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = Config::get('services.discord.webhook_url');
+        if (empty($url)) {
+            return; // No-op if not configured
+        }
+
+        // Build text
+        $lines = [$title, $message];
+        foreach ($this->redactContext($context) as $key => $value) {
+            $lines[] = "{$key}={$value}";
+        }
+        $text = implode("\n", $lines);
+        // Truncate to 1800 multibyte characters
+        if (mb_strlen($text) > 1800) {
+            $text = mb_substr($text, 0, 1800);
+        }
+
+        try {
+            $response = Http::withOptions(['timeout' => 5])->post($url, [
+                'content' => $text,
+            ]);
+
+            if ($response->failed()) {
+                $this->logError("Discord ops alert failed", [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (\\Throwable $e) {
+            $this->logError("Discord ops alert exception", [
+                'message' => $this->sanitize($e->getMessage()),
+                'code' => $e->getCode(),
+            ]);
+        }
+    }
+
+    /**
+     * Redact sensitive data from context.
+     * Returns an associative array with redacted values.
+     */
+    private function redactContext(array $context): array
+    {
+        $sensitiveKeys = [
+            'password',
+            'token',
+            'secret',
+            'authorization',
+            'api_key',
+            'api-key',
+            'apikey',
+            'webhook',
+        ];
+        $result = [];
+        foreach ($context as $key => $value) {
+            $redacted = $this->redactValue($value, $key, $sensitiveKeys);
+            $result[$key] = $redacted;
+        }
+        return $result;
+    }
+
+    private function redactValue($value, string $key, array $sensitiveKeys)
+    {
+        // Check key for sensitivity
+        foreach ($sensitiveKeys as $sKey) {
+            if (stripos($key, $sKey) !== false) {
+                return '[redacted]';
+            }
+        }
+        // Handle array recursively
+        if (is_array($value)) {
+            $redacted = [];
+            foreach ($value as $k => $v) {
+                $redacted[$k] = $this->redactValue($v, $k, $sensitiveKeys);
+            }
+            return json_encode($redacted, JSON_UNESCAPED_UNICODE);
+        }
+        // String checks
+        if (is_string($value)) {
+            if (preg_match('/Bearer\s+\S+/i', $value)) {
+                return '[redacted]';
+            }
+            return $value;
+        }
+        // For other types, cast to string
+        return (string) $value;
+    }
+
+    private function sanitize(string $message): string
+    {
+        $url = Config::get('services.discord.webhook_url');
+        if ($url) {
+            $message = str_replace($url, '[redacted_url]', $message);
+        }
+        return $message;
+    }
+
+    private function logError(string $msg, array $context = []): void
+    {
+        // Ensure webhook URL is not logged
+        $context = array_map(fn($v) => is_string($v) ? $this->sanitize($v) : $v, $context);
+        Log::error($msg, $context);
+    }
+}
