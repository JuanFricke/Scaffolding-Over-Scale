@@ -0,0 +1,37 @@
+<?php
+
+use App\Http\Controllers\Api\Totem\TotemAuthController;
+use App\Http\Controllers\Api\Totem\TotemPriorityController;
+use App\Http\Controllers\Api\Totem\TotemQueueController;
+use App\Http\Controllers\Api\Totem\TotemTicketController;
+use App\Http\Middleware\TotemAuth;
+use Illuminate\Support\Facades\Route;
+
+/*
+|--------------------------------------------------------------------------
+| Totem BFF API
+|--------------------------------------------------------------------------
+|
+| These endpoints are consumed by the Flutter Totem client running on
+| physical display devices. Authentication uses JWT issued via pairing
+| codes generated through the `totem:pairing-code` artisan command.
+|
+*/
+
+// Unauthenticated: pairing code login.
+Route::post('/totem/auth', TotemAuthController::class)->name('totem.auth');
+
+// Authenticated: totem endpoints (behind TotemAuth middleware).
+Route::middleware(TotemAuth::class)->group(function () {
+    // GET /api/totem/{entity}/queues
+    Route::get('/totem/{entity}/queues', TotemQueueController::class)
+        ->name('totem.queues');
+
+    // GET /api/totem/{entity}/queues/{queue}/priorities
+    Route::get('/totem/{entity}/queues/{queue}/priorities', TotemPriorityController::class)
+        ->name('totem.priorities');
+
+    // POST /api/totem/{entity}/queues/{queue}/ticket
+    Route::post('/totem/{entity}/queues/{queue}/ticket', TotemTicketController::class)
+        ->name('totem.ticket');
+});
diff --git a/tests/Feature/TotemBffTest.php b/tests/Feature/TotemBffTest.php
new file mode 100644
index 0000000..49c71fe
--- /dev/null
+++ b/tests/Feature/TotemBffTest.php
@@ -0,0 +1,583 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Console\BufferedConsoleOutput;
+use Illuminate\Console\Command;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Config;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+uses(RefreshDatabase::class);
+
+/*
+|--------------------------------------------------------------------------
+| Totem BFF — Pairing Authentication
+|--------------------------------------------------------------------------
+*/
+
+it('returns 401 for a non-existent pairing code', function () {
+    $response = $this->postJson(route('totem.auth'), [
+        'code' => '000000',
+    ]);
+
+    $response->assertStatus(401)
+        ->assertJsonPath('code', 'invalid_pairing_code');
+});
+
+it('returns 401 for an expired pairing code', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->create([
+        'entity_id' => $entity->id,
+        'login_code_expires_at' => now()->subMinutes(1),
+    ]);
+
+    $response = $this->postJson(route('totem.auth'), [
+        'code' => $preset->login_code,
+    ]);
+
+    $response->assertStatus(401)
+        ->assertJsonPath('code', 'invalid_pairing_code');
+});
+
+it('returns 401 for a consumed pairing code', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->create([
+        'entity_id' => $entity->id,
+        'login_code_consumed_at' => now(),
+    ]);
+
+    $response = $this->postJson(route('totem.auth'), [
+        'code' => $preset->login_code,
+    ]);
+
+    $response->assertStatus(401)
+        ->assertJsonPath('code', 'invalid_pairing_code');
+});
+
+it('returns 401 for an inactive preset', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->create([
+        'entity_id' => $entity->id,
+        'is_active' => false,
+    ]);
+
+    $response = $this->postJson(route('totem.auth'), [
+        'code' => $preset->login_code,
+    ]);
+
+    $response->assertStatus(401)
+        ->assertJsonPath('code', 'invalid_pairing_code');
+});
+
+it('authenticates with a valid pairing code and returns JWT', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $preset = TotemPreset::factory()->create([
+        'entity_id' => $entity->id,
+    ]);
+
+    // Link preset to queue.
+    $preset->queues()->attach($queue->id);
+
+    $response = $this->postJson(route('totem.auth'), [
+        'code' => $preset->login_code,
+    ]);
+
+    $response->assertStatus(200)
+        ->assertJsonStructure([
+            'token',
+            'token_type',
+            'expires_in',
+            'entity',
+        ])
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('entity.name', $entity->name);
+
+    // Verify the token is a valid JWT (three parts).
+    $token = $response->json('token');
+    $parts = explode('.', $token);
+    expect($parts)->toHaveCount(3);
+
+    // Verify the totem was created.
+    expect(Totem::query()->where('entity_id', $entity->id)->exists())->toBeTrue();
+});
+
+it('rejects invalid code format', function () {
+    $response = $this->postJson(route('totem.auth'), [
+        'code' => 'abc',
+    ]);
+
+    $response->assertStatus(400)
+        ->assertJsonPath('code', 'invalid_code_format');
+});
+
+it('rejects empty code', function () {
+    $response = $this->postJson(route('totem.auth'), []);
+
+    $response->assertStatus(400)
+        ->assertJsonPath('code', 'invalid_code_format');
+});
+
+it('consumes the pairing code on successful auth', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->create([
+        'entity_id' => $entity->id,
+    ]);
+
+    // First auth succeeds.
+    $this->postJson(route('totem.auth'), [
+        'code' => $preset->login_code,
+    ])->assertStatus(200);
+
+    // Second auth with same code fails (code consumed).
+    $this->postJson(route('totem.auth'), [
