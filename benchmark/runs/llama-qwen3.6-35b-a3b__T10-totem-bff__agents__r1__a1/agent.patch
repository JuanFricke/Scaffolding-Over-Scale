+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\RateLimiter;
+
+class TotemTicketController
+{
+    /**
+     * Issue a ticket in a queue with a chosen priority.
+     */
+    public function __invoke(Request $request): JsonResponse
+    {
+        /** @var Totem $totem */
+        $totem = $request->totem;
+
+        /** @var TotemPreset $preset */
+        $preset = $request->preset;
+
+        /** @var \stdClass $payload */
+        $payload = $request->totem_payload;
+
+        // Validate entity slug matches.
+        if ($request->entity !== $preset->entity->slug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        // Resolve queue within the entity.
+        $queue = Queue::query()
+            ->where('entity_id', $preset->entity_id)
+            ->where('slug', $request->queue)
+            ->first();
+
+        if (! $queue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        // Check if queue is in the preset scope.
+        $inScope = \DB::table('totem_preset_queue')
+            ->where('preset_id', $preset->id)
+            ->where('queue_id', $queue->id)
+            ->exists();
+
+        if (! $inScope) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        // Inactive queue.
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        // Rate limit issuance (30/min).
+        $key = 'totem-issue:'.$totem->id;
+
+        if (RateLimiter::tooManyAttempts($key, 30)) {
+            return response()->json(['code' => 'rate_limited'], 429);
+        }
+
+        // Validate priority.
+        $validated = $request->validate([
+            'priority' => ['required', 'integer', 'in:0,10,20'],
+        ]);
+
+        RateLimiter::hit($key);
+
+        // Issue ticket using existing domain action.
+        $ticket = app(IssueTicket::class)(
+            $queue,
+            (int) $validated['priority'],
+            TicketChannel::Totem
+        );
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priority' => [
+                'value' => $ticket->priority,
+                'label' => self::priorityLabel($ticket->priority),
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+
+    /**
+     * Get the label for a priority value.
+     */
+    private static function priorityLabel(int $value): string
+    {
+        return match ($value) {
+            0 => 'Normal',
+            10 => 'Prioritário',
+            20 => 'Prioridade 80+',
+            default => 'Normal',
+        };
+    }
+}
diff --git a/app/Http/Middleware/TotemAuth.php b/app/Http/Middleware/TotemAuth.php
new file mode 100644
index 0000000..c888b02
--- /dev/null
+++ b/app/Http/Middleware/TotemAuth.php
@@ -0,0 +1,112 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Str;
+use Symfony\Component\HttpFoundation\Response;
+
+class TotemAuth
+{
+    /**
+     * Handle an incoming request.
+     *
+     * @param  \Closure(\Symfony\Component\HttpFoundation\Request): (.\Symfony\Component\HttpFoundation\Response)  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $header = $request->header('Authorization');
+
+        if (is_null($header) || ! Str::startsWith($header, 'Bearer ')) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $token = Str::substr($header, 7);
+
+        // Decode and validate JWT.
+        $payload = $this->decodeToken($token);
+
+        if (is_null($payload)) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        // Validate totem exists and is active.
+        $totem = Totem::query()
+            ->whereKey($payload->totem_id)
+            ->first();
+
+        if (! $totem || ! $totem->is_active) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        // Validate preset exists and is active.
+        $preset = TotemPreset::query()
+            ->whereKey($payload->preset_id)
+            ->first();
+
+        if (! $preset || ! $preset->is_active) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        // Validate entity matches.
+        if ($payload->entity_id !== $totem->entity_id) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        // Update last_seen_at.
+        $totem->update(['last_seen_at' => now()]);
+
+        // Store resolved data on request.
+        $request->merge([
+            'totem' => $totem,
+            'preset' => $preset,
+            'totem_payload' => (array) $payload,
+        ]);
+
+        return $next($request);
+    }
+
+    /**
+     * Decode and validate a HS256 JWT.
+     *
+     * @return \stdClass|null
+     */
+    private function decodeToken(string $token): ?object
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            return null;
+        }
+
+        [$header, $payload, $signature] = $parts;
+
+        // Verify signature.
+        $expectedSignature = hash_hmac(
+            'sha256',
+            $header.'.'.$payload,
+            config('services.totem.jwt_secret'),
+            true
+        );
+
+        if (! hash_equals($expectedSignature, base64_decode($signature, true))) {
+            return null;
+        }
+
+        $decoded = json_decode(base64_decode(strtr($payload, '-_', '/+')));
+
+        if (! $decoded || ! is_object($decoded)) {
+            return null;
+        }
+
+        // Check expiry.
+        if (isset($decoded->exp) && $decoded->exp < time()) {
+            return null;
+        }
+
+        return $decoded;
+    }
+}
