+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+
+class TotemPairingCode extends Command
+{
+    /**
+     * The name and signature of the console command.
+     *
+     * @var string
+     */
+    protected $signature = 'totem:pairing-code {preset}';
+
+    /**
+     * The console command description.
+     *
+     * @var string
+     */
+    protected $description = 'Generate a pairing code for a totem preset';
+
+    /**
+     * Execute the console command.
+     */
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+
+        $preset = TotemPreset::query()
+            ->whereKey($presetId)
+            ->lockForUpdate()
+            ->first();
+
+        if (! $preset) {
+            $this->error("Preset {$presetId} not found.");
+
+            return Command::FAILURE;
+        }
+
+        // Generate a new 6-digit code (replaces any previous code).
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->update([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ]);
+
+        // Audit log.
+        Log::channel('audit')->info('Totem pairing code generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'code_prefix' => Str::limit($code, 2, ''),
+        ]);
+
+        $this->info("Pairing code for preset \"{$preset->name}\" (ID {$preset->id}): {$code}");
+
+        return Command::SUCCESS;
+    }
+}
diff --git a/app/Http/Controllers/Api/Totem/TotemAuthController.php b/app/Http/Controllers/Api/Totem/TotemAuthController.php
new file mode 100644
index 0000000..a861814
--- /dev/null
+++ b/app/Http/Controllers/Api/Totem/TotemAuthController.php
@@ -0,0 +1,176 @@
+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+
+class TotemAuthController
+{
+    /**
+     * Authenticate via pairing code and return a JWT.
+     */
+    public function __invoke(Request $request): JsonResponse
+    {
+        $key = 'totem-auth:'.$request->ip();
+
+        if (RateLimiter::tooManyAttempts($key, 10)) {
+            return response()->json(['code' => 'rate_limited'], 429);
+        }
+
+        // Validate format first (before checking the code).
+        $validator = Validator::make($request->all(), [
+            'code' => ['required', 'string', 'regex:/^\d{6}$/'],
+        ]);
+
+        if ($validator->fails()) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $code = $request->input('code');
+
+        // Rate limit after format validation.
+        RateLimiter::hit($key);
+
+        // Find matching preset (locked, atomic).
+        $preset = TotemPreset::query()
+            ->where('login_code', $code)
+            ->where('is_active', true)
+            ->lockForUpdate()
+            ->first();
+
+        // If not found or expired or consumed → same response (no oracle).
+        if (! $preset || $preset->login_code_expires_at?->isPast() || $preset->login_code_consumed_at) {
+            // Audit failure (without logging the full code).
+            Log::channel('audit')->warning('Totem pairing code failed', [
+                'ip' => (string) $request->ip(),
+                'code_prefix' => Str::limit($code, 2, ''),
+            ]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        // Atomic consume + create totem + sign JWT.
+        $result = DB::transaction(function () use ($preset, $code) {
+            \Log::channel('audit')->info('Auth tx start', [
+                'code' => $code,
+                'preset_id' => $preset->id,
+                'consumed_at_before' => $preset->login_code_consumed_at?->toAtomString(),
+            ]);
+            // Re-check under transaction lock.
+            $preset = TotemPreset::query()
+                ->whereKey($preset->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            \Log::channel('audit')->info('Auth tx recheck', [
+                'code' => $code,
+                'consumed_at_recheck' => $preset->login_code_consumed_at?->toAtomString(),
+            ]);
+
+            if ($preset->login_code_consumed_at || $preset->login_code_expires_at?->isPast()) {
+                return null;
+            }
+
+            // Mark consumed.
+            $preset->update([
+                'login_code_consumed_at' => now(),
+            ]);
+
+            \Log::channel('audit')->info('Auth tx updated', [
+                'preset_id' => $preset->id,
+                'consumed_at_set' => $preset->login_code_consumed_at?->toAtomString(),
+            ]);
+
+            // Refresh to be sure.
+            $preset->refresh();
+            \Log::channel('audit')->info('Auth tx refreshed', [
+                'consumed_at_refresh' => $preset->login_code_consumed_at?->toAtomString(),
+            ]);
+
+            // Create or update totem row for the entity.
+            $totem = Totem::query()
+                ->where('entity_id', $preset->entity_id)
+                ->first();
+
+            if (! $totem) {
+                $totem = Totem::create([
+                    'entity_id' => $preset->entity_id,
+                    'name' => $preset->name,
+                    'is_active' => true,
+                    'last_seen_at' => now(),
+                ]);
+            } else {
+                $totem->update([
+                    'is_active' => true,
+                    'last_seen_at' => now(),
+                ]);
+            }
+
+            // Resolve allowed queues (preset's queue scope).
+            $queues = $preset->queues()
+                ->where('queues.is_active', true)
+                ->pluck('queues.slug')
+                ->toArray();
+
+            // Sign JWT.
+            $token = self::signJwt([
+                'totem_id' => $totem->id,
+                'entity_id' => $preset->entity_id,
+                'preset_id' => $preset->id,
+                'queues' => $queues,
+                'iat' => time(),
+                'exp' => time() + config('services.totem.jwt_ttl', 3600),
+                'jti' => (string) Str::uuid(),
+            ]);
+
+            return [
+                'token' => $token,
+                'entity' => [
+                    'slug' => $preset->entity->slug,
+                    'name' => $preset->entity->name,
+                ],
+            ];
+        });
+
+        if (! $result) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        // Audit success.
+        Log::channel('audit')->info('Totem pairing code succeeded', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'totem_id' => $result['token'] ?? null,
+        ]);
+
+        return response()->json([
+            'token' => $result['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => config('services.totem.jwt_ttl', 3600),
+            'entity' => $result['entity'],
+        ], 200);
+    }
+
+    /**
+     * Sign a HS256 JWT.
+     */
+    private static function signJwt(array $claims): string
+    {
+        $header = base64_encode(json_encode(['alg' => 'HS256', 'typ' => 'JWT']));
+        $payload = base64_encode(json_encode($claims));
+
+        $signature = base64_encode(
+            hash_hmac('sha256', $header.'.'.$payload, config('services.totem.jwt_secret'), true)
+        );
+
+        return $header.'.'.$payload.'.'.$signature;
+    }
+}
