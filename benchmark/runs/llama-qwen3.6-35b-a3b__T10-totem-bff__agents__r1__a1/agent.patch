+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemPriorityController
+{
+    /**
+     * List priority levels for a queue.
+     */
+    public function __invoke(Request $request): JsonResponse
+    {
+        /** @var Totem $totem */
+        $totem = $request->totem;
+
+        /** @var TotemPreset $preset */
+        $preset = $request->preset;
+
+        /** @var \stdClass $payload */
+        $payload = $request->totem_payload;
+
+        // Validate entity slug matches.
+        if ($request->entity !== $preset->entity->slug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        // Resolve queue within the entity.
+        $queue = Queue::query()
+            ->where('entity_id', $preset->entity_id)
+            ->where('slug', $request->queue)
+            ->first();
+
+        if (! $queue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        // Check if queue is in the preset scope.
+        $inScope = \DB::table('totem_preset_queue')
+            ->where('preset_id', $preset->id)
+            ->where('queue_id', $queue->id)
+            ->exists();
+
+        if (! $inScope) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        // Inactive queue.
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        // Backend-owned priorities (single source of truth).
+        $priorities = [
+            ['value' => 0, 'label' => 'Normal'],
+            ['value' => 10, 'label' => 'Prioritário'],
+            ['value' => 20, 'label' => 'Prioridade 80+'],
+        ];
+
+        // Add visual specs.
+        $priorities = array_map(function ($p, $i) {
+            $p['visual'] = [
+                'color' => match ($p['value']) {
+                    0 => '#2E7D32',
+                    10 => '#C62828',
+                    20 => '#E65100',
+                    default => '#607D8B',
+                },
+                'icon' => match ($p['value']) {
+                    0 => 'person',
+                    10 => 'priority',
+                    20 => 'elderly',
+                    default => 'ticket',
+                },
+                'order' => $i + 1,
+            ];
+
+            return $p;
+        }, $priorities, range(1, count($priorities)));
+
+        return response()->json([
+            'entity' => [
+                'slug' => $preset->entity->slug,
+            ],
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priorities' => $priorities,
+        ], 200);
+    }
+}
