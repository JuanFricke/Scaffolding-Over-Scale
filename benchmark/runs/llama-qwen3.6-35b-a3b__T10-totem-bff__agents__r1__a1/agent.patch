+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController
+{
+    /**
+     * List queues available for issuance for the token's entity.
+     */
+    public function __invoke(Request $request): JsonResponse
+    {
+        /** @var Totem $totem */
+        $totem = $request->totem;
+
+        /** @var TotemPreset $preset */
+        $preset = $request->preset;
+
+        /** @var \stdClass $payload */
+        $payload = $request->totem_payload;
+
+        // Validate entity slug matches.
+        if ($request->entity !== $preset->entity->slug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        // Get queues from preset scope, active only, ordered by visual order.
+        $queues = Queue::query()
+            ->whereIn('queues.id', function ($q) use ($preset) {
+                $q->select('totem_preset_queue.queue_id')
+                    ->from('totem_preset_queue')
+                    ->where('totem_preset_queue.preset_id', $preset->id);
+            })
+            ->where('queues.is_active', true)
+            ->orderByRaw("JSON_EXTRACT(queues.labels_i18n, '$.visual.order')")
+            ->get();
+
+        $queueData = $queues->map(function (Queue $queue) {
+            $visual = $queue->labels_i18n['visual'] ?? [];
+
+            return [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => $queue->labels_i18n['description'] ?? '',
+                'visual' => [
+                    'color' => $visual['color'] ?? '#0055FF',
+                    'icon' => $visual['icon'] ?? 'ticket',
+                    'order' => $visual['order'] ?? 0,
+                ],
+                'is_active' => true,
+            ];
+        });
+
+        // Sort by visual order (1-based display position).
+        $queueData->sortBy(function ($q) {
+            return $q['visual']['order'];
+        });
+
+        return response()->json([
+            'entity' => [
+                'slug' => $preset->entity->slug,
+                'name' => $preset->entity->name,
+            ],
+            'queues' => $queueData->values(),
+        ], 200);
+    }
+}
