+it('returns the same totem on re-auth for the same entity', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->create([
+        'entity_id' => $entity->id,
+    ]);
+
+    $response1 = $this->postJson(route('totem.auth'), [
+        'code' => $preset->login_code,
+    ]);
+
+    // Need to generate a new code for the second auth.
+    $newCode = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+    // Use a direct query to reset consumed_at (the model's state is stale after first auth).
+    DB::table('totem_presets')
+        ->where('id', $preset->id)
+        ->update([
+            'login_code' => $newCode,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ]);
+    $preset->refresh();
+
+    // Debug: verify the update persisted.
+    Log::channel('audit')->info('Re-auth update', [
+        'preset_id' => $preset->id,
+        'login_code' => $preset->login_code,
+        'consumed_at' => $preset->login_code_consumed_at,
+    ]);
+
+    $response2 = $this->postJson(route('totem.auth'), [
+        'code' => $newCode,
+    ]);
+
+    // Both should return the same totem_id in the JWT payload.
+    $token1 = $response1->json('token');
+    $token2 = $response2->json('token');
+
+    $parts1 = explode('.', (string) $token1);
+    $parts2 = explode('.', (string) $token2);
+    $payload1 = json_decode(base64_decode(strtr($parts1[1], '-_', '/+')));
+    $payload2 = json_decode(base64_decode(strtr($parts2[1], '-_', '/+')));
+
+    expect($payload1->totem_id)->toBe($payload2->totem_id);
+});
