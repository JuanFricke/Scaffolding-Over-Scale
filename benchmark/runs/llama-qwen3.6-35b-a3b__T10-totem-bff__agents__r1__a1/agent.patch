+/**
+ * Generate a valid JWT for the given totem and preset.
+ */
+function generateTotemJwt(Totem $totem, TotemPreset $preset): string
+{
+    $secret = Config::get('services.totem.jwt_secret') ?? 'test-jwt-secret-for-unit-tests';
+    Config::set('services.totem.jwt_secret', $secret);
+
+    $header = base64_encode(json_encode(['alg' => 'HS256', 'typ' => 'JWT']));
+    $payload = base64_encode(json_encode([
+        'totem_id' => $totem->id,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => $preset->queues()->pluck('queues.slug')->toArray(),
+        'iat' => time(),
+        'exp' => time() + 3600,
+        'jti' => (string) Str::uuid(),
+    ]));
+
+    $signature = base64_encode(
+        hash_hmac('sha256', $header.'.'.$payload, $secret, true)
+    );
+
+    return $header.'.'.$payload.'.'.$signature;
+}
