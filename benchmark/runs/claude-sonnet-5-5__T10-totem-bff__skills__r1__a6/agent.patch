@@ -0,0 +1,37 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Actions\OpenTotemPairing;
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+
+#[Signature('totem:pairing-code {preset : Totem preset id}')]
+#[Description('Open a 10-minute pairing window for a totem preset and print its code')]
+class TotemPairingCode extends Command
+{
+    public function handle(OpenTotemPairing $openPairing): int
+    {
+        $id = (string) $this->argument('preset');
+        $preset = ctype_digit($id) ? TotemPreset::query()->find((int) $id) : null;
+
+        if (! $preset) {
+            $this->error('Totem preset not found.');
+
+            return self::FAILURE;
+        }
+
+        if (! $preset->is_active) {
+            $this->warn('Preset is inactive: the code will be rejected until it is reactivated.');
+        }
+
+        $code = $openPairing($preset);
+
+        $this->line($code);
+        $this->info('Valid for '.OpenTotemPairing::TTL_MINUTES.' minutes, single use.');
+
+        return self::SUCCESS;
+    }
+}
