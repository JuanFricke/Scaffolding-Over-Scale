--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,64 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Authenticates a paired totem from its Bearer JWT and re-validates the
+ * server-side state on every call (totem/preset active, same entity).
+ *
+ * Exposes `totem`, `totem_preset`, `totem_entity` and `totem_queue_ids` (JWT
+ * claim ∩ the preset's current queue join) as request attributes.
+ */
+class AuthenticateTotem
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+        $claims = $token ? TotemJwt::decode($token) : null;
+
+        if (! $claims
+            || ! is_int($claims['totem_id'] ?? null)
+            || ! is_int($claims['entity_id'] ?? null)
+            || ! is_int($claims['preset_id'] ?? null)
+            || ! is_array($claims['queues'] ?? null)) {
+            return $this->invalidToken();
+        }
+
+        $totem = Totem::query()->find($claims['totem_id']);
+        $preset = TotemPreset::query()->find($claims['preset_id']);
+        $entity = Entity::query()->find($claims['entity_id']);
+
+        if (! $totem || ! $totem->is_active
+            || ! $preset || ! $preset->is_active
+            || ! $entity
+            || $totem->entity_id !== $entity->id
+            || $preset->entity_id !== $entity->id) {
+            return $this->invalidToken();
+        }
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set(
+            'totem_queue_ids',
+            array_values(array_intersect($claims['queues'], $preset->entityQueueIds())),
+        );
+
+        return $next($request);
+    }
+
+    private function invalidToken(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401, ['WWW-Authenticate' => 'Bearer']);
+    }
+}
