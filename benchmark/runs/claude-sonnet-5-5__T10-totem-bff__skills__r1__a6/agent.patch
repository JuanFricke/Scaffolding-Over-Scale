+ * joined to the preset by default), the totem row and its Bearer token.
+ *
+ * @return array{entity: Entity, preset: TotemPreset, queue: Queue, totem: Totem, token: string}
+ */
+function pairedTotem(?TotemPreset $preset = null): array
+{
+    $preset ??= TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+    $preset->queues()->attach($queue);
