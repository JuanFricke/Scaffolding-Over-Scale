+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+it('opens a pairing window with a random zero-padded 6-digit code valid for 10 minutes', function () {
+    $this->freezeTime();
+    $preset = TotemPreset::factory()->create(['login_code' => null, 'login_code_expires_at' => null]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    $preset->refresh();
+
+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_expires_at->getTimestamp())->toBe(now()->addMinutes(10)->getTimestamp())
+        ->and($preset->login_code_consumed_at)->toBeNull();
+});
+
+it('prints the code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    expect(Artisan::call('totem:pairing-code', ['preset' => $preset->id]))->toBe(0)
+        ->and(Artisan::output())->toContain($preset->refresh()->login_code);
+});
+
+it('replaces the previous code and clears the consumed marker', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '111111',
+        'login_code_consumed_at' => now()->subMinute(),
+    ]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+    $preset->refresh();
+
+    expect($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->login_code)->toMatch('/^\d{6}$/');
+});
+
+it('invalidates the old code the moment a new one is generated', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '000000']);
+
+    // random_int can in theory return 000000 again; retry until it differs.
+    do {
+        $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+    } while ($preset->refresh()->login_code === '000000');
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('never hands the same code to two presets', function () {
+    $presets = TotemPreset::factory()->count(5)->create(['login_code' => null]);
+
+    foreach ($presets as $preset) {
+        $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+    }
+
+    expect(TotemPreset::query()->pluck('login_code')->unique())->toHaveCount(5);
+});
+
+it('fails for an unknown or malformed preset id', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999])
+        ->expectsOutputToContain('not found')
+        ->assertFailed();
+
+    $this->artisan('totem:pairing-code', ['preset' => '1abc'])->assertFailed();
+});
+
+it('writes an audit log without the code', function () {
+    $preset = TotemPreset::factory()->create();
+    $logged = [];
+
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->andReturnUsing(function (string $message, array $context) use (&$logged) {
+        $logged = [$message, $context];
+    });
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    expect($logged[0])->toBe('totem.pairing_code.generated')
+        ->and($logged[1]['preset_id'])->toBe($preset->id)
+        ->and(json_encode($logged))->not->toContain($preset->refresh()->login_code);
+});
