@@ -0,0 +1,50 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    /**
+     * POST api/totem/auth — exchange a pairing code for a JWT.
+     *
+     * The full code is never logged.
+     */
+    public function __invoke(Request $request, PairTotem $pairTotem): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || ! preg_match('/\A\d{6}\z/', $code)) {
+            Log::channel('audit')->warning('totem.pairing.failed', ['reason' => 'invalid_format', 'ip' => $request->ip()]);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        try {
+            $paired = $pairTotem($code);
+        } catch (InvalidPairingCodeException) {
+            Log::channel('audit')->warning('totem.pairing.failed', ['reason' => 'invalid_pairing_code', 'ip' => $request->ip()]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        Log::channel('audit')->info('totem.pairing.succeeded', [
+            'totem_id' => $paired['totem']->id,
+            'entity_id' => $paired['entity']->id,
+            'ip' => $request->ip(),
+        ]);
+
+        return response()->json([
+            'token' => $paired['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => $paired['expires_in'],
+            'entity' => ['slug' => $paired['entity']->slug, 'name' => $paired['entity']->name],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemQueueController.php b/app/Http/Controllers/Api/TotemQueueController.php
new file mode 100644
index 0000000..8c116e3
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemQueueController.php
@@ -0,0 +1,161 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Authenticated totem reads/writes. Runs behind `totem.auth`, which resolves
+ * the token's entity and effective queue scope onto the request.
+ */
+class TotemQueueController extends Controller
+{
+    private const DEFAULT_QUEUE_COLOR = '#0055FF';
+
+    private const DEFAULT_QUEUE_ICON = 'ticket';
+
+    public function index(Request $request, string $entity): JsonResponse
+    {
+        $this->authorizeEntity($request, $entity);
+
+        $preset = $request->attributes->get('totem_preset');
+
+        $queues = Queue::query()
+            ->where('entity_id', $request->attributes->get('totem_entity')->id)
+            ->whereIn('id', $request->attributes->get('totem_queue_ids'))
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->values()
+            ->map(fn (Queue $queue, int $position) => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => $this->queueAppearance($preset, $queue, 'description'),
+                'visual' => [
+                    'color' => $this->queueAppearance($preset, $queue, 'color') ?? self::DEFAULT_QUEUE_COLOR,
+                    'icon' => $this->queueAppearance($preset, $queue, 'icon') ?? self::DEFAULT_QUEUE_ICON,
+                    'order' => $position + 1,
+                ],
+                'is_active' => true,
+            ]);
+
+        return response()->json([
+            'entity' => $this->entityPayload($request),
+            'queues' => $queues,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $queue = $this->resolveQueue($request, $entity, $queue);
+
+        return response()->json([
+            'entity' => ['slug' => $request->attributes->get('totem_entity')->slug],
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priorities' => collect(TicketPriority::cases())->values()->map(
+                fn (TicketPriority $priority, int $position) => [
+                    'value' => $priority->value,
+                    'label' => $priority->label(),
+                    'visual' => $priority->visual() + ['order' => $position + 1],
+                ],
+            ),
+        ]);
+    }
+
+    public function ticket(Request $request, string $entity, string $queue, IssueTicket $issueTicket): JsonResponse
+    {
+        $queue = $this->resolveQueue($request, $entity, $queue);
+
+        $raw = $request->input('priority');
+        $priority = is_int($raw) || (is_string($raw) && preg_match('/\A\d+\z/', $raw))
+            ? TicketPriority::tryFrom((int) $raw)
+            : null;
+
+        if (! $priority) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = $issueTicket($queue, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            // Deactivated between resolveQueue() and the locked check in IssueTicket.
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priority' => ['value' => $priority->value, 'label' => $priority->label()],
+            'issued_at' => $ticket->issued_at->toIso8601ZuluString(),
+        ], 201);
+    }
+
+    /**
+     * Resolve {queue} inside the token's entity and scope, or abort with the
+     * contract error (403 entity/scope, 404 unknown, 422 inactive).
+     */
+    private function resolveQueue(Request $request, string $entity, string $slug): Queue
+    {
+        $this->authorizeEntity($request, $entity);
+
+        $queue = Queue::query()
+            ->where('entity_id', $request->attributes->get('totem_entity')->id)
+            ->where('slug', $slug)
+            ->first();
+
+        if (! $queue) {
+            abort(response()->json(['code' => 'queue_not_found'], 404));
+        }
+
+        if (! in_array($queue->id, $request->attributes->get('totem_queue_ids'), true)) {
+            $this->forbidden();
+        }
+
+        if (! $queue->is_active) {
+            abort(response()->json(['code' => 'inactive_queue'], 422));
+        }
+
+        return $queue;
+    }
+
+    private function authorizeEntity(Request $request, string $entity): void
+    {
+        if ($request->attributes->get('totem_entity')->slug !== $entity) {
+            $this->forbidden();
+        }
+    }
+
+    private function forbidden(): never
+    {
+        abort(response()->json(['code' => 'forbidden'], 403));
+    }
+
+    /**
+     * @return array{slug: string, name: string}
+     */
+    private function entityPayload(Request $request): array
+    {
+        $entity = $request->attributes->get('totem_entity');
+
+        return ['slug' => $entity->slug, 'name' => $entity->name];
+    }
+
+    /**
+     * Per-queue presentation override stored in the preset's `appearance`
+     * JSON: `{"queues": {"<queue-slug>": {"description", "color", "icon"}}}`.
+     */
+    private function queueAppearance(TotemPreset $preset, Queue $queue, string $key): ?string
+    {
+        $value = $preset->appearance['queues'][$queue->slug][$key] ?? null;
+
+        return is_string($value) ? $value : null;
+    }
+}
diff --git a/app/Http/Middleware/AuthenticateTotem.php b/app/Http/Middleware/AuthenticateTotem.php
new file mode 100644
