new file mode 100644
index 0000000..d57784b
--- /dev/null
+++ b/app/Support/TotemJwt.php
@@ -0,0 +1,94 @@
+<?php
+
+namespace App\Support;
+
+use RuntimeException;
+
+/**
+ * Minimal HS256 JWT signer/verifier for the totem credential.
+ *
+ * Verification is strict: only `alg: HS256` is accepted (never `none`), the
+ * signature is compared in constant time and `exp` is mandatory. Time comes
+ * from `now()` so it follows Carbon's test clock.
+ */
+class TotemJwt
+{
+    private const MIN_SECRET_LENGTH = 32;
+
+    /**
+     * @param  array<string, mixed>  $claims
+     */
+    public static function encode(array $claims): string
+    {
+        $header = self::base64UrlEncode(json_encode(['alg' => 'HS256', 'typ' => 'JWT'], JSON_THROW_ON_ERROR));
+        $payload = self::base64UrlEncode(json_encode($claims, JSON_THROW_ON_ERROR));
+
+        return $header.'.'.$payload.'.'.self::base64UrlEncode(self::sign($header.'.'.$payload));
+    }
+
+    /**
+     * @return array<string, mixed>|null Claims, or null when the token is malformed, forged or expired.
+     */
+    public static function decode(string $token): ?array
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            return null;
+        }
+
+        [$header, $payload, $signature] = $parts;
+
+        $decodedHeader = self::decodeJson($header);
+
+        if (($decodedHeader['alg'] ?? null) !== 'HS256') {
+            return null;
+        }
+
+        $expected = self::base64UrlEncode(self::sign($header.'.'.$payload));
+
+        if (! hash_equals($expected, $signature)) {
+            return null;
+        }
+
+        $claims = self::decodeJson($payload);
+
+        if ($claims === null || ! is_int($claims['exp'] ?? null) || $claims['exp'] <= now()->getTimestamp()) {
+            return null;
+        }
+
+        return $claims;
+    }
+
+    private static function sign(string $data): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if (strlen($secret) < self::MIN_SECRET_LENGTH) {
+            throw new RuntimeException('services.totem.jwt_secret (TOTEM_JWT_SECRET) must be at least 32 characters.');
+        }
+
+        return hash_hmac('sha256', $data, $secret, true);
+    }
+
+    /**
+     * @return array<string, mixed>|null
+     */
+    private static function decodeJson(string $segment): ?array
+    {
+        $raw = base64_decode(strtr($segment, '-_', '+/'), true);
+
+        if ($raw === false) {
+            return null;
+        }
+
+        $decoded = json_decode($raw, true);
+
+        return is_array($decoded) ? $decoded : null;
+    }
+
+    private static function base64UrlEncode(string $data): string
+    {
+        return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');
+    }
+}
