+    expect(array_column($logged, 0))->toBe(['totem.pairing.failed', 'totem.pairing.succeeded'])
+        ->and(json_encode($logged))->not->toContain($preset->login_code)->not->toContain('000001');
+});
diff --git a/tests/Feature/TotemCorsTest.php b/tests/Feature/TotemCorsTest.php
new file mode 100644
index 0000000..51624d7
--- /dev/null
+++ b/tests/Feature/TotemCorsTest.php
@@ -0,0 +1,60 @@
+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('answers the preflight for a localhost origin with 204 and echoes the origin', function (string $origin) {
+    $this->call('OPTIONS', '/api/totem/auth', server: [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+        'HTTP_ACCESS_CONTROL_REQUEST_HEADERS' => 'content-type,authorization',
+    ])
+        ->assertNoContent()
+        ->assertHeader('Access-Control-Allow-Origin', $origin)
+        ->assertHeaderMissing('Access-Control-Allow-Credentials');
+})->with([
+    'http://localhost:8081',
+    'http://localhost',
+    'https://localhost:3000',
+    'http://127.0.0.1:5000',
+    'https://127.0.0.1',
+]);
+
+it('sends no allow-origin header for any other origin', function (string $origin) {
+    $this->call('OPTIONS', '/api/totem/auth', server: [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ])->assertHeaderMissing('Access-Control-Allow-Origin');
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'], ['Origin' => $origin])
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+})->with([
+    'https://evil.example',
+    'http://localhost.evil.example',
+    'http://evil.example:8081',
+    'http://127.0.0.1.evil.example',
+    'ftp://localhost',
+    'null',
+]);
+
+it('adds the allow-origin header to real responses, errors included', function () {
+    $this->postJson('/api/totem/auth', ['code' => 'bad'], ['Origin' => 'http://localhost:8081'])
+        ->assertStatus(400)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+});
+
+it('allows the optional TOTEM_WEB_ORIGIN and nothing else extra', function () {
+    config(['cors.allowed_origins' => ['https://totem.example.com']]);
+
+    $this->postJson('/api/totem/auth', ['code' => 'bad'], ['Origin' => 'https://totem.example.com'])
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem.example.com');
+
+    $this->postJson('/api/totem/auth', ['code' => 'bad'], ['Origin' => 'https://other.example.com'])
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+});
+
+it('does not apply CORS outside api/*', function () {
+    $this->get('/up', ['Origin' => 'http://localhost:8081'])
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+});
diff --git a/tests/Feature/TotemEndpointsTest.php b/tests/Feature/TotemEndpointsTest.php
new file mode 100644
index 0000000..0bfbce6
--- /dev/null
+++ b/tests/Feature/TotemEndpointsTest.php
@@ -0,0 +1,321 @@
+<?php
+
+use App\Actions\OpenTotemPairing;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+// --- totem.auth middleware -------------------------------------------------
+
+it('rejects missing, malformed and forged tokens with 401 invalid_token', function (?string $header) {
+    $totem = pairedTotem();
+
+    $this->getJson("/api/{$totem['entity']->slug}/queues", $header === null ? [] : ['Authorization' => $header])
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+})->with([
+    'missing' => [null],
+    'not bearer' => ['Basic abc'],
+    'garbage' => ['Bearer garbage'],
+    'empty bearer' => ['Bearer '],
+]);
+
+function claimsFor(array $totem, array $override = []): array
+{
+    return $override + [
+        'totem_id' => $totem['totem']->id,
+        'entity_id' => $totem['entity']->id,
+        'preset_id' => $totem['preset']->id,
+        'queues' => [$totem['queue']->id],
+        'iat' => now()->getTimestamp(),
+        'exp' => now()->addHour()->getTimestamp(),
+        'jti' => 'x',
+    ];
+}
+
+it('rejects an expired token', function () {
+    $totem = pairedTotem();
+
+    $this->travel(3601)->seconds();
+
+    $this->getJson("/api/{$totem['entity']->slug}/queues", bearer($totem['token']))
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a correctly signed token whose claims do not match server state', function (string $case) {
+    $totem = pairedTotem();
+    $other = TotemPreset::factory()->create();
+    $otherTotem = Totem::factory()->for($other->entity)->create();
+
+    match ($case) {
+        'totem missing' => $totem['totem']->delete(),
+        'totem inactive' => $totem['totem']->update(['is_active' => false]),
+        'preset missing' => $totem['preset']->delete(),
+        'preset inactive' => $totem['preset']->update(['is_active' => false]),
+        'entity deleted' => $totem['entity']->delete(),
+        default => null,
+    };
+
+    $claims = match ($case) {
+        'entity claim mismatch' => claimsFor($totem, ['entity_id' => $other->entity_id]),
+        'totem of other entity' => claimsFor($totem, ['totem_id' => $otherTotem->id]),
+        'preset of other entity' => claimsFor($totem, ['preset_id' => $other->id]),
+        'missing queues claim' => array_diff_key(claimsFor($totem), ['queues' => 1]),
+        'string ids' => claimsFor($totem, ['totem_id' => (string) $totem['totem']->id]),
+        default => claimsFor($totem),
+    };
+
+    $this->getJson("/api/{$totem['entity']->slug}/queues", bearer(TotemJwt::encode($claims)))
+        ->assertUnauthorized()
+        ->assertExactJson(['code' => 'invalid_token']);
+})->with([
+    'totem missing', 'totem inactive', 'preset missing', 'preset inactive', 'entity deleted',
+    'entity claim mismatch', 'totem of other entity', 'preset of other entity',
+    'missing queues claim', 'string ids',
+]);
+
+it('quietly updates last_seen_at on every authenticated call', function () {
+    $this->freezeTime();
+    $totem = pairedTotem();
+    $this->travel(5)->minutes();
+
+    $this->getJson("/api/{$totem['entity']->slug}/queues", bearer($totem['token']))->assertOk();
+
+    expect($totem['totem']->refresh()->last_seen_at->getTimestamp())->toBe(now()->getTimestamp());
+});
+
+// --- GET queues --------------------------------------------------------------
+
+it('lists only active preset queues of the entity, ordered by name with 1-based order', function () {
+    $totem = pairedTotem();
+    $entity = $totem['entity'];
+    $preset = $totem['preset'];
+
+    $inactive = Queue::factory()->for($entity)->create(['name' => 'Inativa', 'is_active' => false]);
+    $outside = Queue::factory()->for($entity)->create(['name' => 'Fora do preset']);
+    $alpha = Queue::factory()->for($entity)->create(['name' => 'Atendimento', 'slug' => 'atendimento']);
+    $preset->queues()->attach([$inactive->id, $alpha->id]);
+    // Joined after pairing: not in the token's claim, so still invisible.
+
+    // A fresh pairing picks up everything in the join at that moment.
+    $preset->update(['appearance' => ['queues' => ['atendimento' => [
+        'description' => 'Balcão', 'color' => '#111111', 'icon' => 'desk',
+    ]]]]);
+    $token = $this->postJson('/api/totem/auth', ['code' => (new OpenTotemPairing)($preset->refresh())])->json('token');
+
+    $this->getJson("/api/{$entity->slug}/queues", bearer($token))
+        ->assertOk()
+        ->assertExactJson([
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+            'queues' => [
+                [
+                    'slug' => 'atendimento',
+                    'label' => 'Atendimento',
+                    'description' => 'Balcão',
+                    'visual' => ['color' => '#111111', 'icon' => 'desk', 'order' => 1],
+                    'is_active' => true,
+                ],
+                [
+                    'slug' => 'geral',
+                    'label' => 'Geral',
+                    'description' => null,
+                    'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => 2],
+                    'is_active' => true,
+                ],
+            ],
+        ]);
+
+    expect($outside->id)->not->toBeNull();
+});
+
+it('applies the intersection of the token claim and the current preset join', function () {
+    $totem = pairedTotem();
+    $late = Queue::factory()->for($totem['entity'])->create(['slug' => 'late']);
+
+    // Joined after pairing: not in the claim.
+    $totem['preset']->queues()->attach($late);
+    $this->getJson("/api/{$totem['entity']->slug}/queues", bearer($totem['token']))
+        ->assertOk()->assertJsonCount(1, 'queues')->assertJsonPath('queues.0.slug', 'geral');
+
+    // Removed after pairing: gone immediately.
+    $totem['preset']->queues()->detach($totem['queue']);
+    $this->getJson("/api/{$totem['entity']->slug}/queues", bearer($totem['token']))
+        ->assertOk()->assertExactJson([
+            'entity' => ['slug' => $totem['entity']->slug, 'name' => $totem['entity']->name],
+            'queues' => [],
+        ]);
+});
+
+it('forbids a different entity slug, including a real foreign entity', function () {
+    $totem = pairedTotem();
+    $foreign = Entity::factory()->create();
+
+    foreach ([$foreign->slug, 'does-not-exist'] as $slug) {
+        $this->getJson("/api/{$slug}/queues", bearer($totem['token']))
+            ->assertForbidden()
+            ->assertExactJson(['code' => 'forbidden']);
+    }
+});
+
+// --- GET priorities ------------------------------------------------------------
+
+it('serves the backend-owned priorities', function () {
+    $t = pairedTotem();
+
+    $this->getJson("/api/{$t['entity']->slug}/geral/priorities", bearer($t['token']))
+        ->assertOk()
+        ->assertExactJson([
+            'entity' => ['slug' => $t['entity']->slug],
+            'queue' => ['slug' => 'geral', 'label' => 'Geral'],
+            'priorities' => [
+                ['value' => 0, 'label' => 'Normal', 'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1]],
+                ['value' => 10, 'label' => 'Prioritário', 'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2]],
+                ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => ['color' => '#6A1B9A', 'icon' => 'elderly', 'order' => 3]],
+            ],
+        ]);
+});
+
+it('resolves queues within the token entity: 404 unknown, 403 out of scope, 422 inactive', function () {
+    $t = pairedTotem();
+    $outside = Queue::factory()->for($t['entity'])->create(['slug' => 'fora']);
+    $inactive = Queue::factory()->for($t['entity'])->create(['slug' => 'off', 'is_active' => false]);
+    $t['preset']->queues()->attach($inactive);
+    $foreignQueue = Queue::factory()->for(Entity::factory())->create(['slug' => 'alheia']);
+
+    $base = "/api/{$t['entity']->slug}";
+    $auth = bearer($t['token']);
+
+    $this->getJson("$base/nope/priorities", $auth)->assertNotFound()->assertExactJson(['code' => 'queue_not_found']);
+    $this->getJson("$base/{$foreignQueue->slug}/priorities", $auth)->assertNotFound()->assertExactJson(['code' => 'queue_not_found']);
+    $this->getJson("$base/fora/priorities", $auth)->assertForbidden()->assertExactJson(['code' => 'forbidden']);
+    $this->getJson('/api/other-entity/geral/priorities', $auth)->assertForbidden()->assertExactJson(['code' => 'forbidden']);
+
+    // The inactive queue was joined after pairing, so it is outside the claim (403);
+    // a fresh claim that includes it gets 422.
+    $this->getJson("$base/off/priorities", $auth)->assertForbidden();
+
+    $fresh = bearer($this->postJson('/api/totem/auth', ['code' => (new OpenTotemPairing)($t['preset']->refresh())])->json('token'));
+
+    $this->getJson("$base/off/priorities", $fresh)->assertStatus(422)->assertExactJson(['code' => 'inactive_queue']);
+
+    expect($outside->id)->not->toBeNull();
+});
+
+it('requires a token on the data endpoints', function () {
+    $t = pairedTotem();
+
+    $this->getJson("/api/{$t['entity']->slug}/geral/priorities")->assertUnauthorized();
+    $this->postJson("/api/{$t['entity']->slug}/geral/ticket", ['priority' => 0])->assertUnauthorized();
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+// --- POST ticket -----------------------------------------------------------------
+
+it('issues sequential totem tickets through IssueTicket', function () {
+    $this->freezeTime();
+    $t = pairedTotem();
+    $url = "/api/{$t['entity']->slug}/geral/ticket";
+
+    $this->postJson($url, ['priority' => 0], bearer($t['token']))
+        ->assertCreated()
+        ->assertExactJson([
+            'slug' => 'A001',
+            'queue' => ['slug' => 'geral', 'label' => 'Geral'],
+            'priority' => ['value' => 0, 'label' => 'Normal'],
+            'issued_at' => now()->utc()->format('Y-m-d\TH:i:s\Z'),
+        ]);
+
+    $this->postJson($url, ['priority' => 20], bearer($t['token']))
+        ->assertCreated()
+        ->assertJsonPath('slug', 'A002')
+        ->assertJsonPath('priority', ['value' => 20, 'label' => 'Prioridade 80+']);
+
+    $ticket = Ticket::query()->where('code', 'A002')->sole();
+
+    expect($ticket)
+        ->queue_id->toBe($t['queue']->id)
+        ->priority->toBe(20)
+        ->channel->toBe(TicketChannel::Totem)
+        ->status->toBe(TicketStatus::Waiting);
+});
+
+it('rejects priorities outside the backend-owned set with 422 and creates nothing', function (mixed $priority) {
+    $t = pairedTotem();
+
+    $this->postJson("/api/{$t['entity']->slug}/geral/ticket", ['priority' => $priority], bearer($t['token']))
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+})->with([5, -10, 999, '5', 'abc', 10.5, true, null, [[10]]]);
+
+it('rejects a missing priority', function () {
+    $t = pairedTotem();
+
+    $this->postJson("/api/{$t['entity']->slug}/geral/ticket", [], bearer($t['token']))
+        ->assertStatus(422)->assertExactJson(['code' => 'invalid_priority']);
+});
+
+it('rejects issuance into an inactive queue with 422 and creates nothing', function () {
+    $t = pairedTotem();
+    $t['queue']->update(['is_active' => false]);
+
+    $this->postJson("/api/{$t['entity']->slug}/geral/ticket", ['priority' => 0], bearer($t['token']))
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('does not let a token issue into foreign, unknown or removed queues', function () {
+    $t = pairedTotem();
+    $foreign = Queue::factory()->for(Entity::factory())->create(['slug' => 'alheia']);
+    $sibling = Queue::factory()->for($t['entity'])->create(['slug' => 'irma']);
+    $base = "/api/{$t['entity']->slug}";
+    $auth = bearer($t['token']);
+
+    $this->postJson("$base/{$foreign->slug}/ticket", ['priority' => 0], $auth)->assertNotFound();
+    $this->postJson("$base/nope/ticket", ['priority' => 0], $auth)->assertNotFound();
+    $this->postJson("$base/irma/ticket", ['priority' => 0], $auth)->assertForbidden();
+    $this->postJson("/api/{$foreign->entity->slug}/alheia/ticket", ['priority' => 0], $auth)->assertForbidden();
+
+    $t['preset']->queues()->detach($t['queue']);
+    $this->postJson("$base/geral/ticket", ['priority' => 0], $auth)->assertForbidden();
+
+    expect(Ticket::query()->count())->toBe(0)->and($sibling->id)->not->toBeNull();
+});
+
+it('throttles issuance to 30 per minute per totem', function () {
+    $t = pairedTotem();
+    $url = "/api/{$t['entity']->slug}/geral/ticket";
+
+    foreach (range(1, 30) as $_) {
+        $this->postJson($url, ['priority' => 0], bearer($t['token']))->assertCreated();
+    }
+
+    $this->postJson($url, ['priority' => 0], bearer($t['token']))
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+
+    expect(Ticket::query()->count())->toBe(30);
+});
+
+it('does not count unauthenticated calls against the issuance throttle', function () {
+    $t = pairedTotem();
+    $url = "/api/{$t['entity']->slug}/geral/ticket";
+
+    foreach (range(1, 40) as $_) {
+        $this->postJson($url, ['priority' => 0])->assertUnauthorized();
+    }
+
+    $this->postJson($url, ['priority' => 0], bearer($t['token']))->assertCreated();
+});
diff --git a/tests/Feature/TotemJwtTest.php b/tests/Feature/TotemJwtTest.php
new file mode 100644
index 0000000..bb17b4e
--- /dev/null
+++ b/tests/Feature/TotemJwtTest.php
@@ -0,0 +1,65 @@
+<?php
+
+use App\Support\TotemJwt;
+
+function forgeJwt(array $header, array $claims, string $secret): string
+{
+    $b64 = fn (string $s) => rtrim(strtr(base64_encode($s), '+/', '-_'), '=');
+    $signing = $b64(json_encode($header)).'.'.$b64(json_encode($claims));
+
+    return $signing.'.'.$b64(hash_hmac('sha256', $signing, $secret, true));
+}
+
+it('round-trips claims through an HS256 token', function () {
+    $claims = ['totem_id' => 1, 'exp' => now()->addHour()->getTimestamp()];
+
+    $token = TotemJwt::encode($claims);
+
+    expect(explode('.', $token))->toHaveCount(3)
+        ->and(TotemJwt::decode($token))->toBe($claims);
+});
+
+it('rejects tampered payloads, wrong secrets and malformed tokens', function () {
+    $claims = ['totem_id' => 1, 'exp' => now()->addHour()->getTimestamp()];
+    $token = TotemJwt::encode($claims);
+    [$header, , $signature] = explode('.', $token);
+    $other = rtrim(strtr(base64_encode(json_encode(['totem_id' => 2] + $claims)), '+/', '-_'), '=');
+
+    expect(TotemJwt::decode("$header.$other.$signature"))->toBeNull()
+        ->and(TotemJwt::decode(forgeJwt(['alg' => 'HS256'], $claims, str_repeat('x', 40))))->toBeNull()
+        ->and(TotemJwt::decode('not-a-jwt'))->toBeNull()
+        ->and(TotemJwt::decode('a.b.c'))->toBeNull()
+        ->and(TotemJwt::decode(''))->toBeNull();
+});
+
+it('rejects non-HS256 algorithms even when correctly signed', function () {
+    $claims = ['exp' => now()->addHour()->getTimestamp()];
+    $secret = config('services.totem.jwt_secret');
+
+    expect(TotemJwt::decode(forgeJwt(['alg' => 'HS512'], $claims, $secret)))->toBeNull()
+        ->and(TotemJwt::decode(forgeJwt(['alg' => 'none'], $claims, $secret)))->toBeNull()
+        ->and(TotemJwt::decode(forgeJwt([], $claims, $secret)))->toBeNull()
+        ->and(TotemJwt::decode(forgeJwt(['alg' => 'none'], $claims, '').''))->toBeNull();
+});
+
+it('rejects expired tokens and tokens without an exp', function () {
+    $token = TotemJwt::encode(['exp' => now()->addMinute()->getTimestamp()]);
+
+    expect(TotemJwt::decode($token))->not->toBeNull();
+
+    $this->travel(61)->seconds();
+
+    expect(TotemJwt::decode($token))->toBeNull()
+        ->and(TotemJwt::decode(TotemJwt::encode(['totem_id' => 1])))->toBeNull()
+        ->and(TotemJwt::decode(TotemJwt::encode(['exp' => 'tomorrow'])))->toBeNull();
+});
+
+it('refuses to sign with a missing or short secret', function () {
+    config(['services.totem.jwt_secret' => 'too-short']);
+
+    expect(fn () => TotemJwt::encode(['exp' => 1]))->toThrow(RuntimeException::class);
+
+    config(['services.totem.jwt_secret' => null]);
+
+    expect(fn () => TotemJwt::encode(['exp' => 1]))->toThrow(RuntimeException::class);
+});
diff --git a/tests/Feature/TotemModelsTest.php b/tests/Feature/TotemModelsTest.php
new file mode 100644
index 0000000..0a7087c
--- /dev/null
+++ b/tests/Feature/TotemModelsTest.php
@@ -0,0 +1,84 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+it('builds a ready-to-use preset from its factory', function () {
+    $presets = TotemPreset::factory()->count(3)->create();
+
+    foreach ($presets as $preset) {
+        expect($preset->login_code)->toMatch('/^\d{6}$/')
+            ->and($preset->login_code_expires_at->isFuture())->toBeTrue()
+            ->and($preset->login_code_expires_at->lte(now()->addMinutes(10)))->toBeTrue()
+            ->and($preset->login_code_consumed_at)->toBeNull()
+            ->and($preset->is_active)->toBeTrue()
+            ->and($preset->entity)->toBeInstanceOf(Entity::class);
+    }
+
+    expect($presets->pluck('login_code')->unique())->toHaveCount(3);
+});
+
+it('keeps preset login codes unique', function () {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    expect(fn () => TotemPreset::factory()->create(['login_code' => '123456']))->toThrow(QueryException::class);
+});
+
+it('relates entities, presets, totems and queues', function () {
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->for($preset->entity)->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue);
+
+    expect($preset->entity->totems->modelKeys())->toBe([$totem->id])
+        ->and($preset->entity->totemPresets->modelKeys())->toBe([$preset->id])
+        ->and($preset->queues->modelKeys())->toBe([$queue->id])
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->toBeNull();
+
+    $preset->queues()->detach($queue);
+
+    expect($preset->queues()->count())->toBe(0);
+});
+
+it('rejects attaching the same queue to a preset twice', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue);
+
+    expect(fn () => $preset->queues()->attach($queue))->toThrow(QueryException::class);
+});
+
+it('cascades presets, totems and joins when the entity or queue is hard-deleted', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue);
+    Totem::factory()->for($preset->entity)->create();
+
+    $queue->delete();
+    expect(DB::table('totem_preset_queue')->count())->toBe(0);
+
+    $preset->queues()->attach(Queue::factory()->for($preset->entity)->create());
+    $preset->entity->forceDelete();
+
+    expect(TotemPreset::query()->count())->toBe(0)
+        ->and(Totem::query()->count())->toBe(0)
+        ->and(DB::table('totem_preset_queue')->count())->toBe(0);
+});
+
+it('does not mass-assign pairing state', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '111111']);
+
+    $preset->fill(['login_code' => '222222', 'login_code_consumed_at' => now()])->save();
+
+    expect($preset->refresh()->login_code)->toBe('111111')
+        ->and($preset->login_code_consumed_at)->toBeNull();
+});
