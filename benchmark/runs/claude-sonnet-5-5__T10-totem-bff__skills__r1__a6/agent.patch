@@ -0,0 +1,52 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Log;
+
+class OpenTotemPairing
+{
+    public const TTL_MINUTES = 10;
+
+    /**
+     * Open a pairing window: give the preset a fresh single-use 6-digit code
+     * (replacing any previous one) and return it. The code is only ever shown
+     * to the operator, never logged.
+     */
+    public function __invoke(TotemPreset $preset): string
+    {
+        for ($attempt = 1; ; $attempt++) {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+            // login_code is unique across presets (consumed codes stay on their row);
+            // retry on a collision, including one lost in a race with another preset.
+            if (TotemPreset::query()->where('login_code', $code)->whereKeyNot($preset->id)->exists()) {
+                continue;
+            }
+
+            try {
+                $preset->forceFill([
+                    'login_code' => $code,
+                    'login_code_expires_at' => now()->addMinutes(self::TTL_MINUTES),
+                    'login_code_consumed_at' => null,
+                ])->save();
+            } catch (QueryException $e) {
+                if ($attempt >= 10) {
+                    throw $e;
+                }
+
+                continue;
+            }
+
+            Log::channel('audit')->info('totem.pairing_code.generated', [
+                'preset_id' => $preset->id,
+                'entity_id' => $preset->entity_id,
+                'expires_at' => $preset->login_code_expires_at->toIso8601String(),
+            ]);
+
+            return $code;
+        }
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
new file mode 100644
index 0000000..d2a2cb2
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,81 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+
+class PairTotem
+{
+    /**
+     * Exchange a pairing code for a totem credential.
+     *
+     * Unknown, expired, consumed and inactive-preset codes all raise the same
+     * exception so callers cannot tell them apart.
+     *
+     * @return array{token: string, expires_in: int, entity: Entity, totem: Totem}
+     *
+     * @throws InvalidPairingCodeException
+     */
+    public function __invoke(string $code): array
+    {
+        return DB::transaction(function () use ($code): array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (! $preset
+                || ! $preset->is_active
+                || $preset->login_code_consumed_at !== null
+                || $preset->login_code_expires_at === null
+                || $preset->login_code_expires_at->lte(now())) {
+                throw new InvalidPairingCodeException;
+            }
+
+            $entity = $preset->entity;
+
+            if (! $entity) {
+                throw new InvalidPairingCodeException;
+            }
+
+            // lockForUpdate() is a no-op on SQLite; the conditional update keeps
+            // consumption single-use there as well.
+            $consumed = TotemPreset::query()
+                ->whereKey($preset->id)
+                ->whereNull('login_code_consumed_at')
+                ->update(['login_code_consumed_at' => now()]);
+
+            if ($consumed !== 1) {
+                throw new InvalidPairingCodeException;
+            }
+
+            $totem = Totem::query()->create([
+                'entity_id' => $entity->id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $ttl = (int) config('services.totem.jwt_ttl', 3600);
+            $issuedAt = now()->getTimestamp();
+
+            $token = TotemJwt::encode([
+                'totem_id' => $totem->id,
+                'entity_id' => $entity->id,
+                'preset_id' => $preset->id,
+                'queues' => $preset->entityQueueIds(),
+                'iat' => $issuedAt,
+                'exp' => $issuedAt + $ttl,
+                'jti' => (string) Str::uuid(),
+            ]);
+
+            return ['token' => $token, 'expires_in' => $ttl, 'entity' => $entity, 'totem' => $totem];
+        });
+    }
+}
