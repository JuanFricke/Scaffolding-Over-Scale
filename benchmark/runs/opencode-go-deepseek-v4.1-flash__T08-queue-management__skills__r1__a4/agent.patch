@@ -0,0 +1,86 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        if ((int) $targetMembership->entity_id !== (int) $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => __('validation.exists', ['attribute' => 'entity_membership_id']),
+            ]);
+        }
+
+        $permissions = $this->validatedPermissions($permissions);
+
+        $keys = [
+            'entity_membership_id' => $targetMembership->id,
+            'queue_id' => $queue->id,
+        ];
+
+        if ($permissions === []) {
+            $deleted = QueueAccess::query()->where($keys)->delete();
+
+            if ($deleted > 0) {
+                $this->audit('queue.access.revoked', $actor, $queue, $targetMembership);
+            }
+
+            return;
+        }
+
+        QueueAccess::query()->updateOrCreate($keys, ['permissions' => $permissions]);
+
+        $this->audit('queue.access.granted', $actor, $queue, $targetMembership);
+    }
+
+    /**
+     * @param  array<int|string, mixed>  $permissions
+     * @return list<string>
+     */
+    private function validatedPermissions(array $permissions): array
+    {
+        if (! array_is_list($permissions)) {
+            throw $this->invalidPermissions();
+        }
+
+        foreach ($permissions as $permission) {
+            if (! is_string($permission) || QueuePermission::tryFrom($permission) === null) {
+                throw $this->invalidPermissions();
+            }
+        }
+
+        return array_values(array_unique($permissions));
+    }
+
+    private function invalidPermissions(): ValidationException
+    {
+        return ValidationException::withMessages([
+            'permissions' => __('validation.in', ['attribute' => 'permissions']),
+        ]);
+    }
+
+    private function audit(string $message, User $actor, Queue $queue, EntityMembership $membership): void
+    {
+        Log::channel('audit')->info($message, [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $membership->id,
+        ]);
+    }
+}
