+    $membership = EntityMembership::factory()->create();
+
+    $access = QueueAccess::factory()->for($membership)->create();
+
+    expect($access->membership->is($membership))->toBeTrue()
+        ->and($access->queue->entity_id)->toBe($membership->entity_id);
+});
+
+it('cascades access rows when a membership is deleted', function () {
+    $access = QueueAccess::factory()->create();
+    $membership = $access->membership;
+
+    $membership->delete();
+
+    expect(QueueAccess::whereKey($access->id)->exists())->toBeFalse();
+});
+
+it('cascades access rows when a queue is deleted', function () {
+    $access = QueueAccess::factory()->create();
+    $queue = $access->queue;
+
+    $queue->delete();
+
+    expect(QueueAccess::whereKey($access->id)->exists())->toBeFalse();
+});
+
+it('enforces one access row per membership and queue', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    QueueAccess::factory()->for($membership, 'membership')->for($queue)->create();
+
+    expect(fn () => QueueAccess::factory()->for($membership, 'membership')->for($queue)->create())
+        ->toThrow(QueryException::class);
+});
diff --git a/tests/Feature/Queue/QueuePolicyTest.php b/tests/Feature/Queue/QueuePolicyTest.php
new file mode 100644
index 0000000..e0be2a3
--- /dev/null
+++ b/tests/Feature/Queue/QueuePolicyTest.php
@@ -0,0 +1,120 @@
+<?php
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Policies\QueuePolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function queuePolicyFixtures(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $stranger = User::factory()->create();
+    $otherOwner = queueManagerFor(Entity::factory()->create());
+
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    $employeeMembership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    return compact('entity', 'owner', 'admin', 'employee', 'stranger', 'otherOwner', 'employeeMembership', 'queue');
+}
+
+it('allows only owner and admin to create a queue in the entity', function () {
+    $f = queuePolicyFixtures();
+    $policy = new QueuePolicy;
+
+    expect($policy->create($f['owner'], $f['entity']))->toBeTrue()
+        ->and($policy->create($f['admin'], $f['entity']))->toBeTrue()
+        ->and($policy->create($f['employee'], $f['entity']))->toBeFalse()
+        ->and($policy->create($f['stranger'], $f['entity']))->toBeFalse()
+        ->and($policy->create($f['otherOwner'], $f['entity']))->toBeFalse();
+
+    expect(Gate::forUser($f['owner'])->allows('create', [Queue::class, $f['entity']]))->toBeTrue()
+        ->and(Gate::forUser($f['employee'])->allows('create', [Queue::class, $f['entity']]))->toBeFalse();
+});
+
+it('allows only owner and admin to update or manage access', function () {
+    $f = queuePolicyFixtures();
+    $policy = new QueuePolicy;
+
+    foreach (['update', 'manageAccess'] as $ability) {
+        expect($policy->{$ability}($f['owner'], $f['queue']))->toBeTrue()
+            ->and($policy->{$ability}($f['admin'], $f['queue']))->toBeTrue()
+            ->and($policy->{$ability}($f['employee'], $f['queue']))->toBeFalse()
+            ->and($policy->{$ability}($f['stranger'], $f['queue']))->toBeFalse()
+            ->and($policy->{$ability}($f['otherOwner'], $f['queue']))->toBeFalse();
+    }
+});
+
+it('lets managers call without a grant row', function () {
+    $f = queuePolicyFixtures();
+    $policy = new QueuePolicy;
+
+    expect($policy->call($f['owner'], $f['queue']))->toBeTrue()
+        ->and($policy->call($f['admin'], $f['queue']))->toBeTrue();
+});
+
+it('denies call to an employee without a grant', function () {
+    $f = queuePolicyFixtures();
+    $policy = new QueuePolicy;
+
+    expect($policy->call($f['employee'], $f['queue']))->toBeFalse()
+        ->and($policy->call($f['stranger'], $f['queue']))->toBeFalse()
+        ->and($policy->call($f['otherOwner'], $f['queue']))->toBeFalse();
+});
+
+it('allows call to an employee with a call grant on that queue', function () {
+    $f = queuePolicyFixtures();
+    QueueAccess::factory()->for($f['employeeMembership'], 'membership')->for($f['queue'])->create([
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+
+    expect((new QueuePolicy)->call($f['employee'], $f['queue']))->toBeTrue();
+});
+
+it('denies call when the grant is for another queue', function () {
+    $f = queuePolicyFixtures();
+    $otherQueue = Queue::factory()->for($f['entity'])->create();
+    QueueAccess::factory()->for($f['employeeMembership'], 'membership')->for($otherQueue)->create([
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+
+    expect((new QueuePolicy)->call($f['employee'], $f['queue']))->toBeFalse()
+        ->and((new QueuePolicy)->call($f['employee'], $otherQueue))->toBeTrue();
+});
+
+it('denies call when the grant does not contain call', function (array $permissions) {
+    $f = queuePolicyFixtures();
+    QueueAccess::factory()->for($f['employeeMembership'], 'membership')->for($f['queue'])->create([
+        'permissions' => $permissions,
+    ]);
+
+    expect((new QueuePolicy)->call($f['employee'], $f['queue']))->toBeFalse();
+})->with([
+    'empty' => [[]],
+    'other permission' => [['view']],
+    'wrong type' => [[1]],
+]);
+
+it('denies call when the stored permissions value is corrupted', function (string $stored) {
+    $f = queuePolicyFixtures();
+    $access = QueueAccess::factory()->for($f['employeeMembership'], 'membership')->for($f['queue'])->create();
+
+    QueueAccess::query()->whereKey($access->id)->update(['permissions' => $stored]);
+
+    expect((new QueuePolicy)->call($f['employee'], $f['queue']))->toBeFalse();
+})->with([
+    'json scalar' => [json_encode('call')],
+    'invalid json' => ['not-json'],
+    'json object' => [json_encode(['permission' => 'call'])],
+]);
diff --git a/tests/Feature/Queue/SetQueueAccessTest.php b/tests/Feature/Queue/SetQueueAccessTest.php
new file mode 100644
index 0000000..7576d5c
--- /dev/null
+++ b/tests/Feature/Queue/SetQueueAccessTest.php
@@ -0,0 +1,177 @@
+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Psr\Log\LoggerInterface;
+
+uses(RefreshDatabase::class);
+
+function auditLoggerExpecting(string $message, array $context): void
+{
+    $audit = Mockery::mock(LoggerInterface::class);
+    $audit->shouldReceive('info')->once()->with($message, Mockery::on(
+        fn ($actual) => is_array($actual)
+            && $actual['actor_id'] === $context['actor_id']
+            && $actual['queue_id'] === $context['queue_id']
+            && $actual['entity_membership_id'] === $context['entity_membership_id'],
+    ));
+    Log::shouldReceive('channel')->once()->with('audit')->andReturn($audit);
+}
+
+it('grants call access to a membership and audits it', function () {
+    $entity = Entity::factory()->create();
+    $manager = queueManagerFor($entity);
+    $target = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($target)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    auditLoggerExpecting('queue.access.granted', [
+        'actor_id' => $manager->id,
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $membership->id,
+    ]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, [QueuePermission::Call->value]);
+
+    $access = QueueAccess::where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->first();
+
+    expect($access)->not->toBeNull()
+        ->and($access->permissions)->toBe([QueuePermission::Call->value]);
+});
+
+it('upserts instead of duplicating a grant', function () {
+    $entity = Entity::factory()->create();
+    $manager = queueManagerFor($entity);
+    $target = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($target)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    Log::shouldReceive('channel')->twice()->with('audit')->andReturn(Mockery::mock(LoggerInterface::class)->shouldIgnoreMissing());
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    expect(QueueAccess::where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->count())->toBe(1);
+});
+
+it('revokes access with an empty list and audits it', function () {
+    $entity = Entity::factory()->create();
+    $manager = queueManagerFor($entity);
+    $target = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($target)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    QueueAccess::factory()->for($membership, 'membership')->for($queue)->create();
+
+    auditLoggerExpecting('queue.access.revoked', [
+        'actor_id' => $manager->id,
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $membership->id,
+    ]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->exists())->toBeFalse();
+});
+
+it('does not audit a revoke when there was no access row', function () {
+    $entity = Entity::factory()->create();
+    $manager = queueManagerFor($entity);
+    $target = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($target)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    Log::shouldReceive('channel')->never();
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::count())->toBe(0);
+});
+
+it('rejects unknown or non-string permissions without storing anything', function (array $permissions) {
+    $entity = Entity::factory()->create();
+    $manager = queueManagerFor($entity);
+    $target = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($target)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    Log::shouldReceive('channel')->never();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, $permissions))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::count())->toBe(0);
+})->with([
+    'unknown string' => [['unknown']],
+    'integer entry' => [['call', 1]],
+    'null entry' => [['call', null]],
+    'nested array' => [['call', ['call']]],
+]);
+
+it('rejects a membership from another entity', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    $manager = queueManagerFor($entity);
+    $target = User::factory()->create();
+    $foreignMembership = EntityMembership::factory()->for($other)->for($target)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    Log::shouldReceive('channel')->never();
+
+    expect(fn () => (new SetQueueAccess)($foreignMembership, $queue, $manager, ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::count())->toBe(0);
+});
+
+it('forbids non-managers from setting access', function (string $actorType) {
+    $entity = Entity::factory()->create();
+    $target = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($target)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    $actor = match ($actorType) {
+        'self' => $target,
+        'other_entity' => queueManagerFor(Entity::factory()->create()),
+        default => User::factory()->create(),
+    };
+
+    if ($actorType === 'other_entity') {
+        // A manager of an unrelated entity must still not manage this queue.
+        expect(EntityMembership::where('user_id', $actor->id)->where('entity_id', $entity->id)->exists())->toBeFalse();
+    }
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $actor, ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::count())->toBe(0);
+})->with(['self', 'other_entity', 'non_member']);
+
+it('allows admins to set access', function () {
+    $entity = Entity::factory()->create();
+    $admin = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    $target = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($target)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    Log::shouldReceive('channel')->once()->with('audit')->andReturn(Mockery::mock(LoggerInterface::class)->shouldIgnoreMissing());
+
+    (new SetQueueAccess)($membership, $queue, $admin, ['call']);
+
+    expect(QueueAccess::count())->toBe(1);
+});
diff --git a/tests/Feature/Queue/UpdateQueueTest.php b/tests/Feature/Queue/UpdateQueueTest.php
new file mode 100644
index 0000000..0f21786
--- /dev/null
+++ b/tests/Feature/Queue/UpdateQueueTest.php
@@ -0,0 +1,149 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('updates only the fields that were provided', function () {
+    $entity = Entity::factory()->create();
+    $actor = queueManagerFor($entity);
+    $queue = Queue::factory()->for($entity)->create([
+        'name' => 'Old name',
+        'slug' => 'old-slug',
+        'is_active' => true,
+    ]);
+
+    $updated = (new UpdateQueue)($queue, $actor, name: '  New name  ');
+
+    expect($updated->name)->toBe('New name')
+        ->and($updated->slug)->toBe('old-slug')
+        ->and($updated->is_active)->toBeTrue();
+
+    $updated = (new UpdateQueue)($queue, $actor, slug: '  A New Slug  ');
+
+    expect($updated->slug)->toBe('a-new-slug')
+        ->and($updated->name)->toBe('New name');
+
+    $updated = (new UpdateQueue)($queue, $actor, isActive: false);
+
+    expect($updated->is_active)->toBeFalse()
+        ->and($updated->name)->toBe('New name')
+        ->and($updated->slug)->toBe('a-new-slug');
+});
+
+it('does nothing when all named arguments are null', function () {
+    $entity = Entity::factory()->create();
+    $actor = queueManagerFor($entity);
+    $queue = Queue::factory()->for($entity)->create([
+        'name' => 'Atendimento',
+        'slug' => 'atendimento',
+        'is_active' => true,
+    ]);
+
+    $updated = (new UpdateQueue)($queue, $actor, name: null, slug: null, isActive: null);
+
+    expect($updated->fresh())
+        ->name->toBe('Atendimento')
+        ->slug->toBe('atendimento')
+        ->is_active->toBeTrue();
+});
+
+it('allows a queue to keep its own slug', function () {
+    $entity = Entity::factory()->create();
+    $actor = queueManagerFor($entity);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'atendimento']);
+
+    $updated = (new UpdateQueue)($queue, $actor, slug: 'atendimento');
+
+    expect($updated->slug)->toBe('atendimento');
+});
+
+it('rejects taking another queue slug in the same entity', function () {
+    $entity = Entity::factory()->create();
+    $actor = queueManagerFor($entity);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'atendimento']);
+    Queue::factory()->for($entity)->create(['slug' => 'prioridade']);
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, slug: 'prioridade'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->slug)->toBe('atendimento');
+});
+
+it('allows a slug already used by another entity', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    $actor = queueManagerFor($entity);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'atendimento']);
+    Queue::factory()->for($other)->create(['slug' => 'prioridade']);
+
+    $updated = (new UpdateQueue)($queue, $actor, slug: 'prioridade');
+
+    expect($updated->slug)->toBe('prioridade');
+});
+
+it('rejects a blank updated name', function () {
+    $entity = Entity::factory()->create();
+    $actor = queueManagerFor($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Atendimento']);
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: '   '))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->name)->toBe('Atendimento');
+});
+
+it('deactivates instead of deleting and preserves tickets', function () {
+    $entity = Entity::factory()->create();
+    $actor = queueManagerFor($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue);
+
+    (new UpdateQueue)($queue, $actor, isActive: false);
+
+    expect(Queue::whereKey($queue->id)->exists())->toBeTrue()
+        ->and($queue->fresh()->is_active)->toBeFalse()
+        ->and(Ticket::whereKey($ticket->id)->exists())->toBeTrue();
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(fn () => (new CallNextTicket)($queue, $actor))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status->value)->toBe('waiting');
+});
+
+it('forbids non-managers from updating and writes nothing', function (string $membership) {
+    $entity = Entity::factory()->create();
+    $actor = User::factory()->create();
+    $queue = Queue::factory()->for($entity)->create([
+        'name' => 'Atendimento',
+        'slug' => 'atendimento',
+        'is_active' => true,
+    ]);
+
+    if ($membership === 'employee') {
+        EntityMembership::factory()->for($entity)->for($actor)->employee()->create();
+    } elseif ($membership === 'other_entity') {
+        EntityMembership::factory()->for(Entity::factory()->create())->for($actor)->owner()->create();
+    }
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'Hijacked', isActive: false))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh())
+        ->name->toBe('Atendimento')
+        ->is_active->toBeTrue();
+})->with(['employee', 'other_entity', 'non_member']);
