@@ -0,0 +1,77 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class CreateQueue
+{
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $name = trim($name);
+        $slug = $slug === null ? Str::slug($name) : Str::slug(trim($slug));
+
+        Validator::make(
+            ['name' => $name, 'slug' => $slug],
+            [
+                'name' => ['required', 'string', 'max:255'],
+                'slug' => ['required', 'string', 'max:255'],
+            ],
+        )->validate();
+
+        if ($this->slugExists($entity, $slug)) {
+            throw $this->duplicateSlug();
+        }
+
+        try {
+            return Queue::query()->create([
+                'entity_id' => $entity->id,
+                'name' => $name,
+                'slug' => $slug,
+                'is_active' => true,
+            ]);
+        } catch (QueryException $e) {
+            if ($this->isUniqueViolation($e)) {
+                throw $this->duplicateSlug();
+            }
+
+            throw $e;
+        }
+    }
+
+    private function slugExists(Entity $entity, string $slug): bool
+    {
+        return Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $slug)
+            ->exists();
+    }
+
+    private function duplicateSlug(): ValidationException
+    {
+        return ValidationException::withMessages([
+            'slug' => __('validation.unique', ['attribute' => 'slug']),
+        ]);
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
