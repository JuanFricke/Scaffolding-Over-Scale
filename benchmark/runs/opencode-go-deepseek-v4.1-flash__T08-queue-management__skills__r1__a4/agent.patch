new file mode 100644
index 0000000..4828fd8
--- /dev/null
+++ b/database/factories/QueueAccessFactory.php
@@ -0,0 +1,117 @@
+<?php
+
+namespace Database\Factories;
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+use Illuminate\Support\Str;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        $entity = null;
+
+        return [
+            'queue_id' => function (array $attributes) use (&$entity) {
+                $membershipId = $this->resolvedId($attributes['entity_membership_id'] ?? null);
+                $membership = $membershipId === null ? null : EntityMembership::query()->find($membershipId);
+
+                if ($membership !== null) {
+                    return Queue::factory()->for($membership->entity)->create()->getKey();
+                }
+
+                $entity ??= Entity::factory()->create();
+
+                return Queue::factory()->for($entity)->create()->getKey();
+            },
+            'entity_membership_id' => function (array $attributes) use (&$entity) {
+                $queueId = $this->resolvedId($attributes['queue_id'] ?? null);
+                $queue = $queueId === null ? null : Queue::query()->find($queueId);
+
+                if ($queue !== null) {
+                    return EntityMembership::factory()->for($queue->entity)->create()->getKey();
+                }
+
+                $entity ??= Entity::factory()->create();
+
+                return EntityMembership::factory()->for($entity)->create()->getKey();
+            },
+            'permissions' => [QueuePermission::Call->value],
+        ];
+    }
+
+    /**
+     * Keep the related membership and queue in the same entity when a caller
+     * pins one side of the relationship.
+     */
+    public function for($factory, $relationship = null)
+    {
+        if ($relationship === null) {
+            $related = $factory instanceof Factory ? $factory->modelName() : $factory::class;
+
+            $relationship = match ($related) {
+                EntityMembership::class => 'membership',
+                Queue::class => 'queue',
+                default => Str::camel(class_basename($related)),
+            };
+        }
+
+        $instance = parent::for($factory, $relationship);
+
+        return match ($relationship) {
+            'queue' => $instance->afterMaking(fn (QueueAccess $access) => self::alignMembershipWithQueue($access)),
+            'membership' => $instance->afterMaking(fn (QueueAccess $access) => self::alignQueueWithMembership($access)),
+            default => $instance,
+        };
+    }
+
+    private function resolvedId(mixed $value): ?int
+    {
+        if (is_int($value)) {
+            return $value;
+        }
+
+        if (is_string($value) && ctype_digit($value)) {
+            return (int) $value;
+        }
+
+        return null;
+    }
+
+    private static function alignMembershipWithQueue(QueueAccess $access): void
+    {
+        $membership = EntityMembership::query()->find($access->entity_membership_id);
+        $queue = Queue::query()->find($access->queue_id);
+
+        if ($membership === null || $queue === null || (int) $membership->entity_id === (int) $queue->entity_id) {
+            return;
+        }
+
+        $membership->forceFill(['entity_id' => $queue->entity_id])->save();
+    }
+
+    private static function alignQueueWithMembership(QueueAccess $access): void
+    {
+        $membership = EntityMembership::query()->find($access->entity_membership_id);
+        $queue = Queue::query()->find($access->queue_id);
+
+        if ($membership === null || $queue === null || (int) $membership->entity_id === (int) $queue->entity_id) {
+            return;
+        }
+
+        $queue->forceFill(['entity_id' => $membership->entity_id])->save();
+    }
+}
