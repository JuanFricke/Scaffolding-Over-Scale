@@ -0,0 +1,98 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $attributes = [];
+
+        if ($name !== null) {
+            $attributes['name'] = trim($name);
+        }
+
+        if ($slug !== null) {
+            $attributes['slug'] = Str::slug(trim($slug));
+        }
+
+        if ($isActive !== null) {
+            $attributes['is_active'] = $isActive;
+        }
+
+        if ($attributes === []) {
+            return $queue;
+        }
+
+        $rules = [];
+
+        if (array_key_exists('name', $attributes)) {
+            $rules['name'] = ['required', 'string', 'max:255'];
+        }
+
+        if (array_key_exists('slug', $attributes)) {
+            $rules['slug'] = ['required', 'string', 'max:255'];
+        }
+
+        Validator::make($attributes, $rules)->validate();
+
+        if (isset($attributes['slug']) && $this->slugExists($queue, $attributes['slug'])) {
+            throw $this->duplicateSlug();
+        }
+
+        try {
+            $queue->fill($attributes)->save();
+        } catch (QueryException $e) {
+            if ($this->isUniqueViolation($e)) {
+                throw $this->duplicateSlug();
+            }
+
+            throw $e;
+        }
+
+        return $queue;
+    }
+
+    private function slugExists(Queue $queue, string $slug): bool
+    {
+        return Queue::query()
+            ->where('entity_id', $queue->entity_id)
+            ->where('id', '!=', $queue->id)
+            ->where('slug', $slug)
+            ->exists();
+    }
+
+    private function duplicateSlug(): ValidationException
+    {
+        return ValidationException::withMessages([
+            'slug' => __('validation.unique', ['attribute' => 'slug']),
+        ]);
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
