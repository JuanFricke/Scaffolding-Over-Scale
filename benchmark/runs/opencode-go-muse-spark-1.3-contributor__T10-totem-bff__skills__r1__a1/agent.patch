@@ -0,0 +1,74 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * CORS for the totem API (`api/*`).
+ *
+ * The totem web build runs on a local static server, so `localhost` and
+ * `127.0.0.1` origins (any scheme/port) are allowed, plus one optional
+ * configured origin (`TOTEM_WEB_ORIGIN`). Any other origin gets no
+ * `Access-Control-Allow-Origin` header. No credentials.
+ */
+class TotemCors
+{
+    /**
+     * @param  Closure(Request): Response  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        if (! $request->is('api/*')) {
+            return $next($request);
+        }
+
+        $origin = (string) $request->headers->get('Origin', '');
+        $allowedOrigin = $this->allowedOrigin($origin);
+
+        if ($request->isMethod('OPTIONS')) {
+            $headers = [
+                'Access-Control-Allow-Methods' => 'GET, POST, OPTIONS',
+                'Access-Control-Allow-Headers' => 'Authorization, Content-Type, Accept',
+                'Vary' => 'Origin',
+            ];
+
+            if ($allowedOrigin !== null) {
+                $headers['Access-Control-Allow-Origin'] = $allowedOrigin;
+            }
+
+            return response('', 204, $headers);
+        }
+
+        /** @var Response $response */
+        $response = $next($request);
+
+        if ($allowedOrigin !== null) {
+            $response->headers->set('Access-Control-Allow-Origin', $allowedOrigin);
+            $response->headers->set('Vary', 'Origin', false);
+        }
+
+        return $response;
+    }
+
+    private function allowedOrigin(string $origin): ?string
+    {
+        if ($origin === '') {
+            return null;
+        }
+
+        if (preg_match('#^https?://(localhost|127\.0\.0\.1)(:\d+)?$#', $origin)) {
+            return $origin;
+        }
+
+        $extra = (string) config('services.totem.web_origin', '');
+
+        if ($extra !== '' && hash_equals($extra, $origin)) {
+            return $origin;
+        }
+
+        return null;
+    }
+}
