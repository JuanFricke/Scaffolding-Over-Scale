+it('rate limits ticket issuance', function () {
+    $preset = makeTotemPreset($this);
+    $token = pairTotem($this, $preset);
+    $queue = $preset->queues->first();
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson(
+            "/api/{$preset->entity->slug}/{$queue->slug}/ticket",
+            ['priority' => 0],
+            authHeaders($token)
+        )->assertStatus(201);
+    }
+
+    $this->postJson(
+        "/api/{$preset->entity->slug}/{$queue->slug}/ticket",
+        ['priority' => 0],
+        authHeaders($token)
+    )->assertStatus(429)->assertExactJson(['code' => 'rate_limited']);
+});
