+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+class TotemPairingCode extends Command
+{
+    /**
+     * @var string
+     */
+    protected $signature = 'totem:pairing-code {preset}';
+
+    /**
+     * @var string
+     */
+    protected $description = 'Open a pairing window for a totem preset (generates its 6-digit code, valid 10 minutes)';
+
+    public function handle(): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if (! $preset) {
+            $this->error('Unknown totem preset.');
+
+            return self::FAILURE;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        Log::channel('audit')->info('Totem pairing window opened', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $preset->login_code_expires_at?->toIso8601String(),
+        ]);
+
+        $this->line("Pairing code for preset [{$preset->id}] {$preset->name}: {$code}");
+        $this->line('Valid for 10 minutes, single use.');
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Http/Controllers/TotemController.php b/app/Http/Controllers/TotemController.php
new file mode 100644
index 0000000..f42ffd2
--- /dev/null
+++ b/app/Http/Controllers/TotemController.php
@@ -0,0 +1,259 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\Totem\TotemJwt;
+use App\Services\Totem\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class TotemController extends Controller
+{
+    /**
+     * Pairing login: exchange a preset's 6-digit code for a scoped JWT.
+     */
+    public function auth(Request $request, TotemJwt $jwt): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || ! preg_match('/^\d{6}$/', $code)) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $preset = TotemPreset::query()->where('login_code', $code)->first();
+
+        if ($preset === null) {
+            $this->auditPairingFailure('unknown_code', $code);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        if (! $preset->is_active) {
+            $this->auditPairingFailure('inactive_preset', $code, $preset);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        if ($preset->login_code_expires_at === null || $preset->login_code_expires_at->isPast()) {
+            $this->auditPairingFailure('expired_code', $code, $preset);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        if ($preset->login_code_consumed_at !== null) {
+            $this->auditPairingFailure('consumed_code', $code, $preset);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        $result = DB::transaction(function () use ($preset, $code, $jwt): ?array {
+            // Lock the preset row so concurrent pairing attempts consume the
+            // single-use code exactly once. (No-op on SQLite; tests rely on
+            // the consumed_at re-check inside the transaction.)
+            $locked = TotemPreset::query()->whereKey($preset->id)->lockForUpdate()->firstOrFail();
+
+            if (! $locked->is_active
+                || $locked->login_code !== $code
+                || $locked->login_code_consumed_at !== null
+                || $locked->login_code_expires_at === null
+                || $locked->login_code_expires_at->isPast()) {
+                return null;
+            }
+
+            $locked->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $locked->entity_id,
+                'name' => "Totem {$locked->name}",
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            return [$totem, $locked, $jwt->issue($totem, $locked)];
+        });
+
+        if ($result === null) {
+            $this->auditPairingFailure('consumed_code', $code, $preset);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        [$totem, $locked, $token] = $result;
+
+        Log::channel('audit')->info('Totem pairing succeeded', [
+            'preset_id' => $locked->id,
+            'entity_id' => $locked->entity_id,
+            'totem_id' => $totem->id,
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => (int) config('services.totem.jwt_ttl', 3600),
+            'entity' => [
+                'slug' => $locked->entity->slug,
+                'name' => $locked->entity->name,
+            ],
+        ]);
+    }
+
+    /**
+     * List the queues available for issuance for the token's entity.
+     */
+    public function queues(Request $request, string $entity): JsonResponse
+    {
+        $entityModel = $this->resolveEntity($request, $entity);
+
+        if ($entityModel === null) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $queues = Queue::query()
+            ->whereIn('id', $this->effectiveQueueIds($request))
+            ->where('entity_id', $entityModel->id)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        return response()->json([
+            'entity' => ['slug' => $entityModel->slug, 'name' => $entityModel->name],
+            'queues' => $queues->values()->map(fn (Queue $queue, int $index): array => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => null,
+                'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => $index + 1],
+                'is_active' => true,
+            ])->all(),
+        ]);
+    }
+
+    /**
+     * List the backend-owned priority levels for a queue.
+     */
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        if (! $resolved->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $resolved->entity->slug],
+            'queue' => ['slug' => $resolved->slug, 'label' => $resolved->name],
+            'priorities' => TotemPriorities::all(),
+        ]);
+    }
+
+    /**
+     * Issue a ticket in a queue with a chosen priority.
+     */
+    public function ticket(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        $priority = $request->input('priority');
+
+        if (! is_int($priority) || TotemPriorities::find($priority) === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = app(IssueTicket::class)(
+                $resolved,
+                $priority,
+                TicketChannel::Totem,
+            );
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $label = TotemPriorities::find($ticket->priority);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $resolved->slug, 'label' => $resolved->name],
+            'priority' => ['value' => $ticket->priority, 'label' => $label['label']],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+
+    /**
+     * The token's entity, or null when the path slug does not match it.
+     */
+    private function resolveEntity(Request $request, string $slug): ?Entity
+    {
+        $entity = Entity::query()->find($request->attributes->get('totem_entity_id'));
+
+        if ($entity === null || $entity->slug !== $slug) {
+            return null;
+        }
+
+        return $entity;
+    }
+
+    /**
+     * Resolve a queue slug within the token's entity and effective scope:
+     * unknown slug (including another entity's) -> 404, known slug outside
+     * the effective scope -> 403, otherwise the queue.
+     */
+    private function resolveQueue(Request $request, string $entity, string $slug): Queue|JsonResponse
+    {
+        $entityModel = $this->resolveEntity($request, $entity);
+
+        if ($entityModel === null) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $queue = Queue::query()
+            ->where('entity_id', $entityModel->id)
+            ->where('slug', $slug)
+            ->first();
+
+        if ($queue === null) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! in_array($queue->id, $this->effectiveQueueIds($request), true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return $queue;
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function effectiveQueueIds(Request $request): array
+    {
+        return array_map('intval', (array) $request->attributes->get('totem_queue_ids', []));
+    }
+
+    private function auditPairingFailure(string $reason, string $code, ?TotemPreset $preset = null): void
+    {
+        Log::channel('audit')->info('Totem pairing failed', array_filter([
+            'reason' => $reason,
+            'preset_id' => $preset?->id,
+            'entity_id' => $preset?->entity_id,
+            // Deliberately no full code: log only its shape.
+            'code_length' => strlen($code),
+        ], fn ($value) => $value !== null));
+    }
+}
