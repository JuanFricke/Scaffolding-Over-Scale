+<?php
+
+namespace App\Services\Totem;
+
+/**
+ * Backend-owned totem priority levels.
+ *
+ * Single source of truth for both the priorities endpoint payload and ticket
+ * issuance validation: numeric values are stored on the ticket (higher = more
+ * prioritized); labels and visuals are display-only.
+ */
+class TotemPriorities
+{
+    /**
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function all(): array
+    {
+        return [
+            [
+                'value' => 0,
+                'label' => 'Normal',
+                'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            ],
+            [
+                'value' => 10,
+                'label' => 'Prioritário',
+                'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            ],
+            [
+                'value' => 20,
+                'label' => 'Prioridade 80+',
+                'visual' => ['color' => '#1565C0', 'icon' => 'star', 'order' => 3],
+            ],
+        ];
+    }
+
+    /**
+     * @return list<int>
+     */
+    public static function values(): array
+    {
+        return array_column(self::all(), 'value');
+    }
+
+    /**
+     * @return array{value: int, label: string, visual: array{color: string, icon: string, order: int}}|null
+     */
+    public static function find(int $value): ?array
+    {
+        foreach (self::all() as $priority) {
+            if ($priority['value'] === $value) {
+                return $priority;
+            }
+        }
+
+        return null;
+    }
+}
