+// CORS
+
+it('answers preflight for local totem origins', function () {
+    $response = $this->call('OPTIONS', '/api/totem/auth', [], [], [], ['HTTP_ORIGIN' => 'http://localhost:8081']);
+
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+});
+
+it('sends CORS headers on real responses for allowed origins only', function () {
+    $preset = makeTotemPreset($this);
+
+    $allowed = $this->postJson('/api/totem/auth', ['code' => $preset->login_code], ['Origin' => 'http://127.0.0.1:3000']);
+    $allowed->assertOk();
+    expect($allowed->headers->get('Access-Control-Allow-Origin'))->toBe('http://127.0.0.1:3000');
+
+    $denied = $this->postJson('/api/totem/auth', ['code' => '000000'], ['Origin' => 'https://evil.example.com']);
+    expect($denied->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+});
+
+it('accepts the configured extra web origin', function () {
+    config(['services.totem.web_origin' => 'https://totem.example.com']);
+
+    $response = $this->call('OPTIONS', '/api/totem/auth', [], [], [], ['HTTP_ORIGIN' => 'https://totem.example.com']);
+
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('https://totem.example.com');
+});
