+
+#[Fillable(['entity_id', 'name', 'is_active', 'last_seen_at'])]
+class Totem extends Model
+{
+    /** @use HasFactory<TotemFactory> */
+    use HasFactory;
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'is_active' => 'boolean',
+            'last_seen_at' => 'datetime',
