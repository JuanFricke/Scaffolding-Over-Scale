+function makeTotemPreset(TestCase $t, array $overrides = [], int $queueCount = 2): TotemPreset
+{
+    $preset = TotemPreset::factory()->create($overrides);
+    $queues = Queue::factory()->count($queueCount)->for($preset->entity)->create(['is_active' => true]);
+    $preset->queues()->attach($queues->pluck('id'));
+
+    return $preset->refresh()->load('queues');
+}
+
+function pairTotem(TestCase $t, TotemPreset $preset): string
+{
+    $response = $t->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk();
+
+    return $response->json('token');
+}
+
+function authHeaders(string $token, string $origin = 'http://localhost:8081'): array
+{
+    return [
+        'Authorization' => "Bearer {$token}",
+        'Origin' => $origin,
+    ];
+}
