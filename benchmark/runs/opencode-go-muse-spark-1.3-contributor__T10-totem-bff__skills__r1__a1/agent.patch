+    $token = pairTotem($this, $preset);
+    $queue = $preset->queues->first();
+    $queue->update(['is_active' => false]);
+
+    $this->getJson("/api/{$preset->entity->slug}/{$queue->slug}/priorities", authHeaders($token))
