+it('issues sequential totem tickets with priority labels', function () {
+    $preset = makeTotemPreset($this);
+    $token = pairTotem($this, $preset);
+    $queue = $preset->queues->first();
+
+    $first = $this->postJson(
+        "/api/{$preset->entity->slug}/{$queue->slug}/ticket",
+        ['priority' => 10],
+        authHeaders($token)
+    )->assertStatus(201)->assertJson([
+        'slug' => 'A001',
+        'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+        'priority' => ['value' => 10, 'label' => 'Prioritário'],
+    ])->assertJsonStructure(['slug', 'queue' => ['slug', 'label'], 'priority' => ['value', 'label'], 'issued_at']);
+
+    expect((string) now()->parse($first->json('issued_at'))->toIso8601String())->not->toBeEmpty();
+
+    $second = $this->postJson(
+        "/api/{$preset->entity->slug}/{$queue->slug}/ticket",
+        ['priority' => 0],
+        authHeaders($token)
+    )->assertStatus(201);
+
+    expect($second->json('slug'))->toBe('A002');
+
+    $tickets = Ticket::query()->orderBy('code')->get();
+
+    expect($tickets)->toHaveCount(2)
+        ->and($tickets->pluck('channel')->all())->each->toBe(TicketChannel::Totem);
+});
