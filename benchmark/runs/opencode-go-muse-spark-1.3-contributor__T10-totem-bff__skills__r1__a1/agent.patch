@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\Totem\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Validates the totem JWT on every authenticated totem API call.
+ *
+ * Failure (missing/invalid/expired token, unknown or inactive totem/preset,
+ * entity mismatch between claims, totem and preset) always answers
+ * 401 {"code":"invalid_token"} — no oracle.
+ *
+ * On success the resolved totem, preset and effective queue ids
+ * (intersection of the JWT claim with the preset's current join, so queue
+ * removals take effect immediately) are stored on the request attributes.
+ */
+class TotemAuth
+{
+    public function __construct(private TotemJwt $jwt) {}
+
+    /**
+     * @param  Closure(Request): Response  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+        $claims = $token === null ? null : $this->jwt->decode($token);
+
+        $totem = $claims === null ? null : Totem::query()->find($claims['totem_id']);
+        $preset = $claims === null ? null : TotemPreset::query()->find($claims['preset_id']);
+
+        if ($claims === null || $totem === null || $preset === null
+            || ! $totem->is_active || ! $preset->is_active
+            || $claims['entity_id'] !== $totem->entity_id
+            || $claims['entity_id'] !== $preset->entity_id
+            || $totem->entity_id !== $preset->entity_id) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $effectiveQueues = array_values(array_intersect(
+            array_map('intval', (array) $claims['queues']),
+            $preset->queues()->pluck('queues.id')->all(),
+        ));
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity_id', $totem->entity_id);
+        $request->attributes->set('totem_queue_ids', $effectiveQueues);
+
+        return $next($request);
+    }
+}
