+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->login_code_expires_at)->not->toBeNull()
+        ->and($preset->login_code_expires_at->diffInMinutes(now(), true))->toBeGreaterThan(9)
+        ->and($preset->login_code_expires_at->diffInMinutes(now(), true))->toBeLessThan(11);
