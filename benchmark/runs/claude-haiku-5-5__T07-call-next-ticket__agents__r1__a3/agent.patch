+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /** A normal ticket may not wait behind more than this many consecutive priority calls. */
+    private const PRIORITY_STREAK_LIMIT = 3;
+
+    /**
+     * Call the next waiting ticket of the queue and return it, now marked called.
+     *
+     * Throws InactiveQueueException or NoWaitingTicketsException without
+     * changing anything. Authorization is the caller's responsibility.
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Queue state is read under the lock, not from the passed instance (it may be stale).
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $ticket = null;
+
+            // Fairness: a normal ticket goes next after 3 priority calls. When no normal
+            // ticket is waiting, claim() returns null and the full ordering applies.
+            if ($mode === CallMode::Any && $this->priorityStreakIsFull($lockedQueue)) {
+                $ticket = $this->claim($lockedQueue, CallMode::NormalOnly);
+            }
+
+            $ticket ??= $this->claim($lockedQueue, $mode);
+
+            if ($ticket === null) {
+                throw new NoWaitingTicketsException('No waiting ticket is eligible for this call.');
+            }
+
+            $ticket->status = TicketStatus::Called;
+            $ticket->called_at = now();
+            $ticket->called_by_user_id = $calledBy->id;
+            $ticket->save();
+
+            return $ticket;
+        });
+    }
+
+    /**
+     * Lock the first candidate that is still waiting; skip any called concurrently.
+     */
+    private function claim(Queue $queue, CallMode $mode): ?Ticket
+    {
+        $skipped = [];
+
+        while (($candidate = $this->nextCandidate($queue, $mode, $skipped)) !== null) {
+            $ticket = Ticket::query()->whereKey($candidate->id)->lockForUpdate()->first();
+
+            if ($ticket?->status === TicketStatus::Waiting) {
+                return $ticket;
+            }
+
+            // Ticket::call() does not take the queue lock, so the candidate may have been
+            // called after it was picked. Exclude it explicitly: a snapshot read may still
+            // report it as waiting, and re-querying without this would loop forever.
+            $skipped[] = $candidate->id;
+        }
+
+        return null;
+    }
+
+    /**
+     * @param  list<int>  $skipped
+     */
+    private function nextCandidate(Queue $queue, CallMode $mode, array $skipped): ?Ticket
+    {
+        return Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->whereNotIn('id', $skipped)
+            ->when($mode === CallMode::PriorityOnly, fn ($query) => $query->where('priority', '>', 0))
+            ->when($mode === CallMode::NormalOnly, fn ($query) => $query->where('priority', 0))
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id')
+            ->first();
+    }
+
+    /**
+     * True when the last PRIORITY_STREAK_LIMIT calls in the queue were all priority tickets.
+     */
+    private function priorityStreakIsFull(Queue $queue): bool
+    {
+        $lastCalls = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::PRIORITY_STREAK_LIMIT)
+            ->get(['priority']);
+
+        return $lastCalls->count() === self::PRIORITY_STREAK_LIMIT
+            && $lastCalls->every(fn (Ticket $ticket): bool => $ticket->priority > 0);
+    }
+}
