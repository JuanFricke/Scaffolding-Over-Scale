+    makeCalled($queue, $attendant, 10, now()->subMinutes(2));
+    makeCalled($queue, $attendant, 10, now()->subMinutes(1));
+
+    expect((new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly)->is($priorityWaiting))->toBeTrue()
+        ->and((new CallNextTicket)($queue, $attendant, CallMode::NormalOnly)->is($normal))->toBeTrue();
+});
+
+it('skips a candidate that was called concurrently after it was picked', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($attendant)->owner()->create();
+    $picked = makeWaiting($queue, 0, now()->subHour());
+    $next = makeWaiting($queue, 0, now()->subMinutes(30));
+
+    // Simulate Ticket::call() winning the race right after the candidate SELECT
+    // and before the action locks that row. Ticket::call() takes no queue lock.
+    $raced = false;
+    DB::listen(function (QueryExecuted $query) use (&$raced, $picked, $attendant): void {
+        if ($raced || ! str_contains($query->sql, 'issued_at')) {
+            return;
+        }
+
+        $raced = true;
+        $picked->call($attendant);
+    });
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($raced)->toBeTrue()
+        ->and($called->is($next))->toBeTrue()
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($picked->fresh()->called_by_user_id)->toBe($attendant->id);
+});
