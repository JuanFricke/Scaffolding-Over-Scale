+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Events\QueryExecuted;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+function makeWaiting(Queue $queue, int $priority = 0, ?Carbon $issuedAt = null): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'issued_at' => $issuedAt ?? now(),
+    ]);
+}
+
+function makeCalled(Queue $queue, User $by, int $priority, Carbon $calledAt): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt,
+        'called_by_user_id' => $by->id,
+    ]);
+}
+
+it('calls the oldest normal ticket and marks it called', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $oldest = makeWaiting($queue, 0, now()->subMinutes(10));
+    makeWaiting($queue, 0, now()->subMinutes(5));
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($oldest))->toBeTrue()
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_at)->not->toBeNull()
+        ->and($called->called_by_user_id)->toBe($attendant->id);
+
+    expect($oldest->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($attendant->id)
+        ->called_at->not->toBeNull();
+});
+
+it('keeps the issued fields unchanged when calling', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = makeWaiting($queue, 10, now()->subMinutes(3));
+    $before = $ticket->fresh();
+
+    $called = (new CallNextTicket)($queue, User::factory()->create());
+
+    expect($called->code)->toBe($before->code)
+        ->and($called->priority)->toBe(10)
+        ->and($called->issued_at->equalTo($before->issued_at))->toBeTrue()
+        ->and($called->queue_id)->toBe($queue->id);
+});
+
+it('calls higher priority values first in any mode', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $normal = makeWaiting($queue, 0, now()->subHour());
+    $low = makeWaiting($queue, 10, now()->subMinutes(30));
+    $high = makeWaiting($queue, 20, now()->subMinutes(10));
+
+    expect((new CallNextTicket)($queue, $attendant)->is($high))->toBeTrue()
+        ->and((new CallNextTicket)($queue, $attendant)->is($low))->toBeTrue()
+        ->and((new CallNextTicket)($queue, $attendant)->is($normal))->toBeTrue();
+});
+
+it('breaks ties by oldest issued_at, then lowest id', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $sameTime = now()->subMinutes(5);
+    $firstId = makeWaiting($queue, 10, $sameTime);
+    $secondId = makeWaiting($queue, 10, $sameTime);
+    $newer = makeWaiting($queue, 10, now()->subMinute());
+
+    expect((new CallNextTicket)($queue, $attendant)->is($firstId))->toBeTrue()
+        ->and((new CallNextTicket)($queue, $attendant)->is($secondId))->toBeTrue()
+        ->and((new CallNextTicket)($queue, $attendant)->is($newer))->toBeTrue();
+});
+
+it('never selects tickets from another queue', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $other = Queue::factory()->create(['is_active' => true]);
+    makeWaiting($other, 20, now()->subHour());
+    $mine = makeWaiting($queue, 0);
+
+    $called = (new CallNextTicket)($queue, User::factory()->create());
+
+    expect($called->is($mine))->toBeTrue()
+        ->and($mine->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+it('never calls a ticket that is already called', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    makeCalled($queue, $attendant, 0, now()->subMinutes(5));
+    $waiting = makeWaiting($queue, 0);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($waiting))->toBeTrue();
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
