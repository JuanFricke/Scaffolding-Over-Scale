+<?php
+
+namespace App\Enums;
+
+enum CallMode: string
+{
+    /** Full ordering (priority, age, id) with the 3-priority fairness rule. */
+    case Any = 'any';
+
+    /** Only priority tickets (priority > 0); fairness ignored. */
+    case PriorityOnly = 'priority_only';
+
+    /** Only normal tickets (priority = 0), oldest first; fairness ignored. */
+    case NormalOnly = 'normal_only';
+}
