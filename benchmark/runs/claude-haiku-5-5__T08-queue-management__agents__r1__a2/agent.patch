 <?php
 
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
 use Illuminate\Foundation\Testing\RefreshDatabase;
 use Tests\TestCase;
 
@@ -48,3 +55,40 @@ function something()
 {
     // ..
 }
+
+/**
+ * A user who is an admin of the entity (a manager without the owner invariant).
+ */
+function managerOf(Entity $entity): User
+{
+    return memberOf($entity, UserRole::Admin);
+}
+
+/**
+ * A user holding the given membership role in the entity.
+ */
+function memberOf(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->for($entity)->for($user)->state(['role' => $role->value])->create();
+
+    return $user;
+}
+
+/**
+ * Give an employee a `call` grant on the queue (their membership in the queue's entity).
+ */
+function grantCall(User $employee, Queue $queue): void
+{
+    $membership = EntityMembership::query()
+        ->where('user_id', $employee->id)
+        ->where('entity_id', $queue->entity_id)
+        ->firstOrFail();
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $queue->id,
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+}
