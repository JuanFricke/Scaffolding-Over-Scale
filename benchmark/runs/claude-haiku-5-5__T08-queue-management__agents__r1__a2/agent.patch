@@ -0,0 +1,79 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Set the permissions a membership has on a queue. A non-empty list grants them (replacing
+     * any previous list); an empty list revokes the grant. Changes are written to the audit log.
+     *
+     * @param  list<string>  $permissions
+     *
+     * @throws AuthorizationException when the actor is not an owner or admin of the queue's entity
+     * @throws ValidationException when a permission is unknown or not a string, or the membership belongs to another entity
+     */
+    public function __invoke(EntityMembership $targetMembership, Queue $queue, User $actor, array $permissions): void
+    {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        $granted = Validator::make(
+            ['permissions' => $permissions],
+            [
+                'permissions' => ['present', 'array'],
+                'permissions.*' => ['string', Rule::enum(QueuePermission::class)],
+            ],
+        )->validate()['permissions'];
+
+        $granted = array_values(array_unique($granted));
+
+        if ((int) $targetMembership->entity_id !== (int) $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => __('validation.exists', ['attribute' => 'membership']),
+            ]);
+        }
+
+        DB::transaction(function () use ($targetMembership, $queue, $actor, $granted): void {
+            // Serialize grant writes per queue so concurrent upserts cannot collide on the unique index.
+            Queue::query()->whereKey($queue->id)->lockForUpdate()->firstOrFail();
+
+            $where = [
+                'entity_membership_id' => $targetMembership->id,
+                'queue_id' => $queue->id,
+            ];
+            $context = [
+                'actor_id' => $actor->id,
+                'entity_id' => $queue->entity_id,
+                'queue_id' => $queue->id,
+                'entity_membership_id' => $targetMembership->id,
+            ];
+
+            if ($granted === []) {
+                $revoked = QueueAccess::query()->where($where)->delete();
+
+                if ($revoked > 0) {
+                    Log::channel('audit')->info('queue.access.revoked', $context);
+                }
+
+                return;
+            }
+
+            QueueAccess::query()->updateOrCreate($where, ['permissions' => $granted]);
+
+            Log::channel('audit')->info('queue.access.granted', [...$context, 'permissions' => $granted]);
+        });
+    }
+}
