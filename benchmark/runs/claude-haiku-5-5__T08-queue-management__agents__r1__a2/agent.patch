@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Actions\Concerns;
+
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Name and slug rules shared by the queue actions. Slugs are unique per entity.
+ */
+trait ValidatesQueueAttributes
+{
+    /**
+     * Trim the name, slugify the slug, and validate whichever were given (null = unchanged).
+     *
+     * @return array{name?: string, slug?: string}
+     *
+     * @throws ValidationException
+     */
+    protected function validatedQueueAttributes(int $entityId, ?int $queueId, ?string $name, ?string $slug): array
+    {
+        $data = [];
+        $rules = [];
+
+        if ($name !== null) {
+            $data['name'] = trim($name);
+            $rules['name'] = ['required', 'string', 'max:255'];
+        }
+
+        if ($slug !== null) {
+            $data['slug'] = Str::slug($slug);
+            $rules['slug'] = [
+                'required',
+                'string',
+                'max:255',
+                Rule::unique('queues', 'slug')->where('entity_id', $entityId)->ignore($queueId),
+            ];
+        }
+
+        Validator::make($data, $rules)->validate();
+
+        return $data;
+    }
+
+    /**
+     * Map a unique-index hit on the slug (a concurrent request won the race after
+     * validation passed) to a validation error. Any other query failure is rethrown.
+     */
+    protected function slugConflictOrRethrow(QueryException $e): ValidationException|QueryException
+    {
+        $message = $e->getMessage();
+
+        $isUniqueViolation = str_contains($message, 'UNIQUE constraint failed')
+            || str_contains($message, 'Duplicate entry');
+
+        if (! $isUniqueViolation) {
+            return $e;
+        }
+
+        return ValidationException::withMessages([
+            'slug' => __('validation.unique', ['attribute' => 'slug']),
+        ]);
+    }
+}
