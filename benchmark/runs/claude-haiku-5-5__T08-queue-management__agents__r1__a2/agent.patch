+<?php
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+it('allows managers to create queues in their entity only', function (UserRole $role, bool $expected) {
+    $entity = Entity::factory()->create();
+    $user = memberOf($entity, $role);
+
+    expect(Gate::forUser($user)->allows('create', [Queue::class, $entity]))->toBe($expected);
+})->with([
+    'owner' => [UserRole::Owner, true],
+    'admin' => [UserRole::Admin, true],
+    'employee' => [UserRole::Employee, false],
+]);
+
+it('denies queue creation to a manager of another entity', function () {
+    $entity = Entity::factory()->create();
+
+    expect(Gate::forUser(managerOf(Entity::factory()->create()))->allows('create', [Queue::class, $entity]))
+        ->toBeFalse();
+});
+
+it('allows only managers of the queue entity to update and manage access', function (string $ability) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(Gate::forUser(managerOf($entity))->allows($ability, $queue))->toBeTrue()
+        ->and(Gate::forUser(memberOf($entity, UserRole::Employee))->allows($ability, $queue))->toBeFalse()
+        ->and(Gate::forUser(managerOf(Entity::factory()->create()))->allows($ability, $queue))->toBeFalse()
+        ->and(Gate::forUser(User::factory()->create())->allows($ability, $queue))->toBeFalse();
+})->with(['update', 'manageAccess']);
+
+it('lets an employee with a call grant on the queue call', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    grantCall($employee, $queue);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeTrue();
+});
+
+it('lets managers call without a grant', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(Gate::forUser(memberOf($entity, $role))->allows('call', $queue))->toBeTrue();
+})->with([
+    'owner' => [UserRole::Owner],
+    'admin' => [UserRole::Admin],
+]);
+
+it('denies an employee without a grant', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(Gate::forUser(memberOf($entity, UserRole::Employee))->allows('call', $queue))->toBeFalse();
+});
+
+it('denies an employee whose grant is on another queue', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $otherQueue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    grantCall($employee, $otherQueue);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+});
+
+it('denies an employee whose grant does not contain call', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    grantCall($employee, $queue);
+    DB::table('queue_access')->update(['permissions' => json_encode([])]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+});
+
+it('denies an employee whose corrupted grant is not an array', function (string $json) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    grantCall($employee, $queue);
+    DB::table('queue_access')->update(['permissions' => $json]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+})->with([
+    'bare string' => ['"call"'],
+    'null' => ['null'],
+    'invalid json' => ['{call'],
+]);
+
+it('denies a member of another entity even with a grant on this queue', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $outsider = memberOf(Entity::factory()->create(), UserRole::Employee);
+    $membership = EntityMembership::query()->where('user_id', $outsider->id)->firstOrFail();
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $queue->id,
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+
+    expect(Gate::forUser($outsider)->allows('call', $queue))->toBeFalse();
+});
+
+it('denies a non-member', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Gate::forUser(User::factory()->create())->allows('call', $queue))->toBeFalse();
+});
diff --git a/tests/Feature/Queue/SetQueueAccessTest.php b/tests/Feature/Queue/SetQueueAccessTest.php
new file mode 100644
index 0000000..29f83d2
--- /dev/null
+++ b/tests/Feature/Queue/SetQueueAccessTest.php
@@ -0,0 +1,170 @@
+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Psr\Log\LoggerInterface;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Entity with a queue and an employee membership, plus the manager doing the grant.
+ *
+ * @return array{0: Entity, 1: Queue, 2: EntityMembership, 3: User}
+ */
+function accessFixture(): array
+{
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    $membership = EntityMembership::query()->where('entity_id', $entity->id)->where('user_id', $employee->id)->firstOrFail();
+
+    return [$entity, $queue, $membership, managerOf($entity)];
+}
+
+/**
+ * Expect one audit-channel write with the given message and context keys.
+ */
+function expectAudit(string $message, array $expectedContext): void
+{
+    $audit = Mockery::mock(LoggerInterface::class);
+    $audit->shouldReceive('info')->once()->with($message, Mockery::on(
+        fn (array $context) => collect($expectedContext)->every(
+            fn ($value, $key) => ($context[$key] ?? null) === $value
+        ) && isset($context['actor_id'], $context['queue_id'], $context['entity_membership_id'])
+    ));
+
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+}
+
+it('grants call to an employee on a queue', function () {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+
+    (new SetQueueAccess)($membership, $queue, $manager, [QueuePermission::Call->value]);
+
+    expect(QueueAccess::query()->count())->toBe(1);
+    expect(QueueAccess::query()->first())
+        ->entity_membership_id->toBe($membership->id)
+        ->queue_id->toBe($queue->id)
+        ->permissions->toBe(['call']);
+});
+
+it('updates the existing grant instead of duplicating it', function () {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    expect(QueueAccess::query()->count())->toBe(1);
+});
+
+it('stores each permission once', function () {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call', 'call']);
+
+    expect(QueueAccess::query()->value('permissions'))->toBe(['call']);
+});
+
+it('revokes access when the list is empty', function () {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('does not write a revoke audit entry when there was no grant', function () {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+
+    Log::shouldReceive('channel')->never();
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('writes a granted audit entry with actor, queue and membership', function () {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+    expectAudit('queue.access.granted', [
+        'actor_id' => $manager->id,
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $membership->id,
+    ]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+});
+
+it('writes a revoked audit entry with actor, queue and membership', function () {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    expectAudit('queue.access.revoked', [
+        'actor_id' => $manager->id,
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $membership->id,
+    ]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+});
+
+it('rejects an unknown permission and stores nothing', function () {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, ['call', 'delete']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('rejects non-string permission entries', function (mixed $entry) {
+    [$entity, $queue, $membership, $manager] = accessFixture();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, [$entry]))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with([
+    'int' => [1],
+    'bool' => [true],
+    'null' => [null],
+    'nested list' => [['call']],
+]);
+
+it('rejects a membership from another entity', function () {
+    [$entity, $queue, , $manager] = accessFixture();
+    $outsider = EntityMembership::factory()->create(['role' => UserRole::Employee->value]);
+
+    expect(fn () => (new SetQueueAccess)($outsider, $queue, $manager, ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('denies an employee granting themselves call', function () {
+    [, $queue, $membership] = accessFixture();
+    $employee = $membership->user;
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $employee, ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('denies a non-member and writes nothing', function () {
+    [, $queue, $membership] = accessFixture();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, User::factory()->create(), ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
