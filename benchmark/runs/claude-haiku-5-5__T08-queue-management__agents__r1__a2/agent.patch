+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('renames a queue and keeps its slug when no slug is given', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+
+    $updated = (new UpdateQueue)($queue, managerOf($entity), name: 'Recepção');
+
+    expect($updated->fresh())
+        ->name->toBe('Recepção')
+        ->slug->toBe('geral');
+});
+
+it('changes the slug and slugifies it', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral']);
+
+    (new UpdateQueue)($queue, managerOf($entity), slug: 'Nova Fila');
+
+    expect($queue->fresh()->slug)->toBe('nova-fila');
+});
+
+it('deactivates a queue and keeps its tickets', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    (new IssueTicket)($queue);
+
+    (new UpdateQueue)($queue, managerOf($entity), isActive: false);
+
+    expect($queue->fresh()->is_active)->toBeFalse()
+        ->and(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(1);
+});
+
+it('keeps issuing into a deactivated queue rejected', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    (new UpdateQueue)($queue, managerOf($entity), isActive: false);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+});
+
+it('reactivates a queue', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => false]);
+
+    (new UpdateQueue)($queue, managerOf($entity), isActive: true);
+
+    expect($queue->fresh()->is_active)->toBeTrue();
+});
+
+it('keeps the queue unchanged when every parameter is null', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral', 'is_active' => true]);
+
+    (new UpdateQueue)($queue, managerOf($entity));
+
+    expect($queue->fresh())
+        ->name->toBe('Geral')
+        ->slug->toBe('geral')
+        ->is_active->toBeTrue();
+});
+
+it('accepts keeping its own slug', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral']);
+
+    (new UpdateQueue)($queue, managerOf($entity), name: 'Geral 2', slug: 'Geral');
+
+    expect($queue->fresh())
+        ->name->toBe('Geral 2')
+        ->slug->toBe('geral');
+});
+
+it('rejects taking the slug of another queue in the same entity', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->create(['slug' => 'balcao']);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral', 'name' => 'Geral']);
+
+    expect(fn () => (new UpdateQueue)($queue, managerOf($entity), slug: 'Balcão'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->slug)->toBe('geral');
+});
+
+it('allows a slug used by a queue of another entity', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->create(['slug' => 'balcao']);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral']);
+
+    (new UpdateQueue)($queue, managerOf($entity), slug: 'balcao');
+
+    expect($queue->fresh()->slug)->toBe('balcao');
+});
+
+it('rejects a blank name', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    expect(fn () => (new UpdateQueue)($queue, managerOf($entity), name: '  '))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->name)->toBe('Geral');
+});
+
+it('turns a unique-index race on the slug into a validation error', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral']);
+
+    // Simulates a concurrent request taking the slug after the pre-check passed.
+    Queue::updating(function () use ($entity): void {
+        DB::table('queues')->insert([
+            'entity_id' => $entity->id,
+            'name' => 'Concorrente',
+            'slug' => 'balcao',
+            'is_active' => true,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    });
+
+    try {
+        expect(fn () => (new UpdateQueue)($queue, managerOf($entity), slug: 'balcao'))
+            ->toThrow(ValidationException::class);
+    } finally {
+        Queue::flushEventListeners();
+    }
+
+    expect($queue->fresh()->slug)->toBe('geral');
+});
+
+it('denies an employee, even one with a call grant, and writes nothing', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'is_active' => true]);
+    $employee = memberOf($entity, UserRole::Employee);
+
+    expect(fn () => (new UpdateQueue)($queue, $employee, name: 'Outro', isActive: false))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh())
+        ->name->toBe('Geral')
+        ->is_active->toBeTrue();
+});
+
+it('denies a non-member and a manager of another entity', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    expect(fn () => (new UpdateQueue)($queue, User::factory()->create(), isActive: false))
+        ->toThrow(AuthorizationException::class);
+    expect(fn () => (new UpdateQueue)($queue, managerOf(Entity::factory()->create()), isActive: false))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->is_active)->toBeTrue();
+});
