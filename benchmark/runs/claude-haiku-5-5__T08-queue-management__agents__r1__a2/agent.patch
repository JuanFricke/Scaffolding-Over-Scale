@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\ValidatesQueueAttributes;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Validation\ValidationException;
+
+class CreateQueue
+{
+    use ValidatesQueueAttributes;
+
+    /**
+     * Create an active queue in the entity. The slug defaults to the slug of the name
+     * and must be unique within the entity.
+     *
+     * @throws AuthorizationException when the actor is not an owner or admin of the entity
+     * @throws ValidationException when the name or slug is invalid or the slug is taken
+     */
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $attributes = $this->validatedQueueAttributes($entity->id, null, $name, $slug ?? $name);
+
+        try {
+            return Queue::query()->create([
+                ...$attributes,
+                'entity_id' => $entity->id,
+                'is_active' => true,
+            ]);
+        } catch (QueryException $e) {
+            throw $this->slugConflictOrRethrow($e);
+        }
+    }
+}
