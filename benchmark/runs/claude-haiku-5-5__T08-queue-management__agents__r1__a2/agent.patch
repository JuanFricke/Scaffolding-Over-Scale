+<?php
+
+namespace Database\Factories;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * The queue is created first and the membership is created in the same
+     * entity, so the grant is consistent unless a caller overrides one side.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'queue_id' => fn () => Queue::factory()->create()->id,
+            'entity_membership_id' => fn (array $attributes) => EntityMembership::factory()->create([
+                'entity_id' => Queue::query()->findOrFail($attributes['queue_id'])->entity_id,
+            ])->id,
+            'permissions' => [QueuePermission::Call->value],
+        ];
+    }
+
+    /**
+     * Grant on the given queue, with a new membership in its entity.
+     */
+    public function forQueue(Queue $queue): static
+    {
+        return $this->state(fn (): array => [
+            'queue_id' => $queue->id,
+        ]);
+    }
+
+    /**
+     * Grant for the given membership, on a new queue in its entity.
+     */
+    public function forMembership(EntityMembership $membership): static
+    {
+        return $this->state(fn (): array => [
+            'entity_membership_id' => $membership->id,
+            'queue_id' => Queue::factory()->create(['entity_id' => $membership->entity_id])->id,
+        ]);
+    }
+}
