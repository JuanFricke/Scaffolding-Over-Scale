@@ -0,0 +1,76 @@
+<?php
+
+namespace App\Policies;
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+
+class QueuePolicy
+{
+    /**
+     * Only managers (owner/admin) of the entity may create queues in it.
+     */
+    public function create(User $user, Entity $entity): bool
+    {
+        return $this->isManagerOf($user, $entity->id);
+    }
+
+    /**
+     * Only managers (owner/admin) of the queue's entity may update it.
+     */
+    public function update(User $user, Queue $queue): bool
+    {
+        return $this->isManagerOf($user, $queue->entity_id);
+    }
+
+    /**
+     * Only managers (owner/admin) of the queue's entity may grant or revoke access.
+     */
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->isManagerOf($user, $queue->entity_id);
+    }
+
+    /**
+     * Managers may always call; employees only with a `call` grant on this queue.
+     * A grant whose permissions are not an array (corrupted row) denies.
+     */
+    public function call(User $user, Queue $queue): bool
+    {
+        $membership = $user->membershipFor($queue->entity_id);
+
+        if ($membership === null) {
+            return false;
+        }
+
+        if ($this->isManager($membership)) {
+            return true;
+        }
+
+        $grant = QueueAccess::query()
+            ->where('entity_membership_id', $membership->id)
+            ->where('queue_id', $queue->id)
+            ->first();
+
+        return $grant !== null
+            && is_array($grant->permissions)
+            && in_array(QueuePermission::Call->value, $grant->permissions, true);
+    }
+
+    private function isManagerOf(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership !== null && $this->isManager($membership);
+    }
+
+    private function isManager(EntityMembership $membership): bool
+    {
+        return in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
