+test('mentions the configured discord user when a valid snowflake is set', function (string|int $id, string $expected) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(function (Request $request) use ($expected) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n".$expected)
+            && substr_count($content, $expected) === 1;
+    });
+})->with([
+    'plain snowflake' => ['12345678901234567', '<@12345678901234567>'],
+    'twenty digits' => ['12345678901234567890', '<@12345678901234567890>'],
+    'surrounding whitespace' => ["  12345678901234567\t", '<@12345678901234567>'],
+    'integer value' => [12345678901234567, '<@12345678901234567>'],
+]);
+
+test('adds no mention when mention id is unset or invalid', function (string|int|null $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([
+    'null' => null,
+    'empty string' => '',
+    'everyone' => '@everyone',
+    'here' => '@here',
+    'abc' => 'abc',
+    'too short' => '123',
+    'too long' => '123456789012345678901',
+    'embedded newline' => "123\n@everyone",
+    'extra characters' => "123> \n@everyone",
+    'non digits' => '12345678901234567a',
+]);
+
+test('mention survives truncation while the whole content stays within the limit', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
