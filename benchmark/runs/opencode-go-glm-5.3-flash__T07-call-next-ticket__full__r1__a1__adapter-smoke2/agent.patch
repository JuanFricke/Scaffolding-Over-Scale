+++ b/tests/Feature/CallNextTicketTest.php
@@ -0,0 +1,294 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+function attendantFor(Queue $queue): User
+{
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->for($queue->entity)->for($user)->employee()->create();
+
+    return $user;
+}
+
+function waitingTicket(Queue $queue, int $priority = 0, int $minutesAgo = 10): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'issued_at' => Carbon::parse('2026-01-01 09:00:00')->subMinutes($minutesAgo),
+    ]);
+}
+
+function callNext(Queue $queue, ?User $user = null, CallMode $mode = CallMode::Any): Ticket
+{
+    return (new CallNextTicket)($queue, $user ?? attendantFor($queue), $mode);
+}
+
+it('calls the highest priority waiting ticket first', function () {
+    $queue = Queue::factory()->create();
+    waitingTicket($queue, priority: 5, minutesAgo: 30);
+    $high = waitingTicket($queue, priority: 10, minutesAgo: 5);
+    waitingTicket($queue, priority: 7, minutesAgo: 1);
+
+    $called = callNext($queue);
+
+    expect($called->is($high))->toBeTrue();
+});
+
+it('calls the oldest ticket within the same priority', function () {
+    $queue = Queue::factory()->create();
+    $oldest = waitingTicket($queue, priority: 10, minutesAgo: 40);
+    waitingTicket($queue, priority: 10, minutesAgo: 5);
+
+    $called = callNext($queue);
+
+    expect($called->is($oldest))->toBeTrue();
+});
+
+it('breaks priority and age ties by lowest id', function () {
+    $queue = Queue::factory()->create();
+    $first = waitingTicket($queue, priority: 10, minutesAgo: 20);
+    $second = waitingTicket($queue, priority: 10, minutesAgo: 20);
+
+    // Same priority and same issued_at: deterministic tie-break on id.
+    expect($first->id)->toBeLessThan($second->id);
+
+    $called = callNext($queue);
+
+    expect($called->is($first))->toBeTrue();
+});
+
+it('never selects tickets of other queues', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create();
+    waitingTicket($other, priority: 20, minutesAgo: 1);
+    $mine = waitingTicket($queue, priority: 0, minutesAgo: 5);
+
+    $called = callNext($queue);
+
+    expect($called->is($mine))->toBeTrue();
+});
+
+it('calls only priority tickets in priority_only mode', function () {
+    $queue = Queue::factory()->create();
+    $p1 = waitingTicket($queue, priority: 5, minutesAgo: 40);
+    waitingTicket($queue, priority: 0, minutesAgo: 60);
+    $p2 = waitingTicket($queue, priority: 3, minutesAgo: 20);
+
+    $first = callNext($queue, mode: CallMode::PriorityOnly);
+    $second = callNext($queue, mode: CallMode::PriorityOnly);
+
+    expect($first->is($p1))->toBeTrue();
+    expect($second->is($p2))->toBeTrue();
+});
+
+it('calls the oldest normal ticket in normal_only mode', function () {
+    $queue = Queue::factory()->create();
+    waitingTicket($queue, priority: 10, minutesAgo: 60);
+    $oldestNormal = waitingTicket($queue, priority: 0, minutesAgo: 30);
+    waitingTicket($queue, priority: 0, minutesAgo: 5);
+
+    $called = callNext($queue, mode: CallMode::NormalOnly);
+
+    expect($called->is($oldestNormal))->toBeTrue();
+});
+
+it('throws when no ticket is eligible for the requested mode', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => callNext($queue))->toThrow(NoWaitingTicketsException::class);
+
+    $onlyNormals = Queue::factory()->create();
+    waitingTicket($onlyNormals, priority: 0, minutesAgo: 5);
+
+    expect(fn () => callNext($onlyNormals, mode: CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    $onlyPriority = Queue::factory()->create();
+    waitingTicket($onlyPriority, priority: 10, minutesAgo: 5);
+
+    expect(fn () => callNext($onlyPriority, mode: CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('throws after every waiting ticket has been called', function () {
+    $queue = Queue::factory()->create();
+    $ticket = waitingTicket($queue, priority: 10, minutesAgo: 5);
+
+    expect(callNext($queue)->is($ticket))->toBeTrue();
+
+    expect(fn () => callNext($queue))->toThrow(NoWaitingTicketsException::class);
+});
+
+it('rejects calling next from an inactive queue and changes nothing', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $ticket = waitingTicket($queue, priority: 10, minutesAgo: 5);
+
+    expect(fn () => callNext($queue))->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('rejects calling next with a stale active queue instance after deactivation', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicket($queue, priority: 10, minutesAgo: 5);
+    $stale = Queue::query()->findOrFail($queue->id);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => callNext($stale))->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->where('status', TicketStatus::Called)->count())->toBe(0);
+});
+
+it('restricts any-mode calls to normal after 3 consecutive priority calls', function () {
+    $queue = Queue::factory()->create();
+    waitingTicket($queue, priority: 0, minutesAgo: 50); // oldest overall
+    $p1 = waitingTicket($queue, priority: 10, minutesAgo: 40);
+    $p2 = waitingTicket($queue, priority: 10, minutesAgo: 30);
+    $p3 = waitingTicket($queue, priority: 10, minutesAgo: 20);
+    $p4 = waitingTicket($queue, priority: 10, minutesAgo: 10);
+    waitingTicket($queue, priority: 0, minutesAgo: 15);
+    waitingTicket($queue, priority: 0, minutesAgo: 5);
+
+    expect(callNext($queue)->is($p1))->toBeTrue();
+    $this->travel(1)->seconds();
+    expect(callNext($queue)->is($p2))->toBeTrue();
+    $this->travel(1)->seconds();
+    expect(callNext($queue)->is($p3))->toBeTrue();
+    $this->travel(1)->seconds();
+
+    // Fairness: a normal may not wait behind 3 consecutive priority calls.
+    expect(callNext($queue)->priority)->toBe(0);
+    $this->travel(1)->seconds();
+
+    // A normal call resets the streak: full ordering returns.
+    $fifth = callNext($queue);
+
+    expect($fifth->is($p4))->toBeTrue();
+});
+
+it('counts priority_only and normal_only calls in the fairness history', function () {
+    $queue = Queue::factory()->create();
+    waitingTicket($queue, priority: 0, minutesAgo: 50); // oldest overall
+    $p1 = waitingTicket($queue, priority: 10, minutesAgo: 40);
+    $p2 = waitingTicket($queue, priority: 10, minutesAgo: 30);
+    $p3 = waitingTicket($queue, priority: 10, minutesAgo: 20);
+    $p4 = waitingTicket($queue, priority: 10, minutesAgo: 10);
+    waitingTicket($queue, priority: 0, minutesAgo: 5);
+
+    expect(callNext($queue, mode: CallMode::PriorityOnly)->is($p1))->toBeTrue();
+    expect(callNext($queue, mode: CallMode::PriorityOnly)->is($p2))->toBeTrue();
+    expect(callNext($queue, mode: CallMode::PriorityOnly)->is($p3))->toBeTrue();
+
+    // Fairness is ignored in explicit modes.
+    expect(callNext($queue, mode: CallMode::PriorityOnly)->is($p4))->toBeTrue();
+
+    // But those calls feed the fairness window.
+    $called = callNext($queue);
+
+    expect($called->priority)->toBe(0);
+});
+
+it('resumes full ordering after a normal_only call breaks the streak', function () {
+    $queue = Queue::factory()->create();
+    $p1 = waitingTicket($queue, priority: 10, minutesAgo: 50);
+    $p2 = waitingTicket($queue, priority: 10, minutesAgo: 40);
+    $p3 = waitingTicket($queue, priority: 10, minutesAgo: 30);
+    waitingTicket($queue, priority: 0, minutesAgo: 20);
+
+    expect(callNext($queue)->is($p1))->toBeTrue();
+    $this->travel(1)->seconds();
+    expect(callNext($queue)->is($p2))->toBeTrue();
+    $this->travel(1)->seconds();
+
+    // A normal_only call counts in the history (a normal call breaks the
+    // priority streak even when performed in explicit mode).
+    expect(callNext($queue, mode: CallMode::NormalOnly)->priority)->toBe(0);
+    $this->travel(1)->seconds();
+
+    expect(callNext($queue)->is($p3))->toBeTrue();
+});
+
+it('keeps calling priority tickets when no normal ticket is waiting', function () {
+    $queue = Queue::factory()->create();
+    $p1 = waitingTicket($queue, priority: 10, minutesAgo: 40);
+    $p2 = waitingTicket($queue, priority: 10, minutesAgo: 30);
+    $p3 = waitingTicket($queue, priority: 10, minutesAgo: 20);
+    $p4 = waitingTicket($queue, priority: 10, minutesAgo: 10);
+
+    expect(callNext($queue)->is($p1))->toBeTrue();
+    expect(callNext($queue)->is($p2))->toBeTrue();
+    expect(callNext($queue)->is($p3))->toBeTrue();
+    expect(callNext($queue)->is($p4))->toBeTrue();
+
+    expect(fn () => callNext($queue))->toThrow(NoWaitingTicketsException::class);
+});
+
+it('marks the called ticket fields and respects the write-once rule', function () {
+    $queue = Queue::factory()->create();
+    $member = attendantFor($queue);
+    $ticket = waitingTicket($queue, priority: 10, minutesAgo: 5);
+
+    $called = callNext($queue, $member);
+
+    expect($called->is($ticket))->toBeTrue();
+    expect($called->status)->toBe(TicketStatus::Called);
+    expect($called->called_at)->not->toBeNull();
+    expect($called->called_by_user_id)->toBe($member->id);
+    expect($called->code)->toBe($ticket->code);
+    expect($called->priority)->toBe(10);
+    expect($called->issued_at)->toEqual($ticket->issued_at);
+    expect($called->queue_id)->toBe($queue->id);
+
+    $fresh = $called->fresh();
+
+    expect($fresh->status)->toBe(TicketStatus::Called);
+    expect($fresh->called_at)->not->toBeNull();
+    expect($fresh->called_by_user_id)->toBe($member->id);
+});
+
+it('skips a candidate called concurrently and picks the next waiting ticket', function () {
+    $queue = Queue::factory()->create();
+    $attendant = attendantFor($queue);
+    $racer = attendantFor($queue);
+    $older = waitingTicket($queue, priority: 0, minutesAgo: 40);
+    $newer = waitingTicket($queue, priority: 0, minutesAgo: 20);
+
+    // Simulate a concurrent Ticket::call() (which locks no queue row):
+    // it commits between candidate selection and the candidate row lock.
+    $intercepted = false;
+
+    Ticket::retrieved(function (Ticket $ticket) use (&$intercepted, $racer): void {
+        if ($intercepted) {
+            return;
+        }
