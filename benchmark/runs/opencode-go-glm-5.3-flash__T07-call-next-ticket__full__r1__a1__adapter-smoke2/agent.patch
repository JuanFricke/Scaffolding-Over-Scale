+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * Call the next waiting ticket of a queue deterministically.
+     *
+     * Candidates are the `waiting` tickets of the queue only. Ordering is
+     * higher `priority` first, then oldest `issued_at`, then lowest `id`.
+     * Any-mode additionally applies the fairness rule: when the last three
+     * called tickets of the queue are all priority tickets and at least one
+     * normal ticket is waiting, only normal tickets are called. Any
+     * normal call breaks that streak (the window contains a normal).
+     *
+     * Exactly-once: inside a transaction the queue row is locked (serializes
+     * against queue deactivation and refreshes stale state), then each
+     * candidate row is locked and re-checked to still be `waiting` — a
+     * concurrent `Ticket::call()` (which locks no queue row) is skipped over.
+     *
+     * Only `status`, `called_at`, `called_by_user_id` (and `updated_at`) are
+     * written, per the ticket write-once rule enforced on the model.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // The passed instance may be stale; read the state under a row
+            // lock so deactivation and call-next are serialized.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call the next ticket of an inactive queue.');
+            }
+
+            $restrictToNormals = $mode === CallMode::NormalOnly
+                || ($mode === CallMode::Any && $this->fairnessRestrictsToNormals($lockedQueue->id));
+
+            $candidates = Ticket::query()
+                ->where('queue_id', $lockedQueue->id)
+                ->where('status', TicketStatus::Waiting)
+                ->when($restrictToNormals, fn ($q) => $q->where('priority', 0))
+                ->when($mode === CallMode::PriorityOnly, fn ($q) => $q->where('priority', '>', 0))
+                ->orderByDesc('priority')
+                ->orderBy('issued_at')
+                ->orderBy('id')
+                ->get(['id']);
+
+            foreach ($candidates as $candidate) {
+                // Lock the candidate row and re-check it is still waiting:
+                // a concurrent Ticket::call() does not lock the queue row and
+                // may have committed between candidate selection and here.
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    continue;
+                }
+
+                // Call-path fields bypass mass-assignment protection as
+                // trusted data (same pattern as Ticket::call()).
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+
+            throw new NoWaitingTicketsException('No waiting ticket is eligible for the requested call mode.');
+        });
+    }
+
+    /**
+     * Fairness (any-mode): the last three called tickets of the queue, most
+     * recent first by `called_at` then by `id`; when all three exist and are
+     * priority tickets and at least one normal ticket is waiting, the next
+     * call must come from the normal candidates (the oldest normal wins).
+     */
+    private function fairnessRestrictsToNormals(int $queueId): bool
+    {
+        $recent = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->pluck('priority');
+
+        if ($recent->count() < 3 || $recent->contains(fn (int $priority): bool => $priority <= 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
