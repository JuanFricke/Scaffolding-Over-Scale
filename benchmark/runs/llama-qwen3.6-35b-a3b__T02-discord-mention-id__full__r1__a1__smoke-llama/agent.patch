diff --git a/tests/Feature/DiscordOpsAlertMentionTest.php b/tests/Feature/DiscordOpsAlertMentionTest.php
new file mode 100644
index 0000000..3de7515
--- /dev/null
+++ b/tests/Feature/DiscordOpsAlertMentionTest.php
@@ -0,0 +1,216 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+
+beforeEach(function () {
+    Http::preventStrayRequests();
+});
+
+test('appends mention when DISCORD_MENTION_ID is a valid snowflake', function () {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_contains($content, '<@123456789012345678>');
+    });
+});
+
+test('mention appears on its own line after content', function () {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+        $lines = explode("\n", $content);
+
+        return end($lines) === '<@123456789012345678>';
+    });
+});
+
+test('no mention when DISCORD_MENTION_ID is null', function () {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => null]);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+});
+
+test('no mention when DISCORD_MENTION_ID is empty string', function () {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => '']);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+});
+
+test('rejects non-digit mention ids', function (string $id) {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => $id]);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+})->with([
+    '@everyone',
+    '@here',
+    'abc',
+    '123',
+    '123\n@everyone',
+    "123> \n@everyone",
+]);
+
+test('rejects mention ids shorter than 17 digits', function (string $id) {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => $id]);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+})->with([
+    '1234567890123456',    // 16 digits
+    '123456789012345',     // 15 digits
+]);
+
+test('rejects mention ids longer than 20 digits', function (string $id) {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => $id]);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+})->with([
+    '123456789012345678901',   // 21 digits
+    '1234567890123456789012',  // 22 digits
+]);
+
+test('accepts mention ids of exactly 17 to 20 digits', function (string $id) {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => $id]);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) use ($id) {
+        $content = $request['content'] ?? '';
+
+        return str_contains($content, '<@'.$id.'>');
+    });
+})->with([
+    '123456789012345678',   // 18 digits
+    '1234567890123456789',  // 19 digits
+    '12345678901234567890', // 20 digits
+]);
+
+test('trims whitespace around mention id', function () {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => '  123456789012345678  ']);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_contains($content, '<@123456789012345678>');
+    });
+});
+
+test('reserves room for mention when truncating long content', function () {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        // Total content must be exactly 1800 characters
+        expect(mb_strlen($content))->toBe(1800);
+
+        // Must end with the mention
+        expect($content)->toContain('<@123456789012345678>');
+
+        return true;
+    });
+});
+
+test('truncation without mention stays at 1800 characters', function () {
+    config(['services.discord.webhook_url' => 'https://discord.test/webhook']);
+    config(['services.discord.mention_id' => null]);
+
+    Http::fake([
+        'https://discord.test/webhook' => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(fn (Request $request) => mb_strlen($request['content'] ?? '') === 1800);
+});
