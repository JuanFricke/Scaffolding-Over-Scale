@@ -16,6 +16,9 @@
  *     ]);
  *
  * Unconfigured (empty DISCORD_WEBHOOK_URL) is a silent no-op.
+ * When `services.discord.mention_id` is set to a valid Discord snowflake
+ * (17-20 digits), every alert mentions that user (`<@USER_ID>`) on its own
+ * line at the end of the content.
  */
 class DiscordOpsAlert
 {
@@ -36,7 +39,8 @@ public function send(string $title, string $message, array $context = []): void
             return;
         }
 
-        $content = $this->formatContent($title, $message, $context);
+        $mention = $this->resolveMention();
+        $content = $this->formatContent($title, $message, $context, $mention);
 
         try {
             $response = Http::timeout(3)
@@ -58,15 +62,52 @@ public function send(string $title, string $message, array $context = []): void
     /**
      * @param  array<string, mixed>  $context
      */
-    private function formatContent(string $title, string $message, array $context): string
-    {
+    private function formatContent(
+        string $title,
+        string $message,
+        array $context,
+        ?string $mention = null,
+    ): string {
         $lines = [$title, $message];
 
         foreach ($context as $key => $value) {
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $body = implode("\n", $lines);
+
+        if ($mention !== null) {
+            // Reserve room for the mention (newline + mention string).
+            $mentionLen = mb_strlen($mention);
+            $maxBody = self::MaxContentLength - $mentionLen - 1; // -1 for newline
+
+            return mb_substr($body, 0, max(0, $maxBody))."\n".$mention;
+        }
+
+        return mb_substr($body, 0, self::MaxContentLength);
+    }
+
+    /**
+     * Resolve and validate the Discord mention ID from config.
+     *
+     * Only accepts a 17-20 digit snowflake (whitespace-trimmed).
+     * Returns the mention string or null when not configured / invalid.
+     */
+    private function resolveMention(): ?string
+    {
+        $raw = config('services.discord.mention_id');
+
+        if (! is_string($raw) || $raw === '') {
+            return null;
+        }
+
+        $trimmed = trim($raw);
+
+        if (! preg_match('/^\d{17,20}$/', $trimmed)) {
+            return null;
+        }
+
+        return '<@'.$trimmed.'>';
     }
 
     private function safe(string $key, mixed $value): string
diff --git a/docs/ops/devops.md b/docs/ops/devops.md
