diff --git a/tests/Feature/Auth/AuthenticationTest.php b/tests/Feature/Auth/AuthenticationTest.php
new file mode 100644
index 0000000..c628301
--- /dev/null
+++ b/tests/Feature/Auth/AuthenticationTest.php
@@ -0,0 +1,146 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+test('guests can see the login page', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee(__('ui.login'))
+        ->assertSee(__('ui.password'))
+        ->assertSee(__('ui.forgot_password'))
+        ->assertSee('wire:model="email"', false)
+        ->assertSee('wire:model="password"', false)
+        ->assertSee('wire:model="remember"', false);
+});
+
+test('authenticated users are redirected from login to home', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('a user can log in with valid credentials', function () {
+    $user = User::factory()->create([
+        'password' => 'Password123',
+    ]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Password123')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertRedirect(route('home'))
+        ->assertHasNoErrors();
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('a successful login follows the intended url', function () {
+    $user = User::factory()->create([
+        'password' => 'Password123',
+    ]);
+
+    $this->withSession(['url.intended' => route('bulma-test')]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Password123')
+        ->call('submit')
+        ->assertRedirect(route('bulma-test'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('invalid credentials raise an auth failed error on email', function () {
+    $user = User::factory()->create([
+        'password' => 'Password123',
+    ]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')])
+        ->assertSee(__('auth.failed'));
+
+    $this->assertGuest();
+});
+
+test('login is rate limited after five failed attempts', function () {
+    $user = User::factory()->create([
+        'password' => 'Password123',
+    ]);
+
+    for ($i = 0; $i < 5; $i++) {
+        Livewire::test(Login::class)
+            ->set('email', $user->email)
+            ->set('password', 'wrong-password')
+            ->call('submit')
+            ->assertHasErrors(['email' => __('auth.failed')]);
+    }
+
+    $key = str()->transliterate(str()->lower($user->email).'|127.0.0.1');
+
+    expect(RateLimiter::tooManyAttempts($key, 5))->toBeTrue();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Password123')
+        ->call('submit')
+        ->assertHasErrors(['email']);
+
+    $this->assertGuest();
+});
+
+test('login rejects an invalid e-mail address', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'Password123')
+        ->call('submit')
+        ->assertHasErrors(['email']);
+
+    $this->assertGuest();
+});
+
+test('a user can log out', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('logout'))
+        ->assertRedirect(route('login'));
+
+    $this->assertGuest();
+});
+
+test('guests are redirected from home to login', function () {
+    $this->get(route('home'))->assertRedirect(route('login'));
+});
+
+test('unverified users are redirected from home to the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('verified users can see the home page', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertOk()
+        ->assertSee(__('ui.home'));
+});
+
+test('logout requires authentication', function () {
+    $this->post(route('logout'))->assertRedirect(route('login'));
+
+    expect(Auth::check())->toBeFalse();
+});
diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..5ac364b
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,108 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Contracts\Auth\MustVerifyEmail;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+test('the user model implements must verify email', function () {
+    expect(new User)->toBeInstanceOf(MustVerifyEmail::class);
+});
+
+test('unverified users can see the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee(__('ui.verify_email_title'))
+        ->assertSee('action="'.route('verification.send').'"', false)
+        ->assertSee('action="'.route('logout').'"', false);
+});
+
+test('a signed verification link verifies the logged in user', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $this->actingAs($user)
+        ->get($url)
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a tampered verification link is forbidden and verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $tampered = str_replace(
+        '/email/verify/'.$user->id.'/',
+        '/email/verify/'.($user->id + 1).'/',
+        $url
+    );
+
+    $this->actingAs($user)
+        ->get($tampered)
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a valid link for another user cannot verify the logged in user', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $other->id,
+        'hash' => sha1($other->email),
+    ]);
+
+    $this->actingAs($user)
+        ->get($url)
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('the verification notice redirects verified users home', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('home'));
+});
+
+test('the verification e-mail can be resent', function () {
+    Notification::fake();
+
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect()
+        ->assertSessionHas('status', __('ui.verification_sent'));
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('verified users do not receive another verification e-mail', function () {
+    Notification::fake();
+
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
diff --git a/tests/Feature/Auth/LocalizationTest.php b/tests/Feature/Auth/LocalizationTest.php
new file mode 100644
index 0000000..50c921a
--- /dev/null
+++ b/tests/Feature/Auth/LocalizationTest.php
@@ -0,0 +1,73 @@
+<?php
+
+test('the test suite runs in brazilian portuguese', function () {
+    expect(app()->getLocale())->toBe('pt_BR')
+        ->and(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('the login page is translated to brazilian portuguese', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('the login page can be shown in english', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu a senha?');
+});
+
+test('the translation files define the ui keys in both locales', function () {
+    $pt = require lang_path('pt_BR/ui.php');
+    $en = require lang_path('en/ui.php');
+
+    expect($pt)->toHaveKeys(['login', 'password', 'forgot_password'])
+        ->and($en)->toHaveKeys(['login', 'password', 'forgot_password'])
+        ->and($pt['login'])->toBe('Entrar')
+        ->and($en['login'])->toBe('Log in');
+});
+
+test('env example ships the brazilian portuguese defaults', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)->toContain('APP_NAME=PegaFila')
+        ->and($env)->toContain('APP_LOCALE=pt_BR')
+        ->and($env)->toContain('APP_FALLBACK_LOCALE=en');
+});
+
+test('phpunit pins the locale', function () {
+    $xml = file_get_contents(base_path('phpunit.xml'));
+
+    expect($xml)->toContain('name="APP_LOCALE" value="pt_BR"')
+        ->and($xml)->toContain('name="APP_FALLBACK_LOCALE" value="en"');
+});
+
+test('views only link with named routes', function () {
+    $offenders = [];
+
+    $files = new RecursiveIteratorIterator(
+        new RecursiveDirectoryIterator(resource_path('views'))
+    );
+
+    foreach ($files as $file) {
+        if (! $file->isFile() || ! str_ends_with($file->getFilename(), '.blade.php')) {
+            continue;
+        }
+
+        $contents = file_get_contents($file->getPathname());
+
+        if (preg_match('/(?:href|action)="\/[^"]*"/', $contents)) {
+            $offenders[] = $file->getPathname();
+        }
+    }
+
+    expect($offenders)->toBe([]);
+});
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..dc334ab
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,115 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword as ResetPasswordNotification;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+test('guests can see the forgot password page', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee(__('ui.forgot_password'))
+        ->assertSee('name="email"', false)
+        ->assertSee('action="'.route('password.email').'"', false);
+});
+
+test('a reset link is sent for an existing user', function () {
+    Notification::fake();
+
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPasswordNotification::class);
+});
+
+test('unknown e-mail addresses receive the same status without revealing the account', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'unknown@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('forgot password is throttled at six requests per minute', function () {
+    for ($i = 0; $i < 6; $i++) {
+        $this->post(route('password.email'), ['email' => 'unknown@example.com'])
+            ->assertStatus(302);
+    }
+
+    $this->post(route('password.email'), ['email' => 'unknown@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset page asks for the e-mail exactly once', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $response = $this->get(route('password.reset', [
+        'token' => $token,
+        'email' => $user->email,
+    ]))->assertOk();
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1)
+        ->and($response->getContent())->toContain('action="'.route('password.update').'"');
+});
+
+test('a password can be reset with a valid token', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create([
+        'password' => 'OldPassword123',
+        'remember_token' => 'old-token',
+    ]);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'NewPassword123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewPassword123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token');
+
+    Event::assertDispatched(PasswordReset::class, fn (PasswordReset $event) => $event->user->is($user));
+});
+
+test('an invalid reset token fails on email', function () {
+    $user = User::factory()->create([
+        'password' => 'OldPassword123',
+    ]);
+
+    $this->post(route('password.update'), [
+        'token' => 'invalid-token',
+        'email' => $user->email,
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'NewPassword123',
+    ])->assertSessionHasErrors(['email']);
+
+    expect(Hash::check('OldPassword123', $user->fresh()->password))->toBeTrue();
+});
+
+test('the reset password rule follows the application default', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'weak',
+        'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors(['password']);
+});
diff --git a/tests/Feature/Auth/RegistrationTest.php b/tests/Feature/Auth/RegistrationTest.php
new file mode 100644
index 0000000..bf1cc31
--- /dev/null
+++ b/tests/Feature/Auth/RegistrationTest.php
@@ -0,0 +1,116 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+test('guests can see the register page', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSee(__('ui.register'))
+        ->assertSee(__('ui.name'))
+        ->assertSee('wire:model="email"', false)
+        ->assertSee('wire:model="password"', false)
+        ->assertSee('wire:model="password_confirmation"', false);
+});
+
+test('a user can register and is logged in unverified', function () {
+    Notification::fake();
+    Event::fake([Registered::class]);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertRedirect(route('home'))
+        ->assertHasNoErrors();
+
+    $user = User::where('email', 'maria@example.com')->firstOrFail();
+
+    expect($user->name)->toBe('Maria Silva')
+        ->and($user->email_verified_at)->toBeNull();
+
+    $this->assertAuthenticatedAs($user);
+    Event::assertDispatched(Registered::class, fn (Registered $event) => $event->user->is($user));
+});
+
+test('registration sends the verification notification', function () {
+    Notification::fake();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit');
+
+    $user = User::where('email', 'maria@example.com')->firstOrFail();
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('a mismatched password confirmation fails on password', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Different123')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    expect(User::where('email', 'maria@example.com')->exists())->toBeFalse();
+});
+
+test('the application password rule requires length, mixed case and numbers', function (string $password) {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', $password)
+        ->set('password_confirmation', $password)
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    expect(User::where('email', 'maria@example.com')->exists())->toBeFalse();
+})->with([
+    'short' => 'Ab1',
+    'no numbers' => 'Password',
+    'no uppercase' => 'password123',
+    'no lowercase' => 'PASSWORD123',
+]);
+
+test('the e-mail address must be unique', function () {
+    User::factory()->create(['email' => 'maria@example.com']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+});
+
+test('registration is rate limited by ip', function () {
+    $key = str()->transliterate('register|127.0.0.1');
+
+    for ($i = 0; $i < 5; $i++) {
+        RateLimiter::hit($key, 60);
+    }
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.throttle', ['seconds' => RateLimiter::availableIn($key)])]);
+
+    expect(User::where('email', 'maria@example.com')->exists())->toBeFalse();
+});
