+namespace App\Http\Controllers;
+
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Password;
+use Illuminate\View\View;
+
+class PasswordResetLinkController extends Controller
+{
+    public function create(): View
+    {
+        return view('auth.forgot-password');
+    }
+
+    public function store(Request $request): RedirectResponse
+    {
+        $request->validate([
+            'email' => ['required', 'string', 'email:strict'],
+        ]);
+
+        Password::sendResetLink($request->only('email'));
+
+        // Never reveal whether an account exists for the submitted address.
+        return back()->with('status', __('passwords.sent'));
+    }
+}
diff --git a/app/Livewire/Auth/Login.php b/app/Livewire/Auth/Login.php
new file mode 100644
index 0000000..2ef47e0
--- /dev/null
+++ b/app/Livewire/Auth/Login.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+class Login extends Component
+{
+    #[Validate('required|string|email:strict')]
+    public string $email = '';
+
+    #[Validate('required|string')]
+    public string $password = '';
+
+    public bool $remember = false;
+
+    public function mount(): void
+    {
+        if (Auth::check()) {
+            $this->redirectRoute('home');
+        }
+    }
+
+    public function submit(): void
+    {
+        $this->validate();
+
+        $key = str()->transliterate(str()->lower($this->email).'|'.request()->ip());
+
+        if (RateLimiter::tooManyAttempts($key, 5)) {
+            $this->addError('email', __('auth.throttle', [
+                'seconds' => RateLimiter::availableIn($key),
+            ]));
+
+            return;
+        }
+
+        if (! Auth::attempt([
+            'email' => $this->email,
+            'password' => $this->password,
+        ], $this->remember)) {
+            RateLimiter::hit($key, 60);
+
+            $this->addError('email', __('auth.failed'));
+
+            return;
+        }
+
+        RateLimiter::clear($key);
+
+        session()->regenerate();
+
+        $this->redirectIntended(route('home'));
+    }
+
+    public function render()
+    {
+        return view('livewire.auth.login');
+    }
+}
diff --git a/app/Livewire/Auth/Register.php b/app/Livewire/Auth/Register.php
new file mode 100644
index 0000000..ce52353
--- /dev/null
+++ b/app/Livewire/Auth/Register.php
@@ -0,0 +1,79 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Validation\Rules\Password;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+class Register extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    #[Validate('required|string|email:strict|max:255|unique:users,email')]
+    public string $email = '';
+
+    public string $password = '';
+
+    public string $password_confirmation = '';
+
+    public function mount(): void
+    {
+        if (Auth::check()) {
+            $this->redirectRoute('home');
+        }
+    }
+
+    /**
+     * The password uses the application's single default password rule.
+     *
+     * @return array<string, array<int, mixed>>
+     */
+    protected function rules(): array
+    {
+        return [
+            'password' => ['required', 'string', 'confirmed', Password::defaults()],
+        ];
+    }
+
+    public function submit(): void
+    {
+        $key = str()->transliterate('register|'.request()->ip());
+
+        if (RateLimiter::tooManyAttempts($key, 5)) {
+            $this->addError('email', __('auth.throttle', [
+                'seconds' => RateLimiter::availableIn($key),
+            ]));
+
+            return;
+        }
+
+        $this->validate();
+
+        $user = User::create([
+            'name' => $this->name,
+            'email' => $this->email,
+            'password' => $this->password,
+        ]);
+
+        event(new Registered($user));
+
+        RateLimiter::hit($key, 60);
+
+        Auth::login($user);
+
+        session()->regenerate();
+
+        $this->redirectRoute('home');
+    }
+
+    public function render()
+    {
+        return view('livewire.auth.register');
+    }
+}
