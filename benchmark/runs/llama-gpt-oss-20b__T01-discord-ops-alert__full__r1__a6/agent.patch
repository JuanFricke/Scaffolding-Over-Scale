diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..7d2489d
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,160 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Http;
+
+class DiscordOpsAlert
+{
+    /**
+     * Send an ops alert to Discord via an incoming webhook.
+     *
+     * @param string $title
+     * @param string $message
+     * @param array  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+        if (empty($url)) {
+            return;
+        }
+
+        $content = $this->buildContent($title, $message, $context);
+
+        try {
+            $response = Http::timeout(3)->post($url, ['content' => $content]);
+
+            if (! $response->successful()) {
+                $status = $response->status();
+                Log::error('Discord ops alert failed', ['status' => $status]);
+            }
+        } catch (\Exception $e) {
+            $message = $this->sanitizeException($e, $url);
+            Log::error('Discord ops alert exception', ['exception' => $message]);
+        }
+    }
+
+    /**
+     * Build the message payload with redaction and truncation.
+     */
+    private function buildContent(string $title, string $message, array $context): string
+    {
+        $lines = [];
+        $lines[] = $title;
+        $lines[] = $message;
+
+        foreach ($context as $key => $value) {
+            if ($this->isSensitiveKey($key)) {
+                $lines[] = $key . '=' . '[redacted]';
+            } else {
+                $lines[] = $key . '=' . $this->renderValue($value);
+            }
+        }
+
+        $full = implode("\n", $lines);
+        $max = 1800;
+        if (mb_strlen($full, 'UTF-8') > $max) {
+            return mb_substr($full, 0, $max, 'UTF-8');
+        }
+        return $full;
+    }
+
+    /**
+     * Render a value to string, applying redaction and JSON for arrays.
+     */
+    private function renderValue($value): string
+    {
+        if (is_array($value)) {
+            // Redact recursively with key handling and JSON encode.
+            $redacted = $this->renderArray($value);
+            return json_encode($redacted, JSON_UNESCAPED_UNICODE);
+        }
+
+        if (is_string($value)) {
+            $redacted = $this->redactString($value);
+            return $redacted;
+        }
+
+        return (string) $value;
+    }
+
+    /**
+     * Recursively redacts values according to the rules.
+     */
+    private function redact($value)
+    {
+        if (is_array($value)) {
+            $result = [];
+            foreach ($value as $k => $v) {
+                $result[$k] = $this->redact($v);
+            }
+            return $result;
+        }
+
+        if (is_string($value)) {
+            return $this->redactString($value);
+        }
+
+        return $value;
+    }
+
+    /**
+     * Redact a string if it is sensitive.
+     */
+    private function redactString(string $value): string
+    {
+        // Bearer token redaction
+        if (stripos($value, 'Bearer ') !== false) {
+            return '[redacted]';
+        }
+        return $value;
+    }
+
+    /**
+     * Determine if a key looks sensitive and should be redacted.
+     */
+    private function isSensitiveKey(string $key): bool
+    {
+        $patterns = [
+            '/^password$/i',
+            '/^token$/i',
+            '/^secret$/i',
+            '/^authorization$/i',
+            '/^(api[_-]?key)$/i',
+            '/^webhook$/i',
+        ];
+        foreach ($patterns as $p) {
+            if (preg_match($p, $key)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    /**
+     * Render array values with key redaction.
+     */
+    private function renderArray(array $array): array
+    {
+        $result = [];
+        foreach ($array as $k => $v) {
+            if ($this->isSensitiveKey($k)) {
+                $result[$k] = '[redacted]';
+            } else {
+                $result[$k] = $this->redact($v);
+            }
+        }
+        return $result;
+    }
+
+    /**
+     * Sanitize exception messages to avoid leaking webhook URL.
+     */
+    private function sanitizeException(\Exception $e, string $url): string
+    {
+        $msg = $e->getMessage();
+        return str_replace($url, '[webhook_url]', $msg);
+    }
+}
