+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,94 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $validated = $this->validate();
+        $user = auth()->user() ?? $this->redirect(route('login'));
+
+        // Retry on slug unique collisions: uniqueSlug() checks exists() first,
+        // but a concurrent request may insert the same slug between the check
+        // and our insert (TOCTOU). Each retry recomputes the slug, so it
+        // observes the winner's row and picks the next suffix.
+        $entity = null;
+        for ($attempt = 0; $attempt < 3; $attempt++) {
+            try {
+                $entity = DB::transaction(function () use ($validated, $user) {
+                    $entity = Entity::create([
+                        'name' => $validated['name'],
+                        'slug' => $this->uniqueSlug($validated['name']),
+                    ]);
+
+                    EntityMembership::create([
+                        'entity_id' => $entity->id,
+                        'user_id' => $user->id,
+                        'role' => UserRole::Owner->value,
+                    ]);
+
+                    return $entity;
+                });
+
+                break;
+            } catch (QueryException $e) {
+                if (! $this->isSlugConflict($e) || $attempt === 2) {
+                    throw $e;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirect(route('entity.dashboard', $entity->slug));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity');
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name) ?: Str::slug(Str::random(8));
+        $slug = $base;
+        $i = 2;
+
+        while (Entity::where('slug', $slug)->exists()) {
+            $slug = $base.'-'.$i;
+            $i++;
+        }
+
+        return $slug;
+    }
+
+    protected function isSlugConflict(QueryException $e): bool
+    {
+        $message = strtolower($e->getMessage());
+
+        return str_contains($message, 'entities.slug')
+            || str_contains($message, 'entities_slug_unique');
+    }
+}
