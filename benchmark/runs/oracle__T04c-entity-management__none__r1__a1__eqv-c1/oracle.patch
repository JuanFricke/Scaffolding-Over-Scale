@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Context;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+
+/**
+ * In-request tenant context.
+ *
+ * Populated by the CurrentEntity middleware (an HTTP-layer component) which is
+ * the only place that reads session('current_entity_id'). The models and the
+ * rest of the app resolve this singleton instead of touching the session
+ * directly, keeping domain code session-free and unit-testable.
+ */
+class Tenant
+{
+    public function __construct(
+        public readonly ?User $user = null,
+        public readonly ?int $entityId = null,
+    ) {}
+
+    public function id(): ?int
+    {
+        return $this->entityId;
+    }
+
+    public function entity(): ?Entity
+    {
+        return $this->entityId ? Entity::find($this->entityId) : null;
+    }
+
+    public function membership(): ?EntityMembership
+    {
+        if (! $this->user || ! $this->entityId) {
+            return null;
+        }
+
+        return $this->user->memberships()->where('entity_id', $this->entityId)->first();
+    }
+
+    public function hasAccess(): bool
+    {
+        return $this->membership() !== null;
+    }
+}
