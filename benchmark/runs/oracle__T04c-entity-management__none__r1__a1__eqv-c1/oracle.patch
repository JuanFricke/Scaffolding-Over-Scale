+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class EntityController extends Controller
+{
+    /**
+     * Select the current entity for the tenant session.
+     */
+    public function pick(Request $request, Entity $entity): RedirectResponse
+    {
+        $user = $request->user();
+
+        // Authorization: only a member may activate an entity as their tenant.
+        if (! $user->membershipFor($entity->id)) {
+            abort(403);
+        }
+
+        $request->session()->put('current_entity_id', $entity->id);
+        $request->session()->forget('url.intended');
+
+        Log::channel('audit')->info('Tenant session switched', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        return redirect()->route('entity.dashboard', $entity->slug);
+    }
+}
diff --git a/app/Http/Middleware/CurrentEntity.php b/app/Http/Middleware/CurrentEntity.php
new file mode 100644
index 0000000..3e1c94c
--- /dev/null
+++ b/app/Http/Middleware/CurrentEntity.php
@@ -0,0 +1,76 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Context\Tenant;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Resolves the current tenant (entity) from the session.
+ *
+ * Session is read here because this is the HTTP layer; domain code (models,
+ * Tenant) stays session-free. The resolved Tenant is bound to the container so
+ * policies, Livewire and controllers can resolve it without touching the session.
+ */
+class CurrentEntity
+{
+    /**
+     * Handle an incoming request.
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        if (! $user) {
+            return redirect()->route('login');
+        }
+
+        $entityId = $request->session()->get('current_entity_id');
+
+        if (! $entityId) {
+            return $this->redirectWhenUnset($request, $user, $next);
+        }
+
+        $tenant = new Tenant($user, (int) $entityId);
+
+        // Tampered/stale session: the user is not a member of the session entity.
+        if (! $tenant->hasAccess()) {
+            abort(403);
+        }
+
+        app()->instance(Tenant::class, $tenant);
+
+        return $next($request);
+    }
+
+    /**
+     * Where to send a logged-in user who has no current entity set yet.
+     *
+     * Zero memberships → onboarding. A single membership (any role) auto-connects:
+     * the session is set and the request continues so bookmarks/intended URLs keep
+     * working after login (when the session is still empty). Multiple → switcher.
+     */
+    protected function redirectWhenUnset(Request $request, $user, Closure $next): Response
+    {
+        // Single query: fetch at most 2 rows and count in memory.
+        $memberships = $user->memberships()->take(2)->get();
+
+        if ($memberships->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($memberships->count() > 1) {
+            return redirect()->route('entity.switcher');
+        }
+
+        $membership = $memberships->first();
+
+        $request->session()->put('current_entity_id', $membership->entity_id);
+
+        app()->instance(Tenant::class, new Tenant($user, (int) $membership->entity_id));
+
+        return $next($request);
+    }
+}
