@@ -0,0 +1,130 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Log;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|email:strict|exists:users,email')]
+    public string $email = '';
+
+    /**
+     * Roles an actor may assign here (never owner — that is ownership transfer in Settings).
+     */
+    protected const ASSIGNABLE_ROLES = ['admin', 'employee'];
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $this->authorize('update', $this->entity);
+
+        $data = $this->validate();
+
+        $user = User::where('email', $data['email'])->firstOrFail();
+
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            $this->addError('email', __('entity.member_exists'));
+
+            return;
+        }
+
+        EntityMembership::create([
+            'entity_id' => $this->entity->id,
+            'user_id' => $user->id,
+            'role' => UserRole::Employee->value,
+        ]);
+
+        Log::channel('audit')->info('Member added', [
+            'entity_id' => $this->entity->id,
+            'actor_id' => auth()->id(),
+            'target_user_id' => $user->id,
+        ]);
+
+        $this->reset('email');
+    }
+
+    public function assignRole($membershipId, string $role): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        // The owner membership is immutable here — that path is ownership transfer in Settings.
+        abort_if($membership->role === UserRole::Owner, 403);
+
+        // The owner role is never assignable here — that path is ownership transfer in Settings.
+        if (! in_array($role, self::ASSIGNABLE_ROLES, true)) {
+            $this->addError('role', __('validation.in'));
+
+            return;
+        }
+
+        // Demoting the last manager would leave the entity unmanaged.
+        if ($membership->role === UserRole::Admin && $role === UserRole::Employee->value) {
+            $managers = $this->entity->memberships()
+                ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+                ->count();
+
+            abort_if($managers <= 1, 403);
+        }
+
+        $membership->update(['role' => $role]);
+
+        Log::channel('audit')->info('Member role changed', [
+            'entity_id' => $this->entity->id,
+            'actor_id' => auth()->id(),
+            'target_membership_id' => $membership->id,
+            'role' => $role,
+        ]);
+    }
+
+    public function removeMember($membershipId): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('delete', $membership);
+
+        // Never leave the entity without a manager (owner or admin).
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            $managers = $this->entity->memberships()
+                ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+                ->count();
+
+            abort_if($managers <= 1, 403);
+        }
+
+        $membership->delete();
+
+        Log::channel('audit')->info('Member removed', [
+            'entity_id' => $this->entity->id,
+            'actor_id' => auth()->id(),
+            'target_membership_id' => $membership->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->latest('id')->get(),
+        ]);
+    }
+}
