+     * Membership link between this user and an entity.
+     */
+    public function memberships(): HasMany
+    {
+        return $this->hasMany(EntityMembership::class);
+    }
+
+    /**
+     * Entities this user belongs to, via memberships.
+     */
+    public function entities(): BelongsToMany
+    {
+        return $this->belongsToMany(Entity::class, EntityMembership::class, 'user_id', 'entity_id')
+            ->withPivot('role')
+            ->withTimestamps();
+    }
+
+    /**
+     * The membership for this user in the given entity (session-free).
+     */
+    public function membershipFor(int $entityId): ?EntityMembership
+    {
+        return $this->memberships()->where('entity_id', $entityId)->first();
+    }
 }
