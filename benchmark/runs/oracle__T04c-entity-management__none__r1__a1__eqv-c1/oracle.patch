@@ -0,0 +1,86 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Determine whether the user can view any models.
+     */
+    public function viewAny(User $user): bool
+    {
+        return true;
+    }
+
+    /**
+     * Determine whether the user can view the model (any member).
+     */
+    public function view(User $user, Entity $entity): bool
+    {
+        return (bool) $user->membershipFor($entity->id);
+    }
+
+    /**
+     * Determine whether the user can create models (onboarding path).
+     */
+    public function create(User $user): bool
+    {
+        return $user->exists;
+    }
+
+    /**
+     * Determine whether the user can update the model (admin + owner).
+     */
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    /**
+     * Determine whether the user can delete the model (admin + owner — soft delete).
+     */
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    /**
+     * Determine whether the user can restore the model (admin + owner).
+     */
+    public function restore(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    /**
+     * Determine whether the user can manage entity settings (owner only).
+     */
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $this->isOwner($user, $entity);
+    }
+
+    public function forceDelete(User $user, Entity $entity): bool
+    {
+        return false;
+    }
+
+    protected function isOwner(User $user, Entity $entity): bool
+    {
+        $membership = $user->membershipFor($entity->id);
+
+        return $membership && $membership->role === UserRole::Owner;
+    }
+
+    protected function isManager(User $user, Entity $entity): bool
+    {
+        $membership = $user->membershipFor($entity->id);
+
+        return $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
