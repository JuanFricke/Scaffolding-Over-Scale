+<?php
+
+namespace App\Models;
+
+enum UserRole: string
+{
+    case Owner = 'owner';
+    case Admin = 'admin';
+    case Employee = 'employee';
+
+    /**
+     * Roles a manager may promote/demote between (never owner↔external).
+     *
+     * @return self[]
+     */
+    public static function manageable(): array
+    {
+        return [self::Admin, self::Employee];
+    }
+}
diff --git a/app/Policies/EntityMembershipPolicy.php b/app/Policies/EntityMembershipPolicy.php
new file mode 100644
index 0000000..f8316be
--- /dev/null
+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,85 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Determine whether the user can view any models.
+     */
+    public function viewAny(User $user): bool
+    {
+        return true;
+    }
+
+    /**
+     * Determine whether the user can view the model (any member of the entity).
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return (bool) $user->membershipFor($membership->entity_id);
+    }
+
+    /**
+     * Determine whether the user can assign roles within the entity (admin + owner).
+     * The owner role is never assigned here — that path is ownership transfer.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->isManagerOf($user, $membership->entity_id);
+    }
+
+    /**
+     * Determine whether the user can remove the membership.
+     * The owner can never be removed (transfer first); a non-owner may remove
+     * their own membership, otherwise only a manager of the entity may remove.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        // The owner is immutable while holding the owner role.
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        // Self-removal of a non-owner membership is always allowed.
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->isManagerOf($user, $membership->entity_id);
+    }
+
+    public function update(User $user, EntityMembership $membership): bool
+    {
+        return $this->isManagerOf($user, $membership->entity_id);
+    }
+
+    public function restore(User $user, EntityMembership $membership): bool
+    {
+        return $this->isOwnerOf($user, $membership->entity_id);
+    }
+
+    public function forceDelete(User $user, EntityMembership $membership): bool
+    {
+        return false;
+    }
+
+    protected function isOwnerOf(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership && $membership->role === UserRole::Owner;
+    }
+
+    protected function isManagerOf(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
diff --git a/app/Policies/EntityPolicy.php b/app/Policies/EntityPolicy.php
new file mode 100644
