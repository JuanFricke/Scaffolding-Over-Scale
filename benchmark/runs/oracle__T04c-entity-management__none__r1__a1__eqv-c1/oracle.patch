+++ b/app/Livewire/Entity/Settings.php
@@ -0,0 +1,145 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public string $slug = '';
+
+    #[Validate('required|integer|exists:entity_memberships,id')]
+    public $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    protected function rules(): array
+    {
+        return [
+            'slug' => [
+                'required',
+                'string',
+                'max:255',
+                Rule::unique('entities', 'slug')->ignore($this->entity->id, 'id'),
+            ],
+        ];
+    }
+
+    public function save(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $name = $this->validateOnly('name');
+        $slug = $this->validateOnly('slug');
+        $validated = array_merge($name, $slug);
+
+        $this->entity->update([
+            'name' => $validated['name'],
+            'slug' => $validated['slug'],
+        ]);
+
+        Log::channel('audit')->info('Entity settings updated', [
+            'entity_id' => $this->entity->id,
+            'actor_id' => auth()->id(),
+        ]);
+
+        $this->dispatch('settings-saved');
+    }
+
+    public function delete(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        DB::transaction(function () {
+            $entity = $this->entity;
+
+            $entity->delete();
+            EntityMembership::where('entity_id', $entity->id)->delete();
+
+            Log::channel('audit')->info('Entity soft-deleted', [
+                'entity_id' => $entity->id,
+                'actor_id' => auth()->id(),
+            ]);
+        });
+
+        // The deleted entity may be the current tenant: clear the session.
+        if (session('current_entity_id') === $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirect(route('home'));
+    }
+
+    public function transfer(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        // Only the current owner may initiate an ownership transfer.
+        $currentOwner = $this->entity->ownerMembership();
+        abort_if(! $currentOwner || $currentOwner->user_id !== auth()->id(), 403);
+
+        $data = $this->validateOnly('targetMembershipId');
+
+        $target = $this->entity->memberships()
+            ->where('id', $data['targetMembershipId'])
+            ->first();
+
+        // Cross-entity tampering, non-member target, or transfer to self / non-admin.
+        if (! $target || $target->role !== UserRole::Admin || $target->user_id === auth()->id()) {
+            abort(403);
+        }
+
+        try {
+            DB::transaction(function () use ($target, $currentOwner) {
+                $currentOwner->update(['role' => UserRole::Admin->value]);
+                $target->update(['role' => UserRole::Owner->value]);
+            });
+        } catch (QueryException) {
+            // Concurrent transfer tripped the one-owner unique index.
+            abort(409, 'Ownership transfer conflict. Please retry.');
+        }
+
+        Log::channel('audit')->info('Ownership transferred', [
+            'entity_id' => $this->entity->id,
+            'actor_id' => auth()->id(),
+            'new_owner_id' => $target->user_id,
+        ]);
+
+        $this->redirect(route('entity.dashboard', $this->entity->slug));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'isOwner' => $this->entity->ownerMembership()?->user_id === auth()->id(),
+            'admins' => $this->entity->memberships()
+                ->where('role', UserRole::Admin->value)
+                ->get(),
+        ]);
+    }
+}
diff --git a/app/Models/Entity.php b/app/Models/Entity.php
new file mode 100644
