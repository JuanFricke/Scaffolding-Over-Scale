+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * Call the next ticket for the given queue according to the selected mode.
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Lock the queue row to serialize calls and check active state.
+            $lockedQueue = Queue::query()->whereKey($queue->id)->lockForUpdate()->firstOrFail();
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call tickets from an inactive queue.');
+            }
+
+            // Determine fairness (only applies to 'any' mode).
+            $effectiveMode = $mode;
+            if ($mode === CallMode::Any) {
+                $lastCalled = Ticket::query()
+                    ->where('queue_id', $queue->id)
+                    ->whereNotNull('called_at')
+                    ->orderByDesc('called_at')
+                    ->orderByDesc('id')
+                    ->take(3)
+                    ->get();
+
+                $priorityStreak = $lastCalled->filter(fn (Ticket $t) => $t->priority > 0)->count();
+                $hasNormal = Ticket::query()
+                    ->where('queue_id', $queue->id)
+                    ->where('status', TicketStatus::Waiting)
+                    ->where('priority', 0)
+                    ->exists();
+
+                if ($priorityStreak === 3 && $hasNormal) {
+                    $effectiveMode = CallMode::NormalOnly;
+                }
+            }
+
+            // Build candidate query based on the effective mode.
+            $query = Ticket::query()
+                ->where('queue_id', $queue->id)
+                ->where('status', TicketStatus::Waiting);
+
+            switch ($effectiveMode) {
+                case CallMode::Any:
+                    $query->orderByDesc('priority')->orderBy('issued_at')->orderBy('id');
+                    break;
+                case CallMode::PriorityOnly:
+                    $query->where('priority', '>', 0)
+                        ->orderByDesc('priority')->orderBy('issued_at')->orderBy('id');
+                    break;
+                case CallMode::NormalOnly:
+                    $query->where('priority', 0)
+                        ->orderBy('issued_at')->orderBy('id');
+                    break;
+            }
+
+            // Iterate candidates ensuring the ticket is still waiting.
+            foreach ($query->cursor() as $candidate) {
+                /** @var Ticket|null $candidate */
+                $candidate = Ticket::query()->whereKey($candidate->id)->lockForUpdate()->first();
+                if ($candidate && $candidate->status === TicketStatus::Waiting) {
+                    $candidate->status = TicketStatus::Called;
+                    $candidate->called_at = now();
+                    $candidate->called_by_user_id = $calledBy->id;
+                    $candidate->save();
+
+                    // Refresh to return a fresh instance with updated attributes.
+                    return $candidate->fresh();
+                }
+            }
+
+            // No eligible ticket found.
+            throw new NoWaitingTicketsException('No waiting tickets available for the requested mode.');
+        });
+    }
+}
