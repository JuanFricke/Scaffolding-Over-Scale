@@ -0,0 +1,50 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Support\Facades\Log;
+
+class OpenTotemPairing
+{
+    /**
+     * Open a pairing window for the preset and return its new code.
+     *
+     * Regenerating replaces the previous code (and reopens a consumed window),
+     * so the old code stops working immediately. The code itself is never audited.
+     */
+    public function __invoke(TotemPreset $preset): string
+    {
+        $code = $this->newCode();
+        $expiresAt = now()->addMinutes(TotemPreset::LOGIN_CODE_TTL_MINUTES);
+
+        // Query-level write: the caller's instance may be stale (e.g. consumed by a redeem
+        // since it was loaded), and a dirty-check update would then skip the reset.
+        TotemPreset::query()->whereKey($preset->id)->update([
+            'login_code' => $code,
+            'login_code_expires_at' => $expiresAt,
+            'login_code_consumed_at' => null,
+            'updated_at' => now(),
+        ]);
+
+        Log::channel('audit')->info('totem.pairing.opened', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $expiresAt->toIso8601String(),
+        ]);
+
+        return $code;
+    }
+
+    /**
+     * Cryptographically random six digits, zero-padded, not used by any other preset.
+     */
+    private function newCode(): string
+    {
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while (TotemPreset::query()->where('login_code', $code)->exists());
+
+        return $code;
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
new file mode 100644
index 0000000..6cde337
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Support\Facades\DB;
+
+class PairTotem
+{
+    /**
+     * Redeem a pairing code: consume it, create the totem and sign its token.
+     *
+     * Runs in one transaction with the preset row locked, so a code redeems at most
+     * once and a failed signature rolls the consumption back.
+     *
+     * @return array{totem: Totem, preset: TotemPreset, token: string}
+     *
+     * @throws InvalidPairingCodeException
+     */
+    public function __invoke(string $code): array
+    {
+        return DB::transaction(function () use ($code): array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null) {
+                throw new InvalidPairingCodeException('unknown');
+            }
+
+            if (! $preset->is_active) {
+                throw new InvalidPairingCodeException('inactive');
+            }
+
+            if ($preset->login_code_consumed_at !== null) {
+                throw new InvalidPairingCodeException('consumed');
+            }
+
+            if ($preset->login_code_expires_at === null || $preset->login_code_expires_at->isPast()) {
+                throw new InvalidPairingCodeException('expired');
+            }
+
+            $preset->update(['login_code_consumed_at' => now()]);
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            return [
+                'totem' => $totem,
+                'preset' => $preset,
+                'token' => TotemJwt::issue($totem, $preset, $preset->queueIds()),
+            ];
+        });
+    }
+}
