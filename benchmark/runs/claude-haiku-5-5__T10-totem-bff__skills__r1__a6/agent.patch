@@ -0,0 +1,17 @@
+<?php
+
+namespace App\Exceptions;
+
+use RuntimeException;
+
+/**
+ * A pairing code that cannot be redeemed. The HTTP answer is the same for every
+ * reason (no oracle); `$reason` is for the audit log only.
+ */
+class InvalidPairingCodeException extends RuntimeException
+{
+    public function __construct(public readonly string $reason)
+    {
+        parent::__construct("Pairing code rejected: {$reason}.");
+    }
+}
