+<?php
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function encodeSegment(array $data): string
+{
+    return rtrim(strtr(base64_encode(json_encode($data)), '+/', '-_'), '=');
+}
+
+function scopeClaims(int $exp): array
+{
+    return [
+        'totem_id' => 1,
+        'entity_id' => 1,
+        'preset_id' => 1,
+        'queues' => [1],
+        'iat' => time(),
+        'exp' => $exp,
+        'jti' => 'test-jti',
+    ];
+}
+
+it('issues a token carrying the totem scope claims with the configured ttl', function () {
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->for($preset->entity)->create();
+
+    $claims = TotemJwt::decode(TotemJwt::issue($totem, $preset, [3, 5]));
+
+    expect($claims)->toMatchArray([
+        'totem_id' => $totem->id,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [3, 5],
+    ]);
+    expect($claims['exp'] - $claims['iat'])->toBe(3600);
+    expect($claims['jti'])->toBeString()->not->toBeEmpty();
+});
+
+it('uses a fresh jti for every issued token', function () {
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->for($preset->entity)->create();
+
+    $first = TotemJwt::decode(TotemJwt::issue($totem, $preset, []));
+    $second = TotemJwt::decode(TotemJwt::issue($totem, $preset, []));
+
+    expect($first['jti'])->not->toBe($second['jti']);
+});
+
+it('rejects a token signed with another secret', function () {
+    $token = forgeTotemJwt(scopeClaims(time() + 60), 'another-secret-that-is-long-enough-0123456789');
+
+    expect(fn () => TotemJwt::decode($token))->toThrow(UnexpectedValueException::class);
+});
+
+it('rejects a token whose header declares a different algorithm', function (string $alg) {
+    $token = forgeTotemJwt(scopeClaims(time() + 60), null, ['alg' => $alg, 'typ' => 'JWT']);
+
+    expect(fn () => TotemJwt::decode($token))->toThrow(UnexpectedValueException::class);
+})->with(['none', 'HS512', 'RS256']);
+
+it('rejects a token whose payload was tampered with', function () {
+    $valid = TotemJwt::issue(Totem::factory()->create(), TotemPreset::factory()->create(), [1]);
+    [$header, , $signature] = explode('.', $valid);
+
+    $forged = $header.'.'.encodeSegment(scopeClaims(time() + 60)).'.'.$signature;
+
+    expect(fn () => TotemJwt::decode($forged))->toThrow(UnexpectedValueException::class);
+});
+
+it('rejects an expired token', function () {
+    $token = forgeTotemJwt(scopeClaims(time() - 1));
+
+    expect(fn () => TotemJwt::decode($token))->toThrow(UnexpectedValueException::class);
+});
+
+it('rejects a token without an expiry claim', function () {
+    $claims = scopeClaims(time() + 60);
+    unset($claims['exp']);
+
+    expect(fn () => TotemJwt::decode(forgeTotemJwt($claims)))->toThrow(UnexpectedValueException::class);
+});
+
+it('rejects malformed tokens', function (string $token) {
+    expect(fn () => TotemJwt::decode($token))->toThrow(UnexpectedValueException::class);
+})->with(['', 'not-a-jwt', 'a.b', 'a.b.c.d', '%%%.%%%.%%%']);
+
+it('refuses to issue or verify tokens when the secret is too short', function () {
+    config(['services.totem.jwt_secret' => 'too-short']);
+
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->for($preset->entity)->create();
+
+    expect(fn () => TotemJwt::issue($totem, $preset, []))->toThrow(RuntimeException::class);
+    expect(fn () => TotemJwt::decode(forgeTotemJwt(scopeClaims(time() + 60))))->toThrow(RuntimeException::class);
+});
diff --git a/tests/Feature/Totem/TotemPairingCodeTest.php b/tests/Feature/Totem/TotemPairingCodeTest.php
new file mode 100644
index 0000000..d08a304
--- /dev/null
+++ b/tests/Feature/Totem/TotemPairingCodeTest.php
@@ -0,0 +1,82 @@
+<?php
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+it('opens a pairing window with a six-digit code that expires in ten minutes', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => null,
+        'login_code_expires_at' => null,
+    ]);
+
+    $exitCode = Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    $preset->refresh();
+
+    expect($exitCode)->toBe(0);
+    expect($preset->login_code)->toMatch('/^\d{6}$/');
+    expect(abs($preset->login_code_expires_at->diffInSeconds(now()->addMinutes(10))))->toBeLessThanOrEqual(5);
+    expect($preset->login_code_consumed_at)->toBeNull();
+});
+
+it('prints the generated code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    expect(Artisan::output())->toContain($preset->refresh()->login_code);
+});
+
+it('reopens a window for a preset whose code was already consumed', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code_consumed_at' => now()->subMinute(),
+    ]);
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    expect($preset->refresh()->login_code_consumed_at)->toBeNull();
+});
+
+it('replaces the previous code so the old one stops working', function () {
+    $preset = TotemPreset::factory()->create();
+    $oldCode = $preset->login_code;
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    $newCode = $preset->refresh()->login_code;
+
+    expect($newCode)->not->toBe($oldCode);
+    expect(fn () => (new PairTotem)($oldCode))->toThrow(InvalidPairingCodeException::class);
+});
+
+it('fails with a message for an unknown preset', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999999])
+        ->expectsOutputToContain('not found')
+        ->assertFailed();
+});
+
+it('audits the opened window without writing the code', function () {
+    $preset = TotemPreset::factory()->create();
+    $context = null;
+
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->withArgs(function (string $message, array $data) use (&$context) {
+        $context = $data;
+
+        return $message === 'totem.pairing.opened';
+    });
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    expect($context)->toMatchArray([
+        'preset_id' => $preset->id,
+        'entity_id' => $preset->entity_id,
+    ]);
+    expect(json_encode($context))->not->toContain($preset->refresh()->login_code);
+});
