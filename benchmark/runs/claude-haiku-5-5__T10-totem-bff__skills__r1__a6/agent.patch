@@ -0,0 +1,139 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create(['slug' => 'loja-centro']);
+    $this->preset = TotemPreset::factory()->for($this->entity)->create();
+    $this->geral = Queue::factory()->for($this->entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+    $this->preset->queues()->attach($this->geral);
+    $this->token = pairTotem($this->preset);
+});
+
+it('issues a totem ticket with a sequential code and the chosen priority', function () {
+    $response = $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 10], totemHeaders($this->token));
+
+    $response->assertCreated()
+        ->assertJsonPath('slug', 'A001')
+        ->assertJsonPath('queue.slug', 'geral')
+        ->assertJsonPath('queue.label', 'Geral')
+        ->assertJsonPath('priority.value', 10)
+        ->assertJsonPath('priority.label', 'Prioritário');
+
+    expect(Carbon::parse($response->json('issued_at'))->diffInSeconds(now()))->toBeLessThan(5);
+
+    $ticket = Ticket::query()->sole();
+
+    expect($ticket)
+        ->code->toBe('A001')
+        ->queue_id->toBe($this->geral->id)
+        ->priority->toBe(10)
+        ->channel->toBe(TicketChannel::Totem)
+        ->status->toBe(TicketStatus::Waiting);
+});
+
+it('allocates codes sequentially per queue', function () {
+    $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 0], totemHeaders($this->token))
+        ->assertJsonPath('slug', 'A001');
+    $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 0], totemHeaders($this->token))
+        ->assertJsonPath('slug', 'A002');
+
+    $otherQueue = Queue::factory()->for($this->entity)->create(['slug' => 'caixa']);
+    $this->preset->queues()->attach($otherQueue);
+    $token = pairTotem($this->preset);
+
+    $this->postJson('/api/loja-centro/caixa/ticket', ['priority' => 0], totemHeaders($token))
+        ->assertJsonPath('slug', 'A001');
+});
+
+it('rejects a priority outside the backend-owned values and creates nothing', function ($payload) {
+    $this->postJson('/api/loja-centro/geral/ticket', $payload, totemHeaders($this->token))
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+})->with([
+    'unknown value' => [['priority' => 5]],
+    'above the top level' => [['priority' => 30]],
+    'negative' => [['priority' => -10]],
+    'numeric string' => [['priority' => '10']],
+    'fractional' => [['priority' => 10.5]],
+    'null' => [['priority' => null]],
+    'missing' => [[]],
+]);
+
+it('answers 422 inactive_queue when the queue was deactivated', function () {
+    $this->geral->update(['is_active' => false]);
+
+    $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 0], totemHeaders($this->token))
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 404 queue_not_found for an unknown queue slug', function () {
+    $this->postJson('/api/loja-centro/inexistente/ticket', ['priority' => 0], totemHeaders($this->token))
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 403 forbidden for a queue outside the preset scope', function () {
+    Queue::factory()->for($this->entity)->create(['slug' => 'escondida']);
+
+    $this->postJson('/api/loja-centro/escondida/ticket', ['priority' => 0], totemHeaders($this->token))
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 403 forbidden when the path entity is not the token entity', function () {
+    $this->postJson('/api/outra-loja/geral/ticket', ['priority' => 0], totemHeaders($this->token))
