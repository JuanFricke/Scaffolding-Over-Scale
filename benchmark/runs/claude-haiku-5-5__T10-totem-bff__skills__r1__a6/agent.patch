+/**
+ * Sign claims the way an attacker or a misconfigured issuer might, bypassing the app's issuer.
+ *
+ * @param  array<string, mixed>  $claims
+ * @param  array<string, string>  $header
+ */
+function forgeTotemJwt(array $claims, ?string $secret = null, array $header = ['alg' => 'HS256', 'typ' => 'JWT']): string
+{
+    $encode = fn (array $data): string => rtrim(strtr(base64_encode(json_encode($data)), '+/', '-_'), '=');
+    $signingInput = $encode($header).'.'.$encode($claims);
+    $signature = hash_hmac('sha256', $signingInput, $secret ?? config('services.totem.jwt_secret'), true);
+
+    return $signingInput.'.'.rtrim(strtr(base64_encode($signature), '+/', '-_'), '=');
+}
