+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create(['slug' => 'loja-centro']);
+    $this->preset = TotemPreset::factory()->for($this->entity)->create();
+    $this->queue = Queue::factory()->for($this->entity)->create(['slug' => 'geral']);
+    $this->preset->queues()->attach($this->queue);
+    $this->token = pairTotem($this->preset);
+    $this->url = '/api/loja-centro/queues';
+});
+
+it('rejects a request without a bearer token', function () {
+    $this->getJson($this->url)
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a malformed token', function () {
+    $this->getJson($this->url, ['Authorization' => 'Bearer not-a-jwt'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token that is not sent as a bearer credential', function () {
+    $this->getJson($this->url, ['Authorization' => 'Basic '.$this->token])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects an expired token', function () {
+    $this->travel(-2)->hours();
+    $expired = pairTotem($this->preset);
+    $this->travelBack();
+
+    $this->getJson($this->url, totemHeaders($expired))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token signed with a different secret', function () {
+    $claims = TotemJwt::decode($this->token);
+    $forged = forgeTotemJwt($claims, 'another-secret-that-is-long-enough-0123456789');
+
+    $this->getJson($this->url, totemHeaders($forged))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a validly signed token whose entity claim disagrees with the totem', function () {
+    $other = Entity::factory()->create();
+    $claims = TotemJwt::decode($this->token);
+    $claims['entity_id'] = $other->id;
+
+    $this->getJson($this->url, totemHeaders(forgeTotemJwt($claims)))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose totem row was deactivated', function () {
+    Totem::query()->sole()->update(['is_active' => false]);
+
+    $this->getJson($this->url, totemHeaders($this->token))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose totem row was deleted', function () {
+    Totem::query()->sole()->delete();
+
+    $this->getJson($this->url, totemHeaders($this->token))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose preset was deactivated', function () {
+    $this->preset->update(['is_active' => false]);
+
+    $this->getJson($this->url, totemHeaders($this->token))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose preset was deleted', function () {
+    $this->preset->delete();
+
+    $this->getJson($this->url, totemHeaders($this->token))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose entity was soft-deleted', function () {
+    $this->entity->delete();
+
+    $this->getJson($this->url, totemHeaders($this->token))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('refreshes last_seen_at on every authenticated call', function () {
+    $totem = Totem::query()->sole();
+    $totem->update(['last_seen_at' => now()->subDay()]);
+
+    $this->getJson($this->url, totemHeaders($this->token))->assertOk();
+
+    expect($totem->refresh()->last_seen_at->isAfter(now()->subMinute()))->toBeTrue();
+});
+
+it('answers 403 when the path entity is not the token entity', function () {
+    Entity::factory()->create(['slug' => 'outra-loja']);
+
+    $this->getJson('/api/outra-loja/queues', totemHeaders($this->token))
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('answers 403 for an unknown entity slug too, so slugs cannot be probed', function () {
+    $this->getJson('/api/nao-existe/queues', totemHeaders($this->token))
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
