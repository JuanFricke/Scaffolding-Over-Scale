@@ -0,0 +1,59 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use App\Http\Controllers\Controller;
+use App\Support\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    /**
+     * Exchange a preset's pairing code for a totem JWT.
+     */
+    public function __invoke(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || preg_match('/\A[0-9]{6}\z/', $code) !== 1) {
+            Log::channel('audit')->warning('totem.pairing.failed', [
+                'reason' => 'invalid_code_format',
+                'ip' => $request->ip(),
+            ]);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        try {
+            ['totem' => $totem, 'preset' => $preset, 'token' => $token] = (new PairTotem)($code);
+        } catch (InvalidPairingCodeException $e) {
+            Log::channel('audit')->warning('totem.pairing.failed', [
+                'reason' => $e->reason,
+                'ip' => $request->ip(),
+            ]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        Log::channel('audit')->info('totem.pairing.succeeded', [
+            'totem_id' => $totem->id,
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'ip' => $request->ip(),
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => TotemJwt::ttl(),
+            'entity' => [
+                'slug' => $totem->entity->slug,
+                'name' => $totem->entity->name,
+            ],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemController.php b/app/Http/Controllers/Api/TotemController.php
new file mode 100644
index 0000000..06efb44
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemController.php
@@ -0,0 +1,152 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\TotemApiException;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use App\Support\TotemScope;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * The three authenticated totem reads and writes. Every route runs behind
+ * `totem.auth`, which checks the {@see TotemScope} and the `{entity}` path value.
+ * `$entity` stays in the signatures because Laravel passes route parameters by position.
+ */
+class TotemController extends Controller
+{
+    /**
+     * Queues the totem may issue from: active, in the preset's scope, ordered by name.
+     */
+    public function queues(Request $request, string $entity): JsonResponse
+    {
+        $scope = $this->scope($request);
+
+        $queues = Queue::query()
+            ->whereIn('id', $scope->queueIds)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $scope->entity->slug,
+                'name' => $scope->entity->name,
+            ],
+            'queues' => $queues
+                ->map(fn (Queue $queue, int $index): array => $this->queueJson($scope, $queue, $index + 1))
+                ->all(),
+        ]);
+    }
+
+    /**
+     * Priority levels a queue accepts, with their backend-owned display specs.
+     */
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $scope = $this->scope($request);
+        $resolved = $this->resolveQueue($scope, $queue);
+
+        if (! $resolved->is_active) {
+            throw new TotemApiException(422, 'inactive_queue');
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $scope->entity->slug],
+            'queue' => ['slug' => $resolved->slug, 'label' => $resolved->name],
+            'priorities' => collect(TicketPriority::cases())
+                ->map(fn (TicketPriority $priority, int $index): array => [
+                    'value' => $priority->value,
+                    'label' => $priority->label(),
+                    'visual' => [
+                        'color' => $priority->color(),
+                        'icon' => $priority->icon(),
+                        'order' => $index + 1,
+                    ],
+                ])
+                ->all(),
+        ]);
+    }
+
+    /**
+     * Issue a ticket with the chosen priority. Code allocation and queue rules live in IssueTicket.
+     */
+    public function issueTicket(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $scope = $this->scope($request);
+        $resolved = $this->resolveQueue($scope, $queue);
+
+        $value = $request->input('priority');
+        $priority = is_int($value) ? TicketPriority::tryFrom($value) : null;
+
+        if ($priority === null) {
+            throw new TotemApiException(422, 'invalid_priority');
+        }
+
+        try {
+            $ticket = (new IssueTicket)($resolved, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            throw new TotemApiException(422, 'inactive_queue');
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $resolved->slug, 'label' => $resolved->name],
+            'priority' => ['value' => $priority->value, 'label' => $priority->label()],
+            'issued_at' => $ticket->issued_at->utc()->toIso8601ZuluString(),
+        ], 201);
+    }
+
+    private function scope(Request $request): TotemScope
+    {
+        return $request->attributes->get('totem.scope');
+    }
+
+    /**
+     * Resolve a queue slug within the token's entity only, then check it is in scope.
+     *
+     * @throws TotemApiException 404 when the entity has no such queue, 403 when it is outside scope
+     */
+    private function resolveQueue(TotemScope $scope, string $slug): Queue
+    {
+        $queue = Queue::query()
+            ->where('entity_id', $scope->entity->id)
+            ->where('slug', $slug)
+            ->first();
+
+        if ($queue === null) {
+            throw new TotemApiException(404, 'queue_not_found');
+        }
+
+        if (! in_array((int) $queue->id, $scope->queueIds, true)) {
+            throw new TotemApiException(403, 'forbidden');
+        }
+
+        return $queue;
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    private function queueJson(TotemScope $scope, Queue $queue, int $order): array
+    {
+        $appearance = $scope->preset->queueAppearance($queue);
+
+        return [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => $appearance['description'],
+            'visual' => [
+                'color' => $appearance['color'],
+                'icon' => $appearance['icon'],
+                'order' => $order,
+            ],
+            'is_active' => true,
+        ];
+    }
+}
diff --git a/app/Http/Middleware/AuthenticateTotem.php b/app/Http/Middleware/AuthenticateTotem.php
new file mode 100644
index 0000000..83be24c
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,109 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Exceptions\TotemApiException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use App\Support\TotemScope;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use UnexpectedValueException;
+
+/**
+ * Authenticates totem API calls with the JWT issued at pairing.
+ *
+ * Every call re-checks the totem, its preset and its entity, so deactivating a
+ * totem or changing its preset takes effect at once. The resolved {@see TotemScope}
+ * is stored on the request under `totem.scope`.
+ */
+class AuthenticateTotem
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $scope = $this->resolveScope($request);
+
+        $pathEntity = $request->route('entity');
+
+        if ($pathEntity !== null && $pathEntity !== $scope->entity->slug) {
+            throw new TotemApiException(403, 'forbidden');
+        }
+
+        $request->attributes->set('totem.scope', $scope);
+
+        return $next($request);
+    }
+
+    private function resolveScope(Request $request): TotemScope
+    {
+        $claims = $this->verifiedClaims($request);
+
+        $totem = Totem::query()
+            ->whereKey($claims['totem_id'])
+            ->where('is_active', true)
+            ->first();
+
+        $preset = TotemPreset::query()
+            ->whereKey($claims['preset_id'])
+            ->where('is_active', true)
+            ->first();
+
+        $entity = $totem?->entity;
+
+        if ($totem === null
+            || $preset === null
+            || $entity === null
+            || (int) $totem->entity_id !== $claims['entity_id']
+            || (int) $preset->entity_id !== $claims['entity_id']
+        ) {
+            throw $this->invalidToken();
+        }
+
+        Totem::query()->whereKey($totem->id)->update(['last_seen_at' => now()]);
+
+        return new TotemScope(
+            $totem,
+            $preset,
+            $entity,
+            $preset->scopedQueueIds($claims['queues']),
+        );
+    }
+
+    /**
+     * @return array{totem_id: int, entity_id: int, preset_id: int, queues: array<int, int>}
+     */
+    private function verifiedClaims(Request $request): array
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            throw $this->invalidToken();
+        }
+
+        try {
+            $claims = TotemJwt::decode($token);
+        } catch (UnexpectedValueException) {
+            throw $this->invalidToken();
+        }
+
+        $queues = $claims['queues'] ?? null;
+
+        if (! is_int($claims['totem_id'] ?? null)
+            || ! is_int($claims['entity_id'] ?? null)
+            || ! is_int($claims['preset_id'] ?? null)
+            || ! is_array($queues)
+            || array_filter($queues, 'is_int') !== $queues
+        ) {
+            throw $this->invalidToken();
+        }
+
+        return $claims;
+    }
+
+    private function invalidToken(): TotemApiException
+    {
+        return new TotemApiException(401, 'invalid_token');
+    }
+}
