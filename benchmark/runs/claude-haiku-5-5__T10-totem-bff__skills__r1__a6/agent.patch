+
+it('answers 404 queue_not_found for a slug that does not exist', function () {
+    $this->getJson('/api/loja-centro/inexistente/priorities', totemHeaders($this->token))
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+});
+
+it('answers 404 queue_not_found for a queue slug that only exists in another entity', function () {
+    $other = Entity::factory()->create();
+    Queue::factory()->for($other)->create(['slug' => 'externa']);
