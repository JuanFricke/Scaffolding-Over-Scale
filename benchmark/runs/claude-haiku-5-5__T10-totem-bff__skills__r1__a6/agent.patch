+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned ticket priorities. The one source for issuance validation
+ * (IssueTicket) and for the totem priorities endpoint; entities cannot change them.
+ */
+enum TicketPriority: int
+{
+    case Normal = 0;
+    case Prioritario = 10;
+    case Over80 = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Prioritario => 'Prioritário',
+            self::Over80 => 'Prioridade 80+',
+        };
+    }
+
+    public function color(): string
+    {
+        return match ($this) {
+            self::Normal => '#2E7D32',
+            self::Prioritario => '#C62828',
+            self::Over80 => '#EF6C00',
+        };
+    }
+
+    public function icon(): string
+    {
+        return match ($this) {
+            self::Normal => 'person',
+            self::Prioritario => 'priority',
+            self::Over80 => 'elderly',
+        };
+    }
+}
