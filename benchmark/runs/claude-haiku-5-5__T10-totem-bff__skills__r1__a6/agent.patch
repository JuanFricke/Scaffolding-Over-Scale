@@ -0,0 +1,100 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+it('creates the totem tables with the expected columns', function () {
+    expect(Schema::hasColumns('totems', [
+        'id', 'entity_id', 'name', 'is_active', 'last_seen_at', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+
+    expect(Schema::hasColumns('totem_presets', [
+        'id', 'entity_id', 'name', 'login_code', 'login_code_expires_at', 'login_code_consumed_at',
+        'appearance', 'is_active', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+
+    expect(Schema::hasColumns('totem_preset_queue', [
+        'preset_id', 'queue_id', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+});
+
+it('rejects the same queue twice in a preset', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue);
+
+    expect(fn () => DB::table('totem_preset_queue')->insert([
+        'preset_id' => $preset->id,
+        'queue_id' => $queue->id,
+    ]))->toThrow(QueryException::class);
+});
+
+it('keeps login codes unique across presets', function () {
+    TotemPreset::factory()->create(['login_code' => '246810']);
+
+    expect(fn () => TotemPreset::factory()->create(['login_code' => '246810']))
+        ->toThrow(QueryException::class);
+});
+
+it('creates a preset with its entity and a live six-digit code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->entity)->toBeInstanceOf(Entity::class);
+    expect($preset->login_code)->toMatch('/^\d{6}$/');
+    expect(abs($preset->login_code_expires_at->diffInSeconds(now()->addMinutes(10))))->toBeLessThanOrEqual(5);
+    expect($preset->login_code_consumed_at)->toBeNull();
+    expect($preset->is_active)->toBeTrue();
+});
+
+it('creates an active totem for an entity', function () {
+    $totem = Totem::factory()->create();
+
+    expect($totem->entity)->toBeInstanceOf(Entity::class);
+    expect($totem->is_active)->toBeTrue();
+});
+
+it('exposes totems and presets on the entity', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    expect($entity->totems->modelKeys())->toBe([$totem->id]);
+    expect($entity->totemPresets->modelKeys())->toBe([$preset->id]);
+});
+
+it('attaches and detaches queues on a preset', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue);
+    expect($preset->queues->modelKeys())->toBe([$queue->id]);
+
+    $preset->queues()->detach($queue);
+    expect($preset->refresh()->queues)->toBeEmpty();
+});
+
+it('cascades totems and presets when the entity is force deleted', function () {
+    $entity = Entity::factory()->create();
+    Totem::factory()->for($entity)->create();
+    TotemPreset::factory()->for($entity)->create();
+
+    $entity->forceDelete();
+
+    expect(Totem::query()->count())->toBe(0);
+    expect(TotemPreset::query()->count())->toBe(0);
+});
+
+it('keeps the login code out of serialized presets', function () {
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->toArray())->not->toHaveKey('login_code');
+});
diff --git a/tests/Feature/Totem/TotemTicketTest.php b/tests/Feature/Totem/TotemTicketTest.php
