diff --git a/tests/Feature/Totem/TotemAuthTest.php b/tests/Feature/Totem/TotemAuthTest.php
new file mode 100644
index 0000000..bbc2b9b
--- /dev/null
+++ b/tests/Feature/Totem/TotemAuthTest.php
@@ -0,0 +1,146 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+it('pairs a totem and answers with a bearer token and the entity', function () {
+    $entity = Entity::factory()->create(['name' => 'Loja Centro', 'slug' => 'loja-centro']);
+    $preset = TotemPreset::factory()->for($entity)->create(['login_code' => '123456']);
+    $geral = Queue::factory()->for($entity)->create();
+    $preset->queues()->attach($geral);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+    $response->assertOk()
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', 'loja-centro')
+        ->assertJsonPath('entity.name', 'Loja Centro');
+
+    $claims = TotemJwt::decode($response->json('token'));
+    $totem = Totem::query()->sole();
+
+    expect($claims)->toMatchArray([
+        'totem_id' => $totem->id,
+        'entity_id' => $entity->id,
+        'preset_id' => $preset->id,
+        'queues' => [$geral->id],
+    ]);
+
+    expect($totem)
+        ->entity_id->toBe($entity->id)
+        ->is_active->toBeTrue()
+        ->last_seen_at->not->toBeNull();
+
+    expect($preset->refresh()->login_code_consumed_at)->not->toBeNull();
+});
+
+it('rejects codes that are not exactly six digits with invalid_code_format', function ($code) {
+    $preset = TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+
+    expect(Totem::query()->count())->toBe(0);
+    expect($preset->refresh()->login_code_consumed_at)->toBeNull();
+})->with([
+    'empty' => [''],
+    'missing' => [null],
+    'five digits' => ['12345'],
+    'seven digits' => ['1234567'],
+    'letters' => ['12345a'],
+    'embedded space' => ['123 56'],
+    'json number' => [123456],
+]);
+
+it('answers the same 401 for unknown, expired, consumed or inactive codes', function (Closure $arrange) {
+    $arrange();
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with([
+    'unknown code' => [fn () => TotemPreset::factory()->create(['login_code' => '654321'])],
+    'expired code' => [fn () => TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->subSecond(),
+    ])],
+    'consumed code' => [fn () => TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_consumed_at' => now()->subMinute(),
+    ])],
+    'inactive preset' => [fn () => TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'is_active' => false,
+    ])],
+]);
+
+it('accepts a code only once', function () {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('rate limits pairing attempts to 10 per minute with a JSON 429', function () {
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('audits a successful pairing without the full code', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '123456']);
+    $context = null;
+
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->withArgs(function (string $message, array $data) use (&$context) {
+        $context = $data;
+
+        return $message === 'totem.pairing.succeeded';
+    });
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+
+    expect($context)->toMatchArray([
+        'preset_id' => $preset->id,
+        'entity_id' => $preset->entity_id,
+        'totem_id' => Totem::query()->sole()->id,
+    ]);
+    expect(json_encode($context))->not->toContain('123456');
+});
+
+it('audits a failed pairing with a reason but without the submitted code', function () {
+    TotemPreset::factory()->create(['login_code' => '123456', 'login_code_expires_at' => now()->subSecond()]);
+    $context = null;
+
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('warning')->once()->withArgs(function (string $message, array $data) use (&$context) {
+        $context = $data;
+
+        return $message === 'totem.pairing.failed';
+    });
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertStatus(401);
+
+    expect($context)->toMatchArray(['reason' => 'expired']);
+    expect(json_encode($context))->not->toContain('123456');
+});
