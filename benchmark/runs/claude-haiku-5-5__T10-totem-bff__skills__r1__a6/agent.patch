+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create(['name' => 'Loja Centro', 'slug' => 'loja-centro']);
+    $this->preset = TotemPreset::factory()->for($this->entity)->create([
+        'appearance' => [
+            'queues' => [
+                'triagem' => [
+                    'description' => 'Triagem inicial',
+                    'color' => '#C62828',
+                    'icon' => 'stethoscope',
+                ],
+            ],
+        ],
+    ]);
+    $this->triagem = Queue::factory()->for($this->entity)->create(['name' => 'Triagem', 'slug' => 'triagem']);
+    $this->geral = Queue::factory()->for($this->entity)->create(['name' => 'Atendimento Geral', 'slug' => 'geral']);
+    $this->inactive = Queue::factory()->for($this->entity)->create([
+        'name' => 'Caixa',
+        'slug' => 'caixa',
+        'is_active' => false,
+    ]);
+    $this->preset->queues()->attach([$this->triagem->id, $this->geral->id, $this->inactive->id]);
+    $this->token = pairTotem($this->preset);
+});
+
+it('lists the active queues of the preset ordered by name with visual specs', function () {
+    $response = $this->getJson('/api/loja-centro/queues', totemHeaders($this->token));
+
+    $response->assertOk()
+        ->assertExactJson([
+            'entity' => ['slug' => 'loja-centro', 'name' => 'Loja Centro'],
+            'queues' => [
+                [
+                    'slug' => 'geral',
+                    'label' => 'Atendimento Geral',
+                    'description' => null,
+                    'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => 1],
+                    'is_active' => true,
+                ],
+                [
+                    'slug' => 'triagem',
+                    'label' => 'Triagem',
+                    'description' => 'Triagem inicial',
+                    'visual' => ['color' => '#C62828', 'icon' => 'stethoscope', 'order' => 2],
+                    'is_active' => true,
+                ],
+            ],
+        ]);
+});
+
+it('never lists queues outside the preset, even from the same entity', function () {
+    Queue::factory()->for($this->entity)->create(['name' => 'Zeta', 'slug' => 'zeta']);
+
+    $slugs = collect($this->getJson('/api/loja-centro/queues', totemHeaders($this->token))->json('queues'))
+        ->pluck('slug')
+        ->all();
+
+    expect($slugs)->toBe(['geral', 'triagem']);
+});
+
+it('never lists queues of another entity', function () {
+    $other = Entity::factory()->create();
+    $foreign = Queue::factory()->for($other)->create(['name' => 'Alheia', 'slug' => 'alheia']);
+    $this->preset->queues()->attach($foreign);
+
+    $slugs = collect($this->getJson('/api/loja-centro/queues', totemHeaders($this->token))->json('queues'))
+        ->pluck('slug')
+        ->all();
+
+    expect($slugs)->not->toContain('alheia');
+});
+
+it('drops a queue removed from the preset immediately, even for an existing token', function () {
+    $this->preset->queues()->detach($this->geral);
+
+    $slugs = collect($this->getJson('/api/loja-centro/queues', totemHeaders($this->token))->json('queues'))
+        ->pluck('slug')
+        ->all();
+
+    expect($slugs)->toBe(['triagem']);
+});
+
+it('ignores a queue added to the preset after pairing, because the token does not carry it', function () {
+    $late = Queue::factory()->for($this->entity)->create(['name' => 'Tardia', 'slug' => 'tardia']);
+    $this->preset->queues()->attach($late);
+
+    $slugs = collect($this->getJson('/api/loja-centro/queues', totemHeaders($this->token))->json('queues'))
+        ->pluck('slug')
+        ->all();
+
+    expect($slugs)->not->toContain('tardia');
+});
+
+it('scopes the list to the queues the preset had when the token was issued', function () {
+    $late = Queue::factory()->for($this->entity)->create(['name' => 'Tardia', 'slug' => 'tardia']);
+    $this->preset->queues()->attach($late);
+    $lateToken = pairTotem($this->preset);
+
+    $slugs = collect($this->getJson('/api/loja-centro/queues', totemHeaders($lateToken))->json('queues'))
+        ->pluck('slug')
+        ->all();
+
+    expect($slugs)->toBe(['geral', 'tardia', 'triagem']);
+});
diff --git a/tests/Feature/Totem/TotemSchemaTest.php b/tests/Feature/Totem/TotemSchemaTest.php
