diff --git a/app/Support/TotemJwt.php b/app/Support/TotemJwt.php
new file mode 100644
index 0000000..bbd43ed
--- /dev/null
+++ b/app/Support/TotemJwt.php
@@ -0,0 +1,138 @@
+<?php
+
+namespace App\Support;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Support\Carbon;
+use RuntimeException;
+use UnexpectedValueException;
+
+/**
+ * Minimal HS256 JWT for totem sessions.
+ *
+ * Only HS256 is accepted and the header's `alg` must match it exactly, which
+ * rules out `none` and algorithm-confusion tricks. The secret comes from
+ * `services.totem.jwt_secret` and must be at least 32 bytes; without one the
+ * class refuses to sign or verify rather than running with a weak key.
+ */
+final class TotemJwt
+{
+    private const ALGORITHM = 'HS256';
+
+    private const MIN_SECRET_LENGTH = 32;
+
+    /**
+     * Issue a token scoped to one totem, its entity, its preset and the given queues.
+     *
+     * @param  array<int, int>  $queueIds  queues the preset allows at pairing time
+     *
+     * @throws RuntimeException when no usable secret is configured
+     */
+    public static function issue(Totem $totem, TotemPreset $preset, array $queueIds): string
+    {
+        $issuedAt = Carbon::now()->getTimestamp();
+
+        $signingInput = self::encode(['alg' => self::ALGORITHM, 'typ' => 'JWT'])
+            .'.'
+            .self::encode([
+                'totem_id' => $totem->id,
+                'entity_id' => $totem->entity_id,
+                'preset_id' => $preset->id,
+                'queues' => array_values($queueIds),
+                'iat' => $issuedAt,
+                'exp' => $issuedAt + self::ttl(),
+                'jti' => bin2hex(random_bytes(16)),
+            ]);
+
+        return $signingInput.'.'.self::signature($signingInput);
+    }
+
+    /**
+     * Lifetime of an issued token, in seconds.
+     */
+    public static function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl');
+    }
+
+    /**
+     * Verify the token's structure, algorithm, signature and expiry, and return its claims.
+     *
+     * @return array<string, mixed>
+     *
+     * @throws UnexpectedValueException when the token is malformed, mis-signed or expired
+     * @throws RuntimeException when no usable secret is configured
+     */
+    public static function decode(string $token): array
+    {
+        $segments = explode('.', $token);
+
+        if (count($segments) !== 3) {
+            throw new UnexpectedValueException('Malformed token.');
+        }
+
+        [$header, $payload, $signature] = $segments;
+
+        if ((self::segment($header)['alg'] ?? null) !== self::ALGORITHM) {
+            throw new UnexpectedValueException('Unsupported token algorithm.');
+        }
+
+        if (! hash_equals(self::signature($header.'.'.$payload), $signature)) {
+            throw new UnexpectedValueException('Invalid token signature.');
+        }
+
+        $claims = self::segment($payload);
+
+        if (! is_int($claims['exp'] ?? null) || $claims['exp'] <= Carbon::now()->getTimestamp()) {
+            throw new UnexpectedValueException('Token expired.');
+        }
+
+        return $claims;
+    }
+
+    private static function signature(string $signingInput): string
+    {
+        return self::base64UrlEncode(hash_hmac('sha256', $signingInput, self::secret(), true));
+    }
+
+    private static function secret(): string
+    {
+        $secret = config('services.totem.jwt_secret');
+
+        if (! is_string($secret) || strlen($secret) < self::MIN_SECRET_LENGTH) {
+            throw new RuntimeException('TOTEM_JWT_SECRET must be set to at least 32 bytes.');
+        }
+
+        return $secret;
+    }
+
+    /**
+     * @param  array<string, mixed>  $data
+     */
+    private static function encode(array $data): string
+    {
+        return self::base64UrlEncode(json_encode($data, JSON_THROW_ON_ERROR));
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    private static function segment(string $segment): array
+    {
+        $padding = str_repeat('=', (4 - strlen($segment) % 4) % 4);
+        $json = base64_decode(strtr($segment, '-_', '+/').$padding, true);
+        $data = $json === false ? null : json_decode($json, true);
+
+        if (! is_array($data)) {
+            throw new UnexpectedValueException('Malformed token segment.');
+        }
+
+        return $data;
+    }
+
+    private static function base64UrlEncode(string $data): string
+    {
+        return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');
+    }
+}
