+<?php
+
+namespace App\Models;
+
+use Database\Factories\TotemPresetFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Attributes\Hidden;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\BelongsToMany;
+
+/**
+ * A limited totem configuration: which queues one paired totem may use and how
+ * it looks. Each preset owns its pairing code.
+ */
+#[Fillable([
+    'entity_id',
+    'name',
+    'login_code',
+    'login_code_expires_at',
+    'login_code_consumed_at',
+    'appearance',
+    'is_active',
+])]
+#[Hidden(['login_code'])]
+class TotemPreset extends Model
+{
+    /** @use HasFactory<TotemPresetFactory> */
+    use HasFactory;
+
+    /** Minutes a pairing window stays open after the code is generated. */
+    public const LOGIN_CODE_TTL_MINUTES = 10;
+
+    /** Display defaults for a queue that has no entry in `appearance`. */
+    private const DEFAULT_QUEUE_COLOR = '#0055FF';
+
+    private const DEFAULT_QUEUE_ICON = 'ticket';
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'login_code_expires_at' => 'datetime',
+            'login_code_consumed_at' => 'datetime',
+            'appearance' => 'array',
+            'is_active' => 'boolean',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Queues this preset can see, through `totem_preset_queue`.
+     *
+     * @return BelongsToMany<Queue, $this>
+     */
+    public function queues(): BelongsToMany
+    {
+        return $this->belongsToMany(Queue::class, 'totem_preset_queue', 'preset_id', 'queue_id')
+            ->withTimestamps();
+    }
+
+    /**
+     * Ids of every queue in the preset's current join.
+     *
+     * @return array<int, int>
+     */
+    public function queueIds(): array
+    {
+        return $this->queues()
+            ->pluck('queues.id')
+            ->map(fn ($id): int => (int) $id)
+            ->all();
+    }
+
+    /**
+     * The given queue ids that the preset still allows in its own entity.
+     *
+     * Intersecting with the live join is what makes removing a queue from a
+     * preset take effect for tokens issued before the removal.
+     *
+     * @param  array<int, int>  $queueIds
+     * @return array<int, int>
+     */
+    public function scopedQueueIds(array $queueIds): array
+    {
+        return $this->queues()
+            ->whereIn('queues.id', $queueIds)
+            ->where('queues.entity_id', $this->entity_id)
+            ->pluck('queues.id')
+            ->map(fn ($id): int => (int) $id)
+            ->all();
+    }
+
+    /**
+     * Display specs for one queue as this preset shows it.
+     *
+     * Read from `appearance['queues'][<queue slug>]`, with defaults for anything
+     * the operator did not set.
+     *
+     * @return array{description: ?string, color: string, icon: string}
+     */
+    public function queueAppearance(Queue $queue): array
+    {
+        $specs = $this->appearance['queues'][$queue->slug] ?? [];
+
+        return [
+            'description' => $specs['description'] ?? null,
+            'color' => $specs['color'] ?? self::DEFAULT_QUEUE_COLOR,
+            'icon' => $specs['icon'] ?? self::DEFAULT_QUEUE_ICON,
+        ];
+    }
+}
