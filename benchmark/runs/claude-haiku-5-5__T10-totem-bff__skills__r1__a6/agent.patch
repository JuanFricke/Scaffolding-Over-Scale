+<?php
+
+use App\Models\Entity;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function preflightHeaders(string $origin): array
+{
+    return [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+        'HTTP_ACCESS_CONTROL_REQUEST_HEADERS' => 'content-type',
+    ];
+}
+
+it('answers a preflight from the local totem web build with 204 and echoes the origin', function () {
+    $this->call('OPTIONS', '/api/totem/auth', [], [], [], preflightHeaders('http://localhost:8081'))
+        ->assertNoContent()
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+});
+
+it('allows localhost and 127.0.0.1 on any port over http or https', function (string $origin) {
+    $this->call('OPTIONS', '/api/totem/auth', [], [], [], preflightHeaders($origin))->assertHeader('Access-Control-Allow-Origin', $origin);
+})->with([
+    'http localhost' => ['http://localhost'],
+    'https localhost with port' => ['https://localhost:8443'],
+    'http 127.0.0.1 with port' => ['http://127.0.0.1:5173'],
+    'https 127.0.0.1' => ['https://127.0.0.1'],
+]);
+
+it('sends no allow-origin header for any other origin', function (string $origin) {
+    $this->call('OPTIONS', '/api/totem/auth', [], [], [], preflightHeaders($origin))->assertHeaderMissing('Access-Control-Allow-Origin');
+})->with([
+    'public site' => ['https://evil.example'],
+    'localhost as a subdomain' => ['http://localhost.evil.example'],
+    'localhost with a path suffix' => ['http://localhost.evil.example/localhost'],
+    'lan address' => ['http://192.168.0.10:8081'],
+    'other scheme' => ['ftp://localhost'],
+]);
+
+it('allows the origin configured in TOTEM_WEB_ORIGIN', function () {
+    config(['cors.allowed_origins' => ['https://totem.pegafila.example']]);
+
+    $this->call('OPTIONS', '/api/totem/auth', [], [], [], preflightHeaders('https://totem.pegafila.example'))
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem.pegafila.example');
+});
+
+it('never answers with credentials support', function () {
+    $this->call('OPTIONS', '/api/totem/auth', [], [], [], preflightHeaders('http://localhost:8081'))->assertHeaderMissing('Access-Control-Allow-Credentials');
+});
+
+it('adds the allow-origin header to actual API responses for allowed origins', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create(['login_code' => '123456']);
+
+    $this->withHeaders(['Origin' => 'http://localhost:8081'])
+        ->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertOk()
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+
+    expect($preset->refresh()->login_code_consumed_at)->not->toBeNull();
+});
