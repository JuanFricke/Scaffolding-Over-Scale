+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 0], totemHeaders($this->token))
+            ->assertCreated();
+    }
+
+    $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 0], totemHeaders($this->token))
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+
+    expect(Ticket::query()->count())->toBe(30);
+});
+
+it('limits issuance per totem, so a second totem on the same client is not blocked', function () {
+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 0], totemHeaders($this->token))
+            ->assertCreated();
+    }
+
+    $otherToken = pairTotem($this->preset);
+
+    $this->postJson('/api/loja-centro/geral/ticket', ['priority' => 0], totemHeaders($otherToken))
+        ->assertCreated();
+});
