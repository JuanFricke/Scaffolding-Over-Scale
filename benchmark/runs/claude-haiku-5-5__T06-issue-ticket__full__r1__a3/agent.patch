+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+/**
+ * Issue a waiting ticket into a queue.
+ */
+class IssueTicket
+{
+    /**
+     * Attempts before giving up on a (queue_id, code) collision.
+     */
+    private const MAX_ATTEMPTS = 3;
+
+    /**
+     * @throws InvalidArgumentException when the priority is negative.
+     * @throws InactiveQueueException when the queue is inactive.
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be zero or greater.');
+        }
+
+        // Each retry recomputes the code, so it observes the winner's row and picks the next one.
+        $ticket = null;
+        for ($attempt = 1; $attempt <= self::MAX_ATTEMPTS; $attempt++) {
+            try {
+                $ticket = DB::transaction(fn () => $this->issue($queue, $priority, $channel));
+
+                break;
+            } catch (QueryException $e) {
+                if (! $this->isCodeConflict($e) || $attempt === self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+
+        return $ticket;
+    }
+
+    private function issue(Queue $queue, int $priority, TicketChannel $channel): Ticket
+    {
+        // The caller's instance may be stale: read is_active from the locked row.
+        $locked = Queue::query()->whereKey($queue->getKey())->lockForUpdate()->first();
+
+        if (! $locked?->is_active) {
+            throw new InactiveQueueException("Queue {$queue->getKey()} is not accepting tickets.");
+        }
+
+        return Ticket::create([
+            'queue_id' => $locked->getKey(),
+            'code' => Ticket::nextCode($locked->getKey()),
+            'priority' => $priority,
+            'channel' => $channel,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ]);
+    }
+
+    private function isCodeConflict(QueryException $e): bool
+    {
+        $message = strtolower($e->getMessage());
+
+        return str_contains($message, 'tickets.code')
+            || str_contains($message, 'tickets_queue_code_unique');
+    }
+}
