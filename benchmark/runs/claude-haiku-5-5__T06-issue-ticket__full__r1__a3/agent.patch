+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('a queue belongs to an entity and the entity lists its queues', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity)->toBeInstanceOf(Entity::class)
+        ->and($queue->entity->queues()->pluck('id')->all())->toBe([$queue->id]);
+});
+
+test('a queue has many tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    expect($queue->tickets)->toHaveCount(1);
+});
+
+test('queue factory creates an active queue under its own entity', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->is_active)->toBeTrue()
+        ->and(Entity::count())->toBe(1);
+});
+
+test('inactive queue factory state creates a deactivated queue', function () {
+    expect(Queue::factory()->inactive()->create()->is_active)->toBeFalse();
+});
+
+test('queue slug is unique within an entity but may repeat across entities', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->create(['entity_id' => $entity->id, 'slug' => 'caixa']);
+
+    expect(fn () => Queue::factory()->create(['entity_id' => $entity->id, 'slug' => 'caixa']))
+        ->toThrow(QueryException::class);
+
+    expect(Queue::factory()->create(['slug' => 'caixa'])->slug)->toBe('caixa');
+});
+
+test('labels are cast to an array and the active flag to a boolean', function () {
+    $queue = Queue::factory()->create([
+        'is_active' => false,
+        'labels_i18n' => ['pt_BR' => 'Caixa', 'en' => 'Cashier'],
+    ]);
+
+    $queue->refresh();
+
+    expect($queue->is_active)->toBeFalse()
+        ->and($queue->labels_i18n)->toBe(['pt_BR' => 'Caixa', 'en' => 'Cashier']);
+});
+
+test('deleting an entity cascades to its queues and their tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $queue->entity->forceDelete();
+
+    expect(Queue::count())->toBe(0)
+        ->and(Ticket::count())->toBe(0);
+});
diff --git a/tests/Feature/Ticket/CallTicketTest.php b/tests/Feature/Ticket/CallTicketTest.php
new file mode 100644
index 0000000..7dd688c
--- /dev/null
+++ b/tests/Feature/Ticket/CallTicketTest.php
@@ -0,0 +1,95 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Queue $queue): User
+{
+    $attendant = User::factory()->create();
+    EntityMembership::factory()->employee()->create([
+        'entity_id' => $queue->entity_id,
+        'user_id' => $attendant->id,
+    ]);
+
+    return $attendant;
+}
+
+test('a member of the entity calls a waiting ticket', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $attendant = memberOf($queue);
+
+    $ticket->call($attendant);
+
+    $ticket->refresh();
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($attendant->id)
+        ->and($ticket->calledBy->is($attendant))->toBeTrue();
+});
+
+test('the call keeps the code, priority and issue time untouched', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+    $issuedAt = $ticket->issued_at->toDateTimeString();
+
+    $ticket->call(memberOf($queue));
+
+    $ticket->refresh();
+    expect($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(10)
+        ->and($ticket->issued_at->toDateTimeString())->toBe($issuedAt);
+});
+
+test('a user outside the entity cannot call the ticket and it stays unchanged', function () {
+    $ticket = Ticket::factory()->create();
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class);
+
+    $ticket->refresh();
+    expect($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('a member of another entity cannot call the ticket', function () {
+    $ticket = Ticket::factory()->create();
+    $otherEntityMember = User::factory()->create();
+    EntityMembership::factory()->create(['user_id' => $otherEntityMember->id]);
+
+    expect(fn () => $ticket->call($otherEntityMember))->toThrow(AuthorizationException::class);
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a ticket can be called only once', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $first = memberOf($queue);
+    $second = memberOf($queue);
+
+    $ticket->call($first);
+
+    expect(fn () => $ticket->call($second))->toThrow(LogicException::class);
+
+    expect($ticket->fresh()->called_by_user_id)->toBe($first->id);
+});
+
+test('a stale instance cannot call a ticket that was already called elsewhere', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $stale = Ticket::find($ticket->id);
+    $attendant = memberOf($queue);
+
+    $ticket->call($attendant);
+
+    expect(fn () => $stale->call($attendant))->toThrow(LogicException::class);
+    expect($stale->fresh()->called_by_user_id)->toBe($attendant->id);
+});
diff --git a/tests/Feature/Ticket/IssueTicketTest.php b/tests/Feature/Ticket/IssueTicketTest.php
new file mode 100644
index 0000000..f4cac30
--- /dev/null
+++ b/tests/Feature/Ticket/IssueTicketTest.php
@@ -0,0 +1,129 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+afterEach(fn () => Carbon::setTestNow());
+
+test('issues a waiting virtual ticket with priority 0 by default', function () {
+    Carbon::setTestNow('2026-10-29 10:00:00');
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at->toDateTimeString())->toBe('2026-10-29 10:00:00')
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull()
+        ->and($ticket->queue->is($queue))->toBeTrue();
+});
+
+test('persists the enum values as their string form', function () {
+    (new IssueTicket)(Queue::factory()->create());
+
+    $row = DB::table('tickets')->first();
+
+    expect($row->status)->toBe('waiting')
+        ->and($row->channel)->toBe('virtual');
+});
+
+test('issues a ticket with the given priority and channel', function () {
+    $ticket = (new IssueTicket)(Queue::factory()->create(), 20, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(20)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem);
+});
+
+test('successive issuances follow the queue code sequence', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    expect($issue($queue)->code)->toBe('A001')
+        ->and($issue($queue)->code)->toBe('A002');
+});
+
+test('a negative priority is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))->toThrow(InvalidArgumentException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('an inactive queue rejects issuance and nothing is persisted', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('a queue deactivated after the caller loaded it is still rejected', function () {
+    $queue = Queue::factory()->create();
+    Queue::whereKey($queue->id)->update(['is_active' => false]);
+
+    expect($queue->is_active)->toBeTrue()
+        ->and(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('retries when the code is taken by a concurrent issuance', function () {
+    $queue = Queue::factory()->create();
+    $collisions = 1;
+
+    Ticket::creating(function (Ticket $ticket) use (&$collisions) {
+        if ($collisions-- > 0) {
+            // Another request takes the code between nextCode() and our insert.
+            DB::table('tickets')->insert([
+                'queue_id' => $ticket->queue_id,
+                'code' => $ticket->code,
+                'priority' => 0,
+                'channel' => 'virtual',
+                'status' => 'waiting',
+                'issued_at' => now(),
+                'created_at' => now(),
+                'updated_at' => now(),
+            ]);
+        }
+    });
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->code)->toBe('A001')
+        ->and(Ticket::count())->toBe(1);
+});
+
+test('gives up after a bounded number of colliding attempts', function () {
+    $queue = Queue::factory()->create();
+    $collisions = 3;
+
+    Ticket::creating(function (Ticket $ticket) use (&$collisions) {
+        if ($collisions-- > 0) {
+            DB::table('tickets')->insert([
+                'queue_id' => $ticket->queue_id,
+                'code' => $ticket->code,
+                'priority' => 0,
+                'channel' => 'virtual',
+                'status' => 'waiting',
+                'issued_at' => now(),
+                'created_at' => now(),
+                'updated_at' => now(),
+            ]);
+        }
+    });
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(QueryException::class)
+        ->and(Ticket::count())->toBe(0);
+});
diff --git a/tests/Feature/Ticket/NextCodeTest.php b/tests/Feature/Ticket/NextCodeTest.php
new file mode 100644
index 0000000..1f2141f
--- /dev/null
+++ b/tests/Feature/Ticket/NextCodeTest.php
@@ -0,0 +1,83 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the first code of a queue is A001', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+});
+
+test('nextCode does not persist anything', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::nextCode($queue->id);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('codes are sequential and independent per queue', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($other)->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A003')
+        ->and(Ticket::nextCode($other->id))->toBe('A002');
+});
+
+test('forQueue gives two tickets the codes A001 and A002', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002');
+});
+
+test('an explicit code is kept by the factory', function () {
+    $ticket = Ticket::factory()->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X');
+});
+
+test('deleting a ticket that is not the latest does not reuse its number', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    $deleted = Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $deleted->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('codes keep growing past 999 without padding and follow insertion order', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('malformed legacy codes are skipped when no valid code exists', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+});
+
+test('malformed legacy codes are skipped after a valid code', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+});
diff --git a/tests/Feature/Ticket/TicketWriteOnceTest.php b/tests/Feature/Ticket/TicketWriteOnceTest.php
new file mode 100644
index 0000000..8157e61
--- /dev/null
+++ b/tests/Feature/Ticket/TicketWriteOnceTest.php
@@ -0,0 +1,59 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('changing an issued ticket field throws', function (string $field, mixed $value) {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->{$field} = $value;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+})->with([
+    'code' => ['code', 'A999'],
+    'priority' => ['priority', 5],
+    'channel' => ['channel', TicketChannel::Printed],
+    'issued_at' => ['issued_at', '2020-01-01 00:00:00'],
+]);
+
+test('a changed ticket field is not persisted when the save is rejected', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->priority = 5;
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+
+    expect($ticket->fresh()->priority)->toBe(0);
+});
+
+test('a mass update of an immutable field throws', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['priority' => 9]))->toThrow(LogicException::class);
+});
+
+test('the call fields may change after issuance', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+
+    $ticket->update([
+        'status' => TicketStatus::Called,
+        'called_at' => now(),
+        'called_by_user_id' => $user->id,
+    ]);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+test('a called ticket cannot go back to waiting', function () {
+    $ticket = Ticket::factory()->create();
+    $ticket->update(['status' => TicketStatus::Called, 'called_at' => now()]);
+
+    $ticket->status = TicketStatus::Waiting;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+});
