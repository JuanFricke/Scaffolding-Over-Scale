diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..b545336
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,122 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * The only fields that may change after issuance.
+     */
+    private const CALL_FIELDS = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    /**
+     * Display code shape: `A` followed by digits.
+     */
+    private const CODE_PATTERN = '/^A(\d+)$/D';
+
+    protected static function booted(): void
+    {
+        static::updating(function (Ticket $ticket) {
+            $immutable = array_diff(array_keys($ticket->getDirty()), self::CALL_FIELDS);
+
+            if ($immutable !== []) {
+                throw new LogicException('Ticket fields are write-once after issuance: '.implode(', ', $immutable).'.');
+            }
+
+            $wasCalled = $ticket->getRawOriginal('status') === TicketStatus::Called->value;
+
+            if ($wasCalled && $ticket->isDirty(['status', 'called_at', 'called_by_user_id'])) {
+                throw new LogicException('Ticket has already been called.');
+            }
+        });
+    }
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: the last valid code by insertion order, plus one.
+     * Malformed legacy codes are skipped. Read-only: nothing is persisted.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $lastNumber = static::query()
+            ->select(['id', 'code'])
+            ->where('queue_id', $queueId)
+            ->where('code', 'like', 'A%')
+            ->lazyByIdDesc()
+            ->map(fn (Ticket $ticket) => self::numberOf($ticket->code))
+            ->first(fn (?int $number) => $number !== null);
+
+        return sprintf('A%03d', ($lastNumber ?? 0) + 1);
+    }
+
+    /**
+     * Call this ticket once. Only members of the ticket's entity may call it.
+     *
+     * @throws AuthorizationException when the user is not a member of the entity.
+     * @throws LogicException when the ticket is not waiting.
+     */
+    public function call(User $user): void
+    {
+        Gate::forUser($user)->authorize('call', $this);
+
+        DB::transaction(function () use ($user) {
+            // Re-read under lock: this instance may be stale, and two attendants may race.
+            $current = static::query()->whereKey($this->getKey())->lockForUpdate()->firstOrFail();
+
+            if ($current->status !== TicketStatus::Waiting) {
+                throw new LogicException('Ticket has already been called.');
+            }
+
+            $this->setRawAttributes($current->getAttributes(), true);
+            $this->forceFill([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+            ])->save();
+        });
+    }
+
+    private static function numberOf(string $code): ?int
+    {
+        return preg_match(self::CODE_PATTERN, $code, $matches) === 1 ? (int) $matches[1] : null;
+    }
+}
