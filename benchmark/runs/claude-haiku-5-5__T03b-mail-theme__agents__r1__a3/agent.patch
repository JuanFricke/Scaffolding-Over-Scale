diff --git a/tests/Feature/AccountEmailsTest.php b/tests/Feature/AccountEmailsTest.php
new file mode 100644
index 0000000..4f4c654
--- /dev/null
+++ b/tests/Feature/AccountEmailsTest.php
@@ -0,0 +1,49 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the password reset mail is in pt-BR with the PegaFila brand and a reset link', function () {
+    $user = User::factory()->create();
+    $mail = (new ResetPassword('token-123'))->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Redefina sua senha')
+        ->and($html)->toContain('PegaFila')
+        ->toContain('Olá!')
+        ->toContain('Redefinir senha')
+        ->toContain('Você recebeu esse e-mail porque')
+        ->toContain('Se você estiver tendo problemas para clicar no botão')
+        ->toContain('/reset-password/token-123')
+        ->not->toContain('having trouble clicking')
+        ->not->toContain('You are receiving this email')
+        ->not->toContain('Reset Password');
+});
+
+test('the verification mail is in pt-BR with the PegaFila brand and a signed link', function () {
+    $user = User::factory()->create();
+    $mail = (new VerifyEmail)->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($html)->toContain('PegaFila')
+        ->toContain('Olá!')
+        ->toContain('Verifique o endereço de e-mail')
+        ->toContain('/email/verify/'.$user->getKey().'/'.sha1($user->email))
+        ->toContain('signature=')
+        ->not->toContain('having trouble clicking')
+        ->not->toContain('Verify Email Address');
+});
+
+test('the pegafila theme paints the action button with the brand primary colour', function () {
+    $user = User::factory()->create();
+    $html = (string) (new ResetPassword('token-123'))->toMail($user)->render();
+    preg_match('/<a [^>]*class="button button-primary"[^>]*>/', $html, $button);
+
+    expect($button)->not->toBeEmpty()
+        ->and($button[0])->toContain('background-color: #0f7490');
+});
