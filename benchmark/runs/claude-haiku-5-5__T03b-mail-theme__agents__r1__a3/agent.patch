diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..b5fcd6d
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,162 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+const NEW_PASSWORD = 'NovaSenha123';
+
+test('guests can open the forgot password form with a labelled e-mail field', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('type="email"', false)
+        ->assertSee('name="email"', false)
+        ->assertSee('for="email"', false);
+});
+
+test('authenticated users are redirected away from the forgot password form', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('password.request'))
+        ->assertRedirect();
+});
+
+test('a reset link is sent to a registered address and the response says so', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown address gets the same response and no e-mail is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'ninguem@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionDoesntHaveErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('the forgot password request requires a valid e-mail address', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nao-e-um-email'])
+        ->assertSessionHasErrors('email');
+
+    Notification::assertNothingSent();
+});
+
+test('the forgot password endpoint is throttled to six requests a minute', function () {
+    Notification::fake();
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('password.email'), ['email' => 'ninguem@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'ninguem@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset form carries the token and the e-mail with a single e-mail input', function () {
+    $html = $this->get(route('password.reset', ['token' => 'abc123', 'email' => 'ana@example.com']))
+        ->assertOk()
+        ->assertSee('value="abc123"', false)
+        ->assertSee('value="ana@example.com"', false)
+        ->getContent();
+
+    expect(substr_count($html, 'type="email"'))->toBe(1)
+        ->and(substr_count($html, 'type="password"'))->toBe(2);
+});
+
+test('a valid token sets the new password, rotates the remember token and redirects home', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'token-antigo']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => NEW_PASSWORD,
+        'password_confirmation' => NEW_PASSWORD,
+    ])
+        ->assertRedirect('/')
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check(NEW_PASSWORD, $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('token-antigo')
+        ->and($user->remember_token)->not->toBeNull();
+
+    Event::assertDispatched(PasswordReset::class, fn (PasswordReset $event) => $event->user->is($user));
+});
+
+test('an invalid token is rejected and the password is kept', function () {
+    $user = User::factory()->create(['password' => 'SenhaAntiga123']);
+
+    $this->post(route('password.update'), [
+        'token' => 'token-invalido',
+        'email' => $user->email,
+        'password' => NEW_PASSWORD,
+        'password_confirmation' => NEW_PASSWORD,
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect(Hash::check('SenhaAntiga123', $user->fresh()->password))->toBeTrue();
+});
+
+test('a token issued to one address cannot reset another address', function () {
+    $owner = User::factory()->create();
+    $victim = User::factory()->create(['password' => 'SenhaAntiga123']);
+    $token = Password::broker()->createToken($owner);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $victim->email,
+        'password' => NEW_PASSWORD,
+        'password_confirmation' => NEW_PASSWORD,
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect(Hash::check('SenhaAntiga123', $victim->fresh()->password))->toBeTrue();
+});
+
+test('the new password must be at least 8 characters with letters, mixed case and numbers', function (string $password) {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => $password,
+        'password_confirmation' => $password,
+    ])->assertSessionHasErrors('password');
+})->with([
+    'curta com numero e maiuscula' => 'Curta1A',
+    'sem maiusculas' => 'semmaiuscula1',
+    'sem minusculas' => 'SEMMINUSCULA1',
+    'sem numeros' => 'SemNumeroAqui',
+    'sem letras' => '12345678',
+]);
+
+test('the new password must match its confirmation', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => NEW_PASSWORD,
+        'password_confirmation' => 'OutraSenha123',
+    ])->assertSessionHasErrors('password');
+});
diff --git a/tests/Feature/Auth/VerifyEmailTest.php b/tests/Feature/Auth/VerifyEmailTest.php
new file mode 100644
index 0000000..550f98f
--- /dev/null
+++ b/tests/Feature/Auth/VerifyEmailTest.php
@@ -0,0 +1,98 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function signedVerificationUrl(User $user, ?int $id = null, ?string $hash = null, ?DateTimeInterface $expiresAt = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', $expiresAt ?? now()->addMinutes(60), [
+        'id' => $id ?? $user->getKey(),
+        'hash' => $hash ?? sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('the signed link verifies the logged-in user and redirects to the welcome page', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('an already verified user is redirected without changes', function () {
+    $user = User::factory()->create();
+    $verifiedAt = $user->email_verified_at;
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->fresh()->email_verified_at->equalTo($verifiedAt))->toBeTrue();
+});
+
+test('a hash that does not match the user is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user, hash: 'outro-hash'))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link for another user id is forbidden even with a valid signature', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user, id: $other->getKey()))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link whose id was edited after signing is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->create();
+    $tampered = str_replace(
+        '/email/verify/'.$user->getKey().'/',
+        '/email/verify/'.$other->getKey().'/',
+        signedVerificationUrl($user),
+    );
+
+    $this->actingAs($user)
+        ->get($tampered)
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned or expired link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user, expiresAt: now()->subMinute()))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('the verification link is throttled to six requests a minute', function () {
+    $user = User::factory()->unverified()->create();
+    $url = signedVerificationUrl($user);
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->actingAs($user)->get($url)->assertRedirect('/');
+    }
+
+    $this->actingAs($user)->get($url)->assertStatus(429);
+});
