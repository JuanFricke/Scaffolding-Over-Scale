@@ -0,0 +1,222 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues and tickets tables expose the contract columns and indexes', function () {
+    expect(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'last_ticket_number',
+        'created_at', 'updated_at',
+    ]))->toBeTrue()
+        ->and(Schema::hasIndex('queues', 'queues_entity_id_slug_unique'))->toBeTrue()
+        ->and(Schema::hasColumns('tickets', [
+            'id', 'queue_id', 'code', 'priority', 'channel', 'status', 'issued_at',
+            'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_code_unique'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_status_priority_issued_at_index'))->toBeTrue();
+});
+
+test('queue and entity relationships and casts work', function () {
+    $queue = Queue::factory()->create(['labels_i18n' => ['pt_BR' => 'Geral']]);
+
+    expect($queue->is_active)->toBeTrue()
+        ->and($queue->labels_i18n)->toBe(['pt_BR' => 'Geral'])
+        ->and($queue->entity)->toBeInstanceOf(Entity::class)
+        ->and($queue->entity->queues()->whereKey($queue->id)->exists())->toBeTrue()
+        ->and($queue->tickets()->count())->toBe(0);
+});
+
+test('ticket codes grow by insertion order and skip malformed legacy codes', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-Y']);
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    expect(Ticket::nextCode($queue->id))->toBe('A1000');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('deleting a ticket does not rewind the sequence', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+    $last = Ticket::factory()->forQueue($queue)->create();
+
+    $second->delete();
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+
+    $last->delete();
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('ticket factory allocates codes when none is given and preserves explicit codes', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+    $legacy = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and($legacy->code)->toBe('A-X')
+        ->and($first->status)->toBe(TicketStatus::Waiting)
+        ->and($first->channel)->toBe(TicketChannel::Virtual)
+        ->and($first->priority)->toBe(0)
+        ->and($first->issued_at)->not->toBeNull();
+});
+
+test('issuing a ticket persists a waiting ticket with defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('issuing accepts priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue, 20, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(20)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem);
+});
+
+test('issuing rejects negative priority without persisting', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('ticket creation rejects negative priority', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => Ticket::factory()->forQueue($queue)->create(['priority' => -1]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('issuing rejects an inactive queue without persisting', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('issuing rejects a queue deactivated after it was loaded', function () {
+    $queue = Queue::factory()->create();
+    expect($queue->is_active)->toBeTrue();
+
+    DB::table('queues')->where('id', $queue->id)->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('a waiting ticket can be called once by a member of its entity', function () {
+    $queue = Queue::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($user)->employee()->create();
+    $ticket = (new IssueTicket)($queue);
+
+    $ticket->call($user);
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($user->id);
+});
+
+test('a non-member cannot call a ticket and it stays unchanged', function () {
+    $queue = Queue::factory()->create();
+    $ticket = (new IssueTicket)($queue);
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))
+        ->toThrow(AuthorizationException::class);
+
+    $ticket->refresh();
+
+    expect($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('calling a ticket a second time throws and does not change the first call', function () {
+    $queue = Queue::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($user)->employee()->create();
+    $ticket = (new IssueTicket)($queue);
+
+    $ticket->call($user);
+    $calledAt = $ticket->called_at;
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+
+    $ticket->refresh();
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at->equalTo($calledAt))->toBeTrue();
+});
+
+test('ticket fields are write-once after issuance', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['code' => 'A999']))->toThrow(LogicException::class);
+
+    $ticket->refresh();
+    expect($ticket->code)->not->toBe('A999');
+
+    $ticket->priority = 10;
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+
+    $ticket->refresh();
+    expect($ticket->priority)->toBe(0);
+});
+
+test('deleting a queue cascades to its tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $queue->delete();
+
+    expect(Ticket::count())->toBe(0);
+});
