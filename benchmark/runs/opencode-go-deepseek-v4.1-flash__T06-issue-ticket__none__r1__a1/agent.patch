diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..2cd308d
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,199 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+use LogicException;
+
+#[Fillable([
+    'queue_id',
+    'code',
+    'priority',
+    'channel',
+    'status',
+    'issued_at',
+    'called_at',
+    'called_by_user_id',
+])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * @var array<string, mixed>
+     */
+    protected $attributes = [
+        'priority' => 0,
+        'channel' => TicketChannel::Virtual->value,
+        'status' => TicketStatus::Waiting->value,
+    ];
+
+    /**
+     * Attributes that may still change after a ticket has been issued.
+     *
+     * @var list<string>
+     */
+    private const MUTABLE_AFTER_ISSUANCE = [
+        'status',
+        'called_at',
+        'called_by_user_id',
+        'updated_at',
+    ];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        static::creating(function (self $ticket) {
+            if ($ticket->priority < 0) {
+                throw new InvalidArgumentException('Ticket priority must be greater than or equal to zero.');
+            }
+        });
+
+        static::created(function (self $ticket) {
+            $ticket->advanceCodeHighWater();
+        });
+
+        static::deleting(function (self $ticket) {
+            // Keep the high-water mark even when the latest ticket is removed.
+            $ticket->advanceCodeHighWater();
+        });
+
+        static::updating(function (self $ticket) {
+            $changed = array_keys($ticket->getDirty());
+            $forbidden = array_diff($changed, self::MUTABLE_AFTER_ISSUANCE);
+
+            if ($forbidden !== []) {
+                throw new LogicException(sprintf(
+                    'Ticket fields are immutable after issuance: %s.',
+                    implode(', ', $forbidden),
+                ));
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    private function advanceCodeHighWater(): void
+    {
+        $code = (string) $this->getRawOriginal('code');
+
+        if (preg_match('/^A(\d+)$/', $code, $matches) !== 1) {
+            return;
+        }
+
+        $number = (int) $matches[1];
+
+        // Only move the high-water mark forward. Explicit legacy codes may
+        // arrive out of order, and deleting a ticket must never rewind it.
+        DB::table('queues')
+            ->where('id', $this->queue_id)
+            ->where('last_ticket_number', '<', $number)
+            ->update(['last_ticket_number' => $number]);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Allocate the next display code for a queue.
+     *
+     * Codes are read in insertion order (newest first) and malformed legacy
+     * codes are skipped. The numeric suffix is incremented, so A999 is
+     * followed by A1000 rather than by A1000 being treated as smaller.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $highWater = (int) DB::table('queues')
+            ->where('id', $queueId)
+            ->value('last_ticket_number');
+
+        $codes = static::query()
+            ->where('queue_id', $queueId)
+            ->orderByDesc('id')
+            ->pluck('code');
+
+        foreach ($codes as $code) {
+            if (preg_match('/^A(\d+)$/', (string) $code, $matches) === 1) {
+                $lastValid = (int) $matches[1];
+                $number = max($highWater, $lastValid);
+
+                if ($number > $highWater) {
+                    DB::table('queues')
+                        ->where('id', $queueId)
+                        ->update(['last_ticket_number' => $number]);
+                }
+
+                return 'A'.str_pad((string) ($number + 1), 3, '0', STR_PAD_LEFT);
+            }
+        }
+
+        return 'A'.str_pad((string) ($highWater + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call a waiting ticket exactly once.
+     *
+     * @throws AuthorizationException When the user is not a member of the ticket's entity.
+     * @throws LogicException When the ticket is not waiting.
+     */
+    public function call(User $user): void
+    {
+        DB::transaction(function () use ($user) {
+            // Lock and reload so two concurrent calls cannot both observe a
+            // waiting ticket, even if this instance was loaded earlier.
+            $fresh = static::query()
+                ->whereKey($this->getKey())
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            $this->setRawAttributes($fresh->getAttributes(), true);
+
+            if ($this->status !== TicketStatus::Waiting) {
+                throw new LogicException('Only waiting tickets can be called.');
+            }
+
+            $isMember = EntityMembership::query()
+                ->where('entity_id', $this->queue()->value('entity_id'))
+                ->where('user_id', $user->getKey())
+                ->exists();
+
+            if (! $isMember) {
+                throw new AuthorizationException('Only members of the ticket\'s entity may call it.');
+            }
+
+            $this->update([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+            ]);
+        });
+    }
+}
