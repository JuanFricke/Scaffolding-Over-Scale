@@ -0,0 +1,77 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Number of attempts used when a concurrent issuance consumes our code.
+     */
+    private const MAX_ATTEMPTS = 5;
+
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be greater than or equal to zero.');
+        }
+
+        for ($attempt = 1; $attempt <= self::MAX_ATTEMPTS; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    // Always read the queue state inside the transaction: the
+                    // caller's model may have been loaded before deactivation.
+                    $lockedQueue = Queue::query()
+                        ->whereKey($queue->getKey())
+                        ->lockForUpdate()
+                        ->first();
+
+                    if ($lockedQueue === null || ! $lockedQueue->is_active) {
+                        throw new InactiveQueueException('Tickets cannot be issued from an inactive queue.');
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $lockedQueue->getKey(),
+                        'code' => Ticket::nextCode($lockedQueue->getKey()),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (QueryException $exception) {
+                if ($attempt === self::MAX_ATTEMPTS || ! $this->isUniqueConstraintViolation($exception)) {
+                    throw $exception;
+                }
+            }
+        }
+
+        throw new \LogicException('Ticket issuance exhausted its retry attempts.');
+    }
+
+    private function isUniqueConstraintViolation(QueryException $exception): bool
+    {
+        $sqlState = (string) $exception->getCode();
+
+        if ($sqlState === '23000' || $sqlState === '23505') {
+            return true;
+        }
+
+        $message = strtolower($exception->getMessage());
+
+        return str_contains($message, 'unique constraint')
+            || str_contains($message, 'duplicate entry')
+            || str_contains($message, 'unique violation');
+    }
+}
