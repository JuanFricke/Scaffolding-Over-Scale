-# Database Schema — PegaFila
 
-Relational model derived from [`business-rules.md`](business-rules.md). Domain proposal — no migrations in this repository yet.
+## Unique Constraints (continued)
 
-## ER Diagram
-
-```mermaid
-erDiagram
-    plans ||--o{ subscriptions : "define"
-    entities |o--|| billing_accounts : "owns"
-    billing_accounts ||--|| subscriptions : "subscribes"
-    payment_options ||--o{ subscriptions : "defines payment method"
-    subscriptions ||--o{ payments : "generates charges"
-    entities ||--o{ entity_memberships : "has members"
-    users ||--o{ entity_memberships : "participates in"
-    entities ||--o{ queues : "owns queues"
-    queues ||--o{ tickets : "contains"
-    entity_memberships ||--o{ queue_access : "grants"
-    queues ||--o{ queue_access : "accessible via"
-    users ||--o{ tickets : "calls"
-    entities ||--o{ totems : "registers"
-
-    plans {
-        bigint id PK
-        string name
-        int max_users
-        int max_queues
-        decimal price
-    }
-    entities {
-        bigint id PK
-        string name
-        string slug UK
-        bigint owner_membership_id FK
-        string locale_default
-        datetime created_at
-    }
-    billing_accounts {
-        bigint id PK
-        bigint entity_id FK
-        string asaas_customer_id
-        string cpf_cnpj
-        datetime created_at
-    }
-    payment_options {
-        bigint id PK
-        string billing_cycle "[MONTHLY, ANNUAL]"
-        string payment_method "[CARD, PIX, BOLETO]"
-        decimal discount_percent
-        int refund_window_days
-        bool is_preferred
-        bool is_active
-    }
-    subscriptions {
-        bigint id PK
-        bigint billing_account_id FK
-        bigint plan_id FK
-        bigint payment_option_id FK
-        decimal base_value
-        decimal value
-        string status
-        bool cancel_at_period_end
-        string asaas_subscription_id UK
-        datetime current_period_start
-        datetime current_period_end
-        datetime canceled_at
-    }
-    payments {
-        bigint id PK
-        bigint subscription_id FK
-        string asaas_payment_id UK
-        decimal value
-        string status
-        datetime due_date
-        datetime paid_at
-        datetime refund_deadline
-        datetime refunded_at
-    }
-    users {
-        bigint id PK
-        string name
-        string email UK
-        string password
-        datetime email_verified_at
-    }
-    entity_memberships {
-        bigint id PK
-        bigint entity_id FK
-        bigint user_id FK
-        string role
-        datetime created_at
-    }
-    queues {
-        bigint id PK
-        bigint entity_id FK
-        string name
-        string slug
-        bool is_active
-        json labels_i18n
-    }
-    queue_access {
-        bigint id PK
-        bigint entity_membership_id FK
-        bigint queue_id FK
-        json permissions
-    }
-    tickets {
