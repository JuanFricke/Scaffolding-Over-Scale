@@ -0,0 +1,82 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Livewire\Component;
+use Illuminate\Support\Str;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Database\QueryException;
+
+class CreateEntity extends Component
+{
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->validate([
+            'name' => 'required|string|max:255',
+        ]);
+
+        $attempt = 0;
+        do {
+            $createdEntity = null;
+        try {
+            $slug = $this->uniqueSlug($this->name, $attempt);
+            DB::transaction(function () use ($slug, &$createdEntity) {
+                // Create the entity
+                $createdEntity = Entity::create([
+                    'name' => $this->name,
+                    'slug' => $slug,
+                ]);
+
+                // Assign owner membership
+                EntityMembership::create([
+                    'entity_id' => $createdEntity->id,
+                    'user_id' => auth()->id(),
+                    'role' => UserRole::Owner->value,
+                ]);
+
+                // Audit log
+                Log::channel('audit')->info('Entity created', [
+                    'entity_id' => $createdEntity->id,
+                    'actor_id' => auth()->id(),
+                ]);
+
+                // Set session
+                session(['current_entity_id' => $createdEntity->id]);
+            });
+            break;
+        } catch (\\Illuminate\\Database\\QueryException $e) {
+            if ($attempt++ >= 5) {
+                throw $e;
+            }
+        }
+    } while (true);
+
+    return redirect()->route('entity.dashboard', ['entity' => $createdEntity]);
+    }
+
+    protected function uniqueSlug(string $name, int $attempt = 0): string
+    {
+        $base = Str::slug($name);
+        $slug = $attempt > 0 ? $base . '-' . ($attempt + 1) : $base;
+        if ($attempt > 0 && Entity::where('slug', $slug)->exists()) {
+            // fallback to incremental suffix
+            $i = 2;
+            while (Entity::where('slug', $base . '-' . $i)->exists()) {
+                $i++;
+            }
+            $slug = $base . '-' . $i;
+        }
+        return $slug;
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.create-entity');
+    }
+}
