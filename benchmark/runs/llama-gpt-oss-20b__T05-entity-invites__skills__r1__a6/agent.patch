+<?php
+
+namespace App\Mail;
+
+use App\Models\EntityInvite;
+use Illuminate\Foundation\Mailable;
+use Illuminate\Queue\SerializesModels;
+
+class EntityInviteMail extends Mailable
+{
+    use SerializesModels;
+
+    public function __construct(public EntityInvite $invite)
+    {
+    }
+
+    public function build()
+    {
+        $entity = $this->invite->entity;
+        $roleName = __('ui.role_' . $this->invite->role->value);
+        return $this->markdown('emails.entity-invite')
+            ->subject(__('You are invited to :entity', ['entity' => $entity->name]))
+            ->with([
+                'entity' => $entity,
+                'role' => $roleName,
+                'invite' => $this->invite,
+            ]);
+    }
+}
