+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use Illuminate\Contracts\View\View;
+use Livewire\Component;
+use Illuminate\Support\Facades\Log;
+
+class PendingInvites extends Component
+{
+    public int $entityId;
+
+    public function mount(int $entityId): void
+    {
+        $this->entityId = $entityId;
+    }
+
+    public function accept(int $inviteId): void
+    {
+        $invite = EntityInvite::where('entity_id', $this->entityId)->findOrFail($inviteId);
+        $this->authorize('accept', $invite);
+
+        if ($invite->accepted_at) {
+            return; // idempotent
+        }
+
+        if ($invite->expires_at->isPast()) {
+            $this->addError('invite', __('invite.expired'));
+            return;
+        }
+
+        // Create membership
+        $invite->entity->memberships()->create([
+            'user_id' => $invite->email, // but we need user id? We need to find or create user by email
+            'role' => $invite->role,
+        ]);
+
+        $invite->update(['accepted_at' => now()]);
+        Log::channel('audit')->info('Invite accepted', [
+            'entity_id' => $invite->entity_id,
+            'invite_id' => $invite->id,
+        ]);
+
+        session(['current_entity_id' => $invite->entity_id]);
+        return redirect()->route('entity.dashboard', $invite->entity->slug);
+    }
+
+    public function decline(int $inviteId): void
+    {
+        $invite = EntityInvite::where('entity_id', $this->entityId)->findOrFail($inviteId);
+        $this->authorize('decline', $invite);
+        $invite->delete();
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        $invites = EntityInvite::where('entity_id', $this->entityId)
+            ->whereNull('accepted_at')
+            ->where('expires_at', '>', now())
+            ->latest('created_at')
+            ->get();
+        return view('livewire.entity.pending-invites', ['invites' => $invites]);
+    }
+}
