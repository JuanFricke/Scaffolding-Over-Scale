+
+it('skips a candidate that was called concurrently before it could be locked', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($attendant)->employee()->create();
+
+    $first = callNextTicketWaiting($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(10)]);
+    $second = callNextTicketWaiting($queue, ['priority' => 0, 'issued_at' => now()->subMinute()]);
+
+    $injected = false;
+    Ticket::retrieved(function (Ticket $ticket) use (&$injected, $first, $attendant): void {
+        if ($injected || $ticket->id !== $first->id) {
+            return;
+        }
+
+        $injected = true;
+        $first->call($attendant);
+    });
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($injected)->toBeTrue()
+        ->and($called->is($second))->toBeTrue()
+        ->and($first->fresh()->status)->toBe(TicketStatus::Called);
+});
