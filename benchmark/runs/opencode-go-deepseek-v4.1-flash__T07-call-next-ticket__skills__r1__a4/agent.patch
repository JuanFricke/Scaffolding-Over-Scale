+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+function callNextTicketWaiting(Queue $queue, array $attributes = []): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create(array_merge([
+        'status' => TicketStatus::Waiting,
+    ], $attributes));
+}
+
+function callNextTicketCalled(Queue $queue, User $user, int $priority, Carbon $calledAt): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt,
+        'called_by_user_id' => $user->id,
+    ]);
+}
+
+it('calls the highest priority waiting ticket first', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    callNextTicketWaiting($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(10)]);
+    $priority = callNextTicketWaiting($queue, ['priority' => 10, 'issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('defaults to any mode', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    callNextTicketWaiting($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(10)]);
+    $priority = callNextTicketWaiting($queue, ['priority' => 10, 'issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('calls the oldest ticket within the same priority', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $newer = callNextTicketWaiting($queue, ['priority' => 5, 'issued_at' => now()->subMinute()]);
+    $older = callNextTicketWaiting($queue, ['priority' => 5, 'issued_at' => now()->subMinutes(10)]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($called->is($older))->toBeTrue()
+        ->and($called->is($newer))->toBeFalse();
+});
+
+it('uses the lowest id as the final tie-break', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
