+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * Call the next waiting ticket of a queue according to its call mode.
+     *
+     * Ordering is deterministic: higher priority first, then the oldest
+     * issued ticket, then the lowest id. In "any" mode the three-call
+     * fairness rule may restrict the choice to normal tickets.
+     *
+     * @throws InactiveQueueException When the queue is inactive in the database.
+     * @throws NoWaitingTicketsException When no ticket is eligible for the mode.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read the queue state under a row lock: the passed model may be stale,
+            // and the lock serializes calls with issuance and deactivation.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $restrictToNormal = $mode === CallMode::Any
+                && $this->mustProtectNormalTickets($lockedQueue->id);
+
+            $candidates = $this->candidatesQuery($lockedQueue->id, $mode, $restrictToNormal)
+                ->orderByDesc('priority')
+                ->orderBy('issued_at')
+                ->orderBy('id')
+                ->get();
+
+            foreach ($candidates as $candidate) {
+                // Re-check under lock: Ticket::call() does not lock the queue, so the
+                // candidate may have been called after the initial read.
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->where('status', TicketStatus::Waiting->value)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null) {
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+
+            throw new NoWaitingTicketsException('No waiting ticket is eligible for the requested call mode.');
+        });
+    }
+
+    /**
+     * Whether the last three calls of the queue were all priority calls while
+     * at least one normal ticket is still waiting.
+     */
+    private function mustProtectNormalTickets(int $queueId): bool
+    {
+        /** @var Collection<int, Ticket> $recentCalls */
+        $recentCalls = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called->value)
+            ->whereNotNull('called_at')
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->get(['id', 'priority', 'called_at']);
+
+        if ($recentCalls->count() < 3) {
+            return false;
+        }
+
+        if ($recentCalls->contains(fn (Ticket $ticket): bool => $ticket->priority < 1)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting->value)
+            ->where('priority', 0)
+            ->exists();
+    }
+
+    /**
+     * @return Builder<Ticket>
+     */
+    private function candidatesQuery(int $queueId, CallMode $mode, bool $restrictToNormal): Builder
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting->value);
+
+        if ($restrictToNormal || $mode === CallMode::NormalOnly) {
+            $query->where('priority', 0);
+        } elseif ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0);
+        }
+
+        return $query;
+    }
+}
