+        ->and($next->is($normal))->toBeTrue();
+});
+
+it('counts normal_only calls in the fairness history so a normal call resets the streak', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    callNextTicketCalled($queue, $attendant, 10, now()->subMinutes(2));
+    callNextTicketCalled($queue, $attendant, 10, now()->subMinute());
+
+    $priority = callNextTicketWaiting($queue, ['priority' => 10, 'issued_at' => now()->subHour()]);
+    $oldestNormal = callNextTicketWaiting($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(30)]);
+    callNextTicketWaiting($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(5)]);
+
+    $normalCall = (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly);
+    $next = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($normalCall->is($oldestNormal))->toBeTrue()
+        ->and($next->is($priority))->toBeTrue();
+});
+
+it('rejects calling from an inactive queue without changing tickets', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $attendant = User::factory()->create();
+    $ticket = callNextTicketWaiting($queue);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, CallMode::Any))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('reads the queue state from the database instead of the passed instance', function () {
