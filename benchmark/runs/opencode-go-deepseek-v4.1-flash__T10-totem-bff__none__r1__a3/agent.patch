new file mode 100644
index 0000000..999d7fb
--- /dev/null
+++ b/app/Enums/TicketPriority.php
@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned priority levels for ticket issuance and the totem API.
+ *
+ * Higher values are served first. Labels and visuals are presentation data,
+ * but the values and the allowed set are business rules.
+ */
+enum TicketPriority: int
+{
+    case Normal = 0;
+    case Priority = 10;
+    case Priority80 = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Priority => 'Prioritário',
+            self::Priority80 => 'Prioridade 80+',
+        };
+    }
+
+    /**
+     * @return array{color: string, icon: string, order: int}
+     */
+    public function visual(): array
+    {
+        return match ($this) {
+            self::Normal => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            self::Priority => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            self::Priority80 => ['color' => '#6A1B9A', 'icon' => 'elderly', 'order' => 3],
+        };
+    }
+
+    /**
+     * Contract payload for the priorities endpoint.
+     *
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function options(): array
+    {
+        return array_map(
+            fn (self $priority): array => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+                'visual' => $priority->visual(),
+            ],
+            self::cases(),
+        );
+    }
+
+    public static function fromRequest(mixed $value): ?self
+    {
+        if (is_int($value)) {
+            return self::tryFrom($value);
+        }
+
+        if (is_string($value) && preg_match('/^-?\d+$/D', $value) === 1) {
+            return self::tryFrom((int) $value);
+        }
+
+        return null;
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemAuthController.php b/app/Http/Controllers/Api/TotemAuthController.php
new file mode 100644
index 0000000..69345c5
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemAuthController.php
@@ -0,0 +1,133 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    public function __construct(private readonly TotemJwt $jwt) {}
+
+    /**
+     * Exchange a preset pairing code for a totem JWT.
+     */
+    public function login(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (is_int($code)) {
+            $code = (string) $code;
+        }
+
+        if (! is_string($code) || preg_match('/^\d{6}$/D', $code) !== 1) {
+            $this->auditFailure($request, 'invalid_code_format');
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $result = DB::transaction(function () use ($code, $request): ?array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null) {
+                $this->auditFailure($request, 'unknown_code');
+
+                return null;
+            }
+
+            if ($preset->login_code_expires_at === null || ! $preset->login_code_expires_at->isFuture()) {
+                $this->auditFailure($request, 'expired_code', $preset);
+
+                return null;
+            }
+
+            if ($preset->login_code_consumed_at !== null) {
+                $this->auditFailure($request, 'consumed_code', $preset);
+
+                return null;
+            }
+
+            if (! $preset->is_active) {
+                $this->auditFailure($request, 'inactive_preset', $preset);
+
+                return null;
+            }
+
+            $entity = $preset->entity;
+
+            if ($entity === null) {
+                $this->auditFailure($request, 'missing_entity', $preset);
+
+                return null;
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()
+                ->pluck('queues.id')
+                ->map(fn (mixed $id): int => (int) $id)
+                ->all();
+
+            $token = $this->jwt->issue([
+                'totem_id' => $totem->id,
+                'entity_id' => $preset->entity_id,
+                'preset_id' => $preset->id,
+                'queues' => $queueIds,
+            ]);
+
+            $this->auditSuccess($request, $totem, $preset);
+
+            return [
+                'token' => $token,
+                'token_type' => 'Bearer',
+                'expires_in' => $this->jwt->ttl(),
+                'entity' => [
+                    'slug' => $entity->slug,
+                    'name' => $entity->name,
+                ],
+            ];
+        });
+
+        if ($result === null) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        return response()->json($result, 200);
+    }
+
+    private function auditSuccess(Request $request, Totem $totem, TotemPreset $preset): void
+    {
+        Log::channel('audit')?->info('totem.pairing.succeeded', [
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'ip' => $request->ip(),
+        ]);
+    }
+
+    private function auditFailure(Request $request, string $reason, ?TotemPreset $preset = null): void
+    {
+        Log::channel('audit')?->warning('totem.pairing.failed', [
+            'reason' => $reason,
+            'entity_id' => $preset?->entity_id,
+            'preset_id' => $preset?->id,
+            'ip' => $request->ip(),
+        ]);
+    }
+}
