+<?php
+
+namespace App\Support;
+
+use App\Models\Queue;
+
+/**
+ * Presentation helpers for the totem API. Visual data is always resolved by
+ * the backend, with optional per-preset overrides in totem_presets.appearance.
+ */
+final class TotemPresentation
+{
+    /** @var list<string> */
+    private const QUEUE_COLORS = [
+        '#0055FF',
+        '#00897B',
+        '#EF6C00',
+        '#6A1B9A',
+        '#455A64',
+        '#AD1457',
+    ];
+
+    /**
+     * @param  array<string, mixed>  $appearance
+     * @return array{slug: string, label: string, description: string, visual: array{color: string, icon: string, order: int}, is_active: true}
+     */
+    public static function queue(Queue $queue, int $order, array $appearance = []): array
+    {
+        $override = $appearance['queues'][$queue->slug] ?? [];
+        $override = is_array($override) ? $override : [];
+        $visual = is_array($override['visual'] ?? null) ? $override['visual'] : [];
+
+        return [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => is_string($override['description'] ?? null) ? $override['description'] : '',
+            'visual' => [
+                'color' => is_string($visual['color'] ?? null)
+                    ? $visual['color']
+                    : self::QUEUE_COLORS[($order - 1) % count(self::QUEUE_COLORS)],
+                'icon' => is_string($visual['icon'] ?? null) ? $visual['icon'] : 'ticket',
+                'order' => $order,
+            ],
+            'is_active' => true,
+        ];
+    }
+}
