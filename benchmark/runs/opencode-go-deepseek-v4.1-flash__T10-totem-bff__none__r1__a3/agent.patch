@@ -0,0 +1,165 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use App\Support\TotemPresentation;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController extends Controller
+{
+    public function queues(Request $request, string $entity): JsonResponse
+    {
+        [$tokenEntity, $preset, $queueIds] = $this->context($request);
+
+        if ($tokenEntity->slug !== $entity) {
+            return $this->forbidden();
+        }
+
+        $appearance = is_array($preset->appearance) ? $preset->appearance : [];
+
+        $queues = Queue::query()
+            ->where('entity_id', $tokenEntity->id)
+            ->whereIn('id', $queueIds)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->values()
+            ->map(fn (Queue $queue, int $index): array => TotemPresentation::queue($queue, $index + 1, $appearance))
+            ->all();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $tokenEntity->slug,
+                'name' => $tokenEntity->name,
+            ],
+            'queues' => $queues,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        [$tokenEntity, , $queueIds] = $this->context($request);
+
+        if ($tokenEntity->slug !== $entity) {
+            return $this->forbidden();
+        }
+
+        $resolved = $this->resolveQueue($tokenEntity, $queue, $queueIds);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        if (! $resolved->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug],
+            'queue' => [
+                'slug' => $resolved->slug,
+                'label' => $resolved->name,
+            ],
+            'priorities' => TicketPriority::options(),
+        ]);
+    }
+
+    public function ticket(Request $request, string $entity, string $queue): JsonResponse
+    {
+        [$tokenEntity, , $queueIds] = $this->context($request);
+
+        if ($tokenEntity->slug !== $entity) {
+            return $this->forbidden();
+        }
+
+        $resolved = $this->resolveQueue($tokenEntity, $queue, $queueIds);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        if (! $resolved->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priority = TicketPriority::fromRequest($request->input('priority'));
+
+        if ($priority === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = (new IssueTicket)($resolved, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $resolved->slug,
+                'label' => $resolved->name,
+            ],
+            'priority' => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601ZuluString(),
+        ], 201);
+    }
+
+    /**
+     * @return array{0: Entity, 1: TotemPreset, 2: list<int>}
+     */
+    private function context(Request $request): array
+    {
+        /** @var Entity $entity */
+        $entity = $request->attributes->get('totem_entity');
+
+        /** @var TotemPreset $preset */
+        $preset = $request->attributes->get('totem_preset');
+
+        /** @var list<int> $queueIds */
+        $queueIds = $request->attributes->get('totem_queue_ids', []);
+
+        return [$entity, $preset, $queueIds];
+    }
+
+    /**
+     * Resolve a queue slug inside the token entity only. Another entity's
+     * queue is indistinguishable from a missing queue.
+     *
+     * @param  list<int>  $queueIds
+     */
+    private function resolveQueue(Entity $entity, string $slug, array $queueIds): Queue|JsonResponse
+    {
+        $queue = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $slug)
+            ->first();
+
+        if ($queue === null) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! in_array($queue->id, $queueIds, true)) {
+            return $this->forbidden();
+        }
+
+        return $queue;
+    }
+
+    private function forbidden(): JsonResponse
+    {
+        return response()->json(['code' => 'forbidden'], 403);
+    }
+}
