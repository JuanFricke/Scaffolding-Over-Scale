+it('rejects missing invalid expired and inconsistent tokens', function (string $kind) {
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->for($preset->entity)->create();
+    $jwt = app(TotemJwt::class);
+
+    $claims = [
+        'totem_id' => $totem->id,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+    ];
+
+    $token = match ($kind) {
+        'missing' => null,
+        'invalid' => 'not-a-token',
+        'expired' => (function () use ($jwt, $claims) {
+            config(['services.totem.jwt_ttl' => -3600]);
+
+            return $jwt->issue($claims);
+        })(),
+        'inactive_totem' => (function () use ($totem, $jwt, $claims) {
+            $totem->update(['is_active' => false]);
+
+            return $jwt->issue($claims);
+        })(),
+        'inactive_preset' => (function () use ($preset, $jwt, $claims) {
+            $preset->update(['is_active' => false]);
+
+            return $jwt->issue($claims);
+        })(),
+        'entity_mismatch' => $jwt->issue(array_merge($claims, [
+            'entity_id' => Entity::factory()->create()->id,
+        ])),
+    };
+
+    $headers = $token === null ? [] : ['Authorization' => "Bearer {$token}"];
+
+    $this->getJson("/api/{$preset->entity->slug}/queues", $headers)
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+})->with(['missing', 'invalid', 'expired', 'inactive_totem', 'inactive_preset', 'entity_mismatch']);
+
