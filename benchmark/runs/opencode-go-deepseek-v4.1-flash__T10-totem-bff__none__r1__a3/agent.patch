+it('rejects unknown, expired, consumed and inactive presets identically', function (string $state) {
+    $preset = TotemPreset::factory()->create();
+
+    if ($state === 'expired') {
+        $preset->update(['login_code_expires_at' => now()->subMinute()]);
+    }
+
+    if ($state === 'consumed') {
+        $preset->update(['login_code_consumed_at' => now()]);
+    }
+
+    if ($state === 'inactive') {
+        $preset->update(['is_active' => false]);
+    }
+
+    $code = $state === 'unknown' ? '999999' : $preset->login_code;
+
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with(['unknown', 'expired', 'consumed', 'inactive']);
