new file mode 100644
index 0000000..652e65b
--- /dev/null
+++ b/app/Support/TotemJwt.php
@@ -0,0 +1,127 @@
+<?php
+
+namespace App\Support;
+
+use Illuminate\Support\Str;
+use RuntimeException;
+
+/**
+ * Minimal, dependency-free HS256 JWT implementation for the totem API.
+ */
+final class TotemJwt
+{
+    /**
+     * Issue a short-lived token. iat/exp/jti are always set by the issuer.
+     *
+     * @param  array<string, mixed>  $claims
+     */
+    public function issue(array $claims): string
+    {
+        $now = time();
+        $ttl = $this->ttl();
+
+        return $this->encode(array_merge($claims, [
+            'iat' => $now,
+            'exp' => $now + $ttl,
+            'jti' => (string) Str::uuid(),
+        ]));
+    }
+
+    public function ttl(): int
+    {
+        return max(0, (int) config('services.totem.jwt_ttl', 3600));
+    }
+
+    /**
+     * Validate signature/expiry and return the claims.
+     *
+     * @return array<string, mixed>
+     */
+    public function decode(string $token): array
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            throw new RuntimeException('Malformed token.');
+        }
+
+        [$encodedHeader, $encodedPayload, $encodedSignature] = $parts;
+
+        $header = json_decode($this->base64UrlDecode($encodedHeader), true);
+
+        if (! is_array($header) || ($header['alg'] ?? null) !== 'HS256') {
+            throw new RuntimeException('Unsupported token algorithm.');
+        }
+
+        $expected = $this->sign($encodedHeader.'.'.$encodedPayload);
+
+        if (! hash_equals($expected, $encodedSignature)) {
+            throw new RuntimeException('Invalid token signature.');
+        }
+
+        $payload = json_decode($this->base64UrlDecode($encodedPayload), true);
+
+        if (! is_array($payload)) {
+            throw new RuntimeException('Malformed token payload.');
+        }
+
+        if (! isset($payload['exp']) || ! is_numeric($payload['exp']) || (int) $payload['exp'] <= time()) {
+            throw new RuntimeException('Token expired.');
+        }
+
+        if (! isset($payload['iat']) || ! is_numeric($payload['iat'])) {
+            throw new RuntimeException('Token missing issued-at claim.');
+        }
+
+        return $payload;
+    }
+
+    /**
+     * @param  array<string, mixed>  $payload
+     */
+    private function encode(array $payload): string
+    {
+        $header = $this->base64UrlEncode(json_encode([
+            'typ' => 'JWT',
+            'alg' => 'HS256',
+        ], JSON_THROW_ON_ERROR));
+
+        $body = $this->base64UrlEncode(json_encode($payload, JSON_THROW_ON_ERROR));
+        $signature = $this->sign($header.'.'.$body);
+
+        return $header.'.'.$body.'.'.$signature;
+    }
+
+    private function sign(string $value): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if ($secret === '') {
+            throw new RuntimeException('Totem JWT secret is not configured.');
+        }
+
+        return $this->base64UrlEncode(hash_hmac('sha256', $value, $secret, true));
+    }
+
+    private function base64UrlEncode(string $value): string
+    {
+        return rtrim(strtr(base64_encode($value), '+/', '-_'), '=');
+    }
+
+    private function base64UrlDecode(string $value): string
+    {
+        $remainder = strlen($value) % 4;
+
+        if ($remainder !== 0) {
+            $value .= str_repeat('=', 4 - $remainder);
+        }
+
+        $decoded = base64_decode(strtr($value, '-_', '+/'), true);
+
+        if ($decoded === false) {
+            throw new RuntimeException('Malformed token encoding.');
+        }
+
+        return $decoded;
+    }
+}
