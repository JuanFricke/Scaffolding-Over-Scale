+<?php
+
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function totemFeatureTokenForPreset(TotemPreset $preset, array $queueIds = []): string
+{
+    $totem = Totem::factory()->for($preset->entity)->create();
+
+    return app(TotemJwt::class)->issue([
+        'totem_id' => $totem->id,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => $queueIds,
+    ]);
+}
+
+it('rejects malformed pairing codes', function (mixed $code) {
+
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+})->with([
+    'empty' => '',
+    'short' => '12345',
+    'long' => '1234567',
+    'letters' => '12a456',
+    'missing' => null,
+]);
+
+it('pairs a preset and returns the token plus entity', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $preset->entity->slug)
+        ->assertJsonPath('entity.name', $preset->entity->name);
+
+    $claims = app(TotemJwt::class)->decode($response->json('token'));
+
+    expect($claims)
+        ->toHaveKeys(['totem_id', 'entity_id', 'preset_id', 'queues', 'iat', 'exp', 'jti'])
+        ->entity_id->toBe($preset->entity_id)
