@@ -0,0 +1,64 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * CORS for the totem web build and any allowed local development origin.
+ *
+ * Only localhost/127.0.0.1 on any port and the optional TOTEM_WEB_ORIGIN are
+ * allowed. Disallowed origins receive no Access-Control-Allow-Origin header.
+ * Credentials are never enabled.
+ */
+class TotemCors
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        if (! $request->is('api/*')) {
+            return $next($request);
+        }
+
+        $response = $request->getMethod() === 'OPTIONS'
+            ? response('', 204)
+            : $next($request);
+
+        return self::apply($request, $response);
+    }
+
+    /**
+     * Add the strict totem CORS headers to a response (used for both normal
+     * responses and rendered exceptions such as throttling).
+     */
+    public static function apply(Request $request, Response $response): Response
+    {
+        $origin = $request->headers->get('Origin');
+        $allowedOrigin = is_string($origin) && self::isAllowedOrigin($origin) ? $origin : null;
+
+        if ($allowedOrigin !== null) {
+            $response->headers->set('Access-Control-Allow-Origin', $allowedOrigin);
+            $response->headers->set('Access-Control-Allow-Methods', 'GET, POST, OPTIONS');
+            $response->headers->set('Access-Control-Allow-Headers', 'Authorization, Content-Type, Accept');
+            $response->headers->set('Access-Control-Max-Age', '86400');
+        }
+
+        if ($origin !== null) {
+            $response->headers->set('Vary', 'Origin', false);
+        }
+
+        return $response;
+    }
+
+    private static function isAllowedOrigin(string $origin): bool
+    {
+        if (preg_match('#^https?://(localhost|127\.0\.0\.1)(:\d+)?$#i', $origin) === 1) {
+            return true;
+        }
+
+        $configured = (string) config('services.totem.web_origin', '');
+
+        return $configured !== '' && strcasecmp(rtrim($configured, '/'), rtrim($origin, '/')) === 0;
+    }
+}
