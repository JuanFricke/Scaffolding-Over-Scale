@@ -0,0 +1,53 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+class PairingCodeCommand extends Command
+{
+    protected $signature = 'totem:pairing-code {preset}';
+
+    protected $description = 'Open a 10-minute pairing window for a totem preset';
+
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+        $preset = TotemPreset::query()->find($presetId);
+
+        if ($preset === null) {
+            $this->error("Unknown totem preset: {$presetId}");
+
+            return self::FAILURE;
+        }
+
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while (TotemPreset::query()
+            ->where('login_code', $code)
+            ->whereKeyNot($preset->id)
+            ->exists());
+
+        $expiresAt = now()->addMinutes(10);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => $expiresAt,
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        Log::channel('audit')?->info('totem.pairing_code.generated', [
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'expires_at' => $expiresAt->toIso8601String(),
+        ]);
+
+        $this->info("Pairing code: {$code}");
+        $this->line("Preset: {$preset->name} ({$preset->id})");
+        $this->line("Expires at {$expiresAt->toIso8601String()}.");
+
+        return self::SUCCESS;
+    }
+}
