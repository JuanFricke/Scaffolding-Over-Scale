--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,104 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Throwable;
+
+/**
+ * Authenticates totem API calls and resolves the effective queue scope.
+ *
+ * The queue scope is the intersection of the token's queues claim and the
+ * preset's current join, so removing a queue from a preset takes effect
+ * immediately for tokens that are still valid.
+ */
+class AuthenticateTotem
+{
+    public function __construct(private readonly TotemJwt $jwt) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            return $this->invalidToken();
+        }
+
+        try {
+            $claims = $this->jwt->decode($token);
+        } catch (Throwable) {
+            return $this->invalidToken();
+        }
+
+        $totemId = $this->integerClaim($claims['totem_id'] ?? null);
+        $entityId = $this->integerClaim($claims['entity_id'] ?? null);
+        $presetId = $this->integerClaim($claims['preset_id'] ?? null);
+        $claimedQueues = $claims['queues'] ?? null;
+
+        if ($totemId === null || $entityId === null || $presetId === null
+            || ! is_array($claimedQueues) || ! isset($claims['jti'])) {
+            return $this->invalidToken();
+        }
+
+        $totem = Totem::query()->find($totemId);
+        $preset = TotemPreset::query()->find($presetId);
+        $entity = Entity::query()->find($entityId);
+
+        if ($totem === null || $preset === null || $entity === null) {
+            return $this->invalidToken();
+        }
+
+        // The token, device, and preset must all agree on the entity.
+        if ((int) $totem->entity_id !== $entityId
+            || (int) $preset->entity_id !== $entityId
+            || ! $totem->is_active
+            || ! $preset->is_active) {
+            return $this->invalidToken();
+        }
+
+        $claimedQueueIds = array_values(array_unique(array_filter(
+            array_map(fn (mixed $id): ?int => $this->integerClaim($id), $claimedQueues),
+            fn (?int $id): bool => $id !== null,
+        )));
+
+        $presetQueueIds = $preset->queues()
+            ->pluck('queues.id')
+            ->map(fn (mixed $id): int => (int) $id)
+            ->all();
+
+        $effectiveQueueIds = array_values(array_intersect($claimedQueueIds, $presetQueueIds));
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_queue_ids', $effectiveQueueIds);
+
+        return $next($request);
+    }
+
+    private function invalidToken(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+
+    private function integerClaim(mixed $value): ?int
+    {
+        if (is_int($value)) {
+            return $value;
+        }
+
+        if (is_string($value) && preg_match('/^\d+$/D', $value) === 1) {
+            return (int) $value;
+        }
+
+        return null;
+    }
+}
