+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityInvite;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Refuse an invite addressed to the actor by deleting it (invitee only).
+ */
+class DeclineInvite
+{
+    public function handle(User $actor, EntityInvite $invite): void
+    {
+        Gate::forUser($actor)->authorize('decline', $invite);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $actor->id,
+            'invite_id' => $invite->id,
+        ]);
+    }
+}
