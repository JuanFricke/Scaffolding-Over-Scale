diff --git a/app/Models/EntityInvite.php b/app/Models/EntityInvite.php
new file mode 100644
index 0000000..f3ab16d
--- /dev/null
+++ b/app/Models/EntityInvite.php
@@ -0,0 +1,85 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Eloquent\Casts\Attribute;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Str;
+
+/**
+ * An e-mail address invited to join an entity. Membership exists only after acceptance.
+ */
+#[Fillable(['entity_id', 'invited_by', 'email', 'role', 'expires_at', 'accepted_at'])]
+class EntityInvite extends Model
+{
+    use HasFactory;
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, mixed>
+     */
+    protected function casts(): array
+    {
+        return [
+            'role' => UserRole::class,
+            'expires_at' => 'datetime',
+            'accepted_at' => 'datetime',
+        ];
+    }
+
+    /**
+     * Store e-mails lowercase and trimmed, whichever path writes them.
+     */
+    protected function email(): Attribute
+    {
+        return Attribute::make(
+            set: fn (string $value) => Str::lower(trim($value)),
+        );
+    }
+
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Invites that are neither accepted nor expired.
+     */
+    public function scopePending(Builder $query): void
+    {
+        $query->whereNull('accepted_at')->where('expires_at', '>', now());
+    }
+
+    /**
+     * Accepted or expired invites; these may be replaced by a new invite.
+     */
+    public function scopeNotPending(Builder $query): void
+    {
+        $query->where(fn (Builder $query) => $query
+            ->whereNotNull('accepted_at')
+            ->orWhere('expires_at', '<=', now()));
+    }
+
+    /**
+     * Match an e-mail address case-insensitively.
+     */
+    public function scopeForEmail(Builder $query, string $email): void
+    {
+        $query->where('email', Str::lower(trim($email)));
+    }
+
+    public function isExpired(): bool
+    {
+        return $this->expires_at->isPast();
+    }
+
+    public function isPending(): bool
+    {
+        return $this->accepted_at === null && ! $this->isExpired();
+    }
+}
