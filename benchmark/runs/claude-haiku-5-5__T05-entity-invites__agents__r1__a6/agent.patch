@@ -0,0 +1,72 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\AcceptInvite;
+use App\Actions\DeclineInvite;
+use App\Models\EntityInvite;
+use Illuminate\Contracts\View\View;
+use Livewire\Component;
+
+/**
+ * The signed-in user's pending invites, with accept / decline.
+ */
+class PendingInvites extends Component
+{
+    /**
+     * Join the entity of an invite addressed to the signed-in user.
+     */
+    public function accept(int $inviteId): void
+    {
+        $invite = $this->findInvite($inviteId);
+
+        $this->authorize('accept', $invite);
+
+        // Already accepted: nothing left to do, and nothing to report.
+        if ($invite->accepted_at) {
+            return;
+        }
+
+        $membership = app(AcceptInvite::class)->handle(auth()->user(), $invite);
+
+        session(['current_entity_id' => $membership->entity_id]);
+
+        $this->redirect(route('entity.dashboard', $invite->entity->slug));
+    }
+
+    /**
+     * Refuse an invite addressed to the signed-in user.
+     */
+    public function decline(int $inviteId): void
+    {
+        $invite = $this->findInvite($inviteId);
+
+        $this->authorize('decline', $invite);
+
+        app(DeclineInvite::class)->handle(auth()->user(), $invite);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.pending-invites', [
+            'invites' => EntityInvite::query()
+                ->with('entity')
+                ->whereHas('entity')
+                ->forEmail(auth()->user()->email)
+                ->pending()
+                ->latest('id')
+                ->get(),
+        ]);
+    }
+
+    /**
+     * Resolve an invite by id; invites of deleted entities are treated as gone.
+     */
+    protected function findInvite(int $inviteId): EntityInvite
+    {
+        return EntityInvite::query()
+            ->with('entity')
+            ->whereHas('entity')
+            ->findOrFail($inviteId);
+    }
+}
