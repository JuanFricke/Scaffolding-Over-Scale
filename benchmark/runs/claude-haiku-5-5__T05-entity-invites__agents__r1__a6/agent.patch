+<?php
+
+use App\Livewire\Entity\PendingInvites;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('lists only the signed-in user pending invites, matching e-mail case-insensitively', function () {
+    $user = User::factory()->create(['email' => 'Ana@Example.com']);
+    $mine = Entity::factory()->create(['name' => 'Acme Corp']);
+    $expiredEntity = Entity::factory()->create(['name' => 'Old Co']);
+    $otherEntity = Entity::factory()->create(['name' => 'Stranger Ltd']);
+
+    EntityInvite::factory()->for($mine)->create(['email' => 'ana@example.com']);
+    EntityInvite::factory()->for($expiredEntity)->expired()->create(['email' => 'ana@example.com']);
+    EntityInvite::factory()->for($otherEntity)->create(['email' => 'bob@example.com']);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->assertSee('Acme Corp')
+        ->assertDontSee('Old Co')
+        ->assertDontSee('Stranger Ltd');
+});
+
+test('renders the invites title and a separating rule only when there are invites', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->assertDontSeeHtml('<hr')
+        ->assertDontSee(__('ui.invites_title'));
+
+    EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->assertSeeHtml('<hr')
+        ->assertSee(__('ui.invites_title'))
+        ->assertSee(__('Accept'))
+        ->assertSee(__('Decline'));
+});
+
+test('accept creates the membership, sets the tenant session and redirects to the dashboard', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com', 'role' => UserRole::Admin]);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', 'acme'));
+
+    expect(EntityMembership::where('entity_id', $entity->id)->where('user_id', $user->id)->first()->role)
+        ->toBe(UserRole::Admin)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull()
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('accepting an expired invite reports an error and creates nothing', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->expired()->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasErrors(['invite'])
+        ->assertNoRedirect();
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+test('accepting an already accepted invite is a silent no-op', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create([
+        'email' => 'ana@example.com',
+        'accepted_at' => now()->subHour(),
+    ]);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('tamper: a user cannot accept or decline someone else invite', function () {
+    $ana = User::factory()->create(['email' => 'ana@example.com']);
+    $bob = User::factory()->create(['email' => 'bob@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($bob)
+        ->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertForbidden();
+
+    Livewire::actingAs($bob)
