@@ -0,0 +1,54 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Turn an invite into a membership with the invite's role (invitee only).
+ */
+class AcceptInvite
+{
+    /**
+     * @throws AuthorizationException when the actor is not the invitee
+     * @throws ValidationException when the invite has expired
+     */
+    public function handle(User $actor, EntityInvite $invite): EntityMembership
+    {
+        Gate::forUser($actor)->authorize('accept', $invite);
+
+        return DB::transaction(function () use ($actor, $invite) {
+            // Lock the row so two accepts racing each other cannot both create the membership.
+            $locked = EntityInvite::query()->whereKey($invite->id)->lockForUpdate()->firstOrFail();
+
+            if ($locked->accepted_at === null && $locked->isExpired()) {
+                throw ValidationException::withMessages(['invite' => __('ui.invite_expired')]);
+            }
+
+            // Never a duplicate: an existing membership keeps the role it already has.
+            $membership = EntityMembership::firstOrCreate(
+                ['entity_id' => $locked->entity_id, 'user_id' => $actor->id],
+                ['role' => $locked->role],
+            );
+
+            if ($locked->accepted_at === null) {
+                $locked->update(['accepted_at' => now()]);
+
+                Log::channel('audit')->info('Invite accepted', [
+                    'entity_id' => $locked->entity_id,
+                    'actor_id' => $actor->id,
+                    'invite_id' => $locked->id,
+                ]);
+            }
+
+            return $membership;
+        });
+    }
+}
