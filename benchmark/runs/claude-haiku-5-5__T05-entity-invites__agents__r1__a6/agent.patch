+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityInvite;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Withdraw a pending invite (managers of its entity only).
+ */
+class CancelInvite
+{
+    public function handle(User $actor, EntityInvite $invite): void
+    {
+        Gate::forUser($actor)->authorize('cancel', $invite);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite cancelled', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $actor->id,
+            'invite_id' => $invite->id,
+        ]);
+    }
+}
