--- /dev/null
+++ b/app/Actions/InviteMember.php
@@ -0,0 +1,83 @@
+<?php
+
+namespace App\Actions;
+
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Mail;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Invite an e-mail address to join an entity with a role (owner or admin only).
+ */
+class InviteMember
+{
+    /**
+     * Create the invite, queue its e-mail and write the audit trail.
+     *
+     * @throws AuthorizationException when the actor does not manage the entity
+     * @throws ValidationException when the role is not invitable or the address is already a member or invited
+     */
+    public function handle(User $actor, Entity $entity, string $email, UserRole $role): EntityInvite
+    {
+        Gate::forUser($actor)->authorize('update', $entity);
+
+        if (! in_array($role, UserRole::manageable(), true)) {
+            throw ValidationException::withMessages([
+                'inviteRole' => __('validation.in', ['attribute' => __('ui.role')]),
+            ]);
+        }
+
+        $email = Str::lower(trim($email));
+
+        if ($entity->memberships()->whereHas('user', fn ($query) => $query->whereRaw('LOWER(email) = ?', [$email]))->exists()) {
+            throw ValidationException::withMessages(['inviteEmail' => __('ui.invite_already_member')]);
+        }
+
+        if ($this->hasPendingInvite($entity, $email)) {
+            throw ValidationException::withMessages(['inviteEmail' => __('ui.invite_already_pending')]);
+        }
+
+        try {
+            $invite = DB::transaction(function () use ($actor, $entity, $email, $role) {
+                // Accepted or expired leftovers would collide with the unique (entity_id, email) index.
+                $entity->invites()->forEmail($email)->notPending()->delete();
+
+                return $entity->invites()->create([
+                    'invited_by' => $actor->id,
+                    'email' => $email,
+                    'role' => $role,
+                    'expires_at' => now()->addDays(7),
+                ]);
+            });
+        } catch (UniqueConstraintViolationException) {
+            // A concurrent request invited the same address between our check and insert.
+            throw ValidationException::withMessages(['inviteEmail' => __('ui.invite_already_pending')]);
+        }
+
+        Mail::to($invite->email)->queue(new EntityInviteMail($invite));
+
+        Log::channel('audit')->info('Member invited', [
+            'entity_id' => $entity->id,
+            'actor_id' => $actor->id,
+            'invite_id' => $invite->id,
+            'role' => $role->value,
+        ]);
+
+        return $invite;
+    }
+
+    protected function hasPendingInvite(Entity $entity, string $email): bool
+    {
+        return $entity->invites()->forEmail($email)->pending()->exists();
+    }
+}
