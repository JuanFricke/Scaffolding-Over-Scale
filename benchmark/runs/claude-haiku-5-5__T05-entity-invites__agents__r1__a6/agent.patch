+
+    expect(EntityMembership::count())->toBe(0)
+        ->and(EntityInvite::whereKey($invite->id)->whereNull('accepted_at')->exists())->toBeTrue();
+});
+
+test('decline deletes the invite for the invitee', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->call('decline', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::whereKey($invite->id)->exists())->toBeFalse();
+});
+
+test('an unknown invite id is not found', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->call('accept', 999999)
+        ->assertNotFound();
+});
