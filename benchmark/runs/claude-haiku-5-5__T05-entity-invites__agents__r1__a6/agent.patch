new file mode 100644
index 0000000..84f6db8
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteMailTest.php
@@ -0,0 +1,58 @@
+<?php
+
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('invite mail is a queued markdown mailable', function () {
+    $invite = EntityInvite::factory()->create();
+    $mail = new EntityInviteMail($invite);
+
+    expect($mail)->toBeInstanceOf(ShouldQueue::class)
+        ->and($mail->content()->markdown)->toBe('emails.entity-invite');
+});
+
+test('invite mail is written in Brazilian Portuguese with the invite details', function () {
+    app()->setLocale('pt_BR');
+
+    $entity = Entity::factory()->create(['name' => 'Acme Corp']);
+    $invite = EntityInvite::factory()->for($entity)->create([
+        'email' => 'ana@example.com',
+        'role' => UserRole::Admin,
+    ]);
+
+    $mail = new EntityInviteMail($invite);
+    $html = (string) $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('Você foi convidado(a) para Acme Corp')
+        ->and($html)->toContain('Olá!')
+        ->and($html)->toContain('Você foi convidado(a) para Acme Corp como Administrador.')
+        ->and($html)->toContain('Acesse o link abaixo para entrar e aceitar seu convite:')
+        ->and($html)->toContain('Entrar no PegaFila')
+        ->and($html)->toContain(route('login'))
+        ->and($html)->toContain('Este convite expira em '.$invite->expires_at->locale('pt_BR')->isoFormat('LL'))
+        ->and($html)->toContain('Time PegaFila')
+        ->and($html)->toContain('#0f7490');
+});
+
+test('invite mail falls back to English strings', function () {
+    app()->setLocale('en');
+
+    $entity = Entity::factory()->create(['name' => 'Acme Corp']);
+    $invite = EntityInvite::factory()->for($entity)->create(['role' => UserRole::Employee]);
+
+    $mail = new EntityInviteMail($invite);
+    $html = (string) $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('You are invited to Acme Corp')
+        ->and($html)->toContain('You are invited to Acme Corp as Employee.')
+        ->and($html)->toContain('Sign in to PegaFila')
+        ->and($html)->toContain('Team PegaFila');
+
+    app()->setLocale('pt_BR');
+});
diff --git a/tests/Feature/Entity/EntityInviteModelTest.php b/tests/Feature/Entity/EntityInviteModelTest.php
new file mode 100644
index 0000000..96834c4
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteModelTest.php
@@ -0,0 +1,73 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('factory defaults to a pending employee invite expiring in 7 days', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->entity)->toBeInstanceOf(Entity::class)
+        ->and($invite->role)->toBe(UserRole::Employee)
+        ->and($invite->isPending())->toBeTrue()
+        ->and($invite->expires_at->between(now()->addDays(7)->subMinute(), now()->addDays(7)->addMinute()))->toBeTrue();
+});
+
+test('expired factory state creates an invite that is no longer pending', function () {
+    $invite = EntityInvite::factory()->expired()->create();
+
+    expect($invite->isExpired())->toBeTrue()
+        ->and($invite->isPending())->toBeFalse();
+});
+
+test('e-mails are stored lowercase and trimmed whatever the write path', function () {
+    $created = EntityInvite::factory()->create(['email' => '  Ana.Silva@Example.COM ']);
+
+    $fresh = EntityInvite::find($created->id);
+    expect($fresh->email)->toBe('ana.silva@example.com');
+
+    $fresh->update(['email' => ' BOB@Example.com ']);
+    expect($fresh->fresh()->email)->toBe('bob@example.com');
+});
+
+test('accepted invites are not pending', function () {
+    $invite = EntityInvite::factory()->create(['accepted_at' => now()]);
+
+    expect($invite->isPending())->toBeFalse();
+});
+
+test('pending scope excludes accepted and expired invites', function () {
+    $entity = Entity::factory()->create();
+    $pending = EntityInvite::factory()->for($entity)->create(['email' => 'a@example.com']);
+    EntityInvite::factory()->for($entity)->expired()->create(['email' => 'b@example.com']);
+    EntityInvite::factory()->for($entity)->create(['email' => 'c@example.com', 'accepted_at' => now()]);
+
+    expect(EntityInvite::pending()->pluck('id')->all())->toBe([$pending->id]);
+});
+
+test('notPending scope is the complement of pending', function () {
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'a@example.com']);
+    $expired = EntityInvite::factory()->for($entity)->expired()->create(['email' => 'b@example.com']);
+    $accepted = EntityInvite::factory()->for($entity)->create(['email' => 'c@example.com', 'accepted_at' => now()]);
+
+    expect(EntityInvite::notPending()->pluck('id')->sort()->values()->all())
+        ->toBe(collect([$expired->id, $accepted->id])->sort()->values()->all());
+});
+
+test('forEmail matches case-insensitively and ignores surrounding spaces', function () {
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+    EntityInvite::factory()->create(['email' => 'other@example.com']);
+
+    expect(EntityInvite::forEmail(' ANA@Example.com ')->pluck('id')->all())->toBe([$invite->id]);
+});
+
+test('entity exposes its invites', function () {
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create();
+
+    expect($entity->invites()->get()->first()->is($invite))->toBeTrue();
+});
diff --git a/tests/Feature/Entity/EntityInviteSchemaTest.php b/tests/Feature/Entity/EntityInviteSchemaTest.php
new file mode 100644
index 0000000..3161b5c
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteSchemaTest.php
@@ -0,0 +1,47 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity_invites table has the required columns and a unique (entity_id, email) index', function () {
+    expect(Schema::hasTable('entity_invites'))->toBeTrue()
+        ->and(Schema::hasColumns('entity_invites', [
+            'id', 'entity_id', 'invited_by', 'email', 'role', 'expires_at', 'accepted_at', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('entity_invites', 'entity_invites_entity_id_email_unique', 'unique'))->toBeTrue();
+});
+
+test('role defaults to employee and invited_by may be null', function () {
+    $invite = DB::table('entity_invites')->insertGetId([
+        'entity_id' => Entity::factory()->create()->id,
+        'email' => 'ana@example.com',
+        'expires_at' => now()->addDays(7),
+    ]);
+
+    $row = DB::table('entity_invites')->where('id', $invite)->first();
+
+    expect($row->role)->toBe('employee')
+        ->and($row->invited_by)->toBeNull()
+        ->and($row->accepted_at)->toBeNull();
+});
+
+test('deleting an entity cascades to its invites', function () {
+    $invite = EntityInvite::factory()->create();
+
+    $invite->entity->forceDelete();
+
+    expect(EntityInvite::count())->toBe(0);
+});
+
+test('the same e-mail cannot be invited twice to the same entity', function () {
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    expect(fn () => EntityInvite::factory()->for($invite->entity)->create(['email' => 'ana@example.com']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
diff --git a/tests/Feature/Entity/InviteActionsTest.php b/tests/Feature/Entity/InviteActionsTest.php
new file mode 100644
index 0000000..2ee44af
--- /dev/null
+++ b/tests/Feature/Entity/InviteActionsTest.php
@@ -0,0 +1,208 @@
+<?php
+
+use App\Actions\AcceptInvite;
+use App\Actions\CancelInvite;
+use App\Actions\DeclineInvite;
+use App\Actions\InviteMember;
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Mail;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+/* ---------- InviteMember ---------- */
+
+test('InviteMember stores a 7-day invite with the inviter and queues the e-mail', function () {
+    Mail::fake();
+    $entity = Entity::factory()->create();
+    $manager = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($manager)->admin()->create();
+
+    $invite = app(InviteMember::class)->handle($manager, $entity, 'Ana@Example.com', UserRole::Admin);
+
+    expect($invite->email)->toBe('ana@example.com')
+        ->and($invite->role)->toBe(UserRole::Admin)
+        ->and($invite->invited_by)->toBe($manager->id)
+        ->and($invite->entity_id)->toBe($entity->id)
+        ->and($invite->expires_at->between(now()->addDays(7)->subMinute(), now()->addDays(7)->addMinute()))->toBeTrue();
+
+    Mail::assertQueued(EntityInviteMail::class, fn (EntityInviteMail $mail) => $mail->hasTo('ana@example.com')
+        && $mail->invite->is($invite));
+});
+
+test('InviteMember refuses an e-mail that already belongs to a member, case-insensitively', function () {
+    Mail::fake();
+    $entity = Entity::factory()->create();
+    $manager = User::factory()->create();
+    $member = User::factory()->create(['email' => 'Member@Example.com']);
+    EntityMembership::factory()->for($entity)->for($manager)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($member)->employee()->create();
+
+    expect(fn () => app(InviteMember::class)->handle($manager, $entity, 'member@example.com', UserRole::Employee))
+        ->toThrow(ValidationException::class);
+
+    expect(EntityInvite::count())->toBe(0);
+    Mail::assertNothingQueued();
+});
+
+test('InviteMember refuses an e-mail with a pending invite in the same entity', function () {
+    $entity = Entity::factory()->create();
+    $manager = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($manager)->owner()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']);
+
+    expect(fn () => app(InviteMember::class)->handle($manager, $entity, 'ana@example.com', UserRole::Employee))
+        ->toThrow(ValidationException::class);
+
+    expect(EntityInvite::count())->toBe(1);
+});
+
+test('InviteMember replaces an expired invite instead of colliding with it', function () {
+    Mail::fake();
+    $entity = Entity::factory()->create();
+    $manager = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($manager)->owner()->create();
+    EntityInvite::factory()->for($entity)->expired()->create(['email' => 'ana@example.com']);
+
+    $invite = app(InviteMember::class)->handle($manager, $entity, 'ana@example.com', UserRole::Employee);
+
+    expect(EntityInvite::count())->toBe(1)
+        ->and(EntityInvite::first()->id)->toBe($invite->id)
+        ->and($invite->isPending())->toBeTrue();
+});
+
+test('InviteMember replaces a leftover accepted invite once the user has left the entity', function () {
+    Mail::fake();
+    $entity = Entity::factory()->create();
+    $manager = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($manager)->owner()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com', 'accepted_at' => now()->subDay()]);
+
+    app(InviteMember::class)->handle($manager, $entity, 'ana@example.com', UserRole::Employee);
+
+    expect(EntityInvite::count())->toBe(1)
+        ->and(EntityInvite::first()->accepted_at)->toBeNull();
+});
+
+test('InviteMember turns a unique-constraint race into a validation error on the e-mail', function () {
+    Mail::fake();
+    $entity = Entity::factory()->create();
+    $manager = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($manager)->owner()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']);
+
+    // Simulate the race: another request inserted the invite after our pending check.
+    $racing = new class extends InviteMember
+    {
+        protected function hasPendingInvite(Entity $entity, string $email): bool
+        {
+            return false;
+        }
+    };
+
+    try {
+        $racing->handle($manager, $entity, 'ana@example.com', UserRole::Employee);
+        test()->fail('Expected a validation error.');
+    } catch (ValidationException $e) {
+        expect($e->errors())->toHaveKey('inviteEmail');
+    }
+
+    Mail::assertNothingQueued();
+});
+
+test('InviteMember is manager-only and never invites an owner', function () {
+    $entity = Entity::factory()->create();
+    $employee = User::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    expect(fn () => app(InviteMember::class)->handle($employee, $entity, 'x@example.com', UserRole::Employee))
+        ->toThrow(AuthorizationException::class);
+
+    expect(fn () => app(InviteMember::class)->handle($owner, $entity, 'x@example.com', UserRole::Owner))
+        ->toThrow(ValidationException::class);
+
+    expect(EntityInvite::count())->toBe(0);
+});
+
+/* ---------- CancelInvite ---------- */
+
+test('CancelInvite lets a manager delete a pending invite but not an employee', function () {
+    $entity = Entity::factory()->create();
+    $manager = User::factory()->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($manager)->admin()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $invite = EntityInvite::factory()->for($entity)->create();
+
+    expect(fn () => app(CancelInvite::class)->handle($employee, $invite))->toThrow(AuthorizationException::class);
+    expect(EntityInvite::count())->toBe(1);
+
+    app(CancelInvite::class)->handle($manager, $invite);
+
+    expect(EntityInvite::count())->toBe(0);
+});
+
+/* ---------- AcceptInvite ---------- */
+
+test('AcceptInvite creates the membership with the invite role and marks the invite accepted', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create(['email' => 'Ana@Example.com']);
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com', 'role' => UserRole::Admin]);
+
+    $membership = app(AcceptInvite::class)->handle($user, $invite);
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($membership->user_id)->toBe($user->id)
+        ->and($membership->entity_id)->toBe($entity->id)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull();
+});
+
+test('AcceptInvite never duplicates an existing membership and keeps its role', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    EntityMembership::factory()->for($entity)->for($user)->admin()->create();
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com', 'role' => UserRole::Employee]);
+
+    $membership = app(AcceptInvite::class)->handle($user, $invite);
+
+    expect(EntityMembership::where('entity_id', $entity->id)->where('user_id', $user->id)->count())->toBe(1)
+        ->and($membership->role)->toBe(UserRole::Admin)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull();
+});
+
+test('AcceptInvite is forbidden for anyone but the invitee', function () {
+    $entity = Entity::factory()->create();
+    $stranger = User::factory()->create(['email' => 'other@example.com']);
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']);
+
+    expect(fn () => app(AcceptInvite::class)->handle($stranger, $invite))->toThrow(AuthorizationException::class);
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+/* ---------- DeclineInvite ---------- */
+
+test('DeclineInvite deletes the invite for the invitee only', function () {
