diff --git a/tests/Feature/AccountEmailsTest.php b/tests/Feature/AccountEmailsTest.php
new file mode 100644
index 0000000..1f4859d
--- /dev/null
+++ b/tests/Feature/AccountEmailsTest.php
@@ -0,0 +1,124 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+it('pins the product locale and name', function () {
+    expect(app()->getLocale())->toBe('pt_BR')
+        ->and(config('app.name'))->toBe('PegaFila')
+        ->and(config('app.fallback_locale'))->toBe('en')
+        ->and(config('mail.markdown.theme'))->toBe('pegafila');
+});
+
+it('renders the reset mail in pt-BR with the brand theme', function () {
+    $user = User::factory()->create();
+
+    $mail = (new ResetPassword('token'))->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Redefina sua senha')
+        ->and($html)->toContain('PegaFila', 'Olá!', 'Redefinir senha', 'Você recebeu esse e-mail', '#0f7490')
+        ->and($html)->not->toContain('having trouble clicking');
+});
+
+it('renders the verification mail in pt-BR', function () {
+    $user = User::factory()->create();
+
+    $mail = (new VerifyEmail)->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($html)->toContain('Verifique o endereço de e-mail', '#0f7490')
+        ->and($html)->not->toContain('having trouble clicking');
+});
+
+it('always answers the reset request with the same status', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()->assertSessionHas('status', __('passwords.sent'));
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertRedirect()->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+    Notification::assertCount(1);
+});
+
+it('validates the reset request e-mail', function () {
+    $this->post(route('password.email'), ['email' => 'nope'])->assertSessionHasErrors('email');
+});
+
+it('shows the forms to guests', function () {
+    $this->get(route('password.request'))->assertOk();
+    $this->get(route('password.reset', ['token' => 'abc', 'email' => 'a@b.co']))
+        ->assertOk()->assertSee('a@b.co');
+});
+
+it('resets the password', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPassw0rd',
+        'password_confirmation' => 'NewPassw0rd',
+    ])->assertRedirect('/')->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NewPassw0rd', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old');
+    Event::assertDispatched(PasswordReset::class);
+});
+
+it('rejects a weak password or bad token', function () {
+    $user = User::factory()->create();
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token, 'email' => $user->email,
+        'password' => 'weakpass', 'password_confirmation' => 'weakpass',
+    ])->assertSessionHasErrors('password');
+
+    $this->post(route('password.update'), [
+        'token' => 'bad', 'email' => $user->email,
+        'password' => 'NewPassw0rd', 'password_confirmation' => 'NewPassw0rd',
+    ])->assertSessionHasErrors('email');
+});
+
+it('verifies the logged-in user through the signed link', function () {
+    $user = User::factory()->unverified()->create();
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), [
+        'id' => $user->id, 'hash' => sha1($user->email),
+    ]);
+
+    $this->actingAs($user)->get($url)->assertRedirect('/');
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
