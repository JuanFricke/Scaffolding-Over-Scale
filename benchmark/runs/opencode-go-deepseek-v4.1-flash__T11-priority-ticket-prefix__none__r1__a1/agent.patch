diff --git a/tests/Feature/TicketCodePrefixTest.php b/tests/Feature/TicketCodePrefixTest.php
new file mode 100644
index 0000000..d186538
--- /dev/null
+++ b/tests/Feature/TicketCodePrefixTest.php
@@ -0,0 +1,184 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+afterEach(function () {
+    Carbon::setTestNow();
+});
+
+it('maps default prefixes by priority and range fallback', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Queue::defaultPrefixFor(0))->toBe('N')
+        ->and(Queue::defaultPrefixFor(10))->toBe('P')
+        ->and(Queue::defaultPrefixFor(20))->toBe('E')
+        ->and(Queue::defaultPrefixFor(-5))->toBe('N')
+        ->and(Queue::defaultPrefixFor(5))->toBe('P')
+        ->and(Queue::defaultPrefixFor(15))->toBe('P')
+        ->and(Queue::defaultPrefixFor(25))->toBe('E')
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(25))->toBe('E');
+});
+
+it('uses a custom queue map and normalizes an empty map to null', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z'],
+    ]);
+
+    expect($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('Z')
+        ->and($queue->prefixForPriority(5))->toBe('P');
+
+    (new UpdateQueue)($queue, makeTicketCodePrefixFeatureOwner($queue), priorityPrefixMap: []);
+    $queue->refresh();
+
+    expect($queue->priority_prefix_map)->toBeNull()
+        ->and($queue->prefixForPriority(0))->toBe('N');
+});
+
+it('does not mass assign the priority prefix map', function () {
+    $queue = Queue::factory()->create();
+
+    $queue->fill(['priority_prefix_map' => ['0' => 'X']]);
+
+    expect($queue->priority_prefix_map)->toBeNull();
+});
+
+it('validates priority prefix map keys values and effective uniqueness', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+})->with([
+    'negative key' => [['-1' => 'X']],
+    'non integer key' => [['foo' => 'X']],
+    'leading zero key' => [['010' => 'X']],
+    'lowercase value' => [['0' => 'xx']],
+    'two letters' => [['0' => 'AB']],
+    'duplicate custom values' => [['0' => 'N', '10' => 'N']],
+    'custom collides with default 80+' => [['0' => 'E']],
+    'extra custom collides with default' => [['5' => 'N']],
+]);
+
+it('sequences each prefix independently and restarts daily', function () {
+    Carbon::setTestNow('2026-09-28 23:59:59');
+
+    $queue = Queue::factory()->create();
+
+    $normal1 = (new IssueTicket)($queue, 0);
+    $normal2 = (new IssueTicket)($queue, 0);
+    $priority1 = (new IssueTicket)($queue, 10);
+    $priority2 = (new IssueTicket)($queue, 10);
+    $elderly = (new IssueTicket)($queue, 20);
+
+    expect([$normal1->code, $normal2->code, $priority1->code, $priority2->code, $elderly->code])
+        ->toBe(['N001', 'N002', 'P001', 'P002', 'E001'])
+        ->and($normal1->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($priority1->issued_at->toDateString())->toBe('2026-09-28');
+
+    Carbon::setTestNow('2026-09-29 00:00:01');
+
+    $nextDayNormal = (new IssueTicket)($queue, 0);
+    $nextDayPriority = (new IssueTicket)($queue, 10);
+
+    expect($nextDayNormal->code)->toBe('N001')
+        ->and($nextDayPriority->code)->toBe('P001')
+        ->and($nextDayNormal->issue_date->toDateString())->toBe('2026-09-29');
+});
+
+it('ignores legacy and malformed codes in the same prefix sequence', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'N001']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'N-X']);
+
+    expect((new IssueTicket)($queue, 0)->code)->toBe('N002');
+});
+
+it('factory aligns issue_date with issued_at and allocates by that day', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create([
+        'issued_at' => '2026-09-28 12:00:00',
+    ]);
+    $today = Ticket::factory()->forQueue($queue)->create([
+        'issued_at' => now(),
+    ]);
+    $pastDay = Ticket::factory()->forQueue($queue)->create([
+        'issued_at' => '2026-09-28 18:00:00',
+    ]);
+
+    expect($today->code)->toBe('N001')
+        ->and($pastDay->code)->toBe('N002')
+        ->and($pastDay->issue_date->toDateString())->toBe('2026-09-28');
+});
+
+it('factory keeps explicit codes and issue_date follows issued_at', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->forQueue($queue)->create([
+        'code' => 'CUSTOM',
+        'issued_at' => '2026-09-28 08:00:00',
+        'issue_date' => '2026-10-01',
+    ]);
+
+    expect($ticket->code)->toBe('CUSTOM')
+        ->and($ticket->issue_date->toDateString())->toBe('2026-09-28');
+});
+
+it('updates the prefix map through UpdateQueue and rejects invalid maps atomically', function () {
+    $queue = Queue::factory()->create(['name' => 'Original']);
+    $owner = makeTicketCodePrefixFeatureOwner($queue);
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X', '10' => 'Y', '20' => 'Z']);
+    $queue->refresh();
+
+    expect($queue->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z'])
+        ->and($queue->prefixForPriority(0))->toBe('X');
+
+    expect(fn () => (new UpdateQueue)(
+        $queue,
+        $owner,
+        name: 'Changed',
+        priorityPrefixMap: ['0' => 'N', '10' => 'N'],
+    ))->toThrow(ValidationException::class);
+
+    $queue->refresh();
+
+    expect($queue->name)->toBe('Original')
+        ->and($queue->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z']);
+
+    expect(fn () => (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['foo' => 'X']))
+        ->toThrow(ValidationException::class);
+});
+
+it('leaves the map unchanged when priorityPrefixMap is omitted', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z'],
+    ]);
+    $owner = makeTicketCodePrefixFeatureOwner($queue);
+
+    (new UpdateQueue)($queue, $owner, name: 'Renamed');
+    $queue->refresh();
+
+    expect($queue->name)->toBe('Renamed')
+        ->and($queue->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z']);
+});
+
+function makeTicketCodePrefixFeatureOwner(Queue $queue): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($user)->owner()->create();
+
+    return $user;
+}
