+                );
+            }
+
+            $normalized[$key] = $prefix;
+        }
+
+        $effectivePrefixes = array_values($normalized);
+
+        foreach (array_keys(self::DEFAULT_PREFIX_MAP) as $level) {
+            if (! array_key_exists($level, $normalized)) {
+                $effectivePrefixes[] = self::defaultPrefixFor($level);
+            }
+        }
+
+        if (count($effectivePrefixes) !== count(array_unique($effectivePrefixes))) {
+            throw new InvalidArgumentException(
+                'Priority prefix map effective prefixes must be unique.',
+            );
+        }
+
+        return $normalized;
+    }
