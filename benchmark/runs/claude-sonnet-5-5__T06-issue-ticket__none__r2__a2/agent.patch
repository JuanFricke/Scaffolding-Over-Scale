+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('factories build a queue with entity and a ticket with sequential codes', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity)->not->toBeNull()->and($queue->is_active)->toBeTrue();
+
+    $a = Ticket::factory()->forQueue($queue)->create();
+    $b = Ticket::factory()->forQueue($queue)->create();
+
+    expect([$a->code, $b->code])->toBe(['A001', 'A002'])
+        ->and($a->status)->toBe(TicketStatus::Waiting)
+        ->and($a->channel)->toBe(TicketChannel::Virtual)
+        ->and($a->priority)->toBe(0);
+});
+
+test('factory creating several tickets allocates consecutive codes', function () {
+    $queue = Queue::factory()->create();
+
+    $codes = Ticket::factory()->forQueue($queue)->count(3)->create()->pluck('code')->all();
+
+    expect($codes)->toBe(['A001', 'A002', 'A003']);
+});
+
+test('nextCode edge cases', function () {
+    $queue = Queue::factory()->create();
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    foreach (['A999', 'A1000'] as $code) {
+        Ticket::factory()->forQueue($queue)->create(['code' => $code]);
+    }
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+
+    $q2 = Queue::factory()->create();
+    Ticket::factory()->forQueue($q2)->count(3)->create();
+    Ticket::where('queue_id', $q2->id)->where('code', 'A002')->delete();
+    expect(Ticket::nextCode($q2->id))->toBe('A004');
+
+    $q3 = Queue::factory()->create();
+    Ticket::factory()->forQueue($q3)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($q3->id))->toBe('A001');
+
+    $q4 = Queue::factory()->create();
+    Ticket::factory()->forQueue($q4)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($q4)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($q4->id))->toBe('A002');
+});
+
+test('issue ticket creates a waiting ticket with defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull();
+
+    $second = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+    expect($second->code)->toBe('A002')->and($second->priority)->toBe(10)
+        ->and($second->fresh()->channel)->toBe(TicketChannel::Totem);
+});
+
+test('issue ticket rejects negative priority', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))->toThrow(InvalidArgumentException::class);
+    expect(Ticket::count())->toBe(0);
+});
+
+test('issue ticket rejects inactive queue, even when the model is stale', function () {
+    $stale = Queue::factory()->create();
+    Queue::whereKey($stale->id)->update(['is_active' => false]);
+
+    expect($stale->is_active)->toBeTrue();
+    expect(fn () => (new IssueTicket)($stale))->toThrow(InactiveQueueException::class);
+    expect(Ticket::count())->toBe(0);
+});
+
+test('issue ticket retries on code collision', function () {
+    $queue = Queue::factory()->create();
+    $calls = 0;
+
+    // Simulate a concurrent insert of the code we are about to allocate.
+    Ticket::creating(function (Ticket $t) use (&$calls) {
+        if ($calls++ === 0) {
+            Ticket::withoutEvents(fn () => Ticket::query()->insert([
+                'queue_id' => $t->queue_id, 'code' => $t->code, 'priority' => 0,
+                'channel' => 'virtual', 'status' => 'waiting', 'issued_at' => now(),
+            ]));
+        }
+    });
+
+    $ticket = (new IssueTicket)($queue);
+
+    // The collision rolled back the attempt (savepoint, including the competing row here); the retry succeeded.
+    expect($calls)->toBe(2)->and($ticket->exists)->toBeTrue()->and(Ticket::count())->toBe(1);
+});
+
+test('ticket is write-once except call fields', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->code = 'A999';
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+
+    $ticket = $ticket->fresh();
+    expect(fn () => $ticket->update(['priority' => 5]))->toThrow(LogicException::class);
+    expect($ticket->fresh()->priority)->toBe(0);
+
+    $ticket = $ticket->fresh();
+    $ticket->status = TicketStatus::Called;
+    $ticket->save();
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+test('a member can call a waiting ticket exactly once', function () {
+    $ticket = (new IssueTicket)(Queue::factory()->create());
+    $user = User::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $ticket->queue->entity_id, 'user_id' => $user->id]);
+
+    $ticket->call($user);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Called)
+        ->and($fresh->called_by_user_id)->toBe($user->id)
+        ->and($fresh->called_at)->not->toBeNull()
+        ->and($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->isDirty())->toBeFalse();
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+
+    // A stale instance is also rejected.
+    $stale = Ticket::find($ticket->id);
+    Ticket::whereKey($ticket->id)->update(['status' => 'waiting']);
+    $other = Ticket::find($ticket->id);
+    $other->call($user);
+    expect(fn () => $stale->call($user))->toThrow(LogicException::class);
+});
+
+test('non members cannot call a ticket', function () {
+    $ticket = (new IssueTicket)(Queue::factory()->create());
+    $outsider = User::factory()->create();
+    EntityMembership::factory()->create(['user_id' => $outsider->id]);
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Waiting)
+        ->and($fresh->called_at)->toBeNull()
+        ->and($fresh->called_by_user_id)->toBeNull();
+});
+
+test('queue and ticket relations and cascades', function () {
+    $ticket = Ticket::factory()->create();
+    $queue = $ticket->queue;
+
+    expect($queue->entity->queues->pluck('id')->all())->toBe([$queue->id])
+        ->and($queue->tickets->pluck('id')->all())->toBe([$ticket->id]);
+
+    $queue->delete();
+    expect(Ticket::count())->toBe(0);
+});
