@@ -0,0 +1,62 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Attempts before giving up on concurrent (queue_id, code) collisions.
+     */
+    private const MAX_ATTEMPTS = 5;
+
+    /**
+     * @throws InvalidArgumentException when the priority is negative
+     * @throws InactiveQueueException when the queue is (now) inactive
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be greater than or equal to 0.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(fn () => $this->issue($queue, $priority, $channel));
+            } catch (UniqueConstraintViolationException $e) {
+                if ($attempt >= self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+    }
+
+    private function issue(Queue $queue, int $priority, TicketChannel $channel): Ticket
+    {
+        // Authoritative state comes from the database, under lock, not from the passed model.
+        $locked = Queue::query()->whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+        if (! $locked->is_active) {
+            throw new InactiveQueueException;
+        }
+
+        $ticket = Ticket::create([
+            'queue_id' => $locked->getKey(),
+            'code' => Ticket::nextCode($locked->getKey()),
+            'priority' => $priority,
+            'channel' => $channel,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ]);
+
+        return $ticket->setRelation('queue', $locked);
+    }
+}
