diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..c05a2ee
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,124 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields that may change after issuance (updated_at is maintained by Eloquent).
+     */
+    private const MUTABLE = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    protected static function booted(): void
+    {
+        static::updating(function (Ticket $ticket) {
+            $immutable = array_diff(array_keys($ticket->getDirty()), self::MUTABLE);
+
+            if ($immutable !== []) {
+                throw new LogicException(
+                    'Ticket fields are immutable after issuance: '.implode(', ', $immutable).'.'
+                );
+            }
+        });
+    }
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for the queue: A001, A002, ... (grows past A999).
+     *
+     * It is the last well-formed code (A<digits>) by insertion order plus one;
+     * malformed legacy codes are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = static::query()
+            ->where('queue_id', $queueId)
+            ->select(['id', 'code'])
+            ->lazyByIdDesc(100);
+
+        $last = 0;
+
+        foreach ($codes as $ticket) {
+            if (preg_match('/^A(\d+)$/', $ticket->code, $matches) === 1) {
+                $last = (int) $matches[1];
+                break;
+            }
+        }
+
+        return 'A'.str_pad((string) ($last + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call this ticket (exactly once) on behalf of a member of its entity.
+     *
+     * @throws AuthorizationException when the user is not a member of the ticket's entity
+     * @throws LogicException when the ticket is not waiting
+     */
+    public function call(User $user): void
+    {
+        DB::transaction(function () use ($user) {
+            // Re-read under lock: the in-memory model may be stale.
+            $current = static::query()->whereKey($this->getKey())->lockForUpdate()->firstOrFail();
+
+            $entityId = Queue::query()->whereKey($current->queue_id)->value('entity_id');
+
+            if ($entityId === null || $user->membershipFor($entityId) === null) {
+                throw new AuthorizationException;
+            }
+
+            if ($current->status !== TicketStatus::Waiting) {
+                throw new LogicException('Only waiting tickets can be called.');
+            }
+
+            $current->forceFill([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+            ])->save();
+
+            $fields = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+            $this->setRawAttributes(
+                array_merge($this->getAttributes(), array_intersect_key($current->getAttributes(), array_flip($fields)))
+            );
+            $this->syncOriginalAttributes($fields);
+        });
+    }
+}
