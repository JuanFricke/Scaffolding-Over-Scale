+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,48 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        // The user can view the membership if they are a member of the same entity.
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        // User must be member of same entity and be owner or admin
+        $userMembership = $membership->entity->memberships()->where('user_id', $user->id)->first();
+        if ($userMembership === null) {
+            return false;
+        }
+        if ($userMembership->role !== UserRole::Owner && $userMembership->role !== UserRole::Admin) {
+            return false;
+        }
+        // Cannot assign role if target is owner and assigning non-owner? Not specified; allow.
+        return true;
+    }
+
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        // Cannot delete owner's membership
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+        // Allow self removal
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+        // Owner or admin of the entity may delete
+        $userMembership = $membership->entity->memberships()->where('user_id', $user->id)->first();
+        if ($userMembership === null) {
+            return false;
+        }
+        return $userMembership->role === UserRole::Owner || $userMembership->role === UserRole::Admin;
+    }
+}
diff --git a/app/Policies/EntityPolicy.php b/app/Policies/EntityPolicy.php
