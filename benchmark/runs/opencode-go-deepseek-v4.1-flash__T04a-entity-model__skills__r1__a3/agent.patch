+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,98 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function entityPolicyMember(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'role' => $role,
+    ]);
+
+    return $user;
+}
+
+test('any authenticated user may create an entity', function () {
+    expect((new EntityPolicy)->create(User::factory()->make()))->toBeTrue();
+});
+
+test('every member may view an entity but non-members may not', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+
+    foreach (UserRole::cases() as $role) {
+        expect($policy->view(entityPolicyMember($entity, $role), $entity))->toBeTrue();
+    }
+
+    expect($policy->view(User::factory()->create(), $entity))->toBeFalse();
+});
+
+test('owner and admin may update and delete an entity', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+
+    foreach ([UserRole::Owner, UserRole::Admin] as $role) {
+        $member = entityPolicyMember($entity, $role);
+
+        expect($policy->update($member, $entity))->toBeTrue()
+            ->and($policy->delete($member, $entity))->toBeTrue();
+    }
+});
+
+test('employees and non-members may not update or delete an entity', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+    $employee = entityPolicyMember($entity, UserRole::Employee);
+    $outsider = User::factory()->create();
+
+    expect($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->delete($employee, $entity))->toBeFalse()
+        ->and($policy->update($outsider, $entity))->toBeFalse()
+        ->and($policy->delete($outsider, $entity))->toBeFalse();
+});
+
+test('only the owner may manage settings', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+    $owner = entityPolicyMember($entity, UserRole::Owner);
+    $admin = entityPolicyMember($entity, UserRole::Admin);
+    $employee = entityPolicyMember($entity, UserRole::Employee);
+    $outsider = User::factory()->create();
+
+    expect($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse()
+        ->and($policy->manageSettings($employee, $entity))->toBeFalse()
+        ->and($policy->manageSettings($outsider, $entity))->toBeFalse();
+});
+
+test('a member of another entity has no permission over an entity', function () {
+    $entity = Entity::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+    $outsider = entityPolicyMember($otherEntity, UserRole::Owner);
+
+    expect($policy->view($outsider, $entity))->toBeFalse()
+        ->and($policy->update($outsider, $entity))->toBeFalse()
+        ->and($policy->delete($outsider, $entity))->toBeFalse()
+        ->and($policy->manageSettings($outsider, $entity))->toBeFalse();
+});
+
+test('entity policy is discovered by the gate', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityPolicyMember($entity, UserRole::Owner);
+    $employee = entityPolicyMember($entity, UserRole::Employee);
+
+    expect(Gate::forUser($owner)->allows('manageSettings', $entity))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('manageSettings', $entity))->toBeFalse();
+});
