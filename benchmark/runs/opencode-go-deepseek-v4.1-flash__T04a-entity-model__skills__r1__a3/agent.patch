+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+return new class extends Migration
+{
+    /**
+     * Run the migrations.
+     */
+    public function up(): void
+    {
+        Schema::create('entity_memberships', function (Blueprint $table) {
+            $table->id();
+            $table->foreignId('entity_id')->constrained()->cascadeOnDelete();
+            $table->foreignId('user_id')->constrained()->cascadeOnDelete();
+            $table->string('role')->default('employee');
+            $table->timestamps();
+
+            // 1 for the owner membership, NULL for everyone else: the unique index
+            // below then allows only one owner per entity while leaving all other
+            // memberships unconstrained (NULLs are distinct on SQLite and MariaDB).
+            $table->integer('owner_seq')
+                ->nullable()
+                ->storedAs("CASE WHEN role = 'owner' THEN 1 ELSE NULL END");
+
+            $table->unique(
+                ['entity_id', 'user_id'],
+                'entity_memberships_entity_user_unique',
+            );
+            $table->unique(
+                ['entity_id', 'owner_seq'],
+                'entity_memberships_one_owner',
+            );
+        });
+    }
+
+    /**
+     * Reverse the migrations.
+     */
+    public function down(): void
+    {
+        Schema::dropIfExists('entity_memberships');
+    }
+};
