+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Determine whether the user can create an entity.
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    /**
+     * Determine whether the user can view the entity.
+     */
+    public function view(User $user, Entity $entity): bool
+    {
+        return $this->hasRole($user, $entity, UserRole::Owner, UserRole::Admin, UserRole::Employee);
+    }
+
+    /**
+     * Determine whether the user can update the entity.
+     */
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->hasRole($user, $entity, UserRole::Owner, UserRole::Admin);
+    }
+
+    /**
+     * Determine whether the user can delete the entity.
+     */
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->hasRole($user, $entity, UserRole::Owner, UserRole::Admin);
+    }
+
+    /**
+     * Determine whether the user can manage the entity's settings.
+     */
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $this->hasRole($user, $entity, UserRole::Owner);
+    }
+
+    /**
+     * Determine whether the user has one of the given roles in the entity.
+     */
+    private function hasRole(User $user, Entity $entity, UserRole ...$roles): bool
+    {
+        $role = $user->membershipFor($entity->id)?->role;
+
+        return $role !== null && in_array($role, $roles, true);
+    }
+}
