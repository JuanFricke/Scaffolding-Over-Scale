+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function membershipPolicyMember(Entity $entity, UserRole $role): EntityMembership
+{
+    return EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'role' => $role,
+    ]);
+}
+
+test('any member of the entity may view a membership', function () {
+    $entity = Entity::factory()->create();
+    $membership = membershipPolicyMember($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    foreach (UserRole::cases() as $role) {
+        expect($policy->view(membershipPolicyMember($entity, $role)->user, $membership))->toBeTrue();
+    }
+});
+
+test('non-members may not view a membership', function () {
+    $entity = Entity::factory()->create();
+    $membership = membershipPolicyMember($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view(User::factory()->create(), $membership))->toBeFalse()
+        ->and($policy->view(membershipPolicyMember(Entity::factory()->create(), UserRole::Owner)->user, $membership))->toBeFalse();
+});
+
+test('owner and admin may assign roles to a membership', function () {
+    $entity = Entity::factory()->create();
+    $membership = membershipPolicyMember($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    foreach ([UserRole::Owner, UserRole::Admin] as $role) {
+        expect($policy->assignRole(membershipPolicyMember($entity, $role)->user, $membership))->toBeTrue();
+    }
+});
+
+test('employees and non-members may not assign roles to a membership', function () {
+    $entity = Entity::factory()->create();
+    $membership = membershipPolicyMember($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->assignRole(membershipPolicyMember($entity, UserRole::Employee)->user, $membership))->toBeFalse()
+        ->and($policy->assignRole(User::factory()->create(), $membership))->toBeFalse()
+        ->and($policy->assignRole(membershipPolicyMember(Entity::factory()->create(), UserRole::Owner)->user, $membership))->toBeFalse();
+});
+
+test('the owner membership may never be deleted', function () {
+    $entity = Entity::factory()->create();
+    $ownerMembership = membershipPolicyMember($entity, UserRole::Owner);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($ownerMembership->user, $ownerMembership))->toBeFalse()
+        ->and($policy->delete(membershipPolicyMember($entity, UserRole::Admin)->user, $ownerMembership))->toBeFalse()
+        ->and($policy->delete(membershipPolicyMember(Entity::factory()->create(), UserRole::Owner)->user, $ownerMembership))->toBeFalse();
+});
+
+test('a member may delete their own non-owner membership', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityMembershipPolicy;
+
+    foreach ([UserRole::Admin, UserRole::Employee] as $role) {
+        $membership = membershipPolicyMember($entity, $role);
+
+        expect($policy->delete($membership->user, $membership))->toBeTrue();
+    }
+});
+
+test('owner and admin may delete other non-owner memberships', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityMembershipPolicy;
+
+    foreach ([UserRole::Owner, UserRole::Admin] as $role) {
+        $actor = membershipPolicyMember($entity, $role);
+        $target = membershipPolicyMember($entity, UserRole::Employee);
+
+        expect($policy->delete($actor->user, $target))->toBeTrue();
+    }
+});
+
+test('employees and non-members may not delete other memberships', function () {
+    $entity = Entity::factory()->create();
+    $target = membershipPolicyMember($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete(membershipPolicyMember($entity, UserRole::Employee)->user, $target))->toBeFalse()
+        ->and($policy->delete(User::factory()->create(), $target))->toBeFalse()
+        ->and($policy->delete(membershipPolicyMember(Entity::factory()->create(), UserRole::Owner)->user, $target))->toBeFalse();
+});
+
+test('entity membership policy is discovered by the gate', function () {
+    $entity = Entity::factory()->create();
+    $admin = membershipPolicyMember($entity, UserRole::Admin);
+    $employee = membershipPolicyMember($entity, UserRole::Employee);
+
+    expect(Gate::forUser($admin->user)->allows('assignRole', $employee))->toBeTrue()
+        ->and(Gate::forUser($employee->user)->allows('assignRole', $employee))->toBeFalse();
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..899cfd4
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,181 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity factory creates an entity with a non-empty name and unique slug', function () {
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    expect($first->name)->not->toBeEmpty()
+        ->and($first->slug)->not->toBeEmpty()
+        ->and($second->slug)->not->toBe($first->slug);
+});
+
+test('entities are bound in routes by slug', function () {
+    expect((new Entity)->getRouteKeyName())->toBe('slug');
+});
+
+test('entity exposes memberships, users and its owner membership', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->count())->toBe(2)
+        ->and($entity->users()->pluck('users.id')->all())->toContain($owner->user_id, $employee->user_id)
+        ->and($entity->owner()->first()?->is($owner))->toBeTrue();
+});
+
+test('entity owner is null when it has no owner membership', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($entity->owner()->first())->toBeNull();
+});
+
+test('entity membership factory creates an employee with its entity and user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+});
+
+test('entity membership factory exposes role states', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect($owner->role)->toBe(UserRole::Owner)
+        ->and($admin->role)->toBe(UserRole::Admin)
+        ->and($employee->role)->toBe(UserRole::Employee);
+});
+
+test('owner_seq is generated from the membership role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect($owner->refresh()->owner_seq)->toBe(1)
+        ->and($employee->refresh()->owner_seq)->toBeNull();
+});
+
+test('entity membership role defaults to employee in the database', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(EntityMembership::first()->role)->toBe(UserRole::Employee);
+});
+
+test('schema uses the required unique index names', function () {
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))
+        ->toContain('entities_slug_unique')
+        ->and(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_entity_user_unique', 'entity_memberships_one_owner');
+});
+
+test('entity membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and($entity->memberships()->admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and($entity->memberships()->employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('user exposes memberships, entities and its membership for an entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->admin()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+    $unrelated = Entity::factory()->create();
+
+    expect($user->memberships()->count())->toBe(1)
+        ->and($user->entities()->pluck('entities.id')->all())->toBe([$entity->id])
+        ->and($user->membershipFor($entity->id)?->is($membership))->toBeTrue()
+        ->and($user->membershipFor($unrelated->id))->toBeNull();
+});
+
+test('user role exposes its manageable roles', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('entity slug must be unique', function () {
+    $entity = Entity::factory()->create();
+
+    expect(fn () => Entity::factory()->create(['slug' => $entity->slug]))
+        ->toThrow(QueryException::class);
+});
+
+test('a user can have only one membership per entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(QueryException::class);
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]))
+        ->toThrow(QueryException::class);
+});
+
+test('different entities may each have an owner and non-owners are unlimited', function () {
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $first->id]);
+    EntityMembership::factory()->owner()->create(['entity_id' => $second->id]);
+    EntityMembership::factory()->count(3)->employee()->create(['entity_id' => $first->id]);
+
+    expect($first->memberships()->count())->toBe(4)
+        ->and($second->memberships()->count())->toBe(1);
+});
+
+test('deleting an entity force deletes its memberships', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->create(['entity_id' => $entity->id]);
+
+    $entity->forceDelete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('deleting a user deletes its memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('entities are soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..fb0f98e
