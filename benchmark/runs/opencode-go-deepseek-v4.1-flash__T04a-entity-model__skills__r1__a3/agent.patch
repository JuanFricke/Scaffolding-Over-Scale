@@ -0,0 +1,52 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Determine whether the user can view the membership.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Determine whether the user can assign a role to the membership.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->hasEntityRole($user, $membership, UserRole::Owner, UserRole::Admin);
+    }
+
+    /**
+     * Determine whether the user can delete the membership.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ((int) $user->id === (int) $membership->user_id) {
+            return true;
+        }
+
+        return $this->hasEntityRole($user, $membership, UserRole::Owner, UserRole::Admin);
+    }
+
+    /**
+     * Determine whether the user has one of the given roles in the membership's entity.
+     */
+    private function hasEntityRole(User $user, EntityMembership $membership, UserRole ...$roles): bool
+    {
+        $role = $user->membershipFor($membership->entity_id)?->role;
+
+        return $role !== null && in_array($role, $roles, true);
+    }
+}
