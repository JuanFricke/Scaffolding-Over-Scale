+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the app is pinned to PegaFila with pt-BR and en fallback', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('markdown mail uses the pegafila theme shipped in resources', function () {
+    expect(config('mail.markdown.theme'))->toBe('pegafila')
+        ->and(resource_path('views/vendor/mail/html/themes/pegafila.css'))->toBeFile();
+});
+
+test('reset password mail is in pt-BR with the PegaFila brand', function () {
+    $user = User::factory()->create();
+
+    $mail = (new ResetPassword('token-123'))->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Redefina sua senha')
+        ->and($html)->toContain('PegaFila')
+        ->and($html)->toContain('Olá!')
+        ->and($html)->toContain('Redefinir senha')
+        ->and($html)->toContain('Você recebeu esse e-mail')
+        ->and($html)->toContain('Se você estiver tendo problemas para clicar no botão')
+        ->and($html)->not->toContain('having trouble')
+        ->and($html)->toContain('/reset-password/token-123');
+});
+
+test('verification mail is in pt-BR with a signed verification button', function () {
+    $user = User::factory()->create();
+
+    $mail = (new VerifyEmail)->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($html)->toContain('Verifique o endereço de e-mail')
+        ->and($html)->toContain('Por favor, clique no botão abaixo para verificar seu endereço de e-mail.')
+        ->and($html)->toContain('/email/verify/'.$user->id.'/'.sha1($user->email))
+        ->and($html)->toContain('signature=');
+});
+
+test('the primary action button uses the brand color after css inlining', function () {
+    $user = User::factory()->create();
+
+    $html = (string) (new ResetPassword('token-123'))->toMail($user)->render();
+
+    expect($html)->toContain('background-color: #0f7490');
+});
