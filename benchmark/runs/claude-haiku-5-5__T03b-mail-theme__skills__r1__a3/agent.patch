+Route::get('/email/verify/{id}/{hash}', VerifyEmailController::class)
+    ->middleware(['auth', 'signed', 'throttle:6,1'])
+    ->name('verification.verify');
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..229eb99
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,164 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the forgot password form with a labelled e-mail field', function () {
+    $response = $this->get(route('password.request'));
+
+    $response->assertOk()
+        ->assertSee('action="'.route('password.email').'"', false)
+        ->assertSee('for="email"', false)
+        ->assertSee('name="email"', false);
+});
+
+test('authenticated users are redirected away from the forgot password form', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('password.request'))
+        ->assertRedirect();
+});
+
+test('a reset link is sent to an existing user and the response shows the sent status', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $response = $this->post(route('password.email'), ['email' => $user->email]);
+
+    Notification::assertSentTo($user, ResetPassword::class);
+    $response->assertRedirect()
+        ->assertSessionHas('status', 'Enviamos um link para redefinição de senha para o seu e-mail.');
+});
+
+test('an unknown address gets the same response and nothing is sent', function () {
+    Notification::fake();
+
+    $response = $this->post(route('password.email'), ['email' => 'ninguem@example.com']);
+
+    Notification::assertNothingSent();
+    $response->assertRedirect()
+        ->assertSessionHas('status', 'Enviamos um link para redefinição de senha para o seu e-mail.');
+});
+
+test('an invalid e-mail address is rejected without sending', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nao-e-um-email'])
+        ->assertSessionHasErrors('email');
+
+    Notification::assertNothingSent();
+});
+
+test('the reset link request is throttled after six attempts a minute', function () {
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('password.email'), ['email' => 'ninguem@example.com']);
+    }
+
+    $this->post(route('password.email'), ['email' => 'ninguem@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset form carries the token and the e-mail with a single e-mail input', function () {
+    $response = $this->get(route('password.reset', ['token' => 'abc123', 'email' => 'ana@example.com']));
+
+    $response->assertOk()
+        ->assertSee('action="'.route('password.update').'"', false)
+        ->assertSee('name="token"', false)
+        ->assertSee('value="abc123"', false)
+        ->assertSee('value="ana@example.com"', false)
+        ->assertSee('name="password"', false)
+        ->assertSee('name="password_confirmation"', false);
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('a valid token resets the password, rotates remember_token and redirects home', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'token-antigo']);
+    $token = Password::broker()->createToken($user);
+
+    $response = $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ]);
+
+    $user->refresh();
+
+    expect(Hash::check('NovaSenha123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('token-antigo');
+
+    Event::assertDispatched(PasswordReset::class, fn (PasswordReset $event) => $event->user->is($user));
+
+    $response->assertRedirect('/')
+        ->assertSessionHas('status', 'Sua senha foi redefinida.');
+});
+
+test('an invalid token is rejected and the password is kept', function () {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => 'token-que-nao-existe',
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ])->assertSessionHasErrors('email');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+});
+
+test('a token cannot be used for another e-mail address', function () {
+    $owner = User::factory()->create();
+    $other = User::factory()->create();
+    $token = Password::broker()->createToken($owner);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $other->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ])->assertSessionHasErrors('email');
+
+    expect(Hash::check('password', $other->fresh()->password))->toBeTrue();
+});
+
+test('the new password must be confirmed', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'OutraSenha123',
+    ])->assertSessionHasErrors('password');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+});
+
+test('weak passwords are rejected and the password is kept', function (string $password) {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => $password,
+        'password_confirmation' => $password,
+    ])->assertSessionHasErrors('password');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+})->with([
+    'too short' => ['Abc123'],
+    'no uppercase' => ['senhaforte1'],
+    'no lowercase' => ['SENHAFORTE1'],
+    'no numbers' => ['SenhaForte'],
+]);
diff --git a/tests/Feature/Auth/VerifyEmailTest.php b/tests/Feature/Auth/VerifyEmailTest.php
new file mode 100644
index 0000000..bc6d511
--- /dev/null
+++ b/tests/Feature/Auth/VerifyEmailTest.php
@@ -0,0 +1,58 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user, string $hash): string
+{
+    return URL::temporarySignedRoute(
+        'verification.verify',
+        now()->addMinutes(60),
+        ['id' => $user->getKey(), 'hash' => $hash],
+    );
+}
+
+test('a signed link verifies the logged-in user and redirects home', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user, sha1($user->email)))
+        ->assertRedirect('/');
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link with a hash that does not match the account is refused', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user, sha1('outro@example.com')))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link that belongs to another account is refused', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($other, sha1($other->email)))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned link is refused', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
diff --git a/tests/Feature/Mail/AccountEmailsTest.php b/tests/Feature/Mail/AccountEmailsTest.php
