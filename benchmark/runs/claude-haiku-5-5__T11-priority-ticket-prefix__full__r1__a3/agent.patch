@@ -15,6 +16,85 @@ class Queue extends Model
     /** @use HasFactory<QueueFactory> */
     use HasFactory;
 
+    /**
+     * Default ticket code prefix per priority level (see business-rules.md).
+     *
+     * @var array<int, string>
+     */
+    public const DEFAULT_PREFIX_MAP = [0 => 'N', 10 => 'P', 20 => 'E'];
+
+    protected static function booted(): void
+    {
+        static::saving(function (Queue $queue): void {
+            $queue->priority_prefix_map = self::normalizePrefixMap($queue->priority_prefix_map);
+        });
+    }
+
+    /**
+     * Default prefix for a priority: exact level first, then by range.
+     */
+    public static function defaultPrefixFor(int $priority): string
+    {
+        return self::DEFAULT_PREFIX_MAP[$priority] ?? match (true) {
+            $priority <= 0 => 'N',
+            $priority >= 20 => 'E',
+            default => 'P',
+        };
+    }
+
+    /**
+     * Ticket code prefix for a priority on this queue: the custom map wins,
+     * otherwise the default prefix applies.
+     */
+    public function prefixForPriority(int $priority): string
+    {
+        return $this->priority_prefix_map[$priority] ?? self::defaultPrefixFor($priority);
+    }
+
+    /**
+     * Normalize and validate a custom priority -> letter map.
+     *
+     * An empty map becomes null (default prefixes). Keys must be canonical
+     * non-negative integers, values exactly one uppercase letter, and the
+     * effective prefixes unique: custom entries plus the defaults of the
+     * levels 0/10/20 they do not cover.
+     *
+     * @param  array<array-key, mixed>|null  $map
+     * @return array<int, string>|null
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function normalizePrefixMap(?array $map): ?array
+    {
+        if ($map === null || $map === []) {
+            return null;
+        }
+
+        foreach ($map as $priority => $letter) {
+            if (! preg_match('/\A(0|[1-9]\d*)\z/', (string) $priority)) {
+                throw new InvalidArgumentException("Priority [{$priority}] must be a non-negative integer.");
+            }
+
+            if (! is_string($letter) || ! preg_match('/\A[A-Z]\z/', $letter)) {
+                throw new InvalidArgumentException("Prefix for priority [{$priority}] must be one uppercase letter (A-Z).");
+            }
+        }
+
+        $prefixes = array_values($map);
+
+        foreach (self::DEFAULT_PREFIX_MAP as $level => $default) {
+            if (! array_key_exists($level, $map)) {
+                $prefixes[] = $default;
+            }
+        }
+
+        if (count(array_unique($prefixes)) !== count($prefixes)) {
+            throw new InvalidArgumentException('Ticket prefixes must be unique within a queue.');
+        }
+
+        return $map;
+    }
+
     /**
      * @return array<string, string>
      */
