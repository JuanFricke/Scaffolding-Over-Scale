diff --git a/tests/Feature/QueuePriorityPrefixTest.php b/tests/Feature/QueuePriorityPrefixTest.php
new file mode 100644
index 0000000..73c1675
--- /dev/null
+++ b/tests/Feature/QueuePriorityPrefixTest.php
@@ -0,0 +1,116 @@
+<?php
+
+use App\Models\Queue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('maps the default levels to N, P and E and falls back by range', function () {
+    expect(Queue::defaultPrefixFor(0))->toBe('N')
+        ->and(Queue::defaultPrefixFor(10))->toBe('P')
+        ->and(Queue::defaultPrefixFor(20))->toBe('E')
+        ->and(Queue::defaultPrefixFor(-5))->toBe('N')
+        ->and(Queue::defaultPrefixFor(5))->toBe('P')
+        ->and(Queue::defaultPrefixFor(15))->toBe('P')
+        ->and(Queue::defaultPrefixFor(25))->toBe('E');
+});
+
+it('uses the default prefixes when the queue has no custom map', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->priority_prefix_map)->toBeNull()
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(10))->toBe('P')
+        ->and($queue->prefixForPriority(20))->toBe('E');
+});
+
+it('lets a custom map override the prefix for each priority it covers', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z'],
+    ]);
+
+    expect($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('Z');
+});
+
+it('falls back to the default prefix for priorities missing from the custom map', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['10' => 'Y']]);
+
+    expect($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('E')
+        ->and($queue->prefixForPriority(5))->toBe('P');
+});
+
+it('persists a custom map and reads it back as an array', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '5' => 'Q']]);
+
+    $fresh = $queue->fresh();
+
+    expect($fresh->priority_prefix_map)->toBe([0 => 'X', 5 => 'Q'])
+        ->and($fresh->prefixForPriority(5))->toBe('Q');
+});
+
+it('stores an empty map as null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('normalizes a map cleared on an existing queue back to null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+
+    $queue->priority_prefix_map = [];
+    $queue->save();
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('is not mass-assignable from user input', function () {
+    $queue = Queue::factory()->create();
+
+    $queue->update(['priority_prefix_map' => ['0' => 'X']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects keys that are not canonical non-negative integers', function (string $key) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => [$key => 'X']]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+})->with(['foo', '-1', '010', '1.5', ' 1', '1 ', "1\n"]);
+
+it('rejects values that are not exactly one uppercase letter', function (mixed $letter) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => ['0' => $letter]]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+})->with(['xx', 'x', '1', '', 'AB', 'A ', "A\n", 7]);
+
+it('rejects a map that repeats a letter across custom entries', function () {
+    expect(fn () => Queue::factory()->create([
+        'priority_prefix_map' => ['0' => 'N', '10' => 'N'],
+    ]))->toThrow(InvalidArgumentException::class);
+});
+
+it('rejects a custom letter that merges with a default level prefix', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+})->with([
+    'normal merged with 80+' => [['0' => 'E']],
+    'custom level colliding with normal default' => [['10' => 'N']],
+    'custom range colliding with 80+ default' => [['5' => 'E']],
+    'custom entry repeating a custom letter' => [['0' => 'X', '10' => 'Y', '20' => 'Z', '30' => 'X']],
+]);
+
+it('validates the map on every save, not only on create', function () {
+    $queue = Queue::factory()->create();
+
+    $queue->priority_prefix_map = ['0' => 'N', '10' => 'N'];
+
+    expect(fn () => $queue->save())->toThrow(InvalidArgumentException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
diff --git a/tests/Feature/TicketDailyCodeTest.php b/tests/Feature/TicketDailyCodeTest.php
new file mode 100644
index 0000000..648e6f3
--- /dev/null
+++ b/tests/Feature/TicketDailyCodeTest.php
@@ -0,0 +1,148 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('starts every prefix at 001 when the day has no tickets', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    expect(Ticket::nextCode($queue->id, 'N', '2026-10-29'))->toBe('N001')
+        ->and(Ticket::nextCode($queue->id, 'P', '2026-10-29'))->toBe('P001');
+});
+
+it('counts only tickets with the same prefix and issue date', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'N001', 'issued_at' => '2026-10-29 09:00:00']);
+    Ticket::factory()->for($queue)->create(['code' => 'P001', 'issued_at' => '2026-10-29 09:01:00']);
+
+    expect(Ticket::nextCode($queue->id, 'N', '2026-10-29'))->toBe('N002')
+        ->and(Ticket::nextCode($queue->id, 'P', '2026-10-29'))->toBe('P002')
+        ->and(Ticket::nextCode($queue->id, 'N', '2026-10-30'))->toBe('N001');
+});
+
+it('skips malformed codes of the same prefix', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'N001', 'issued_at' => '2026-10-29 09:00:00']);
+    Ticket::factory()->for($queue)->create(['code' => 'N-X', 'issued_at' => '2026-10-29 09:01:00']);
+
+    expect(Ticket::nextCode($queue->id, 'N', '2026-10-29'))->toBe('N002');
+
+    $onlyMalformed = Queue::factory()->create(['is_active' => true]);
+    Ticket::factory()->for($onlyMalformed)->create(['code' => 'N-X', 'issued_at' => '2026-10-29 09:00:00']);
+
+    expect(Ticket::nextCode($onlyMalformed->id, 'N', '2026-10-29'))->toBe('N001');
+});
+
+it('does not treat legacy A codes as part of the normal sequence', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001', 'issued_at' => '2026-10-29 09:00:00']);
+
+    expect(Ticket::nextCode($queue->id, 'N', '2026-10-29'))->toBe('N001');
+});
+
+it('continues past 999 within the same prefix and day', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'N999', 'issued_at' => '2026-10-29 09:00:00']);
+    Ticket::factory()->for($queue)->create(['code' => 'N1000', 'issued_at' => '2026-10-29 09:01:00']);
+
+    expect(Ticket::nextCode($queue->id, 'N', '2026-10-29'))->toBe('N1001');
+});
+
+it('issues independent sequences for each priority prefix', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $codes = collect([0, 0, 10, 10, 20, 5])
+        ->map(fn (int $priority) => (new IssueTicket)($queue, $priority)->code)
+        ->all();
+
+    expect($codes)->toBe(['N001', 'N002', 'P001', 'P002', 'E001', 'P003']);
+});
+
+it('restarts each prefix at 001 on the next day', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $this->travelTo('2026-10-29 10:00:00');
+    expect((new IssueTicket)($queue, 0)->code)->toBe('N001')
+        ->and((new IssueTicket)($queue, 10)->code)->toBe('P001');
+
+    $this->travelTo('2026-10-30 08:00:00');
+    $normal = (new IssueTicket)($queue, 0);
+    $priority = (new IssueTicket)($queue, 10);
+
+    expect($normal->code)->toBe('N001')
+        ->and($normal->issue_date->toDateString())->toBe('2026-10-30')
+        ->and($priority->code)->toBe('P001');
+});
+
+it('uses one instant for the code day, issued_at and issue_date', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $this->travelTo('2026-10-29 23:59:59');
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-10-29')
+        ->and($ticket->issued_at->toDateString())->toBe('2026-10-29')
+        ->and($ticket->code)->toBe('N001');
+});
+
+it('uses the queue custom prefix when issuing', function () {
+    $queue = Queue::factory()->create([
+        'is_active' => true,
+        'priority_prefix_map' => ['0' => 'X'],
+    ]);
+
+    expect((new IssueTicket)($queue, 0)->code)->toBe('X001')
+        ->and((new IssueTicket)($queue, 10)->code)->toBe('P001');
+});
+
+it('exposes issue_date as a date', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->fresh()->issue_date->toDateString())->toBe(now()->toDateString());
+});
+
+it('derives issue_date from issued_at in the factory', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create(['issued_at' => '2026-09-28 10:00:00']);
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-09-28');
+});
+
+it('allocates a factory code for the issued_at day even when today has the same prefix', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $today = (new IssueTicket)($queue);
+    $past = Ticket::factory()->for($queue)->create(['issued_at' => '2026-09-28 10:00:00']);
+
+    expect($today->code)->toBe('N001')
+        ->and($past->code)->toBe('N001');
+});
+
+it('allocates factory codes from the ticket priority', function () {
+    $queue = Queue::factory()->create();
+
+    $priority = Ticket::factory()->for($queue)->create(['priority' => 10]);
+    $elder = Ticket::factory()->for($queue)->create(['priority' => 20]);
+
+    expect($priority->code)->toBe('P001')
+        ->and($elder->code)->toBe('E001');
+});
+
+it('keeps explicit factory codes', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create(['code' => 'N999']);
+
+    expect($ticket->code)->toBe('N999');
+});
diff --git a/tests/Feature/UpdateQueuePriorityPrefixMapTest.php b/tests/Feature/UpdateQueuePriorityPrefixMapTest.php
new file mode 100644
index 0000000..06c3ab7
--- /dev/null
+++ b/tests/Feature/UpdateQueuePriorityPrefixMapTest.php
@@ -0,0 +1,93 @@
+<?php
+
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function queueWithOwner(array $attributes = []): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create($attributes);
+
+    return [$queue, $owner];
+}
+
+it('stores a valid priority prefix map for owner and admin', function () {
+    [$queue, $owner] = queueWithOwner();
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X', '10' => 'Y', '20' => 'Z']);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z'])
+        ->and($queue->fresh()->prefixForPriority(10))->toBe('Y');
+});
+
+it('leaves the map unchanged when the parameter is omitted', function () {
+    [$queue, $owner] = queueWithOwner(['priority_prefix_map' => ['0' => 'X']]);
+
+    (new UpdateQueue)($queue, $owner, name: 'Renomeada');
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X'])
+        ->and($queue->fresh()->name)->toBe('Renomeada');
+});
+
+it('clears the map back to the default when given an empty array', function () {
+    [$queue, $owner] = queueWithOwner(['priority_prefix_map' => ['0' => 'X']]);
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: []);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull()
+        ->and($queue->fresh()->prefixForPriority(0))->toBe('N');
+});
+
+it('rejects an invalid map with a validation error and leaves the queue unchanged', function () {
+    [$queue, $owner] = queueWithOwner(['name' => 'Original', 'priority_prefix_map' => ['0' => 'X']]);
+
+    $error = null;
+
+    try {
+        (new UpdateQueue)($queue, $owner, name: 'Alterada', priorityPrefixMap: ['0' => 'N', '10' => 'N']);
+    } catch (ValidationException $e) {
+        $error = $e;
+    }
+
+    expect($error)->not->toBeNull()
+        ->and($error->errors())->toHaveKey('priority_prefix_map')
+        ->and($queue->name)->toBe('Original')
+        ->and($queue->priority_prefix_map)->toBe([0 => 'X'])
+        ->and($queue->fresh())
+        ->name->toBe('Original')
+        ->priority_prefix_map->toBe([0 => 'X']);
+});
+
+it('rejects a map that merges normal with 80+ with a validation error', function () {
+    [$queue, $owner] = queueWithOwner();
+
+    expect(fn () => (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'E']))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('denies a map change to employees and non-members', function () {
+    [$queue] = queueWithOwner();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($employee)->employee()->create();
+    $outsider = User::factory()->create();
+
+    expect(fn () => (new UpdateQueue)($queue, $employee, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(fn () => (new UpdateQueue)($queue, $outsider, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
