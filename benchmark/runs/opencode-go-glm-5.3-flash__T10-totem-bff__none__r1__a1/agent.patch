+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function issueScopedPreset(int $queueCount = 1): array
+{
+    $preset = TotemPreset::factory()->create();
+    $queues = Queue::factory()->count($queueCount)->create(['entity_id' => $preset->entity_id]);
+    $preset->queues()->attach($queues->pluck('id'));
+
+    $totem = Totem::factory()->create(['entity_id' => $preset->entity_id]);
+    $token = TotemJwt::issue($totem->id, $totem->entity_id, $preset->id, $queues->pluck('id')->all())['token'];
+
+    return [$preset, $queues, $totem, $token];
+}
+
+it('issues totem-channel tickets with sequential queue codes', function () {
+    [$preset, $queues, $totem, $token] = issueScopedPreset(1);
+    $queue = $queues->first();
+
+    $response = $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/{$queue->slug}/ticket", ['priority' => 10]);
+
+    $response->assertStatus(201)
+        ->assertJsonPath('slug', 'A001')
+        ->assertJsonPath('queue.slug', $queue->slug)
+        ->assertJsonPath('queue.label', $queue->name)
+        ->assertJsonPath('priority.value', 10)
+        ->assertJsonPath('priority.label', 'Prioritário');
+
+    expect($response->json('issued_at'))->toMatch('/^20\d\d-\d\d-\d\dT\d\d:\d\d:\d\d(\.\d+)?(Z|[+-]\d\d:\d\d)$/');
+
+    $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(201)
+        ->assertJsonPath('slug', 'A002')
+        ->assertJsonPath('priority.label', 'Normal');
+
+    $tickets = Ticket::query()->get();
+
+    expect($tickets->count())->toBe(2)
+        ->and($tickets->where('code', 'A001')->first()->channel)->toBe(TicketChannel::Totem)
+        ->and($tickets->where('code', 'A001')->first()->priority)->toBe(10);
+});
+
+it('answers 422 invalid_priority and creates nothing for unknown values', function () {
+    [$preset, $queues, $totem, $token] = issueScopedPreset(1);
+    $queue = $queues->first();
+
+    foreach ([5, 30, '10', null, 1.5, -1] as $priority) {
+        $this->withToken($token)
+            ->postJson("/api/{$preset->entity->slug}/{$queue->slug}/ticket", ['priority' => $priority])
+            ->assertStatus(422)
+            ->assertJsonPath('code', 'invalid_priority');
+    }
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 422 inactive_queue and creates nothing', function () {
+    [$preset, $queues, $totem, $token] = issueScopedPreset(1);
+    $queues->first()->update(['is_active' => false]);
+
+    $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/{$queues->first()->slug}/ticket", ['priority' => 0])
+        ->assertStatus(422)
+        ->assertJsonPath('code', 'inactive_queue');
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('keeps scope on issuance: 403 out-of-preset, 404 foreign queue, 403 foreign entity', function () {
+    [$preset, $queues, $totem, $token] = issueScopedPreset(1);
+
+    $outOfPreset = Queue::factory()->create(['entity_id' => $preset->entity->id]);
+    $foreign = Queue::factory()->for(Entity::factory()->create())->create();
+
+    $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/{$outOfPreset->slug}/ticket", ['priority' => 0])
+        ->assertForbidden()->assertJsonPath('code', 'forbidden');
+
+    $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/{$foreign->slug}/ticket", ['priority' => 0])
+        ->assertStatus(404)->assertJsonPath('code', 'queue_not_found');
+
+    $this->withToken($token)
+        ->postJson("/api/{$foreign->entity->slug}/{$foreign->slug}/ticket", ['priority' => 0])
+        ->assertForbidden()->assertJsonPath('code', 'forbidden');
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('rate-limits issuance at thirty per minute as JSON', function () {
+    [$preset, $queues, $totem, $token] = issueScopedPreset(1);
+    $queue = $queues->first();
+
+    for ($i = 1; $i <= 30; $i++) {
+        $this->withToken($token)
+            ->postJson("/api/{$preset->entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+            ->assertStatus(201);
+    }
+
+    $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(429)
+        ->assertJsonPath('code', 'rate_limited');
+});
+
+it('issues through the same domain action as every other channel', function () {
+    [$preset, $queues, $totem, $token] = issueScopedPreset(1);
+
+    // The domain action remains the single issuance primitive.
+    $action = (new IssueTicket)($queues->first(), 20, TicketChannel::Virtual);
+
+    $response = $this->withToken($token)
+        ->postJson("/api/{$preset->entity->slug}/{$queues->first()->slug}/ticket", ['priority' => 0]);
+
+    $response->assertStatus(201)->assertJsonPath('slug', 'A002');
+
+    expect($response->json('slug'))->toBe(Ticket::query()->find($action->id + 1)->code);
+});
