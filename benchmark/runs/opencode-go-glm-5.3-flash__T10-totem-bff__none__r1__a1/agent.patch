         $middleware->prependToGroup('web', SetLocaleFromBrowser::class);
+
+        // CORS on api/* follows config/cors.php: the totem web build only
+        // gets localhost/127.0.0.1 (any scheme/port) + TOTEM_WEB_ORIGIN.
     })
