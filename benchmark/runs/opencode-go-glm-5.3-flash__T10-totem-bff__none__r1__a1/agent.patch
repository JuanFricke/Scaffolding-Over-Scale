+<?php
+
+namespace Database\Factories;
+
+use App\Models\Entity;
+use App\Models\TotemPreset;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<TotemPreset>
+ */
+class TotemPresetFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * Ready to pair by default: entity is created automatically and the preset
+     * carries a fresh, unconsumed, unexpired 6-digit login code.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'entity_id' => Entity::factory(),
+            'name' => 'Totem '.fake()->unique()->words(2, true),
+            'login_code' => $this->freshCode(),
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+            'appearance' => null,
+            'is_active' => true,
+        ];
+    }
+
+    /**
+     * Cryptographically random 6 digits (zero-padded).
+     */
+    private function freshCode(): string
+    {
+        return str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+    }
+}
