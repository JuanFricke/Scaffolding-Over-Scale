+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TotemPriority;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemTicketController extends TotemController
+{
+    /**
+     * Issue a ticket in an in-scope queue with a backend-owned priority.
+     *
+     * Rules live in App\Actions\IssueTicket (same domain action the other
+     * channels use, channel `totem`); this endpoint only translates the API
+     * contract around it. `422 {"code":"inactive_queue"}` and the sequential
+     * per-queue codes (A001, A002, …) all come from the action.
+     */
+    public function issue(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $entity = $this->resolveEntity($request, $entity);
+        $queue = $this->resolveQueue($request, $entity, $queue);
+
+        $priority = $request->input('priority');
+
+        if (! is_int($priority) || ! TotemPriority::isAllowed($priority)) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        $ticket = (new IssueTicket)($queue, $priority, TicketChannel::Totem);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priority' => [
+                'value' => $priority,
+                'label' => TotemPriority::from($priority)->label(),
+            ],
+            'issued_at' => $ticket->issued_at->toISOString(),
+        ], 201);
+    }
+}
diff --git a/app/Http/Middleware/TotemAuth.php b/app/Http/Middleware/TotemAuth.php
new file mode 100644
index 0000000..7c93c41
--- /dev/null
+++ b/app/Http/Middleware/TotemAuth.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Exceptions\TotemAuthenticationException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Totem BFF bearer-token gate.
+ *
+ * Validates the JWT signature/claims and re-checks device + preset state
+ * against the database on every call: missing/invalid/expired token, totem or
+ * preset gone/inactive, or claims-vs-database entity mismatch all fail the
+ * same way (`401 {"code":"invalid_token"}`) to avoid oracles. Refreshes the
+ * device heartbeat (`last_seen_at`) on success.
+ */
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            throw new TotemAuthenticationException('Missing totem bearer token.');
+        }
+
+        $claims = TotemJwt::decode($token);
+
+        $totem = Totem::query()->find($claims['totem_id']);
+        $preset = TotemPreset::query()->find($claims['preset_id']);
+
+        $valid =
+            $totem !== null
+            && $totem->is_active
+            && (int) $totem->entity_id === (int) $claims['entity_id']
+            && $preset !== null
+            && $preset->is_active
+            && (int) $preset->entity_id === (int) $claims['entity_id'];
+
+        if (! $valid) {
+            throw new TotemAuthenticationException('Invalid totem token.');
+        }
+
+        // Effective queue scope = JWT queues claim ∩ preset's current join, so
+        // detaching a queue takes effect immediately for existing tokens.
+        $scope = $preset->queues()->pluck('queues.id')->all();
+        $scope = array_values(array_intersect($scope, array_map(intval(...), $claims['queues'])));
+
+        $request->attributes->set('totem.claims', $claims);
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem.preset', $preset);
+        $request->attributes->set('totem.queue_ids', $scope);
+
+        $totem->touchLastSeen();
+
+        return $next($request);
+    }
+}
