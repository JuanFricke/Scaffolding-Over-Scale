+<?php
+
+return [
+
+    /*
+    |--------------------------------------------------------------------------
+    | Totem BFF CORS
+    |--------------------------------------------------------------------------
+    |
+    | The totem's web build runs on a local static server in development. Only
+    | `localhost` / `127.0.0.1` (any scheme/port) and an optional exact
+    | `TOTEM_WEB_ORIGIN` may call `api/*`; every other origin gets **no**
+    | `Access-Control-Allow-Origin` at all. No cookies/credentials are ever
+    | granted — the bearer JWT is the credential.
+    |
+    */
+
+    'paths' => ['api/*'],
+
+    'allowed_methods' => ['*'],
+
+    'allowed_origins' => array_values(array_filter([
+        env('TOTEM_WEB_ORIGIN'),
+    ], fn ($origin) => is_string($origin) && $origin !== '')),
+
+    // http(s)://localhost[:port] and http(s)://127.0.0.1[:port].
+    'allowed_origins_patterns' => [
+        '~^https?://(localhost|127\.0\.0\.1)(:\d+)?$~i',
+    ],
+
+    'allowed_headers' => ['Accept', 'Authorization', 'Content-Type'],
+
+    'exposed_headers' => [],
+
+    'max_age' => 600,
+
+    'supports_credentials' => false,
+
+];
