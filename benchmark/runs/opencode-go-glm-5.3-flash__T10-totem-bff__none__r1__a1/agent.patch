         );
+
+        // Totem BFF contract: explicit machine codes, no oracles.
+        $exceptions->render(function (TotemApiException $e, Request $request) {
+            return response()->json(['code' => $e->errorCode()], $e->statusCode());
+        });
+
+        $exceptions->render(function (TotemAuthenticationException $e, Request $request) {
+            if ($request->is('api/*')) {
