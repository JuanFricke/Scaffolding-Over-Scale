@@ -0,0 +1,54 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Opens a pairing window for a totem preset: generates the preset's own
+ * cryptographically random, single-use 6-digit code, valid for 10 minutes.
+ *
+ * Regenerating replaces the previous code (and clears `consumed_at`), so the
+ * old code stops working immediately. The code is printed for the operator
+ * and never written to any log; the audit trail records the generation only.
+ */
+class TotemPairingCode extends Command
+{
+    protected $signature = 'totem:pairing-code {preset : Preset id}';
+
+    protected $description = 'Generate a 6-digit pairing code for a totem preset (valid 10 minutes)';
+
+    private const CODE_TTL_MINUTES = 10;
+
+    public function handle(): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if ($preset === null) {
+            $this->error('Unknown totem preset id. Use an existing totem_presets.id.');
+
+            return Command::FAILURE;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(self::CODE_TTL_MINUTES),
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        Log::channel('audit')->info('totem.pairing_code.generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $preset->login_code_expires_at->toIso8601String(),
+        ]);
+
+        $this->line("Pairing code for preset [{$preset->id}] {$preset->name}: <fg=green>{$code}</>");
+        $this->line('Enter it on the totem within 10 minutes. It is single-use.');
+
+        return Command::SUCCESS;
+    }
+}
