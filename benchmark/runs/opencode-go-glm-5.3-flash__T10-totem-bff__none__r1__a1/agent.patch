+
+namespace App\Exceptions;
+
+/**
+ * Queue slug not found within the token entity (including another entity's
+ * queue — same answer, no oracle).
+ */
+class TotemQueueNotFoundException extends TotemApiException
+{
+    public function __construct()
+    {
+        parent::__construct('Queue not found within the token entity.');
+    }
+
+    public function errorCode(): string
+    {
+        return 'queue_not_found';
+    }
+
+    public function statusCode(): int
+    {
+        return 404;
+    }
+}
diff --git a/app/Http/Controllers/Totem/TotemAuthController.php b/app/Http/Controllers/Totem/TotemAuthController.php
new file mode 100644
index 0000000..ffe8764
--- /dev/null
+++ b/app/Http/Controllers/Totem/TotemAuthController.php
@@ -0,0 +1,101 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    /**
+     * Exchange a single-use 6-digit pairing code for a bearer JWT.
+     *
+     * Unknown, expired, already consumed, and inactive-preset codes all get
+     * the same `401 {"code":"invalid_pairing_code"}` — no oracle. Pairing is
+     * atomic: the code is consumed and the device row created in one
+     * transaction holding the preset row lock.
+     */
+    public function login(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || preg_match('/^\d{6}$/', $code) !== 1) {
+            Log::channel('audit')->info('totem.pairing.rejected', ['reason' => 'invalid_code_format']);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $result = DB::transaction(function () use ($code): ?array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            $valid =
+                $preset !== null
+                && $preset->is_active
+                && $preset->login_code_consumed_at === null
+                && $preset->login_code_expires_at !== null
+                && $preset->login_code_expires_at->isFuture();
+
+            if (! $valid) {
+                return null;
+            }
+
+            $preset->consumeLoginCode();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $jwt = TotemJwt::issue(
+                $totem->id,
+                (int) $preset->entity_id,
+                (int) $preset->id,
+                $preset->queues()->pluck('queues.id')->all(),
+            );
+
+            $entity = $preset->entity;
+
+            return [
+                'preset' => $preset,
+                'totem' => $totem,
+                'jwt' => $jwt,
+                'entity' => $entity,
+            ];
+        });
+
+        if ($result === null) {
+            // One shared failure answer: unknown, mismatched, expired,
+            // consumed or inactive preset. Never log the code itself.
+            Log::channel('audit')->info('totem.pairing.rejected', ['reason' => 'invalid_pairing_code']);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        Log::channel('audit')->info('totem.pairing.succeeded', [
+            'preset_id' => $result['preset']->id,
+            'entity_id' => $result['preset']->entity_id,
+            'totem_id' => $result['totem']->id,
+        ]);
+
+        return response()->json([
+            'token' => $result['jwt']['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => $result['jwt']['expires_in'],
+            'entity' => [
+                'slug' => $result['entity']->slug,
+                'name' => $result['entity']->name,
+            ],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Totem/TotemController.php b/app/Http/Controllers/Totem/TotemController.php
new file mode 100644
index 0000000..d9839bd
--- /dev/null
+++ b/app/Http/Controllers/Totem/TotemController.php
@@ -0,0 +1,82 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Exceptions\TotemForbiddenException;
+use App\Exceptions\TotemQueueNotFoundException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Http\Request;
+
+/**
+ * Shared plumbing for the authenticated totem endpoints: request attributes
+ * filled by TotemAuth plus entity/queue path resolution.
+ *
+ * Path contract: {entity} must equal the token's entity (else 403
+ * `forbidden`) and {queue} resolves within that entity only — unknown
+ * (including another entity's slug) → 404 `queue_not_found`, found but
+ * outside the effective preset scope → 403 `forbidden`.
+ */
+abstract class TotemController extends Controller
+{
+    /**
+     * JWT claims of the current call.
+     *
+     * @return array<string, mixed>
+     */
+    protected function claims(Request $request): array
+    {
+        return $request->attributes->get('totem.claims');
+    }
+
+    protected function totem(Request $request): Totem
+    {
+        return $request->attributes->get('totem');
+    }
+
+    protected function preset(Request $request): TotemPreset
+    {
+        return $request->attributes->get('totem.preset');
+    }
+
+    /**
+     * Effective queue scope: JWT `queues` claim ∩ preset's current join.
+     *
+     * @return list<int>
+     */
+    protected function queueScope(Request $request): array
+    {
+        return array_map(intval(...), (array) $request->attributes->get('totem.queue_ids'));
+    }
+
+    protected function resolveEntity(Request $request, string $entitySlug): Entity
+    {
+        $claims = $this->claims($request);
+
+        $entity = Entity::query()->where('slug', $entitySlug)->first();
+
+        if ($entity === null || (int) $entity->id !== (int) $claims['entity_id']) {
+            throw new TotemForbiddenException;
+        }
+
+        return $entity;
+    }
+
+    protected function resolveQueue(Request $request, Entity $entity, string $queueSlug): Queue
+    {
+        $queue = $entity->queues()->where('slug', $queueSlug)->first();
+
+        if ($queue === null) {
+            throw new TotemQueueNotFoundException;
+        }
+
+        if (! in_array((int) $queue->id, $this->queueScope($request), true)) {
+            throw new TotemForbiddenException;
+        }
+
+        return $queue;
+    }
+}
