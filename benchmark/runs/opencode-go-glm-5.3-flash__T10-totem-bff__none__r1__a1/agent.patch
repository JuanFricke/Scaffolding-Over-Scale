@@ -0,0 +1,49 @@
+<?php
+
+namespace App\Models;
+
+use Database\Factories\TotemFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+/**
+ * One physical totem device paired to an entity via a preset login code.
+ *
+ * The JWT is the runtime credential for the row; revocation for existing
+ * tokens = `is_active = false` (+ JWT expiry).
+ */
+#[Fillable(['entity_id', 'name', 'is_active', 'last_seen_at'])]
+class Totem extends Model
+{
+    /** @use HasFactory<TotemFactory> */
+    use HasFactory;
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'is_active' => 'boolean',
+            'last_seen_at' => 'datetime',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Update the heartbeat without touching `updated_at`.
+     */
+    public function touchLastSeen(): void
+    {
+        $this->forceFill(['last_seen_at' => now()])->saveQuietly();
+    }
+}
