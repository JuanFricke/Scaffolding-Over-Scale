--- /dev/null
+++ b/routes/api.php
@@ -0,0 +1,29 @@
+<?php
+
+use App\Http\Controllers\Totem\TotemAuthController;
+use App\Http\Controllers\Totem\TotemQueueController;
+use App\Http\Controllers\Totem\TotemTicketController;
+use Illuminate\Support\Facades\Route;
+
+// Totem BFF (pegafila_totem Flutter client). api/* paths answer CORS per
+// config/cors.php (localhost/127.0.0.1 + optional TOTEM_WEB_ORIGIN); no ACA is
+// ever sent for other origins.
+
+// Pairing login: 10 attempts/minute, JSON rate-limit errors.
+Route::post('totem/auth', [TotemAuthController::class, 'login'])
+    ->middleware('throttle:10,1')
+    ->name('totem.auth');
+
+Route::middleware('totem.auth')
+    ->group(function () {
+        Route::get('{entity}/queues', [TotemQueueController::class, 'queues'])
+            ->name('totem.queues');
+
+        Route::get('{entity}/{queue}/priorities', [TotemQueueController::class, 'priorities'])
+            ->name('totem.priorities');
+
+        // Ticket issuance: 30 attempts/minute.
+        Route::post('{entity}/{queue}/ticket', [TotemTicketController::class, 'issue'])
+            ->middleware('throttle:30,1')
+            ->name('totem.ticket');
+    });
diff --git a/tests/Feature/TotemAuthMiddlewareTest.php b/tests/Feature/TotemAuthMiddlewareTest.php
new file mode 100644
index 0000000..2b61c9c
--- /dev/null
+++ b/tests/Feature/TotemAuthMiddlewareTest.php
@@ -0,0 +1,141 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function bearerSetup(array $totemAttributes = [], array $presetAttributes = []): TotemPreset
+{
+    $preset = TotemPreset::factory()->create($presetAttributes);
+    Totem::factory()->create(array_merge(['entity_id' => $preset->entity_id], $totemAttributes));
+
+    return $preset;
+}
+
+function mismatchedToken(TotemPreset $preset, Totem $totem, array $claimsOverrides = []): string
+{
+    // A validly-signed token whose claims deliberately disagree with the rows.
+    $claimsOverrides = array_merge([
+        'totem_id' => $totem->id,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+    ], $claimsOverrides);
+
+    return TotemJwt::issue(
+        $claimsOverrides['totem_id'],
+        $claimsOverrides['entity_id'],
+        $claimsOverrides['preset_id'],
+        $claimsOverrides['queues'],
+    )['token'];
+}
+
+it('answers 401 invalid_token for missing, malformed or expired tokens', function () {
+    $this->getJson('/api/whatever/queues')
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_token');
+
+    $this->withToken('not-a-jwt')->getJson('/api/whatever/queues')
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_token');
+});
+
+it('answers 401 invalid_token for an expired bearer token', function () {
+    $preset = bearerSetup();
+
+    $secret = config('services.totem.jwt_secret');
+    $encode = fn (array $v) => rtrim(strtr(base64_encode((string) json_encode($v)), '+/', '-_'), '=');
+
+    $header = $encode(['alg' => 'HS256', 'typ' => 'JWT']);
+    $payload = $encode([
+        'totem_id' => 1,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+        'iat' => now()->timestamp - 7200,
+        'exp' => now()->timestamp - 3600,
+        'jti' => 'expired',
+    ]);
+    $signature = rtrim(strtr(base64_encode(hash_hmac('sha256', "$header.$payload", $secret, true)), '+/', '-_'), '=');
+
+    $this->withToken("$header.$payload.$signature")
+        ->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertJsonPath('code', 'invalid_token');
+});
+
+it('rejects tokens for inactive devices or presets', function () {
+    $preset = bearerSetup(['is_active' => false]);
+
+    $token = mismatchedToken($preset, Totem::query()->sole());
+
+    $this->withToken($token)->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_token');
+
+    $presetActive = bearerSetup([], ['is_active' => false]);
+    $token = mismatchedToken($presetActive, Totem::query()->findOrFail(2));
+
+    $this->withToken($token)->getJson("/api/{$presetActive->entity->slug}/queues")
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_token');
+});
+
+it('rejects claim/row mismatches for totem, entity and preset', function () {
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->create(['entity_id' => $preset->entity_id]);
+
+    // Unknown totem id.
+    $auth = mismatchedToken($preset, $totem, ['totem_id' => 999999]);
+    $this->withToken($auth)->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_token');
+
+    // Unknown preset id.
+    $auth = mismatchedToken($preset, $totem, ['preset_id' => 999999]);
+    $this->withToken($auth)->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_token');
+
+    // Entity claim disagrees with totem's row.
+    $foreignEntity = Entity::factory()->create();
+    $auth = mismatchedToken($preset, $totem, ['entity_id' => $foreignEntity->id]);
+    $this->withToken($auth)->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_token');
+});
+
+it('refreshes last_seen_at on every authenticated call', function () {
+    $preset = bearerSetup(['last_seen_at' => now()->subMinutes(10)]);
+    $totem = Totem::query()->sole();
+    $before = $totem->last_seen_at;
+
+    $token = TotemJwt::issue($totem->id, $totem->entity_id, $preset->id, [])['token'];
+
+    $this->withToken($token)->getJson("/api/{$preset->entity->slug}/queues")->assertOk();
+
+    $totem = $totem->fresh();
+
+    expect($totem->last_seen_at)->toBeGreaterThan(now()->subSecond());
+});
+
+it('is case-insensitive to the Bearer scheme but not to the payload', function () {
+    $preset = bearerSetup();
+    $totem = Totem::query()->sole();
+    $token = TotemJwt::issue($totem->id, $totem->entity_id, $preset->id, [])['token'];
+
+    $this->withHeader('Authorization', "Bearer $token")
+        ->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertOk();
+
+    // One flipped character breaks the signature, regardless of scheme.
+    $tampered = preg_replace_callback(
+        '/[A-Za-z_-]/',
+        fn ($m) => $m[0] === 'a' ? 'b' : 'a',
+        $token,
+        1,
+    );
+
+    expect($tampered)->not->toBe($token);
+
+    $this->withHeader('Authorization', "Bearer $tampered")
+        ->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_token');
+});
diff --git a/tests/Feature/TotemCorsTest.php b/tests/Feature/TotemCorsTest.php
new file mode 100644
index 0000000..aa65291
--- /dev/null
+++ b/tests/Feature/TotemCorsTest.php
@@ -0,0 +1,87 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function corsToken(): array
+{
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->create(['entity_id' => $preset->entity_id]);
+    $preset->queues()->attach($queue->id);
+
+    $totem = Totem::factory()->create(['entity_id' => $preset->entity_id]);
+
+    return [
+        $preset,
+        TotemJwt::issue($totem->id, $totem->entity_id, $preset->id, [$queue->id])['token'],
+    ];
+}
+
+it('preflights from localhost origins with a matching ACA', function () {
+    foreach (['http://localhost:8081', 'http://localhost', 'https://127.0.0.1:5000', 'http://127.0.0.1:3000'] as $origin) {
+        $response = $this->options('/api/totem/auth', [], [
+            'Origin' => $origin,
+            'Access-Control-Request-Method' => 'POST',
+            'Access-Control-Request-Headers' => 'Authorization, Content-Type',
+        ]);
+
+        $response->assertStatus(204)
+            ->assertHeader('Access-Control-Allow-Origin', $origin)
+            ->assertHeaderMissing('Access-Control-Allow-Credentials');
+
+        expect(str_contains(strtolower((string) $response->headers->get('Access-Control-Allow-Methods')), 'post'))->toBeTrue()
+            ->and(str_contains(strtolower((string) $response->headers->get('Access-Control-Allow-Headers')), 'authorization'))->toBeTrue();
+    }
+});
+
+it('preflights from a configured extra origin', function () {
+    config()->set('cors.allowed_origins', ['https://totem.example.org']);
+
+    $this->options('/api/totem/auth', [], [
+        'Origin' => 'https://totem.example.org',
+        'Access-Control-Request-Method' => 'POST',
+    ])
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem.example.org');
+});
+
+it('sends no ACA for other origins', function () {
+    foreach (['https://example.org', 'http://evil.localhost.example', 'http://localhost.evil.com'] as $origin) {
+        $response = $this->options('/api/totem/auth', [], ['Origin' => $origin]);
+
+        expect($response->status())->toBeIn([200, 204])
+            ->and($response->headers->get('Access-Control-Allow-Origin'))->toBeNull()
+            ->and($response->headers->has('Access-Control-Allow-Headers'))->toBeFalse();
+    }
+});
+
+it('answers actual api calls with ACA only for allowed origins', function () {
+    [$preset, $token] = corsToken();
+
+    $allowed = $this->withHeaders([
+        'Origin' => 'http://localhost:8081',
+        'Authorization' => "Bearer {$token}",
+    ])->getJson("/api/{$preset->entity->slug}/queues");
+
+    $allowed->assertOk()
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+
+    $denied = $this->withHeaders([
+        'Origin' => 'https://example.org',
+        'Authorization' => "Bearer {$token}",
+    ])->getJson("/api/{$preset->entity->slug}/queues");
+
+    $denied->assertOk()
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+});
+
+it('does not leak ACA onto non-api paths', function () {
+    $response = $this->options('/', [], ['Origin' => 'http://localhost:8081']);
+
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+});
diff --git a/tests/Feature/TotemJwtTest.php b/tests/Feature/TotemJwtTest.php
new file mode 100644
index 0000000..1ac0d22
--- /dev/null
+++ b/tests/Feature/TotemJwtTest.php
@@ -0,0 +1,66 @@
+<?php
+
+use App\Exceptions\TotemAuthenticationException;
+use App\Services\TotemJwt;
+
+// JWT plumbing is appless (no DB) but the secret/ttl come from config, so this
+// file runs under the Laravel TestCase without RefreshDatabase.
+
+it('round-trips claims through an HS256 token', function () {
+    ['token' => $token, 'expires_in' => $ttl] = TotemJwt::issue(11, 22, 33, [441, 442]);
+
+    $claims = TotemJwt::decode($token);
+
+    expect($ttl)->toBe(3600)
+        ->and($token)->toMatch('/^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/')
+        ->and($claims)->toMatchArray([
+            'totem_id' => 11,
+            'entity_id' => 22,
+            'preset_id' => 33,
+            'queues' => [441, 442],
+        ])
+        ->and($claims['exp'] - $claims['iat'])->toBe(3600)
+        ->and($claims['jti'])->toBeString();
+});
+
+it('carries a HS256 + JWT header and signs verifiable bodies', function () {
+    ['token' => $token] = TotemJwt::issue(1, 2, 3, []);
+
+    [$headerSegment, $payloadSegment, $signatureSegment] = explode('.', $token);
+    $secret = config('services.totem.jwt_secret');
+
+    expect(json_decode(base64_decode($headerSegment, true), true))
+        ->toBe(['alg' => 'HS256', 'typ' => 'JWT']);
+
+    $expected = hash_hmac('sha256', $headerSegment.'.'.$payloadSegment, $secret, true);
+    $signature = base64_decode(strtr($signatureSegment, '-_', '+/'));
+
+    expect(hash_equals($expected, $signature))->toBeTrue();
+});
+
+it('refuses tampered payloads, wrong algorithms and expired tokens', function () {
+    ['token' => $token] = TotemJwt::issue(1, 2, 3, []);
+    [$header, $payload, $signature] = explode('.', $token);
+    $secret = config('services.totem.jwt_secret');
+    $encode = fn (array $v) => rtrim(strtr(base64_encode((string) json_encode($v)), '+/', '-_'), '=');
+    $sign = fn (string $h, string $p) => rtrim(strtr(base64_encode(hash_hmac('sha256', "$h.$p", $secret, true)), '+/', '-_'), '=');
+
+    // Tampered claims with the old signature still attached.
+    $tampered = substr_replace($payload, ($payload[5] === 'A' ? 'B' : 'A'), 5, 1);
+    expect($tampered)->not->toBe($payload)
+        ->and(fn () => TotemJwt::decode("$header.$tampered.$signature"))
+        ->toThrow(TotemAuthenticationException::class);
+
+    // Different algorithm header.
+    $wrongAlg = $encode(['alg' => 'none', 'typ' => 'JWT']);
+    expect(fn () => TotemJwt::decode("$wrongAlg.$payload.".$sign($wrongAlg, $payload)))
+        ->toThrow(TotemAuthenticationException::class);
+
+    // Expired.
+    $expired = $encode([
+        'totem_id' => 1, 'entity_id' => 2, 'preset_id' => 3, 'queues' => [],
+        'iat' => now()->timestamp - 7200, 'exp' => now()->timestamp - 3600, 'jti' => 'x',
+    ]);
+    expect(fn () => TotemJwt::decode("$header.$expired.".$sign($header, $expired)))
+        ->toThrow(TotemAuthenticationException::class);
+});
diff --git a/tests/Feature/TotemPairingTest.php b/tests/Feature/TotemPairingTest.php
new file mode 100644
index 0000000..89b7002
--- /dev/null
+++ b/tests/Feature/TotemPairingTest.php
@@ -0,0 +1,168 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function presetWithCode(string $code, array $attributes = []): TotemPreset
+{
+    return TotemPreset::query()->forceCreate(array_merge([
+        'entity_id' => Entity::factory()->create()->id,
+        'name' => 'Entrada principal',
+        'login_code' => $code,
+        'login_code_expires_at' => now()->addMinutes(10),
+        'login_code_consumed_at' => null,
+        'is_active' => true,
+    ], $attributes));
+}
+
+it('generates a zero-padded 10-minute pairing code via artisan', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+        ->expectsOutputToContain('Pairing code for preset')
+        ->assertExitCode(0);
+
+    $preset = $preset->fresh();
+
+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_expires_at)
+        ->toBeGreaterThan(now()->addMinutes(9))
+        ->toBeLessThan(now()->addMinutes(11))
+        ->and($preset->login_code_consumed_at)->toBeNull();
+});
+
+it('fails with a non-zero exit code for an unknown preset id', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 99999])
+        ->expectsOutputToContain('Unknown totem preset id')
+        ->assertExitCode(1);
+});
+
+it('replaces a previous pairing code when regenerated', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id]);
+    $first = $preset->fresh()->login_code;
+
+    // Simulate the first code already being (wrongly) consumed, then open a new window.
+    $firstPreset = $preset->fresh();
+    $firstPreset->forceFill(['login_code_consumed_at' => now()])->save();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id]);
+
+    $fresh = $preset->fresh();
+
+    expect($fresh->login_code)->toMatch('/^\d{6}$/')
+        ->and($fresh->login_code_expires_at)->toBeGreaterThan(now()->addMinutes(9))
+        ->and($fresh->login_code_consumed_at)->toBeNull();
+
+    // Unless the CSPRNG repeated the exact number (1:1,000,000), the previous
+    // code no longer pairs.
+    if ($fresh->login_code !== $first) {
+        $this->postJson('/api/totem/auth', ['code' => $first])
+            ->assertStatus(401)
+            ->assertJsonPath('code', 'invalid_pairing_code');
+    }
+});
+
+it('pairs and returns a bearer JWT with the entity pair', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonStructure(['token', 'token_type', 'expires_in', 'entity' => ['slug', 'name']])
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $preset->entity->slug)
+        ->assertJsonPath('entity.name', $preset->entity->name);
+
+    $preset = $preset->fresh();
+
+    expect($preset->login_code_consumed_at)->not->toBeNull();
+
+    $totem = Totem::query()->sole();
+    expect($totem->entity_id)->toBe($preset->entity_id)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull();
+
+    $claims = TotemJwt::decode($response->json('token'));
+
+    expect($claims['totem_id'])->toBe($totem->id)
+        ->and($claims['entity_id'])->toBe($preset->entity_id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['queues'])->toBe([])
+        ->and($claims['exp'])->toBe($claims['iat'] + 3600);
+});
+
+it('carries the preset queue ids in the JWT queues claim', function () {
+    $preset = TotemPreset::factory()->create();
+    $queues = Queue::factory()->count(2)->create(['entity_id' => $preset->entity_id]);
+    $preset->queues()->attach($queues->pluck('id'));
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertOk();
+
+    $claims = TotemJwt::decode($response->json('token'));
+
+    expect($claims['queues'])->toEqualCanonicalizing($queues->pluck('id')->all());
+});
+
+it('answers 400 invalid_code_format for anything that is not six digits', function () {
+    foreach (['', '12345', '1234567', '12a456', '12345 ', '123 456', 123456] as $code) {
+        $this->postJson('/api/totem/auth', ['code' => $code])
+            ->assertStatus(400)
+            ->assertJsonPath('code', 'invalid_code_format');
+    }
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('answers 401 for unknown, expired, consumed and inactive presets without an oracle', function () {
+    // Unknown code.
+    $this->postJson('/api/totem/auth', ['code' => '999999'])
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_pairing_code');
+
+    // Expired.
+    $preset = presetWithCode('111111', ['login_code_expires_at' => now()->subMinutes(10)]);
+    $this->postJson('/api/totem/auth', ['code' => '111111'])
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_pairing_code');
+
+    // Already consumed.
+    $consumed = presetWithCode('222222', ['login_code_consumed_at' => now()]);
+    $this->postJson('/api/totem/auth', ['code' => '222222'])
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_pairing_code');
+
+    // Inactive preset.
+    $inactive = presetWithCode('333333', ['is_active' => false]);
+    $this->postJson('/api/totem/auth', ['code' => '333333'])
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_pairing_code');
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('refuses to reuse a single-use code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)->assertJsonPath('code', 'invalid_pairing_code');
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('rate-limits pairing attempts as JSON', function () {
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '999999'])
+            ->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '999999'])
+        ->assertStatus(429)
+        ->assertJsonPath('code', 'rate_limited');
+});
diff --git a/tests/Feature/TotemQueueEndpointsTest.php b/tests/Feature/TotemQueueEndpointsTest.php
new file mode 100644
index 0000000..1f55cd5
--- /dev/null
+++ b/tests/Feature/TotemQueueEndpointsTest.php
@@ -0,0 +1,185 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Attach this many active queues to a preset, returning them freshly reloaded.
+ */
+function presetQueues(TotemPreset $preset, int $count = 2): array
+{
+    $id = $preset->entity->id;
+    $queues = [];
+
+    for ($i = 0; $i < $count; $i++) {
+        $queue = Queue::factory()->create(['entity_id' => $id, 'name' => 'Queue '.($i + 1)]);
+        $queues[] = $queue->fresh();
+    }
+
+    $preset->queues()->attach(array_column($queues, 'id'));
+
+    return $queues;
+}
+
+it('issues its own queues list limited to the preset scope, ordered by name', function () {
+    $preset = TotemPreset::factory()->create();
+    $queues = presetQueues($preset, 2);
+
+    $entity = $preset->entity;
+    $alpha = $queues[0];
+    $alpha->update(['name' => 'Alpha']);
+    $beta = $queues[1];
+    $beta->update(['name' => 'Beta']);
+
+    // Attached but inactive -> hidden; active but outside preset -> hidden.
+    $inactive = Queue::factory()->create(['entity_id' => $entity->id, 'name' => 'Aaa', 'is_active' => false]);
+    $preset->queues()->attach($inactive->id);
+    $outOfScope = Queue::factory()->create(['entity_id' => $entity->id, 'name' => 'Bbb']);
+    $anotherEntity = Queue::factory()->create();
+
+    $token = TotemJwt::issue(
+        Totem::factory()->create(['entity_id' => $entity->id])->id,
+        $entity->id,
+        $preset->id,
+        $preset->queues()->pluck('queues.id')->all(),
+    )['token'];
+
+    $response = $this->withToken($token)->getJson("/api/{$entity->slug}/queues");
+
+    $response->assertOk()
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('entity.name', $entity->name);
+
+    $payload = $response->json('queues');
+
+    $slugs = collect($payload)->pluck('slug')->all();
+    $orders = collect($payload)->pluck('visual.order')->all();
+
+    expect($payload)->toHaveCount(2)
+        ->and($slugs)->toEqualCanonicalizing([$alpha->slug, $beta->slug])
+        ->and($orders)->toBe([1, 2])
+        ->and(collect($payload)->pluck('is_active')->all())->toBe([true, true])
+        ->and(array_keys($payload[0]))->toBe(['slug', 'label', 'description', 'visual', 'is_active'])
+        ->and(array_keys($payload[0]['visual']))->toBe(['color', 'icon', 'order']);
+
+    expect(in_array($inactive->slug, $slugs))->toBeFalse()
+        ->and(in_array($outOfScope->slug, $slugs))->toBeFalse()
+        ->and(in_array($anotherEntity->slug, $slugs))->toBeFalse();
+});
+
+it('rejects queues outside the token entity', function () {
+    $preset = TotemPreset::factory()->create();
+    $other = Entity::factory()->create();
+
+    $token = TotemJwt::issue(
+        Totem::factory()->create(['entity_id' => $preset->entity->id])->id,
+        $preset->entity->id,
+        $preset->id,
+        [],
+    )['token'];
+
+    $this->withToken($token)->getJson("/api/{$other->slug}/queues")
+        ->assertForbidden()->assertJsonPath('code', 'forbidden');
+
+    $this->withToken($token)->getJson('/api/not-an-entity/queues')
+        ->assertForbidden()->assertJsonPath('code', 'forbidden');
+});
+
+it('exposes backend-owned priorities for an in-scope active queue', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = presetQueues($preset, 1)[0];
+
+    $token = TotemJwt::issue(
+        Totem::factory()->create(['entity_id' => $preset->entity->id])->id,
+        $preset->entity->id,
+        $preset->id,
+        [$queue->id],
+    )['token'];
+
+    $response = $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/{$queue->slug}/priorities");
+
+    $response->assertOk()
+        ->assertJsonPath('entity.slug', $preset->entity->slug)
+        ->assertJsonPath('queue.slug', $queue->slug)
+        ->assertJsonPath('queue.label', $queue->name);
+
+    $priorities = $response->json('priorities');
+
+    expect($priorities)->toBe([
+        ['value' => 0, 'label' => 'Normal', 'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1]],
+        ['value' => 10, 'label' => 'Prioritário', 'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2]],
+        ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => ['color' => '#8E24AA', 'icon' => 'elderly', 'order' => 3]],
+    ]);
+});
+
+it('answers inactive_queue when listing priorities of an inactive queue', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = presetQueues($preset, 1)[0];
+    $queue->update(['is_active' => false]);
+
+    $token = TotemJwt::issue(
+        Totem::factory()->create(['entity_id' => $preset->entity->id])->id,
+        $preset->entity->id,
+        $preset->id,
+        [$queue->id],
+    )['token'];
+
+    $this->withToken($token)
+        ->getJson("/api/{$preset->entity->slug}/{$queue->slug}/priorities")
+        ->assertStatus(422)
+        ->assertJsonPath('code', 'inactive_queue');
+});
+
+it('distinguishes out-of-scope (403) and foreign queues (404) on priorities', function () {
+    $preset = TotemPreset::factory()->create();
+    $entity = $preset->entity;
+    presetQueues($preset, 1);
+
+    $foreign = Queue::factory()->create(['entity_id' => Entity::factory()->create()->id]);
+    $outOfScope = Queue::factory()->create(['entity_id' => $entity->id]);
+
+    $token = TotemJwt::issue(
+        Totem::factory()->create(['entity_id' => $entity->id])->id,
+        $entity->id,
+        $preset->id,
+        [],
+    )['token'];
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/{$foreign->slug}/priorities")
+        ->assertStatus(404)->assertJsonPath('code', 'queue_not_found');
+
+    $this->withToken($token)->getJson("/api/{$entity->slug}/{$outOfScope->slug}/priorities")
+        ->assertForbidden()->assertJsonPath('code', 'forbidden');
+});
+
+it('drops a queue from the response immediately after the preset detaches it', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = presetQueues($preset, 1)[0];
+
+    $token = TotemJwt::issue(
+        Totem::factory()->create(['entity_id' => $preset->entity->id])->id,
+        $preset->entity->id,
+        $preset->id,
+        [$queue->id],
+    )['token'];
+
+    $this->withToken($token)->getJson("/api/{$preset->entity->slug}/{$queue->slug}/priorities")
+        ->assertOk();
+
+    $preset->queues()->detach($queue->id);
+
+    // Existing token, new scope: effective scope is the current join.
+    $this->withToken($token)->getJson("/api/{$preset->entity->slug}/{$queue->slug}/priorities")
+        ->assertForbidden();
+
+    $this->withToken($token)->getJson("/api/{$preset->entity->slug}/queues")
+        ->assertOk()
+        ->assertJsonCount(0, 'queues');
+});
diff --git a/tests/Feature/TotemTicketEndpointTest.php b/tests/Feature/TotemTicketEndpointTest.php
new file mode 100644
