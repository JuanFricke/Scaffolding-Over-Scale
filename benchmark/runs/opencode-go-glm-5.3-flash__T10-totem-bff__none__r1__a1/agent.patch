+<?php
+
+namespace App\Exceptions;
+
+/**
+ * Path {entity} does not match the token's entity.
+ */
+class TotemForbiddenException extends TotemApiException
+{
+    public function __construct()
+    {
+        parent::__construct('Resource does not belong to the token entity.');
+    }
+
+    public function errorCode(): string
+    {
+        return 'forbidden';
+    }
+
+    public function statusCode(): int
+    {
+        return 403;
+    }
+}
