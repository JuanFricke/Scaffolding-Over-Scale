@@ -0,0 +1,72 @@
+<?php
+
+namespace App\Models;
+
+use Database\Factories\TotemPresetFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\BelongsToMany;
+
+/**
+ * A limited totem settings bundle: which queues one paired totem may see and
+ * how it looks. A preset has its own single-use 6-digit login code; codes are
+ * never shared across presets.
+ */
+#[Fillable([
+    'entity_id',
+    'name',
+    'login_code',
+    'login_code_expires_at',
+    'login_code_consumed_at',
+    'appearance',
+    'is_active',
+])]
+class TotemPreset extends Model
+{
+    /** @use HasFactory<TotemPresetFactory> */
+    use HasFactory;
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'login_code_expires_at' => 'datetime',
+            'login_code_consumed_at' => 'datetime',
+            'appearance' => 'array',
+            'is_active' => 'boolean',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Queues this preset exposes to its paired totems (pivot = totem_preset_queue).
+     *
+     * @return BelongsToMany<Queue, $this>
+     */
+    public function queues(): BelongsToMany
+    {
+        return $this->belongsToMany(Queue::class, 'totem_preset_queue', 'preset_id', 'queue_id')
+            ->withTimestamps();
+    }
+
+    /**
+     * Consuming clears the code row so a reused/old code can never re-pair.
+     */
+    public function consumeLoginCode(): void
+    {
+        $this->forceFill([
+            'login_code_consumed_at' => now(),
+        ])->save();
+    }
+}
diff --git a/app/Services/TotemJwt.php b/app/Services/TotemJwt.php
new file mode 100644
index 0000000..9c30482
--- /dev/null
+++ b/app/Services/TotemJwt.php
@@ -0,0 +1,173 @@
+<?php
+
+namespace App\Services;
+
+use App\Exceptions\TotemAuthenticationException;
+use Illuminate\Support\Facades\Config;
+use Illuminate\Support\Str;
+use JsonException;
+use LogicException;
+
+/**
+ * Minimal, correct HS256 JWT implementation for totem pairing tokens.
+ *
+ * No external library on purpose: the totem surface only needs sign/verify of
+ * a fixed HS256 token. Claims: `totem_id`, `entity_id`, `preset_id`, `queues`,
+ * `iat`, `exp`, `jti`. Secret and TTL come from `services.totem.jwt_secret` /
+ * `services.totem.jwt_ttl`.
+ */
+final class TotemJwt
+{
+    private const ALG = 'HS256';
+
+    /**
+     * Sign a token for a freshly paired totem.
+     *
+     * @param  list<int>  $queueIds  Allowed queue ids at pairing time.
+     * @return array{token: string, expires_in: int}
+     */
+    public static function issue(int $totemId, int $entityId, int $presetId, array $queueIds): array
+    {
+        $ttl = max(1, (int) Config::integer('services.totem.jwt_ttl', 3600));
+        $now = now()->timestamp;
+
+        $payload = [
+            'totem_id' => $totemId,
+            'entity_id' => $entityId,
+            'preset_id' => $presetId,
+            'queues' => $queueIds,
+            'iat' => $now,
+            'exp' => $now + $ttl,
+            'jti' => (string) Str::uuid(),
+        ];
+
+        $headerSegment = self::encodeJsonSegment(['alg' => self::ALG, 'typ' => 'JWT']);
+        $payloadSegment = self::encodeJsonSegment($payload);
+        $signatureSegment = self::base64UrlEncode(
+            self::signature($headerSegment, $payloadSegment, self::secret())
+        );
+
+        return [
+            'token' => $headerSegment.'.'.$payloadSegment.'.'.$signatureSegment,
+            'expires_in' => $ttl,
+        ];
+    }
+
+    /**
+     * Verify + decode a bearer token; throws TotemAuthenticationException on
+     * any failure (malformed input, bad signature, wrong alg, expiry, shape).
+     *
+     * @return array<string, mixed> Claims.
+     */
+    public static function decode(string $token): array
+    {
+        $secret = self::secret();
+
+        $segments = explode('.', $token, 3);
+
+        if (count($segments) !== 3) {
+            throw new TotemAuthenticationException('Malformed totem token.');
+        }
+
+        [$headerSegment, $payloadSegment, $signatureSegment] = $segments;
+
+        $signature = self::base64UrlDecode($signatureSegment);
+
+        if ($signature === null || ! hash_equals(self::signature($headerSegment, $payloadSegment, $secret), $signature)) {
+            throw new TotemAuthenticationException('Invalid totem token signature.');
+        }
+
+        $header = self::decodeJsonSegment($headerSegment);
+        $claims = self::decodeJsonSegment($payloadSegment);
+
+        if (($header['alg'] ?? null) !== self::ALG) {
+            throw new TotemAuthenticationException('Unsupported totem token algorithm.');
+        }
+
+        if (! is_int($claims['exp'] ?? null) || $claims['exp'] < now()->timestamp) {
+            throw new TotemAuthenticationException('Totem token expired.');
+        }
+
+        if (
+            ! is_int($claims['totem_id'] ?? null)
+            || ! is_int($claims['entity_id'] ?? null)
+            || ! is_int($claims['preset_id'] ?? null)
+            || ! is_array($claims['queues'] ?? null)
+        ) {
+            throw new TotemAuthenticationException('Invalid totem token claims.');
+        }
+
+        return $claims;
+    }
+
+    private static function signature(string $headerSegment, string $payloadSegment, string $secret): string
+    {
+        return hash_hmac('sha256', $headerSegment.'.'.$payloadSegment, $secret, true);
+    }
+
+    private static function secret(): string
+    {
+        $secret = Config::string('services.totem.jwt_secret', '');
+
+        if ($secret === '') {
+            throw new LogicException('TOTEM_JWT_SECRET is not configured.');
+        }
+
+        if (strlen($secret) < 32) {
+            throw new LogicException('TOTEM_JWT_SECRET must be at least 32 characters.');
+        }
+
+        return $secret;
+    }
+
+    private static function encodeJsonSegment(array $value): string
+    {
+        try {
+            $json = json_encode($value, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);
+        } catch (JsonException $e) {
+            throw new LogicException('Cannot encode totem JWT segment: '.$e->getMessage());
+        }
+
+        return self::base64UrlEncode($json);
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    private static function decodeJsonSegment(string $segment): array
+    {
+        $json = self::base64UrlDecode($segment);
+
+        if ($json === null) {
+            throw new TotemAuthenticationException('Malformed totem token segment.');
+        }
+
+        try {
+            $value = json_decode($json, true, 512, JSON_THROW_ON_ERROR);
+        } catch (JsonException) {
+            throw new TotemAuthenticationException('Malformed totem token segment.');
+        }
+
+        if (! is_array($value)) {
+            throw new TotemAuthenticationException('Malformed totem token segment.');
+        }
+
+        return $value;
+    }
+
+    private static function base64UrlEncode(string $value): string
+    {
+        return rtrim(strtr(base64_encode($value), '+/', '-_'), '=');
+    }
+
+    private static function base64UrlDecode(string $value): ?string
+    {
+        $decoded = base64_decode(strtr($value, '-_', '+/'), true);
+
+        if ($decoded === false) {
+            return null;
+        }
+
+        return $decoded;
+    }
+}
