+<?php
+
+namespace App\Exceptions;
+
+use RuntimeException;
+
+/**
+ * Thrown when an API request outside the totem group is rejected by
+ * totem-specific validation (entity path mismatch, queue out of scope).
+ */
+abstract class TotemApiException extends RuntimeException
+{
+    /**
+     * Stable machine-readable error code sent to the totem client.
+     */
+    abstract public function errorCode(): string;
+
+    /**
+     * HTTP status the API should answer with.
+     */
+    abstract public function statusCode(): int;
+}
