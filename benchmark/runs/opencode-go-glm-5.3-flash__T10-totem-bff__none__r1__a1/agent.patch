@@ -0,0 +1,70 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Enums\TotemPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Support\TotemQueueVisuals;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController extends TotemController
+{
+    /**
+     * Queues available for issuance on the token entity, limited to the
+     * preset's effective scope, ordered by name. `visual.order` is the
+     * 1-based display position in the returned (ascending) list.
+     */
+    public function queues(Request $request, string $entity): JsonResponse
+    {
+        $entity = $this->resolveEntity($request, $entity);
+
+        $scope = $this->queueScope($request);
+
+        $queues = $entity->queues()
+            ->whereIn('id', $scope)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $entity->slug,
+                'name' => $entity->name,
+            ],
+            'queues' => $queues->values()->map(
+                fn (Queue $queue, int $index) => [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => null,
+                    'visual' => TotemQueueVisuals::forPosition($index + 1),
+                    'is_active' => $queue->is_active,
+                ],
+            )->all(),
+        ]);
+    }
+
+    /**
+     * Backend-owned priority levels for one in-scope, active queue.
+     */
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $entity = $this->resolveEntity($request, $entity);
+        $queue = $this->resolveQueue($request, $entity, $queue);
+
+        if (! $queue->is_active) {
+            throw new InactiveQueueException('Cannot list priorities for an inactive queue.');
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $entity->slug],
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priorities' => TotemPriority::contract(),
+        ]);
+    }
+}
