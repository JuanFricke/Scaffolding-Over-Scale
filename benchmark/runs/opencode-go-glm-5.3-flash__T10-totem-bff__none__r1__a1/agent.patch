+<?php
+
+namespace App\Support;
+
+/**
+ * Presentation-only visual specs served by the totem queues endpoint so the
+ * Flutter client renders queues without hardcoding styles. Backend owns the
+ * values; `order` is the 1-based display position of the queue in the list.
+ */
+final class TotemQueueVisuals
+{
+    private const PALETTE = [
+        '#0055FF',
+        '#2E7D32',
+        '#C62828',
+        '#8E24AA',
+        '#EF6C00',
+        '#00838F',
+    ];
+
+    /**
+     * @return array{color: string, icon: string, order: int}
+     */
+    public static function forPosition(int $position): array
+    {
+        $color = self::PALETTE[($position - 1) % count(self::PALETTE)] ?? self::PALETTE[0];
+
+        return ['color' => $color, 'icon' => 'ticket', 'order' => $position];
+    }
+}
