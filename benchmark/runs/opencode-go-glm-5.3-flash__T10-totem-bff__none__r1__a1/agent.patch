@@ -0,0 +1,76 @@
+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned totem priority levels — the single source used by the
+ * priorities endpoint and by issuance validation. Higher value = more
+ * prioritized. Stored raw on `tickets.priority`.
+ */
+enum TotemPriority: int
+{
+    case Normal = 0;
+    case Priority = 10;
+    case Priority80Plus = 20;
+
+    /**
+     * Display label rendered by the totem.
+     */
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Priority => 'Prioritário',
+            self::Priority80Plus => 'Prioridade 80+',
+        };
+    }
+
+    /**
+     * Presentation-only visual spec so the totem renders without hardcoding.
+     *
+     * @return array{color: string, icon: string, order: int}
+     */
+    public function visual(): array
+    {
+        return match ($this) {
+            self::Normal => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            self::Priority => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            self::Priority80Plus => ['color' => '#8E24AA', 'icon' => 'elderly', 'order' => 3],
+        };
+    }
+
+    /**
+     * Structured payload shape for the priorities endpoint.
+     *
+     * @return array{value: int, label: string, visual: array{color: string, icon: string, order: int}}
+     */
+    public function toArray(): array
+    {
+        return [
+            'value' => $this->value,
+            'label' => $this->label(),
+            'visual' => $this->visual(),
+        ];
+    }
+
+    /**
+     * Full contract list, in display order.
+     *
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function contract(): array
+    {
+        return array_map(
+            fn (self $priority) => $priority->toArray(),
+            self::cases(),
+        );
+    }
+
+    /**
+     * True when the integer is an issuable priority value.
+     */
+    public static function isAllowed(int $value): bool
+    {
+        return self::tryFrom($value) !== null;
+    }
+}
