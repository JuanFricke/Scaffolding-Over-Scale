--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,137 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use LogicException;
+
+#[Fillable([
+    'queue_id',
+    'code',
+    'priority',
+    'channel',
+    'status',
+    'issued_at',
+    'called_at',
+    'called_by_user_id',
+])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields that may still change after a ticket is issued.
+     *
+     * @var list<string>
+     */
+    protected const MUTABLE_AFTER_ISSUANCE = [
+        'status',
+        'called_at',
+        'called_by_user_id',
+        'updated_at',
+    ];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        static::updating(function (self $ticket): void {
+            $immutableChanges = array_diff(
+                array_keys($ticket->getDirty()),
+                self::MUTABLE_AFTER_ISSUANCE,
+            );
+
+            if ($immutableChanges !== []) {
+                throw new LogicException('Tickets are immutable after issuance except for call fields.');
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Allocate the next display code for a queue: A001, A002, ... A1000.
+     *
+     * Codes are read by insertion order and malformed legacy codes are skipped,
+     * so the sequence never depends on lexical ordering.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = static::query()
+            ->where('queue_id', $queueId)
+            ->orderByDesc('id')
+            ->pluck('code');
+
+        $last = 0;
+
+        foreach ($codes as $code) {
+            if (preg_match('/^A(\d+)$/', (string) $code, $matches) === 1) {
+                $last = (int) $matches[1];
+
+                break;
+            }
+        }
+
+        return 'A'.str_pad((string) ($last + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call a waiting ticket exactly once.
+     *
+     * @throws AuthorizationException
+     * @throws LogicException
+     */
+    public function call(User $user): void
+    {
+        DB::transaction(function () use ($user): void {
+            $ticket = static::query()
+                ->whereKey($this->getKey())
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            Gate::forUser($user)->authorize('call', $ticket);
+
+            if ($ticket->status !== TicketStatus::Waiting) {
+                throw new LogicException('A ticket can only be called once.');
+            }
+
+            $ticket->forceFill([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->id,
+            ])->save();
+
+            $this->setRawAttributes($ticket->getAttributes(), true);
+        });
+    }
+}
