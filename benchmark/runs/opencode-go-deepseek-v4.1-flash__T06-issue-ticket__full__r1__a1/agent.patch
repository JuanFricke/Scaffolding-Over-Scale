+++ b/tests/Feature/Ticket/TicketSchemaTest.php
@@ -0,0 +1,85 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has the required columns and unique slug per entity', function () {
+    $this->assertTrue(Schema::hasTable('queues'));
+
+    $this->assertTrue(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n',
+        'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('queues', 'queues_entity_id_slug_unique'));
+
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+
+    Queue::factory()->for($entity)->create(['slug' => 'reception']);
+
+    expect(fn () => Queue::factory()->for($entity)->create(['slug' => 'reception']))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    Queue::factory()->for($other)->create(['slug' => 'reception']);
+
+    expect(Queue::where('slug', 'reception')->count())->toBe(2);
+});
+
+test('tickets table has the required columns, unique code per queue and lookup index', function () {
+    $this->assertTrue(Schema::hasTable('tickets'));
+
+    $this->assertTrue(Schema::hasColumns('tickets', [
+        'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+        'issued_at', 'called_at', 'called_by_user_id',
+        'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_id_code_unique'));
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_id_status_priority_issued_at_index'));
+});
+
+test('queue defaults are applied by the database', function () {
+    $entity = Entity::factory()->create();
+
+    $id = DB::table('queues')->insertGetId([
+        'entity_id' => $entity->id,
+        'name' => 'Reception',
+        'slug' => 'reception',
+    ]);
+
+    $queue = DB::table('queues')->where('id', $id)->first();
+
+    expect((bool) $queue->is_active)->toBeTrue()
+        ->and($queue->labels_i18n)->toBeNull();
+});
+
+test('ticket defaults and queue/entity cascades are enforced by the database', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $raw = DB::table('tickets')->where('id', $ticket->id)->first();
+
+    expect($raw->priority)->toBe(0)
+        ->and($raw->status)->toBe('waiting')
+        ->and($raw->channel)->toBe('virtual')
+        ->and($raw->called_at)->toBeNull()
+        ->and($raw->called_by_user_id)->toBeNull();
+
+    $user = User::factory()->create();
+
+    $queue->delete();
+
+    expect(DB::table('tickets')->where('id', $ticket->id)->exists())->toBeFalse()
+        ->and($user->id)->not->toBeNull();
+});
