+
+namespace App\Policies;
+
+use App\Models\Ticket;
+use App\Models\User;
+
+class TicketPolicy
+{
+    /**
+     * Any member of the ticket's entity may call it.
+     */
+    public function call(User $user, Ticket $ticket): bool
+    {
+        return (bool) $user->membershipFor($ticket->queue->entity_id);
+    }
