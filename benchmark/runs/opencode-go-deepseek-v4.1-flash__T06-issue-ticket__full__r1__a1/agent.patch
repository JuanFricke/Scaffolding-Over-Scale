+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issuing a ticket uses waiting, virtual and priority zero by default', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('issuing tickets increments the per-queue code sequence', function () {
+    $queue = Queue::factory()->create();
+
+    $action = new IssueTicket;
+
+    expect($action($queue)->code)->toBe('A001')
+        ->and($action($queue)->code)->toBe('A002')
+        ->and($action($queue)->code)->toBe('A003');
+});
+
+test('issuance accepts an explicit priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting);
+});
+
+test('issuance rejects an inactive queue and persists nothing', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('issuance checks the database queue state instead of the stale model instance', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::findOrFail($queue->id);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($stale))->toThrow(InactiveQueueException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('issuance rejects a negative priority with an invalid argument exception', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))->toThrow(InvalidArgumentException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('issuance allocates codes independently per queue', function () {
+    $first = Queue::factory()->create();
+    $second = Queue::factory()->create();
+
+    $action = new IssueTicket;
+
+    expect($action($first)->code)->toBe('A001')
+        ->and($action($second)->code)->toBe('A001')
+        ->and($action($first)->code)->toBe('A002');
+});
diff --git a/tests/Feature/Ticket/TicketCallTest.php b/tests/Feature/Ticket/TicketCallTest.php
new file mode 100644
index 0000000..26b020c
--- /dev/null
+++ b/tests/Feature/Ticket/TicketCallTest.php
@@ -0,0 +1,91 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function ticketCallTestFixture(): array
+{
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    return [$entity, $queue, $ticket];
+}
+
+function ticketCallTestMember(Entity $entity, string $role = 'employee'): User
+{
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->for($entity)->for($user)->create(['role' => $role]);
+
+    return $user;
+}
+
+test('a member calls a waiting ticket exactly once', function () {
+    [$entity, $queue, $ticket] = ticketCallTestFixture();
+    $user = ticketCallTestMember($entity);
+
+    $ticket->call($user);
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($user->id)
+        ->and($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->fresh()->calledBy->is($user))->toBeTrue();
+});
+
+test('any role in the entity may call a ticket', function (string $role) {
+    [$entity, $queue, $ticket] = ticketCallTestFixture();
+    $user = ticketCallTestMember($entity, $role);
+
+    $ticket->call($user);
+
+    expect($ticket->fresh()->called_by_user_id)->toBe($user->id);
+})->with(['owner', 'admin', 'employee']);
+
+test('calling a non-waiting ticket throws and leaves it unchanged', function () {
+    [$entity, $queue, $ticket] = ticketCallTestFixture();
+    $user = ticketCallTestMember($entity);
+
+    $ticket->call($user);
+    $calledAt = $ticket->called_at;
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->status)->toBe(TicketStatus::Called)
+        ->and($fresh->called_at->equalTo($calledAt))->toBeTrue()
+        ->and($fresh->called_by_user_id)->toBe($user->id);
+});
+
+test('a user outside the ticket entity cannot call and the ticket is unchanged', function () {
+    [$entity, $queue, $ticket] = ticketCallTestFixture();
+    $stranger = User::factory()->create();
+    EntityMembership::factory()->create(['user_id' => $stranger->id]);
+
+    expect(fn () => $ticket->call($stranger))->toThrow(AuthorizationException::class);
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->status)->toBe(TicketStatus::Waiting)
+        ->and($fresh->called_at)->toBeNull()
+        ->and($fresh->called_by_user_id)->toBeNull();
+});
+
+test('a member of another entity cannot call the ticket', function () {
+    [$entity, $queue, $ticket] = ticketCallTestFixture();
+    $otherEntity = Entity::factory()->create();
+    $user = ticketCallTestMember($otherEntity);
+
+    expect(fn () => $ticket->call($user))->toThrow(AuthorizationException::class)
+        ->and($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
diff --git a/tests/Feature/Ticket/TicketModelTest.php b/tests/Feature/Ticket/TicketModelTest.php
new file mode 100644
index 0000000..c901b3f
--- /dev/null
+++ b/tests/Feature/Ticket/TicketModelTest.php
@@ -0,0 +1,162 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('queue factory creates an active queue owned by a new entity', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity)->toBeInstanceOf(Entity::class)
+        ->and($queue->is_active)->toBeTrue()
+        ->and($queue->slug)->not->toBeEmpty()
+        ->and($queue->name)->not->toBeEmpty();
+});
+
+test('queue casts flags and localized labels', function () {
+    $queue = Queue::factory()->create([
+        'is_active' => false,
+        'labels_i18n' => ['pt_BR' => 'Recepção', 'en' => 'Reception'],
+    ]);
+
+    expect($queue->is_active)->toBeFalse()
+        ->and($queue->labels_i18n)->toBe(['pt_BR' => 'Recepção', 'en' => 'Reception']);
+});
+
+test('entity exposes its queues', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect($entity->queues()->get())->toHaveCount(1)
+        ->and($entity->queues()->first()->is($queue))->toBeTrue();
+});
+
+test('ticket factory creates a waiting virtual ticket with priority zero and an allocated code', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->queue)->toBeInstanceOf(Queue::class)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->calledBy)->toBeNull()
+        ->and($ticket->code)->toBe('A001');
+});
+
+test('ticket factory forQueue allocates A001 then A002 for the same queue', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and($first->queue_id)->toBe($queue->id)
+        ->and($second->queue_id)->toBe($queue->id);
+});
+
+test('ticket factory keeps an explicitly provided code', function () {
+    $ticket = Ticket::factory()->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X');
+});
+
+test('ticket casts enums, integers and datetimes', function () {
+    $ticket = Ticket::factory()->create([
+        'priority' => 10,
+        'channel' => TicketChannel::Printed->value,
+        'status' => TicketStatus::Called->value,
+        'issued_at' => now()->subMinute(),
+        'called_at' => now(),
+    ]);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Printed)
+        ->and($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->issued_at)->toBeInstanceOf(DateTimeInterface::class)
+        ->and($ticket->called_at)->toBeInstanceOf(DateTimeInterface::class);
+});
+
+test('queue and ticket relations resolve', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    expect($ticket->queue->is($queue))->toBeTrue()
+        ->and($queue->tickets()->first()->is($ticket))->toBeTrue();
+});
+
+test('nextCode starts at A001 and increments by insertion order', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and(Ticket::nextCode($queue->id))->toBe('A003');
+});
+
+test('nextCode grows beyond three digits without truncation', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('nextCode skips malformed legacy codes', function () {
+    $onlyMalformed = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($onlyMalformed)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($onlyMalformed->id))->toBe('A001');
+
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+});
+
+test('deleting a ticket does not reuse a middle number', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+    $third = Ticket::factory()->forQueue($queue)->create();
+
+    expect([$first->code, $second->code, $third->code])->toBe(['A001', 'A002', 'A003']);
+
+    $second->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('ticket writes are immutable after issuance except the call fields', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['code' => 'A999']))->toThrow(LogicException::class);
+    expect(fn () => $ticket->update(['priority' => 10]))->toThrow(LogicException::class);
+    expect(fn () => $ticket->update(['channel' => TicketChannel::Totem->value]))->toThrow(LogicException::class);
+    expect(fn () => $ticket->update(['issued_at' => now()->subHour()]))->toThrow(LogicException::class);
+
+    $ticket->refresh();
+
+    $ticket->update([
+        'status' => TicketStatus::Called,
+        'called_at' => now(),
+        'called_by_user_id' => null,
+    ]);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called);
+});
diff --git a/tests/Feature/Ticket/TicketSchemaTest.php b/tests/Feature/Ticket/TicketSchemaTest.php
new file mode 100644
