@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+use RuntimeException;
+
+class IssueTicket
+{
+    /**
+     * Issue a new ticket into a queue.
+     *
+     * @throws InactiveQueueException
+     * @throws InvalidArgumentException
+     */
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be greater than or equal to zero.');
+        }
+
+        for ($attempt = 0; $attempt < 5; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel): Ticket {
+                    $lockedQueue = Queue::query()
+                        ->whereKey($queue->getKey())
+                        ->lockForUpdate()
+                        ->first();
+
+                    if (! $lockedQueue || ! $lockedQueue->is_active) {
+                        throw new InactiveQueueException('Cannot issue tickets into an inactive queue.');
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $lockedQueue->id,
+                        'code' => Ticket::nextCode($lockedQueue->id),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (UniqueConstraintViolationException) {
+                // Another issuance took the code between nextCode() and insert; retry.
+            }
+        }
+
+        throw new RuntimeException('Could not issue a ticket after several code allocation attempts.');
+    }
+}
