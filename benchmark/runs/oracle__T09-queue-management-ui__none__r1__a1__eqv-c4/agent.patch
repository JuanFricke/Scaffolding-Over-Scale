diff --git a/app/Livewire/Entity/Queues.php b/app/Livewire/Entity/Queues.php
new file mode 100644
index 0000000..60b1bae
--- /dev/null
+++ b/app/Livewire/Entity/Queues.php
@@ -0,0 +1,308 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateQueue;
+use App\Actions\SetQueueAccess;
+use App\Actions\UpdateQueue;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Queues extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|min:1|max:255')]
+    public string $name = '';
+
+    /**
+     * Queue shown in the detail modal. Untrusted client state — always
+     * re-resolved scoped to the entity before use.
+     */
+    public ?int $viewingQueueId = null;
+
+    /**
+     * Whether the deactivate-confirmation modal is open. Client-writable flag —
+     * every action re-resolves and authorizes server-side.
+     */
+    public bool $confirmingToggle = false;
+
+    /**
+     * Whether the creation modal is open.
+     */
+    public bool $creating = false;
+
+    /**
+     * Queue being renamed. Untrusted client state — always re-resolved
+     * scoped to the entity before use.
+     */
+    public ?int $editingQueueId = null;
+
+    #[Validate('required|string|min:1|max:255')]
+    public string $renameName = '';
+
+    /**
+     * Queue whose access modal is open. Untrusted client state — always
+     * re-resolved scoped to the entity before use.
+     */
+    public ?int $accessQueueId = null;
+
+    public bool $managingAccess = false;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('create', [Queue::class, $entity]);
+        $this->entity = $entity;
+    }
+
+    public function create(): void
+    {
+        $this->authorize('create', [Queue::class, $this->entity]);
+
+        $this->validateOnly('name');
+
+        try {
+            // Slug always derives from the name — no custom slug input.
+            $queue = (new CreateQueue)($this->entity, auth()->user(), $this->name);
+        } catch (ValidationException $e) {
+            // Surface domain errors (name or derived-slug uniqueness) on name.
+            foreach ($e->errors() as $messages) {
+                foreach ((array) $messages as $message) {
+                    $this->addError('name', $message);
+                }
+            }
+
+            return;
+        }
+
+        Log::channel('audit')->info('queue.created', [
+            'entity_id' => $this->entity->id,
+            'actor_id' => auth()->id(),
+            'queue_id' => $queue->id,
+        ]);
+
+        $this->reset('name', 'creating');
+    }
+
+    public function openCreate(): void
+    {
+        $this->authorize('create', [Queue::class, $this->entity]);
+
+        $this->reset('name');
+        $this->resetValidation('name');
+        $this->creating = true;
+    }
+
+    public function closeCreate(): void
+    {
+        $this->reset('creating', 'name');
+        $this->resetValidation('name');
+    }
+
+    public function openQueue($queueId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($queueId);
+
+        $this->authorize('update', $queue);
+
+        $this->viewingQueueId = $queue->id;
+    }
+
+    public function closeQueue(): void
+    {
+        $this->reset('viewingQueueId', 'editingQueueId', 'renameName', 'accessQueueId', 'managingAccess', 'confirmingToggle');
+        $this->resetValidation('renameName');
+    }
+
+    public function viewingQueue(): ?Queue
+    {
+        if ($this->viewingQueueId === null) {
+            return null;
+        }
+
+        return $this->entity->queues()->find($this->viewingQueueId);
+    }
+
+    public function startRename($queueId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($queueId);
+
+        $this->authorize('update', $queue);
+
+        $this->editingQueueId = $queue->id;
+        $this->renameName = $queue->name;
+        $this->resetValidation('renameName');
+    }
+
+    public function cancelRename(): void
+    {
+        $this->reset('editingQueueId', 'renameName');
+        $this->resetValidation('renameName');
+    }
+
+    public function editingQueue(): ?Queue
+    {
+        if ($this->editingQueueId === null) {
+            return null;
+        }
+
+        return $this->entity->queues()->find($this->editingQueueId);
+    }
+
+    public function rename(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->editingQueueId ?? 0);
+
+        $this->authorize('update', $queue);
+
+        $this->validateOnly('renameName');
+
+        try {
+            // Rename re-slugs from the new name so slug always tracks name.
+            (new UpdateQueue)($queue, auth()->user(), name: $this->renameName, slug: $this->renameName);
+        } catch (ValidationException $e) {
+            foreach ($e->errors() as $messages) {
+                foreach ((array) $messages as $message) {
+                    $this->addError('renameName', $message);
+                }
+            }
+
+            return;
+        }
+
+        Log::channel('audit')->info('queue.renamed', [
+            'entity_id' => $this->entity->id,
+            'actor_id' => auth()->id(),
+            'queue_id' => $queue->id,
+        ]);
+
+        $this->reset('editingQueueId', 'renameName');
+    }
+
+    public function toggleActive($queueId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($queueId);
+
+        $this->authorize('update', $queue);
+
+        (new UpdateQueue)($queue, auth()->user(), isActive: ! $queue->is_active);
+
+        Log::channel('audit')->info('queue.toggled', [
+            'entity_id' => $this->entity->id,
+            'actor_id' => auth()->id(),
+            'queue_id' => $queue->id,
+            'is_active' => $queue->fresh()->is_active,
+        ]);
+
+        $this->reset('confirmingToggle');
+    }
+
+    public function confirmToggle(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->viewingQueueId ?? 0);
+
+        $this->authorize('update', $queue);
+
+        $this->confirmingToggle = true;
+    }
+
+    public function cancelToggle(): void
+    {
+        $this->confirmingToggle = false;
+    }
+
+    public function openAccess($queueId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($queueId);
+
+        $this->authorize('manageAccess', $queue);
+
+        $this->accessQueueId = $queue->id;
+        $this->managingAccess = true;
+    }
+
+    public function closeAccess(): void
+    {
+        $this->reset('accessQueueId', 'managingAccess');
+    }
+
+    public function accessQueue(): ?Queue
+    {
+        if (! $this->managingAccess || $this->accessQueueId === null) {
+            return null;
+        }
+
+        return $this->entity->queues()->find($this->accessQueueId);
+    }
+
+    /**
+     * @return Collection<int, EntityMembership>
+     */
+    public function accessMemberships(): Collection
+    {
+        return $this->entity->memberships()->with('user')->latest('id')->get();
+    }
+
+    /**
+     * @return Collection<int, mixed>
+     */
+    public function accessGrants(): Collection
+    {
+        $queue = $this->accessQueue();
+
+        if ($queue === null) {
+            return collect();
+        }
+
+        return QueueAccess::query()
+            ->where('queue_id', $queue->id)
+            ->pluck('permissions', 'entity_membership_id');
+    }
+
+    public function grantAccess($membershipId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->accessQueueId ?? 0);
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('manageAccess', $queue);
+
+        // Grant/revoke audit lives in SetQueueAccess; cross-entity targets are
+        // rejected there with a ValidationException.
+        (new SetQueueAccess)($membership, $queue, auth()->user(), [QueuePermission::Call]);
+    }
+
+    public function revokeAccess($membershipId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->accessQueueId ?? 0);
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('manageAccess', $queue);
+
+        (new SetQueueAccess)($membership, $queue, auth()->user(), []);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.queues', [
+            'queues' => $this->entity->queues()->orderBy('name')->get(),
+            'viewing' => $this->viewingQueue(),
+            'editing' => $this->editingQueue(),
+            'accessQueue' => $this->accessQueue(),
+            'accessMemberships' => $this->managingAccess ? $this->accessMemberships() : collect(),
+            'accessGrants' => $this->accessGrants(),
+        ]);
+    }
+}
diff --git a/app/Livewire/Entity/Serve.php b/app/Livewire/Entity/Serve.php
new file mode 100644
index 0000000..0d4b76e
--- /dev/null
+++ b/app/Livewire/Entity/Serve.php
@@ -0,0 +1,198 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\QueuePermission;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Serve extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    /**
+     * Selected queue. Untrusted client state — always re-resolved
+     * scoped to the entity before use.
+     */
+    public ?int $selectedQueueId = null;
+
+    #[Validate('required|in:any,priority_only,normal_only')]
+    public string $mode = CallMode::Any->value;
+
+    #[Locked]
+    public ?int $lastCalledTicketId = null;
+
+    public ?string $notice = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+        $this->selectedQueueId = $this->callableQueues()->first()?->id;
+    }
+
+    /**
+     * @return Collection<int, Queue>
+     */
+    public function callableQueues(): Collection
+    {
+        $user = auth()->user();
+
+        $queues = $this->entity->queues()
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        if ($user === null) {
+            return collect();
+        }
+
+        // Single membership lookup; managers bypass without grant rows.
+        $membership = $user->membershipFor($this->entity->id);
+
+        if ($membership === null) {
+            return collect();
+        }
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            return $queues->values();
+        }
+
+        $grantedIds = QueueAccess::query()
+            ->where('entity_membership_id', $membership->id)
+            ->whereIn('queue_id', $queues->pluck('id'))
+            ->get()
+            ->filter(fn (QueueAccess $access) => in_array(
+                QueuePermission::Call->value,
+                (array) $access->permissions,
+                true
+            ))
+            ->map(fn (QueueAccess $access) => $access->queue_id)
+            ->flip();
+
+        return $queues->filter(fn (Queue $queue) => isset($grantedIds[$queue->id]))->values();
+    }
+
+    public function selectedQueue(): ?Queue
+    {
+        if ($this->selectedQueueId === null) {
+            return null;
+        }
+
+        return $this->entity->queues()->find($this->selectedQueueId);
+    }
+
+    /**
+     * Waiting tickets in call order (priority, age, id) — the same ordering
+     * the domain winner query uses. Any-mode fairness stays domain-side.
+     *
+     * @return Collection<int, Ticket>
+     */
+    public function waiting(): Collection
+    {
+        $queue = $this->selectedQueue();
+
+        if ($queue === null || Gate::denies('call', $queue)) {
+            return collect();
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->when($this->mode === CallMode::PriorityOnly->value, fn ($query) => $query->where('priority', '>', 0))
+            ->when($this->mode === CallMode::NormalOnly->value, fn ($query) => $query->where('priority', 0))
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id')
+            ->limit(30)
+            ->get();
+    }
+
+    public function lastCalled(): ?Ticket
+    {
+        $queue = $this->selectedQueue();
+
+        if ($this->lastCalledTicketId === null || $queue === null) {
+            return null;
+        }
+
+        return Ticket::query()
+            ->whereKey($this->lastCalledTicketId)
+            ->where('queue_id', $queue->id)
+            ->first();
+    }
+
+    public function updatedSelectedQueueId(): void
+    {
+        $this->reset('lastCalledTicketId', 'notice');
+    }
+
+    public function callNext(): void
+    {
+        $this->validateOnly('mode');
+
+        $limiterKey = 'serve-call:'.$this->entity->id.':'.auth()->id();
+        if (RateLimiter::tooManyAttempts($limiterKey, 10)) {
+            $this->notice = __('ui.serve_rate_limited');
+
+            return;
+        }
+
+        $queue = null;
+        if ($this->selectedQueueId !== null && $this->selectedQueueId !== 0) {
+            $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+        }
+
+        if ($queue === null) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        try {
+            $ticket = (new CallNextTicket)($queue, auth()->user(), CallMode::from($this->mode));
+        } catch (InactiveQueueException) {
+            $this->notice = __('ui.serve_inactive');
+
+            return;
+        } catch (NoWaitingTicketsException) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        // AuthorizationException bubbles: denied calls are 403 and mutate nothing.
+        // Quota burns only on a served ticket; probes and empty clicks stay free.
+        RateLimiter::hit($limiterKey, 60);
+
+        $this->lastCalledTicketId = $ticket->id;
+        $this->notice = null;
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.serve', [
+            'callableQueues' => $this->callableQueues(),
+            'waiting' => $this->waiting(),
+            'lastCalled' => $this->lastCalled(),
+        ]);
+    }
+}
