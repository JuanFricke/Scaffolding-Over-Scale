+<?php
+
+namespace App\Console\Commands;
+
+use Illuminate\Console\Command;
+use Illuminate\Support\Str;
+use App\Models\TotemPreset;
+use Carbon\Carbon;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class TotemPairingCode extends Command
+{
+    protected $signature = 'totem:pairing-code {preset : Preset ID for which to generate a code}';
+    protected $description = 'Generate a new pairing code for a totem preset';
+
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+        $preset = TotemPreset::find($presetId);
+
+        if (! $preset) {
+            $this->error("Preset {$presetId} not found");
+            return 1;
+        }
+
+        $code = Str::random(6)->padStart(6, '0');
+        $expiresAt = Carbon::now()->addMinutes(10);
+
+        DB::transaction(function () use ($preset, $code, $expiresAt) {
+            $preset->login_code = $code;
+            $preset->login_code_expires_at = $expiresAt;
+            $preset->login_code_consumed_at = null;
+            $preset->save();
+        });
+
+        $this->line("Generated code: {$code}");
+        Log::info("Totem pairing code generated", ['preset_id' => $presetId, 'code' => $code]);
+
+        return 0;
+    }
+}
