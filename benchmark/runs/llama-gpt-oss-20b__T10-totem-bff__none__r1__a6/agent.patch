+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Response;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\DB;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next)
+    {
+        $authHeader = $request->header('Authorization');
+        if (! $authHeader || ! starts_with($authHeader, 'Bearer ')) {
+            return Response::json(["code"=>"invalid_token"], 401);
+        }
+        $token = substr($authHeader, 7);
+        try {
+            $secret = config('services.totem.jwt_secret');
+            $payload = JWT::decode($token, new Key($secret, 'HS256'));
+        } catch (\Exception $e) {
+            return Response::json(["code"=>"invalid_token"], 401);
+        }
+        // Find totem
+        $totem = Totem::find($payload->totem_id ?? null);
+        if (! $totem || ! $totem->is_active) {
+            return Response::json(["code"=>"invalid_token"], 401);
+        }
+        // Validate preset
+        $preset = TotemPreset::find($payload->preset_id ?? null);
+        if (! $preset || ! $preset->is_active) {
+            return Response::json(["code"=>"invalid_token"], 401);
+        }
+        // Validate entity match
+        if ($totem->entity_id !== $preset->entity_id) {
+            return Response::json(["code"=>"invalid_token"], 401);
+        }
+        // Update last_seen_at
+        $totem->update(['last_seen_at' => now()]);
+
+        // Attach to request for downstream
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('preset', $preset);
+        $request->attributes->set('jwt_payload', $payload);
+
+        return $next($request);
+    }
+}
