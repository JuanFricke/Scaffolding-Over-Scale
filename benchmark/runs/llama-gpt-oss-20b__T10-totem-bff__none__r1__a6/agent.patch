+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+
+class TotemPreset extends Model
+{
+    use HasFactory;
+
+    protected $fillable = [
+        'entity_id',
+        'name',
+        'login_code',
+        'login_code_expires_at',
+        'login_code_consumed_at',
+        'appearance',
+        'is_active',
+    ];
+
+    public function entity()
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    public function queues()
+    {
+        return $this->belongsToMany(Queue::class, 'totem_preset_queue', 'preset_id', 'queue_id')
+            ->withTimestamps();
+    }
+}
