@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\HandlesAuthorization;
+
+class EntityMembershipPolicy
+{
+    use HandlesAuthorization;
+
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        // Any member of the entity may view the membership
+        return $membership->entity->memberships()->where('user_id', $user->id)->exists();
+    }
+
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        $userRole = $membership->entity->memberships()->where('user_id', $user->id)->value('role');
+        return in_array($userRole, [UserRole::Owner->value, UserRole::Admin->value]);
+    }
+
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        // Owner cannot delete their own membership
+        $ownerMembership = $membership->entity->memberships()->where('role', UserRole::Owner->value)->first();
+        if ($ownerMembership && $ownerMembership->id === $membership->id) {
+            return false;
+        }
+        // Self removal allowed
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+        // Owner or admin can delete others
+        $userRole = $membership->entity->memberships()->where('user_id', $user->id)->value('role');
+        return in_array($userRole, [UserRole::Owner->value, UserRole::Admin->value]);
+    }
+}
