+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use App\Models\User;
+use Illuminate\Auth\Auth;
+use Illuminate\Database\DatabaseManager;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Session;
+use Illuminate\Support\Str;
+use Livewire\Component;
+use Illuminate\Support\Facades\DB;
+
+class CreateEntity extends Component
+{
+    public string $name = '';
+
+    protected function rules(): array
+    {
+        return [
+            'name' => 'required|string|max:255',
+        ];
+    }
+
+    public function submit(): void
+    {
+        $this->validate();
+
+        $slug = $this->uniqueSlug($this->name);
+        $user = Auth::user();
+
+        DB::transaction(function () use ($user, $slug) {
+            $entity = Entity::create([
+                'name' => $this->name,
+                'slug' => $slug,
+            ]);
+
+            // create membership as owner
+            $entity->entityMemberships()->create([
+                'user_id' => $user->id,
+                'role' => UserRole::Owner->value,
+            ]);
+
+            Session::put('current_entity_id', $entity->id);
+
+            Log::channel('audit')->info('Entity created', [
+                'entity_id' => $entity->id,
+                'actor_id' => $user->id,
+            ]);
+        });
+
+        return redirect()->route('entity.dashboard', ['entity' => $slug]);
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name);
+        $slug = $base;
+        $i = 2;
+        while (Entity::where('slug', $slug)->exists()) {
+            $slug = $base . '-' . $i;
+            $i++;
+        }
+        return $slug;
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.create-entity');
+    }
+}
