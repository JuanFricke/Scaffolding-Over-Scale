+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Session;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Redirect;
+use Illuminate\Support\Facades\Str;
+
+class EntityController extends Controller
+{
+    public function onboarding(Request $request)
+    {
+        if ($request->isMethod('post')) {
+            $request->validate(['name' => 'required|string|max:255']);
+            $name = $request->input('name');
+            $slug = $this->uniqueSlug($name);
+            $user = Auth::user();
+            try {
+                DB::transaction(function () use ($name, $slug, $user) {
+                    $entity = Entity::create(['name' => $name, 'slug' => $slug]);
+                    $entity->entityMemberships()->create([
+                        'user_id' => $user->id,
+                        'role' => UserRole::Owner->value,
+                    ]);
+                    Session::put('current_entity_id', $entity->id);
+                    Log::channel('audit')->info('Entity created', ['entity_id' => $entity->id, 'actor_id' => $user->id]);
+                });
+            } catch (\\Throwable $e) {
+                // If slug collision, retry
+                return back()->withErrors(['name' => 'Name already used. Try another.']);
+            }
+            return redirect()->route('entity.dashboard', ['entity' => $slug]);
+        }
+        return view('livewire.entity.create-entity', ['title' => __('ui.onboarding_title'), 'heading' => __('ui.onboarding_heading')]);
+    }
+
+    private function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name);
+        $slug = $base;
+        $i = 2;
+        while (Entity::where('slug', $slug)->exists()) {
+            $slug = $base . '-' . $i;
+            $i++;
+        }
+        return $slug;
+    }
+
+    public function switcher()
+    {
+        $user = Auth::user();
+        $entities = $user->entities()->get();
+        return view('livewire.entity.switcher', ['entities' => $entities]);
+    }
+
+    public function pick(Request $request, Entity $entity)
+    {
+        $user = Auth::user();
+        if (! $entity->memberships()->where('user_id', $user->id)->exists()) {
+            abort(403);
+        }
+        Session::put('current_entity_id', $entity->id);
+        Log::channel('audit')->info('Entity switched', ['entity_id' => $entity->id, 'actor_id' => $user->id]);
+        return redirect()->route('entity.dashboard', ['entity' => $entity->slug]);
+    }
+
+    public function dashboard(Entity $entity)
+    {
+        // current_entity middleware ensures user is member
+        return view('livewire.entity.dashboard', ['entity' => $entity]);
+    }
+}
