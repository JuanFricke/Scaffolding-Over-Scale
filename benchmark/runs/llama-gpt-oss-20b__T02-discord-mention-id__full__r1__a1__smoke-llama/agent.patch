diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..d4810f9 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,38 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $content = implode("\n", $lines);
+        $mention = $this->getMention();
+
+        if ($mention === null) {
+            return mb_substr($content, 0, self::MaxContentLength);
+        }
+
+        $mentionLine = "<@{$mention}>";
+        $maxContent = self::MaxContentLength;
+
+        // Reserve space for newline and mention
+        $available = $maxContent - 1 - mb_strlen($mentionLine, 'UTF-8');
+        if ($available < 0) {
+            // mention itself exceeds limit; truncate to mention only
+            return $mentionLine;
+        }
+
+        $truncated = mb_substr($content, 0, $available);
+        return $truncated . "\n" . $mentionLine;
+    }
+
+    private function getMention(): ?string
+    {
+        $id = config('services.discord.mention_id');
+        if (! is_string($id) || $id === '') {
+            return null;
+        }
+        $id = trim($id);
+        if (preg_match('/^\d{17,20}$/', $id)) {
+            return $id;
+        }
+        return null;
     }
 
     private function safe(string $key, mixed $value): string
