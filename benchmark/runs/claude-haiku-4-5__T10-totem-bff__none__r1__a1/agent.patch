+<?php
+
+use App\Http\Controllers\Api\Totem\AuthController;
+use App\Http\Controllers\Api\Totem\DataController;
+use App\Http\Middleware\TotemAuthenticate;
+use App\Http\Middleware\TotemCors;
+use Illuminate\Support\Facades\Route;
+
+Route::middleware([TotemCors::class])
+    ->group(function () {
+        Route::post('/totem/auth', [AuthController::class, 'login'])
+            ->middleware('throttle:10,1')
+            ->name('totem.auth');
+
+        Route::middleware([TotemAuthenticate::class, 'throttle:30,1'])
+            ->group(function () {
+                Route::get('/{entity}/queues', [DataController::class, 'getQueues'])
+                    ->name('totem.queues');
+
+                Route::get('/{entity}/{queue}/priorities', [DataController::class, 'getPriorities'])
+                    ->name('totem.priorities');
+
+                Route::post('/{entity}/{queue}/ticket', [DataController::class, 'issueTicket'])
+                    ->name('totem.ticket');
+            });
+    });
