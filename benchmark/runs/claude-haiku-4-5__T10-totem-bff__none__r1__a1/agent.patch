@@ -0,0 +1,72 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class TotemCors
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $origin = $request->header('Origin');
+        $allowedOrigins = $this->getAllowedOrigins();
+
+        if ($origin && $this->isOriginAllowed($origin, $allowedOrigins)) {
+            $response = $next($request);
+
+            return $response
+                ->header('Access-Control-Allow-Origin', $origin)
+                ->header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
+                ->header('Access-Control-Allow-Headers', 'Content-Type, Authorization')
+                ->header('Access-Control-Max-Age', '3600');
+        }
+
+        if ($request->getMethod() === 'OPTIONS') {
+            return response('', 204);
+        }
+
+        return $next($request);
+    }
+
+    private function getAllowedOrigins(): array
+    {
+        $origins = [
+            'http://localhost',
+            'https://localhost',
+            'http://127.0.0.1',
+            'https://127.0.0.1',
+        ];
+
+        $customOrigin = config('services.totem.web_origin');
+        if ($customOrigin) {
+            $origins[] = $customOrigin;
+        }
+
+        return $origins;
+    }
+
+    private function isOriginAllowed(string $origin, array $allowedOrigins): bool
+    {
+        foreach ($allowedOrigins as $allowed) {
+            if ($this->originMatches($origin, $allowed)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function originMatches(string $origin, string $allowed): bool
+    {
+        if ($origin === $allowed) {
+            return true;
+        }
+
+        $allowedWithoutPort = preg_replace('/:[0-9]+$/', '', $allowed);
+        $originWithoutPort = preg_replace('/:[0-9]+$/', '', $origin);
+
+        return $originWithoutPort === $allowedWithoutPort;
+    }
+}
