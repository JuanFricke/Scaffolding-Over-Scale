+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+class TotemPairingCodeCommand extends Command
+{
+    protected $signature = 'totem:pairing-code {preset : Preset ID}';
+
+    protected $description = 'Generate a pairing code for a totem preset';
+
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+        $preset = TotemPreset::find($presetId);
+
+        if (! $preset) {
+            $this->error("Preset with ID {$presetId} not found.");
+            Log::warning('Totem pairing code: preset not found', ['preset_id' => $presetId]);
+
+            return self::FAILURE;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->update([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ]);
+
+        $this->info("Pairing code for preset '{$preset->name}': {$code}");
+        Log::info('Totem pairing code generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Http/Controllers/Api/Totem/AuthController.php b/app/Http/Controllers/Api/Totem/AuthController.php
new file mode 100644
index 0000000..dff7113
--- /dev/null
+++ b/app/Http/Controllers/Api/Totem/AuthController.php
@@ -0,0 +1,113 @@
+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwtService;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class AuthController extends Controller
+{
+    public function __construct(
+        private TotemJwtService $jwt,
+    ) {
+    }
+
+    public function login(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || ! preg_match('/^\d{6}$/', $code)) {
+            return response()->json([
+                'code' => 'invalid_code_format',
+            ], status: 400);
+        }
+
+        $preset = TotemPreset::where('login_code', $code)->first();
+
+        if (
+            ! $preset
+            || ! $preset->is_active
+            || ! $preset->login_code_expires_at?->isFuture()
+            || $preset->login_code_consumed_at
+        ) {
+            Log::warning('Totem: invalid pairing attempt', [
+                'ip' => $request->ip(),
+                'code_exists' => (bool) $preset,
+                'code_valid' => $preset?->is_active ?? false,
+                'code_expired' => ! ($preset?->login_code_expires_at?->isFuture() ?? true),
+                'code_consumed' => (bool) $preset?->login_code_consumed_at,
+            ]);
+
+            return response()->json([
+                'code' => 'invalid_pairing_code',
+            ], status: 401);
+        }
+
+        try {
+            $token = DB::transaction(function () use ($preset): string {
+                $lockedPreset = TotemPreset::query()
+                    ->whereKey($preset->id)
+                    ->lockForUpdate()
+                    ->firstOrFail();
+
+                if (! $lockedPreset->is_active || ! $lockedPreset->login_code_expires_at?->isFuture()) {
+                    throw new \Exception('Preset became inactive or code expired.');
+                }
+
+                $totem = Totem::query()->firstOrCreate([
+                    'entity_id' => $lockedPreset->entity_id,
+                    'name' => $lockedPreset->name,
+                ], [
+                    'is_active' => true,
+                ]);
+
+                $lockedPreset->update([
+                    'login_code_consumed_at' => now(),
+                ]);
+
+                $totem->update([
+                    'last_seen_at' => now(),
+                ]);
+
+                $queueIds = $lockedPreset->queues()->pluck('queues.id')->toArray();
+
+                return $this->jwt->sign(
+                    $totem->id,
+                    $lockedPreset->entity_id,
+                    $lockedPreset->id,
+                    $queueIds,
+                );
+            });
+
+            Log::info('Totem: pairing successful', [
+                'preset_id' => $preset->id,
+                'entity_id' => $preset->entity_id,
+            ]);
+
+            return response()->json([
+                'token' => $token,
+                'token_type' => 'Bearer',
+                'expires_in' => $this->jwt->getTtl(),
+                'entity' => [
+                    'slug' => $preset->entity->slug,
+                    'name' => $preset->entity->name,
+                ],
+            ]);
+        } catch (\Exception $e) {
+            Log::error('Totem: pairing transaction failed', [
+                'preset_id' => $preset->id,
+                'error' => $e->getMessage(),
+            ]);
+
+            return response()->json([
+                'code' => 'invalid_pairing_code',
+            ], status: 401);
+        }
+    }
+}
