@@ -0,0 +1,169 @@
+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use InvalidArgumentException;
+
+class DataController extends Controller
+{
+    private const PRIORITIES = [
+        0 => ['label' => 'Normal', 'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1]],
+        10 => ['label' => 'Prioritário', 'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2]],
+        20 => ['label' => 'Prioridade 80+', 'visual' => ['color' => '#F57F17', 'icon' => 'shield', 'order' => 3]],
+    ];
+
+    public function getQueues(Request $request): JsonResponse
+    {
+        $claims = $request->attributes->get('totem_claims');
+        $preset = $request->attributes->get('totem_preset');
+        $entitySlug = $request->route('entity');
+
+        $entity = $preset->entity;
+
+        if ($entity->slug !== $entitySlug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $presetQueueIds = $preset->queues()->pluck('queues.id')->toArray();
+        $effectiveQueueIds = array_intersect($claims->queues, $presetQueueIds);
+
+        $queues = Queue::query()
+            ->whereIn('id', $effectiveQueueIds)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->map(function (Queue $queue) {
+                $order = $queue->id % 100;
+
+                return [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => $queue->labels_i18n['description'] ?? '',
+                    'visual' => [
+                        'color' => '#0055FF',
+                        'icon' => 'ticket',
+                        'order' => $order,
+                    ],
+                    'is_active' => true,
+                ];
+            });
+
+        return response()->json([
+            'entity' => [
+                'slug' => $entity->slug,
+                'name' => $entity->name,
+            ],
+            'queues' => $queues,
+        ]);
+    }
+
+    public function getPriorities(Request $request): JsonResponse
+    {
+        $preset = $request->attributes->get('totem_preset');
+        $entitySlug = $request->route('entity');
+        $queueSlug = $request->route('queue');
+
+        $entity = $preset->entity;
+
+        if ($entity->slug !== $entitySlug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $presetQueueIds = $preset->queues()->pluck('queues.id')->toArray();
+        $queue = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $queueSlug)
+            ->whereIn('id', $presetQueueIds)
+            ->first();
+
+        if (! $queue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priorities = array_map(
+            fn ($value, $priority) => [
+                'value' => $value,
+                'label' => $priority['label'],
+                'visual' => $priority['visual'],
+            ],
+            array_keys(self::PRIORITIES),
+            array_values(self::PRIORITIES),
+        );
+
+        return response()->json([
+            'entity' => ['slug' => $entity->slug],
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priorities' => $priorities,
+        ]);
+    }
+
+    public function issueTicket(Request $request, IssueTicket $issueTicket): JsonResponse
+    {
+        $preset = $request->attributes->get('totem_preset');
+        $entitySlug = $request->route('entity');
+        $queueSlug = $request->route('queue');
+
+        $entity = $preset->entity;
+
+        if ($entity->slug !== $entitySlug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $priority = $request->input('priority');
+
+        if (! isset(self::PRIORITIES[$priority])) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        $presetQueueIds = $preset->queues()->pluck('queues.id')->toArray();
+        $queue = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $queueSlug)
+            ->whereIn('id', $presetQueueIds)
+            ->first();
+
+        if (! $queue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        try {
+            $ticket = $issueTicket(
+                $queue,
+                $priority,
+                TicketChannel::Totem,
+            );
+        } catch (\Exception) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priority' => [
+                'value' => $priority,
+                'label' => self::PRIORITIES[$priority]['label'],
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+}
