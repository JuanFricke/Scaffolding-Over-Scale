@@ -0,0 +1,69 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwtService;
+use Closure;
+use Firebase\JWT\ExpiredException;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class TotemAuthenticate
+{
+    public function __construct(
+        private TotemJwtService $jwt,
+    ) {
+    }
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $this->extractToken($request);
+
+        if (! $token) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        try {
+            $claims = $this->jwt->decode($token);
+        } catch (ExpiredException) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        } catch (\Exception) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $totem = Totem::find($claims->totem_id);
+        if (! $totem || ! $totem->is_active) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $preset = TotemPreset::find($claims->preset_id);
+        if (! $preset || ! $preset->is_active) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        if ($totem->entity_id !== $claims->entity_id || $preset->entity_id !== $claims->entity_id) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $totem->update(['last_seen_at' => now()]);
+
+        $request->attributes->set('totem_claims', $claims);
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+
+        return $next($request);
+    }
+
+    private function extractToken(Request $request): ?string
+    {
+        $header = $request->header('Authorization', '');
+
+        if (! str_starts_with($header, 'Bearer ')) {
+            return null;
+        }
+
+        return substr($header, 7);
+    }
+}
