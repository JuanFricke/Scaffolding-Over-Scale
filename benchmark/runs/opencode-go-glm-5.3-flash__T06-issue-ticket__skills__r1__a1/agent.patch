@@ -0,0 +1,78 @@
+<?php
+
+namespace Database\Factories;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Collection;
+use Illuminate\Database\Eloquent\Factories\Factory;
+use Illuminate\Database\Eloquent\Model;
+
+/**
+ * @extends Factory<Ticket>
+ */
+class TicketFactory extends Factory
+{
+    /**
+     * Multi-ticket creation must persist one ticket at a time so each one is
+     * persisted before the next, reading its queue's code sequence (A001,
+     * A002, ...) sequentially; the default batch insert would allocate the
+     * same code to every instance.
+     *
+     * @param  (callable(array<string, mixed>): array<string, mixed>)|array<string, mixed>  $attributes
+     * @return Collection<int, Ticket>|Ticket
+     */
+    public function create($attributes = [], ?Model $parent = null)
+    {
+        if (is_numeric($this->count) && $this->count > 1) {
+            $factory = $attributes === [] ? $this : $this->state($attributes);
+
+            return $factory->createMany($this->count);
+        }
+
+        return parent::create($attributes, $parent);
+    }
+
+    /**
+     * Define the model's default state (creates its queue). The display code
+     * is allocated from the queue's sequence at creation time unless an
+     * explicit `code` attribute is given.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'queue_id' => Queue::factory(),
+            'code' => fn (array $attributes) => Ticket::nextCode($attributes['queue_id']),
+            'priority' => 0,
+            'channel' => TicketChannel::Virtual,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ];
+    }
+
+    /**
+     * Pin the ticket to an existing queue so factory-created tickets share
+     * that queue's code sequence.
+     */
+    public function forQueue(Queue $queue): self
+    {
+        return $this->for($queue);
+    }
+
+    /**
+     * Already-called ticket, with caller and call time.
+     */
+    public function called(): self
+    {
+        return $this->state(fn (): array => [
+            'status' => TicketStatus::Called,
+            'called_at' => now(),
+            'called_by_user_id' => User::factory(),
+        ]);
+    }
+}
