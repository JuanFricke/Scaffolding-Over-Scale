index 0000000..53900c6
--- /dev/null
+++ b/app/Actions/IssueTicket.php
@@ -0,0 +1,83 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+/**
+ * Issue a new waiting ticket for a queue, allocating its display code
+ * (per-queue sequence A001, A002, ...).
+ *
+ * The queue's active state is re-read from the database inside the
+ * transaction, so a queue deactivated after the caller loaded it is
+ * rejected. Concurrent issuances get a few retry attempts on a unique
+ * (queue_id, code) collision; when all attempts fail the underlying
+ * collision is rethrown.
+ */
+class IssueTicket
+{
+    private const MAX_ATTEMPTS = 3;
+
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Priority must be greater than or equal to zero.');
+        }
+
+        $attempts = 0;
+
+        while (true) {
+            $attempts++;
+
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    $fresh = Queue::query()
+                        ->whereKey($queue->getKey())
+                        ->lockForUpdate()
+                        ->first();
+
+                    if ($fresh === null || ! $fresh->is_active) {
+                        throw new InactiveQueueException('Queue is inactive or does not exist.');
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $fresh->id,
+                        'code' => Ticket::nextCode($fresh->id),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (QueryException $e) {
+                if ($attempts >= self::MAX_ATTEMPTS || ! $this->isUniqueCollision($e)) {
+                    throw $e;
+                }
+            }
+        }
+    }
+
+    /**
+     * Detect a unique (queue_id, code) collision, to retry concurrent
+     * issuance; anything else bubbles up as-is. The ticket insert is the
+     * only statement in the transaction, so any unique violation on it
+     * comes from the per-queue code key.
+     */
+    private function isUniqueCollision(QueryException $e): bool
+    {
+        // SQLite (tests) reports "UNIQUE constraint failed: tickets.queue_id..."
+        if (str_contains($e->getMessage(), 'tickets') && str_contains($e->getMessage(), 'UNIQUE')) {
+            return true;
+        }
+
+        // MariaDB/MySQL: error code 1062 (ER_DUP_ENTRY).
+        return (int) ($e->errorInfo[1] ?? 0) === 1062;
+    }
+}
