diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..580ac8c
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,125 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Database\Factories\TicketFactory;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    /** @use HasFactory<TicketFactory> */
+    use HasFactory;
+
+    /**
+     * Fields that may change after issuance (plus updated_at).
+     *
+     * @var list<string>
+     */
+    private const MUTABLE = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string|class-string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for the queue: last valid code in insertion order, + 1.
+     *
+     * Malformed legacy codes (anything not matching `A<digits>`) are skipped,
+     * and deleted tickets' numbers are not offered when a later valid code
+     * exists. Beyond A999 the sequence simply grows (A1000, A1001, ...).
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = Ticket::query()
+            ->select('id', 'code')
+            ->where('queue_id', $queueId)
+            ->where('code', 'regexp', '^A[0-9]+$')
+            ->orderByDesc('id')
+            ->first();
+
+        if ($last === null) {
+            return 'A001';
+        }
+
+        return 'A'.str_pad(
+            string: (string) (((int) substr($last->code, 1)) + 1),
+            length: 3,
+            pad_string: '0',
+            pad_type: STR_PAD_LEFT
+        );
+    }
+
+    /**
+     * Call this ticket, marking it as served by the given user.
+     *
+     * Only members of the ticket's entity may call it (authorization
+     * exception, ticket untouched); an already-called ticket is refused
+     * — a ticket receives exactly one call.
+     */
+    public function call(User $user): void
+    {
+        if (! $user->membershipFor($this->queue->entity_id)) {
+            throw new AuthorizationException("Only members of the ticket's entity may call it.");
+        }
+
+        // Solidify the single-call rule against races hitting the same ticket.
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Ticket has already been called.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->save();
+    }
+
+    /**
+     * Every ticket field is write-once: after issuance only status,
+     * called_at, called_by_user_id (and updated_at) may change.
+     */
+    public function save(array $options = []): bool
+    {
+        $mutating = collect($this->getDirty())
+            ->keys()
+            ->reject(fn (string $field): bool => in_array($field, self::MUTABLE, true));
+
+        if ($this->exists && $mutating->isNotEmpty()) {
+            throw new LogicException(sprintf(
+                'Ticket fields [%s] are immutable after issuance.',
+                $mutating->implode(', ')
+            ));
+        }
+
+        return parent::save($options);
+    }
+}
