+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+test('ticket model relations and casts', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->queue()->first())->not->toBeNull()
+        ->and($ticket->calledBy)->toBeNull()
+        ->and($ticket->priority)->toBeInt()
+        ->and($ticket->issued_at)->toBeInstanceOf(Carbon::class);
+});
+
+test('member of the entity can call a waiting ticket exactly once', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+
+    $entity = $ticket->queue->entity;
+    $entity->users()->attach($user->id, ['role' => UserRole::Employee->value]);
+
+    $ticket->call($user);
+    $before = $ticket->fresh();
+
+    expect($before->status)->toBe(TicketStatus::Called)
+        ->and($before->called_by_user_id)->toBe($user->id)
+        ->and($before->called_at->gt(now()->subMinute()))->toBeTrue();
+
+    $ticket->call($user);
+})->throws(LogicException::class, 'already');
+
+test('calling by a non-member is rejected and the ticket stays untouched', function () {
+    $ticket = Ticket::factory()->create();
+    $outsider = User::factory()->create();
+
+    try {
+        $ticket->call($outsider);
+
+        $this->fail('AuthorizationException was not thrown.');
+    } catch (AuthorizationException) {
+        // expected
+    }
+
+    $after = $ticket->fresh();
+
+    expect($after->status)->toBe(TicketStatus::Waiting)
+        ->and($after->called_at)->toBeNull()
+        ->and($after->called_by_user_id)->toBeNull();
+});
+
+test('calling an already called ticket throws LogicException', function () {
+    $ticket = Ticket::factory()->called()->create();
+    $user = User::factory()->create();
+    $entity = $ticket->queue->entity;
+    $entity->users()->attach($user->id, ['role' => UserRole::Employee->value]);
+
+    $ticket->call($user);
+})->throws(LogicException::class);
+
+test('ticket is write-once: immutable fields throw on save', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->code = 'A999';
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+    expect($ticket->fresh()->code)->not->toBe('A999');
+
+    $ticket->priority = 3;
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+    expect($ticket->fresh()->priority)->not->toBe(3);
+
+    $ticket->update(['priority' => 7]);
+})->throws(LogicException::class);
+
+test('mutable fields can still be persisted without throwing', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+
+    $ticket->status = TicketStatus::Called;
+    $ticket->called_at = now();
+    $ticket->called_by_user_id = $user->id;
+
+    expect($ticket->save())->toBeTrue();
+
+    $after = $ticket->fresh();
+
+    expect($after->status)->toBe(TicketStatus::Called)
+        ->and($after->called_by_user_id)->toBe($user->id)
+        ->and($after->called_at)->not->toBeNull();
+});
