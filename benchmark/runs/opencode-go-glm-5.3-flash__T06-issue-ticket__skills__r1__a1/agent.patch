diff --git a/tests/Feature/Queue/IssueTicketTest.php b/tests/Feature/Queue/IssueTicketTest.php
new file mode 100644
index 0000000..97c784e
--- /dev/null
+++ b/tests/Feature/Queue/IssueTicketTest.php
@@ -0,0 +1,227 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has required columns and per-entity slug index', function () {
+    $this->assertTrue(Schema::hasTable('queues'));
+
+    $this->assertTrue(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('queues', 'queues_entity_slug_unique'));
+});
+
+test('tickets table has required columns and call-next index', function () {
+    $this->assertTrue(Schema::hasTable('tickets'));
+
+    $this->assertTrue(Schema::hasColumns('tickets', [
+        'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+        'issued_at', 'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_code_unique'));
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_call_next_index'));
+});
+
+test('tickets cascade delete with their queue and entity', function () {
+    $entity = Queue::factory()->create()->entity;
+    $queue = Queue::factory()->for($entity)->create();
+
+    $queueId = $queue->id;
+    $entity->forceDelete();
+
+    expect(DB::table('queues')->find($queueId))->toBeNull()
+        ->and(DB::table('tickets')->where('queue_id', $queueId)->count())->toBe(0);
+});
+
+test('queue model relations and casts', function () {
+    $queue = Queue::factory()->create(['labels_i18n' => ['pt_BR' => 'Fila do caixa']]);
+    $sibling = Queue::factory()->for($queue->entity)->create();
+
+    expect($queue->entity)->toBeInstanceOf(Entity::class)
+        ->and($queue->is_active)->toBeTrue()
+        ->and($queue->labels_i18n)->toBe(['pt_BR' => 'Fila do caixa'])
+        ->and($queue->tickets)->toBeEmpty();
+
+    Ticket::factory()->for($queue)->count(2)->create();
+
+    expect($queue->tickets()->count())->toBe(2)
+        ->and(Entity::find($queue->entity_id)->queues()->get())->toHaveCount(2);
+});
+
+test('each queue allocates its own display codes starting at A001', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create();
+
+    $codes = Ticket::factory()->for($queue)->count(3)->create()->map->code;
+    Ticket::factory()->for($other)->create();
+
+    expect($codes->all())->toBe(['A001', 'A002', 'A003'])
+        ->and(Ticket::query()->where('queue_id', $other->id)->first()->code)->toBe('A001');
+});
+
+test('code sequence grows past three digits by insertion order', function () {
+    $queue = Queue::factory()->create();
+
+    // Insertion order wins over string order: A1000 sorts before A999 as a
+    // string, yet the next code must follow the last *inserted* valid code.
+    Ticket::factory()->for($queue)->create(['code' => 'A998']);
+    Ticket::factory()->for($queue)->create(['code' => 'A999']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1000');
+
+    Ticket::factory()->for($queue)->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('deleting a ticket does not downgrade the sequence', function () {
+    $queue = Queue::factory()->create();
+
+    $tickets = Ticket::factory()->for($queue)->count(3)->create();
+    $tickets->get(1)->delete();
+
+    expect(Ticket::factory()->for($queue)->create()->code)->toBe('A004');
+});
+
+test('malformed legacy codes are skipped by the sequence', function () {
+    $orphan = Queue::factory()->create();
+    Ticket::factory()->for($orphan)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($orphan->id))->toBe('A001');
+
+    $legacy = Queue::factory()->create();
+    Ticket::factory()->for($legacy)->create(['code' => 'A001']);
+    Ticket::factory()->for($legacy)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($legacy->id))->toBe('A002')
+        ->and(Ticket::factory()->for($legacy)->create()->code)->toBe('A002');
+});
+
+test('issued ticket is persisted with defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull()
+        ->and($ticket->issued_at->format('Y-m-d H:i:s'))
+        ->toBe(now()->format('Y-m-d H:i:s'));
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(1);
+});
+
+test('issued custom priority and channel are respected', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem);
+});
+
+test('negative priority is rejected', function () {
+    (new IssueTicket)(Queue::factory()->create(), -1);
+})->throws(InvalidArgumentException::class);
+
+test('inactive queue is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+
+    try {
+        (new IssueTicket)($queue);
+
+        $this->fail('InactiveQueueException was not thrown.');
+    } catch (InactiveQueueException) {
+        // expected
+    }
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('a queue deactivated after the caller loaded it is still rejected', function () {
+    $queue = Queue::factory()->create();
+
+    $stale = Queue::query()->findOrFail($queue->id);
+    Queue::query()->whereKey($queue->id)->update(['is_active' => false]);
+
+    try {
+        (new IssueTicket)($stale);
+
+        $this->fail('InactiveQueueException was not thrown.');
+    } catch (InactiveQueueException) {
+        // expected
+    }
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('a queue reactivated in the database is accepted from a stale snapshot', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+
+    $stale = Queue::query()->findOrFail($queue->id);
+    Queue::query()->whereKey($queue->id)->update(['is_active' => true]);
+
+    $ticket = (new IssueTicket)($stale);
+
+    expect($ticket->code)->toBe('A001');
+});
+
+test('ticket factory keeps explicit code and reads per-queue context', function () {
+    $queue = Queue::factory()->create();
+
+    $placed = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X', 'priority' => 2]);
+    $next = Ticket::factory()->forQueue($queue)->create();
+
+    expect($placed->code)->toBe('A-X')
+        ->and($placed->priority)->toBe(2)
+        ->and($next->code)->toBe('A001');
+});
+
+test('unique code collision during issuance is retried', function () {
+    $attempts = 0;
+    Ticket::creating(function (Ticket $ticket) use (&$attempts) {
+        $attempts++;
+
+        if ($attempts === 1) {
+            // Simulate another process having claimed the same code between
+            // nextCode() and the insert: as the transaction (with our rival
+            // row) is rolled back, attempt 2 reallocates the code from scratch.
+            Ticket::withoutEvents(fn () => DB::table('tickets')->insert([
+                'queue_id' => $ticket->queue_id,
+                'code' => $ticket->code,
+                'priority' => 0,
+                'channel' => 'virtual',
+                'status' => 'waiting',
+                'issued_at' => now(),
+                'created_at' => now(),
+                'updated_at' => now(),
+            ]));
+        }
+    });
+
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($attempts)->toBe(2)
+        ->and($ticket->exists)->toBeTrue()
+        ->and(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(1);
+});
