@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Actions\OpenTotemPairing;
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+
+class TotemPairingCode extends Command
+{
+    /**
+     * @var string
+     */
+    protected $signature = 'totem:pairing-code {preset}';
+
+    /**
+     * @var string
+     */
+    protected $description = 'Open a pairing window for a totem preset and print its 6-digit login code';
+
+    public function handle(OpenTotemPairing $openPairing): int
+    {
+        $presetId = $this->argument('preset');
+        $preset = TotemPreset::query()->find($presetId);
+
+        if ($preset === null) {
+            $this->error("Totem preset [{$presetId}] not found.");
+
+            return self::FAILURE;
+        }
+
+        if (! $preset->is_active) {
+            $this->warn("Preset [{$preset->id}] is inactive: the code will not pair until it is activated.");
+        }
+
+        $code = $openPairing($preset);
+
+        $this->info("Pairing code for \"{$preset->name}\": {$code}");
+        $this->line('Expires at '.$preset->login_code_expires_at->toIso8601String().'.');
+
+        return self::SUCCESS;
+    }
+}
