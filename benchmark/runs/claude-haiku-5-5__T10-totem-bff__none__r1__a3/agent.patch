+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->is_active)->toBeTrue()
+        ->and($preset->login_code_expires_at->gt(now()->addMinutes(9)))->toBeTrue()
+        ->and($preset->login_code_expires_at->lte(now()->addMinutes(10)))->toBeTrue();
+});
+
+it('generates distinct login codes across presets', function () {
+    $codes = TotemPreset::factory()->count(20)->create()->pluck('login_code');
+
+    expect($codes->unique())->toHaveCount(20);
+});
+
+it('exposes the entity relations for totems and presets', function () {
+    $entity = Entity::factory()->create();
+    Totem::factory()->create(['entity_id' => $entity->id]);
+    TotemPreset::factory()->create(['entity_id' => $entity->id]);
+
+    expect($entity->totems)->toHaveCount(1)
+        ->and($entity->totemPresets)->toHaveCount(1);
+});
+
+it('attaches and detaches queues on a preset through the join table', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue);
+    expect($preset->queues()->pluck('queues.id')->all())->toBe([$queue->id]);
+
+    $preset->queues()->detach($queue);
+    expect($preset->queues()->count())->toBe(0);
+});
+
+it('refuses to sign tokens with a secret shorter than 32 characters', function () {
+    config(['services.totem.jwt_secret' => 'too-short']);
+
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->create(['entity_id' => $preset->entity_id]);
+
+    app(TotemToken::class)->issue($totem, $preset);
+})->throws(RuntimeException::class, 'TOTEM_JWT_SECRET must be at least 32 characters.');
+
+it('treats a token signed with the none algorithm as invalid', function () {
+    $header = rtrim(strtr(base64_encode(json_encode(['alg' => 'none', 'typ' => 'JWT'])), '+/', '-_'), '=');
+    $payload = rtrim(strtr(base64_encode(json_encode(['totem_id' => 1, 'exp' => time() + 60])), '+/', '-_'), '=');
+
+    expect(app(TotemToken::class)->decode("{$header}.{$payload}."))->toBeNull();
+});
diff --git a/tests/Feature/Totem/TotemPairingTest.php b/tests/Feature/Totem/TotemPairingTest.php
new file mode 100644
index 0000000..d9bcbd4
--- /dev/null
+++ b/tests/Feature/Totem/TotemPairingTest.php
@@ -0,0 +1,181 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+it('opens a pairing window with a fresh 6-digit code that replaces the previous one', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '111111',
+        'login_code_expires_at' => now()->subMinute(),
+        'login_code_consumed_at' => now()->subMinutes(2),
+    ]);
+
+    expect(Artisan::call('totem:pairing-code', ['preset' => $preset->id]))->toBe(0);
+
+    $preset->refresh();
+    $code = $preset->login_code;
+
+    expect($code)->toMatch('/\A\d{6}\z/')
+        ->and($code)->not->toBe('111111')
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->login_code_expires_at->gt(now()->addMinutes(9)))->toBeTrue()
+        ->and($preset->login_code_expires_at->lte(now()->addMinutes(10)))->toBeTrue()
+        ->and(Artisan::output())->toContain($code);
+});
+
+it('fails with a message and a failing exit code for an unknown preset', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999999])
+        ->expectsOutputToContain('not found')
+        ->assertFailed();
+});
+
+it('pairs a totem with a valid code and issues a JWT scoped to the preset', function () {
+    $preset = TotemPreset::factory()->create(['name' => 'Entrada principal']);
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonStructure(['token', 'token_type', 'expires_in', 'entity' => ['slug', 'name']])
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $preset->entity->slug)
+        ->assertJsonPath('entity.name', $preset->entity->name);
+
+    $totem = Totem::query()->sole();
+
+    expect($totem)
+        ->entity_id->toBe($preset->entity_id)
+        ->name->toBe('Entrada principal')
+        ->is_active->toBeTrue()
+        ->last_seen_at->not->toBeNull();
+
+    $claims = (array) JWT::decode($response->json('token'), new Key(config('services.totem.jwt_secret'), 'HS256'));
+
+    expect($claims)
+        ->toMatchArray([
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => [$queue->id],
+        ])
+        ->and($claims['exp'] - $claims['iat'])->toBe(3600)
+        ->and($claims['jti'])->not->toBeEmpty();
+
+    expect($preset->refresh()->login_code_consumed_at)->not->toBeNull();
+});
+
+it('uses the configured JWT TTL', function () {
+    config(['services.totem.jwt_ttl' => 600]);
+
+    $preset = TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertOk()
+        ->assertJsonPath('expires_in', 600);
+});
+
+it('rejects a code that is not exactly six digits with 400 invalid_code_format', function (mixed $code) {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with([
+    'empty' => [''],
+    'missing' => [null],
+    'five digits' => ['12345'],
+    'seven digits' => ['1234567'],
+    'letters' => ['abcdef'],
+    'embedded space' => ['123 456'],
+    'json number' => [123456],
+]);
+
+it('answers 400 when the code key is missing', function () {
+    $this->postJson('/api/totem/auth', [])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+});
+
+it('answers the same 401 for unknown, expired, consumed and inactive codes', function (array $state, bool $unknown) {
+    $preset = TotemPreset::factory()->create(array_merge(['login_code' => '111111'], $state));
+    $code = $unknown ? '000000' : $preset->login_code;
+
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with([
+    'unknown' => [[], true],
+    'expired' => [['login_code_expires_at' => now()->subSecond()], false],
+    'consumed' => [['login_code_consumed_at' => now()->subMinute()], false],
+    'inactive preset' => [['is_active' => false], false],
+]);
+
+it('accepts a code only once', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertOk();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('rejects the old code once a new pairing window is opened', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '111111']);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    $this->postJson('/api/totem/auth', ['code' => '111111'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('rate limits pairing attempts to 10 per minute', function () {
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])
+            ->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('audits pairing success and failure without ever logging the code', function () {
+    $logged = [];
+    $audit = Mockery::mock();
+    $audit->shouldReceive('info', 'warning')->andReturnUsing(function (string $message, array $context) use (&$logged) {
+        $logged[] = [$message, $context];
+    });
+
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    $preset = TotemPreset::factory()->create(['login_code' => '222222']);
+
+    $this->postJson('/api/totem/auth', ['code' => '999999'])->assertStatus(401);
+    $this->postJson('/api/totem/auth', ['code' => '222222'])->assertOk();
+
+    $messages = array_column($logged, 0);
+
+    expect($messages)->toContain('Totem pairing rejected', 'Totem paired')
+        ->and(json_encode($logged))->not->toContain('222222')
+        ->and(json_encode($logged))->not->toContain('999999')
+        ->and($logged[0][1]['reason'])->toBe('unknown')
+        ->and($logged[1][1]['preset_id'])->toBe($preset->id);
+});
