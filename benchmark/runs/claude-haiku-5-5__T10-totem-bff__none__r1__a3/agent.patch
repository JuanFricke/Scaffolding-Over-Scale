@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Exceptions;
+
+use Symfony\Component\HttpKernel\Exception\HttpException;
+
+/**
+ * Totem API failure with a stable machine-readable `code`.
+ *
+ * Rendered as `{"code": "..."}` with the matching HTTP status by the
+ * exception handler (bootstrap/app.php). Extends HttpException so Laravel does
+ * not report these expected client errors.
+ */
+class TotemApiException extends HttpException
+{
+    public function __construct(int $status, public readonly string $errorCode)
+    {
+        parent::__construct($status, $errorCode);
+    }
+
+    public static function invalidCodeFormat(): self
+    {
+        return new self(400, 'invalid_code_format');
+    }
+
+    public static function invalidPairingCode(): self
+    {
+        return new self(401, 'invalid_pairing_code');
+    }
+
+    public static function invalidToken(): self
+    {
+        return new self(401, 'invalid_token');
+    }
+
+    public static function forbidden(): self
+    {
+        return new self(403, 'forbidden');
+    }
+
+    public static function queueNotFound(): self
+    {
+        return new self(404, 'queue_not_found');
+    }
+
+    public static function inactiveQueue(): self
+    {
+        return new self(422, 'inactive_queue');
+    }
+
+    public static function invalidPriority(): self
+    {
+        return new self(422, 'invalid_priority');
+    }
+}
