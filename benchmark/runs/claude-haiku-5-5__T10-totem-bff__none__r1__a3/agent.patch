@@ -0,0 +1,51 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Context\TotemContext;
+use App\Enums\TicketChannel;
+use App\Enums\TotemPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\TotemApiException;
+use App\Http\Controllers\Controller;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemTicketController extends Controller
+{
+    /**
+     * Issue a ticket in a queue with a backend-owned priority, via the IssueTicket domain action.
+     */
+    public function store(
+        string $entity,
+        string $queue,
+        Request $request,
+        TotemContext $context,
+        IssueTicket $issueTicket,
+    ): JsonResponse {
+        $context->assertEntity($entity);
+
+        $queueModel = $context->resolveQueue($queue);
+
+        $value = $request->input('priority');
+        $priority = is_int($value) ? TotemPriority::tryFrom($value) : null;
+
+        if ($priority === null) {
+            throw TotemApiException::invalidPriority();
+        }
+
+        try {
+            $ticket = $issueTicket($queueModel, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            throw TotemApiException::inactiveQueue();
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => ['value' => $priority->value, 'label' => $priority->label()],
+            'issued_at' => $ticket->issued_at->utc()->format('Y-m-d\TH:i:s\Z'),
+        ], 201);
+    }
+}
diff --git a/app/Http/Middleware/AuthenticateTotem.php b/app/Http/Middleware/AuthenticateTotem.php
new file mode 100644
index 0000000..b69e6b0
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,84 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Context\TotemContext;
+use App\Exceptions\TotemApiException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemToken;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Validates `Authorization: Bearer <jwt>` on every totem call and binds TotemContext.
+ *
+ * Every failure is the same 401 invalid_token. Revalidates the totem and preset
+ * on each request, so deactivation takes effect without waiting for token expiry.
+ */
+class AuthenticateTotem
+{
+    public function __construct(private readonly TotemToken $tokens) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $claims = $this->claimsFrom($request);
+
+        $totem = Totem::query()->find($claims['totem_id']);
+
+        if ($totem === null || ! $totem->is_active) {
+            throw TotemApiException::invalidToken();
+        }
+
+        $preset = TotemPreset::query()->with('entity')->find($claims['preset_id']);
+
+        if ($preset === null || ! $preset->is_active || $preset->entity === null) {
+            throw TotemApiException::invalidToken();
+        }
+
+        $entityId = $claims['entity_id'];
+
+        if ((int) $totem->entity_id !== $entityId || (int) $preset->entity_id !== $entityId) {
+            throw TotemApiException::invalidToken();
+        }
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $presetQueueIds = $preset->queues()
+            ->pluck('queues.id')
+            ->map(fn ($id): int => (int) $id)
+            ->all();
+
+        $queueIds = array_values(array_intersect($claims['queues'], $presetQueueIds));
+
+        app()->instance(TotemContext::class, new TotemContext($totem, $preset, $preset->entity, $queueIds));
+
+        return $next($request);
+    }
+
+    /**
+     * @return array{totem_id: int, entity_id: int, preset_id: int, queues: list<int>}
+     */
+    private function claimsFrom(Request $request): array
+    {
+        $token = $request->bearerToken();
+        $claims = $token === null ? null : $this->tokens->decode($token);
+
+        if ($claims === null
+            || ! is_int($claims['totem_id'] ?? null)
+            || ! is_int($claims['entity_id'] ?? null)
+            || ! is_int($claims['preset_id'] ?? null)
+            || ! is_array($claims['queues'] ?? null)
+        ) {
+            throw TotemApiException::invalidToken();
+        }
+
+        return [
+            'totem_id' => $claims['totem_id'],
+            'entity_id' => $claims['entity_id'],
+            'preset_id' => $claims['preset_id'],
+            'queues' => array_map('intval', $claims['queues']),
+        ];
+    }
+}
