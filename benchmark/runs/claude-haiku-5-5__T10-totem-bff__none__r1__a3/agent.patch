@@ -0,0 +1,59 @@
+<?php
+
+namespace App\Context;
+
+use App\Exceptions\TotemApiException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+
+/**
+ * In-request totem context, bound by the totem.auth middleware (like Tenant).
+ *
+ * `queueIds` is the effective scope: the JWT `queues` claim intersected with the
+ * preset's current queue join, so queue removals apply to existing tokens.
+ */
+class TotemContext
+{
+    /**
+     * @param  list<int>  $queueIds
+     */
+    public function __construct(
+        public readonly Totem $totem,
+        public readonly TotemPreset $preset,
+        public readonly Entity $entity,
+        public readonly array $queueIds,
+    ) {}
+
+    /**
+     * Path entity must be the token's entity.
+     */
+    public function assertEntity(string $slug): void
+    {
+        if ($slug !== $this->entity->slug) {
+            throw TotemApiException::forbidden();
+        }
+    }
+
+    /**
+     * Resolve a queue slug within the token's entity only.
+     */
+    public function resolveQueue(string $slug): Queue
+    {
+        $queue = Queue::query()
+            ->where('entity_id', $this->entity->id)
+            ->where('slug', $slug)
+            ->first();
+
+        if ($queue === null) {
+            throw TotemApiException::queueNotFound();
+        }
+
+        if (! in_array($queue->id, $this->queueIds, true)) {
+            throw TotemApiException::forbidden();
+        }
+
+        return $queue;
+    }
+}
