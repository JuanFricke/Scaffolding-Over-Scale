+<?php
+
+namespace App\Exceptions;
+
+use RuntimeException;
+
+/**
+ * A pairing code was rejected. `reason` is for the audit log only; the HTTP
+ * response is always the same (no oracle).
+ */
+class InvalidPairingCodeException extends RuntimeException
+{
+    public function __construct(public readonly string $reason)
+    {
+        parent::__construct('Invalid pairing code: '.$reason);
+    }
+}
