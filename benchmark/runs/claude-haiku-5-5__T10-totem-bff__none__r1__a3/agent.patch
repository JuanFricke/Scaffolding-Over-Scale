+    | Cross-Origin Resource Sharing (CORS) Configuration
+    |--------------------------------------------------------------------------
+    |
+    | Only the totem API answers CORS. The totem's web build runs on a local
+    | static server during development, so localhost and 127.0.0.1 (any port,
+    | http or https) are allowed, plus the optional TOTEM_WEB_ORIGIN. Every
+    | other origin gets no Access-Control-Allow-Origin header. No credentials.
+    |
+    */
+
+    'paths' => ['api/*'],
+
+    'allowed_methods' => ['*'],
+
+    // Explicit list: a "*" wildcard does not cover the Authorization header.
+    'allowed_headers' => ['Accept', 'Authorization', 'Content-Type', 'X-Requested-With'],
+
+    'allowed_origins' => array_values(array_filter([
