@@ -0,0 +1,33 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Opens a pairing window for a preset: a new random code, valid for 10 minutes,
+ * replacing any previous code (old code stops working immediately).
+ */
+class OpenTotemPairing
+{
+    public function __invoke(TotemPreset $preset): string
+    {
+        $code = TotemPreset::newLoginCode();
+
+        $preset->update([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(TotemPreset::PAIRING_CODE_TTL_MINUTES),
+            'login_code_consumed_at' => null,
+        ]);
+
+        // The code itself is never logged.
+        Log::channel('audit')->info('Totem pairing window opened', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $preset->login_code_expires_at->toIso8601String(),
+        ]);
+
+        return $code;
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
new file mode 100644
index 0000000..4009bf3
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,73 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\PairedTotem;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Consumes a preset's pairing code and creates the totem device row, atomically.
+ */
+class PairTotem
+{
+    /**
+     * @throws InvalidPairingCodeException
+     */
+    public function __invoke(string $code): PairedTotem
+    {
+        return DB::transaction(function () use ($code): PairedTotem {
+            // Locking the preset row serializes concurrent attempts with the same code:
+            // the loser re-reads it after the winner commits and sees it consumed.
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->with('entity')
+                ->first();
+
+            if ($preset === null) {
+                throw new InvalidPairingCodeException('unknown');
+            }
+
+            $reason = $this->rejectionReason($preset);
+
+            if ($reason !== null) {
+                throw new InvalidPairingCodeException($reason);
+            }
+
+            $preset->update(['login_code_consumed_at' => now()]);
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            return new PairedTotem($totem, $preset);
+        });
+    }
+
+    private function rejectionReason(TotemPreset $preset): ?string
+    {
+        if ($preset->login_code_consumed_at !== null) {
+            return 'consumed';
+        }
+
+        if ($preset->login_code_expires_at === null || $preset->login_code_expires_at->isPast()) {
+            return 'expired';
+        }
+
+        if (! $preset->is_active) {
+            return 'preset_inactive';
+        }
+
+        if ($preset->entity === null) {
+            return 'entity_unavailable';
+        }
+
+        return null;
+    }
+}
