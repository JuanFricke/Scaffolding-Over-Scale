@@ -0,0 +1,72 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Context\TotemContext;
+use App\Enums\TotemPriority;
+use App\Exceptions\TotemApiException;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+
+class TotemQueueController extends Controller
+{
+    /**
+     * Active queues in the preset's scope for this entity, ordered by name.
+     */
+    public function index(string $entity, TotemContext $context): JsonResponse
+    {
+        $context->assertEntity($entity);
+
+        $queues = Queue::query()
+            ->where('entity_id', $context->entity->id)
+            ->where('is_active', true)
+            ->whereIn('id', $context->queueIds)
+            ->orderBy('name')
+            ->orderBy('id')
+            ->get();
+
+        return response()->json([
+            'entity' => ['slug' => $context->entity->slug, 'name' => $context->entity->name],
+            'queues' => $queues->map(function (Queue $queue, int $index) use ($context): array {
+                $appearance = $context->preset->queueAppearance($queue->slug);
+
+                return [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => $appearance['description'],
+                    'visual' => [
+                        'color' => $appearance['color'],
+                        'icon' => $appearance['icon'],
+                        'order' => $index + 1,
+                    ],
+                    'is_active' => true,
+                ];
+            })->values()->all(),
+        ]);
+    }
+
+    /**
+     * Backend-owned priority levels for one queue.
+     */
+    public function priorities(string $entity, string $queue, TotemContext $context): JsonResponse
+    {
+        $context->assertEntity($entity);
+
+        $queueModel = $context->resolveQueue($queue);
+
+        if (! $queueModel->is_active) {
+            throw TotemApiException::inactiveQueue();
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $context->entity->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => array_map(fn (TotemPriority $priority): array => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+                'visual' => $priority->visual(),
+            ], TotemPriority::cases()),
+        ]);
+    }
+}
