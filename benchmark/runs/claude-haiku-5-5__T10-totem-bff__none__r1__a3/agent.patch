+        $this->withHeaders($headers)
+            ->postJson("/api/{$entity->slug}/{$slug}/ticket", ['priority' => 0])
+            ->assertStatus(404)
+            ->assertExactJson(['code' => 'queue_not_found']);
+    }
+});
+
+it('returns 403 for a queue of the same entity that is outside the preset scope', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'fora']);
+    $headers = totemBearer($totem, $preset);
+
+    $this->withHeaders($headers)
+        ->getJson("/api/{$entity->slug}/fora/priorities")
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+
+    $this->withHeaders($headers)
+        ->postJson("/api/{$entity->slug}/fora/ticket", ['priority' => 0])
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+it('applies queue removals from the preset to existing tokens immediately', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+    $preset->queues()->attach($queue);
+
+    $headers = totemBearer($totem, $preset);
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/queues")->assertJsonCount(1, 'queues');
+
+    $preset->queues()->detach($queue);
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/queues")->assertJsonCount(0, 'queues');
+
+    $this->withHeaders($headers)
+        ->postJson("/api/{$entity->slug}/geral/ticket", ['priority' => 0])
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('does not grant queues attached after the token was issued', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $early = Queue::factory()->for($entity)->create(['slug' => 'cedo']);
+    $late = Queue::factory()->for($entity)->create(['slug' => 'tarde']);
+
+    $preset->queues()->attach($early);
+    $headers = totemBearer($totem, $preset);
+
+    $preset->queues()->attach($late);
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/tarde/priorities")
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/cedo/priorities")->assertOk();
+});
+
+// --- Priorities -----------------------------------------------------------
+
+it('returns the backend-owned priorities for a queue', function () {
+    [$entity, $preset, $totem] = totemFixture();
