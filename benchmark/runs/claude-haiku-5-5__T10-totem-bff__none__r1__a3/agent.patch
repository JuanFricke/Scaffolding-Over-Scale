+<?php
+
+namespace App\Models;
+
+use Database\Factories\TotemPresetFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\BelongsToMany;
+
+/**
+ * Limited totem configuration: which queues a paired totem sees and how it looks.
+ * Owns its own pairing code (login_code), never shared across presets.
+ */
+#[Fillable([
+    'entity_id',
+    'name',
+    'login_code',
+    'login_code_expires_at',
+    'login_code_consumed_at',
+    'appearance',
+    'is_active',
+])]
+class TotemPreset extends Model
+{
+    /** @use HasFactory<TotemPresetFactory> */
+    use HasFactory;
+
+    public const PAIRING_CODE_TTL_MINUTES = 10;
+
+    public const DEFAULT_QUEUE_COLOR = '#0055FF';
+
+    public const DEFAULT_QUEUE_ICON = 'ticket';
+
+    /**
+     * Cryptographically random 6-digit code, zero-padded, not used by any other preset.
+     */
+    public static function newLoginCode(): string
+    {
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while (self::query()->where('login_code', $code)->exists());
+
+        return $code;
+    }
+
+    /**
+     * Presentation for one queue as seen on this preset's totem.
+     *
+     * Read from `appearance.queues.{slug}` (color, icon, description); any missing
+     * key falls back to the default. Display order is decided by the caller.
+     *
+     * @return array{description: ?string, color: string, icon: string}
+     */
+    public function queueAppearance(string $queueSlug): array
+    {
+        $queue = $this->appearance['queues'][$queueSlug] ?? [];
+
+        return [
+            'description' => $queue['description'] ?? null,
+            'color' => $queue['color'] ?? self::DEFAULT_QUEUE_COLOR,
+            'icon' => $queue['icon'] ?? self::DEFAULT_QUEUE_ICON,
+        ];
+    }
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'is_active' => 'boolean',
+            'login_code_expires_at' => 'datetime',
+            'login_code_consumed_at' => 'datetime',
+            'appearance' => 'array',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Queues this preset may see and issue from.
+     *
+     * @return BelongsToMany<Queue, $this>
+     */
+    public function queues(): BelongsToMany
+    {
+        return $this->belongsToMany(Queue::class, 'totem_preset_queue', 'preset_id', 'queue_id')
+            ->withTimestamps();
+    }
+}
