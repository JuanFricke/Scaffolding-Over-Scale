+// Totem API (BFF for pegafila_totem). Contract: docs/api/totem.md.
+
+Route::post('totem/auth', [TotemAuthController::class, 'store'])
+    ->middleware('throttle:10,1')
+    ->name('api.totem.auth');
+
+Route::middleware('totem.auth')->group(function () {
+    Route::get('{entity}/queues', [TotemQueueController::class, 'index'])
+        ->name('api.totem.queues');
+
+    Route::get('{entity}/{queue}/priorities', [TotemQueueController::class, 'priorities'])
+        ->name('api.totem.priorities');
+
+    Route::post('{entity}/{queue}/ticket', [TotemTicketController::class, 'store'])
+        ->middleware('throttle:30,1')
+        ->name('api.totem.tickets.store');
+});
