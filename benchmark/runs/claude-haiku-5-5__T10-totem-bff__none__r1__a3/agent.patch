--- /dev/null
+++ b/app/Totem/TotemToken.php
@@ -0,0 +1,77 @@
+<?php
+
+namespace App\Totem;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use DomainException;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use Illuminate\Support\Str;
+use InvalidArgumentException;
+use RuntimeException;
+use UnexpectedValueException;
+
+/**
+ * HS256 JWTs for paired totems. Claims: totem_id, entity_id, preset_id, queues
+ * (allowed queue ids at pairing time), iat, exp, jti.
+ *
+ * Secret and TTL come from config services.totem.* (env TOTEM_JWT_SECRET / TOTEM_JWT_TTL).
+ */
+class TotemToken
+{
+    private const ALGORITHM = 'HS256';
+
+    private const MIN_SECRET_LENGTH = 32;
+
+    public function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl', 3600);
+    }
+
+    public function issue(Totem $totem, TotemPreset $preset): string
+    {
+        $issuedAt = time();
+
+        $queueIds = $preset->queues()
+            ->pluck('queues.id')
+            ->map(fn ($id): int => (int) $id)
+            ->values()
+            ->all();
+
+        return JWT::encode([
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => $queueIds,
+            'iat' => $issuedAt,
+            'exp' => $issuedAt + $this->ttl(),
+            'jti' => (string) Str::uuid(),
+        ], $this->secret(), self::ALGORITHM);
+    }
+
+    /**
+     * Verified claims, or null when the token is malformed, mis-signed, expired or not yet valid.
+     *
+     * @return array<string, mixed>|null
+     */
+    public function decode(string $token): ?array
+    {
+        try {
+            return (array) JWT::decode($token, new Key($this->secret(), self::ALGORITHM));
+        } catch (UnexpectedValueException|DomainException|InvalidArgumentException) {
+            return null;
+        }
+    }
+
+    private function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if (strlen($secret) < self::MIN_SECRET_LENGTH) {
+            throw new RuntimeException('TOTEM_JWT_SECRET must be at least '.self::MIN_SECRET_LENGTH.' characters.');
+        }
+
+        return $secret;
+    }
+}
