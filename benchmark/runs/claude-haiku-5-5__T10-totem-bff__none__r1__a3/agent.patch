new file mode 100644
index 0000000..7c89ee7
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemAuthController.php
@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use App\Exceptions\TotemApiException;
+use App\Http\Controllers\Controller;
+use App\Totem\TotemToken;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    /**
+     * Pair a totem with its preset's login code and issue a JWT.
+     */
+    public function store(Request $request, PairTotem $pairTotem, TotemToken $tokens): JsonResponse
+    {
+        // Must be a JSON string of exactly six digits; never log the code itself.
+        $code = $request->input('code');
+
+        if (! is_string($code) || ! preg_match('/\A\d{6}\z/', $code)) {
+            Log::channel('audit')->warning('Totem pairing rejected', [
+                'reason' => 'invalid_code_format',
+                'ip' => $request->ip(),
+            ]);
+
+            throw TotemApiException::invalidCodeFormat();
+        }
+
+        try {
+            $paired = $pairTotem($code);
+        } catch (InvalidPairingCodeException $e) {
+            Log::channel('audit')->warning('Totem pairing rejected', [
+                'reason' => $e->reason,
+                'ip' => $request->ip(),
+            ]);
+
+            throw TotemApiException::invalidPairingCode();
+        }
+
+        $entity = $paired->preset->entity;
+
+        Log::channel('audit')->info('Totem paired', [
+            'totem_id' => $paired->totem->id,
+            'entity_id' => $entity->id,
+            'preset_id' => $paired->preset->id,
+            'ip' => $request->ip(),
+        ]);
+
+        return response()->json([
+            'token' => $tokens->issue($paired->totem, $paired->preset),
+            'token_type' => 'Bearer',
+            'expires_in' => $tokens->ttl(),
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+        ]);
+    }
+}
