+
+it('returns 422 inactive_queue and creates no ticket for an inactive queue', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'pausada', 'is_active' => false]);
+    $preset->queues()->attach($queue);
+
+    $this->withHeaders(totemBearer($totem, $preset))
+        ->postJson("/api/{$entity->slug}/pausada/ticket", ['priority' => 0])
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('returns 403 forbidden when the path entity is not the token entity', function () {
+    [, $preset, $totem] = totemFixture();
+    $other = Entity::factory()->create();
+    $queue = Queue::factory()->for($other)->create(['slug' => 'geral']);
+
+    $this->withHeaders(totemBearer($totem, $preset))
+        ->postJson("/api/{$other->slug}/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('limits ticket issuance to 30 requests per minute', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral']);
+    $preset->queues()->attach($queue);
+    $headers = totemBearer($totem, $preset);
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->withHeaders($headers)
+            ->postJson("/api/{$entity->slug}/geral/ticket", ['priority' => 0])
