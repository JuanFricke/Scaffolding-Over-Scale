+<?php
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemToken;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function totemPreflight(string $origin, string $path = '/api/totem/auth', string $headers = 'content-type')
+{
+    return test()->call('OPTIONS', $path, [], [], [], [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+        'HTTP_ACCESS_CONTROL_REQUEST_HEADERS' => $headers,
+    ]);
+}
+
+it('answers the preflight for the local totem web build with 204 and echoes the origin', function (string $origin) {
+    totemPreflight($origin)
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', $origin);
+})->with([
+    'localhost port' => ['http://localhost:8081'],
+    'localhost no port' => ['http://localhost'],
+    '127.0.0.1 https' => ['https://127.0.0.1:8443'],
+    'localhost https' => ['https://localhost'],
+]);
+
+it('sends no Access-Control-Allow-Origin for other origins', function (string $origin) {
+    $preflight = totemPreflight($origin);
+
+    expect($preflight->headers->has('Access-Control-Allow-Origin'))->toBeFalse();
+
+    $this->withHeaders(['Origin' => $origin])
+        ->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(401);
+
+})->with([
+    'public site' => ['https://evil.example'],
+    'lookalike host' => ['http://localhost.evil.example'],
+    'lan address' => ['http://192.168.0.10:8081'],
+    'localhost with path' => ['http://localhost:8081/app'],
+]);
+
+it('does not answer CORS outside the api paths', function () {
+    $this->call('OPTIONS', '/up', [], [], [], [
+        'HTTP_ORIGIN' => 'http://localhost:8081',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'GET',
+    ])->assertHeaderMissing('Access-Control-Allow-Origin');
+});
+
+it('allows the Authorization header on API preflights', function () {
+    totemPreflight('http://localhost:8081', '/api/geral/queues', 'authorization')
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+});
+
+it('echoes an actual API response to an allowed origin', function () {
+
+    $preset = TotemPreset::factory()->create();
+    $totem = Totem::factory()->create(['entity_id' => $preset->entity_id]);
+    $entity = $preset->entity;
+
+    $this->withHeaders([
+        'Origin' => 'http://127.0.0.1:8081',
+        'Authorization' => 'Bearer '.app(TotemToken::class)->issue($totem, $preset),
+    ])->getJson("/api/{$entity->slug}/queues")
+        ->assertOk()
+        ->assertHeader('Access-Control-Allow-Origin', 'http://127.0.0.1:8081');
+});
+
+it('allows an extra origin from TOTEM_WEB_ORIGIN', function () {
+    $_SERVER['TOTEM_WEB_ORIGIN'] = 'https://totem.pegafila.test';
+    $this->refreshApplication();
+
+    try {
+        totemPreflight('https://totem.pegafila.test')
+            ->assertStatus(204)
+            ->assertHeader('Access-Control-Allow-Origin', 'https://totem.pegafila.test');
+    } finally {
+        unset($_SERVER['TOTEM_WEB_ORIGIN']);
+    }
+});
+
+it('does not allow an origin when TOTEM_WEB_ORIGIN is unset', function () {
+    totemPreflight('https://totem.pegafila.test')
+        ->assertStatus(204)
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+});
