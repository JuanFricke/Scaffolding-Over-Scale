+
+    $this->withHeaders($headers)
+        ->postJson("/api/{$entity->slug}/geral/ticket", ['priority' => 0])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
diff --git a/tests/Feature/Totem/TotemCorsTest.php b/tests/Feature/Totem/TotemCorsTest.php
