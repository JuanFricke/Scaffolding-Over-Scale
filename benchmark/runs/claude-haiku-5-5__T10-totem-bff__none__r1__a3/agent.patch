+<?php
+
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemToken;
+use Firebase\JWT\JWT;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Entity, active preset (with a totem already paired) and the totem's entity-scoped queue.
+ *
+ * @return array{0: Entity, 1: TotemPreset, 2: Totem}
+ */
+function totemFixture(array $presetAttributes = []): array
+{
+    $preset = TotemPreset::factory()->create($presetAttributes);
+    $totem = Totem::factory()->create(['entity_id' => $preset->entity_id]);
+
+    return [$preset->entity, $preset, $totem];
+}
+
+/**
+ * Bearer header for a token issued the same way pairing does (current queue scope).
+ *
+ * @return array<string, string>
+ */
+function totemBearer(Totem $totem, TotemPreset $preset): array
+{
+    return ['Authorization' => 'Bearer '.app(TotemToken::class)->issue($totem, $preset)];
+}
+
+/**
+ * Sign arbitrary claims with the test secret, to simulate expired or foreign tokens.
+ *
+ * @return array<string, string>
+ */
+function totemBearerWithClaims(array $claims, ?string $secret = null): array
+{
+    $now = time();
+    $payload = array_merge([
+        'totem_id' => 0,
+        'entity_id' => 0,
+        'preset_id' => 0,
+        'queues' => [],
+        'iat' => $now,
+        'exp' => $now + 3600,
+        'jti' => 'test',
+    ], $claims);
+
+    return ['Authorization' => 'Bearer '.JWT::encode($payload, $secret ?? config('services.totem.jwt_secret'), 'HS256')];
+}
+
+/**
+ * @return array<string, mixed>
+ */
+function totemClaimsFor(Totem $totem, TotemPreset $preset): array
+{
+    return [
+        'totem_id' => $totem->id,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+    ];
+}
+
+// --- Authentication -------------------------------------------------------
+
+it('rejects missing and malformed tokens with 401 invalid_token', function (array $headers) {
+    [$entity] = totemFixture();
+
+    $this->withHeaders($headers)
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+})->with([
+    'no header' => [[]],
+    'not a jwt' => [['Authorization' => 'Bearer not-a-jwt']],
+    'wrong scheme' => [['Authorization' => 'Basic dXNlcjpwYXNz']],
+]);
+
+it('rejects expired tokens and tokens signed with another secret', function () {
+    [$entity, $preset, $totem] = totemFixture();
+
+    $expired = totemBearerWithClaims(array_merge(totemClaimsFor($totem, $preset), [
+        'iat' => time() - 7200,
+        'exp' => time() - 3600,
+    ]));
+
+    $foreign = totemBearerWithClaims(
+        totemClaimsFor($totem, $preset),
+        'another-secret-that-is-long-enough-0123456789',
+    );
+
+    foreach ([$expired, $foreign] as $headers) {
+        $this->withHeaders($headers)
+            ->getJson("/api/{$entity->slug}/queues")
+            ->assertStatus(401)
+            ->assertExactJson(['code' => 'invalid_token']);
+    }
+});
+
+it('rejects a token whose totem is inactive or deleted', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $headers = totemBearer($totem, $preset);
+
+    $totem->update(['is_active' => false]);
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+
+    $totem->update(['is_active' => true]);
+    $totem->delete();
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose preset is inactive or deleted', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $headers = totemBearer($totem, $preset);
+
+    $preset->update(['is_active' => false]);
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+
+    $preset->update(['is_active' => true]);
+    $preset->delete();
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose entity claim does not match the totem and preset', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $otherEntity = Entity::factory()->create();
+
+    $headers = totemBearerWithClaims(array_merge(totemClaimsFor($totem, $preset), [
+        'entity_id' => $otherEntity->id,
+    ]));
+
+    $this->withHeaders($headers)->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('refreshes last_seen_at on every authenticated call', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $totem->update(['last_seen_at' => now()->subDay()]);
+
+    $this->withHeaders(totemBearer($totem, $preset))
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertOk();
+
+    expect($totem->refresh()->last_seen_at->gt(now()->subMinute()))->toBeTrue();
+});
+
+// --- Queues ---------------------------------------------------------------
+
+it('lists only active queues in the preset scope, ordered by name, with visuals', function () {
+    [$entity, $preset, $totem] = totemFixture([
+        'appearance' => [
+            'queues' => [
+                'caixa' => ['color' => '#112233', 'icon' => 'cash', 'description' => 'Pagamentos'],
+            ],
+        ],
+    ]);
+
+    $caixa = Queue::factory()->for($entity)->create(['name' => 'Caixa', 'slug' => 'caixa']);
+    $atendimento = Queue::factory()->for($entity)->create(['name' => 'Atendimento', 'slug' => 'atendimento']);
+    $balcao = Queue::factory()->for($entity)->create(['name' => 'Balcão', 'slug' => 'balcao']);
+    $inactive = Queue::factory()->for($entity)->create(['name' => 'Arquivo', 'slug' => 'arquivo', 'is_active' => false]);
+    // Sorts first by name, but is not in the preset scope.
+    Queue::factory()->for($entity)->create(['name' => 'Aaa', 'slug' => 'aaa']);
+
+    $preset->queues()->attach([$caixa->id, $atendimento->id, $balcao->id, $inactive->id]);
+
+    $response = $this->withHeaders(totemBearer($totem, $preset))
+        ->getJson("/api/{$entity->slug}/queues");
+
+    $response->assertOk()
+        ->assertJsonPath('entity', ['slug' => $entity->slug, 'name' => $entity->name])
+        ->assertJsonCount(3, 'queues')
+        ->assertJsonMissing(['slug' => 'aaa'])
+        ->assertJsonMissing(['slug' => 'arquivo'])
+        ->assertJsonPath('queues.0', [
+            'slug' => 'atendimento',
+            'label' => 'Atendimento',
+            'description' => null,
+            'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => 1],
+            'is_active' => true,
+        ])
+        ->assertJsonPath('queues.1.slug', 'balcao')
+        ->assertJsonPath('queues.1.visual.order', 2)
+        ->assertJsonPath('queues.2', [
+            'slug' => 'caixa',
+            'label' => 'Caixa',
+            'description' => 'Pagamentos',
+            'visual' => ['color' => '#112233', 'icon' => 'cash', 'order' => 3],
+            'is_active' => true,
+        ]);
+});
+
+it('returns 403 for another entity slug on the queues list', function () {
+    [, $preset, $totem] = totemFixture();
+    $other = Entity::factory()->create();
+
+    $this->withHeaders(totemBearer($totem, $preset))
+        ->getJson("/api/{$other->slug}/queues")
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('returns 404 queue_not_found for unknown slugs and for another entity queue slug', function () {
+    [$entity, $preset, $totem] = totemFixture();
+    $headers = totemBearer($totem, $preset);
+
+    $otherEntity = Entity::factory()->create();
+    Queue::factory()->for($otherEntity)->create(['slug' => 'geral']);
