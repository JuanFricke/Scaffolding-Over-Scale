diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..2c232d8
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,111 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Arr;
+use Illuminate\Support\Str;
+
+/**
+ * Service for sending operational alerts to Discord via an incoming webhook.
+ */
+class DiscordOpsAlert
+{
+    /**
+     * Send an alert to Discord.
+     *
+     * @param string $title   Title of the alert.
+     * @param string $message Body message.
+     * @param array  $context Optional associative context data.
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhook = config('services.discord.webhook_url');
+        if (empty($webhook)) {
+            return;
+        }
+
+        // Build content
+        $content = $this->buildContent($title, $message, $context);
+
+        try {
+            $response = Http::timeout(3)->post($webhook, [
+                'content' => $content,
+            ]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (\Throwable $e) {
+            // Remove any potential webhook URL from exception message
+            $msg = $e->getMessage();
+            $msg = str_replace($webhook, '[REDACTED]', $msg);
+            Log::error('Discord ops alert exception', [
+                'error' => $msg,
+                'code' => $e->getCode(),
+            ]);
+        }
+    }
+
+    /**
+     * Build the message content string.
+     */
+    protected function buildContent(string $title, string $message, array $context): string
+    {
+        $parts = [$title, $message];
+        if (! empty($context)) {
+            foreach ($this->redactContext($context) as $key => $value) {
+                $parts[] = "$key=$value";
+            }
+        }
+        $text = implode("\n", $parts);
+        // Truncate to 1800 multibyte safe
+        if (mb_strlen($text, 'UTF-8') > 1800) {
+            $text = mb_substr($text, 0, 1800, 'UTF-8');
+        }
+        return $text;
+    }
+
+    /**
+     * Recursively redact context data.
+     */
+    protected function redactContext(array $data): array
+    {
+        $sensitiveKeys = ['password', 'token', 'secret', 'authorization', 'api_key', 'api-key', 'apikey', 'webhook'];
+        $result = [];
+        foreach ($data as $key => $value) {
+            $keyLower = Str::lower($key);
+            $isSensitiveKey = false;
+            foreach ($sensitiveKeys as $sk) {
+                if (Str::contains($keyLower, Str::lower($sk))) {
+                    $isSensitiveKey = true;
+                    break;
+                }
+            }
+
+            if ($isSensitiveKey) {
+                $result[$key] = '[redacted]';
+                continue;
+            }
+
+            if (is_array($value)) {
+                $redacted = $this->redactContext($value);
+                $result[$key] = json_encode($redacted, JSON_UNESCAPED_UNICODE);
+                continue;
+            }
+
+            if (is_string($value) && preg_match('/Bearer\s+\S+/i', $value)) {
+                $result[$key] = '[redacted]';
+                continue;
+            }
+
+            $result[$key] = $value;
+        }
+        return $result;
+    }
+}
+
+?>
