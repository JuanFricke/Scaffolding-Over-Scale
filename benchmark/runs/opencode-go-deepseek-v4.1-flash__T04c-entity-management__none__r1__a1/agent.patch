@@ -0,0 +1,132 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public int $boundEntityId;
+
+    public int $entityId;
+
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    public $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->boundEntityId = (int) $entity->getKey();
+        $this->entityId = (int) $entity->getKey();
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        $entity = $this->entity();
+
+        $this->authorize('manageSettings', $entity);
+
+        $validated = $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => [
+                'required',
+                'string',
+                'max:255',
+                Rule::unique('entities', 'slug')->ignore($entity->getKey()),
+            ],
+        ]);
+
+        $entity->update($validated);
+
+        $this->entity = $entity->fresh();
+    }
+
+    public function delete(): void
+    {
+        $entity = $this->entity();
+
+        $this->authorize('manageSettings', $entity);
+
+        DB::transaction(function () use ($entity): void {
+            $entity->memberships()->delete();
+            $entity->delete();
+        });
+
+        if ((int) session('current_entity_id') === (int) $entity->getKey()) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirectRoute('home');
+    }
+
+    public function transfer(): void
+    {
+        $entity = $this->entity();
+
+        $this->authorize('manageSettings', $entity);
+
+        DB::transaction(function () use ($entity): void {
+            $owner = $entity->memberships()
+                ->where('role', UserRole::Owner)
+                ->lockForUpdate()
+                ->first();
+
+            abort_if($owner === null, 403);
+
+            $target = $entity->memberships()
+                ->whereKey($this->targetMembershipId)
+                ->where('role', UserRole::Admin)
+                ->lockForUpdate()
+                ->first();
+
+            abort_if(
+                $target === null || (int) $target->user_id === (int) auth()->id(),
+                403,
+            );
+
+            // Free the owner slot before promoting the target: the generated
+            // owner_seq column and its unique index enforce one owner per entity.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+        });
+
+        $this->redirectRoute('entity.dashboard', $entity);
+    }
+
+    public function render(): View
+    {
+        $entity = $this->entity();
+
+        return view('livewire.entity.settings', [
+            'entity' => $entity,
+            'admins' => $entity->memberships()
+                ->with('user')
+                ->where('role', UserRole::Admin)
+                ->orderBy('id')
+                ->get(),
+        ]);
+    }
+
+    private function entity(): Entity
+    {
+        return Entity::query()->findOrFail($this->boundEntityId);
+    }
+}
