diff --git a/app/Livewire/Entity/Members.php b/app/Livewire/Entity/Members.php
new file mode 100644
index 0000000..d11c609
--- /dev/null
+++ b/app/Livewire/Entity/Members.php
@@ -0,0 +1,149 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public int $boundEntityId;
+
+    public int $entityId;
+
+    public Entity $entity;
+
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+        $this->boundEntityId = (int) $entity->getKey();
+        $this->entityId = (int) $entity->getKey();
+    }
+
+    public function addMember(): void
+    {
+        $entity = $this->entity();
+
+        $this->authorize('update', $entity);
+
+        $validated = $this->validate([
+            'email' => ['required', 'email:strict', 'exists:users,email'],
+        ]);
+
+        $user = User::query()->where('email', $validated['email'])->firstOrFail();
+
+        if ($entity->memberships()->where('user_id', $user->getKey())->exists()) {
+            $this->addError('email', __('ui.member_already_exists'));
+
+            return;
+        }
+
+        try {
+            $entity->memberships()->create([
+                'user_id' => $user->getKey(),
+                'role' => UserRole::Employee,
+            ]);
+        } catch (QueryException) {
+            // Handles two requests racing for the same (entity, user) pair.
+            $this->addError('email', __('ui.member_already_exists'));
+
+            return;
+        }
+
+        $this->reset('email');
+        $this->resetErrorBag('email');
+    }
+
+    public function assignRole($membershipId, string $role): void
+    {
+        $entity = $this->entity();
+
+        $this->authorize('update', $entity);
+
+        $validator = Validator::make(
+            ['role' => $role],
+            ['role' => ['required', Rule::in(array_map(
+                fn (UserRole $manageable): string => $manageable->value,
+                UserRole::manageable(),
+            ))]],
+        );
+
+        if ($validator->fails()) {
+            throw new ValidationException($validator);
+        }
+
+        $membership = $this->membership($entity, $membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        // Ownership only moves through the explicit transfer flow.
+        abort_if($membership->role === UserRole::Owner, 403);
+
+        $membership->update(['role' => UserRole::from($role)]);
+    }
+
+    public function removeMember($membershipId): void
+    {
+        $entity = $this->entity();
+
+        $this->authorize('view', $entity);
+
+        $membership = $this->membership($entity, $membershipId);
+
+        $this->authorize('delete', $membership);
+
+        // The owner is never removable, even if the policy is bypassed.
+        abort_if($membership->role === UserRole::Owner, 403);
+
+        $isManager = in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+
+        if ($isManager && $entity->memberships()
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->count() <= 1) {
+            abort(403);
+        }
+
+        $membership->delete();
+    }
+
+    public function render(): View
+    {
+        $entity = $this->entity();
+
+        return view('livewire.entity.members', [
+            'entity' => $entity,
+            'memberships' => $entity->memberships()->with('user')->orderBy('id')->get(),
+            'canManage' => auth()->user()->can('update', $entity),
+        ]);
+    }
+
+    private function entity(): Entity
+    {
+        return Entity::query()->findOrFail($this->boundEntityId);
+    }
+
+    private function membership(Entity $entity, mixed $membershipId): EntityMembership
+    {
+        $membership = $entity->memberships()->whereKey($membershipId)->first();
+
+        abort_if($membership === null, 403);
+
+        return $membership;
+    }
+}
