+<?php
+
+namespace App\Models;
+
+enum UserRole: string
+{
+    case Owner = 'owner';
+    case Admin = 'admin';
+    case Employee = 'employee';
+
+    /**
+     * Roles that can be assigned through the members screen.
+     *
+     * Ownership is transferred explicitly; it is never assigned as a role.
+     *
+     * @return array<int, self>
+     */
+    public static function manageable(): array
+    {
+        return [self::Admin, self::Employee];
+    }
+}
