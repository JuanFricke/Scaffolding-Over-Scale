@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $this->membershipFor($user, $membership) !== null;
+    }
+
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->isManager($user, $membership);
+    }
+
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        // The owner can never be removed; ownership has to be transferred first.
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        // Any member may remove themselves (leave the entity).
+        if ((int) $membership->user_id === (int) $user->getKey()) {
+            return true;
+        }
+
+        return $this->isManager($user, $membership);
+    }
+
+    private function isManager(User $user, EntityMembership $membership): bool
+    {
+        $role = $this->membershipFor($user, $membership)?->role;
+
+        return in_array($role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    private function membershipFor(User $user, EntityMembership $membership): ?EntityMembership
+    {
+        return $user->membershipFor((int) $membership->entity_id);
+    }
+}
