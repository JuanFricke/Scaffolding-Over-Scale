+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class EntitySelectionController extends Controller
+{
+    /**
+     * Remember which entity the authenticated user is currently working in.
+     */
+    public function __invoke(Request $request, Entity $entity): RedirectResponse
+    {
+        abort_unless(
+            $request->user()->membershipFor((int) $entity->getKey()) !== null,
+            403,
+        );
+
+        session(['current_entity_id' => $entity->getKey()]);
+
+        Log::channel('audit')->info('Entity selected.', [
+            'user_id' => $request->user()->getKey(),
+            'entity_id' => $entity->getKey(),
+            'entity_slug' => $entity->slug,
+        ]);
+
+        return redirect()->route('entity.dashboard', $entity);
+    }
+}
