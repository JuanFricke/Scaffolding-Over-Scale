@@ -0,0 +1,97 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+
+class TotemAuthController
+{
+    public function auth(Request $request)
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || ! preg_match('/^\d{6}$/', $code)) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        try {
+            $result = DB::transaction(function () use ($code) {
+                $preset = TotemPreset::query()
+                    ->where('login_code', $code)
+                    ->lockForUpdate()
+                    ->first();
+
+                if (
+                    ! $preset
+                    || ! $preset->is_active
+                    || $preset->login_code_consumed_at !== null
+                    || $preset->login_code_expires_at === null
+                    || $preset->login_code_expires_at->isPast()
+                ) {
+                    Log::channel('audit')->warning('Totem pairing failed', [
+                        'reason' => 'invalid_pairing_code',
+                    ]);
+
+                    throw new \RuntimeException('invalid_pairing_code');
+                }
+
+                $preset->login_code_consumed_at = now();
+                $preset->save();
+
+                $totem = Totem::create([
+                    'entity_id' => $preset->entity_id,
+                    'name' => $preset->name,
+                    'is_active' => true,
+                    'last_seen_at' => now(),
+                ]);
+
+                $ttl = (int) config('services.totem.jwt_ttl', 3600);
+                $secret = (string) config('services.totem.jwt_secret');
+                $queues = $preset->queues()->pluck('queues.id')->map(fn ($v) => (int) $v)->values()->all();
+
+                $now = time();
+                $claims = [
+                    'totem_id' => $totem->id,
+                    'entity_id' => $preset->entity_id,
+                    'preset_id' => $preset->id,
+                    'queues' => $queues,
+                    'iat' => $now,
+                    'exp' => $now + $ttl,
+                    'jti' => (string) Str::uuid(),
+                ];
+
+                $token = TotemJwt::encode($claims, $secret);
+
+                Log::channel('audit')->info('Totem pairing succeeded', [
+                    'totem_id' => $totem->id,
+                    'preset_id' => $preset->id,
+                    'entity_id' => $preset->entity_id,
+                ]);
+
+                return [
+                    'token' => $token,
+                    'ttl' => $ttl,
+                    'entity' => $preset->entity,
+                ];
+            });
+        } catch (\RuntimeException $e) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        return response()->json([
+            'token' => $result['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => $result['ttl'],
+            'entity' => [
+                'slug' => $result['entity']->slug,
+                'name' => $result['entity']->name,
+            ],
+        ], 200);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemController.php b/app/Http/Controllers/Api/TotemController.php
