+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+#[Signature('totem:pairing-code {preset}')]
+#[Description('Open a pairing window for a totem preset by generating its 6-digit login code.')]
+class TotemPairingCode extends Command
+{
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+
+        $preset = TotemPreset::query()->find($presetId);
+
+        if (! $preset) {
+            $this->error('Unknown preset id: '.$presetId);
+
+            return self::FAILURE;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->login_code = $code;
+        $preset->login_code_expires_at = now()->addMinutes(10);
+        $preset->login_code_consumed_at = null;
+        $preset->save();
+
+        Log::channel('audit')->info('Totem pairing code generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        $this->info($code);
+
+        return self::SUCCESS;
+    }
+}
