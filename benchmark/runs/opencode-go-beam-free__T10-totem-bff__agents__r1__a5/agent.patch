+<?php
+
+namespace App\Support;
+
+class TotemPriorities
+{
+    /**
+     * Backend-owned priority levels (single source for the totem API and
+     * issuance validation).
+     *
+     * @return array<int, array{value:int,label:string,visual:array{color:string,icon:string,order:int}}>
+     */
+    public static function all(): array
+    {
+        return [
+            [
+                'value' => 0,
+                'label' => 'Normal',
+                'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            ],
+            [
+                'value' => 10,
+                'label' => 'Prioritário',
+                'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            ],
+            [
+                'value' => 20,
+                'label' => 'Prioridade 80+',
+                'visual' => ['color' => '#1565C0', 'icon' => 'elderly', 'order' => 3],
+            ],
+        ];
+    }
+
+    public static function values(): array
+    {
+        return array_column(self::all(), 'value');
+    }
+
+    public static function find(int $value): ?array
+    {
+        foreach (self::all() as $priority) {
+            if ($priority['value'] === $value) {
+                return $priority;
+            }
+        }
+
+        return null;
+    }
+}
