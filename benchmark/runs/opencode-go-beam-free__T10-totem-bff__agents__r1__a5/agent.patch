@@ -0,0 +1,154 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Support\TotemPriorities;
+use Illuminate\Http\Request;
+
+class TotemController
+{
+    public function queues(Request $request, Entity $entity)
+    {
+        if ((int) $entity->id !== (int) $request->attributes->get('totem_entity_id')) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $effective = $request->attributes->get('totem_queues', []);
+
+        $queues = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('is_active', true)
+            ->whereIn('id', $effective)
+            ->orderBy('name')
+            ->get();
+
+        $position = 0;
+        $data = $queues->map(function (Queue $queue) use (&$position) {
+            $position++;
+
+            return [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => null,
+                'visual' => [
+                    'color' => '#0055FF',
+                    'icon' => 'ticket',
+                    'order' => $position,
+                ],
+                'is_active' => true,
+            ];
+        })->values();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $entity->slug,
+                'name' => $entity->name,
+            ],
+            'queues' => $data,
+        ], 200);
+    }
+
+    public function priorities(Request $request, Entity $entity, string $queue)
+    {
+        if ((int) $entity->id !== (int) $request->attributes->get('totem_entity_id')) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $resolvedQueue = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $resolvedQueue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        $effective = $request->attributes->get('totem_queues', []);
+
+        if (! in_array($resolvedQueue->id, $effective, true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        if (! $resolvedQueue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priorities = array_map(function (array $p) {
+            return [
+                'value' => $p['value'],
+                'label' => $p['label'],
+                'visual' => $p['visual'],
+            ];
+        }, TotemPriorities::all());
+
+        return response()->json([
+            'entity' => ['slug' => $entity->slug],
+            'queue' => [
+                'slug' => $resolvedQueue->slug,
+                'label' => $resolvedQueue->name,
+            ],
+            'priorities' => $priorities,
+        ], 200);
+    }
+
+    public function issueTicket(Request $request, Entity $entity, string $queue)
+    {
+        if ((int) $entity->id !== (int) $request->attributes->get('totem_entity_id')) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $rawPriority = $request->input('priority');
+
+        if (is_int($rawPriority)) {
+            $priority = $rawPriority;
+        } elseif (is_string($rawPriority) && ctype_digit($rawPriority)) {
+            $priority = (int) $rawPriority;
+        } else {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        if (TotemPriorities::find($priority) === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        $resolvedQueue = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $resolvedQueue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        $effective = $request->attributes->get('totem_queues', []);
+
+        if (! in_array($resolvedQueue->id, $effective, true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        if (! $resolvedQueue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $ticket = (new IssueTicket)($resolvedQueue, $priority, TicketChannel::Totem);
+
+        $priorityData = TotemPriorities::find($priority);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $resolvedQueue->slug,
+                'label' => $resolvedQueue->name,
+            ],
+            'priority' => [
+                'value' => $priorityData['value'],
+                'label' => $priorityData['label'],
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601ZuluString(),
+        ], 201);
+    }
+}
diff --git a/app/Http/Middleware/TotemAuth.php b/app/Http/Middleware/TotemAuth.php
