index 0000000..592c45d
--- /dev/null
+++ b/app/Http/Middleware/TotemAuth.php
@@ -0,0 +1,91 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $this->bearerToken($request);
+
+        if ($token === null) {
+            return $this->unauthorized();
+        }
+
+        $secret = (string) config('services.totem.jwt_secret');
+
+        try {
+            $claims = TotemJwt::decode($token, $secret);
+        } catch (\Throwable $e) {
+            return $this->unauthorized();
+        }
+
+        // exp check
+        if (! isset($claims['exp']) || (int) $claims['exp'] < time()) {
+            return $this->unauthorized();
+        }
+
+        $totemId = $claims['totem_id'] ?? null;
+        $entityId = $claims['entity_id'] ?? null;
+        $presetId = $claims['preset_id'] ?? null;
+        $queues = $claims['queues'] ?? [];
+
+        $totem = Totem::query()->find($totemId);
+        $preset = TotemPreset::query()->find($presetId);
+
+        if (! $totem || ! $totem->is_active) {
+            return $this->unauthorized();
+        }
+
+        if (! $preset || ! $preset->is_active) {
+            return $this->unauthorized();
+        }
+
+        if ((int) $totem->entity_id !== (int) $entityId || (int) $preset->entity_id !== (int) $entityId) {
+            return $this->unauthorized();
+        }
+
+        if ((int) $totem->entity_id !== (int) $preset->entity_id) {
+            return $this->unauthorized();
+        }
+
+        // quietly update last_seen_at
+        $totem->last_seen_at = now();
+        $totem->saveQuietly();
+
+        // effective queue scope = intersection of JWT queues with preset's current join
+        $presetQueueIds = $preset->queues()->pluck('queues.id')->map(fn ($v) => (int) $v)->all();
+        $claimQueueIds = array_map('intval', is_array($queues) ? $queues : []);
+        $effective = array_values(array_intersect($claimQueueIds, $presetQueueIds));
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity_id', (int) $entityId);
+        $request->attributes->set('totem_queues', $effective);
+
+        return $next($request);
+    }
+
+    private function bearerToken(Request $request): ?string
+    {
+        $header = $request->header('Authorization', '');
+
+        if (preg_match('/^Bearer\s+(.+)$/i', $header, $m)) {
+            return trim($m[1]);
+        }
+
+        return null;
+    }
+
+    private function unauthorized(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
