+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Issue a ticket for the given queue.
+     *
+     * @throws InactiveQueueException
+     * @throws InvalidArgumentException
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Priority must be >= 0');
+        }
+
+        return DB::transaction(function () use ($queue, $priority, $channel) {
+            /** @var Queue $queueLocked */
+            $queueLocked = Queue::where('id', $queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $queueLocked->is_active) {
+                throw new InactiveQueueException('Queue is inactive');
+            }
+
+            $ticket = new Ticket();
+            $ticket->queue_id = $queueLocked->id;
+            $ticket->priority = $priority;
+            $ticket->channel = $channel;
+            $ticket->save();
+
+            return $ticket;
+        }, 3);
+    }
+}
