@@ -0,0 +1,95 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use LogicException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Models\EntityMembership;
+use Illuminate\Database\Eloquent\Factories\DatabaseFactory;
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+use Illuminate\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class QueueTicketTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_issuance_creates_ticket_with_default_values()
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+        $ticket = (new IssueTicket())($queue);
+
+        $this->assertInstanceOf(Ticket::class, $ticket);
+        $this->assertEquals(TicketStatus::Waiting, $ticket->status);
+        $this->assertEquals(TicketChannel::Virtual, $ticket->channel);
+        $this->assertEquals(0, $ticket->priority);
+        $this->assertNotNull($ticket->issued_at);
+        $this->assertNotNull($ticket->code);
+    }
+
+    public function test_issuance_rejects_inactive_queue()
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->state(['is_active' => false])->create();
+        $this->expectException(InactiveQueueException::class);
+        (new IssueTicket())($queue);
+    }
+
+    public function test_ticket_code_sequence()
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+        $t1 = (new IssueTicket())($queue);
+        $t2 = (new IssueTicket())($queue);
+        $this->assertEquals('A001', $t1->code);
+        $this->assertEquals('A002', $t2->code);
+    }
+
+    public function test_ticket_call_requires_member_and_single_call()
+    {
+        $entity = Entity::factory()->create();
+        $user = User::factory()->create();
+        $entity->memberships()->create([ 'user_id' => $user->id, 'role' => 'admin']);
+        $queue = Queue::factory()->for($entity)->create();
+        $ticket = (new IssueTicket())($queue);
+
+        $ticket->call($user);
+        $this->assertEquals(TicketStatus::Called, $ticket->fresh()->status);
+
+        $this->expectException(LogicException::class);
+        $ticket->call($user);
+    }
+
+    public function test_ticket_call_unauthorized_user()
+    {
+        $entity = Entity::factory()->create();
+        $user = User::factory()->create(); // not a member
+        $queue = Queue::factory()->for($entity)->create();
+        $ticket = (new IssueTicket())($queue);
+
+        $this->expectException(\Illuminate\Contracts\Auth\AuthorizationException::class);
+        $ticket->call($user);
+    }
+
+    public function test_ticket_immutable_fields()
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+        $ticket = (new IssueTicket())($queue);
+
+        $ticket->code = 'A999';
+        $this->expectException(LogicException::class);
+        $ticket->save();
+    }
+}
+?>
