diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..3d4dca0
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,123 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Attributes\HasFactory;
+use Illuminate\Database\Eloquent\Attributes\HasGuarded;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\HasOne;
+use Illuminate\Exceptions\AuthorizationException;
+use LogicException;
+use RuntimeException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    protected $casts = [
+    'code' => 'string',
+        'priority' => 'int',
+        'channel' => TicketChannel::class,
+        'status' => TicketStatus::class,
+        'issued_at' => 'datetime',
+        'called_at' => 'datetime',
+        'called_by_user_id' => 'int',
+    ];
+
+    /**
+     * Get the queue that owns this ticket.
+     */
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    /**
+     * The user who called this ticket.
+     */
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Determine the next code for a given queue.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = self::where('queue_id', $queueId)->pluck('code')->toArray();
+        $max = 0;
+        foreach ($codes as $code) {
+            if (preg_match('/^A(\d+)$/', $code, $matches)) {
+                $num = (int) $matches[1];
+                if ($num > $max) {
+                    $max = $num;
+                }
+            }
+        }
+        $next = $max + 1;
+        if ($next < 1000) {
+            return 'A' . str_pad((string) $next, 3, '0', STR_PAD_LEFT);
+        }
+        return 'A' . $next;
+    }
+
+    /**
+     * Call this ticket.
+     */
+    public function call(User $user): void
+    {
+        if (! $user->membershipFor($this->queue->entity_id)) {
+            throw new AuthorizationException('User is not a member of the entity.');
+        }
+
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Ticket cannot be called again.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->save();
+    }
+
+    /**
+     * Enforce write-once semantics.
+     */
+    protected static function booted(): void
+    {
+        static::creating(function (self $ticket) {
+            if ($ticket->status === null) {
+                $ticket->status = TicketStatus::Waiting;
+            }
+            if ($ticket->channel === null) {
+                $ticket->channel = TicketChannel::Virtual;
+            }
+            if ($ticket->issued_at === null) {
+                $ticket->issued_at = now();
+            }
+            if ($ticket->code === null) {
+                $ticket->code = self::nextCode($ticket->queue_id);
+            }
+            if ($ticket->priority === null) {
+                $ticket->priority = 0;
+            }
+            if ($ticket->priority < 0) {
+                throw new LogicException('Negative priority is not allowed.');
+            }
+        });
+        static::updating(function (self $ticket) {
+            $dirty = $ticket->getDirty();
+            foreach ($dirty as $key => $_) {
+                if (! in_array($key, ['status', 'called_at', 'called_by_user_id'])) {
+                    throw new LogicException('Ticket fields are immutable.');
+                }
+            }
+        });
+    }
+}
