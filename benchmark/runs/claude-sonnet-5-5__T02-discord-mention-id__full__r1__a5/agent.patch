@@ -121,3 +121,77 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends the configured mention on its own last line', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => ' 123456789012345678 ']);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues', ['entity_id' => 42]);
+
+    Http::assertSent(fn (Request $request) => $request['content'] === "Plan limit\nEntity hit max queues\nentity_id=42\n<@123456789012345678>");
+});
+
+test('accepts an integer mention id', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => 123456789012345678]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'], "\n<@123456789012345678>"));
+});
+
+test('adds no mention when the id is not configured', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $id]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Http::assertSent(fn (Request $request) => $request['content'] === "T\nM");
+})->with([null, '', '   ']);
+
+test('ignores mention ids that are not a discord snowflake', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $id]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'], '<@')
+        && ! str_contains($request['content'], '@everyone')
+        && $request['content'] === "T\nM");
+})->with([
+    '@everyone',
+    '@here',
+    'abc',
+    '123',
+    123,
+    '1234567890123456',
+    '123456789012345678901',
+    "123456789012345678\n@everyone",
+    "123456789012345678> \n@everyone",
+    '123456789012345678>',
+    '12345678901234567a',
+    '１２３４５６７８９０１２３４５６７８',
+    true,
+    1.5,
+    'array' => [['123456789012345678']],
+]);
+
+test('keeps the mention when a long alert is truncated to 1800 characters', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(fn (Request $request) => mb_strlen($request['content']) === 1800
+        && str_ends_with($request['content'], "\n<@123456789012345678>"));
