diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..d885032 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,55 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $base = implode("\n", $lines);
+
+        $mentionId = $this->mentionId();
+        if ($mentionId === null) {
+            return mb_substr($base, 0, self::MaxContentLength);
+        }
+
+        $mention = '<@'.$mentionId.'>';
+        $suffix = "\n".$mention;
+
+        $available = self::MaxContentLength - mb_strlen($suffix);
+        if ($available < 0) {
+            $available = 0;
+        }
+
+        return mb_substr($base, 0, $available).$suffix;
+    }
+
+    /**
+     * Resolve and validate the configured Discord user ID to ping.
+     *
+     * Returns null when unset/invalid so no mention is emitted.
+     */
+    private function mentionId(): ?string
+    {
+        $raw = config('services.discord.mention_id');
+
+        if (is_bool($raw)) {
+            return null;
+        }
+
+        if (is_int($raw)) {
+            $id = (string) $raw;
+        } elseif (is_float($raw)) {
+            if ($raw !== floor($raw)) {
+                return null;
+            }
+            $id = sprintf('%.0f', $raw);
+        } elseif (is_string($raw)) {
+            $id = trim($raw);
+        } else {
+            return null;
+        }
+
+        if (! preg_match('/^[0-9]{17,20}$/', $id)) {
+            return null;
+        }
+
+        return $id;
     }
 
     private function safe(string $key, mixed $value): string
