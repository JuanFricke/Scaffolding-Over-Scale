diff --git a/tests/Feature/EntityMembersTest.php b/tests/Feature/EntityMembersTest.php
new file mode 100644
index 0000000..1497189
--- /dev/null
+++ b/tests/Feature/EntityMembersTest.php
@@ -0,0 +1,220 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function entityMembersTestMembership(Entity $entity, UserRole $role, ?User $user = null): EntityMembership
+{
+    return EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'user_id' => ($user ?? User::factory()->create())->id,
+        'role' => $role,
+    ]);
+}
+
+test('an owner can add an existing user as an employee', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityMembersTestMembership($entity, UserRole::Owner)->user;
+    $user = User::factory()->create(['email' => 'new-member@example.com']);
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', $user->email)
+        ->call('addMember')
+        ->assertHasNoErrors();
+
+    $this->assertDatabaseHas('entity_memberships', [
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'role' => UserRole::Employee->value,
+    ]);
+});
+
+test('adding a duplicate member is an error on email', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityMembersTestMembership($entity, UserRole::Owner)->user;
+    $member = entityMembersTestMembership($entity, UserRole::Employee)->user;
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', $member->email)
+        ->call('addMember')
+        ->assertHasErrors('email');
+});
+
+test('adding an unknown email is an error on email', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityMembersTestMembership($entity, UserRole::Owner)->user;
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', 'nobody@example.com')
+        ->call('addMember')
+        ->assertHasErrors('email');
+});
+
+test('an employee cannot add members or assign roles', function () {
+    $entity = Entity::factory()->create();
+    $employee = entityMembersTestMembership($entity, UserRole::Employee);
+    $target = entityMembersTestMembership($entity, UserRole::Employee);
+
+    $this->actingAs($employee->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', User::factory()->create()->email)
+        ->call('addMember')
+        ->assertForbidden();
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $target->id, UserRole::Admin->value)
+        ->assertForbidden();
+
+    expect($target->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('an owner can assign admin and employee roles', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityMembersTestMembership($entity, UserRole::Owner)->user;
+    $target = entityMembersTestMembership($entity, UserRole::Employee);
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $target->id, UserRole::Admin->value)
+        ->assertHasNoErrors();
+
+    expect($target->fresh()->role)->toBe(UserRole::Admin);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $target->id, UserRole::Employee->value)
+        ->assertHasNoErrors();
+
+    expect($target->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner role cannot be assigned through role management', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityMembersTestMembership($entity, UserRole::Owner)->user;
+    $target = entityMembersTestMembership($entity, UserRole::Employee);
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $target->id, UserRole::Owner->value)
+        ->assertHasErrors('role');
+
+    expect($target->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner membership cannot be demoted through role management', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityMembersTestMembership($entity, UserRole::Owner);
+    entityMembersTestMembership($entity, UserRole::Admin);
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $owner->id, UserRole::Admin->value)
+        ->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('an admin can remove an employee', function () {
+    $entity = Entity::factory()->create();
+    entityMembersTestMembership($entity, UserRole::Owner);
+    $admin = entityMembersTestMembership($entity, UserRole::Admin);
+    $employee = entityMembersTestMembership($entity, UserRole::Employee);
+
+    $this->actingAs($admin->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $employee->id)
+        ->assertHasNoErrors();
+
+    $this->assertDatabaseMissing('entity_memberships', ['id' => $employee->id]);
+});
+
+test('a member can remove themselves', function () {
+    $entity = Entity::factory()->create();
+    entityMembersTestMembership($entity, UserRole::Owner);
+    $employee = entityMembersTestMembership($entity, UserRole::Employee);
+
+    $this->actingAs($employee->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $employee->id)
+        ->assertHasNoErrors();
+
+    $this->assertDatabaseMissing('entity_memberships', ['id' => $employee->id]);
+});
+
+test('an employee cannot remove another member', function () {
+    $entity = Entity::factory()->create();
+    entityMembersTestMembership($entity, UserRole::Owner);
+    $employee = entityMembersTestMembership($entity, UserRole::Employee);
+    $other = entityMembersTestMembership($entity, UserRole::Employee);
+
+    $this->actingAs($employee->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $other->id)
+        ->assertForbidden();
+
+    $this->assertDatabaseHas('entity_memberships', ['id' => $other->id]);
+});
+
+test('the owner can never be removed', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityMembersTestMembership($entity, UserRole::Owner);
+    $admin = entityMembersTestMembership($entity, UserRole::Admin);
+
+    $this->actingAs($admin->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $owner->id)
+        ->assertForbidden();
+
+    expect($owner->fresh())->not->toBeNull();
+});
+
+test('the last manager can never be removed', function () {
+    $entity = Entity::factory()->create();
+    $admin = entityMembersTestMembership($entity, UserRole::Admin);
+
+    $this->actingAs($admin->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $admin->id)
+        ->assertForbidden();
+
+    expect($admin->fresh())->not->toBeNull();
+});
+
+test('a membership from another entity cannot be tampered with', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityMembersTestMembership($entity, UserRole::Owner)->user;
+    $otherMembership = entityMembersTestMembership(Entity::factory()->create(), UserRole::Employee);
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $otherMembership->id, UserRole::Admin->value)
+        ->assertForbidden();
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $otherMembership->id)
+        ->assertForbidden();
+
+    expect($otherMembership->fresh()->role)->toBe(UserRole::Employee);
+});
