diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..6df8c92
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,105 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function entityPolicyTestMembership(Entity $entity, UserRole $role, ?User $user = null): EntityMembership
+{
+    return EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'user_id' => ($user ?? User::factory()->create())->id,
+        'role' => $role,
+    ]);
+}
+
+test('any authenticated user may create an entity', function () {
+    expect((new EntityPolicy)->create(User::factory()->create()))->toBeTrue();
+});
+
+test('entity view is limited to members', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->view(entityPolicyTestMembership($entity, UserRole::Employee)->user, $entity))->toBeTrue()
+        ->and($policy->view(User::factory()->create(), $entity))->toBeFalse();
+});
+
+test('owners and admins may update and delete an entity', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+
+    $owner = entityPolicyTestMembership($entity, UserRole::Owner)->user;
+    $admin = entityPolicyTestMembership($entity, UserRole::Admin)->user;
+    $employee = entityPolicyTestMembership($entity, UserRole::Employee)->user;
+
+    expect($policy->update($owner, $entity))->toBeTrue()
+        ->and($policy->delete($owner, $entity))->toBeTrue()
+        ->and($policy->update($admin, $entity))->toBeTrue()
+        ->and($policy->delete($admin, $entity))->toBeTrue()
+        ->and($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->delete($employee, $entity))->toBeFalse();
+});
+
+test('only the owner may manage entity settings', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->manageSettings(entityPolicyTestMembership($entity, UserRole::Owner)->user, $entity))->toBeTrue()
+        ->and($policy->manageSettings(entityPolicyTestMembership($entity, UserRole::Admin)->user, $entity))->toBeFalse()
+        ->and($policy->manageSettings(entityPolicyTestMembership($entity, UserRole::Employee)->user, $entity))->toBeFalse()
+        ->and($policy->manageSettings(User::factory()->create(), $entity))->toBeFalse();
+});
+
+test('membership view is limited to entity members', function () {
+    $entity = Entity::factory()->create();
+    $membership = entityPolicyTestMembership($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view(entityPolicyTestMembership($entity, UserRole::Employee)->user, $membership))->toBeTrue()
+        ->and($policy->view(User::factory()->create(), $membership))->toBeFalse();
+});
+
+test('only owners and admins may assign roles', function () {
+    $entity = Entity::factory()->create();
+    $membership = entityPolicyTestMembership($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->assignRole(entityPolicyTestMembership($entity, UserRole::Owner)->user, $membership))->toBeTrue()
+        ->and($policy->assignRole(entityPolicyTestMembership($entity, UserRole::Admin)->user, $membership))->toBeTrue()
+        ->and($policy->assignRole(entityPolicyTestMembership($entity, UserRole::Employee)->user, $membership))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityPolicyTestMembership($entity, UserRole::Owner);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($owner->user, $owner))->toBeFalse()
+        ->and($policy->delete(entityPolicyTestMembership($entity, UserRole::Admin)->user, $owner))->toBeFalse();
+});
+
+test('members may delete themselves but not other employees', function () {
+    $entity = Entity::factory()->create();
+    $employee = entityPolicyTestMembership($entity, UserRole::Employee);
+    $otherEmployee = entityPolicyTestMembership($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($employee->user, $employee))->toBeTrue()
+        ->and($policy->delete($otherEmployee->user, $employee))->toBeFalse();
+});
+
+test('owners and admins may delete other memberships', function () {
+    $entity = Entity::factory()->create();
+    $employee = entityPolicyTestMembership($entity, UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete(entityPolicyTestMembership($entity, UserRole::Owner)->user, $employee))->toBeTrue()
+        ->and($policy->delete(entityPolicyTestMembership($entity, UserRole::Admin)->user, $employee))->toBeTrue();
+});
diff --git a/tests/Feature/EntitySettingsTest.php b/tests/Feature/EntitySettingsTest.php
new file mode 100644
index 0000000..667a916
--- /dev/null
+++ b/tests/Feature/EntitySettingsTest.php
@@ -0,0 +1,205 @@
+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function entitySettingsTestMembership(Entity $entity, UserRole $role, ?User $user = null): EntityMembership
+{
+    return EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'user_id' => ($user ?? User::factory()->create())->id,
+        'role' => $role,
+    ]);
+}
+
+test('the owner can update the entity name and slug', function () {
+    $entity = Entity::factory()->create(['name' => 'Old', 'slug' => 'old-slug']);
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner)->user;
+
+    $this->actingAs($owner);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('name', 'New name')
+        ->set('slug', 'new-slug')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    expect($entity->fresh())
+        ->name->toBe('New name')
+        ->slug->toBe('new-slug');
+});
+
+test('the entity may keep its own slug when saving', function () {
+    $entity = Entity::factory()->create(['slug' => 'same-slug']);
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner)->user;
+
+    $this->actingAs($owner);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('name', 'Updated')
+        ->set('slug', 'same-slug')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    expect($entity->fresh()->slug)->toBe('same-slug');
+});
+
+test('the slug must be unique across entities', function () {
+    $entity = Entity::factory()->create(['slug' => 'first-slug']);
+    Entity::factory()->create(['slug' => 'taken-slug']);
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner)->user;
+
+    $this->actingAs($owner);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('slug', 'taken-slug')
+        ->call('save')
+        ->assertHasErrors('slug');
+
+    expect($entity->fresh()->slug)->toBe('first-slug');
+});
+
+test('the entity name is required', function () {
+    $entity = Entity::factory()->create();
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner)->user;
+
+    $this->actingAs($owner);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('name', '')
+        ->call('save')
+        ->assertHasErrors('name');
+});
+
+test('deleting an entity removes its memberships and clears the current session', function () {
+    $entity = Entity::factory()->create();
+    $ownerMembership = entitySettingsTestMembership($entity, UserRole::Owner);
+    entitySettingsTestMembership($entity, UserRole::Employee);
+
+    session(['current_entity_id' => $entity->id]);
+    $this->actingAs($ownerMembership->user);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->call('delete')
+        ->assertRedirect(route('home'));
+
+    $this->assertSoftDeleted('entities', ['id' => $entity->id]);
+    $this->assertDatabaseMissing('entity_memberships', ['entity_id' => $entity->id]);
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('deleting an entity leaves a different current session untouched', function () {
+    $entity = Entity::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    $ownerMembership = entitySettingsTestMembership($entity, UserRole::Owner);
+
+    session(['current_entity_id' => $otherEntity->id]);
+    $this->actingAs($ownerMembership->user);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->call('delete')
+        ->assertRedirect(route('home'));
+
+    expect((int) session('current_entity_id'))->toBe($otherEntity->id);
+});
+
+test('ownership can be transferred to an admin', function () {
+    $entity = Entity::factory()->create();
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner);
+    $target = entitySettingsTestMembership($entity, UserRole::Admin);
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $target->id)
+        ->call('transfer')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    expect($owner->fresh()->role)->toBe(UserRole::Admin)
+        ->and($target->fresh()->role)->toBe(UserRole::Owner)
+        ->and($entity->owner()->first()->id)->toBe($target->id);
+});
+
+test('ownership cannot be transferred to an employee', function () {
+    $entity = Entity::factory()->create();
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner);
+    $target = entitySettingsTestMembership($entity, UserRole::Employee);
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $target->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner)
+        ->and($target->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('ownership cannot be transferred to an admin of another entity', function () {
+    $entity = Entity::factory()->create();
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner);
+    $target = entitySettingsTestMembership(Entity::factory()->create(), UserRole::Admin);
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $target->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner)
+        ->and($target->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('ownership cannot be transferred to the owner themselves', function () {
+    $entity = Entity::factory()->create();
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner);
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $owner->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('ownership transfer fails when the owner row disappeared', function () {
+    $entity = Entity::factory()->create();
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner);
+    $target = entitySettingsTestMembership($entity, UserRole::Admin);
+
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $target->id);
+
+    $owner->delete();
+
+    $component->call('transfer')->assertForbidden();
+
+    expect($target->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('the bound entity cannot be swapped by the client', function () {
+    $entity = Entity::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    $owner = entitySettingsTestMembership($entity, UserRole::Owner)->user;
+
+    $this->actingAs($owner);
+
+    expect(fn () => Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('entity', $otherEntity))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
diff --git a/tests/Feature/EntityTest.php b/tests/Feature/EntityTest.php
