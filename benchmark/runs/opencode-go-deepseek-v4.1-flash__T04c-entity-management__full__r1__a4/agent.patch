@@ -0,0 +1,114 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|email:strict|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $this->authorize('update', $this->entity);
+
+        $validated = $this->validate();
+
+        $user = User::query()->where('email', $validated['email'])->firstOrFail();
+
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw ValidationException::withMessages([
+                'email' => __('ui.member_already_exists'),
+            ]);
+        }
+
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->reset('email');
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        $membership = $this->resolveMembership($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        validator(
+            ['role' => $role],
+            ['role' => ['required', Rule::in(array_map(fn (UserRole $item) => $item->value, UserRole::manageable()))]],
+        )->validate();
+
+        if ($membership->role === UserRole::Owner) {
+            abort(403);
+        }
+
+        $membership->update(['role' => UserRole::from($role)]);
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = $this->resolveMembership($membershipId);
+
+        $this->authorize('delete', $membership);
+
+        $otherManagers = $this->entity->memberships()
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->whereKeyNot($membership->getKey())
+            ->count();
+
+        if ($otherManagers === 0) {
+            abort(403);
+        }
+
+        $membership->delete();
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()
+                ->with('user')
+                ->orderBy('id')
+                ->get(),
+        ]);
+    }
+
+    /**
+     * Resolve a membership that belongs to the current entity.
+     */
+    protected function resolveMembership(int $membershipId): EntityMembership
+    {
+        $membership = EntityMembership::query()->find($membershipId);
+
+        if ($membership === null || (int) $membership->entity_id !== (int) $this->entity->id) {
+            abort(403);
+        }
+
+        return $membership;
+    }
+}
diff --git a/app/Livewire/Entity/Settings.php b/app/Livewire/Entity/Settings.php
new file mode 100644
index 0000000..fdb9657
--- /dev/null
+++ b/app/Livewire/Entity/Settings.php
@@ -0,0 +1,143 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    public $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $validated = $this->validate();
+
+        $this->entity->update([
+            'name' => $validated['name'],
+            'slug' => $validated['slug'],
+        ]);
+    }
+
+    public function delete(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        DB::transaction(function () {
+            $this->entity->memberships()->delete();
+            $this->entity->delete();
+        });
+
+        if ((int) session('current_entity_id') === (int) $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirectRoute('home');
+    }
+
+    public function transfer(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $targetId = filter_var($this->targetMembershipId, FILTER_VALIDATE_INT);
+
+        if ($targetId === false) {
+            abort(403);
+        }
+
+        $target = EntityMembership::query()->find($targetId);
+
+        if (! $this->isTransferableAdmin($target)) {
+            abort(403);
+        }
+
+        DB::transaction(function () use ($targetId) {
+            $owner = $this->entity->memberships()
+                ->owner()
+                ->where('user_id', auth()->id())
+                ->lockForUpdate()
+                ->first();
+
+            $target = $this->entity->memberships()
+                ->whereKey($targetId)
+                ->lockForUpdate()
+                ->first();
+
+            if ($owner === null || ! $this->isTransferableAdmin($target)) {
+                abort(403);
+            }
+
+            // Demote first: the database allows only one owner per entity.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+        });
+
+        $this->targetMembershipId = null;
+
+        $this->redirectRoute('entity.dashboard', ['entity' => $this->entity]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'admins' => $this->entity->memberships()
+                ->admin()
+                ->with('user')
+                ->orderBy('id')
+                ->get(),
+        ]);
+    }
+
+    /**
+     * @return array<string, array<int, mixed>>
+     */
+    protected function rules(): array
+    {
+        return [
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => [
+                'required',
+                'string',
+                'max:255',
+                Rule::unique('entities', 'slug')->ignore($this->entity->getKey()),
+            ],
+        ];
+    }
+
+    /**
+     * Determine whether the membership can receive ownership from this owner.
+     */
+    protected function isTransferableAdmin(?EntityMembership $membership): bool
+    {
+        return $membership !== null
+            && (int) $membership->entity_id === (int) $this->entity->id
+            && $membership->role === UserRole::Admin
+            && $membership->user_id !== auth()->id();
+    }
+}
