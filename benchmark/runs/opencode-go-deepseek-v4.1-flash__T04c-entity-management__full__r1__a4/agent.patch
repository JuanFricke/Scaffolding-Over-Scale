@@ -0,0 +1,118 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function entityPagesTestUser(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'role' => $role,
+    ]);
+
+    return $user;
+}
+
+test('the dashboard shows the entity, welcome, members link and owner tools', function () {
+    $entity = Entity::factory()->create(['name' => 'PegaFila Centro']);
+    $owner = entityPagesTestUser($entity, UserRole::Owner);
+
+    $this->actingAs($owner)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('PegaFila Centro')
+        ->assertSee(__('ui.entity_welcome', ['name' => $entity->name]))
+        ->assertSee(route('entity.members', $entity))
+        ->assertSee(route('entity.settings', $entity))
+        ->assertSee(__('ui.entity_owner_notice'));
+});
+
+test('the dashboard hides settings from non-owners', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $user = entityPagesTestUser($entity, $role);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(route('entity.members', $entity))
+        ->assertDontSee(route('entity.settings', $entity))
+        ->assertDontSee(__('ui.entity_owner_notice'));
+})->with([UserRole::Admin, UserRole::Employee]);
+
+test('a non-member gets a 403 even when the session points at another entity', function () {
+    $entity = Entity::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    $user = entityPagesTestUser($otherEntity, UserRole::Employee);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $otherEntity->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertForbidden();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $otherEntity->id])
+        ->get(route('entity.members', $entity))
+        ->assertForbidden();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $otherEntity->id])
+        ->get(route('entity.settings', $entity))
+        ->assertForbidden();
+});
+
+test('non-owners cannot open settings', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $user = entityPagesTestUser($entity, $role);
+
+    $this->actingAs($user)
+        ->get(route('entity.settings', $entity))
+        ->assertForbidden();
+})->with([UserRole::Admin, UserRole::Employee]);
+
+test('the owner can open settings', function () {
+    $entity = Entity::factory()->create();
+    $owner = entityPagesTestUser($entity, UserRole::Owner);
+
+    $this->actingAs($owner)
+        ->get(route('entity.settings', $entity))
+        ->assertOk()
+        ->assertSee(__('ui.transfer_ownership'));
+});
+
+test('members page is available to every member', function () {
+    $entity = Entity::factory()->create();
+    $employee = entityPagesTestUser($entity, UserRole::Employee);
+
+    $this->actingAs($employee)
+        ->get(route('entity.members', $entity))
+        ->assertOk()
+        ->assertSee(__('ui.entity_members_title'));
+});
+
+test('guests are redirected from entity pages', function () {
+    $entity = Entity::factory()->create();
+
+    foreach (['entity.dashboard', 'entity.members', 'entity.settings'] as $route) {
+        $this->get(route($route, $entity))->assertRedirect(route('login'));
+    }
+});
+
+test('unverified members are redirected from entity pages', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->unverified()->create();
+    EntityMembership::factory()->owner()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
