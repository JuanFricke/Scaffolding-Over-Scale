+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the membership's entity may view it.
+     */
+    public function view(User $user, EntityMembership $entityMembership): bool
+    {
+        return $user->membershipFor($entityMembership->entity_id) !== null;
+    }
+
+    /**
+     * Owners and admins may assign roles to other members.
+     */
+    public function assignRole(User $user, EntityMembership $entityMembership): bool
+    {
+        return $this->manages($user, $entityMembership);
+    }
+
+    /**
+     * The owner can never be removed, members may remove themselves, and
+     * owners/admins may remove anyone else.
+     */
+    public function delete(User $user, EntityMembership $entityMembership): bool
+    {
+        if ($entityMembership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($entityMembership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->manages($user, $entityMembership);
+    }
+
+    /**
+     * Determine whether the user is an owner or admin of the membership's entity.
+     */
+    protected function manages(User $user, EntityMembership $entityMembership): bool
+    {
+        $membership = $user->membershipFor($entityMembership->entity_id);
+
+        return in_array($membership?->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
