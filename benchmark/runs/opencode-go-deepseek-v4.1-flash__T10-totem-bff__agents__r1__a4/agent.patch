+<?php
+
+use App\Http\Controllers\Api\TotemAuthController;
+use App\Http\Controllers\Api\TotemPriorityController;
+use App\Http\Controllers\Api\TotemQueueController;
+use App\Http\Controllers\Api\TotemTicketController;
+use Illuminate\Support\Facades\Route;
+
+Route::post('totem/auth', [TotemAuthController::class, 'store'])
+    ->middleware('throttle:10,1,totem-auth')
+    ->name('api.totem.auth');
+
+Route::middleware('totem.auth')->group(function () {
+    Route::get('{entity}/queues', [TotemQueueController::class, 'index'])
+        ->name('api.totem.queues');
+
+    Route::get('{entity}/{queue}/priorities', [TotemPriorityController::class, 'index'])
+        ->name('api.totem.priorities');
+
+    Route::post('{entity}/{queue}/ticket', [TotemTicketController::class, 'store'])
+        ->middleware('throttle:30,1,totem-ticket')
+        ->name('api.totem.ticket');
+});
+
+// CORS preflight for every API path; TotemCors decides which origins may see it.
+Route::options('/{any}', fn () => response()->noContent())
+    ->where('any', '.*')
+    ->name('api.totem.preflight');
