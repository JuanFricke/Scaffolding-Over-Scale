+<?php
+
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function totemLogin(object $test, TotemPreset $preset): string
+{
+    return $test->postJson('/api/totem/auth', ['code' => $preset->fresh()->login_code])
+        ->assertOk()
+        ->json('token');
+}
+
+function makeTotemPreset(array $queueNames = []): array
+{
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    $queues = collect($queueNames)->map(
+        fn (string $name) => Queue::factory()->for($entity)->create(['name' => $name]),
+    );
+
+    $preset->queues()->attach($queues->pluck('id')->all());
+
+    return [$entity, $preset, $queues];
+}
+
+it('pairs a preset and returns a scoped JWT plus entity identity', function () {
+    [$entity, $preset, $queues] = makeTotemPreset(['Geral']);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('entity.name', $entity->name)
+        ->assertJsonStructure(['token']);
+
+    $claims = app(TotemJwt::class)->decode($response->json('token'));
+
