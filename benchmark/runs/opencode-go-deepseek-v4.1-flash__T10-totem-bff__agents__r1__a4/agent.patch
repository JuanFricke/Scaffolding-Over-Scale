+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Models\Queue;
+use App\Support\TotemVisuals;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController extends TotemApiController
+{
+    public function index(Request $request): JsonResponse
+    {
+        $context = $this->context($request);
+
+        if ($forbidden = $this->guardEntity($request, $context)) {
+            return $forbidden;
+        }
+
+        $queues = Queue::query()
+            ->where('entity_id', $context->entity->id)
+            ->whereIn('id', $context->queueIds)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->orderBy('id')
+            ->get()
+            ->values()
+            ->map(fn (Queue $queue, int $index) => TotemVisuals::queue(
+                $queue,
+                $context->preset->appearance,
+                $index + 1,
+            ))
+            ->all();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $context->entity->slug,
+                'name' => $context->entity->name,
+            ],
+            'queues' => $queues,
+        ]);
+    }
+}
