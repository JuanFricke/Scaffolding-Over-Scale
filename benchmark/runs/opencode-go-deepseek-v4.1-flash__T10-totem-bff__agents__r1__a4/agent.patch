@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+#[Signature('totem:pairing-code {preset}')]
+#[Description('Open a 10-minute pairing window and print the preset pairing code')]
+class TotemPairingCode extends Command
+{
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+
+        $preset = TotemPreset::query()->find($presetId);
+
+        if ($preset === null) {
+            $this->error("Totem preset [{$presetId}] not found.");
+
+            return self::FAILURE;
+        }
+
+        $code = $this->generateUniqueCode($preset);
+        $expiresAt = now()->addMinutes(10);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => $expiresAt,
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        Log::channel('audit')->info('Totem pairing code generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $expiresAt->toIso8601String(),
+        ]);
+
+        $this->info("Pairing code: {$code}");
+        $this->line('Expires at: '.$expiresAt->toIso8601String());
+
+        return self::SUCCESS;
+    }
+
+    private function generateUniqueCode(TotemPreset $preset): string
+    {
+        $currentCode = $preset->login_code;
+
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while ($code === $currentCode || TotemPreset::query()
+            ->where('login_code', $code)
+            ->whereKeyNot($preset->getKey())
+            ->exists());
+
+        return $code;
+    }
+}
