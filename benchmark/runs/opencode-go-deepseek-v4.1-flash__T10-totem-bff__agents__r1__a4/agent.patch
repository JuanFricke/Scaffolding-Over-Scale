@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Context\TotemContext;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+abstract class TotemApiController extends Controller
+{
+    protected function context(Request $request): TotemContext
+    {
+        return $request->attributes->get('totem_context');
+    }
+
+    protected function forbidden(): JsonResponse
+    {
+        return response()->json(['code' => 'forbidden'], 403);
+    }
+
+    /**
+     * @return JsonResponse|null Null when the path entity matches the token.
+     */
+    protected function guardEntity(Request $request, TotemContext $context): ?JsonResponse
+    {
+        if ((string) $request->route('entity') !== $context->entity->slug) {
+            return $this->forbidden();
+        }
+
+        return null;
+    }
+
+    /**
+     * Resolve the queue inside the token entity, then enforce the effective scope.
+     */
+    protected function resolveQueue(Request $request, TotemContext $context): Queue|JsonResponse
+    {
+        $queue = Queue::query()
+            ->where('entity_id', $context->entity->id)
+            ->where('slug', (string) $request->route('queue'))
+            ->first();
+
+        if ($queue === null) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! in_array((int) $queue->id, $context->queueIds, true)) {
+            return $this->forbidden();
+        }
+
+        return $queue;
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemAuthController.php b/app/Http/Controllers/Api/TotemAuthController.php
new file mode 100644
index 0000000..78c1cd0
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemAuthController.php
@@ -0,0 +1,113 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends TotemApiController
+{
+    public function __construct(private TotemJwt $jwt) {}
+
+    public function store(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || preg_match('/^[0-9]{6}$/', $code) !== 1) {
+            Log::channel('audit')->warning('Totem pairing failed', [
+                'reason' => 'invalid_code_format',
+                'ip' => $request->ip(),
+            ]);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $result = DB::transaction(function () use ($code, $request): ?array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null || ! $preset->hasUsableLoginCode()) {
+                Log::channel('audit')->warning('Totem pairing failed', [
+                    'reason' => 'invalid_pairing_code',
+                    'ip' => $request->ip(),
+                ]);
+
+                return null;
+            }
+
+            $entity = $preset->entity;
+
+            if ($entity === null) {
+                Log::channel('audit')->warning('Totem pairing failed', [
+                    'reason' => 'invalid_pairing_code',
+                    'ip' => $request->ip(),
+                ]);
+
+                return null;
+            }
+
+            $queueIds = $preset->queues()
+                ->pluck('queues.id')
+                ->map(fn ($id) => (int) $id)
+                ->values()
+                ->all();
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $entity->id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            Log::channel('audit')->info('Totem paired', [
+                'totem_id' => $totem->id,
+                'entity_id' => $entity->id,
+                'preset_id' => $preset->id,
+                'ip' => $request->ip(),
+            ]);
+
+            return [
+                'preset' => $preset,
+                'entity' => $entity,
+                'totem' => $totem,
+                'queue_ids' => $queueIds,
+            ];
+        });
+
+        if ($result === null) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        $ttl = $this->jwt->ttl();
+        $issuedAt = now()->getTimestamp();
+
+        $token = $this->jwt->issue([
+            'totem_id' => $result['totem']->id,
+            'entity_id' => $result['entity']->id,
+            'preset_id' => $result['preset']->id,
+            'queues' => $result['queue_ids'],
+            'iat' => $issuedAt,
+            'exp' => $issuedAt + $ttl,
+            'jti' => bin2hex(random_bytes(16)),
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => $ttl,
+            'entity' => [
+                'slug' => $result['entity']->slug,
+                'name' => $result['entity']->name,
+            ],
+        ]);
+    }
+}
