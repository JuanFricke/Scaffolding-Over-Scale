+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Support\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemTicketController extends TotemApiController
+{
+    public function store(Request $request, IssueTicket $issueTicket): JsonResponse
+    {
+        $context = $this->context($request);
+
+        if ($forbidden = $this->guardEntity($request, $context)) {
+            return $forbidden;
+        }
+
+        $queue = $this->resolveQueue($request, $context);
+
+        if ($queue instanceof JsonResponse) {
+            return $queue;
+        }
+
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priority = $request->input('priority');
+
+        if (! is_int($priority) || ! TotemPriorities::isValid($priority)) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = $issueTicket($queue, $priority, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $level = TotemPriorities::find($priority);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+            ],
+            'priority' => [
+                'value' => $level['value'],
+                'label' => $level['label'],
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601ZuluString(),
+        ], 201);
+    }
+}
