@@ -0,0 +1,94 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Context\TotemContext;
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Closure;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class AuthenticateTotem
+{
+    public function __construct(private TotemJwt $jwt) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            return $this->invalidToken();
+        }
+
+        $claims = $this->jwt->decode($token);
+
+        if ($claims === null) {
+            return $this->invalidToken();
+        }
+
+        $totemId = $claims['totem_id'] ?? null;
+        $entityId = $claims['entity_id'] ?? null;
+        $presetId = $claims['preset_id'] ?? null;
+        $queueIds = $claims['queues'] ?? null;
+
+        if (! is_numeric($totemId) || ! is_numeric($entityId) || ! is_numeric($presetId) || ! is_array($queueIds)) {
+            return $this->invalidToken();
+        }
+
+        $totem = Totem::query()->find((int) $totemId);
+        $preset = TotemPreset::query()->find((int) $presetId);
+        $entity = Entity::query()->find((int) $entityId);
+
+        if ($totem === null || $preset === null || $entity === null) {
+            return $this->invalidToken();
+        }
+
+        if (! $totem->is_active || ! $preset->is_active) {
+            return $this->invalidToken();
+        }
+
+        if ((int) $totem->entity_id !== (int) $entityId || (int) $preset->entity_id !== (int) $entityId) {
+            return $this->invalidToken();
+        }
+
+        $currentPresetQueueIds = $preset->queues()
+            ->pluck('queues.id')
+            ->map(fn ($id) => (int) $id)
+            ->all();
+
+        $claimedQueueIds = [];
+
+        foreach ($queueIds as $queueId) {
+            if (! is_int($queueId) && ! (is_string($queueId) && ctype_digit($queueId))) {
+                return $this->invalidToken();
+            }
+
+            $claimedQueueIds[] = (int) $queueId;
+        }
+
+        $claimedQueueIds = array_values(array_unique($claimedQueueIds));
+
+        $effectiveQueueIds = array_values(array_intersect(
+            $claimedQueueIds,
+            $currentPresetQueueIds,
+        ));
+
+        $totem->updateQuietly(['last_seen_at' => now()]);
+
+        $request->attributes->set(
+            'totem_context',
+            new TotemContext($totem, $preset, $entity, $effectiveQueueIds),
+        );
+
+        return $next($request);
+    }
+
+    private function invalidToken(): JsonResponse
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
