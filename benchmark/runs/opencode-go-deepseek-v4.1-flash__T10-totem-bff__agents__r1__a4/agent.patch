+<?php
+
+namespace App\Support;
+
+use App\Models\Queue;
+
+/**
+ * Presentation defaults and optional per-preset overrides for totem payloads.
+ */
+class TotemVisuals
+{
+    private const QUEUE_COLOR = '#0055FF';
+
+    private const QUEUE_ICON = 'ticket';
+
+    /**
+     * @return array{slug: string, label: string, description: ?string, visual: array{color: string, icon: string, order: int}, is_active: bool}
+     */
+    public static function queue(Queue $queue, ?array $appearance, int $order): array
+    {
+        $config = $appearance['queues'][$queue->slug] ?? [];
+        $config = is_array($config) ? $config : [];
+        $visual = is_array($config['visual'] ?? null) ? $config['visual'] : [];
+
+        $description = $config['description']
+            ?? (is_array($queue->labels_i18n) ? ($queue->labels_i18n['description'] ?? null) : null);
+
+        return [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => $description,
+            'visual' => [
+                'color' => $visual['color'] ?? $config['color'] ?? self::QUEUE_COLOR,
+                'icon' => $visual['icon'] ?? $config['icon'] ?? self::QUEUE_ICON,
+                'order' => $order,
+            ],
+            'is_active' => true,
+        ];
+    }
+}
