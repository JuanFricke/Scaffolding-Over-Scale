+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Foundation\Auth\Access\AuthorizesRequests;
+use Illuminate\Support\Facades\DB;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    use AuthorizesRequests;
+
+    #[Locked]
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    public ?int $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $validated = $this->validate([
+            'name' => 'required|string|max:255',
+            'slug' => 'required|string|max:255|alpha_dash|unique:entities,slug,'.$this->entity->id,
+        ]);
+
+        $this->entity->update($validated);
+        $this->entity->refresh();
+    }
+
+    public function delete(): mixed
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $entity = Entity::findOrFail($this->entity->id);
+
+        $this->authorize('manageSettings', $entity);
+
+        DB::transaction(function () use ($entity): void {
+            $entity->memberships()->delete();
+            $entity->delete();
+        });
+
+        if ((int) session('current_entity_id') === (int) $entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        return $this->redirect(route('home'), navigate: true);
+    }
+
+    public function transfer(): mixed
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $entity = Entity::findOrFail($this->entity->id);
+
+        $this->authorize('manageSettings', $entity);
+
+        $target = $entity->memberships()->find($this->targetMembershipId);
+
+        if ($target === null) {
+            abort(403);
+        }
+
+        if ($target->role !== UserRole::Admin) {
+            abort(403);
+        }
+
+        if ((int) $target->user_id === (int) auth()->id()) {
+            abort(403);
+        }
+
+        $owner = $entity->memberships()->owner()->first();
+
+        if ($owner === null) {
+            abort(403);
+        }
+
+        if ((int) $owner->user_id !== (int) auth()->id()) {
+            abort(403);
+        }
+
+        DB::transaction(function () use ($owner, $target): void {
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+        });
+
+        return $this->redirect(route('entity.dashboard', $entity), navigate: true);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'admins' => $this->entity->memberships()->with('user')->admin()->get(),
+        ]);
+    }
+}
