+test('appends a user mention on its own line when mention id is configured', function () {
+    $url = fakeDiscordWebhook();
+    config(['services.discord.mention_id' => '12345678901234567']);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        expect($content)->toContain('<@12345678901234567>');
+
+        return str_ends_with($content, "\n<@12345678901234567>");
+    });
+});
+
+test('does not mention when mention id is null or empty', function () {
+    $url = fakeDiscordWebhook();
+    config(['services.discord.mention_id' => null]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '']);
+
+test('ignores invalid mention ids without emitting a mention', function (mixed $id) {
+    $url = fakeDiscordWebhook();
+    config(['services.discord.mention_id' => $id]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([
+    '@everyone', '@here', 'abc', '123', '1234567890123456',
+    '12345678901234567890123', "12345678901234567\n@everyone", "12345678901234567> \n@everyone",
+    '  ', 12.5,
+]);
+
+test('accepts an integer mention id and surrounding whitespace', function () {
+    $url = fakeDiscordWebhook();
+    config(['services.discord.mention_id' => 12345678901234567]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@12345678901234567>"));
+});
+
+test('mention survives truncation and keeps content within 1800 characters', function () {
+    $url = fakeDiscordWebhook();
+    config(['services.discord.mention_id' => '12345678901234567']);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        expect(mb_strlen($content))->toBe(1800)
+            ->and($content)->toEndWith("\n<@12345678901234567>");
+
+        return true;
+    });
+});
