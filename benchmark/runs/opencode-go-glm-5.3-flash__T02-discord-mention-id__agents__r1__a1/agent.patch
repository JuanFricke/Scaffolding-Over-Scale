-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength - mb_strlen($this->mentionSuffix()));
+    }
+
+    /**
+     * Mention ("\n<@ID>") of the configured on-call user, or '' when unset/invalid.
+     */
+    private function mentionSuffix(): string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (is_int($id)) {
+            $id = (string) $id;
+        }
+
+        if (! is_string($id)) {
+            return '';
+        }
+
+        $id = trim($id);
+
+        if (! preg_match(self::MentionIdPattern, $id)) {
+            return '';
+        }
+
+        return "\n<@{$id}>";
     }
 
