 });
+
+test('appends a user mention on its own line when a valid mention id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@123456789012345678>"));
+});
+
+test('trims surrounding whitespace and accepts integer mention ids', function (mixed $configured, string $expected) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $configured]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@{$expected}>"));
+})->with([
+    'padded string' => ['  123456789012345678  ', '123456789012345678'],
+    'integer' => [1234567890123456789, '1234567890123456789'],
+]);
+
+test('adds no mention when the mention id is null or empty', function (mixed $configured) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $configured]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '', '   ']);
+
+test('ignores invalid mention ids silently without emitting a mention', function (mixed $configured) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $configured]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([
+    'everyone' => ['@everyone'],
+    'here' => ['@here'],
+    'letters' => ['abc'],
+    'too short' => ['123'],
+    'too short digits' => ['1234567890123456'],
+    'too long digits' => ['123456789012345678901'],
+    'embedded newline' => ["123\n@everyone"],
+    'extra characters' => ["123> \n@everyone"],
+    'already formatted' => ['<@123456789012345678>'],
+    'non-digit suffix' => ['1234567890123456a78'],
