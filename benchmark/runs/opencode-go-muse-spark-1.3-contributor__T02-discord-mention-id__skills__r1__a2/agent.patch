diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..d71d595 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,43 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $mention = $this->mentionSuffix();
+
+        if ($mention === null) {
+            return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        }
+
+        $budget = self::MaxContentLength - mb_strlen($mention);
+
+        return mb_substr(implode("\n", $lines), 0, $budget).$mention;
+    }
+
+    /**
+     * Resolve the configured Discord user mention suffix (e.g. "\n<@123>").
+     *
+     * Only a Discord snowflake (17-20 ASCII digits, surrounding whitespace
+     * trimmed; integer values accepted) is honored. Anything else is ignored
+     * silently so values like "@everyone" can never become a mention.
+     */
+    private function mentionSuffix(): ?string
+    {
+        $raw = config('services.discord.mention_id');
+
+        if (is_int($raw)) {
+            $raw = (string) $raw;
+        }
+
+        if (! is_string($raw)) {
+            return null;
+        }
+
+        $id = trim($raw);
+
+        if (! preg_match('/\A[0-9]{17,20}\z/', $id)) {
+            return null;
+        }
+
+        return "\n<@{$id}>";
     }
 
     private function safe(string $key, mixed $value): string
