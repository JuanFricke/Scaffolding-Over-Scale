@@ -0,0 +1,79 @@
+<?php
+
+namespace App\Policies;
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+
+class QueuePolicy
+{
+    /**
+     * Determine whether the user can create a queue in the given entity.
+     */
+    public function create(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity->id);
+    }
+
+    /**
+     * Determine whether the user can update the queue.
+     */
+    public function update(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, $queue->entity_id);
+    }
+
+    /**
+     * Determine whether the user can manage per-queue access grants.
+     */
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, $queue->entity_id);
+    }
+
+    /**
+     * Determine whether the user can call tickets on the queue.
+     *
+     * Owner/admin of the queue's entity always; an employee only with a
+     * queue_access row for that queue whose permissions array contains
+     * 'call' (a corrupted non-array value denies); everyone else denied.
+     */
+    public function call(User $user, Queue $queue): bool
+    {
+        $membership = $user->membershipFor($queue->entity_id);
+
+        if (! $membership) {
+            return false;
+        }
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            return true;
+        }
+
+        $access = QueueAccess::query()
+            ->where('entity_membership_id', $membership->getKey())
+            ->where('queue_id', $queue->getKey())
+            ->first();
+
+        if ($access === null) {
+            return false;
+        }
+
+        $permissions = $access->permissions;
+
+        return is_array($permissions)
+            && in_array(QueuePermission::Call->value, $permissions, true);
+    }
+
+    protected function isManager(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return (bool) $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
