@@ -0,0 +1,72 @@
+<?php
+
+namespace Database\Factories;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    protected $model = QueueAccess::class;
+
+    /**
+     * Define the model's default state.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'entity_membership_id' => EntityMembership::factory(),
+            'queue_id' => Queue::factory(),
+            'permissions' => [QueuePermission::Call->value],
+        ];
+    }
+
+    public function configure(): static
+    {
+        return $this->afterMaking(function (QueueAccess $access): void {
+            $this->alignEntities($access);
+        })->afterCreating(function (QueueAccess $access): void {
+            $membership = $access->membership()->first();
+            $queue = $access->queue()->first();
+
+            if ($membership && $queue && (int) $membership->entity_id !== (int) $queue->entity_id) {
+                $queue->forceFill(['entity_id' => $membership->entity_id])->save();
+            }
+
+            $access->refresh();
+        });
+    }
+
+    private function alignEntities(QueueAccess $access): void
+    {
+        if (! $access->relationLoaded('membership') || ! $access->relationLoaded('queue')) {
+            return;
+        }
+
+        $membership = $access->getRelation('membership');
+        $queue = $access->getRelation('queue');
+
+        // When both sides were made by their own factories they carry
+        // different entities; re-point the queue at the membership entity so
+        // the default factory always yields a same-entity pair. Explicit
+        // caller overrides that already share an entity are left untouched.
+        if ($membership instanceof EntityMembership
+            && $queue instanceof Queue
+            && $membership->entity_id !== null
+            && $queue->entity_id !== null
+            && (int) $membership->entity_id !== (int) $queue->entity_id
+        ) {
+            $queue->forceFill(['entity_id' => $membership->entity_id]);
+            $access->setRelation('queue', $queue);
+            $access->setAttribute('queue_id', $queue->getKey());
+        }
+    }
+}
