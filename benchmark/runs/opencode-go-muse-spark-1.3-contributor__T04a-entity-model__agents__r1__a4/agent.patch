+<?php
+
+namespace App\Models;
+
+use Database\Factories\EntityMembershipFactory;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+/**
+ * @method static Builder|static owner()
+ * @method static Builder|static admin()
+ * @method static Builder|static employee()
+ */
+class EntityMembership extends Model
+{
+    /** @use HasFactory<EntityMembershipFactory> */
+    use HasFactory;
+
+    protected $fillable = ['entity_id', 'user_id', 'role'];
+
+    protected function casts(): array
+    {
+        return [
+            'role' => UserRole::class,
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * @return BelongsTo<User, $this>
+     */
+    public function user(): BelongsTo
+    {
+        return $this->belongsTo(User::class);
+    }
+
+    /**
+     * @param  Builder<EntityMembership>  $query
+     * @return Builder<EntityMembership>
+     */
+    public function scopeOwner(Builder $query): Builder
+    {
+        return $query->where('role', UserRole::Owner);
+    }
+
+    /**
+     * @param  Builder<EntityMembership>  $query
+     * @return Builder<EntityMembership>
+     */
+    public function scopeAdmin(Builder $query): Builder
+    {
+        return $query->where('role', UserRole::Admin);
+    }
+
+    /**
+     * @param  Builder<EntityMembership>  $query
+     * @return Builder<EntityMembership>
+     */
+    public function scopeEmployee(Builder $query): Builder
+    {
+        return $query->where('role', UserRole::Employee);
+    }
+}
