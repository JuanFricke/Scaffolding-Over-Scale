+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Enums\TicketChannel;
+use App\Models\Ticket;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use Illuminate\Support\Facades\DB;
+
+class IssueTicket
+{
+    /**
+     * Issue a ticket for the given queue.
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new \InvalidArgumentException('Priority must be non-negative.');
+        }
+        $ticket = null;
+        DB::transaction(function () use (&$ticket, $queue, $priority, $channel) {
+            // Lock queue row
+            $queue = Queue::where('id', $queue->id)->lockForUpdate()->firstOrFail();
+            if (!$queue->is_active) {
+                throw new InactiveQueueException();
+            }
+            $code = Ticket::nextCode($queue->id);
+            $ticket = Ticket::create([
+                'queue_id' => $queue->id,
+                'priority' => $priority,
+                'channel' => $channel,
+                'status' => TicketStatus::Waiting,
+                'issued_at' => now(),
+                'code' => $code,
+            ]);
+        }, 5);
+        return $ticket;
+    }
+}
