--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,101 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Attributes\Castable;
+use Illuminate\Database\Eloquent\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\DateTime;
+use Illuminate\Contracts\Validation\ValidationException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+#[Castable([
+    'priority' => 'integer',
+    'channel' => TicketChannel::class,
+    'status' => TicketStatus::class,
+    'issued_at' => 'datetime',
+    'called_at' => 'datetime',
+    'called_by_user_id' => 'integer',
+])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    protected function casts(): array
+    {
+        return [];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Generate the next display code for the queue.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = DB::table('tickets')
+            ->where('queue_id', $queueId)
+            ->where('code', 'like', 'A%')
+            ->orderByRaw('CAST(SUBSTRING(code, 2) AS UNSIGNED) DESC')
+            ->first();
+        $nextNum = 1;
+        if ($last) {
+            $num = (int)substr($last->code, 1);
+            $nextNum = $num + 1;
+        }
+        if ($nextNum < 1000) {
+            return 'A' . str_pad((string)$nextNum, 3, '0', STR_PAD_LEFT);
+        }
+        return 'A' . $nextNum;
+    }
+
+    /**
+     * Call the ticket.
+     */
+    public function call(User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new \LogicException('Only waiting tickets can be called.');
+        }
+        // Authorization: user must belong to the same entity
+        $entityId = $this->queue->entity_id;
+        $isMember = $user->entity_memberships()->where('entity_id', $entityId)->exists();
+        if (!$isMember) {
+            throw new \Illuminate\Auth\Access\AuthorizationException();
+        }
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->save();
+    }
+
+    /**
+     * Override save to enforce write-once rule.
+     */
+    public function save(array $options = []): bool
+    {
+        if ($this->exists) {
+            $allowed = ['status', 'called_at', 'called_by_user_id'];
+            $dirty = $this->getDirty();
+            $disallowed = array_diff(array_keys($dirty), $allowed);
+            if (!empty($disallowed)) {
+                throw new \LogicException('Ticket fields are immutable after issuance.');
+            }
+        }
+        return parent::save($options);
+    }
+}
