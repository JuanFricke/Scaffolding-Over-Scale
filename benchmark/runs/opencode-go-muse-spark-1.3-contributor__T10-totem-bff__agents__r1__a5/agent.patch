+test('pairing login returns jwt with entity context', function () {
+    $entity = Entity::factory()->create(['name' => 'Loja Centro']);
+    $queue = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('entity.name', 'Loja Centro');
+
+    $payload = TotemJwt::verify($response->json('token'));
+
+    expect($payload)->not->toBeNull()
+        ->and($payload['entity_id'])->toBe($entity->id)
+        ->and($payload['preset_id'])->toBe($preset->id)
+        ->and($payload['queues'])->toBe([$queue->id])
+        ->and($payload)->toHaveKeys(['totem_id', 'iat', 'exp', 'jti']);
+
+    $totem = Totem::query()->find($payload['totem_id']);
+
+    expect($totem)->not->toBeNull()
+        ->and($totem->entity_id)->toBe($entity->id)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull();
+
+    expect($preset->fresh()->login_code_consumed_at)->not->toBeNull();
+});
