+function totemPair(Entity $entity, array $queueAttributes = [[]]): array
+{
+    $queues = collect($queueAttributes)->map(
+        fn (array $attrs): Queue => Queue::factory()->for($entity)->create($attrs)
+    )->all();
+
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach(collect($queues)->map->id->all());
+
+    $response = test()->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk();
+
+    return [$preset->fresh(), $queues, $response->json('token')];
+}
+
+function totemAuthHeaders(string $token): array
+{
+    return ['Authorization' => "Bearer {$token}"];
+}
