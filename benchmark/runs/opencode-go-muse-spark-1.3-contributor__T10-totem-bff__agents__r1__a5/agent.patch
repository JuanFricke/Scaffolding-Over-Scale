+    $headers = totemAuthHeaders($token);
+    [$queue] = $queues;
+
+    $queue->update(['is_active' => false]);
+    $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], $headers)
+        ->assertStatus(422)->assertJson(['code' => 'inactive_queue']);
+    $queue->update(['is_active' => true]);
+
+    $other = Queue::factory()->create();
+    $this->postJson("/api/{$entity->slug}/{$other->slug}/ticket", ['priority' => 0], $headers)
+        ->assertStatus(404)->assertJson(['code' => 'queue_not_found']);
+
+    $hidden = Queue::factory()->for($entity)->create();
+    $this->postJson("/api/{$entity->slug}/{$hidden->slug}/ticket", ['priority' => 0], $headers)
+        ->assertStatus(403)->assertJson(['code' => 'forbidden']);
+});
+
+test('ticket issuance is throttled to 30 requests per minute', function () {
+    [$preset, $queues, $token] = totemPair($entity = Entity::factory()->create());
+    [$queue] = $queues;
+    $url = "/api/{$entity->slug}/{$queue->slug}/ticket";
+    $headers = totemAuthHeaders($token);
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson($url, ['priority' => 0], $headers)->assertStatus(201);
+    }
+
+    $this->postJson($url, ['priority' => 0], $headers)->assertStatus(429)->assertJson(['code' => 'rate_limited']);
+});
+
+test('api answers cors only for local origins', function () {
+    $preflight = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'http://localhost:8081',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    expect($preflight->getStatusCode())->toBe(204)
+        ->and($preflight->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+
+    $denied = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'https://evil.example.com',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    expect($denied->headers->has('Access-Control-Allow-Origin'))->toBeFalse();
+
+    [$preset, , $token] = totemPair(Entity::factory()->create());
+
+    $response = $this->getJson('/api/x/queues', ['Origin' => 'https://evil.example.com'] + totemAuthHeaders($token));
+    expect($response->headers->has('Access-Control-Allow-Origin'))->toBeFalse();
+});
