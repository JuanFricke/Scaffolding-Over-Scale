+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('pairing command generates a 10 minute single-use code', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => null]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    $preset->refresh();
+
+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->login_code_expires_at->gt(now()->addMinutes(9)))->toBeTrue()
+        ->and($preset->login_code_expires_at->lte(now()->addMinutes(10)))->toBeTrue();
+});
+
+test('pairing command regenerates the previous code and clears consumption', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '123456',
+        'login_code_consumed_at' => now(),
+    ]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    $preset->refresh();
+
+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code)->not->toBe('123456')
+        ->and($preset->login_code_consumed_at)->toBeNull();
+});
+
+test('pairing command fails for an unknown preset', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999999])->assertFailed();
+});
