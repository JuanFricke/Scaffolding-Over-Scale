--- /dev/null
+++ b/app/Support/TotemPriorities.php
@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Support;
+
+/**
+ * Backend-owned priority levels for totem issuance.
+ *
+ * Single source of truth used by both `GET priorities` and ticket issuance
+ * validation: numeric value decides ordering (higher = more prioritized),
+ * label/visual are display-only.
+ */
+final class TotemPriorities
+{
+    /**
+     * @return list<array{value: int, label: string, color: string, icon: string}>
+     */
+    public static function all(): array
+    {
+        return [
+            ['value' => 0, 'label' => 'Normal', 'color' => '#2E7D32', 'icon' => 'person'],
+            ['value' => 10, 'label' => 'Prioritário', 'color' => '#C62828', 'icon' => 'priority'],
+            ['value' => 20, 'label' => 'Prioridade 80+', 'color' => '#6A1B9A', 'icon' => 'priority_80'],
+        ];
+    }
+
+    /**
+     * @return list<int>
+     */
+    public static function values(): array
+    {
+        return array_column(self::all(), 'value');
+    }
+
+    /**
+     * @return array{value: int, label: string, color: string, icon: string}|null
+     */
+    public static function find(int $value): ?array
+    {
+        foreach (self::all() as $priority) {
+            if ($priority['value'] === $value) {
+                return $priority;
+            }
+        }
+
+        return null;
+    }
+}
