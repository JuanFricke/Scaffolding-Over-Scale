+<?php
+
+namespace App\Models;
+
+use Database\Factories\TotemPresetFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\BelongsToMany;
+
+#[Fillable([
+    'entity_id',
+    'name',
+    'login_code',
+    'login_code_expires_at',
+    'login_code_consumed_at',
+    'appearance',
+    'is_active',
+])]
+class TotemPreset extends Model
+{
+    /** @use HasFactory<TotemPresetFactory> */
+    use HasFactory;
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'is_active' => 'boolean',
+            'appearance' => 'array',
+            'login_code_expires_at' => 'datetime',
+            'login_code_consumed_at' => 'datetime',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Queues this preset may see and issue from.
+     *
+     * @return BelongsToMany<Queue, $this>
+     */
+    public function queues(): BelongsToMany
+    {
+        return $this->belongsToMany(Queue::class, 'totem_preset_queue', 'preset_id', 'queue_id')
+            ->withTimestamps();
+    }
+}
diff --git a/app/Support/TotemJwt.php b/app/Support/TotemJwt.php
new file mode 100644
index 0000000..a405cc9
--- /dev/null
+++ b/app/Support/TotemJwt.php
@@ -0,0 +1,132 @@
+<?php
+
+namespace App\Support;
+
+use Illuminate\Support\Str;
+use LogicException;
+
+/**
+ * Minimal HS256 JWT issuer/verifier for totem device credentials.
+ *
+ * Kept dependency-free on purpose: the claims surface is tiny and fully
+ * owned by this monolith (no third-party JWT feature set is needed).
+ */
+final class TotemJwt
+{
+    /**
+     * Sign claims into a compact JWT.
+     *
+     * @param  array<string, mixed>  $claims
+     */
+    public static function sign(array $claims, ?int $ttl = null): string
+    {
+        $secret = self::secret();
+        $now = time();
+        $ttl ??= (int) config('services.totem.jwt_ttl', 3600);
+
+        $payload = array_merge($claims, [
+            'iat' => $now,
+            'exp' => $now + $ttl,
+            'jti' => (string) Str::uuid(),
+        ]);
+
+        $header = self::encode(['alg' => 'HS256', 'typ' => 'JWT']);
+        $body = self::encode($payload);
+        $signature = self::signature("{$header}.{$body}", $secret);
+
+        return "{$header}.{$body}.{$signature}";
+    }
+
+    /**
+     * Verify signature + expiry. Returns the payload, or null when invalid.
+     *
+     * @return array<string, mixed>|null
+     */
+    public static function verify(string $token): ?array
+    {
+        $secret = self::secret();
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3 || $parts[0] === '' || $parts[1] === '' || $parts[2] === '') {
+            return null;
+        }
+
+        [$header, $body, $signature] = $parts;
+
+        $expected = self::signature("{$header}.{$body}", $secret);
+
+        if (! hash_equals($expected, $signature)) {
+            return null;
+        }
+
+        $decodedHeader = self::decode($header);
+
+        if (! is_array($decodedHeader) || ($decodedHeader['alg'] ?? null) !== 'HS256') {
+            return null;
+        }
+
+        $payload = self::decode($body);
+
+        if (! is_array($payload)) {
+            return null;
+        }
+
+        if (! isset($payload['exp']) || ! is_numeric($payload['exp']) || (int) $payload['exp'] <= time()) {
+            return null;
+        }
+
+        return $payload;
+    }
+
+    public static function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl', 3600);
+    }
+
+    private static function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret', '');
+
+        if ($secret === '') {
+            throw new LogicException('Totem JWT secret is not configured.');
+        }
+
+        return $secret;
+    }
+
+    /**
+     * @param  array<string, mixed>  $data
+     */
+    private static function encode(array $data): string
+    {
+        return rtrim(strtr(base64_encode((string) json_encode($data)), '+/', '-_'), '=');
+    }
+
+    /**
+     * @return array<string, mixed>|null
+     */
+    private static function decode(string $segment): ?array
+    {
+        $padded = strtr($segment, '-_', '+/');
+        $remainder = strlen($padded) % 4;
+
+        if ($remainder > 0) {
+            $padded .= str_repeat('=', 4 - $remainder);
+        }
+
+        $json = base64_decode($padded, true);
+
+        if ($json === false) {
+            return null;
+        }
+
+        $decoded = json_decode($json, true);
+
+        return is_array($decoded) ? $decoded : null;
+    }
+
+    private static function signature(string $signingInput, string $secret): string
+    {
+        return rtrim(strtr(base64_encode(hash_hmac('sha256', $signingInput, $secret, true)), '+/', '-_'), '=');
+    }
+}
