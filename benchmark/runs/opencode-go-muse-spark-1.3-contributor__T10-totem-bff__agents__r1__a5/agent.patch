@@ -0,0 +1,48 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+class TotemPairingCode extends Command
+{
+    /**
+     * @var string
+     */
+    protected $signature = 'totem:pairing-code {preset : ID of the totem preset to open pairing for}';
+
+    /**
+     * @var string
+     */
+    protected $description = 'Generate a single-use 6-digit pairing code for a totem preset (valid for 10 minutes)';
+
+    public function handle(): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if ($preset === null) {
+            $this->error("Totem preset #{$this->argument('preset')} not found.");
+
+            return self::FAILURE;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        Log::channel('audit')->info('Totem pairing code generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        $this->info("Pairing code for preset [{$preset->name}]: {$code}");
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemAuthController.php b/app/Http/Controllers/Api/TotemAuthController.php
new file mode 100644
index 0000000..e53b3bb
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemAuthController.php
@@ -0,0 +1,88 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    public function login(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_scalar($code) || ! preg_match('/^\d{6}$/', (string) $code)) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $code = (string) $code;
+
+        /** @var array{0: TotemPreset, 1: Totem}|null $result */
+        $result = DB::transaction(function () use ($code): ?array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (
+                $preset === null
+                || ! $preset->is_active
+                || $preset->login_code_consumed_at !== null
+                || $preset->login_code_expires_at === null
+                || $preset->login_code_expires_at->isPast()
+            ) {
+                return null;
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => "Totem {$preset->name}",
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            return [$preset->load('entity'), $totem];
+        });
+
+        if ($result === null) {
+            Log::channel('audit')->warning('Totem pairing failed', ['reason' => 'invalid_pairing_code']);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        [$preset, $totem] = $result;
+
+        $queueIds = $preset->queues()->pluck('queues.id')->map(fn ($id): int => (int) $id)->all();
+
+        $token = TotemJwt::sign([
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => $queueIds,
+        ]);
+
+        Log::channel('audit')->info('Totem pairing succeeded', [
+            'totem_id' => $totem->id,
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => TotemJwt::ttl(),
+            'entity' => [
+                'slug' => $preset->entity->slug,
+                'name' => $preset->entity->name,
+            ],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemQueueController.php b/app/Http/Controllers/Api/TotemQueueController.php
new file mode 100644
index 0000000..d8aff63
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemQueueController.php
@@ -0,0 +1,167 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Support\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController extends Controller
+{
+    public function queues(Request $request, string $entity): JsonResponse
+    {
+        $entityModel = $this->resolveEntity($request, $entity);
+
+        if ($entityModel instanceof JsonResponse) {
+            return $entityModel;
+        }
+
+        /** @var list<int> $scope */
+        $scope = $request->attributes->get('totem_queue_ids', []);
+
+        $queues = Queue::query()
+            ->where('entity_id', $entityModel->id)
+            ->whereIn('id', $scope)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        $payload = $queues->values()->map(fn (Queue $queue, int $index): array => [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => null,
+            'visual' => [
+                'color' => '#0055FF',
+                'icon' => 'ticket',
+                'order' => $index + 1,
+            ],
+            'is_active' => true,
+        ])->all();
+
+        return response()->json([
+            'entity' => ['slug' => $entityModel->slug, 'name' => $entityModel->name],
+            'queues' => $payload,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        [$entityModel, $queueModel] = $resolved;
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priorities = array_map(
+            fn (array $priority, int $index): array => [
+                'value' => $priority['value'],
+                'label' => $priority['label'],
+                'visual' => [
+                    'color' => $priority['color'],
+                    'icon' => $priority['icon'],
+                    'order' => $index + 1,
+                ],
+            ],
+            TotemPriorities::all(),
+            array_keys(TotemPriorities::all()),
+        );
+
+        return response()->json([
+            'entity' => ['slug' => $entityModel->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => $priorities,
+        ]);
+    }
+
+    public function issueTicket(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        [, $queueModel] = $resolved;
+
+        $priority = $request->input('priority');
+
+        if (is_string($priority) && preg_match('/^-?\d+$/', $priority)) {
+            $priority = (int) $priority;
+        }
+
+        $matched = is_int($priority) ? TotemPriorities::find($priority) : null;
+
+        if ($matched === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = (new IssueTicket)($queueModel, $matched['value'], TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => ['value' => $matched['value'], 'label' => $matched['label']],
+            'issued_at' => $ticket->issued_at->toISO8601String(),
+        ], 201);
+    }
+
+    /**
+     * The path entity must exist and equal the token's entity, else 403.
+     */
+    private function resolveEntity(Request $request, string $slug): Entity|JsonResponse
+    {
+        $entity = Entity::query()->where('slug', $slug)->first();
+
+        if ($entity === null || (int) $entity->id !== (int) $request->attributes->get('totem_entity_id')) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return $entity;
+    }
+
+    /**
+     * @return array{0: Entity, 1: Queue}|JsonResponse
+     */
+    private function resolveQueue(Request $request, string $entity, string $queue): array|JsonResponse
+    {
+        $entityModel = $this->resolveEntity($request, $entity);
+
+        if ($entityModel instanceof JsonResponse) {
+            return $entityModel;
+        }
+
+        $queueModel = Queue::query()
+            ->where('entity_id', $entityModel->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if ($queueModel === null) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        /** @var list<int> $scope */
+        $scope = $request->attributes->get('totem_queue_ids', []);
+
+        if (! in_array((int) $queueModel->id, $scope, true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return [$entityModel, $queueModel];
+    }
+}
diff --git a/app/Http/Middleware/TotemAuth.php b/app/Http/Middleware/TotemAuth.php
