index 0000000..79994ac
--- /dev/null
+++ b/app/Http/Middleware/TotemAuth.php
@@ -0,0 +1,86 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Throwable;
+
+/**
+ * Validates the totem JWT on every authenticated totem call.
+ *
+ * Missing/invalid/expired token, unknown or inactive totem, unknown or
+ * inactive preset, or any entity mismatch between claims, totem and preset
+ * all answer `401 {"code":"invalid_token"}` without leaking which check
+ * failed. On success the resolved rows and the effective queue scope (JWT
+ * `queues` claim ∩ preset's current join) are stored on the request.
+ */
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $payload = $this->payload($request);
+
+        if ($payload === null) {
+            return $this->deny();
+        }
+
+        $totem = isset($payload['totem_id']) ? Totem::query()->find($payload['totem_id']) : null;
+        $preset = isset($payload['preset_id']) ? TotemPreset::query()->find($payload['preset_id']) : null;
+
+        if (
+            $totem === null || ! $totem->is_active
+            || $preset === null || ! $preset->is_active
+            || ! isset($payload['entity_id'])
+            || (int) $payload['entity_id'] !== (int) $totem->entity_id
+            || (int) $payload['entity_id'] !== (int) $preset->entity_id
+            || (int) $totem->entity_id !== (int) $preset->entity_id
+        ) {
+            return $this->deny();
+        }
+
+        $claimQueues = $payload['queues'] ?? [];
+        $claimQueues = is_array($claimQueues) ? array_map('intval', $claimQueues) : [];
+
+        $presetQueues = $preset->queues()->pluck('queues.id')->map(fn ($id): int => (int) $id)->all();
+        $effective = array_values(array_intersect($claimQueues, $presetQueues));
+
+        // Heartbeat: record the device as seen. Quiet by design (no audit noise).
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity_id', (int) $totem->entity_id);
+        $request->attributes->set('totem_queue_ids', $effective);
+
+        return $next($request);
+    }
+
+    /**
+     * @return array<string, mixed>|null
+     */
+    private function payload(Request $request): ?array
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            return null;
+        }
+
+        try {
+            return TotemJwt::verify($token);
+        } catch (Throwable) {
+            return null;
+        }
+    }
+
+    private function deny(): JsonResponse
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
