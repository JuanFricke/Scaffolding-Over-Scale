+<?php
+
+use App\Livewire\Entity\CreateEntity;
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+class EntityOnboardingRacingCreateEntity extends CreateEntity
+{
+    public static int $calls = 0;
+
+    protected function uniqueSlug(string $name): string
+    {
+        self::$calls++;
+
+        return self::$calls === 1 ? 'taken-slug' : 'free-slug';
+    }
+}
+
+test('guests are redirected from onboarding to login', function () {
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+});
+
+test('unverified users are redirected from onboarding to verification', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('onboarding'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the onboarding page renders its title and heading', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Crie sua entidade')
+        ->assertSee('Crie sua empresa');
+
+    app()->setLocale('en');
+
+    $this->actingAs($user)
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Create your entity')
+        ->assertSee('Create your company');
+});
+
+test('the name is required', function () {
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', '')
+        ->call('submit')
+        ->assertHasErrors('name');
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('submitting creates the entity, makes the creator owner and logs the audit event', function () {
+    $user = User::factory()->create();
+
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('Entity created', Mockery::on(
+        fn (array $context) => $context['actor_id'] === $user->id
+            && is_int($context['entity_id']),
+    ));
+
+    $this->actingAs($user);
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $entity = Entity::where('slug', 'acme-corp')->first();
+
+    expect($entity)->not->toBeNull()
+        ->and($entity->name)->toBe('Acme Corp')
+        ->and($entity->memberships()->count())->toBe(1)
+        ->and($entity->owner?->user_id)->toBe($user->id)
+        ->and($entity->owner?->role)->toBe(UserRole::Owner)
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('the creator cannot choose a different role', function () {
+    $user = User::factory()->create();
+    $this->actingAs($user);
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect(Entity::first()->owner?->user_id)->toBe($user->id)
+        ->and(Entity::first()->memberships()->count())->toBe(1);
+});
+
+test('duplicate names receive an incrementing slug suffix', function () {
+    $user = User::factory()->create();
+    $this->actingAs($user);
+
+    foreach (['acme-corp', 'acme-corp-2', 'acme-corp-3'] as $slug) {
+        Livewire::test(CreateEntity::class)
+            ->set('name', 'Acme Corp')
+            ->call('submit')
+            ->assertHasNoErrors();
+
+        expect(Entity::where('slug', $slug)->exists())->toBeTrue();
+    }
+
+    expect(Entity::count())->toBe(3);
+});
+
+test('a slug collision at insert time is retried', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['name' => 'Taken', 'slug' => 'taken-slug']);
+
+    EntityOnboardingRacingCreateEntity::$calls = 0;
+    $this->actingAs($user);
+
+    Livewire::test(EntityOnboardingRacingCreateEntity::class)
+        ->set('name', 'Racing')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect(EntityOnboardingRacingCreateEntity::$calls)->toBe(2)
+        ->and(Entity::where('slug', 'free-slug')->exists())->toBeTrue();
+});
