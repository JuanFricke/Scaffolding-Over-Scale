+
+    foreach (['owner', 'admin'] as $role) {
+        $user = User::factory()->create();
+        entityPolicyTestMembershipFor($user, $entity, $role);
+        $policy = new EntityPolicy;
+
+        expect($policy->update($user, $entity))->toBeTrue()
+            ->and($policy->delete($user, $entity))->toBeTrue();
+    }
+});
+
+test('employees and non-members may not update or delete an entity', function () {
+    $entity = Entity::factory()->create();
+    $employee = User::factory()->create();
+    $outsider = User::factory()->create();
+    entityPolicyTestMembershipFor($employee, $entity);
+    $policy = new EntityPolicy;
+
+    expect($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->delete($employee, $entity))->toBeFalse()
+        ->and($policy->update($outsider, $entity))->toBeFalse()
+        ->and($policy->delete($outsider, $entity))->toBeFalse();
+});
+
+test('only the owner may manage entity settings', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    entityPolicyTestMembershipFor($owner, $entity, 'owner');
+    entityPolicyTestMembershipFor($admin, $entity, 'admin');
+
+    $policy = new EntityPolicy;
+
+    expect($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse();
+});
+
+test('any member may view a membership', function () {
+    $entity = Entity::factory()->create();
+    $member = User::factory()->create();
+    $outsider = User::factory()->create();
+    $membership = entityPolicyTestMembershipFor($member, $entity);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($member, $membership))->toBeTrue()
+        ->and($policy->view($outsider, $membership))->toBeFalse();
+});
+
+test('owners and admins may assign roles and employees may not', function () {
+    $entity = Entity::factory()->create();
+    $target = entityPolicyTestMembershipFor(User::factory()->create(), $entity);
+    $policy = new EntityMembershipPolicy;
+
+    foreach (['owner', 'admin'] as $role) {
+        $user = User::factory()->create();
+        entityPolicyTestMembershipFor($user, $entity, $role);
+
+        expect($policy->assignRole($user, $target))->toBeTrue();
+    }
+
+    $employee = User::factory()->create();
+    entityPolicyTestMembershipFor($employee, $entity);
+
+    expect($policy->assignRole($employee, $target))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $membership = entityPolicyTestMembershipFor($owner, $entity, 'owner');
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($owner, $membership))->toBeFalse();
+});
+
+test('a member may remove themselves unless they are the owner', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityMembershipPolicy;
+
+    foreach (['admin', 'employee'] as $role) {
+        $user = User::factory()->create();
+        $membership = entityPolicyTestMembershipFor($user, $entity, $role);
+
+        expect($policy->delete($user, $membership))->toBeTrue();
+    }
+});
+
+test('owners and admins may remove other members', function () {
+    $entity = Entity::factory()->create();
+    $target = entityPolicyTestMembershipFor(User::factory()->create(), $entity);
+    $policy = new EntityMembershipPolicy;
+
+    foreach (['owner', 'admin'] as $role) {
+        $user = User::factory()->create();
+        entityPolicyTestMembershipFor($user, $entity, $role);
+
+        expect($policy->delete($user, $target))->toBeTrue();
+    }
+});
+
+test('employees and outsiders may not remove other members', function () {
+    $entity = Entity::factory()->create();
+    $target = entityPolicyTestMembershipFor(User::factory()->create(), $entity);
+    $employee = User::factory()->create();
+    $outsider = User::factory()->create();
+    entityPolicyTestMembershipFor($employee, $entity);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($employee, $target))->toBeFalse()
+        ->and($policy->delete($outsider, $target))->toBeFalse();
+});
diff --git a/tests/Feature/EntityTenantSessionTest.php b/tests/Feature/EntityTenantSessionTest.php
new file mode 100644
index 0000000..de6ece8
--- /dev/null
+++ b/tests/Feature/EntityTenantSessionTest.php
@@ -0,0 +1,196 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+function entityTenantTestJoinEntity(User $user, Entity $entity, string $role = 'employee'): EntityMembership
+{
+    return EntityMembership::factory()->{$role}()->for($entity)->for($user)->create();
+}
+
+test('new entity pages require authentication', function (string $routeName) {
+    $entity = Entity::factory()->create();
+
+    $this->get(route($routeName, ['entity' => $entity]))->assertRedirect(route('login'));
+})->with(['onboarding', 'entity.switcher', 'entity.dashboard']);
+
+test('new entity pages require a verified e-mail', function (string $routeName) {
+    $user = User::factory()->unverified()->create();
+    $entity = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route($routeName, ['entity' => $entity]))
+        ->assertRedirect(route('verification.notice'));
+})->with(['onboarding', 'entity.switcher', 'entity.dashboard']);
+
+test('home sends a user without memberships to onboarding', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('home selects the only membership and opens its dashboard', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    entityTenantTestJoinEntity($user, $entity);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('home sends users with several memberships to the switcher', function () {
+    $user = User::factory()->create();
+    entityTenantTestJoinEntity($user, Entity::factory()->create(), 'owner');
+    entityTenantTestJoinEntity($user, Entity::factory()->create());
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('the current entity middleware sends users without memberships to onboarding', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('the current entity middleware selects a sole membership', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Only Entity']);
+    entityTenantTestJoinEntity($user, $entity);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Only Entity')
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('the current entity middleware sends users with several memberships to the switcher', function () {
+    $user = User::factory()->create();
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+    entityTenantTestJoinEntity($user, $first, 'owner');
+    entityTenantTestJoinEntity($user, $second);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $first))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('the dashboard shows the current entity name', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Padaria Central']);
+    entityTenantTestJoinEntity($user, $entity);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $entity->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Padaria Central');
+});
+
+test('the dashboard forbids an entity the user does not belong to', function () {
+    $user = User::factory()->create();
+    $current = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    entityTenantTestJoinEntity($user, $current);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $current->id])
+        ->get(route('entity.dashboard', $other))
+        ->assertForbidden();
+});
+
+test('the middleware forbids a session entity the user does not belong to', function () {
+    $user = User::factory()->create();
+    $member = Entity::factory()->create();
+    $notMember = Entity::factory()->create();
+    entityTenantTestJoinEntity($user, $member);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $notMember->id])
+        ->get(route('entity.dashboard', $member))
+        ->assertForbidden();
+});
+
+test('the switcher lists only the user entities and marks the current one', function () {
+    $user = User::factory()->create();
+    $current = Entity::factory()->create(['name' => 'Current Company']);
+    $other = Entity::factory()->create(['name' => 'Other Company']);
+    $foreign = Entity::factory()->create(['name' => 'Foreign Company']);
+    entityTenantTestJoinEntity($user, $current);
+    entityTenantTestJoinEntity($user, $other);
+
+    $response = $this->actingAs($user)
+        ->withSession(['current_entity_id' => $current->id])
+        ->get(route('entity.switcher'));
+
+    $response->assertOk()
+        ->assertSee('Current Company')
+        ->assertSee('Other Company')
+        ->assertDontSee('Foreign Company')
+        ->assertSeeHtml('class="button is-fullwidth is-link" data-current="1"')
+        ->assertSeeHtml('class="button is-fullwidth is-light"')
+        ->assertSee('action="'.route('entity.pick', $other).'"', false);
+});
+
+test('picking an entity sets the session, writes an audit line and redirects', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    entityTenantTestJoinEntity($user, $entity);
+
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('Entity picked', Mockery::on(
+        fn (array $context) => $context['entity_id'] === $entity->id
+            && $context['actor_id'] === $user->id,
+    ));
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('picking an entity the user does not belong to is forbidden and keeps the session', function () {
+    $user = User::factory()->create();
+    $current = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    entityTenantTestJoinEntity($user, $current);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $current->id])
+        ->post(route('entity.pick', $other))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $current->id);
+});
+
+test('the navbar shows the switcher link only for users with several memberships', function () {
+    $user = User::factory()->create();
+    $first = Entity::factory()->create();
+    entityTenantTestJoinEntity($user, $first);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $first->id])
+        ->get(route('entity.dashboard', $first))
+        ->assertDontSee(route('entity.switcher'));
+
+    entityTenantTestJoinEntity($user, Entity::factory()->create());
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $first->id])
+        ->get(route('entity.dashboard', $first))
+        ->assertSee(route('entity.switcher'));
+});
diff --git a/tests/Feature/EntityTest.php b/tests/Feature/EntityTest.php
new file mode 100644
index 0000000..dec360f
--- /dev/null
+++ b/tests/Feature/EntityTest.php
@@ -0,0 +1,52 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('an entity binds routes by slug', function () {
+    $entity = Entity::factory()->create(['name' => 'Acme Corp', 'slug' => 'acme-corp']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme-corp');
+});
+
+test('an entity has memberships, users and an owner', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $employee = User::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->for($owner)->create();
+    EntityMembership::factory()->employee()->for($entity)->for($employee)->create();
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users)->toHaveCount(2)
+        ->and($entity->owner)->not->toBeNull()
+        ->and($entity->owner->user_id)->toBe($owner->id)
+        ->and($entity->owner->role)->toBe(UserRole::Owner);
+});
+
+test('a user can resolve their membership and entities', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->admin()->for($entity)->for($user)->create();
+
+    expect($user->memberships)->toHaveCount(1)
+        ->and($user->entities->pluck('id')->all())->toBe([$entity->id])
+        ->and($user->membershipFor($entity->id)?->role)->toBe(UserRole::Admin)
+        ->and($user->membershipFor($entity->id + 1))->toBeNull();
+});
+
+test('entities are soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
