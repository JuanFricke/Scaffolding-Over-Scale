@@ -0,0 +1,51 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class CurrentEntity
+{
+    /**
+     * Resolve the entity stored in the session into the request's tenant context.
+     *
+     * @param  Closure(Request): (Response)  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        if ($user === null) {
+            return $next($request);
+        }
+
+        $entityId = $request->session()->get('current_entity_id');
+
+        if ($entityId === null) {
+            $memberships = $user->memberships()->with('entity')->get();
+
+            if ($memberships->isEmpty()) {
+                return redirect()->route('onboarding');
+            }
+
+            if ($memberships->count() > 1) {
+                return redirect()->route('entity.switcher');
+            }
+
+            $entityId = $memberships->first()->entity_id;
+            $request->session()->put('current_entity_id', $entityId);
+        }
+
+        $membership = $user->membershipFor((int) $entityId);
+
+        if ($membership === null || $membership->entity === null) {
+            abort(403);
+        }
+
+        $request->attributes->set('current_entity', $membership->entity);
+
+        return $next($request);
+    }
+}
