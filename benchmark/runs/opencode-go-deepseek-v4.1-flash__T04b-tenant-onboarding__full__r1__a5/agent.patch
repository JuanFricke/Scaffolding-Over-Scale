diff --git a/tests/Feature/EntityMembershipTest.php b/tests/Feature/EntityMembershipTest.php
new file mode 100644
index 0000000..4c00db1
--- /dev/null
+++ b/tests/Feature/EntityMembershipTest.php
@@ -0,0 +1,74 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('the membership factory defaults to employee and creates its entity and user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+});
+
+test('membership factories expose role states', function () {
+    expect(EntityMembership::factory()->owner()->make()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->make()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->make()->role)->toBe(UserRole::Employee);
+});
+
+test('membership role scopes filter by role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('a user can join an entity only once', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the database allows only one owner per entity', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('several entities may each have their own owner', function () {
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect(EntityMembership::owner()->count())->toBe(2);
+});
+
+test('the database allows multiple admins and employees per entity', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(3);
+});
+
+test('the owner sequence generated column is present', function () {
+    expect(Schema::hasColumn('entity_memberships', 'owner_seq'))->toBeTrue();
+});
