+name: Deploy dev
+
+on:
+  push:
+    branches: [main, master]
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: Git ref to deploy
+        required: false
+        type: string
+      skip_tests:
+        description: Skip the Pest gate
+        required: false
+        default: false
+        type: boolean
+  workflow_call:
+    inputs:
+      ref:
+        required: false
+        type: string
+    secrets:
+      HOSTINGER_API:
+        required: true
+      PF_GIT_TOKEN:
+        required: false
+      APP_KEY:
+        required: false
+      DB_PASSWORD:
+        required: false
+      MYSQL_ROOT_PASSWORD:
+        required: false
+
+concurrency:
+  group: deploy-dev
+  cancel-in-progress: false
+
+jobs:
+  tests:
+    if: ${{ !inputs.skip_tests }}
+    uses: ./.github/workflows/tests.yml
+
+  deploy:
+    needs: tests
+    if: ${{ always() && (needs.tests.result == 'success' || inputs.skip_tests) }}
+    runs-on: ubuntu-latest
+
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.ref || github.ref }}
+
+      - name: Deploy to the dev VPS
+        run: ./bin/pf deploy
+        env:
+          HOSTINGER_API: ${{ secrets.HOSTINGER_API }}
+          PF_GIT_TOKEN: ${{ secrets.PF_GIT_TOKEN }}
+          PF_GIT_REF: ${{ inputs.ref || github.ref_name }}
+          APP_KEY: ${{ secrets.APP_KEY }}
+          DB_PASSWORD: ${{ secrets.DB_PASSWORD }}
+          MYSQL_ROOT_PASSWORD: ${{ secrets.MYSQL_ROOT_PASSWORD }}
+
+      - name: Smoke test
+        run: ./bin/pf smoke
