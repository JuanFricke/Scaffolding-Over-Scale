@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Http\Controllers\Auth;
+
+use App\Http\Controllers\Controller;
+use Illuminate\Foundation\Auth\EmailVerificationRequest;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\View\View;
+
+class VerifyEmailController extends Controller
+{
+    public function show(Request $request): View|RedirectResponse
+    {
+        return $request->user()->hasVerifiedEmail()
+            ? redirect()->route('home')
+            : view('auth.verify-email');
+    }
+
+    /**
+     * EmailVerificationRequest authorizes the signed link against the logged-in
+     * user, so a tampered id or hash is rejected before anything is marked verified.
+     */
+    public function verify(EmailVerificationRequest $request): RedirectResponse
+    {
+        $request->fulfill();
+
+        return redirect()->route('home')->with('status', __('ui.email_verified_success'));
+    }
+
+    public function resend(Request $request): RedirectResponse
+    {
+        if ($request->user()->hasVerifiedEmail()) {
+            return redirect()->route('home');
+        }
+
+        $request->user()->sendEmailVerificationNotification();
+
+        return back()->with('status', __('ui.verification_link_resent'));
+    }
+}
