diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..b2343aa
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,144 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+class DiscordOpsAlert
+{
+    public function send(string $title, string $message, array $context = []): void
+    {
+        try {
+            $webhookUrl = config('services.discord.webhook_url');
+
+            if (! is_string($webhookUrl) || trim($webhookUrl) === '') {
+                return;
+            }
+
+            $lines = [$title, $message];
+
+            foreach ($context as $key => $value) {
+                $lines[] = ((string) $key).'='.$this->renderValue($key, $value);
+            }
+
+            $content = implode("\n", $lines);
+
+            if (mb_strlen($content, 'UTF-8') > 1800) {
+                $content = mb_substr($content, 0, 1800, 'UTF-8');
+            }
+
+            try {
+                $response = Http::timeout(5)->post($webhookUrl, [
+                    'content' => $content,
+                ]);
+
+                if (! $response->successful()) {
+                    Log::error('Discord ops alert failed', [
+                        'status' => $response->status(),
+                    ]);
+                }
+            } catch (\Throwable $e) {
+                Log::error('Discord ops alert failed', [
+                    'error' => $this->scrub($e->getMessage(), $webhookUrl),
+                ]);
+            }
+        } catch (\Throwable) {
+            try {
+                Log::error('Discord ops alert failed');
+            } catch (\Throwable) {
+                // Never break the caller.
+            }
+        }
+    }
+
+    private function renderValue(mixed $key, mixed $value): string
+    {
+        if ($this->isSensitiveKey((string) $key)) {
+            return '[redacted]';
+        }
+
+        $redacted = $this->redactValue($value);
+
+        if (is_array($redacted)) {
+            $encoded = json_encode($redacted, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+
+            return $encoded === false ? '[unserializable]' : $encoded;
+        }
+
+        if (is_bool($redacted)) {
+            return $redacted ? 'true' : 'false';
+        }
+
+        if (is_null($redacted)) {
+            return 'null';
+        }
+
+        if (is_scalar($redacted)) {
+            return (string) $redacted;
+        }
+
+        if (is_object($redacted) && method_exists($redacted, '__toString')) {
+            return (string) $redacted;
+        }
+
+        $encoded = json_encode($redacted, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+
+        return $encoded === false ? '[unserializable]' : $encoded;
+    }
+
+    private function redactValue(mixed $value): mixed
+    {
+        if (is_string($value)) {
+            if (preg_match('/\bBearer\s+\S+/i', $value) === 1) {
+                return '[redacted]';
+            }
+
+            return $value;
+        }
+
+        if (is_array($value)) {
+            $result = [];
+
+            foreach ($value as $nestedKey => $nestedValue) {
+                if ($this->isSensitiveKey((string) $nestedKey)) {
+                    $result[$nestedKey] = '[redacted]';
+                } else {
+                    $result[$nestedKey] = $this->redactValue($nestedValue);
+                }
+            }
+
+            return $result;
+        }
+
+        return $value;
+    }
+
+    private function isSensitiveKey(string $key): bool
+    {
+        $lower = strtolower($key);
+
+        foreach (['password', 'token', 'secret', 'authorization', 'webhook'] as $needle) {
+            if (str_contains($lower, $needle)) {
+                return true;
+            }
+        }
+
+        $normalized = str_replace(['-', '_', ' '], '', $lower);
+
+        if (str_contains($normalized, 'apikey')) {
+            return true;
+        }
+
+        return false;
+    }
+
+    private function scrub(string $text, string $webhookUrl): string
+    {
+        if ($webhookUrl !== '') {
+            $text = str_replace($webhookUrl, '[redacted]', $text);
+        }
+
+        return $text;
+    }
+}
