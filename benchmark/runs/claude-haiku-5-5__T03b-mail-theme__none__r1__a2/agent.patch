+test('the reset password mail is rendered in portuguese with the pegafila theme', function () {
+    $user = User::factory()->make(['email' => 'ana@example.com']);
+
+    $message = (new ResetPassword('token-123'))->toMail($user);
+    $html = $message->render()->toHtml();
+
+    expect($message->subject)->toBe('Redefina sua senha')
+        ->and($message->actionText)->toBe('Redefinir senha')
+        ->and($html)->toContain('PegaFila')
+        ->toContain('Olá!')
+        ->toContain('Você recebeu esse e-mail')
+        ->toContain('Se você estiver tendo problemas para clicar no botão')
+        ->toContain('Todos os direitos reservados.')
+        ->toContain('background-color: #0f7490')
+        ->toContain('/reset-password/token-123')
+        ->not->toContain('having trouble clicking')
+        ->not->toContain('You are receiving this email');
+});
+
+test('the verification mail is rendered in portuguese with the pegafila theme', function () {
+    $user = User::factory()->unverified()->make(['id' => 7, 'email' => 'ana@example.com']);
+
+    $message = (new VerifyEmail)->toMail($user);
+    $html = $message->render()->toHtml();
+
+    expect($message->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($message->actionText)->toBe('Verifique o endereço de e-mail')
+        ->and($html)->toContain('Olá!')
+        ->toContain('Verifique o endereço de e-mail')
