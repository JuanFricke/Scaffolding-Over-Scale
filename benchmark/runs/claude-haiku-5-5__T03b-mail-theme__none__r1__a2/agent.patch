diff --git a/tests/Feature/EmailVerificationTest.php b/tests/Feature/EmailVerificationTest.php
new file mode 100644
index 0000000..19f6aee
--- /dev/null
+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,72 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user, ?string $hash = null): string
+{
+    return URL::temporarySignedRoute(
+        'verification.verify',
+        now()->addMinutes(60),
+        ['id' => $user->getKey(), 'hash' => $hash ?? sha1($user->getEmailForVerification())],
+    );
+}
+
+test('the logged-in user verifies their e-mail and is redirected to the welcome page', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('verifying an already verified e-mail is harmless', function () {
+    $user = User::factory()->create();
+    $verifiedAt = $user->email_verified_at;
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->refresh()->email_verified_at->equalTo($verifiedAt))->toBeTrue();
+});
+
+test('a hash that does not match the user e-mail is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user, sha1('outro@example.com')))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an id that belongs to another user is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(URL::temporarySignedRoute(
+            'verification.verify',
+            now()->addMinutes(60),
+            ['id' => $other->getKey(), 'hash' => sha1($other->getEmailForVerification())],
+        ))
+        ->assertForbidden();
+
+    expect($other->refresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned verification link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+
+    expect($user->refresh()->hasVerifiedEmail())->toBeFalse();
+});
diff --git a/tests/Feature/PasswordResetTest.php b/tests/Feature/PasswordResetTest.php
new file mode 100644
index 0000000..19315e9
--- /dev/null
+++ b/tests/Feature/PasswordResetTest.php
@@ -0,0 +1,168 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+const RESET_LINK_SENT = 'Enviamos um link para redefinição de senha para o seu e-mail.';
+
+test('guests can open the forgot password form', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee(route('password.email'), false)
+        ->assertSee('Enviar link de redefinição de senha');
+});
+
+test('authenticated users are not shown the forgot password form', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('password.request'))
+        ->assertRedirect('/');
+});
+
+test('a reset link is sent to an existing user and the response is flashed', function () {
+    Notification::fake();
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    $this->from('/forgot-password')
+        ->post(route('password.email'), ['email' => 'ana@example.com'])
+        ->assertRedirect('/forgot-password')
+        ->assertSessionHas('status', RESET_LINK_SENT);
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown address gets the same response and no mail', function () {
+    Notification::fake();
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    $this->from('/forgot-password')
+        ->post(route('password.email'), ['email' => 'ninguem@example.com'])
+        ->assertRedirect('/forgot-password')
+        ->assertSessionHas('status', RESET_LINK_SENT)
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('the forgot password form validates the e-mail', function () {
+    Notification::fake();
+
+    $this->from('/forgot-password')
+        ->post(route('password.email'), ['email' => 'nao-e-um-email'])
+        ->assertRedirect('/forgot-password')
+        ->assertSessionHasErrors('email');
+
+    Notification::assertNothingSent();
+});
+
+test('the forgot password form is throttled to six requests per minute', function () {
+    Notification::fake();
+
+    for ($i = 0; $i < 6; $i++) {
+        $this->post(route('password.email'), ['email' => 'ana@example.com']);
+    }
+
+    $this->post(route('password.email'), ['email' => 'ana@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset form shows the token and e-mail from the link', function () {
+    $this->get('/reset-password/abc123?email=ana@example.com')
+        ->assertOk()
+        ->assertSee('name="token" value="abc123"', false)
+        ->assertSee('value="ana@example.com"', false)
+        ->assertSee(route('password.update'), false);
+});
+
+test('a valid token sets the new password and redirects to the welcome page', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'antigo']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ])
+        ->assertRedirect('/')
+        ->assertSessionHas('status', 'Sua senha foi redefinida.');
+
+    $user->refresh();
+
+    expect(Hash::check('NovaSenha123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('antigo');
+
+    Event::assertDispatched(PasswordReset::class, fn (PasswordReset $event) => $event->user->is($user));
+});
+
+test('a token can only be used once', function () {
+    $user = User::factory()->create();
+    $token = Password::createToken($user);
+    $payload = [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ];
+
+    $this->post(route('password.update'), $payload)->assertRedirect('/');
+
+    $this->from(route('password.reset', $token))
+        ->post(route('password.update'), $payload)
+        ->assertSessionHasErrors('email');
+});
+
+test('an invalid token is rejected and the password is kept', function () {
+    $user = User::factory()->create();
+
+    $this->from(route('password.reset', 'errado'))
+        ->post(route('password.update'), [
+            'token' => 'errado',
+            'email' => $user->email,
+            'password' => 'NovaSenha123',
+            'password_confirmation' => 'NovaSenha123',
+        ])
+        ->assertRedirect(route('password.reset', 'errado'))
+        ->assertSessionHasErrors(['email' => 'O token de redefinição de senha é inválido.']);
+
+    expect(Hash::check('password', $user->refresh()->password))->toBeTrue();
+});
+
+test('the new password must be at least eight characters with letters, mixed case and numbers', function (string $password) {
+    $user = User::factory()->create();
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => $password,
+        'password_confirmation' => $password,
+    ])->assertSessionHasErrors('password');
+
+    expect(Hash::check('password', $user->refresh()->password))->toBeTrue();
+})->with([
+    'curta demais' => ['Abc1234'],
+    'sem números' => ['SenhaSemNumero'],
+    'sem letras' => ['12345678901'],
+    'sem maiúsculas' => ['senhasemmaiuscula1'],
+]);
+
+test('the new password must be confirmed', function () {
+    $user = User::factory()->create();
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'OutraSenha123',
+    ])->assertSessionHasErrors('password');
+});
