diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..c902873
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,107 @@
+<?php
+
+namespace App\\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+class DiscordOpsAlert
+{
+    /**
+     * Send an ops alert to a Discord webhook.
+     *
+     * @param string $title
+     * @param string $message
+     * @param array $context
+     * @return void
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+        if (empty($url)) {
+            return;
+        }
+
+        try {
+            $payload = $this->buildPayload($title, $message, $context);
+            $response = Http::timeout(5)->post($url, ['content' => $payload]);
+
+            if ($response->failed()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (\Throwable $e) {
+            // Scrub the URL from the exception message
+            $message = preg_replace('/' . preg_quote($url, '/') . '/i', '', $e->getMessage());
+            Log::error('Discord ops alert error', ['message' => $message]);
+        }
+    }
+
+    /**
+     * Build the content payload for Discord.
+     */
+    private function buildPayload(string $title, string $message, array $context): string
+    {
+        $lines = [];
+        $lines[] = $title;
+        $lines[] = $message;
+
+        foreach ($context as $key => $value) {
+            $redacted = $this->redact($key, $value);
+            if (is_array($redacted)) {
+                $lines[] = $key . '=' . json_encode($redacted, JSON_UNESCAPED_UNICODE);
+            } else {
+                $lines[] = $key . '=' . (string) $redacted;
+            }
+        }
+
+        $content = implode("\n", $lines);
+
+        // Truncate to 1800 characters multibyte safe
+        if (mb_strlen($content, 'UTF-8') > 1800) {
+            $content = mb_substr($content, 0, 1800, 'UTF-8');
+        }
+
+        return $content;
+    }
+
+    /**
+     * Redact sensitive data based on key and value.
+     */
+    private function redact(string $key, $value)
+    {
+        $sensitiveKeys = [
+            'password',
+            'token',
+            'secret',
+            'authorization',
+            'api_key',
+            'api-key',
+            'apikey',
+            'webhook',
+        ];
+
+        foreach ($sensitiveKeys as $sKey) {
+            if (stripos($key, $sKey) !== false) {
+                return '[redacted]';
+            }
+        }
+
+        if (is_string($value)) {
+            // Redact bearer tokens
+            if (preg_match('/Bearer\s+\S+/i', $value)) {
+                return '[redacted]';
+            }
+            return $value;
+        }
+
+        if (is_array($value)) {
+            $redactedArray = [];
+            foreach ($value as $k => $v) {
+                $redactedArray[$k] = $this->redact((string)$k, $v);
+            }
+            return $redactedArray;
+        }
+
+        return $value;
+    }
+}
