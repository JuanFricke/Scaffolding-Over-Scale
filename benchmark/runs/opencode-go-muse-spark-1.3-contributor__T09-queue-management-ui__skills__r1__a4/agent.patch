+<?php
+
+use App\Livewire\Entity\Queues;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
+
+uses(RefreshDatabase::class);
+
+function queuesOwner(Entity $entity, ?User $user = null): User
+{
+    $user ??= User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+test('employee cannot open the queues page', function () {
+    $owner = User::factory()->create();
+    $employee = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Queues::class, ['entity' => $entity])->assertForbidden();
+
+    $this->get(route('entity.queues', $entity->slug))->assertForbidden();
+});
+
+test('queues list renders one row button per queue and no other row actions', function () {
+    $owner = queuesOwner($entity = Entity::factory()->create());
+    $a = Queue::factory()->for($entity)->create(['name' => 'Alpha']);
+    $b = Queue::factory()->for($entity)->create(['name' => 'Beta', 'is_active' => false]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $html = Livewire::test(Queues::class, ['entity' => $entity])->html();
+
+    expect($html)->toContain('wire:click="openQueue('.$a->id.')"')
+        ->and($html)->toContain('wire:click="openQueue('.$b->id.')"')
+        ->and($html)->toContain('class="button is-fullwidth p-3 mb-2"')
+        ->and($html)->toContain('Alpha')
+        ->and($html)->toContain('Beta')
+        ->and($html)->not->toContain('startRename')
+        ->and($html)->not->toContain('toggleActive')
+        ->and($html)->not->toContain('openAccess');
+});
+
+test('create queue resets state and duplicate slug errors on name', function () {
+    $owner = queuesOwner($entity = Entity::factory()->create());
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openCreate')
+        ->assertSet('creating', true)
+        ->set('name', 'Atendimento Geral')
+        ->call('create')
+        ->assertHasNoErrors()
+        ->assertSet('creating', false)
+        ->assertSet('name', '');
+
+    expect(Queue::where('entity_id', $entity->id)->where('slug', 'atendimento-geral')->exists())->toBeTrue();
+
+    // Duplicate derived slug surfaces on `name`.
