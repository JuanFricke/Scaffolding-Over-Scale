+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Enums\QueuePermission;
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function serveOwner(Entity $entity, ?User $user = null): User
+{
+    $user ??= User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+test('non-member cannot open the serve panel', function () {
+    $owner = serveOwner($entity = Entity::factory()->create());
+    $outsider = User::factory()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $this->actingAs($outsider)->get(route('entity.serve', $entity->slug))->assertForbidden();
+});
+
+test('serve defaults to the first callable queue', function () {
+    $owner = serveOwner($entity = Entity::factory()->create());
+    $a = Queue::factory()->for($entity)->create();
+    $b = Queue::factory()->for($entity)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $a->id)
+        ->assertSet('mode', 'any');
+
+    expect($b->id)->toBeGreaterThan($a->id);
+});
+
+test('employee only sees queues with a call grant', function () {
+    $manager = serveOwner($entity = Entity::factory()->create());
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $granted = Queue::factory()->for($entity)->create();
+    $denied = Queue::factory()->for($entity)->create();
+    (new SetQueueAccess)($membership, $granted, $manager, [QueuePermission::Call]);
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $granted->id);
+
+    expect($component->html())->toContain($granted->name)
+        ->and($component->html())->not->toContain($denied->name);
+});
+
+test('waiting list is ordered, filtered by mode and translated', function () {
+    $owner = serveOwner($entity = Entity::factory()->create());
+    $queue = Queue::factory()->for($entity)->create();
+    $normal = Ticket::factory()->forQueue($queue)->create(['code' => 'A001', 'priority' => 0, 'channel' => 'totem', 'issued_at' => now()->subMinutes(5)]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['code' => 'A002', 'priority' => 5, 'channel' => 'virtual', 'issued_at' => now()]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $html = Livewire::test(Serve::class, ['entity' => $entity])->html();
+
+    expect($html)->toContain('A001')
+        ->and($html)->toContain('A002')
+        ->and($html)->toContain(__('ui.channel_totem'))
+        ->and($html)->toContain(__('ui.channel_virtual'));
+
+    // Priority first regardless of issue time.
+    expect(strpos($html, 'A002'))->toBeLessThan(strpos($html, 'A001'));
+
+    $filtered = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('mode', 'normal_only')
+        ->html();
+
+    expect($filtered)->toContain('A001')->and($filtered)->not->toContain('A002');
+
+    expect($normal->fresh()->code)->toBe('A001')
+        ->and($priority->fresh()->code)->toBe('A002');
+});
+
+test('foreign queue selection shows no tickets, only the empty text', function () {
+    $owner = serveOwner($entity = Entity::factory()->create());
