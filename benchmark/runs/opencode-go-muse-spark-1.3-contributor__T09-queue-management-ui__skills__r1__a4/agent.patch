+
+test('callNext on empty and inactive queues sets notices', function () {
+    $owner = serveOwner($entity = Entity::factory()->create());
+    $empty = Queue::factory()->for($entity)->create();
+    $inactive = Queue::factory()->for($entity)->create(['is_active' => false]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $empty->id)
+        ->call('callNext')
