+
+test('serve button carries label and lastCalledTicketId is locked', function () {
+    $owner = serveOwner($entity = Entity::factory()->create());
+    Queue::factory()->for($entity)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
