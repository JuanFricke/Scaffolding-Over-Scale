+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $inactive->id)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_inactive'));
+});
+
+test('callNext without grant is forbidden and changes nothing', function () {
+    $manager = serveOwner($entity = Entity::factory()->create());
