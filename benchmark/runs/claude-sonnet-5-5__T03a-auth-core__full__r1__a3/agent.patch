diff --git a/tests/Feature/Auth/LoginTest.php b/tests/Feature/Auth/LoginTest.php
new file mode 100644
index 0000000..83636dc
--- /dev/null
+++ b/tests/Feature/Auth/LoginTest.php
@@ -0,0 +1,153 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Auth\Events\Lockout;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Cookie;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function loginKey(string $email): string
+{
+    return str()->transliterate(str($email)->lower().'|127.0.0.1');
+}
+
+test('login page renders for guests with translated text', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeLivewire(Login::class)
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('authenticated users are redirected from login to home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('a user can log in and the session id is regenerated', function () {
+    $user = User::factory()->create();
+    $this->get(route('login'));
+    $before = session()->getId();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+    expect(session()->getId())->not->toBe($before);
+});
+
+test('login redirects to the intended url', function () {
+    $user = User::factory()->create();
+    session(['url.intended' => route('password.request')]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('password.request'));
+});
+
+test('remember me sets the recaller cookie', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect(auth()->viaRemember())->toBeFalse();
+    expect(Cookie::hasQueued(auth()->guard()->getRecallerName()))->toBeTrue();
+});
+
+test('wrong credentials add the failed message to email and clear the password', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee(__('auth.failed'))
+        ->assertSet('password', '');
+
+    $this->assertGuest();
+    expect(__('auth.failed'))->toStartWith('Essas credenciais não correspondem');
+});
+
+test('email is validated strictly', function (string $email) {
+    Livewire::test(Login::class)
+        ->set('email', $email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email']);
+})->with(['', 'not-an-email', 'a@b', 'a b@example.com', 'user@@example.com']);
+
+test('password is required', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'user@example.com')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'required']);
+});
+
+test('failed attempts are throttled per lowercase email and ip', function () {
+    Event::fake([Lockout::class]);
+    $user = User::factory()->create();
+
+    foreach (range(1, 5) as $i) {
+        Livewire::test(Login::class)
+            ->set('email', strtoupper($user->email))
+            ->set('password', 'wrong-password')
+            ->call('submit')
+            ->assertHasErrors(['email']);
+    }
+
+    expect(RateLimiter::attempts(loginKey($user->email)))->toBe(5);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee('Muitas tentativas de login');
+
+    $this->assertGuest();
+    Event::assertDispatched(Lockout::class);
+});
+
+test('throttling is per email: other emails are unaffected', function () {
+    $user = User::factory()->create();
+    foreach (range(1, 5) as $i) {
+        RateLimiter::hit(loginKey('someone-else@example.com'));
+    }
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+});
+
+test('a successful login clears the failed attempts', function () {
+    $user = User::factory()->create();
+    RateLimiter::hit(loginKey($user->email));
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit');
+
+    expect(RateLimiter::attempts(loginKey($user->email)))->toBe(0);
+});
