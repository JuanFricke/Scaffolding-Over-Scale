+test('logout invalidates the session, regenerates the csrf token and redirects to login', function () {
+    $user = User::factory()->create();
+    $this->actingAs($user)->withSession(['foo' => 'bar']);
+    $token = csrf_token();
+    $sessionId = session()->getId();
+
+    $this->post(route('logout'))->assertRedirect(route('login'));
+
+    $this->assertGuest();
+    expect(session()->has('foo'))->toBeFalse();
+    expect(session()->token())->not->toBe($token);
+    expect(session()->getId())->not->toBe($sessionId);
+});
+
+test('logout requires authentication', function () {
+    $this->post(route('logout'))->assertRedirect(route('login'));
+});
+
+test('logout is POST only', function () {
+    $this->actingAs(User::factory()->create())
+        ->get('/logout')
+        ->assertStatus(405);
+});
+
+test('the layout offers a csrf-protected logout form to logged-in users', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('home'))
+        ->assertOk()
+        ->assertSee('action="'.route('logout').'"', false)
+        ->assertSee('name="_token"', false)
+        ->assertSee('Sair');
+});
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..f42e021
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,132 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('forgot password page renders', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('action="'.route('password.email').'"', false);
+});
+
+test('a reset link is sent to an existing user', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('the answer is identical for unknown emails and nothing is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('the answer does not change when the broker throttles', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email]);
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentToTimes($user, ResetPassword::class, 1);
+});
+
+test('forgot password requires a valid email', function () {
+    $this->post(route('password.email'), ['email' => 'nope'])->assertSessionHasErrors('email');
+});
+
+test('forgot password is throttled at 6 requests per minute', function () {
+    foreach (range(1, 6) as $i) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertStatus(429);
+});
+
+test('reset page asks for the email exactly once and carries the token', function () {
+    $html = $this->get(route('password.reset', ['token' => 'abc123', 'email' => 'maria@example.com']))
+        ->assertOk()
+        ->assertSee('value="abc123"', false)
+        ->assertSee('value="maria@example.com"', false)
+        ->content();
+
+    expect(substr_count($html, 'name="email"'))->toBe(1);
+    expect(substr_count(file_get_contents(resource_path('views/auth/reset-password.blade.php')), 'name="email"'))->toBe(1);
+});
+
+test('a valid token resets the password, rotates the remember token and fires PasswordReset', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old-token']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NewSecret123', $user->password))->toBeTrue();
+    expect($user->remember_token)->not->toBe('old-token')->and($user->remember_token)->toHaveLength(60);
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token is rejected and the password is unchanged', function () {
+    $user = User::factory()->create();
+    $hash = $user->password;
+
+    $this->post(route('password.update'), [
+        'token' => 'wrong',
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect($user->refresh()->password)->toBe($hash);
+});
+
+test('an unknown email gets the same error as a bad token', function () {
+    $this->post(route('password.update'), [
+        'token' => 'wrong',
+        'email' => 'nobody@example.com',
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+});
+
+test('the reset password must satisfy the default rule and be confirmed', function (string $password, string $confirmation) {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => Password::createToken($user),
+        'email' => $user->email,
+        'password' => $password,
+        'password_confirmation' => $confirmation,
+    ])->assertSessionHasErrors('password');
+
+    expect(Hash::check('password', $user->refresh()->password))->toBeTrue();
+})->with([
+    'too short' => ['Ab1', 'Ab1'],
+    'no uppercase' => ['alllowercase1', 'alllowercase1'],
+    'no number' => ['NoNumbersHere', 'NoNumbersHere'],
+    'mismatch' => ['NewSecret123', 'Other12345'],
+]);
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..c2cb2d9
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,148 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function registerKey(): string
+{
+    return str()->transliterate('register|127.0.0.1');
+}
+
+function fillRegister($component, array $overrides = [])
+{
+    $data = array_merge([
+        'name' => 'Maria Silva',
+        'email' => 'maria@example.com',
+        'password' => 'Secret123',
+        'password_confirmation' => 'Secret123',
+    ], $overrides);
+
+    foreach ($data as $field => $value) {
+        $component->set($field, $value);
+    }
+
+    return $component;
+}
+
+test('register page renders for guests', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSeeLivewire(Register::class);
+});
+
+test('authenticated users are redirected from register to home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
+
+test('registering creates an unverified hashed user, sends the verification mail, logs in and regenerates the session', function () {
+    Notification::fake();
+    $this->get(route('register'));
+    $before = session()->getId();
+
+    fillRegister(Livewire::test(Register::class))
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'maria@example.com')->firstOrFail();
+    expect($user->name)->toBe('Maria Silva');
+    expect($user->email_verified_at)->toBeNull();
+    expect(Hash::check('Secret123', $user->password))->toBeTrue();
+    $this->assertAuthenticatedAs($user);
+    expect(session()->getId())->not->toBe($before);
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('Registered event is fired', function () {
+    Event::fake([Registered::class]);
+
+    fillRegister(Livewire::test(Register::class))->call('submit');
+
+    Event::assertDispatched(Registered::class);
+});
+
+test('the e-mail is stored lowercase so case variants cannot duplicate an account', function () {
+    User::factory()->create(['email' => 'maria@example.com']);
+
+    fillRegister(Livewire::test(Register::class), ['email' => 'MARIA@example.com'])
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+
+    expect(User::count())->toBe(1);
+});
+
+test('mismatched password confirmation fails with the confirmed rule', function () {
+    fillRegister(Livewire::test(Register::class), ['password_confirmation' => 'Different123'])
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed'])
+        ->assertSet('password', '')
+        ->assertSet('password_confirmation', '');
+
+    expect(User::count())->toBe(0);
+});
+
+test('weak passwords are rejected by the app-wide default rule', function (string $password) {
+    fillRegister(Livewire::test(Register::class), ['password' => $password, 'password_confirmation' => $password])
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    expect(User::count())->toBe(0);
+})->with(['short1A', 'alllowercase1', 'ALLUPPERCASE1', 'NoNumbersHere', '12345678']);
+
+test('name, email format and uniqueness are validated', function () {
+    User::factory()->create(['email' => 'taken@example.com']);
+
+    fillRegister(Livewire::test(Register::class), ['name' => '', 'email' => 'taken@example.com'])
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required', 'email' => 'unique']);
+
+    fillRegister(Livewire::test(Register::class), ['email' => 'not-an-email'])
+        ->call('submit')
+        ->assertHasErrors(['email']);
+});
+
+test('validation messages use the pt_BR attribute names', function () {
+    fillRegister(Livewire::test(Register::class), ['password_confirmation' => 'x'])
+        ->call('submit')
+        ->assertSee('A confirmação do campo senha não corresponde.');
+});
+
+test('registration is rate limited by ip and reports on email', function () {
+    foreach (range(1, 5) as $i) {
+        RateLimiter::hit(registerKey());
+    }
+
+    fillRegister(Livewire::test(Register::class))
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee('Muitos cadastros');
+
+    expect(User::count())->toBe(0);
+    $this->assertGuest();
+});
+
+test('invalid submissions count towards the rate limit', function () {
+    foreach (range(1, 5) as $i) {
+        fillRegister(Livewire::test(Register::class), ['name' => ''])->call('submit');
+    }
+
+    expect(RateLimiter::tooManyAttempts(registerKey(), 5))->toBeTrue();
+
+    fillRegister(Livewire::test(Register::class))
+        ->call('submit')
+        ->assertHasErrors(['email']);
+
+    expect(User::count())->toBe(0);
+});
diff --git a/tests/Feature/LocalizationTest.php b/tests/Feature/LocalizationTest.php
new file mode 100644
index 0000000..94accb0
--- /dev/null
+++ b/tests/Feature/LocalizationTest.php
@@ -0,0 +1,65 @@
+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Arr;
+
+uses(RefreshDatabase::class);
+
+test('the test suite runs in pt_BR with en as fallback', function () {
+    expect(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('.env.example ships the localization defaults', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)->toContain("APP_NAME=PegaFila\n")
+        ->toContain("APP_LOCALE=pt_BR\n")
+        ->toContain("APP_FALLBACK_LOCALE=en\n");
+});
+
+test('the login page is in Portuguese under pt_BR', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?')
+        ->assertSee('<html lang="pt-BR">', false);
+});
+
+test('the login page is in English under en, without Portuguese', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertSee('Forgot your password?')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu')
+        ->assertSee('<html lang="en">', false);
+});
+
+test('ui.php has the same keys in both locales', function () {
+    $flatten = fn (array $lines) => array_keys(Arr::dot($lines));
+
+    $en = $flatten(require lang_path('en/ui.php'));
+    $pt = $flatten(require lang_path('pt_BR/ui.php'));
+
+    expect($pt)->toEqualCanonicalizing($en);
+});
+
+test('every translation key used by the views and classes exists', function () {
+    $files = array_merge(
+        glob(resource_path('views/{,*/,*/*/}*.blade.php'), GLOB_BRACE),
+        glob(app_path('{,*/,*/*/}*.php'), GLOB_BRACE),
+    );
+
+    foreach ($files as $file) {
+        preg_match_all("/__\('(ui\.[a-z_.]+)'/", file_get_contents($file), $m);
+        foreach ($m[1] as $key) {
+            expect(trans($key, [], 'pt_BR'))->not->toBe($key, "$key missing in pt_BR ($file)");
+            expect(trans($key, [], 'en'))->not->toBe($key, "$key missing in en ($file)");
+        }
+    }
+});
diff --git a/tests/Feature/ViewConventionsTest.php b/tests/Feature/ViewConventionsTest.php
new file mode 100644
index 0000000..e1f7287
--- /dev/null
+++ b/tests/Feature/ViewConventionsTest.php
@@ -0,0 +1,32 @@
+<?php
+
+use Illuminate\Support\Facades\File;
+
+test('views link with route() and never hardcode local paths', function () {
+    foreach (File::allFiles(resource_path('views')) as $file) {
+        expect(file_get_contents($file->getPathname()))
+            ->not->toMatch('/(?:href|action)\s*=\s*["\']\//', $file->getRelativePathname());
+    }
+});
+
+test('auth controllers and livewire classes redirect with named routes', function () {
+    $files = array_merge(
+        glob(app_path('Http/Controllers/*.php')),
+        glob(app_path('Http/Controllers/Auth/*.php')),
+        glob(app_path('Livewire/Auth/*.php')),
+    );
+
+    foreach ($files as $file) {
+        expect(file_get_contents($file))
+            ->not->toMatch('/redirect\(\s*[\'"]\//', basename($file))
+            ->not->toMatch('/redirect(?:Intended)?\([^)]*[\'"]\/[\'"]/', basename($file));
+    }
+});
+
+test('livewire inputs bind with plain wire:model', function () {
+    foreach (glob(resource_path('views/livewire/auth/*.blade.php')) as $file) {
+        expect(file_get_contents($file))
+            ->toContain('wire:model="')
+            ->not->toMatch('/wire:model\.(live|lazy|defer|blur)/');
+    }
+});
