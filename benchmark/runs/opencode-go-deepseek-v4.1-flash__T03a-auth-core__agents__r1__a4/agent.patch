diff --git a/tests/Feature/Auth/LoginTest.php b/tests/Feature/Auth/LoginTest.php
new file mode 100644
index 0000000..2c07809
--- /dev/null
+++ b/tests/Feature/Auth/LoginTest.php
@@ -0,0 +1,100 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    RateLimiter::clear(pfAuthLoginThrottleKey('test@example.com'));
+});
+
+function pfAuthLoginThrottleKey(string $email): string
+{
+    return str()->transliterate(str()->lower($email).'|127.0.0.1');
+}
+
+test('guests can see the login page in Brazilian Portuguese', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('users can log in with valid credentials', function () {
+    $user = User::factory()->create([
+        'email' => 'test@example.com',
+        'password' => 'Password123',
+    ]);
+
+    Livewire::test(Login::class)
+        ->set('email', 'test@example.com')
+        ->set('password', 'Password123')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('invalid credentials fail on email with the auth failed message', function () {
+    User::factory()->create([
+        'email' => 'test@example.com',
+        'password' => 'Password123',
+    ]);
+
+    Livewire::test(Login::class)
+        ->set('email', 'test@example.com')
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')])
+        ->assertNoRedirect();
+
+    $this->assertGuest();
+});
+
+test('invalid email format is rejected before attempting authentication', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'Password123')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email'])
+        ->assertNoRedirect();
+});
+
+test('login is throttled after five failed attempts', function () {
+    User::factory()->create([
+        'email' => 'test@example.com',
+        'password' => 'Password123',
+    ]);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        Livewire::test(Login::class)
+            ->set('email', 'test@example.com')
+            ->set('password', 'wrong-password')
+            ->call('submit')
+            ->assertHasErrors('email');
+    }
+
+    $component = Livewire::test(Login::class)
+        ->set('email', 'test@example.com')
+        ->set('password', 'Password123')
+        ->call('submit')
+        ->assertHasErrors('email')
+        ->assertNoRedirect();
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas');
+});
+
+test('authenticated users are redirected from login to home', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
