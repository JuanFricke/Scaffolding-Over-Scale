diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..d21ad76
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,150 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Str;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the forgot password page', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('Esqueceu a senha?')
+        ->assertSee('Enviar link de redefinição');
+});
+
+test('a reset link is sent to an existing user', function () {
+    Notification::fake();
+
+    $user = User::factory()->create(['email' => 'maria@example.com']);
+
+    $this->from(route('password.request'))
+        ->post(route('password.email'), ['email' => 'maria@example.com'])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('the same status is returned for a non-existent email', function () {
+    Notification::fake();
+
+    $this->from(route('password.request'))
+        ->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('forgot password validates the email field', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+});
+
+test('forgot password is throttled at six requests per minute', function () {
+    for ($request = 0; $request < 6; $request++) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+            ->assertStatus(302);
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertStatus(429);
+});
+
+test('guests can see the reset password form with a single email input', function () {
+    $response = $this->get(route('password.reset', [
+        'token' => 'plain-token',
+        'email' => 'maria@example.com',
+    ]));
+
+    $response->assertOk()
+        ->assertSee('maria@example.com')
+        ->assertSee('Redefinir senha');
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('users can reset their password with a valid token', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create([
+        'email' => 'maria@example.com',
+        'password' => 'OldPassword123',
+        'remember_token' => 'old-remember-token',
+    ]);
+
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => 'maria@example.com',
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'NewPassword123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewPassword123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-remember-token');
+
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid reset token fails on email', function () {
+    $user = User::factory()->create([
+        'email' => 'maria@example.com',
+        'password' => 'OldPassword123',
+    ]);
+
+    $this->post(route('password.update'), [
+        'token' => Str::random(64),
+        'email' => 'maria@example.com',
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'NewPassword123',
+    ])
+        ->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect(Hash::check('OldPassword123', $user->fresh()->password))->toBeTrue();
+});
+
+test('password reset applies the default password policy', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create(['email' => 'maria@example.com']);
+    $token = Password::createToken($user);
+
+    $response = $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => 'maria@example.com',
+        'password' => 'short',
+        'password_confirmation' => 'short',
+    ])->assertSessionHasErrors('password');
+
+    expect($response->getSession()->get('errors')->first('password'))
+        ->toContain('pelo menos 8 caracteres');
+
+    Event::assertNotDispatched(PasswordReset::class);
+});
+
+test('password reset requires a matching confirmation', function () {
+    $user = User::factory()->create(['email' => 'maria@example.com']);
+    $token = Password::createToken($user);
+
+    $response = $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => 'maria@example.com',
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'Different123',
+    ])->assertSessionHasErrors('password');
+
+    expect($response->getSession()->get('errors')->first('password'))
+        ->toContain('confirmação');
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..9fbeea0
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,141 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    RateLimiter::clear(pfAuthRegisterThrottleKey());
+});
+
+function pfAuthRegisterThrottleKey(): string
+{
+    return str()->transliterate('register|127.0.0.1');
+}
+
+test('guests can see the registration page', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSee('Criar conta')
+        ->assertSee('Confirmar senha');
+});
+
+test('users can register and are logged in unverified', function () {
+    Event::fake([Registered::class]);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'maria@example.com')->firstOrFail();
+
+    expect($user->name)->toBe('Maria Silva')
+        ->and($user->hasVerifiedEmail())->toBeFalse()
+        ->and(Hash::check('Password123', $user->password))->toBeTrue();
+
+    $this->assertAuthenticatedAs($user);
+    Event::assertDispatched(Registered::class);
+});
+
+test('registration sends the verification notification', function () {
+    Notification::fake();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    Notification::assertSentTo(
+        User::where('email', 'maria@example.com')->firstOrFail(),
+        VerifyEmail::class,
+    );
+});
+
+test('registration requires a unique email', function () {
+    User::factory()->create(['email' => 'maria@example.com']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+});
+
+test('registration rejects invalid email addresses', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'not-an-email')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+});
+
+test('registration applies the default password policy', function () {
+    $component = Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'short')
+        ->set('password_confirmation', 'short')
+        ->call('submit')
+        ->assertHasErrors('password');
+
+    $messages = implode(' ', $component->errors()->get('password'));
+
+    expect($messages)->toContain('pelo menos 8 caracteres')
+        ->and($messages)->toContain('letra maiúscula');
+});
+
+test('registration rejects a mismatched password confirmation', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Different123')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+});
+
+test('registration is rate limited by IP after five attempts', function () {
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        RateLimiter::hit(pfAuthRegisterThrottleKey(), 60);
+    }
+
+    $component = Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasErrors('email')
+        ->assertNoRedirect();
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas')
+        ->and(User::where('email', 'maria@example.com')->exists())->toBeFalse();
+});
+
+test('authenticated users are redirected from register to home', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
