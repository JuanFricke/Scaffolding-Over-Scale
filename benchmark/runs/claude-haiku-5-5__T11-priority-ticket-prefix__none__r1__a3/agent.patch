+     * @return array<int, string>|null
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function normalizePriorityPrefixMap(?array $map): ?array
+    {
+        if ($map === null || $map === []) {
+            return null;
+        }
+
+        foreach ($map as $priority => $letter) {
+            $key = (string) $priority;
+
+            if (! preg_match('/\A(0|[1-9]\d*)\z/', $key) || filter_var($key, FILTER_VALIDATE_INT) === false) {
+                throw new InvalidArgumentException("Priority \"{$key}\" must be a non-negative integer.");
+            }
+
+            if (! is_string($letter) || preg_match('/\A[A-Z]\z/', $letter) !== 1) {
+                throw new InvalidArgumentException("Prefix for priority {$key} must be a single letter A-Z.");
+            }
+        }
+
+        $effective = array_values($map);
+
+        foreach (self::DEFAULT_PREFIX_MAP as $level => $letter) {
+            if (! array_key_exists($level, $map)) {
+                $effective[] = $letter;
+            }
+        }
+
+        foreach (array_count_values($effective) as $letter => $count) {
+            if ($count > 1) {
+                throw new InvalidArgumentException("Prefix \"{$letter}\" cannot be used for more than one priority.");
+            }
+        }
+
+        ksort($map);
+
+        return $map;
+    }
