+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+return new class extends Migration
+{
+    /**
+     * Run the migrations.
+     *
+     * Display codes are now sequenced per queue, prefix and issue_date, so
+     * the same code may repeat on different days.
+     */
+    public function up(): void
+    {
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->date('issue_date')->nullable();
+        });
+
+        DB::table('tickets')
+            ->whereNull('issue_date')
+            ->update(['issue_date' => DB::raw('DATE(issued_at)')]);
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->date('issue_date')->nullable(false)->change();
+        });
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropUnique(['queue_id', 'code']);
+            $table->unique(['queue_id', 'code', 'issue_date']);
+        });
+    }
+
+    /**
+     * Reverse the migrations.
+     *
+     * Refuses to roll back when a code was issued on more than one day,
+     * because unique(queue_id, code) cannot be restored without rewriting
+     * issued codes.
+     */
+    public function down(): void
+    {
+        $hasRepeatedCodes = DB::table('tickets')
+            ->select('queue_id', 'code')
+            ->groupBy('queue_id', 'code')
+            ->havingRaw('COUNT(*) > 1')
+            ->limit(1)
+            ->get()
+            ->isNotEmpty();
+
+        if ($hasRepeatedCodes) {
+            throw new RuntimeException(
+                'Cannot roll back tickets.issue_date: the same code exists on more than one day for a queue.'
+            );
+        }
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropUnique(['queue_id', 'code', 'issue_date']);
+            $table->unique(['queue_id', 'code']);
+        });
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropColumn('issue_date');
+        });
+    }
+};
