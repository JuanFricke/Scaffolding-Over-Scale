diff --git a/tests/Feature/QueuePriorityPrefixTest.php b/tests/Feature/QueuePriorityPrefixTest.php
new file mode 100644
index 0000000..ca4fc0c
--- /dev/null
+++ b/tests/Feature/QueuePriorityPrefixTest.php
@@ -0,0 +1,167 @@
+<?php
+
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function makePrefixOwner(Entity $entity): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+it('maps named priority levels to the default letters', function (int $priority, string $letter) {
+    expect(Queue::defaultPrefixFor($priority))->toBe($letter)
+        ->and(Queue::factory()->create()->prefixForPriority($priority))->toBe($letter);
+})->with([
+    'normal' => [0, 'N'],
+    'priority' => [10, 'P'],
+    '80+' => [20, 'E'],
+]);
+
+it('falls back to the default letter by range for other priorities', function (int $priority, string $letter) {
+    expect(Queue::defaultPrefixFor($priority))->toBe($letter);
+})->with([
+    'negative is normal' => [-3, 'N'],
+    'between normal and priority' => [5, 'P'],
+    'between priority and 80+' => [15, 'P'],
+    'above 80+' => [25, 'E'],
+]);
+
+it('prefers the custom entry for a priority and defaults the rest', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z'],
+    ]);
+
+    expect($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('Z')
+        ->and($queue->prefixForPriority(5))->toBe('P')
+        ->and($queue->prefixForPriority(25))->toBe('E');
+});
+
+it('applies a partial custom entry on top of the defaults', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['5' => 'Q']]);
+
+    expect($queue->prefixForPriority(5))->toBe('Q')
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(10))->toBe('P');
+});
+
+it('stores the custom map in canonical form and an empty map as null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['10' => 'Y', '0' => 'X']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y']);
+
+    $queue->priority_prefix_map = [];
+    $queue->save();
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('is not mass-assignable, so update() ignores the map', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+
+    $queue->update(['priority_prefix_map' => ['0' => 'Y']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+});
+
+it('accepts maps whose effective letters are unique', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->not->toThrow(InvalidArgumentException::class);
+})->with([
+    'all custom' => [['0' => 'X', '10' => 'Y', '20' => 'Z']],
+    'explicit defaults' => [['0' => 'N', '10' => 'P', '20' => 'E']],
+    'extra level' => [['5' => 'Q']],
+    'custom normal and extra level' => [['0' => 'X', '5' => 'N']],
+]);
+
+it('rejects invalid maps when the queue is saved', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+})->with([
+    'non-numeric key' => [['foo' => 'X']],
+    'negative key' => [['-1' => 'Q']],
+    'leading zero key' => [['010' => 'Q']],
+    'multi-letter value' => [['10' => 'xx']],
+    'lowercase value' => [['0' => 'x']],
+    'digit value' => [['0' => '1']],
+    'value with trailing newline' => [['0' => "X\n"]],
+    'normal and priority share a letter' => [['0' => 'N', '10' => 'N']],
+    'normal merged with 80+' => [['0' => 'E']],
+    'priority merged with 80+ by default' => [['20' => 'P']],
+    'uncovered normal default reused' => [['5' => 'N']],
+    'two custom entries share a letter' => [['5' => 'Q', '6' => 'Q']],
+]);
+
+it('keeps the queue unchanged when a save would be invalid', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+
+    $queue->priority_prefix_map = ['0' => 'E'];
+
+    expect(fn () => $queue->save())
+        ->toThrow(InvalidArgumentException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+});
+
+it('sets, keeps and clears the map through UpdateQueue', function () {
+    $entity = Entity::factory()->create();
+    $owner = makePrefixOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X']);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+
+    (new UpdateQueue)($queue->fresh(), $owner, name: 'Renomeada');
+
+    expect($queue->fresh()->name)->toBe('Renomeada')
+        ->and($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+
+    (new UpdateQueue)($queue->fresh(), $owner, priorityPrefixMap: []);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull()
+        ->and($queue->fresh()->prefixForPriority(0))->toBe('N');
+});
+
+it('rejects an invalid map through UpdateQueue and leaves the queue unchanged', function () {
+    $entity = Entity::factory()->create();
+    $owner = makePrefixOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    try {
+        (new UpdateQueue)($queue, $owner, name: 'Nova', priorityPrefixMap: ['0' => 'E']);
+        $this->fail('Expected a ValidationException.');
+    } catch (ValidationException $e) {
+        expect($e->errors())->toHaveKey('priority_prefix_map');
+    }
+
+    expect($queue->fresh()->name)->toBe('Geral')
+        ->and($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('denies the prefix map change to employees', function () {
+    $entity = Entity::factory()->create();
+    makePrefixOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    expect(fn () => (new UpdateQueue)($queue, $employee, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
diff --git a/tests/Feature/TicketDisplayCodeTest.php b/tests/Feature/TicketDisplayCodeTest.php
new file mode 100644
index 0000000..0baf7c7
--- /dev/null
+++ b/tests/Feature/TicketDisplayCodeTest.php
@@ -0,0 +1,119 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+afterEach(fn () => Carbon::setTestNow());
+
+it('sequences each prefix independently', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $codes = collect([0, 10, 20, 0, 10, 0])
+        ->map(fn (int $priority) => (new IssueTicket)($queue, $priority)->code)
+        ->all();
+
+    expect($codes)->toBe(['N001', 'P001', 'E001', 'N002', 'P002', 'N003']);
+});
+
+it('uses the custom letter for a priority that has an entry', function () {
+    $queue = Queue::factory()->create([
+        'is_active' => true,
+        'priority_prefix_map' => ['0' => 'X'],
+    ]);
+
+    $normal = (new IssueTicket)($queue, 0);
+    $priority = (new IssueTicket)($queue, 10);
+
+    expect($normal->code)->toBe('X001')
+        ->and($priority->code)->toBe('P001');
+});
+
+it('restarts each prefix at 001 on the next day', function () {
+    Carbon::setTestNow(Carbon::parse('2026-10-29 23:59:30'));
+
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $lastOfDay = (new IssueTicket)($queue, 0);
+    $priorityOfDay = (new IssueTicket)($queue, 10);
+
+    Carbon::setTestNow(Carbon::parse('2026-10-30 00:00:10'));
+
+    $firstOfNextDay = (new IssueTicket)($queue, 0);
+    $priorityOfNextDay = (new IssueTicket)($queue, 10);
+
+    expect($lastOfDay->code)->toBe('N001')
+        ->and($priorityOfDay->code)->toBe('P001')
+        ->and($firstOfNextDay->code)->toBe('N001')
+        ->and($priorityOfNextDay->code)->toBe('P001')
+        ->and($firstOfNextDay->issue_date->toDateString())->toBe('2026-10-30')
+        ->and($firstOfNextDay->issued_at->toDateString())->toBe('2026-10-30')
+        ->and($lastOfDay->issue_date->toDateString())->toBe('2026-10-29')
+        ->and($lastOfDay->issued_at->toDateString())->toBe('2026-10-29');
+});
+
+it('keeps the issue date aligned with issued_at for the code day', function () {
+    Carbon::setTestNow(Carbon::parse('2026-10-29 23:59:59'));
+
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-10-29')
+        ->and($ticket->issued_at->toDateString())->toBe('2026-10-29');
+});
+
+it('allocates the factory code from the ticket priority and its issue day', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    (new IssueTicket)($queue);
+
+    $old = Ticket::factory()->for($queue)->create([
+        'issued_at' => '2026-09-28 10:00:00',
+        'priority' => 0,
+    ]);
+    $priority = Ticket::factory()->for($queue)->create(['priority' => 10]);
+
+    expect($old->code)->toBe('N001')
+        ->and($old->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($priority->code)->toBe('P001');
+});
+
+it('defaults the factory issue_date to the date of issued_at', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create(['issued_at' => '2026-09-28 10:00:00']);
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-09-28');
+});
+
+it('defaults the factory issue_date to today when issued_at is not given', function () {
+    Carbon::setTestNow(Carbon::parse('2026-10-29 12:00:00'));
+
+    $ticket = Ticket::factory()->for(Queue::factory()->create())->create();
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-10-29');
+});
+
+it('rejects a factory issue_date that does not match issued_at', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => Ticket::factory()->for($queue)->create([
+        'issued_at' => '2026-09-28 10:00:00',
+        'issue_date' => '2026-09-29',
+    ]))->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('keeps explicit factory codes', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create(['code' => 'Z777', 'priority' => 10]);
+
+    expect($ticket->code)->toBe('Z777');
+});
