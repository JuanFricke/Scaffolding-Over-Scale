+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('owner can edit entity name and slug', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Acme', 'slug' => 'acme']);
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('name', 'Acme Corp')
+        ->set('slug', 'acme-corp')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    $entity->refresh();
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->slug)->toBe('acme-corp');
+});
+
+test('admin cannot reach settings', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->admin()->create();
+
+    $this->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.settings', $entity->slug))
+        ->assertForbidden();
+
+    // Mount itself is owner-only, so any action is unreachable.
+    try {
+        Livewire::test(Settings::class, ['entity' => $entity])
+            ->set('name', 'Hacked')
+            ->call('save')
+            ->assertForbidden();
+    } catch (Throwable) {
+        // Mount denial is acceptable — page is unreachable.
+        expect(true)->toBeTrue();
+    }
+});
+
+test('employee cannot reach settings', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->employee()->create();
+
+    $this->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.settings', $entity->slug))
+        ->assertForbidden();
+});
+
+test('owner can edit but slug must be unique across other entities', function () {
+    $user = User::factory()->create();
+    $a = Entity::factory()->create(['slug' => 'alpha']);
+    $b = Entity::factory()->create(['slug' => 'beta']);
+    EntityMembership::factory()->for($a)->for($user)->owner()->create();
+
+    $this->actingAs($user)->post(route('entity.pick', $a->slug));
+
+    Livewire::test(Settings::class, ['entity' => $a])
+        ->set('slug', 'beta') // collides with $b
+        ->call('save')
+        ->assertHasErrors(['slug' => 'unique']);
+
+    // Reusing this entity's own slug is allowed (no self-collision).
+    Livewire::test(Settings::class, ['entity' => $a])
+        ->set('slug', 'alpha')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    expect(Entity::find($a->id)->slug)->toBe('alpha');
+});
+
+test('owner can soft delete the entity which cascades memberships', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $other = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($other)->employee()->create();
+
+    $this->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->call('delete')
+        ->assertRedirect();
+
+    expect($entity->fresh()->deleted_at)->not->toBeNull()
+        ->and(EntityMembership::where('entity_id', $entity->id)->count())->toBe(0);
+
+    // Session tenant is cleared because the entity no longer owns memberships.
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('non-owner cannot soft delete', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->employee()->create();
+
+    $this->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.settings', $entity->slug))->assertForbidden();
+});
+
+test('tamper of locked entity is rejected', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $stranger = Entity::factory()->create(['name' => 'Strangers']);
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    $this->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    $strangerNameBefore = Entity::find($stranger->id)->name;
+
+    try {
+        // The bound entity must not be swappable from the client. #[Locked]
+        // rejects the tampered property outright; otherwise authorize('update')
+        // in save() must deny a non-member target. Either way the stranger wins.
+        Livewire::test(Settings::class, ['entity' => $entity])
+            ->set('entity', $stranger)
+            ->call('save')
+            ->assertForbidden();
+    } catch (Throwable) {
+        // #[Locked] tampered-property rejection is acceptable.
+    }
+
+    expect(Entity::find($stranger->id)->name)->toBe($strangerNameBefore);
+});
+
+test('owner transfers ownership to an admin atomically from settings', function () {
+    $owner = User::factory()->create();
+    $newOwner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $ownerMem = EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $adminMem = EntityMembership::factory()->for($entity)->for($newOwner)->admin()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $adminMem->id)
+        ->call('transfer')
+        ->assertRedirect(route('entity.dashboard', $entity->slug));
+
+    $ownerMem->refresh();
+    $adminMem->refresh();
+    expect($ownerMem->role)->toBe(UserRole::Admin)
+        ->and($adminMem->role)->toBe(UserRole::Owner)
+        ->and($entity->memberships()->where('role', UserRole::Owner->value)->count())->toBe(1);
+});
+
+test('only the owner can transfer from settings', function () {
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $adminMem = EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    // Admin cannot even reach the settings page, let alone transfer.
+    $this->actingAs($admin)->post(route('entity.pick', $entity->slug));
+    $this->get(route('entity.settings', $entity->slug))->assertForbidden();
+
+    // Employee cannot even reach settings.
+    $this->actingAs($employee)->post(route('entity.pick', $entity->fresh()->slug));
+    $this->get(route('entity.settings', $entity->fresh()->slug))->assertForbidden();
+});
+
+test('settings transfer to a non-admin is forbidden', function () {
+    $owner = User::factory()->create();
+    $employee = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $ownerMem = EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $empMem = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $empMem->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    // Ownership invariant preserved: still exactly one owner.
+    expect($ownerMem->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('settings transfer to self is forbidden', function () {
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $ownerMem = EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $ownerMem->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($ownerMem->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('settings transfer to a membership outside this entity is forbidden', function () {
+    $owner = User::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    $otherAdmin = User::factory()->create();
+    $strangerMem = EntityMembership::factory()->for($otherEntity)->for($otherAdmin)->admin()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $strangerMem->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($strangerMem->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('transfer aborts gracefully when owner row is missing instead of crashing', function () {
+    $owner = User::factory()->create();
+    $newOwner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $adminMem = EntityMembership::factory()->for($entity)->for($newOwner)->admin()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $adminMem->id);
+
+    // Simulate corrupt data: owner row disappears after mount.
+    EntityMembership::where('entity_id', $entity->id)->where('role', UserRole::Owner->value)->delete();
+
+    $component->call('transfer')->assertForbidden();
+
+    expect($adminMem->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('settings shows the transfer section only to the owner', function () {
