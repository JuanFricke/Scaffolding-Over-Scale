+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Livewire\Component;
+use Illuminate\Foundation\Auth\Access\AuthorizesRequests;
+
+class Settings extends Component
+{
+    use AuthorizesRequests;
+    public Entity $entity;
+    public string $name;
+    public string $slug;
+    public ?int $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        $this->validate([
+            'name' => 'required|string',
+            'slug' => 'required|string|alpha_dash|unique:entities,slug,' . $this->entity->id,
+        ]);
+        $this->entity->update([
+            'name' => $this->name,
+            'slug' => $this->slug,
+        ]);
+        session()->flash('message', __('Entity updated.'));
+    }
+
+    public function delete(): void
+    {
+        $this->entity->delete();
+        if (session('current_entity_id') === $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+        return redirect()->route('home');
+    }
+
+    public function transfer(): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($this->targetMembershipId);
+        if ($membership->role !== UserRole::Admin || $membership->user_id === Auth::id()) {
+            abort(403);
+        }
+        DB::transaction(function () use ($membership) {
+            $this->entity->memberships()->where('user_id', Auth::id())->update(['role' => UserRole::Admin]);
+            $membership->update(['role' => UserRole::Owner]);
+        });
+        return redirect()->route('entity.dashboard', $this->entity);
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.settings');
+    }
+}
