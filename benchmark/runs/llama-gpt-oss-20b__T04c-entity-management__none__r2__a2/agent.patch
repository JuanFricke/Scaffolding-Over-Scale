@@ -0,0 +1,94 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('entity factory defaults slug and name', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->slug)->not->toBeEmpty()
+        ->and($entity->name)->not->toBeEmpty();
+});
+
+test('entity routes resolve by slug', function () {
+    // getRouteKeyName is exercised by Route::bind in Step 3; here assert the contract.
+    expect((new Entity)->getRouteKeyName())->toBe('slug');
+});
+
+test('entity owner is the membership whose role is owner', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    expect($entity->owner()->first())->toBeInstanceOf(EntityMembership::class)
+        ->and($entity->owner()->first()->is($membership))->toBeTrue()
+        ->and($entity->owner()->first()->role)->toBe(UserRole::Owner);
+});
+
+test('entity with no owner has null owner', function () {
+    $entity = Entity::factory()->create();
+    User::factory()->create();
+    EntityMembership::factory()->for($entity)->create();
+
+    expect($entity->owner()->first())->toBeNull();
+});
+
+test('entity relationships resolve memberships and users', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    expect($entity->users()->get())->toHaveCount(1)
+        ->and($entity->users()->get()->first()->is($user))->toBeTrue();
+});
+
+test('membership role is cast to the UserRole enum', function () {
+    $membership = EntityMembership::factory()->create(['role' => UserRole::Admin->value]);
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($membership->getRawOriginal('role'))->toBe(UserRole::Admin->value);
+});
+
+test('membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->owner()->create();
+    EntityMembership::factory()->for($entity)->admin()->create();
+    EntityMembership::factory()->for($entity)->employee()->create();
+
+    expect(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(1);
+});
+
+test('user belongs to many entities and has memberships', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    expect($user->memberships()->get())->toHaveCount(1)
+        ->and($user->entities()->get())->toHaveCount(1)
+        ->and($user->entities()->get()->first()->is($entity))->toBeTrue()
+        ->and($user->memberships()->get()->first()->is($membership))->toBeTrue();
+});
+
+test('user membershipFor resolves the membership for a given entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($user)->admin()->create();
+
+    expect($user->membershipFor($entity->id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor(Entity::factory()->create()->id))->toBeNull();
+});
+
+test('entity can be soft-deleted and restored', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+    expect(Entity::withTrashed()->find($entity->id))->toBeInstanceOf(Entity::class)
+        ->and(Entity::find($entity->id))->toBeNull();
+});
diff --git a/tests/Feature/Entity/EntityPolicyTest.php b/tests/Feature/Entity/EntityPolicyTest.php
new file mode 100644
index 0000000..159e73a
--- /dev/null
+++ b/tests/Feature/Entity/EntityPolicyTest.php
@@ -0,0 +1,114 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/*
+ * Shared fixtures: an entity with owner, admin, employee and a stranger user.
+ */
+function entityFixtures(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $stranger = User::factory()->create();
+
+    $ownerMem = EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $adminMem = EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    return [$entity, $owner, $admin, $employee, $stranger, $ownerMem, $adminMem];
+}
+
+/* ---------- EntityPolicy ---------- */
+
+test('EntityPolicy create allows any authenticated user', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = entityFixtures();
+    $policy = new EntityPolicy;
+
+    expect($policy->create($owner))->toBeTrue()
+        ->and($policy->create($employee))->toBeTrue();
+});
+
+test('EntityPolicy view allows any member and denies non-members', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = entityFixtures();
+    $policy = new EntityPolicy;
+
+    expect($policy->view($owner, $entity))->toBeTrue()
+        ->and($policy->view($admin, $entity))->toBeTrue()
+        ->and($policy->view($employee, $entity))->toBeTrue()
+        ->and($policy->view($stranger, $entity))->toBeFalse();
+});
+
+test('EntityPolicy update delete allowed for owner and admin only', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = entityFixtures();
+    $policy = new EntityPolicy;
+
+    // owner + admin can edit/delete; employee + non-member cannot.
+    expect($policy->update($owner, $entity))->toBeTrue()
+        ->and($policy->update($admin, $entity))->toBeTrue()
+        ->and($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->update($stranger, $entity))->toBeFalse();
+
+    expect($policy->delete($owner, $entity))->toBeTrue()
+        ->and($policy->delete($admin, $entity))->toBeTrue()
+        ->and($policy->delete($employee, $entity))->toBeFalse()
+        ->and($policy->delete($stranger, $entity))->toBeFalse();
+});
+
+test('EntityPolicy manageSettings allowed for owner only', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = entityFixtures();
+    $policy = new EntityPolicy;
+
+    expect($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse()
+        ->and($policy->manageSettings($employee, $entity))->toBeFalse()
+        ->and($policy->manageSettings($stranger, $entity))->toBeFalse();
+});
+
+/* ---------- EntityMembershipPolicy ---------- */
+
+test('EntityMembershipPolicy view allows any member of the entity', function () {
+    [$entity, $owner, $admin, $employee, $stranger, $ownerMem, $adminMem] = entityFixtures();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($owner, $adminMem))->toBeTrue()
+        ->and($policy->view($admin, $ownerMem))->toBeTrue()
+        ->and($policy->view($employee, $ownerMem))->toBeTrue()
+        ->and($policy->view($stranger, $ownerMem))->toBeFalse();
+});
+
+test('EntityMembershipPolicy assignRole allowed for owner and admin only', function () {
+    [$entity, $owner, $admin, $employee, $stranger, $ownerMem, $adminMem] = entityFixtures();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->assignRole($owner, $adminMem))->toBeTrue()
+        ->and($policy->assignRole($admin, $ownerMem))->toBeTrue()
+        ->and($policy->assignRole($employee, $adminMem))->toBeFalse()
+        ->and($policy->assignRole($stranger, $adminMem))->toBeFalse();
+});
+
+test('EntityMembershipPolicy delete denies removing the owner and allows self-removal', function () {
+    [$entity, $owner, $admin, $employee, $stranger, $ownerMem, $adminMem] = entityFixtures();
+    $policy = new EntityMembershipPolicy;
+
+    // Owner can never be removed.
+    expect($policy->delete($admin, $ownerMem))->toBeFalse()
+        ->and($policy->delete($owner, $ownerMem))->toBeFalse();
+
+    // Admin can remove an employee; the employee may remove themselves.
+    $empMem = EntityMembership::where('user_id', $employee->id)->first();
+    expect($policy->delete($admin, $empMem))->toBeTrue()
+        ->and($policy->delete($employee, $empMem))->toBeTrue();
+
+    // Stranger and non-members cannot.
+    expect($policy->delete($stranger, $empMem))->toBeFalse()
+        ->and($policy->delete($employee, $ownerMem))->toBeFalse();
+});
diff --git a/tests/Feature/Entity/EntitySchemaTest.php b/tests/Feature/Entity/EntitySchemaTest.php
new file mode 100644
index 0000000..d33bd38
--- /dev/null
+++ b/tests/Feature/Entity/EntitySchemaTest.php
@@ -0,0 +1,67 @@
+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities table has required columns, unique slug and soft deletes', function () {
+    $this->assertTrue(Schema::hasTable('entities'));
+
+    $this->assertTrue(Schema::hasColumns('entities', [
+        'id', 'name', 'slug', 'created_at', 'updated_at', 'deleted_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('entities', 'entities_slug_unique'));
+});
+
+test('entity_memberships table has composite key and one-owner generated column', function () {
+    $this->assertTrue(Schema::hasTable('entity_memberships'));
+
+    $this->assertTrue(Schema::hasColumns('entity_memberships', [
+        'id', 'entity_id', 'user_id', 'role', 'owner_seq', 'created_at', 'updated_at',
+    ]));
+
+    // At most one membership per (entity, user).
+    $this->assertTrue(Schema::hasIndex('entity_memberships', 'entity_memberships_entity_user_unique'));
+
+    // generated stored column drives the one-owner guarantee.
+    $this->assertTrue(Schema::hasIndex('entity_memberships', 'entity_memberships_one_owner'));
+
+    // role defaults to employee.
+    $user = DB::table('users')->insertGetId(['name' => 'x', 'email' => 'x@x', 'password' => 'secret', 'email_verified_at' => now()]);
+    $entity = DB::table('entities')->insertGetId(['name' => 'e', 'slug' => 'e1']);
+
+    $id = DB::table('entity_memberships')->insertGetId([
+        'entity_id' => $entity,
+        'user_id' => $user,
+    ]);
+
+    $membership = DB::table('entity_memberships')->where('id', $id)->first();
+    expect($membership->role)->toBe('employee');
+});
+
+test('db enforces at most one owner per entity', function () {
+    $entity = DB::table('entities')->insertGetId(['name' => 'e', 'slug' => 'e1']);
+    $u1 = DB::table('users')->insertGetId(['name' => 'a', 'email' => 'a@x', 'password' => 'secret', 'email_verified_at' => now()]);
+    $u2 = DB::table('users')->insertGetId(['name' => 'b', 'email' => 'b@x', 'password' => 'secret', 'email_verified_at' => now()]);
+
+    DB::table('entity_memberships')->insert(['entity_id' => $entity, 'user_id' => $u1, 'role' => 'owner']);
+
+    $rejected = false;
+    try {
+        DB::table('entity_memberships')->insert(['entity_id' => $entity, 'user_id' => $u2, 'role' => 'owner']);
+    } catch (Throwable) {
+        $rejected = true;
+    }
+
+    expect($rejected)->toBeTrue()
+        ->and(DB::table('entity_memberships')->where(['entity_id' => $entity, 'role' => 'owner'])->count())->toBe(1);
+
+    // A second entity may have its own owner — index is per (entity, owner_seq).
+    $entity2 = DB::table('entities')->insertGetId(['name' => 'e2', 'slug' => 'e2']);
+    DB::table('entity_memberships')->insert(['entity_id' => $entity2, 'user_id' => $u2, 'role' => 'owner']);
+
+    expect(DB::table('entity_memberships')->where(['entity_id' => $entity2, 'role' => 'owner'])->count())->toBe(1);
+});
diff --git a/tests/Feature/Entity/MembersTest.php b/tests/Feature/Entity/MembersTest.php
new file mode 100644
index 0000000..798a937
--- /dev/null
+++ b/tests/Feature/Entity/MembersTest.php
@@ -0,0 +1,154 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('manager can add an existing user as employee', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $target = User::factory()->create(['email' => 'target@example.com']);
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+
+    $this->actingAs($admin)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', 'target@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors();
+
+    $membership = EntityMembership::where('entity_id', $entity->id)->where('user_id', $target->id)->first();
+    expect($membership)->not->toBeNull()
+        ->and($membership->role)->toBe(UserRole::Employee);
+});
+
+test('adding a nonexistent user fails validation', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+
+    $this->actingAs($admin)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', 'nobody@example.com')
+        ->call('addMember')
+        ->assertHasErrors(['email' => 'exists']);
+
+    expect(EntityMembership::where('entity_id', $entity->id)->count())->toBe(1);
+});
+
+test('adding an existing member reports a conflict', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $member = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($member)->admin()->create();
+
+    $this->actingAs($admin)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', $member->email)
+        ->call('addMember')
+        ->assertHasErrors('email');
+});
+
+test('employee cannot add members or assign roles', function () {
+    $employee = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $admin = User::factory()->create();
+    $target = User::factory()->create(['email' => 't@example.com']);
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', 't@example.com')
+        ->call('addMember')
+        ->assertForbidden();
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', EntityMembership::where('user_id', $admin->id)->first()->id, 'admin')
+        ->assertForbidden();
+
+    expect(EntityMembership::where('entity_id', $entity->id)->count())->toBe(2);
+});
+
+test('manager can assign admin or employee but never the owner role', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $target = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($target)->employee()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+
+    $this->actingAs($admin)->post(route('entity.pick', $entity->slug));
+
+    // Valid promotion.
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $membership->id, 'admin')
+        ->assertHasNoErrors();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin);
+
+    // Tamper: owner role is not assignable here.
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $membership->id, 'owner')
+        ->assertHasErrors('role');
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('cannot remove the last manager of an entity', function () {
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $entity = Entity::factory()->create();
+    // Corrupt-but-possible state: no owner, single admin + employee.
+    $adminMem = EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($admin)->post(route('entity.pick', $entity->slug));
+
+    // Removing the employee is fine (not a manager).
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', EntityMembership::where('user_id', $employee->id)->first()->id)
+        ->assertHasNoErrors();
+
+    // Removing the last manager is forbidden — entity must keep one.
+    Livewire::test(Members::class, ['entity' => $entity->fresh()])
+        ->call('removeMember', $adminMem->id)
+        ->assertForbidden();
+
+    expect(EntityMembership::where('id', $adminMem->id)->exists())->toBeTrue();
+});
+
+test('cannot remove the owner; managers can remove members', function () {
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $ownerMem = EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $adminMem = EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    // Nobody (not even an admin) can remove the owner.
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $ownerMem->id)
+        ->assertForbidden();
+
+    expect(EntityMembership::where('id', $ownerMem->id)->exists())->toBeTrue();
+
+    // An admin can remove an employee.
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', EntityMembership::where('user_id', $employee->id)->first()->id);
+
+    expect(EntityMembership::where('user_id', $employee->id)->exists())->toBeFalse()
+        ->and(EntityMembership::where('id', $ownerMem->id)->exists())->toBeTrue();
+});
