+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Auth;
+use Livewire\Component;
+use Illuminate\Foundation\Auth\Access\AuthorizesRequests;
+
+class Members extends Component
+{
+    use AuthorizesRequests;
+    public Entity $entity;
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $this->validate([
+            'email' => 'required|email|exists:users,email',
+        ]);
+
+        $user = User::where('email', $this->email)->first();
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            $this->addError('email', __('validation.unique', ['attribute' => 'member']));
+            return;
+        }
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+        session()->flash('message', __('Member added.'));
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        if (!
+            in_array(
+                $role,
+                UserRole::manageable()->map(fn ($r) => $r->value)->toArray()
+            )
+        ) {
+            $this->addError('role', __('validation.in'));
+            return;
+        }
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+        $this->authorize('assignRole', $membership);
+        $membership->update(['role' => $role]);
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+        $this->authorize('delete', $membership);
+        $membership->delete();
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.members');
+    }
+}
