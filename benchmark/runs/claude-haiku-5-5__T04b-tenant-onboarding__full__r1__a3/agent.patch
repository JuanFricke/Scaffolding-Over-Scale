+    Livewire::actingAs($this->user)
+        ->test(CreateEntity::class)
+        ->set('name', '!!!')
+        ->call('submit')
+        ->assertRedirect(route('entity.dashboard', 'entity'));
+});
+
+test('a slug that collides at insert time is retried with a fresh slug', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+    CollidingSlugCreateEntity::$calls = 0;
+
+    Livewire::actingAs($this->user)
+        ->test(CollidingSlugCreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', 'acme-corp-2'));
+
+    expect(CollidingSlugCreateEntity::$calls)->toBe(2)
+        ->and(Entity::query()->count())->toBe(2)
+        ->and(EntityMembership::query()->where('user_id', $this->user->id)->count())->toBe(1);
+});
+
+test('a slug that keeps colliding stops after a bounded number of attempts and writes nothing', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect(fn () => Livewire::actingAs($this->user)
+        ->test(AlwaysCollidingSlugCreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit'))->toThrow(UniqueConstraintViolationException::class);
+
+    expect(Entity::query()->count())->toBe(1)
+        ->and(EntityMembership::query()->count())->toBe(0);
+});
+
+test('a client cannot set the role or owner of the new entity', function () {
+    expect(fn () => Livewire::actingAs($this->user)
+        ->test(CreateEntity::class)
+        ->set('role', 'employee'))->toThrow(PublicPropertyNotFoundException::class);
+});
+
+test('a user creating entities in a burst is throttled', function () {
+    $component = Livewire::actingAs($this->user)->test(CreateEntity::class);
+
+    foreach (range(1, 10) as $i) {
+        $component->set('name', "Empresa {$i}")->call('submit')->assertHasNoErrors();
+    }
+
+    $component->set('name', 'Empresa 11')
+        ->call('submit')
+        ->assertHasErrors(['name']);
+
+    expect(Entity::query()->count())->toBe(10);
+});
diff --git a/tests/Feature/EntityDashboardTest.php b/tests/Feature/EntityDashboardTest.php
new file mode 100644
index 0000000..1147b92
--- /dev/null
+++ b/tests/Feature/EntityDashboardTest.php
@@ -0,0 +1,61 @@
+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function memberOf(User $user, Entity $entity, UserRole $role = UserRole::Employee): void
+{
+    EntityMembership::factory()->create(['user_id' => $user->id, 'entity_id' => $entity->id, 'role' => $role]);
+}
+
+beforeEach(function () {
+    $this->user = User::factory()->create();
+    $this->entity = Entity::factory()->create(['name' => 'Acme Corp']);
+    memberOf($this->user, $this->entity, UserRole::Owner);
+});
+
+test('a member sees the entity name on its dashboard', function () {
+    $this->actingAs($this->user)
+        ->withSession(['current_entity_id' => $this->entity->id])
+        ->get(route('entity.dashboard', $this->entity))
+        ->assertOk()
+        ->assertSee('Acme Corp')
+        ->assertSee('wire:id', false);
+});
+
+test('a member may open a dashboard other than the one in their session', function () {
+    $second = Entity::factory()->create(['name' => 'Second Co']);
+    memberOf($this->user, $second);
+
+    $this->actingAs($this->user)
+        ->withSession(['current_entity_id' => $this->entity->id])
+        ->get(route('entity.dashboard', $second))
+        ->assertOk()
+        ->assertSee('Second Co');
+});
+
+test('a user who is not a member of the requested entity gets 403, even with a valid session for another entity', function () {
+    $stranger = Entity::factory()->create(['name' => 'Stranger Ltd']);
+
+    $this->actingAs($this->user)
+        ->withSession(['current_entity_id' => $this->entity->id])
+        ->get(route('entity.dashboard', $stranger))
+        ->assertForbidden()
+        ->assertDontSee('Stranger Ltd');
+});
+
+test('the dashboard entity is locked against tampering in a Livewire request', function () {
+    $stranger = Entity::factory()->create(['name' => 'Stranger Ltd']);
+
+    expect(fn () => Livewire::actingAs($this->user)
+        ->test(Dashboard::class, ['entity' => $this->entity])
+        ->set('entity', $stranger))->toThrow(CannotUpdateLockedPropertyException::class);
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..3713a1c
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,154 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity slugs are unique at the database level, including soft-deleted entities', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme-corp']))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    $entity->delete();
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme-corp']))
+        ->toThrow(UniqueConstraintViolationException::class);
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique');
+});
+
+test('entities are routed by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme-corp');
+});
+
+test('a membership defaults to the employee role when none is given', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert(['entity_id' => $entity->id, 'user_id' => $user->id]);
+
+    expect(EntityMembership::query()->sole()->role)->toBe(UserRole::Employee);
+});
+
+test('a user holds at most one membership per entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+    expect(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_entity_user_unique');
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $owner->entity_id]))
+        ->toThrow(UniqueConstraintViolationException::class);
+    expect(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_one_owner');
+});
+
+test('the database rejects promoting a member to owner while the entity has one', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $owner->entity_id]);
+
+    expect(fn () => $admin->update(['role' => UserRole::Owner]))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('owner_seq is 1 for the owner and NULL for everyone else', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $owner->entity_id]);
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $owner->entity_id]);
+
+    expect(DB::table('entity_memberships')->where('id', $owner->id)->value('owner_seq'))->toBe(1)
+        ->and(DB::table('entity_memberships')->where('id', $admin->id)->value('owner_seq'))->toBeNull()
+        ->and(DB::table('entity_memberships')->where('id', $employee->id)->value('owner_seq'))->toBeNull();
+});
+
+test('an entity may have any number of admins and employees besides its owner', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    EntityMembership::factory()->admin()->count(2)->create(['entity_id' => $owner->entity_id]);
+    EntityMembership::factory()->employee()->count(3)->create(['entity_id' => $owner->entity_id]);
+
+    expect(EntityMembership::query()->where('entity_id', $owner->entity_id)->count())->toBe(6);
+});
+
+test('deleting an entity or a user removes its memberships', function () {
+    $membership = EntityMembership::factory()->create();
+    $other = EntityMembership::factory()->create();
+
+    $membership->entity->forceDelete();
+    $other->user->delete();
+
+    expect(EntityMembership::query()->whereKey([$membership->id, $other->id])->count())->toBe(0);
+});
+
+test('an entity exposes its owner, memberships and users', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue()
+        ->and($entity->memberships)->toHaveCount(2)
+        ->and($entity->users)->toHaveCount(2);
+});
+
+test('a user lists only the live entities they belong to', function () {
+    $user = User::factory()->create();
+    $live = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $deleted = EntityMembership::factory()->create(['user_id' => $user->id])->entity;
+    $deleted->delete();
+
+    expect($user->entities)->toHaveCount(1)
+        ->and($user->entities->first()->is($live))->toBeTrue();
+});
+
+test('membershipFor finds the membership only for a live entity the user belongs to', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->admin()->create(['user_id' => $user->id]);
+    $stranger = Entity::factory()->create();
+
+    expect($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor($stranger->id))->toBeNull();
+
+    $membership->entity->delete();
+
+    expect($user->membershipFor($membership->entity_id))->toBeNull();
+});
+
+test('membership scopes filter by role', function () {
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->admin()->count(2)->create();
+    EntityMembership::factory()->employee()->count(3)->create();
+
+    expect(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(2)
+        ->and(EntityMembership::employee()->count())->toBe(3);
+});
+
+test('the membership factory creates its entity and user as an employee by default', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+});
+
+test('only admins and employees are manageable roles', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee])
+        ->and(UserRole::from('owner'))->toBe(UserRole::Owner);
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..94b4879
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,126 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function memberWithRole(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $user->id, 'role' => $role]);
+
+    return $user;
+}
+
+function membershipOf(User $user, Entity $entity): EntityMembership
+{
+    return $user->membershipFor($entity->id);
+}
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = memberWithRole($this->entity, UserRole::Owner);
+    $this->admin = memberWithRole($this->entity, UserRole::Admin);
+    $this->employee = memberWithRole($this->entity, UserRole::Employee);
+    $this->outsider = User::factory()->create();
+});
+
+test('any authenticated user may create an entity', function () {
+    expect(Gate::forUser($this->outsider)->allows('create', Entity::class))->toBeTrue();
+});
+
+test('any member may view the entity, outsiders may not', function (string $who, bool $expected) {
+    expect(Gate::forUser($this->{$who})->allows('view', $this->entity))->toBe($expected);
+})->with([
+    'owner' => ['owner', true],
+    'admin' => ['admin', true],
+    'employee' => ['employee', true],
+    'outsider' => ['outsider', false],
+]);
+
+test('owner and admin may update and delete the entity', function (string $who, bool $expected) {
+    expect(Gate::forUser($this->{$who})->allows('update', $this->entity))->toBe($expected)
+        ->and(Gate::forUser($this->{$who})->allows('delete', $this->entity))->toBe($expected);
+})->with([
+    'owner' => ['owner', true],
+    'admin' => ['admin', true],
+    'employee' => ['employee', false],
+    'outsider' => ['outsider', false],
+]);
+
+test('only the owner may manage the entity settings', function (string $who, bool $expected) {
+    expect(Gate::forUser($this->{$who})->allows('manageSettings', $this->entity))->toBe($expected);
+})->with([
+    'owner' => ['owner', true],
+    'admin' => ['admin', false],
+    'employee' => ['employee', false],
+    'outsider' => ['outsider', false],
+]);
+
+test('any member may view memberships of their entity, outsiders and other entities may not', function () {
+    $other = Entity::factory()->create();
+    $otherAdmin = memberWithRole($other, UserRole::Admin);
+    $target = membershipOf($this->employee, $this->entity);
+
+    expect(Gate::forUser($this->employee)->allows('view', $target))->toBeTrue()
+        ->and(Gate::forUser($this->outsider)->allows('view', $target))->toBeFalse()
+        ->and(Gate::forUser($otherAdmin)->allows('view', $target))->toBeFalse();
+});
+
+test('owner and admin may assign roles to managed memberships', function (string $who, string $targetRole, bool $expected) {
+    $target = membershipOf(memberWithRole($this->entity, UserRole::from($targetRole)), $this->entity);
+
+    expect(Gate::forUser($this->{$who})->allows('assignRole', $target))->toBe($expected);
+})->with([
+    'owner assigns employee' => ['owner', 'employee', true],
+    'owner assigns admin' => ['owner', 'admin', true],
+    'admin assigns employee' => ['admin', 'employee', true],
+    'admin assigns admin' => ['admin', 'admin', true],
+    'employee cannot assign' => ['employee', 'employee', false],
+]);
+
+test('nobody assigns a role to the owner membership, not even the owner', function () {
+    $ownerMembership = membershipOf($this->owner, $this->entity);
+
+    expect(Gate::forUser($this->owner)->allows('assignRole', $ownerMembership))->toBeFalse()
+        ->and(Gate::forUser($this->admin)->allows('assignRole', $ownerMembership))->toBeFalse();
+});
+
+test('a role cannot be assigned across entities', function () {
+    $other = Entity::factory()->create();
+    $otherEmployee = membershipOf(memberWithRole($other, UserRole::Employee), $other);
+
+    expect(Gate::forUser($this->admin)->allows('assignRole', $otherEmployee))->toBeFalse()
+        ->and(Gate::forUser($this->outsider)->allows('assignRole', $otherEmployee))->toBeFalse();
+});
+
+test('the owner membership is never deletable', function () {
+    $ownerMembership = membershipOf($this->owner, $this->entity);
+
+    expect(Gate::forUser($this->owner)->allows('delete', $ownerMembership))->toBeFalse()
+        ->and(Gate::forUser($this->admin)->allows('delete', $ownerMembership))->toBeFalse();
+});
+
+test('anyone may remove their own membership, unless they are the owner', function () {
+    $adminMembership = membershipOf($this->admin, $this->entity);
+    $employeeMembership = membershipOf($this->employee, $this->entity);
+
+    expect(Gate::forUser($this->employee)->allows('delete', $employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows('delete', $adminMembership))->toBeTrue();
+});
+
+test('owner and admin may remove other memberships, employees may not', function () {
+    $employeeMembership = membershipOf($this->employee, $this->entity);
+    $adminMembership = membershipOf($this->admin, $this->entity);
+
+    expect(Gate::forUser($this->owner)->allows('delete', $employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows('delete', $employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->owner)->allows('delete', $adminMembership))->toBeTrue()
+        ->and(Gate::forUser($this->employee)->allows('delete', $adminMembership))->toBeFalse()
+        ->and(Gate::forUser($this->outsider)->allows('delete', $employeeMembership))->toBeFalse();
+});
diff --git a/tests/Feature/EntitySwitcherTest.php b/tests/Feature/EntitySwitcherTest.php
new file mode 100644
index 0000000..24c1fa9
--- /dev/null
+++ b/tests/Feature/EntitySwitcherTest.php
@@ -0,0 +1,101 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function joinNamedEntity(User $user, string $name, UserRole $role = UserRole::Employee): Entity
+{
+    $entity = Entity::factory()->create(['name' => $name]);
+    EntityMembership::factory()->create(['user_id' => $user->id, 'entity_id' => $entity->id, 'role' => $role]);
+
+    return $entity;
+}
+
+function htmlXPath(string $html): DOMXPath
+{
+    libxml_use_internal_errors(true);
+    $dom = new DOMDocument;
+    $dom->loadHTML($html);
+    libxml_clear_errors();
+
+    return new DOMXPath($dom);
+}
+
+test('the switcher lists only the user entities as pick forms and marks the current one', function () {
+    $user = User::factory()->create();
+    $acme = joinNamedEntity($user, 'Acme Corp', UserRole::Owner);
+    $beta = joinNamedEntity($user, 'Beta Ltd', UserRole::Employee);
+    $stranger = Entity::factory()->create(['name' => 'Stranger Ltd']);
+
+    $html = $this->actingAs($user)
+        ->withSession(['current_entity_id' => $beta->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Trocar de entidade')
+        ->assertDontSee('Stranger Ltd')
+        ->getContent();
+
+    $xpath = htmlXPath($html);
+    $pickForm = fn (Entity $entity) => $xpath->query('//form[@method="POST"][@action="'.route('entity.pick', $entity).'"]');
+
+    expect($pickForm($acme))->toHaveCount(1)
+        ->and($pickForm($beta))->toHaveCount(1)
+        ->and($pickForm($stranger))->toHaveCount(0);
+
+    $current = $xpath->query('//button[@data-current="1"]');
+    expect($current)->toHaveCount(1)
+        ->and($current->item(0)->getAttribute('class'))->toBe('button is-fullwidth is-link')
+        ->and($current->item(0)->parentNode->getAttribute('action'))->toBe(route('entity.pick', $beta));
+
+    $others = $xpath->query('//button[@class="button is-fullwidth is-light"]');
+    expect($others)->toHaveCount(1)
+        ->and($others->item(0)->hasAttribute('data-current'))->toBeFalse()
+        ->and($others->item(0)->textContent)->toBe('Acme Corp');
+});
+
+test('the switcher marks nothing as current when the session holds no entity', function () {
+    $user = User::factory()->create();
+    joinNamedEntity($user, 'Acme Corp');
+    joinNamedEntity($user, 'Beta Ltd');
+
+    $xpath = htmlXPath($this->actingAs($user)->get(route('entity.switcher'))->getContent());
+
+    expect($xpath->query('//button[@data-current="1"]'))->toHaveCount(0)
+        ->and($xpath->query('//button[@class="button is-fullwidth is-light"]'))->toHaveCount(2);
+});
+
+test('the switcher title is translated', function () {
+    $user = User::factory()->create();
+    joinNamedEntity($user, 'Acme Corp');
+
+    $this->actingAs($user)->get(route('entity.switcher'))->assertSee('Trocar de entidade');
+
+    app()->setLocale('en');
+    $this->actingAs($user)->get(route('entity.switcher'))->assertSee('Switch entity');
+});
+
+test('the navbar links to the switcher only for users with more than one entity', function () {
+    $user = User::factory()->create();
+    joinNamedEntity($user, 'Acme Corp');
+
+    $this->actingAs($user)
+        ->get(route('onboarding'))
+        ->assertSee($user->name)
+        ->assertDontSee('href="'.route('entity.switcher').'"', false);
+
+    joinNamedEntity($user, 'Beta Ltd');
+
+    $this->actingAs($user)
+        ->get(route('onboarding'))
+        ->assertSee('href="'.route('entity.switcher').'"', false)
+        ->assertSee('Trocar de entidade');
+});
+
+test('the navbar offers no switcher link to guests', function () {
+    $this->get(route('login'))->assertDontSee('href="'.route('entity.switcher').'"', false);
+});
diff --git a/tests/Feature/TenantSessionTest.php b/tests/Feature/TenantSessionTest.php
new file mode 100644
index 0000000..d856f88
--- /dev/null
+++ b/tests/Feature/TenantSessionTest.php
@@ -0,0 +1,169 @@
+<?php
+
+use App\Http\Middleware\ResolveCurrentEntity;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+function verifiedUser(): User
+{
+    return User::factory()->create();
+}
+
+function joinEntity(User $user, UserRole $role = UserRole::Employee): Entity
+{
+    return EntityMembership::factory()->create(['user_id' => $user->id, 'role' => $role])->entity;
+}
+
+test('guests are redirected to login from home and the entity pages', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('home'))->assertRedirect(route('login'));
+    $this->get(route('entity.switcher'))->assertRedirect(route('login'));
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+});
+
+test('unverified users are sent to email verification instead of the entity pages', function () {
+    $user = User::factory()->unverified()->create();
+    $entity = joinEntity($user);
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('verification.notice'));
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))->assertRedirect(route('verification.notice'));
+    $this->actingAs($user)->get(route('entity.switcher'))->assertRedirect(route('verification.notice'));
+});
+
+test('home sends a user with no entity to onboarding', function () {
+    $user = verifiedUser();
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('onboarding'));
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('home with exactly one entity sets the session and opens that dashboard', function (UserRole $role) {
+    $user = verifiedUser();
+    $entity = joinEntity($user, $role);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity));
+})->with([
+    'owner' => [UserRole::Owner],
+    'admin' => [UserRole::Admin],
+    'employee' => [UserRole::Employee],
+]);
+
+test('home with exactly one entity remembers it in the session', function () {
+    $user = verifiedUser();
+    $entity = joinEntity($user);
+
