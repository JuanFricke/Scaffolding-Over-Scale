+namespace App\Tenancy;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+
+/**
+ * The entity this request works in. The current_entity middleware resolves it from the
+ * session; code below the HTTP layer asks this object instead of reading the session.
+ */
+class CurrentEntity
+{
+    private ?EntityMembership $membership = null;
+
+    public function set(EntityMembership $membership): void
+    {
+        $this->membership = $membership;
+    }
+
+    public function membership(): ?EntityMembership
+    {
+        return $this->membership;
+    }
+
+    public function entity(): ?Entity
+    {
+        return $this->membership?->entity;
+    }
+}
