+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Any authenticated user may open a new entity; they become its owner.
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    public function view(User $user, Entity $entity): bool
+    {
+        return $user->membershipFor($entity->id) !== null;
+    }
+
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->hasRole($user, $entity, [UserRole::Owner, UserRole::Admin]);
+    }
+
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->hasRole($user, $entity, [UserRole::Owner, UserRole::Admin]);
+    }
+
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $this->hasRole($user, $entity, [UserRole::Owner]);
+    }
+
+    /**
+     * @param  list<UserRole>  $roles
+     */
+    private function hasRole(User $user, Entity $entity, array $roles): bool
+    {
+        $membership = $user->membershipFor($entity->id);
+
+        return $membership !== null && in_array($membership->role, $roles, true);
+    }
+}
