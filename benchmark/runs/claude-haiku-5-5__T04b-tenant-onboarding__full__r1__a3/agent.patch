+uses(RefreshDatabase::class);
+
+/** Simulates a concurrent insert: the first slug handed out is one another request already took. */
+class CollidingSlugCreateEntity extends CreateEntity
+{
+    public static int $calls = 0;
+
+    protected function uniqueSlug(string $name): string
+    {
+        return ++static::$calls === 1 ? 'acme-corp' : parent::uniqueSlug($name);
+    }
+}
+
+/** Every attempt collides, so the component must give up instead of looping forever. */
+class AlwaysCollidingSlugCreateEntity extends CreateEntity
+{
+    protected function uniqueSlug(string $name): string
+    {
+        return 'acme-corp';
+    }
+}
+
+beforeEach(function () {
+    $this->user = User::factory()->create();
+});
+
+test('the onboarding page renders its title, heading and a labelled name field', function () {
