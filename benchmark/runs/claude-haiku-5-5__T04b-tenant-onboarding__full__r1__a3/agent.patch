@@ -0,0 +1,36 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+class CreateEntityWithOwner
+{
+    /**
+     * Create an entity and make the creator its owner, in one transaction.
+     *
+     * Throws UniqueConstraintViolationException when another request took the slug after the
+     * caller checked it; the caller then picks a fresh slug and calls again.
+     */
+    public function handle(User $creator, string $name, string $slug): Entity
+    {
+        Gate::forUser($creator)->authorize('create', Entity::class);
+
+        return DB::transaction(function () use ($creator, $name, $slug) {
+            $entity = Entity::create(['name' => $name, 'slug' => $slug]);
+
+            EntityMembership::create([
+                'entity_id' => $entity->id,
+                'user_id' => $creator->id,
+                'role' => UserRole::Owner,
+            ]);
+
+            return $entity;
+        });
+    }
+}
