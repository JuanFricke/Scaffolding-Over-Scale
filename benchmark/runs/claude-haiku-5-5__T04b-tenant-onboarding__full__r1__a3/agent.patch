+    $audit = Mockery::spy();
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    Livewire::actingAs($this->user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', 'acme-corp'));
+
+    $entity = Entity::query()->sole();
+    $membership = EntityMembership::query()->sole();
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->slug)->toBe('acme-corp')
+        ->and($membership->entity_id)->toBe($entity->id)
+        ->and($membership->user_id)->toBe($this->user->id)
+        ->and($membership->role)->toBe(UserRole::Owner)
+        ->and(session('current_entity_id'))->toBe($entity->id);
+
+    $audit->shouldHaveReceived('info')->with('Entity created', [
+        'entity_id' => $entity->id,
+        'actor_id' => $this->user->id,
+    ])->once();
+});
+
+test('the name is required', function () {
