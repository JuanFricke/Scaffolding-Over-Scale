+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Crie sua entidade')
+        ->assertSee('Crie sua empresa')
+        ->assertSee('for="name"', false)
+        ->assertSee('wire:model="name"', false);
+});
+
+test('the onboarding page is in English when the locale is English', function () {
+    app()->setLocale('en');
+
+    $this->actingAs($this->user)
+        ->get(route('onboarding'))
+        ->assertSee('Create your entity')
+        ->assertSee('Create your company');
+});
+
