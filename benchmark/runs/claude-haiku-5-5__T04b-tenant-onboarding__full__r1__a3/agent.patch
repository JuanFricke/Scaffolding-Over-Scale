+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,52 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Owners and admins assign roles, but never to the owner membership: ownership
+     * moves only through a transfer, not through a role change.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->actorHasRole($user, $membership, [UserRole::Owner, UserRole::Admin])
+            && in_array($membership->role, UserRole::manageable(), true);
+    }
+
+    /**
+     * The owner membership can never be deleted. Anyone may remove their own
+     * membership, and owners and admins may remove the others.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->actorHasRole($user, $membership, [UserRole::Owner, UserRole::Admin]);
+    }
+
+    /**
+     * @param  list<UserRole>  $roles
+     */
+    private function actorHasRole(User $user, EntityMembership $membership, array $roles): bool
+    {
+        $actor = $user->membershipFor($membership->entity_id);
+
+        return $actor !== null && in_array($actor->role, $roles, true);
+    }
+}
