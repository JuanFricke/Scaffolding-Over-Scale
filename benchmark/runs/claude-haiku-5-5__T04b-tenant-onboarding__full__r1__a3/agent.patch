@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Tenancy\CurrentEntity;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class ResolveCurrentEntity
+{
+    /**
+     * Resolve the session's entity into the request's tenant context.
+     *
+     * With no entity in the session, the user's entities decide where they go: none means
+     * onboarding, several means the switcher, and exactly one is chosen for them.
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        if ($request->session()->get('current_entity_id') === null) {
+            $entities = $user->entities()->get();
+
+            if ($entities->isEmpty()) {
+                return redirect()->route('onboarding');
+            }
+
+            if ($entities->count() > 1) {
+                return redirect()->route('entity.switcher');
+            }
+
+            $request->session()->put('current_entity_id', $entities->first()->id);
+        }
+
+        $membership = $user->membershipFor((int) $request->session()->get('current_entity_id'));
+        abort_if($membership === null, 403);
+
+        app(CurrentEntity::class)->set($membership);
+
+        return $next($request);
+    }
+}
diff --git a/app/Livewire/Entity/CreateEntity.php b/app/Livewire/Entity/CreateEntity.php
new file mode 100644
index 0000000..71f634d
--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,94 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateEntityWithOwner;
+use App\Models\Entity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class CreateEntity extends Component
+{
+    /** How many times to look for a free slug when concurrent requests keep taking them. */
+    private const MAX_SLUG_ATTEMPTS = 5;
+
+    /** Slugs that are routes (/e/switcher), so no entity may take them. */
+    private const RESERVED_SLUGS = ['switcher'];
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $validated = $this->validate();
+
+        $throttleKey = 'create-entity|'.auth()->id();
+
+        if (RateLimiter::tooManyAttempts($throttleKey, 10)) {
+            throw ValidationException::withMessages(['name' => __('ui.too_many_entities')]);
+        }
+
+        RateLimiter::hit($throttleKey, 60);
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                $entity = app(CreateEntityWithOwner::class)->handle(
+                    auth()->user(),
+                    $validated['name'],
+                    $this->uniqueSlug($validated['name']),
+                );
+
+                break;
+            } catch (UniqueConstraintViolationException $exception) {
+                // Another request inserted this slug after uniqueSlug() checked it. Ask again.
+                if ($attempt === self::MAX_SLUG_ATTEMPTS) {
+                    throw $exception;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => auth()->id(),
+        ]);
+
+        session()->put('current_entity_id', $entity->id);
+
+        $this->redirect(route('entity.dashboard', $entity));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->title(__('ui.onboarding_title'));
+    }
+
+    /**
+     * A slug from the name that no entity uses, soft-deleted ones included (their slugs stay
+     * reserved). Overridable so tests can simulate a slug taken between check and insert.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name) ?: 'entity';
+        $slug = $base;
+
+        for ($suffix = 2; $this->slugTaken($slug); $suffix++) {
+            $slug = "{$base}-{$suffix}";
+        }
+
+        return $slug;
+    }
+
+    private function slugTaken(string $slug): bool
+    {
+        return in_array($slug, self::RESERVED_SLUGS, true)
+            || Entity::withTrashed()->where('slug', $slug)->exists();
+    }
+}
