@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    public function __invoke(Queue $queue, User $actor, ?string $name = null, ?string $slug = null, ?bool $isActive = null): Queue
+    {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $data = [];
+
+        if ($name !== null) {
+            $trimmed = trim($name);
+
+            if ($trimmed === '' || mb_strlen($trimmed) > 255) {
+                throw ValidationException::withMessages(['name' => 'The name must be between 1 and 255 characters.']);
+            }
+
+            $data['name'] = $trimmed;
+        }
+
+        if ($slug !== null) {
+            $slugified = Str::slug($slug);
+
+            if ($slugified === '' || strlen($slugified) > 255) {
+                throw ValidationException::withMessages(['slug' => 'The slug must be between 1 and 255 characters.']);
+            }
+
+            if (Queue::query()
+                ->where('entity_id', $queue->entity_id)
+                ->where('slug', $slugified)
+                ->whereKeyNot($queue->id)
+                ->exists()) {
+                throw ValidationException::withMessages(['slug' => 'The slug is already in use in this entity.']);
+            }
+
+            $data['slug'] = $slugified;
+        }
+
+        if ($isActive !== null) {
+            $data['is_active'] = $isActive;
+        }
+
+        if ($data === []) {
+            return $queue;
+        }
+
+        try {
+            $queue->update($data);
+        } catch (QueryException $e) {
+            if (self::isUniqueViolation($e)) {
+                throw ValidationException::withMessages(['slug' => 'The slug is already in use in this entity.']);
+            }
+
+            throw $e;
+        }
+
+        return $queue->refresh();
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
