diff --git a/app/Policies/QueuePolicy.php b/app/Policies/QueuePolicy.php
new file mode 100644
index 0000000..931eae9
--- /dev/null
+++ b/app/Policies/QueuePolicy.php
@@ -0,0 +1,95 @@
+<?php
+
+namespace App\Policies;
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Throwable;
+
+class QueuePolicy
+{
+    /**
+     * Determine whether the user can create a queue in the given entity (owner/admin).
+     */
+    public function create(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity->id);
+    }
+
+    /**
+     * Determine whether the user can update the queue (owner/admin of its entity).
+     */
+    public function update(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, $queue->entity_id);
+    }
+
+    /**
+     * Determine whether the user can manage per-queue access grants (owner/admin).
+     */
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, $queue->entity_id);
+    }
+
+    /**
+     * Determine whether the user can call tickets on the queue.
+     *
+     * Owner/admin of the queue's entity always; an employee only with a
+     * queue_access row for that queue whose permissions contain 'call'.
+     * A corrupted non-array value denies.
+     */
+    public function call(User $user, Queue $queue): bool
+    {
+        $membership = $user->membershipFor($queue->entity_id);
+
+        if (! $membership) {
+            return false;
+        }
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            return true;
+        }
+
+        // Read the raw stored value and decode defensively so a corrupted
+        // non-array payload denies instead of raising.
+        $raw = QueueAccess::query()
+            ->where('entity_membership_id', $membership->id)
+            ->where('queue_id', $queue->id)
+            ->value('permissions');
+
+        if ($raw === null) {
+            return false;
+        }
+
+        if (is_array($raw)) {
+            $permissions = $raw;
+        } elseif (is_string($raw)) {
+            try {
+                $permissions = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
+            } catch (Throwable) {
+                return false;
+            }
+        } else {
+            return false;
+        }
+
+        if (! is_array($permissions)) {
+            return false;
+        }
+
+        return in_array(QueuePermission::Call->value, $permissions, true);
+    }
+
+    protected function isManager(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
