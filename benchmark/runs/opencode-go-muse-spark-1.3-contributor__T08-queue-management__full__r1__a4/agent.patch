diff --git a/tests/Feature/QueueManagementTest.php b/tests/Feature/QueueManagementTest.php
new file mode 100644
index 0000000..8b81d11
--- /dev/null
+++ b/tests/Feature/QueueManagementTest.php
@@ -0,0 +1,282 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\CreateQueue;
+use App\Actions\IssueTicket;
+use App\Actions\SetQueueAccess;
+use App\Actions\UpdateQueue;
+use App\Enums\CallMode;
+use App\Enums\QueuePermission;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Psr\Log\LoggerInterface;
+
+uses(RefreshDatabase::class);
+
+function queueScenario(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $outsider = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    return compact('entity', 'owner', 'admin', 'employee', 'outsider', 'membership');
+}
+
+it('creates a queue with a slugified default slug', function () {
+    ['entity' => $entity, 'owner' => $owner] = queueScenario();
+
+    $queue = (new CreateQueue)($entity, $owner, '  Atendimento Geral  ');
+
+    expect($queue->name)->toBe('Atendimento Geral')
+        ->and($queue->slug)->toBe('atendimento-geral')
+        ->and($queue->is_active)->toBeTrue()
+        ->and($queue->entity_id)->toBe($entity->id);
+});
+
+it('slugifies an explicit slug and rejects blank or oversized names', function () {
+    ['entity' => $entity, 'owner' => $owner] = queueScenario();
+
+    $queue = (new CreateQueue)($entity, $owner, 'Normal', ' Prioridades Especiais! ');
+
+    expect($queue->slug)->toBe('prioridades-especiais');
+
+    expect(fn () => (new CreateQueue)($entity, $owner, '   '))->toThrow(ValidationException::class);
+    expect(fn () => (new CreateQueue)($entity, $owner, str_repeat('a', 256)))->toThrow(ValidationException::class);
+    expect(fn () => (new CreateQueue)($entity, $owner, '!!!'))->toThrow(ValidationException::class);
+});
+
+it('rejects duplicate slugs within an entity but allows them across entities', function () {
+    ['entity' => $entity, 'owner' => $owner] = queueScenario();
+
+    (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+
+    expect(fn () => (new CreateQueue)($entity, $owner, 'atendimento geral'))->toThrow(ValidationException::class);
+
+    $other = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($other)->for($otherOwner)->owner()->create();
+
+    $queue = (new CreateQueue)($other, $otherOwner, 'Atendimento Geral');
+
+    expect($queue->slug)->toBe('atendimento-geral');
+});
+
+it('rejects queue creation from employees, outsiders, and other entities without writing', function () {
+    ['entity' => $entity, 'employee' => $employee, 'outsider' => $outsider] = queueScenario();
+    $foreign = User::factory()->create();
+    EntityMembership::factory()->for(Entity::factory()->create())->for($foreign)->admin()->create();
+
+    expect(fn () => (new CreateQueue)($entity, $employee, 'X'))->toThrow(AuthorizationException::class);
+    expect(fn () => (new CreateQueue)($entity, $outsider, 'X'))->toThrow(AuthorizationException::class);
+    expect(fn () => (new CreateQueue)($entity, $foreign, 'X'))->toThrow(AuthorizationException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+});
+
+it('updates any combination of name, slug, and active flag', function () {
+    ['entity' => $entity, 'owner' => $owner] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Alpha');
+
+    $updated = (new UpdateQueue)($queue, $owner, name: 'Alpha 2', slug: 'alpha-2', isActive: false);
+
+    expect($updated->name)->toBe('Alpha 2')
+        ->and($updated->slug)->toBe('alpha-2')
+        ->and($updated->is_active)->toBeFalse();
+
+    $untouched = (new UpdateQueue)($updated->fresh(), $owner);
+
+    expect($untouched->name)->toBe('Alpha 2')->and($untouched->is_active)->toBeFalse();
+});
+
+it('allows keeping the own slug but rejects taking another queue slug', function () {
+    ['entity' => $entity, 'owner' => $owner] = queueScenario();
+    $alpha = (new CreateQueue)($entity, $owner, 'Alpha');
+    (new CreateQueue)($entity, $owner, 'Beta');
+
+    expect((new UpdateQueue)($alpha, $owner, slug: 'alpha')->slug)->toBe('alpha');
+    expect(fn () => (new UpdateQueue)($alpha, $owner, slug: 'beta'))->toThrow(ValidationException::class);
+    expect(fn () => (new UpdateQueue)($alpha, $owner, name: '   '))->toThrow(ValidationException::class);
+});
+
+it('rejects queue updates from employees and outsiders', function () {
+    ['entity' => $entity, 'owner' => $owner, 'employee' => $employee, 'outsider' => $outsider] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Alpha');
+
+    expect(fn () => (new UpdateQueue)($queue, $employee, name: 'Nope'))->toThrow(AuthorizationException::class);
+    expect(fn () => (new UpdateQueue)($queue, $outsider, isActive: false))->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->name)->toBe('Alpha')->and($queue->fresh()->is_active)->toBeTrue();
+});
+
+it('deactivation preserves tickets and blocks issuing and calling', function () {
+    ['entity' => $entity, 'owner' => $owner] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+    $ticket = (new IssueTicket)($queue);
+
+    (new UpdateQueue)($queue, $owner, isActive: false);
+    $queue = $queue->fresh();
+
+    expect($ticket->fresh()->exists())->toBeTrue();
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+    expect(fn () => (new CallNextTicket)($queue, $owner))->toThrow(InactiveQueueException::class);
+    expect(fn () => $ticket->fresh()->call($owner))->toThrow(InactiveQueueException::class);
+});
+
+it('authorizes queue policy abilities by role and grant', function () {
+    ['entity' => $entity, 'owner' => $owner, 'admin' => $admin, 'employee' => $employee, 'outsider' => $outsider, 'membership' => $membership] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+
+    expect(Gate::forUser($owner)->allows('create', [Queue::class, $entity]))->toBeTrue();
+    expect(Gate::forUser($admin)->allows('create', [Queue::class, $entity]))->toBeTrue();
+    expect(Gate::forUser($employee)->allows('create', [Queue::class, $entity]))->toBeFalse();
+    expect(Gate::forUser($outsider)->allows('create', [Queue::class, $entity]))->toBeFalse();
+
+    expect(Gate::forUser($owner)->allows('update', $queue))->toBeTrue();
+    expect(Gate::forUser($admin)->allows('update', $queue))->toBeTrue();
+    expect(Gate::forUser($employee)->allows('update', $queue))->toBeFalse();
+
+    expect(Gate::forUser($owner)->allows('manageAccess', $queue))->toBeTrue();
+    expect(Gate::forUser($employee)->allows('manageAccess', $queue))->toBeFalse();
+
+    expect(Gate::forUser($owner)->allows('call', $queue))->toBeTrue();
+    expect(Gate::forUser($admin)->allows('call', $queue))->toBeTrue();
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+    expect(Gate::forUser($outsider)->allows('call', $queue))->toBeFalse();
+
+    (new SetQueueAccess)($membership, $queue, $owner, ['call']);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeTrue();
+    expect(Gate::forUser($outsider)->allows('call', $queue))->toBeFalse();
+});
+
+it('denies calls on corrupted non-array permissions', function () {
+    ['entity' => $entity, 'owner' => $owner, 'employee' => $employee, 'membership' => $membership] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+    (new SetQueueAccess)($membership, $queue, $owner, ['call']);
+
+    DB::table('queue_access')->where('queue_id', $queue->id)->update(['permissions' => '"call"']);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+});
+
+it('grants and revokes per-queue access with an audit trail', function () {
+    ['entity' => $entity, 'owner' => $owner, 'membership' => $membership] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+
+    $audit = Mockery::mock(LoggerInterface::class);
+    $audit->shouldReceive('info')->once()->with('queue.access.granted', Mockery::on(
+        fn ($context) => $context['actor_id'] === $owner->id
+            && $context['queue_id'] === $queue->id
+            && $context['entity_membership_id'] === $membership->id
+    ));
+    $audit->shouldReceive('info')->once()->with('queue.access.revoked', Mockery::on(
+        fn ($context) => $context['actor_id'] === $owner->id
+            && $context['queue_id'] === $queue->id
+            && $context['entity_membership_id'] === $membership->id
+    ));
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    (new SetQueueAccess)($membership, $queue, $owner, ['call']);
+
+    expect(QueueAccess::query()->count())->toBe(1)
+        ->and(QueueAccess::first()->permissions)->toBe(['call']);
+
+    (new SetQueueAccess)($membership, $queue, $owner, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('does not log a revoke when there is no grant row', function () {
+    ['entity' => $entity, 'owner' => $owner, 'membership' => $membership] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+
+    $audit = Mockery::mock(LoggerInterface::class);
+    $audit->shouldReceive('info')->never();
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    (new SetQueueAccess)($membership, $queue, $owner, []);
+});
+
+it('rejects invalid, cross-entity, and self-granted access changes without writing', function () {
+    ['entity' => $entity, 'owner' => $owner, 'employee' => $employee, 'membership' => $membership] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $owner, ['bogus']))->toThrow(ValidationException::class);
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $owner, [42]))->toThrow(ValidationException::class);
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $employee, ['call']))->toThrow(AuthorizationException::class);
+
+    $other = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($other)->for($otherOwner)->owner()->create();
+    $otherQueue = Queue::factory()->for($other)->create();
+
+    expect(fn () => (new SetQueueAccess)($membership, $otherQueue, $otherOwner, ['call']))->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('rejects unauthorized calls in every mode without changing tickets', function () {
+    ['entity' => $entity, 'owner' => $owner, 'outsider' => $outsider] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+    (new IssueTicket)($queue, 10);
+    (new IssueTicket)($queue, 0);
+
+    foreach ([CallMode::Any, CallMode::PriorityOnly, CallMode::NormalOnly] as $mode) {
+        expect(fn () => (new CallNextTicket)($queue, $outsider, $mode))->toThrow(AuthorizationException::class);
+    }
+
+    expect(Ticket::query()->where('status', TicketStatus::Waiting)->count())->toBe(2);
+});
+
+it('lets a granted employee call while the grant lasts', function () {
+    ['entity' => $entity, 'owner' => $owner, 'employee' => $employee, 'membership' => $membership] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+    $ticket = (new IssueTicket)($queue);
+
+    expect(fn () => $ticket->call($employee))->toThrow(AuthorizationException::class);
+
+    (new SetQueueAccess)($membership, $queue, $owner, ['call']);
+
+    $ticket->fresh()->call($employee);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->fresh()->called_by_user_id)->toBe($employee->id);
+});
+
+it('authorizes ticket calls before the waiting check', function () {
+    ['entity' => $entity, 'owner' => $owner, 'outsider' => $outsider] = queueScenario();
+    $queue = (new CreateQueue)($entity, $owner, 'Q1');
+    $ticket = (new IssueTicket)($queue);
+    $ticket->call($owner);
+
+    expect(fn () => $ticket->fresh()->call($outsider))->toThrow(AuthorizationException::class);
+});
+
+it('defaults queue access factory to a call grant in one entity', function () {
+    $grant = QueueAccess::factory()->create();
+
+    expect($grant->permissions)->toBe([QueuePermission::Call->value])
+        ->and($grant->membership->entity_id)->toBe($grant->queue->entity_id);
+});
+
+it('exposes exactly one queue permission', function () {
+    expect(QueuePermission::cases())->toHaveCount(1)
+        ->and(QueuePermission::Call->value)->toBe('call');
+});
