+<?php
+
+namespace App\Tenancy;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Http\RedirectResponse;
+
+/**
+ * The entity the authenticated user is working in during this request.
+ *
+ * Bound as a scoped singleton and filled by the `current_entity` middleware, the
+ * only place that reads `session('current_entity_id')`; everything below the HTTP
+ * layer receives the tenant from here instead of touching the session.
+ */
+class CurrentEntity
+{
+    public const SESSION_KEY = 'current_entity_id';
+
+    private ?Entity $entity = null;
+
+    private ?EntityMembership $membership = null;
+
+    public function set(Entity $entity, EntityMembership $membership): void
+    {
+        $this->entity = $entity;
+        $this->membership = $membership;
+    }
+
+    public function entity(): ?Entity
+    {
+        return $this->entity;
+    }
+
+    public function membership(): ?EntityMembership
+    {
+        return $this->membership;
+    }
+
+    public function role(): ?UserRole
+    {
+        return $this->membership?->role;
+    }
+
+    /**
+     * Pick where a user without a (valid) session entity goes: the only entity they
+     * belong to (remembered in the session), onboarding or the switcher.
+     */
+    public function dispatch(User $user): Entity|RedirectResponse
+    {
+        $entities = $user->entities()->get();
+
+        if ($entities->count() === 1) {
+            $this->remember($entities->first());
+
+            return $entities->first();
+        }
+
+        return redirect()->route($entities->isEmpty() ? 'onboarding' : 'entity.switcher');
+    }
+
+    public function remember(Entity $entity): void
+    {
+        session()->put(self::SESSION_KEY, $entity->id);
+    }
+}
