+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+
+class HomeController extends Controller
+{
+    /**
+     * Send the user to the entity they are working in, or to onboarding / the switcher.
+     */
+    public function __invoke(Request $request, CurrentEntity $current): RedirectResponse
+    {
+        $user = $request->user();
+        $sessionEntityId = $request->session()->get(CurrentEntity::SESSION_KEY);
+
+        // Honor the session entity only while the user still belongs to it.
+        $entity = $sessionEntityId === null
+            ? null
+            : $user->entities()->whereKey($sessionEntityId)->first();
+
+        $entity ??= $current->dispatch($user);
+
+        return $entity instanceof Entity
+            ? redirect()->route('entity.dashboard', $entity)
+            : $entity;
+    }
+}
