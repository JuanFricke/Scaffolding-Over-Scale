diff --git a/tests/Feature/EntityDataModelTest.php b/tests/Feature/EntityDataModelTest.php
new file mode 100644
index 0000000..d1709d0
--- /dev/null
+++ b/tests/Feature/EntityDataModelTest.php
@@ -0,0 +1,185 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'role' => $role,
+    ]);
+
+    return $user;
+}
+
+test('entities are bound by slug and soft deleted', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect($entity->getRouteKeyName())->toBe('slug');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('entity slugs are unique through the named index', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    $indexes = collect(Schema::getIndexes('entities'))->pluck('name');
+    expect($indexes)->toContain('entities_slug_unique');
+});
+
+test('the membership role defaults to employee and is cast to the enum', function () {
+    $membership = EntityMembership::factory()->create()->refresh();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+
+    $bare = EntityMembership::create([
+        'entity_id' => Entity::factory()->create()->id,
+        'user_id' => User::factory()->create()->id,
+    ])->refresh();
+
+    expect($bare->role)->toBe(UserRole::Employee);
+});
+
+test('the database allows a user only one membership per entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the database rejects a second owner but allows many admins and employees', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->count(2)->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(2)->create(['entity_id' => $entity->id]);
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    // Promoting a member in place is rejected too, and another entity may have its own owner.
+    $admin = $entity->memberships()->admin()->first();
+    expect(fn () => $admin->update(['role' => UserRole::Owner]))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    EntityMembership::factory()->owner()->create();
+
+    expect(Entity::count())->toBe(2);
+});
+
+test('memberships are removed with their entity or user', function () {
+    $membership = EntityMembership::factory()->create();
+    $membership->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+
+    $other = EntityMembership::factory()->create();
+    $other->entity()->forceDelete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('role scopes, relations and helpers work', function () {
+    $entity = Entity::factory()->create();
+    $owner = memberOf($entity, UserRole::Owner);
+    memberOf($entity, UserRole::Admin);
+    memberOf($entity, UserRole::Employee);
+
+    expect($entity->memberships)->toHaveCount(3)
+        ->and($entity->users)->toHaveCount(3)
+        ->and($entity->owner()->first()->user_id)->toBe($owner->id)
+        ->and($entity->owner->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(1)
+        ->and(EntityMembership::owner()->count())->toBe(1)
+        ->and($owner->memberships)->toHaveCount(1)
+        ->and($owner->entities->first()->is($entity))->toBeTrue()
+        ->and($owner->membershipFor($entity->id)->role)->toBe(UserRole::Owner)
+        ->and($owner->membershipFor($entity->id + 1))->toBeNull()
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('entity policy follows the role matrix', function () {
+    $entity = Entity::factory()->create();
+    $owner = memberOf($entity, UserRole::Owner);
+    $admin = memberOf($entity, UserRole::Admin);
+    $employee = memberOf($entity, UserRole::Employee);
+    $outsider = User::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->create($outsider))->toBeTrue()
+        ->and($policy->view($owner, $entity))->toBeTrue()
+        ->and($policy->view($employee, $entity))->toBeTrue()
+        ->and($policy->view($outsider, $entity))->toBeFalse()
+        ->and($policy->update($owner, $entity))->toBeTrue()
+        ->and($policy->update($admin, $entity))->toBeTrue()
+        ->and($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->update($outsider, $entity))->toBeFalse()
+        ->and($policy->delete($owner, $entity))->toBeTrue()
+        ->and($policy->delete($admin, $entity))->toBeTrue()
+        ->and($policy->delete($employee, $entity))->toBeFalse()
+        ->and($policy->delete($outsider, $entity))->toBeFalse()
+        ->and($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse()
+        ->and($policy->manageSettings($employee, $entity))->toBeFalse()
+        ->and($policy->manageSettings($outsider, $entity))->toBeFalse();
+});
+
+test('entity policy is discovered by the gate', function () {
+    $entity = Entity::factory()->create();
+    $admin = memberOf($entity, UserRole::Admin);
+
+    expect($admin->can('update', $entity))->toBeTrue()
+        ->and($admin->can('manageSettings', $entity))->toBeFalse()
+        ->and($admin->can('create', Entity::class))->toBeTrue();
+});
+
+test('membership policy follows the role matrix', function () {
+    $entity = Entity::factory()->create();
+    $owner = memberOf($entity, UserRole::Owner);
+    $admin = memberOf($entity, UserRole::Admin);
+    $employee = memberOf($entity, UserRole::Employee);
+    $otherEmployee = memberOf($entity, UserRole::Employee);
+    $outsider = User::factory()->create();
+    $policy = new EntityMembershipPolicy;
+
+    $of = fn (User $user) => $user->membershipFor($entity->id);
+
+    expect($policy->view($employee, $of($owner)))->toBeTrue()
+        ->and($policy->view($outsider, $of($owner)))->toBeFalse()
+        ->and($policy->assignRole($owner, $of($employee)))->toBeTrue()
+        ->and($policy->assignRole($admin, $of($employee)))->toBeTrue()
+        ->and($policy->assignRole($employee, $of($otherEmployee)))->toBeFalse()
+        ->and($policy->assignRole($outsider, $of($employee)))->toBeFalse()
+        // The owner's membership can never be deleted, not even by the owner themself.
+        ->and($policy->delete($owner, $of($owner)))->toBeFalse()
+        ->and($policy->delete($admin, $of($owner)))->toBeFalse()
+        // Self-removal is always allowed (except for the owner).
+        ->and($policy->delete($employee, $of($employee)))->toBeTrue()
+        ->and($policy->delete($admin, $of($admin)))->toBeTrue()
+        ->and($policy->delete($owner, $of($employee)))->toBeTrue()
+        ->and($policy->delete($admin, $of($employee)))->toBeTrue()
+        ->and($policy->delete($employee, $of($otherEmployee)))->toBeFalse()
+        ->and($policy->delete($outsider, $of($employee)))->toBeFalse();
+});
diff --git a/tests/Feature/EntityTenantTest.php b/tests/Feature/EntityTenantTest.php
new file mode 100644
index 0000000..dc0b5a0
--- /dev/null
+++ b/tests/Feature/EntityTenantTest.php
@@ -0,0 +1,401 @@
+<?php
+
+use App\Http\Middleware\ResolveCurrentEntity;
+use App\Livewire\Entity\CreateEntity;
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Route;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function userIn(int $count): array
+{
+    $user = User::factory()->create();
+    $entities = Entity::factory()->count($count)->create();
+    $entities->each(fn (Entity $e) => EntityMembership::factory()->create(['entity_id' => $e->id, 'user_id' => $user->id]));
+
+    return [$user, ...$entities->all()];
+}
+
+// --- Routes & access ---------------------------------------------------------------
+
+test('guests are redirected to login from every new page', function () {
+    $entity = Entity::factory()->create();
+
+    foreach ([
+        ['get', route('onboarding')],
+        ['get', route('entity.switcher')],
+        ['get', route('entity.dashboard', $entity)],
+        ['post', route('entity.pick', $entity)],
+    ] as [$method, $url]) {
+        $this->$method($url)->assertRedirect(route('login'));
+    }
+});
+
+test('unverified users are sent to the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+    $entity = Entity::factory()->create();
+
+    foreach ([route('onboarding'), route('entity.switcher'), route('entity.dashboard', $entity), route('home')] as $url) {
+        $this->actingAs($user)->get($url)->assertRedirect(route('verification.notice'));
+    }
+});
+
+test('routes use the documented paths and bind entities by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect(route('onboarding', absolute: false))->toBe('/onboarding')
+        ->and(route('entity.switcher', absolute: false))->toBe('/e/switcher')
+        ->and(route('entity.pick', $entity, false))->toBe('/e/acme/pick')
+        ->and(route('entity.dashboard', $entity, false))->toBe('/e/acme');
+});
+
+// --- /home dispatch ------------------------------------------------------------------
+
+test('home sends a user without memberships to onboarding', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('home sets the session and opens the dashboard of the only entity, whatever the role', function (UserRole $role) {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $user->id, 'role' => $role]);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+})->with([UserRole::Owner, UserRole::Admin, UserRole::Employee]);
+
+test('home sends a user with several entities to the switcher', function () {
+    [$user] = userIn(2);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.switcher'))
+        ->assertSessionMissing('current_entity_id');
+});
+
+test('home goes to the session entity while the user still belongs to it', function () {
+    [$user, $a, $b] = userIn(2);
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $b->id])
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $b));
+
+    $foreign = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $foreign->id])
+        ->get(route('home'))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+// --- current_entity middleware -------------------------------------------------------
+
+test('the current_entity middleware builds the tenant context from the session', function () {
+    Route::get('/_tenant-probe', fn (CurrentEntity $current) => response()->json([
+        'entity' => $current->entity()?->id,
+        'role' => $current->role()?->value,
+    ]))->middleware(['web', 'auth', 'current_entity']);
+
+    [$user, $a, $b] = userIn(2);
+    EntityMembership::where('entity_id', $b->id)->update(['role' => 'admin']);
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $b->id])
+        ->getJson('/_tenant-probe')
+        ->assertOk()
+        ->assertExactJson(['entity' => $b->id, 'role' => 'admin']);
+});
+
+test('the current_entity middleware aborts 403 for a session entity the user is not in', function () {
+    Route::get('/_tenant-probe', fn () => 'ok')->middleware(['web', 'auth', 'current_entity']);
+
+    [$user] = userIn(1);
+    $foreign = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $foreign->id])
+        ->get('/_tenant-probe')
+        ->assertForbidden();
+});
+
+test('the current_entity middleware dispatches on an empty session', function () {
+    Route::get('/_tenant-probe', fn () => 'ok')->middleware(['web', 'auth', 'current_entity']);
+
+    $this->actingAs(User::factory()->create())->get('/_tenant-probe')->assertRedirect(route('onboarding'));
+
+    [$one, $entity] = userIn(1);
+    $this->flushSession();
+    $this->actingAs($one)->get('/_tenant-probe')
+        ->assertOk()
+        ->assertSessionHas('current_entity_id', $entity->id);
+
+    [$many] = userIn(2);
+    $this->flushSession();
+    $this->actingAs($many)->get('/_tenant-probe')->assertRedirect(route('entity.switcher'));
+});
+
+test('a deleted session entity is dropped instead of locking the user out', function () {
+    [$user, $a, $b] = userIn(2);
+    $a->delete();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $a->id])
+        ->get(route('entity.dashboard', $b))
+        ->assertOk()
+        ->assertSessionHas('current_entity_id', $b->id);
+});
+
+test('the tenant middleware is persistent for Livewire update requests', function () {
+    expect(Livewire::getPersistentMiddleware())->toContain(ResolveCurrentEntity::class);
+});
+
+// --- Pick ----------------------------------------------------------------------------
+
+test('picking an entity sets the session, writes an audit line and opens the dashboard', function () {
+    Event::fake([MessageLogged::class]);
+    [$user, $a, $b] = userIn(2);
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $b))
+        ->assertRedirect(route('entity.dashboard', $b))
+        ->assertSessionHas('current_entity_id', $b->id);
+
+    Event::assertDispatched(MessageLogged::class, fn ($log) => $log->message === 'Entity picked'
+        && $log->context === ['entity_id' => $b->id, 'actor_id' => $user->id]);
+});
+
+test('picking an entity the user does not belong to is forbidden and leaves the session alone', function () {
+    [$user, $a] = userIn(1);
+    $foreign = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $a->id])
+        ->post(route('entity.pick', $foreign))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $a->id);
+
+    $this->flushSession();
+    $this->actingAs($user)
+        ->post(route('entity.pick', $foreign))
+        ->assertForbidden()
+        ->assertSessionMissing('current_entity_id');
+});
+
+// --- Switcher ------------------------------------------------------------------------
+
+test('the switcher lists only the user entities and marks the current one', function () {
+    [$user, $a, $b] = userIn(2);
+    $foreign = Entity::factory()->create(['name' => 'Foreign Inc']);
+
+    $html = $this->actingAs($user)->withSession(['current_entity_id' => $b->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Trocar de entidade')
+        ->assertSee(e($a->name), false)
+        ->assertSee(e($b->name), false)
+        ->assertDontSee('Foreign Inc')
+        ->assertSee('action="'.route('entity.pick', $a).'"', false)
+        ->assertSee('action="'.route('entity.pick', $b).'"', false)
+        ->assertDontSee(route('entity.pick', $foreign), false)
+        ->getContent();
+
+    expect(substr_count($html, 'data-current="1"'))->toBe(1)
+        ->and(substr_count($html, 'button is-fullwidth is-link'))->toBe(1)
+        ->and(substr_count($html, 'button is-fullwidth is-light'))->toBe(1)
+        ->and($html)->not->toContain('class="tag');
+
+    expect($html)->toMatch('/<button[^>]*is-link[^>]*data-current="1"[^>]*>\s*'.preg_quote(e($b->name), '/').'/');
+});
+
+test('the switcher is translated', function () {
+    [$user] = userIn(2);
+
+    app()->setLocale('en');
+
+    $this->actingAs($user)->get(route('entity.switcher'))->assertSee('Switch entity');
+});
+
+test('the navbar links to the switcher only for users with several entities', function () {
+    [$many] = userIn(2);
+    [$one, $entity] = userIn(1);
+
+    $this->actingAs($many)->get(route('entity.switcher'))
+        ->assertSee('href="'.route('entity.switcher').'"', false);
+
+    $this->actingAs($one)->get(route('entity.dashboard', $entity))
+        ->assertSee($one->name)
+        ->assertDontSee('href="'.route('entity.switcher').'"', false);
+});
+
+// --- Dashboard -----------------------------------------------------------------------
+
+test('the dashboard shows the entity name', function () {
+    [$user, $entity] = userIn(1);
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(e($entity->name), false)
+        ->assertSee('wire:id', false);
+
+    Livewire::actingAs($user)->test(Dashboard::class, ['entity' => $entity])->assertSee($entity->name);
+});
+
+test('the dashboard is forbidden to non-members, even with a session for another entity', function () {
+    [$user, $mine] = userIn(1);
+    $foreign = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.dashboard', $foreign))
+        ->assertForbidden();
+
+    Livewire::actingAs($user)->test(Dashboard::class, ['entity' => $foreign])->assertForbidden();
+});
+
+test('the dashboard entity cannot be tampered with from the client', function () {
+    [$user, $mine] = userIn(1);
+    $foreign = Entity::factory()->create();
+
+    expect(fn () => Livewire::actingAs($user)->test(Dashboard::class, ['entity' => $mine])
+        ->set('entity', $foreign->id))->toThrow(Exception::class);
+});
+
+// --- Onboarding ----------------------------------------------------------------------
+
+test('the onboarding page renders translated texts', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('<title>Crie sua entidade', false)
+        ->assertSee('Crie sua empresa')
+        ->assertSee('wire:model="name"', false);
+
+    app()->setLocale('en');
+
+    $this->actingAs($user)->get(route('onboarding'))
+        ->assertSee('<title>Create your entity', false)
+        ->assertSee('Create your company');
+});
+
+test('onboarding creates the entity with the creator as its owner', function () {
+    Event::fake([MessageLogged::class]);
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', 'acme-corp'));
+
+    $entity = Entity::where('slug', 'acme-corp')->firstOrFail();
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->memberships)->toHaveCount(1)
+        ->and($entity->owner->user_id)->toBe($user->id)
+        ->and(session('current_entity_id'))->toBe($entity->id);
+
+    Event::assertDispatched(MessageLogged::class, fn ($log) => $log->message === 'Entity created'
+        && $log->context === ['entity_id' => $entity->id, 'actor_id' => $user->id]);
+});
+
+test('onboarding validates the name', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', '')->call('submit')->assertHasErrors(['name' => 'required'])
+        ->set('name', '   ')->call('submit')->assertHasErrors(['name' => 'required'])
+        ->set('name', str_repeat('a', 256))->call('submit')->assertHasErrors(['name' => 'max']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('onboarding derives unique slugs, counting deleted entities and reserved words', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme-corp'])->delete();
+    Entity::factory()->create(['slug' => 'acme-corp-2']);
+
+    foreach (['Acme Corp', 'Switcher', 'Ação Ñandú!', '日本'] as $name) {
+        Livewire::actingAs($user)->test(CreateEntity::class)->set('name', $name)->call('submit')->assertHasNoErrors();
+    }
+
+    expect(Entity::pluck('slug')->all())->toContain('acme-corp-3', 'switcher-2', 'acao-nandu', 'entity');
+});
+
+test('onboarding keeps the creator as owner whatever the client sends', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', 'Acme')
+        ->call('submit');
+
+    expect(fn () => Livewire::actingAs($user)->test(CreateEntity::class)->set('role', 'admin'))
+        ->toThrow(Exception::class);
+
+    expect(EntityMembership::owner()->where('user_id', $user->id)->count())->toBe(1);
+});
+
+test('onboarding retries when the slug collides at insert time', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme']);
+
+    $component = new class extends CreateEntity
+    {
+        public int $calls = 0;
+
+        protected function uniqueSlug(string $name): string
+        {
+            // The first answers are stale, as if a concurrent request took them meanwhile.
+            return ['acme', 'acme', 'acme-2'][$this->calls++] ?? 'late';
+        }
+    };
+
+    Livewire::actingAs($user)->test($component::class)
+        ->set('name', 'Acme')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', 'acme-2'));
+
+    expect(Entity::pluck('slug')->all())->toBe(['acme', 'acme-2'])
+        ->and(EntityMembership::count())->toBe(1);
+});
+
+test('onboarding gives up after repeated slug collisions without leaving a half-built entity', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme']);
+
+    $component = new class extends CreateEntity
+    {
+        protected function uniqueSlug(string $name): string
+        {
+            return 'acme';
+        }
+    };
+
+    expect(fn () => Livewire::actingAs($user)->test($component::class)->set('name', 'Acme')->call('submit'))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    expect(Entity::count())->toBe(1)->and(EntityMembership::count())->toBe(0);
+});
+
+test('onboarding is rate limited', function () {
+    $user = User::factory()->create();
+
+    $test = Livewire::actingAs($user)->test(CreateEntity::class);
+
+    foreach (range(1, 10) as $i) {
+        $test->set('name', "Company $i")->call('submit')->assertHasNoErrors();
+    }
+
+    $test->set('name', 'One too many')->call('submit')->assertHasErrors('name');
+
+    expect(Entity::count())->toBe(10);
+});
