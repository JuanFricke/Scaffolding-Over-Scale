@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Tenancy\CurrentEntity;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Registered as the `current_entity` route middleware alias.
+ *
+ * Resolves the session entity into the request's tenant context, aborting 403 when
+ * the user is not a member of it. With no session entity the user is sent to
+ * onboarding (no memberships), straight in (one) or to the switcher (several).
+ */
+class ResolveCurrentEntity
+{
+    public function __construct(private CurrentEntity $current) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+        $entityId = $request->session()->get(CurrentEntity::SESSION_KEY);
+
+        // A deleted entity can no longer be worked in: treat it like an empty session.
+        $entity = $entityId === null ? null : Entity::find($entityId);
+
+        if ($entity === null) {
+            $request->session()->forget(CurrentEntity::SESSION_KEY);
+            $entity = $this->current->dispatch($user);
+
+            if (! $entity instanceof Entity) {
+                return $entity;
+            }
+        }
+
+        $membership = $user->membershipFor($entity->id);
+
+        abort_if($membership === null, 403);
+
+        $this->current->set($entity, $membership);
+
+        return $next($request);
+    }
+}
diff --git a/app/Livewire/Entity/CreateEntity.php b/app/Livewire/Entity/CreateEntity.php
new file mode 100644
index 0000000..a4bfc40
--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,118 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    /** Inserts tried before a persistent slug collision is given up on. */
+    private const MAX_SLUG_ATTEMPTS = 5;
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(CurrentEntity $current): void
+    {
+        $this->authorize('create', Entity::class);
+
+        $validated = $this->validate();
+
+        $this->ensureIsNotRateLimited();
+
+        RateLimiter::hit($this->throttleKey());
+
+        $name = trim($validated['name']);
+        $user = auth()->user();
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                $entity = DB::transaction(function () use ($name, $user) {
+                    // The slug is picked inside the transaction, but a concurrent request
+                    // can still insert it before us: the unique index has the last word.
+                    $entity = Entity::create(['name' => $name, 'slug' => $this->uniqueSlug($name)]);
+
+                    // The role is fixed here, never taken from the request.
+                    $entity->memberships()->create(['user_id' => $user->id, 'role' => UserRole::Owner]);
+
+                    return $entity;
+                });
+
+                break;
+            } catch (UniqueConstraintViolationException $e) {
+                if ($attempt >= self::MAX_SLUG_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        $current->remember($entity);
+
+        $this->redirect(route('entity.dashboard', $entity));
+    }
+
+    /**
+     * `acme-corp`, then `acme-corp-2`, `acme-corp-3`... skipping slugs taken by any
+     * entity (deleted ones included, the unique index still holds them) and the
+     * ones that would shadow a fixed route.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = rtrim(Str::limit(Str::slug($name), 200, ''), '-') ?: 'entity';
+
+        $taken = Entity::withTrashed()
+            ->where('slug', 'like', $base.'%')
+            ->pluck('slug')
+            ->merge(Entity::RESERVED_SLUGS);
+
+        $slug = $base;
+
+        for ($suffix = 2; $taken->contains($slug); $suffix++) {
+            $slug = $base.'-'.$suffix;
+        }
+
+        return $slug;
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')
+            ->title(__('ui.create_entity_title'));
+    }
+
+    private function ensureIsNotRateLimited(): void
+    {
+        if (! RateLimiter::tooManyAttempts($this->throttleKey(), 10)) {
+            return;
+        }
+
+        throw ValidationException::withMessages([
+            'name' => __('auth.throttle', [
+                'seconds' => RateLimiter::availableIn($this->throttleKey()),
+            ]),
+        ]);
+    }
+
+    private function throttleKey(): string
+    {
+        return 'create-entity|'.auth()->id();
+    }
+}
