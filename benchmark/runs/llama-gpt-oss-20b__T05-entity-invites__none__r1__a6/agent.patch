+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\User;
+use App\Enums\UserRole;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Redirect;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    public function render()
+    {
+        $email = Auth::user()?->email;
+        if (!$email) {
+            return view('livewire.empty');
+        }
+        $invites = EntityInvite::where('email', strtolower($email))
+            ->whereNull('accepted_at')
+            ->where('expires_at', '>', now())
+            ->orderBy('created_at', 'desc')
+            ->get();
+        return view('livewire.entity.pending-invites', ['invites' => $invites]);
+    }
+
+    public function accept(int $id): void
+    {
+        $invite = EntityInvite::findOrFail($id);
+        if ($invite->email !== strtolower(Auth::user()->email)) {
+            abort(403);
+        }
+        if ($invite->expires_at->isPast()) {
+            $this->addError('invite', __('This invite has expired.'));
+            return;
+        }
+        if ($invite->accepted_at) {
+            // already accepted
+            return;
+        }
+        // Create membership
+        $invite->entity->members()->create([
+            'user_id' => Auth::id(),
+            'role' => $invite->role,
+        ]);
+        $invite->accepted_at = now();
+        $invite->save();
+        // Set tenant session? Assuming tenant middleware will use entity
+        // Redirect to entity dashboard
+        return redirect()->route('entity.dashboard', ['entity' => $invite->entity_id]);
+    }
+
+    public function decline(int $id): void
+    {
+        $invite = EntityInvite::findOrFail($id);
+        if ($invite->email !== strtolower(Auth::user()->email)) {
+            abort(403);
+        }
+        $invite->delete();
+    }
+}
