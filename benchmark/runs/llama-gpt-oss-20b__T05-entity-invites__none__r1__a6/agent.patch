@@ -0,0 +1,37 @@
+<?php
+
+namespace App\Mail;
+
+use App\Models\EntityInvite;
+use Illuminate\Bus\Queueable;
+use Illuminate\Foundation\Bus\Dispatchable;
+use Illuminate\Foundation\Exceptions\InvalidArgumentException;
+use Illuminate\Mail\Mailable;
+use Illuminate\Queue\SerializesModels;
+
+class EntityInviteMail extends Mailable
+{
+    use Queueable, Dispatchable, SerializesModels;
+
+    public $invite;
+
+    public function __construct(EntityInvite $invite)
+    {
+        $this->invite = $invite;
+    }
+
+    public function build()
+    {
+        $entity = $this->invite->entity;
+        $roleKey = 'ui.role_' . $this->invite->role->value; // assuming enum value
+        $subject = __('You are invited to :entity', ['entity' => $entity->name]);
+
+        return $this->subject($subject)
+            ->markdown('emails.entity-invite')
+            ->with([
+                'entity' => $entity,
+                'role' => __($roleKey),
+                'expiresAt' => $this->invite->expires_at,
+            ]);
+    }
+}
