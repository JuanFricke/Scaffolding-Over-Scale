+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Model;
+
+use Illuminate\Database\Eloquent\HasFactory;
+use Illuminate\Database\Eloquent\SoftDeletes;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Foundation\Support\Arr;
+
+#[HasFactory]
+class Entity extends Model
+
+{
+    use SoftDeletes;
+    /**
+     * The attributes that are mass assignable.
+     */
+    protected $fillable = ['name', 'slug'];
+
+    /**
+     * Get the route key for Laravel route model binding.
+     */
+    public function getRouteKeyName(): string
+    {
+        return 'slug';
+    }
+
+    /**
+     * Entity memberships.
+     */
+    public function memberships(): \Illuminate\Database\Eloquent\Relations\HasMany
+    {
+        return $this->hasMany(EntityMembership::class);
+    }
+
+    /**
+     * Users belonging to this entity.
+     */
+    public function users(): \Illuminate\Database\Eloquent\Relations\BelongsToMany
+    {
+        return $this->belongsToMany(User::class, 'entity_memberships', 'entity_id', 'user_id');
+    }
+
+    /**
+     * Query builder for the owner membership.
+     */
+    public function owner(): \Illuminate\Database\Eloquent\Relations\HasOne
+    {
+        return $this->hasOne(EntityMembership::class)->where('role', UserRole::Owner->value);
+    }
+}
