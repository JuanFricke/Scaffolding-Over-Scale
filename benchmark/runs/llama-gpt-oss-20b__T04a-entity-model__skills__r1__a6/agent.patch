+<?php
+
+namespace App\Policies;
+
+use App\Models\User;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\Auth\HandlesAuthorization;
+
+class EntityMembershipPolicy
+{
+    use HandlesAuthorization;
+
+    /**
+     * Determine if user can view a membership.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $membership->entity->memberships()->where('user_id', $user->id)->exists();
+    }
+
+    /**
+     * Determine if user can assign a role to a membership.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $membership->entity->memberships()
+            ->where('user_id', $user->id)
+            ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+            ->exists();
+    }
+
+    /**
+     * Determine if user can delete a membership.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        // Owner cannot delete their own membership
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        // Self-removal is allowed for non-owners
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        // Owner or admin of the entity may delete others
+        return $membership->entity->memberships()
+            ->where('user_id', $user->id)
+            ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+            ->exists();
+    }
+}
