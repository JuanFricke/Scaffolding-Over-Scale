+
+class AuthServiceProvider extends BaseAuthServiceProvider
+{
+    /**
+     * The policy mappings for the application.
+     */
+    protected $policies = [
+        // Map models to policies
+        'App\Models\Entity' => 'App\Policies\EntityPolicy',
