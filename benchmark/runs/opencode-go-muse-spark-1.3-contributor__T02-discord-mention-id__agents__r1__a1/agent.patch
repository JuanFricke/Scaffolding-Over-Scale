diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..e06cb48 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,38 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $body = implode("\n", $lines);
+        $mention = $this->mention();
+
+        if ($mention === null) {
+            return mb_substr($body, 0, self::MaxContentLength);
+        }
+
+        $suffix = "\n".$mention;
+        $available = self::MaxContentLength - mb_strlen($suffix);
+
+        return mb_substr($body, 0, $available).$suffix;
+    }
+
+    private function mention(): ?string
+    {
+        $raw = config('services.discord.mention_id');
+
+        if (is_int($raw)) {
+            $raw = (string) $raw;
+        }
+
+        if (! is_string($raw)) {
+            return null;
+        }
+
+        $id = trim($raw);
+
+        if (! preg_match('/\A[0-9]{17,20}\z/', $id)) {
+            return null;
+        }
+
+        return '<@'.$id.'>';
     }
 
     private function safe(string $key, mixed $value): string
