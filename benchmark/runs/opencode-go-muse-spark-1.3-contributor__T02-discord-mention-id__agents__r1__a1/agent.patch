--- a/tests/Feature/DiscordOpsAlertTest.php
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -121,3 +121,98 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends a mention on its own line when a valid mention id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '12345678901234567',
+    ]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n<@12345678901234567>")
+            && str_contains($content, 'Plan limit');
+    });
+});
+
+test('does not add any mention when mention id is null or empty', function ($mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '', '   ']);
+
+test('ignores invalid mention ids silently', function ($mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([
+    '@everyone',
+    '@here',
+    'abc',
+    '123',
+    '1234567890123456',
+    '123456789012345678901',
+    "123\n@everyone",
+    "123> \n@everyone",
+    '<@12345678901234567>',
+]);
+
+test('accepts surrounding whitespace and integer mention ids', function ($mentionId, string $expected) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@{$expected}>"));
+})->with([
+    'whitespace' => ['  12345678901234567  ', '12345678901234567'],
+    'integer' => [12345678901234567, '12345678901234567'],
+    'twenty digits' => ['12345678901234567890', '12345678901234567890'],
+]);
+
+test('truncation reserves room so the mention survives', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    $mentionId = '12345678901234567';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
