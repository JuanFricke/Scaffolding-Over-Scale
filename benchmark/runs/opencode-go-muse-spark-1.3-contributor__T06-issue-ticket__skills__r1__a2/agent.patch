+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has required columns and unique slug per entity', function () {
+    expect(Schema::hasTable('queues'))->toBeTrue()
+        ->and(Schema::hasColumns('queues', [
+            'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n',
+            'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('queues', 'queues_entity_id_slug_unique'))->toBeTrue();
+});
+
+test('tickets table has required columns, unique code per queue and suggested index', function () {
+    expect(Schema::hasTable('tickets'))->toBeTrue()
+        ->and(Schema::hasColumns('tickets', [
+            'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+            'issued_at', 'called_at', 'called_by_user_id',
+            'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_code_unique'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_status_priority_issued_at_index'))->toBeTrue();
+});
+
+test('deleting a queue cascades to its tickets', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->queue->delete();
+
+    expect(Ticket::whereKey($ticket->id)->exists())->toBeFalse();
+});
+
+test('force deleting an entity cascades to queues and tickets', function () {
+    $ticket = Ticket::factory()->create();
+    $entity = $ticket->queue->entity;
+
+    $entity->forceDelete();
+
+    expect(Queue::whereKey($ticket->queue_id)->exists())->toBeFalse()
+        ->and(Ticket::whereKey($ticket->id)->exists())->toBeFalse();
+});
+
+test('queue factory creates its entity, is active by default and has unique slugs', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create();
+
+    expect($queue->entity)->not->toBeNull()
+        ->and($queue->is_active)->toBeTrue()
+        ->and($queue->slug)->not->toBeEmpty()
+        ->and($other->slug)->not->toBe($queue->slug);
+});
+
+test('queue slug is unique within the entity but reusable across entities', function () {
+    $queue = Queue::factory()->create(['slug' => 'atendimento']);
+
+    expect(Queue::factory()->for($queue->entity)->create(['slug' => 'senhas']))
+        ->toBeInstanceOf(Queue::class);
+
+    expect(fn () => Queue::factory()->for($queue->entity)->create(['slug' => 'atendimento']))
+        ->toThrow(QueryException::class);
+
+    expect(Queue::factory()->create(['slug' => 'atendimento']))
+        ->toBeInstanceOf(Queue::class);
+});
+
+test('queue exposes entity and tickets relations and entity exposes queues', function () {
+    $ticket = Ticket::factory()->create();
+    $queue = $ticket->queue;
+
+    expect($queue->entity->is($ticket->queue->entity))->toBeTrue()
+        ->and($queue->tickets()->first()->is($ticket))->toBeTrue()
+        ->and($queue->entity->queues()->first()->is($queue))->toBeTrue();
+});
+
+test('ticket factory defaults to waiting virtual priority zero issued now', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('ticket factory allocates sequential codes per queue and keeps explicit codes', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+    $explicit = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and($explicit->code)->toBe('A-X');
+});
diff --git a/tests/Feature/Queue/TicketCallTest.php b/tests/Feature/Queue/TicketCallTest.php
