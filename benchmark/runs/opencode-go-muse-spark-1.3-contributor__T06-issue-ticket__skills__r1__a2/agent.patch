+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issuance creates a waiting ticket with defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket)->toBeInstanceOf(Ticket::class)
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('issuance accepts explicit priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+    $printed = (new IssueTicket)($queue, 0, TicketChannel::Printed);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and($printed->channel)->toBe(TicketChannel::Printed)
+        ->and($printed->code)->toBe('A002');
+});
+
+test('display codes sequence per queue beyond 999', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001')
+        ->and((new IssueTicket)($queue)->code)->toBe('A1001');
+});
+
+test('deleted tickets do not free their number', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create();
+    Ticket::where('queue_id', $queue->id)->where('code', 'A002')->delete();
+
+    expect((new IssueTicket)($queue)->code)->toBe('A004');
+});
+
+test('malformed legacy codes are skipped when computing the next code', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+});
+
+test('issuance rejects inactive queues and persists nothing', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('issuance checks queue state from the database inside the transaction', function () {
+    $queue = Queue::factory()->create();
+    Queue::whereKey($queue->id)->update(['is_active' => false]);
+
+    expect($queue->is_active)->toBeTrue(); // stale in-memory instance
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('issuance rejects negative priority', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))->toThrow(InvalidArgumentException::class)
+        ->and(Ticket::count())->toBe(0);
+});
diff --git a/tests/Feature/Queue/QueueTicketSchemaTest.php b/tests/Feature/Queue/QueueTicketSchemaTest.php
