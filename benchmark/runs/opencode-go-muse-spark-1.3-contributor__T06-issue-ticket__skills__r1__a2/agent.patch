+++ b/tests/Feature/Queue/TicketCallTest.php
@@ -0,0 +1,68 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Queue $queue): User
+{
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $queue->entity_id,
+        'user_id' => $user->id,
+        'role' => 'employee',
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    return $user;
+}
+
+test('a member can call a waiting ticket exactly once', function () {
+    $ticket = Ticket::factory()->create();
+    $user = memberOf($ticket->queue);
+
+    $ticket->call($user);
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($user->id)
+        ->and($ticket->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+test('calling twice or calling a non-waiting ticket throws', function () {
+    $ticket = Ticket::factory()->create();
+    $user = memberOf($ticket->queue);
+
+    $ticket->call($user);
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+});
+
+test('a non-member cannot call and the ticket is unchanged', function () {
+    $ticket = Ticket::factory()->create();
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class)
+        ->and($ticket->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->fresh()->called_at)->toBeNull()
+        ->and($ticket->fresh()->called_by_user_id)->toBeNull();
+});
+
+test('issued ticket fields are write-once except call fields', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->code = 'B001';
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+
+    $ticket->refresh();
+    $ticket->priority = 99;
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+});
