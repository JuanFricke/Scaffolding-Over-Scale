diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..7a97b4a
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,114 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Database\Factories\TicketFactory;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    /** @use HasFactory<TicketFactory> */
+    use HasFactory;
+
+    /**
+     * Fields that may change after issuance (plus updated_at, handled by Eloquent).
+     */
+    private const MUTABLE_AFTER_ISSUANCE = ['status', 'called_at', 'called_by_user_id'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        // Allocate the next display code at creation time when none is given
+        // (explicit codes, e.g. legacy ones, are kept as-is).
+        static::creating(function (self $ticket) {
+            if (empty($ticket->code)) {
+                $ticket->code = static::nextCode($ticket->queue_id);
+            }
+        });
+
+        // Write-once: after issuance only the call fields may change.
+        static::updating(function (self $ticket) {
+            $changed = array_keys($ticket->getDirty());
+            $immutable = array_diff($changed, self::MUTABLE_AFTER_ISSUANCE, ['updated_at']);
+
+            if ($immutable !== []) {
+                throw new \LogicException(
+                    'Ticket is write-once; only status, called_at and called_by_user_id may change after issuance.'
+                );
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for the queue: last valid code (A<digits>) + 1 by
+     * insertion order, zero padded to at least 3 digits.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $max = 0;
+
+        foreach (static::where('queue_id', $queueId)->orderBy('id')->pluck('code') as $code) {
+            if (preg_match('/\AA(\d+)\z/', (string) $code, $matches)) {
+                $max = max($max, (int) $matches[1]);
+            }
+        }
+
+        return 'A'.str_pad((string) ($max + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Mark the ticket called by the given user. Only members of the ticket's
+     * entity may call, and a ticket is called exactly once.
+     */
+    public function call(User $user): void
+    {
+        $this->refresh();
+
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new \LogicException('Only waiting tickets can be called.');
+        }
+
+        $entityId = Queue::whereKey($this->queue_id)->value('entity_id');
+
+        if ($entityId === null || ! $user->membershipFor($entityId)) {
+            throw new AuthorizationException('Only members of the ticket\'s entity may call tickets.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->getKey();
+        $this->save();
+    }
+}
