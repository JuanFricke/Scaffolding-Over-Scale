diff --git a/app/Livewire/Entity/Members.php b/app/Livewire/Entity/Members.php
new file mode 100644
index 0000000..b2a43d7
--- /dev/null
+++ b/app/Livewire/Entity/Members.php
@@ -0,0 +1,132 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|email|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    /**
+     * Add an existing user to the entity as an employee.
+     */
+    public function addMember(): void
+    {
+        $this->authorize('update', $this->entity);
+
+        $key = 'add-member:'.auth()->id();
+
+        if (RateLimiter::tooManyAttempts($key, 20)) {
+            throw ValidationException::withMessages([
+                'email' => __('auth.throttle', ['seconds' => RateLimiter::availableIn($key)]),
+            ]);
+        }
+
+        RateLimiter::hit($key);
+
+        $validated = $this->validate();
+
+        $user = User::where('email', $validated['email'])->firstOrFail();
+
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw ValidationException::withMessages(['email' => __('ui.member_already_added')]);
+        }
+
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->reset('email');
+    }
+
+    /**
+     * Promote or demote a member between admin and employee.
+     */
+    public function assignRole(mixed $membershipId, string $role): void
+    {
+        $membership = $this->membership($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        validator(['role' => $role], [
+            'role' => ['required', Rule::in(array_column(UserRole::manageable(), 'value'))],
+        ])->validate();
+
+        // The owner's role only changes through ownership transfer.
+        abort_if($membership->role === UserRole::Owner, 403);
+
+        $membership->update(['role' => $role]);
+    }
+
+    /**
+     * Remove a member (or let a member leave) without ever orphaning the entity.
+     */
+    public function removeMember(mixed $membershipId): void
+    {
+        $membership = $this->membership($membershipId);
+
+        $this->authorize('delete', $membership);
+
+        $isManager = in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+        $managers = $this->entity->memberships()->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])->count();
+
+        abort_if($isManager && $managers <= 1, 403);
+
+        $membership->delete();
+
+        if ($membership->user_id === auth()->id()) {
+            if (session('current_entity_id') == $this->entity->id) {
+                session()->forget('current_entity_id');
+            }
+
+            $this->redirect(route('home'));
+        }
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+            'roles' => UserRole::manageable(),
+        ]);
+    }
+
+    /**
+     * Resolve a client-supplied membership id, scoped to this entity.
+     */
+    protected function membership(mixed $membershipId): EntityMembership
+    {
+        $id = filter_var($membershipId, FILTER_VALIDATE_INT);
+
+        $membership = $id === false ? null : $this->entity->memberships()->find($id);
+
+        abort_if($membership === null, 403);
+
+        return $membership;
+    }
+}
diff --git a/app/Livewire/Entity/Settings.php b/app/Livewire/Entity/Settings.php
new file mode 100644
index 0000000..833df5a
--- /dev/null
+++ b/app/Livewire/Entity/Settings.php
@@ -0,0 +1,111 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    public int|string|null $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    protected function rules(): array
+    {
+        return [
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => [
+                'required', 'string', 'max:255', 'alpha_dash:ascii', 'lowercase',
+                Rule::unique('entities', 'slug')->ignore($this->entity->id),
+            ],
+        ];
+    }
+
+    public function save(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $validated = $this->validate();
+
+        $this->entity->update($validated);
+
+        // The URL of this page carries the slug.
+        if ($this->entity->wasChanged('slug')) {
+            $this->redirect(route('entity.settings', $this->entity));
+        }
+    }
+
+    public function delete(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        DB::transaction(function () {
+            $this->entity->memberships()->delete();
+            $this->entity->delete();
+        });
+
+        if (session('current_entity_id') == $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirect(route('home'));
+    }
+
+    /**
+     * Hand the ownership over to another admin of this entity.
+     */
+    public function transfer(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $targetId = filter_var($this->targetMembershipId, FILTER_VALIDATE_INT);
+
+        abort_if($targetId === false, 403);
+
+        DB::transaction(function () use ($targetId) {
+            $owner = $this->entity->memberships()->owner()->lockForUpdate()->first();
+
+            abort_if($owner === null || $owner->user_id !== auth()->id(), 403);
+
+            $target = $this->entity->memberships()->admin()
+                ->whereKeyNot($owner->id)->lockForUpdate()->find($targetId);
+
+            abort_if($target === null, 403);
+
+            // Demote first: the unique index allows a single owner at any time.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+        });
+
+        $this->redirect(route('entity.dashboard', $this->entity));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'admins' => $this->entity->memberships()->admin()->with('user')->orderBy('id')->get(),
+        ]);
+    }
+}
