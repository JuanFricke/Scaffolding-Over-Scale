+++ b/tests/Feature/EntityDashboardTest.php
@@ -0,0 +1,102 @@
+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(fn () => $this->withoutVite());
+
+test('the owner sees the name, a welcome, the owner notice and both links', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $entity = $membership->entity;
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee($entity->name)
+        ->assertSee('Bem-vindo(a), '.$membership->user->name)
+        ->assertSee('Você é o proprietário desta entidade.')
+        ->assertSee(route('entity.members', $entity), false)
+        ->assertSee(route('entity.settings', $entity), false);
+});
+
+test('an admin sees the members link but never the settings url nor the owner notice', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+    $entity = $membership->entity;
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(route('entity.members', $entity), false)
+        ->assertDontSee(route('entity.settings', $entity), false)
+        ->assertDontSee('Você é o proprietário desta entidade.');
+});
+
+test('the dashboard texts come from the english locale too', function () {
+    app()->setLocale('en');
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $membership->entity))
+        ->assertSee('You are the owner of this entity.')
+        ->assertSee('Members');
+});
+
+test('a non-member gets 403 even when the session points at another of their entities', function () {
+    $mine = EntityMembership::factory()->owner()->create();
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($mine->user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->get(route('entity.dashboard', $theirs))
+        ->assertForbidden();
+
+    Livewire::actingAs($mine->user)->test(Dashboard::class, ['entity' => $theirs])->assertForbidden();
+});
+
+test('guests and unverified users cannot open the dashboard', function () {
+    $entity = EntityMembership::factory()->create()->entity;
+
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('a deleted entity is not found', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $membership->entity->delete();
+
+    $this->actingAs($membership->user)->get(route('entity.dashboard', $membership->entity->slug))->assertNotFound();
+});
+
+test('the bound entity cannot be swapped from the client', function () {
+    $mine = EntityMembership::factory()->owner()->create();
+    $theirs = Entity::factory()->create();
+
+    $component = Livewire::actingAs($mine->user)->test(Dashboard::class, ['entity' => $mine->entity]);
+
+    expect(fn () => $component->set('entity', $theirs->id))
+        ->toThrow('Cannot update locked property');
+});
+
+test('both locales define the same ui keys', function () {
+    $en = array_keys(require base_path('lang/en/ui.php'));
+    $pt = array_keys(require base_path('lang/pt_BR/ui.php'));
+
+    expect($pt)->toEqualCanonicalizing($en);
+});
+
+test('the entity routes are named and bound by slug', function () {
+    foreach (['entity.pick', 'entity.dashboard', 'entity.members', 'entity.settings'] as $name) {
+        expect(route($name, 'padaria', false))->toContain('/e/padaria');
+    }
+
+    expect(route('entity.members', 'padaria', false))->toBe('/e/padaria/membros')
+        ->and(route('entity.settings', 'padaria', false))->toBe('/e/padaria/settings');
+});
