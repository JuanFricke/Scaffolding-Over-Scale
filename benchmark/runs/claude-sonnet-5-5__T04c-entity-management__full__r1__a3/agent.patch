+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+test('picking an entity stores it in the session, audits it and goes to its dashboard', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    Log::shouldReceive('channel')->with('audit')->once()->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('Entity picked', [
+        'user_id' => $membership->user_id,
+        'entity_id' => $membership->entity_id,
+    ]);
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $membership->entity))
+        ->assertRedirect(route('entity.dashboard', $membership->entity))
+        ->assertSessionHas('current_entity_id', $membership->entity_id);
+});
+
+test('picking an entity writes to the audit log channel', function () {
+    Event::fake([MessageLogged::class]);
+    $membership = EntityMembership::factory()->create();
+
+    $this->actingAs($membership->user)->post(route('entity.pick', $membership->entity));
+
+    Event::assertDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->level === 'info'
+        && str_contains($log->message, 'Entity picked'));
+});
+
+test('a non-member cannot pick an entity and the session is untouched', function () {
+    $mine = EntityMembership::factory()->create();
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($mine->user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->post(route('entity.pick', $theirs))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->entity_id);
+});
+
+test('picking requires authentication and a verified e-mail', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $this->post(route('entity.pick', $membership->entity))->assertRedirect(route('login'));
+
+    $this->actingAs(User::factory()->unverified()->create())
+        ->post(route('entity.pick', $membership->entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('picking an unknown or deleted entity is a 404', function () {
+    $membership = EntityMembership::factory()->create();
+    $membership->entity->delete();
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $membership->entity->slug))
+        ->assertNotFound();
+});
diff --git a/tests/Feature/EntityPoliciesTest.php b/tests/Feature/EntityPoliciesTest.php
new file mode 100644
index 0000000..d002e96
--- /dev/null
+++ b/tests/Feature/EntityPoliciesTest.php
@@ -0,0 +1,108 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function member(Entity $entity, UserRole $role): User
+{
+    $membership = EntityMembership::factory()->for($entity)->create(['role' => $role]);
+
+    return $membership->user;
+}
+
+test('entity policy permissions per role', function (UserRole $role, array $expected) {
+    $entity = Entity::factory()->create();
+    $user = member($entity, $role);
+    $policy = new EntityPolicy;
+
+    expect($policy->create($user))->toBeTrue()
+        ->and($policy->view($user, $entity))->toBe($expected['view'])
+        ->and($policy->update($user, $entity))->toBe($expected['update'])
+        ->and($policy->delete($user, $entity))->toBe($expected['delete'])
+        ->and($policy->manageSettings($user, $entity))->toBe($expected['settings']);
+})->with([
+    'owner' => [UserRole::Owner, ['view' => true, 'update' => true, 'delete' => true, 'settings' => true]],
+    'admin' => [UserRole::Admin, ['view' => true, 'update' => true, 'delete' => true, 'settings' => false]],
+    'employee' => [UserRole::Employee, ['view' => true, 'update' => false, 'delete' => false, 'settings' => false]],
+]);
+
+test('a non-member can create entities but not touch another one', function () {
+    $entity = Entity::factory()->create();
+    $stranger = User::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->create($stranger))->toBeTrue()
+        ->and($policy->view($stranger, $entity))->toBeFalse()
+        ->and($policy->update($stranger, $entity))->toBeFalse()
+        ->and($policy->delete($stranger, $entity))->toBeFalse()
+        ->and($policy->manageSettings($stranger, $entity))->toBeFalse();
+});
+
+test('being owner of one entity grants nothing on another', function () {
+    $mine = Entity::factory()->create();
+    $theirs = Entity::factory()->create();
+    $user = member($mine, UserRole::Owner);
+
+    expect((new EntityPolicy)->manageSettings($user, $theirs))->toBeFalse()
+        ->and((new EntityPolicy)->view($user, $theirs))->toBeFalse();
+});
+
+test('membership policy view and assignRole', function (UserRole $role, bool $manager) {
+    $entity = Entity::factory()->create();
+    $user = member($entity, $role);
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($user, $target))->toBeTrue()
+        ->and($policy->assignRole($user, $target))->toBe($manager);
+})->with([
+    'owner' => [UserRole::Owner, true],
+    'admin' => [UserRole::Admin, true],
+    'employee' => [UserRole::Employee, false],
+]);
+
+test('membership policy denies non-members of that entity', function () {
+    $target = EntityMembership::factory()->employee()->create();
+    $manager = member(Entity::factory()->create(), UserRole::Owner);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($manager, $target))->toBeFalse()
+        ->and($policy->assignRole($manager, $target))->toBeFalse()
+        ->and($policy->delete($manager, $target))->toBeFalse();
+});
+
+test('membership policy delete rules', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+    $otherEmployee = EntityMembership::factory()->employee()->for($entity)->create();
+    $policy = new EntityMembershipPolicy;
+
+    // The owner's membership is never deletable, not even by the owner.
+    expect($policy->delete($owner->user, $owner))->toBeFalse()
+        ->and($policy->delete($admin->user, $owner))->toBeFalse()
+        // Managers delete anyone else.
+        ->and($policy->delete($owner->user, $admin))->toBeTrue()
+        ->and($policy->delete($admin->user, $employee))->toBeTrue()
+        // Self-removal is always allowed, removing others is not for employees.
+        ->and($policy->delete($employee->user, $employee))->toBeTrue()
+        ->and($policy->delete($employee->user, $otherEmployee))->toBeFalse()
+        ->and($policy->delete($employee->user, $admin))->toBeFalse();
+});
+
+test('the policies are discovered by the gate', function () {
+    $entity = Entity::factory()->create();
+    $user = member($entity, UserRole::Admin);
+
+    expect($user->can('update', $entity))->toBeTrue()
+        ->and($user->can('manageSettings', $entity))->toBeFalse()
+        ->and($user->can('assignRole', EntityMembership::factory()->for($entity)->create()))->toBeTrue();
+});
