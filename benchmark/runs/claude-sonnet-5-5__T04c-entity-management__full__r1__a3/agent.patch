+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Anyone authenticated may create an entity.
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    /**
+     * Any member may view the entity.
+     */
+    public function view(User $user, Entity $entity): bool
+    {
+        return $this->roleOf($user, $entity) !== null;
+    }
+
+    /**
+     * Owner and admin may update the entity.
+     */
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    /**
+     * Owner and admin may delete the entity.
+     */
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    /**
+     * Settings (and billing) belong to the owner alone.
+     */
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $this->roleOf($user, $entity) === UserRole::Owner;
+    }
+
+    protected function roleOf(User $user, Entity $entity): ?UserRole
+    {
+        return $user->membershipFor($entity->id)?->role;
+    }
+
+    protected function isManager(User $user, Entity $entity): bool
+    {
+        return in_array($this->roleOf($user, $entity), [UserRole::Owner, UserRole::Admin], true);
+    }
+}
