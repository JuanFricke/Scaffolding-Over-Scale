+    $entity = Entity::factory()->create(['slug' => 'padaria-do-ze']);
+
+    expect($entity->getRouteKeyName())->toBe('slug');
+
+    $entity->delete();
+
+    expect(Entity::count())->toBe(0)
+        ->and(Entity::withTrashed()->count())->toBe(1);
+});
+
+test('entity slugs are unique', function () {
+    Entity::factory()->create(['slug' => 'mesma']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'mesma']))->toThrow(QueryException::class);
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique');
+});
+
+test('a membership defaults to employee and casts the role', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+
+    $raw = EntityMembership::create([
+        'entity_id' => Entity::factory()->create()->id,
+        'user_id' => User::factory()->create()->id,
+    ]);
+
+    expect($raw->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('a user can only join an entity once', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(QueryException::class);
+
+    expect(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_entity_user_unique');
+});
+
+test('the database rejects a second owner but allows many admins and employees', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->count(2)->for($entity)->create();
+    EntityMembership::factory()->employee()->count(2)->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(QueryException::class);
+
+    // Another entity has its own owner.
+    EntityMembership::factory()->owner()->create();
+
+    expect(EntityMembership::count())->toBe(6)
+        ->and(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_one_owner');
+});
+
+test('promoting a second member to owner is rejected by the database', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect(fn () => $admin->update(['role' => UserRole::Owner]))->toThrow(QueryException::class);
+});
+
+test('deleting an entity or a user cascades to memberships', function () {
+    $membership = EntityMembership::factory()->create();
+    $other = EntityMembership::factory()->create();
+
+    $membership->entity->forceDelete();
+    $other->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('role scopes and the owner relation filter memberships', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id])
+        ->and($entity->owner()->first()->id)->toBe($owner->id)
+        ->and($entity->owner->is($owner))->toBeTrue()
+        ->and($entity->memberships)->toHaveCount(3)
+        ->and($entity->users)->toHaveCount(3);
+});
+
+test('user relations and membershipFor', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+    $user = $membership->user;
+
+    expect($user->memberships)->toHaveCount(1)
+        ->and($user->entities->first()->is($membership->entity))->toBeTrue()
+        ->and($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor($membership->entity_id + 1))->toBeNull();
+});
+
+test('manageable roles exclude the owner', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
