+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(fn () => $this->withoutVite());
+
+function settingsPage(EntityMembership $as, ?Entity $entity = null)
+{
+    return Livewire::actingAs($as->user)->test(Settings::class, ['entity' => $entity ?? $as->entity]);
+}
+
+test('only the owner opens the settings', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+    $outsider = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($owner->user)->get(route('entity.settings', $entity))->assertOk()
+        ->assertSee('Transferir propriedade');
+
+    foreach ([$admin, $employee, $outsider] as $other) {
+        $this->actingAs($other->user)->get(route('entity.settings', $entity))->assertForbidden();
+        settingsPage($other, $entity)->assertForbidden();
+    }
+});
+
+test('guests are sent to login', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.settings', $entity))->assertRedirect(route('login'));
+});
+
+test('the settings page renders in english', function () {
+    app()->setLocale('en');
+    $owner = EntityMembership::factory()->owner()->create();
+
+    settingsPage($owner)->assertSee('Transfer ownership');
+});
+
+test('the form starts filled with the current values', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    settingsPage($owner)->assertSet('name', $owner->entity->name)->assertSet('slug', $owner->entity->slug);
+});
+
+test('save edits name and slug', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    settingsPage($owner)
+        ->set('name', 'Padaria do Zé')
+        ->set('slug', 'padaria-do-ze')
+        ->call('save')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.settings', 'padaria-do-ze'));
+
+    expect($owner->entity->fresh())->name->toBe('Padaria do Zé')->slug->toBe('padaria-do-ze');
+});
+
+test('saving only the name keeps the page', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    settingsPage($owner)->set('name', 'Novo nome')->call('save')->assertHasNoErrors()->assertNoRedirect();
+
+    expect($owner->entity->fresh()->name)->toBe('Novo nome');
+});
+
+test('save validates name and slug', function (string $field, string $value) {
+    $owner = EntityMembership::factory()->owner()->create();
+    Entity::factory()->create(['slug' => 'ocupado']);
+    Entity::factory()->create(['slug' => 'apagado'])->delete();
+
+    settingsPage($owner)->set($field, $value)->call('save')->assertHasErrors($field);
+})->with([
+    'empty name' => ['name', ''],
+    'long name' => ['name', str_repeat('a', 256)],
+    'empty slug' => ['slug', ''],
+    'taken slug' => ['slug', 'ocupado'],
+    'soft deleted slug' => ['slug', 'apagado'],
+    'spaces in slug' => ['slug', 'dois nomes'],
+    'uppercase slug' => ['slug', 'Maiuscula'],
+    'slashes in slug' => ['slug', 'a/b'],
+]);
+
+test('the slug may stay unchanged', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    settingsPage($owner)->call('save')->assertHasNoErrors();
+});
+
+test('the entity cannot be swapped from the client', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $theirs = Entity::factory()->create();
+
+    expect(fn () => settingsPage($owner)->set('entity', $theirs->id))
+        ->toThrow('Cannot update locked property');
+    expect(fn () => settingsPage($owner)->set('entity.name', 'hacked'))
+        ->toThrow('Cannot update locked property');
+
+    expect($theirs->fresh()->name)->not->toBe('hacked');
+});
+
+test('delete soft deletes the entity, drops its memberships and clears the session', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    $other = EntityMembership::factory()->owner()->create();
+
+    $this->withSession(['current_entity_id' => $entity->id]);
+
+    settingsPage($owner)->call('delete')->assertRedirect(route('home'));
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull()
+        ->and(EntityMembership::where('entity_id', $entity->id)->count())->toBe(0)
+        ->and(EntityMembership::find($other->id))->not->toBeNull()
+        ->and(session('current_entity_id'))->toBeNull();
+});
+
+test('delete keeps a session pointing at another entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $other = Entity::factory()->create();
+
+    $this->withSession(['current_entity_id' => $other->id]);
+
+    settingsPage($owner)->call('delete')->assertRedirect(route('home'));
+
+    expect(session('current_entity_id'))->toBe($other->id);
+});
+
+test('delete is denied once the user is no longer the owner', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $page = settingsPage($owner);
+
+    $owner->update(['role' => UserRole::Admin]);
+
+    $page->call('delete')->assertForbidden();
+
+    expect(Entity::find($entity->id))->not->toBeNull();
+});
+
+test('save is denied once the user is no longer the owner', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $page = settingsPage($owner);
+
+    $owner->update(['role' => UserRole::Admin]);
+
+    $page->set('name', 'x')->call('save')->assertForbidden();
+
+    expect($owner->entity->fresh()->name)->not->toBe('x');
+});
+
+test('transfer moves the ownership to an admin atomically', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    settingsPage($owner)
+        ->set('targetMembershipId', $admin->id)
+        ->call('transfer')
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    expect($owner->fresh()->role)->toBe(UserRole::Admin)
+        ->and($admin->fresh()->role)->toBe(UserRole::Owner)
+        ->and($entity->memberships()->owner()->count())->toBe(1);
+});
+
+test('transfer accepts the id as the string a select sends', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    settingsPage($owner)->set('targetMembershipId', (string) $admin->id)->call('transfer')->assertRedirect();
+
+    expect($admin->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('transfer targets must be an admin of this entity other than the caller', function (string $kind) {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $target = match ($kind) {
+        'employee' => EntityMembership::factory()->employee()->for($entity)->create()->id,
+        'self' => $owner->id,
+        'foreign admin' => EntityMembership::factory()->admin()->create()->id,
+        'foreign owner' => EntityMembership::factory()->owner()->create()->id,
+        'missing' => 999999,
+        'garbage' => 'abc',
+        'empty' => null,
+    };
+
+    settingsPage($owner)->set('targetMembershipId', $target)->call('transfer')->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner)
+        ->and($entity->memberships()->owner()->count())->toBe(1);
+})->with(['employee', 'self', 'foreign admin', 'foreign owner', 'missing', 'garbage', 'empty']);
+
+test('transfer is denied when the owner row vanished', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $page = settingsPage($owner)->set('targetMembershipId', $admin->id);
+
+    $owner->delete();
+
+    $page->call('transfer')->assertForbidden();
+
+    expect($admin->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('transfer is denied to a user who is no longer the owner', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $page = settingsPage($owner)->set('targetMembershipId', $admin->id);
+
+    // Ownership moved to someone else behind the page's back.
+    $owner->update(['role' => UserRole::Admin]);
+    $admin->update(['role' => UserRole::Owner]);
+
+    $page->call('transfer')->assertForbidden();
+});
+
+test('the transfer form lists admins only and tells when there are none', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    settingsPage($owner)
+        ->assertDontSee($employee->user->email)
+        ->assertSee('Promova um membro a administrador');
+
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    settingsPage($owner)
+        ->assertSee($admin->user->email)
+        ->assertDontSee($employee->user->email)
+        ->assertDontSee('Promova um membro a administrador');
+});
