+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(fn () => $this->withoutVite());
+
+function membersPage(EntityMembership $as, ?Entity $entity = null)
+{
+    return Livewire::actingAs($as->user)->test(Members::class, ['entity' => $entity ?? $as->entity]);
+}
+
+test('members of an entity can see the list, a non-member cannot', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $outsider = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($employee->user)
+        ->get(route('entity.members', $owner->entity))
+        ->assertOk()
+        ->assertSee($owner->user->email)
+        ->assertSee('Membros');
+
+    $this->actingAs($outsider->user)->get(route('entity.members', $owner->entity))->assertForbidden();
+    membersPage($outsider, $owner->entity)->assertForbidden();
+});
+
+test('guests are sent to login', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.members', $entity))->assertRedirect(route('login'));
+});
+
+test('a manager adds an existing user as employee', function (string $role) {
+    $manager = EntityMembership::factory()->for(Entity::factory())->create(['role' => $role]);
+    $user = User::factory()->create();
+
+    membersPage($manager)
+        ->set('email', $user->email)
+        ->call('addMember')
+        ->assertHasNoErrors()
+        ->assertSet('email', '');
+
+    expect($manager->entity->memberships()->where('user_id', $user->id)->first()->role)->toBe(UserRole::Employee);
+})->with(['owner', 'admin']);
+
+test('adding validates the e-mail', function (string $email) {
+    $manager = EntityMembership::factory()->owner()->create();
+
+    membersPage($manager)->set('email', $email)->call('addMember')->assertHasErrors('email');
+
+    expect($manager->entity->memberships()->count())->toBe(1);
+})->with(['', 'not-an-email', 'ghost@example.com']);
+
+test('adding a duplicate member is an error on email', function () {
+    $manager = EntityMembership::factory()->owner()->create();
+
+    membersPage($manager)
+        ->set('email', $manager->user->email)
+        ->call('addMember')
+        ->assertHasErrors('email');
+
+    expect($manager->entity->memberships()->count())->toBe(1);
+});
+
+test('adding is rate limited', function () {
+    $manager = EntityMembership::factory()->owner()->create();
+
+    $page = membersPage($manager);
+
+    foreach (range(1, 20) as $i) {
+        $page->set('email', 'ghost@example.com')->call('addMember');
+    }
+
+    $user = User::factory()->create();
+    $page->set('email', $user->email)->call('addMember')->assertHasErrors('email');
+
+    expect($manager->entity->memberships()->count())->toBe(1);
+});
+
+test('an employee cannot add or assign roles', function () {
+    $entity = Entity::factory()->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+    $user = User::factory()->create();
+
+    membersPage($employee)->set('email', $user->email)->call('addMember')->assertForbidden();
+    membersPage($employee)->call('assignRole', $target->id, 'admin')->assertForbidden();
+
+    expect($entity->memberships()->count())->toBe(2)
+        ->and($target->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('a manager assigns admin and employee roles', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+
+    membersPage($owner)->call('assignRole', $target->id, 'admin')->assertHasNoErrors();
+    expect($target->fresh()->role)->toBe(UserRole::Admin);
+
+    membersPage($owner)->call('assignRole', (string) $target->id, 'employee')->assertHasNoErrors();
+    expect($target->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('only admin or employee can be assigned', function (string $role) {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+
+    membersPage($owner)->call('assignRole', $target->id, $role)->assertHasErrors('role');
+
+    expect($target->fresh()->role)->toBe(UserRole::Employee)
+        ->and($entity->memberships()->owner()->count())->toBe(1);
+})->with(['owner', 'superuser', '']);
+
+test('the owner role cannot be changed through assignRole', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    membersPage($admin)->call('assignRole', $owner->id, 'employee')->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('membership ids from another entity are rejected', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $foreign = EntityMembership::factory()->employee()->create();
+    $foreignOwnerOfBoth = EntityMembership::factory()->owner()->for($foreign->entity)->create(['user_id' => $owner->user_id]);
+
+    membersPage($owner)->call('assignRole', $foreign->id, 'admin')->assertForbidden();
+    membersPage($owner)->call('removeMember', $foreign->id)->assertForbidden();
+    membersPage($owner)->call('removeMember', 'abc')->assertForbidden();
+    membersPage($owner)->call('removeMember', 999999)->assertForbidden();
+
+    expect($foreign->fresh()->role)->toBe(UserRole::Employee)
+        ->and(EntityMembership::find($foreign->id))->not->toBeNull();
+});
+
+test('a manager removes a member', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    membersPage($admin)->call('removeMember', $employee->id)->assertHasNoErrors();
+    membersPage($owner)->call('removeMember', $admin->id)->assertHasNoErrors();
+
+    expect($entity->memberships()->pluck('id')->all())->toBe([$owner->id]);
+});
+
+test('the owner can never be removed', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    membersPage($owner)->call('removeMember', $owner->id)->assertForbidden();
+    membersPage($admin)->call('removeMember', $owner->id)->assertForbidden();
+
+    expect($owner->fresh())->not->toBeNull();
+});
+
+test('the last manager cannot be removed', function () {
+    $entity = Entity::factory()->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    // No owner row at all: the lone admin is the last manager and may not leave.
+    membersPage($admin)->call('removeMember', $admin->id)->assertForbidden();
+    membersPage($admin)->call('removeMember', $employee->id)->assertHasNoErrors();
+
+    expect($admin->fresh())->not->toBeNull();
+});
+
+test('a member can leave and loses the current entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    $this->withSession(['current_entity_id' => $entity->id]);
+
+    membersPage($employee)->call('removeMember', $employee->id)->assertRedirect(route('home'));
+    expect(session('current_entity_id'))->toBeNull();
+
+    membersPage($admin)->call('removeMember', $admin->id)->assertRedirect(route('home'));
+
+    expect($entity->memberships()->count())->toBe(1);
+});
+
+test('an employee cannot remove someone else', function () {
+    $entity = Entity::factory()->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+    $other = EntityMembership::factory()->employee()->for($entity)->create();
+
+    membersPage($employee)->call('removeMember', $other->id)->assertForbidden();
+
+    expect($other->fresh())->not->toBeNull();
+});
+
+test('the bound entity cannot be swapped from the client', function () {
+    $mine = EntityMembership::factory()->owner()->create();
+    $theirs = Entity::factory()->create();
+
+    expect(fn () => membersPage($mine)->set('entity', $theirs->id))
+        ->toThrow('Cannot update locked property');
+});
+
+test('the page offers the add form to managers only and renders in english', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    membersPage($owner)->assertSee('wire:model="email"', false)->assertSee('Adicionar membro');
+    membersPage($employee)->assertDontSee('wire:model="email"', false);
+
+    app()->setLocale('en');
+    membersPage($owner)->assertSee('Add member');
+});
