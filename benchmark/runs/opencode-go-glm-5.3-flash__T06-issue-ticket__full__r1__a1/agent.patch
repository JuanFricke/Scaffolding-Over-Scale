@@ -0,0 +1,32 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Builder;
+use LogicException;
+
+/**
+ * Eloquent query builder for tickets that refuses mass updates touching any
+ * write-once field (Ticket is immutable after issuance except call fields).
+ */
+class TicketBuilder extends Builder
+{
+    /**
+     * The fields a mass update may never change (write-once protection mirrors
+     * the model's `updating` event; mass updates bypass model events).
+     */
+    private const WRITTEN_AT_ISSUANCE = ['queue_id', 'code', 'priority', 'channel', 'issued_at', 'queue'];
+
+    public function update(array $values): int
+    {
+        $disallowed = collect($values)->keys()->intersect(self::WRITTEN_AT_ISSUANCE);
+
+        if ($disallowed->isNotEmpty()) {
+            throw new LogicException(
+                'Ticket fields are immutable after issuance; refusing mass update of ['.$disallowed->implode(', ').'].'
+            );
+        }
+
+        return parent::update($values);
+    }
+}
