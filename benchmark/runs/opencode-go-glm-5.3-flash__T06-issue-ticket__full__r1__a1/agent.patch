+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Issues a customer ticket into a queue.
+ */
+class IssueTicket
+{
+    private const MAX_ATTEMPTS = 5;
+
+    /**
+     * Issue a new ticket in the queue with the next display code.
+     *
+     * The queue state is read from the database inside the transaction (its row
+     * is locked), so a queue deactivated after the caller loaded its model is
+     * still rejected. Nothing is persisted on rejection.
+     *
+     * @throws \InvalidArgumentException on negative priority
+     * @throws InactiveQueueException when the queue is inactive (in the database)
+     * @throws \Throwable on persistent unique (queue_id, code) collisions
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new \InvalidArgumentException(
+                'Priority must be >= 0 (higher = more priority); '.$priority.' given.'
+            );
+        }
+
+        foreach (range(1, self::MAX_ATTEMPTS) as $attempt) {
+            try {
+                return $this->issue($queue, $priority, $channel);
+            } catch (UniqueConstraintViolationException $collision) {
+                if ($attempt === self::MAX_ATTEMPTS) {
+                    throw $collision;
+                }
+            }
+        }
+    }
+
+    private function issue(Queue $queue, int $priority, TicketChannel $channel): Ticket
+    {
+        return DB::transaction(function () use ($queue, $priority, $channel): Ticket {
+            $current = $queue->newQuery()
+                ->whereKey($queue->getOriginal('id') ?? $queue->id)
+                ->lockForUpdate()
+                ->first();
+
+            if ($current === null || ! $current->is_active) {
+                throw new InactiveQueueException(
+                    'Queue ['.$queue->slug.'] is not active.'
+                );
+            }
+
+            return $current->tickets()->create([
+                'code' => Ticket::nextCode($queue->id),
+                'priority' => $priority,
+                'channel' => $channel->value,
+                'status' => TicketStatus::Waiting->value,
+                'issued_at' => now(),
+            ]);
+        });
+    }
+}
