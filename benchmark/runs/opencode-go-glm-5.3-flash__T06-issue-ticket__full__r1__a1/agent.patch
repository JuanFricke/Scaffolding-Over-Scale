diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..4d03692
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,123 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields writable after issuance (besides updated_at).
+     */
+    private const CALL_FIELDS = ['status', 'called_at', 'called_by_user_id'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function newEloquentBuilder($query): TicketBuilder
+    {
+        return new TicketBuilder($query);
+    }
+
+    protected static function booted(): void
+    {
+        // Write-once: after issuance only call fields may change.
+        static::updating(function (self $ticket): void {
+            $disallowed = collect($ticket->getDirty())
+                ->keys()
+                ->reject(fn (string $key) => in_array($key, [...self::CALL_FIELDS, 'updated_at'], true));
+
+            if ($disallowed->isNotEmpty()) {
+                throw new LogicException(
+                    'Ticket ['.$ticket->code.'] fields ['.$disallowed->implode(', ').'] are immutable after issuance.'
+                );
+            }
+        });
+
+        // No cancelled status and no re-issue: keep the state machine tight at the DB boundary too.
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: "last valid code + 1" by insertion order.
+     * The prefix is always "A"; the number is zero padded to at least 3 digits
+     * and grows beyond 999 (A999 -> A1000). Malformed legacy codes are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = static::query()
+            ->where('queue_id', $queueId)
+            ->orderByDesc('id')
+            ->pluck('code');
+
+        foreach ($codes as $code) {
+            if (is_string($code) && preg_match('/^A(\d+)$/', $code, $matches) === 1) {
+                $next = (int) $matches[1] + 1;
+
+                return 'A'.str_pad((string) $next, 3, '0', STR_PAD_LEFT);
+            }
+        }
+
+        return 'A001';
+    }
+
+    /**
+     * Call the ticket exactly once: marks it called and records the attendant.
+     * Only members of the ticket's entity may call; rejected tickets are left unchanged.
+     */
+    public function call(User $user): void
+    {
+        $entityId = $this->queue()->value('entity_id');
+
+        $isMember = EntityMembership::query()
+            ->where('entity_id', $entityId)
+            ->where('user_id', $user->id)
+            ->exists();
+
+        if (! $isMember) {
+            throw new AuthorizationException('User is not a member of the ticket entity.');
+        }
+
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Ticket ['.$this->code.'] was already called.');
+        }
+
+        $this->forceFill([
+            'status' => TicketStatus::Called,
+            'called_at' => now(),
+            'called_by_user_id' => $user->id,
+        ])->save();
+    }
+}
