+<?php
+
+namespace Tests\Feature\Queue;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issuing a ticket persists a waiting virtual ticket with defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+
+    $this->assertDatabaseHas('tickets', [
+        'queue_id' => $queue->id,
+        'code' => 'A001',
+        'status' => 'waiting',
+        'channel' => 'virtual',
+    ]);
+});
+
+test('issuing accepts priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem);
+});
+
+test('negative priority is rejected with InvalidArgumentException', function () {
+    $queue = Queue::factory()->create();
+
+    (new IssueTicket)($queue, -1);
+
+    expect(Ticket::query()->count())->toBe(0);
+})->throws(\InvalidArgumentException::class);
+
+test('inactive queue is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    try {
+        (new IssueTicket)($queue);
+        $this->fail('expected exception');
+    } catch (InactiveQueueException) {
+    }
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('queue deactivated after caller loaded it is still rejected', function () {
+    $queue = Queue::factory()->create();
+    $loaded = Queue::query()->findOrFail($queue->id);
+
+    Queue::query()->whereKey($queue->id)->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($loaded))->toThrow(InactiveQueueException::class);
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('codes grow by insertion order beyond 999', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    expect($issue($queue)->code)->toBe('A001')
+        ->and($issue($queue)->code)->toBe('A002')
+        ->and(Ticket::nextCode($queue->id))->toBe('A003');
+});
+
+test('last valid code A999 yields A1000', function () {
+    $queue = Queue::factory()->create();
+
+    // Seed last valid code via insertion order (A001 -> A999).
+    Ticket::query()->insert([
+        ['queue_id' => $queue->id, 'code' => 'A001', 'priority' => 0, 'channel' => 'virtual', 'status' => 'waiting', 'issued_at' => now(), 'created_at' => now(), 'updated_at' => now()],
+        ['queue_id' => $queue->id, 'code' => 'A999', 'priority' => 0, 'channel' => 'virtual', 'status' => 'waiting', 'issued_at' => now(), 'created_at' => now(), 'updated_at' => now()],
+    ]);
+
+    expect((new IssueTicket)($queue)->code)->toBe('A1000')
+        ->and((new IssueTicket)($queue)->code)->toBe('A1001');
+});
+
+test('deleted ticket numbers are not reused', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    $issue($queue);
+    $t2 = $issue($queue);
+    $issue($queue);
+    expect($t2->code)->toBe('A002');
+
+    $t2->delete();
+
+    expect((new IssueTicket)($queue)->code)->toBe('A004');
+});
+
+test('malformed legacy codes are skipped', function () {
+    $queue = Queue::factory()->create();
+
+    $legacy = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-Y']);
+
+    expect((new IssueTicket)($queue)->code)->toBe('A002');
+});
+
+test('factory forQueue yields sequential codes keeping explicit code', function () {
+    $queue = Queue::factory()->create();
+
+    $t1 = Ticket::factory()->forQueue($queue)->create();
+    $t2 = Ticket::factory()->forQueue($queue)->create();
+    $odd = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect($t1->code)->toBe('A001')
+        ->and($t2->code)->toBe('A002')
+        ->and($odd->code)->toBe('A-X');
+});
+
+test('ticket fields are write-once after issuance', function () {
+    $ticket = Ticket::factory()->create();
+
+    $fresh = Ticket::query()->findOrFail($ticket->id);
+    $fresh->code = 'A999';
+    expect(fn () => $fresh->save())->toThrow(\LogicException::class);
+
+    $fresh2 = Ticket::query()->findOrFail($ticket->id);
+    $fresh2->priority = 5;
+    expect(fn () => $fresh2->save())->toThrow(\LogicException::class);
+
+    expect(fn () => Ticket::query()->whereKey($ticket->id)->update(['priority' => 99]))->toThrow(\LogicException::class);
+
+    expect(Ticket::query()->find($ticket->id)->priority)->toBe(0)
+        ->and(Ticket::query()->find($ticket->id)->code)->toBe('A001');
+});
+
+test('calling marks called and records the attendant', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+    $ticket = Ticket::factory()->forQueue(Queue::factory()->for($entity)->create())->create();
+
+    $ticket->call($user);
+
+    $ticket->refresh();
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->calledBy->is($user))->toBeTrue();
+});
+
+test('calling requires entity membership', function () {
+    $stranger = User::factory()->create();
+    $ticket = Ticket::factory()->create();
+
+    try {
+        $ticket->call($stranger);
+        $this->fail('expected AuthorizationException');
+    } catch (AuthorizationException) {
+    }
+
+    $ticket->refresh();
+    expect($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('calling a non-waiting ticket throws LogicException and stays unchanged', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $ticket->call($user);
+    $calledAt = $ticket->refresh()->called_at;
+
+    expect(fn () => $ticket->call($user))->toThrow(\LogicException::class);
+
+    $ticket->refresh();
+    expect($ticket->called_at->toIso8601String())->toBe($calledAt->toIso8601String());
+});
+
+test('authorization precedes the non-waiting check', function () {
+    $stranger = User::factory()->create();
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $ticket->forceFill(['called_at' => now(), 'status' => TicketStatus::Called])->saveQuietly([]);
+
+    expect(fn () => $ticket->call($stranger))->toThrow(AuthorizationException::class);
+});
