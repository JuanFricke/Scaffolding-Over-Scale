+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Redirect;
+
+class CurrentEntity
+{
+    public function handle($request, Closure $next)
+    {
+        $user = $request->user();
+        if (! $user) {
+            return $next($request);
+        }
+
+        $currentId = session('current_entity_id');
+
+        if (! $currentId) {
+            $count = $user->entity_memberships()->count();
+            if ($count === 0) {
+                return Redirect::route('onboarding');
+            }
+            if ($count === 1) {
+                $entityId = $user->entity_memberships()->first()->entity_id;
+                session(['current_entity_id' => $entityId]);
+            } else {
+                return Redirect::route('entity.switcher');
+            }
+        } else {
+            if (! $user->entity_memberships()->where('entity_id', $currentId)->exists()) {
+                abort(403);
+            }
+        }
+
+        return $next($request);
+    }
+}
