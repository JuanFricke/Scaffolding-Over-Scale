+<?php
+
+namespace App\Livewire\Entity;
+
+use Livewire\Component;
+use Illuminate\Support\Str;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Redirect;
+use Illuminate\Database\QueryException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+
+class CreateEntity extends Component
+{
+    public string $name = '';
+
+    public function submit()
+    {
+        $this->validate([
+            'name' => 'required|string',
+        ]);
+
+        $slugBase = $this->uniqueSlug($this->name);
+        $slug = $slugBase;
+        $i = 1;
+
+        $entity = null;
+        do {
+            try {
+                DB::transaction(function () use (&$entity, $slug) {
+                    $entity = Entity::create([
+                        'name' => $this->name,
+                        'slug' => $slug,
+                    ]);
+                    EntityMembership::create([
+                        'entity_id' => $entity->id,
+                        'user_id' => Auth::id(),
+                        'role' => UserRole::Owner,
+                    ]);
+                });
+                break;
+            } catch (QueryException $e) {
+                if ($this->isDuplicateException($e)) {
+                    $i++;
+                    $slug = $slugBase . '-' . $i;
+                    continue;
+                }
+                throw $e;
+            }
+        } while (true);
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => Auth::id(),
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        return Redirect::route('entity.dashboard', $entity);
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        return Str::slug($name);
+    }
+
+    protected function isDuplicateException(QueryException $e): bool
+    {
+        // SQLite unique violation code is 19, MySQL is 1062
+        return in_array($e->errorInfo[1], [19, 1062]);
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.create-entity');
+    }
+}
