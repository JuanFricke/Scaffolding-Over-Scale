@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    private const MAX_ATTEMPTS = 5;
+
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        $attempts = 0;
+
+        while (true) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    // Re-read the queue inside the transaction (row lock) so a
+                    // queue deactivated after the caller loaded it is rejected.
+                    $fresh = Queue::where('id', $queue->id)->lockForUpdate()->firstOrFail();
+
+                    if (! $fresh->is_active) {
+                        throw new InactiveQueueException("Queue [{$fresh->id}] is inactive.");
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $fresh->id,
+                        'code' => Ticket::nextCode($fresh->id),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (UniqueConstraintViolationException $e) {
+                if (++$attempts >= self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            } catch (QueryException $e) {
+                if (! $this->isUniqueViolation($e) || ++$attempts >= self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        $message = strtolower($e->getMessage());
+
+        return str_contains($message, 'unique')
+            || str_contains($message, 'duplicate')
+            || in_array($e->getCode(), [23000, '23000', '23505', 19, '19'], true);
+    }
+}
