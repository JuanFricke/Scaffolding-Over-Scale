diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..fd45ab4
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,114 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        // Allocate the per-queue display code when none was given (factory,
+        // direct creates). An explicit code is always kept as-is.
+        static::creating(function (self $ticket) {
+            if (empty($ticket->code)) {
+                $ticket->code = static::nextCode((int) $ticket->queue_id);
+            }
+        });
+
+        // Write-once: after issuance only the call fields may change.
+        static::saving(function (self $ticket) {
+            if (! $ticket->exists) {
+                return;
+            }
+
+            $allowed = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+            foreach (array_keys($ticket->getDirty()) as $field) {
+                if (! in_array($field, $allowed, true)) {
+                    throw new LogicException("Ticket [{$ticket->getKey()}] field [{$field}] is immutable after issuance.");
+                }
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for the queue: last valid `A<digits>` code by
+     * insertion order plus one, zero-padded to at least 3 digits.
+     * Malformed legacy codes are skipped; an empty history starts at A001.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = 0;
+
+        foreach (static::where('queue_id', $queueId)->orderBy('id')->pluck('code') as $code) {
+            if (preg_match('/\AA(\d+)\z/', (string) $code, $matches)) {
+                $last = (int) $matches[1];
+            }
+        }
+
+        return 'A'.str_pad((string) ($last + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Mark the ticket as called exactly once, recording who called it.
+     *
+     * @throws LogicException when the ticket is not waiting.
+     * @throws AuthorizationException when the user is not a member of the ticket's entity.
+     */
+    public function call(User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Only waiting tickets can be called.');
+        }
+
+        $isMember = EntityMembership::where('entity_id', $this->queue->entity_id)
+            ->where('user_id', $user->id)
+            ->exists();
+
+        if (! $isMember) {
+            throw new AuthorizationException('Only members of the entity may call tickets.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->save();
+    }
+}
