+test('ticket fields are write-once except status called_at and called_by', function () {
+    $ticket = Ticket::factory()->create();
+
+    foreach (['code' => 'A999', 'priority' => 5, 'channel' => TicketChannel::Totem] as $field => $value) {
+        $ticket->forceFill([$field => $ticket->getAttribute($field)]);
+        $ticket->{$field} = $value;
