--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,75 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Attributes\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+use Illuminate\Auth\Access\AuthorizationException;
+
+#[Fillable(["queue_id", "code", "priority", "channel", "status", "issued_at", "called_at", "called_by_user_id"])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    protected $casts = [
+        'priority' => 'int',
+        'channel' => new \Illuminate\Database\Eloquent\Casts\EnumCast(TicketChannel::class),
+        'status' => new \Illuminate\Database\Eloquent\Casts\EnumCast(TicketStatus::class),
+        'issued_at' => 'datetime',
+        'called_at' => 'datetime',
+    ];
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    public static function nextCode(int $queueId): string
+    {
+        $result = DB::selectOne(
+            "SELECT MAX(CAST(SUBSTRING(code, 2) AS UNSIGNED)) AS maxnum FROM tickets WHERE queue_id = ? AND code REGEXP '^A[0-9]+$'",
+            [$queueId]
+        );
+        $next = ($result->maxnum ?? 0) + 1;
+        return 'A' . str_pad((string)$next, 3, '0', STR_PAD_LEFT);
+    }
+
+    public function call(User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException("Ticket can only be called once.");
+        }
+        if (!$user->membershipFor($this->queue->entity_id)) {
+            throw new \Illuminate\Auth\Access\AuthorizationException("User is not a member of the ticket's entity.");
+        }
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->save();
+    }
+
+    protected static function booted(): void
+    {
+        static::saving(function (self $ticket) {
+            if ($ticket->exists) {
+                $immutable = ['queue_id', 'code', 'priority', 'channel', 'issued_at'];
+                foreach ($ticket->getDirty() as $key => $value) {
+                    if (!in_array($key, $immutable, true)) {
+                        throw new LogicException("Ticket is write-once: cannot modify immutable field '{$key}'.");
+                    }
+                }
+            }
+        });
+    }
+}
