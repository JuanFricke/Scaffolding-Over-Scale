@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+use LogicException;
+
+class IssueTicket
+{
+    /**
+     * Issue a ticket for a queue.
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException("Priority must be >= 0");
+        }
+
+        return DB::transaction(function () use ($queue, $priority, $channel) {
+            $lockedQueue = Queue::where('id', $queue->id)->lockForUpdate()->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException("Cannot issue ticket: queue is inactive");
+            }
+
+            $attempts = 0;
+            $maxAttempts = 3;
+            do {
+                try {
+                    $code = Ticket::nextCode($lockedQueue->id);
+                    $ticket = Ticket::create([
+                        'queue_id' => $lockedQueue->id,
+                        'code' => $code,
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                    return $ticket;
+                } catch (QueryException $e) {
+                    // Duplicate entry: retry
+                    if ($e->getCode() === '23000' && $attempts < $maxAttempts) {
+                        $attempts++;
+                        continue;
+                    }
+                    throw $e;
+                }
+            } while ($attempts < $maxAttempts);
+
+            throw new LogicException("Unable to issue ticket after retrying.");
+        });
+    }
+}
