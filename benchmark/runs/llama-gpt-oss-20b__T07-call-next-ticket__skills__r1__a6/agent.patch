@@ -0,0 +1,95 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+use Illuminate\Database\Eloquent\Attributes\Transactional;
+use App\Enums\TicketStatus;
+
+class CallNextTicket
+{
+    #[Transactional]
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        // Run within a transaction to lock queue and candidate tickets
+        return DB::transaction(function () use ($queue, $calledBy, $mode) {
+            // Lock the queue row to read its current state
+            $lockedQueue = Queue::query()->whereKey($queue->id)->lockForUpdate()->firstOrFail();
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException();
+            }
+
+            // Determine fairness condition only for Any mode
+            $applyNormalOnly = false;
+            if ($mode === CallMode::Any) {
+                // Get last 3 called tickets
+                $lastCalled = Ticket::query()
+                    ->where('queue_id', $lockedQueue->id)
+                    ->where('status', TicketStatus::Called)
+                    ->orderByDesc('called_at')
+                    ->orderByDesc('id')
+                    ->limit(3)
+                    ->get();
+
+                $hasThreePriorities = $lastCalled->count() === 3 && $lastCalled->every(fn (Ticket $t) => $t->priority > 0);
+                $hasNormalWaiting = Ticket::query()
+                    ->where('queue_id', $lockedQueue->id)
+                    ->where('status', TicketStatus::Waiting)
+                    ->where('priority', 0)
+                    ->exists();
+
+                if ($hasThreePriorities && $hasNormalWaiting) {
+                    $applyNormalOnly = true;
+                }
+            }
+
+            // Build base query for waiting tickets of this queue
+            $builder = Ticket::query()
+                ->where('queue_id', $lockedQueue->id)
+                ->where('status', TicketStatus::Waiting);
+
+            // Apply mode-specific filtering
+            if ($mode === CallMode::PriorityOnly) {
+                $builder->where('priority', '>', 0);
+            } elseif ($mode === CallMode::NormalOnly || $applyNormalOnly) {
+                $builder->where('priority', 0);
+            }
+
+            // Apply ordering
+            if ($mode === CallMode::NormalOnly || $applyNormalOnly) {
+                $builder->orderBy('issued_at')->orderBy('id');
+            } else {
+                $builder->orderByDesc('priority')->orderBy('issued_at')->orderBy('id');
+            }
+
+            // Attempt to fetch and call a ticket, retrying if necessary
+            $attempts = 0;
+            while (true) {
+                $candidate = $builder->lockForUpdate()->first();
+                if (! $candidate) {
+                    throw new NoWaitingTicketsException();
+                }
+
+                try {
+                    // Delegate to Ticket::call which enforces membership
+                    $candidate->call($calledBy);
+                    // After call, the ticket is refreshed inside Ticket::call
+                    return $candidate;
+                } catch (LogicException $e) {
+                    // Ticket was no longer waiting; retry
+                    if (++$attempts > 5) {
+                        throw $e; // give up after few attempts
+                    }
+                    continue;
+                }
+            }
+        });
+    }
+}
