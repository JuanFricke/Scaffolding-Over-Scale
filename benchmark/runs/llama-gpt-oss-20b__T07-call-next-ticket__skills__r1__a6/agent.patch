+
+namespace App\Exceptions;
+
+use RuntimeException;
+
+class NoWaitingTicketsException extends RuntimeException
+{
+    public function __construct()
+    {
+        parent::__construct('No waiting tickets available for the requested mode.');
+    }
+}
