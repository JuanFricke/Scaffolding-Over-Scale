@@ -0,0 +1,118 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+class DiscordOpsAlert
+{
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhookUrl = config('services.discord.webhook_url');
+
+        if (empty($webhookUrl)) {
+            return;
+        }
+
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->renderValue((string) $key, $value);
+        }
+
+        $text = implode("\n", $lines);
+
+        if (mb_strlen($text, 'UTF-8') > 1800) {
+            $text = mb_substr($text, 0, 1800, 'UTF-8');
+        }
+
+        try {
+            $response = Http::timeout(5)->post($webhookUrl, [
+                'content' => $text,
+            ]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (Throwable $e) {
+            Log::error('Discord ops alert failed', [
+                'error' => $this->scrub($e->getMessage(), (string) $webhookUrl),
+            ]);
+        }
+    }
+
+    private function renderValue(string $key, mixed $value): string
+    {
+        $redacted = $this->redact($value, $key);
+
+        if (is_array($redacted)) {
+            $encoded = json_encode($redacted, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+
+            return $encoded === false ? '[redacted]' : $encoded;
+        }
+
+        if (is_bool($redacted)) {
+            return $redacted ? 'true' : 'false';
+        }
+
+        if (is_null($redacted)) {
+            return 'null';
+        }
+
+        return (string) $redacted;
+    }
+
+    private function redact(mixed $value, string $key): mixed
+    {
+        if ($this->isSensitiveKey($key)) {
+            return '[redacted]';
+        }
+
+        if (is_string($value) && $this->containsBearer($value)) {
+            return '[redacted]';
+        }
+
+        if (is_array($value)) {
+            $redacted = [];
+
+            foreach ($value as $nestedKey => $nestedValue) {
+                $redacted[$nestedKey] = $this->redact($nestedValue, (string) $nestedKey);
+            }
+
+            return $redacted;
+        }
+
+        return $value;
+    }
+
+    private function isSensitiveKey(string $key): bool
+    {
+        $normalized = strtolower(str_replace(['_', '-'], '', $key));
+
+        foreach (['password', 'token', 'secret', 'authorization', 'apikey', 'webhook'] as $needle) {
+            if (str_contains($normalized, $needle)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function containsBearer(string $value): bool
+    {
+        return preg_match('/Bearer\s+\S+/i', $value) === 1;
+    }
+
+    private function scrub(string $message, string $webhookUrl): string
+    {
+        if ($webhookUrl !== '') {
+            $message = str_replace($webhookUrl, '[redacted]', $message);
+        }
+
+        return $message;
+    }
+}
