diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..d9271cb
--- /dev/null
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -0,0 +1,151 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+test('notifier is resolvable with no constructor arguments', function () {
+    $viaNew = new DiscordOpsAlert;
+    $viaContainer = app(DiscordOpsAlert::class);
+
+    expect($viaNew)->toBeInstanceOf(DiscordOpsAlert::class)
+        ->and($viaContainer)->toBeInstanceOf(DiscordOpsAlert::class);
+});
+
+test('no-op when webhook url is null or empty', function () {
+    Http::fake();
+    config()->set('services.discord.webhook_url', null);
+
+    (new DiscordOpsAlert)->send('T', 'M', ['a' => 'b']);
+
+    Http::assertNothingSent();
+
+    config()->set('services.discord.webhook_url', '');
+
+    (new DiscordOpsAlert)->send('T', 'M', ['a' => 'b']);
+
+    Http::assertNothingSent();
+});
+
+test('posts title message and context lines as content', function () {
+    Http::fake(['*' => Http::response(null, 204)]);
+    config()->set('services.discord.webhook_url', 'https://discord.com/api/webhooks/123/abc');
+
+    (new DiscordOpsAlert)->send('Title here', 'Message here', ['entity_id' => 42, 'queue' => 'asaas-webhooks']);
+
+    Http::assertSent(function ($request) {
+        if ($request->url() !== 'https://discord.com/api/webhooks/123/abc') {
+            return false;
+        }
+        if ($request->method() !== 'POST') {
+            return false;
+        }
+        $data = $request->data();
+
+        return ($data['content'] ?? null) === "Title here\nMessage here\nentity_id=42\nqueue=asaas-webhooks";
+    });
+});
+
+test('truncates long payload to exactly 1800 characters', function () {
+    Http::fake(['*' => Http::response(null, 204)]);
+    config()->set('services.discord.webhook_url', 'https://discord.com/api/webhooks/123/abc');
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 5000));
+
+    Http::assertSent(function ($request) {
+        $content = $request->data()['content'] ?? '';
+
+        return mb_strlen($content, 'UTF-8') === 1800;
+    });
+});
+
+test('redacts sensitive keys bearer values and nested arrays', function () {
+    Http::fake(['*' => Http::response(null, 204)]);
+    config()->set('services.discord.webhook_url', 'https://discord.com/api/webhooks/123/abc');
+
+    (new DiscordOpsAlert)->send('T', 'M', [
+        'password' => 'hunter2',
+        'API_KEY' => 'key-123',
+        'api-key' => 'key-123',
+        'apikey' => 'key-123',
+        'token' => 't',
+        'secret' => 's',
+        'authorization' => 'auth',
+        'webhook' => 'https://discord.com/api/webhooks/evil',
+        'queue' => 'asaas-webhooks',
+        'auth_header' => 'Bearer abc123',
+        'nested' => ['password' => 'x', 'ok' => 'y'],
+    ]);
+
+    Http::assertSent(function ($request) {
+        $content = $request->data()['content'] ?? '';
+
+        return str_contains($content, 'password=[redacted]')
+            && str_contains($content, 'API_KEY=[redacted]')
+            && str_contains($content, 'queue=asaas-webhooks')
+            && str_contains($content, 'auth_header=[redacted]')
+            && ! str_contains($content, 'hunter2')
+            && ! str_contains($content, 'Bearer abc123')
+            && ! str_contains($content, 'key-123');
+    });
+
+    // Nested JSON redaction check separately for clarity.
+    Http::assertSent(function ($request) {
+        $content = $request->data()['content'] ?? '';
+        foreach (explode("\n", $content) as $line) {
+            if (str_starts_with($line, 'nested=')) {
+                $json = substr($line, strlen('nested='));
+                $decoded = json_decode($json, true);
+
+                return is_array($decoded)
+                    && ($decoded['password'] ?? null) === '[redacted]'
+                    && ($decoded['ok'] ?? null) === 'y';
+            }
+        }
+
+        return false;
+    });
+});
+
+test('logs error on non-2xx without throwing and without webhook url', function () {
+    Http::fake(['*' => Http::response('oops', 500)]);
+    config()->set('services.discord.webhook_url', 'https://discord.com/api/webhooks/SECRET_TOKEN');
+    Log::spy();
+
+    $alert = new DiscordOpsAlert;
+    $alert->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once();
+});
+
+test('logs error on transport exception without throwing and scrubs url', function () {
+    Http::fake(function () {
+        throw new ConnectionException('Connection to https://discord.com/api/webhooks/SECRET_TOKEN failed');
+    });
+    config()->set('services.discord.webhook_url', 'https://discord.com/api/webhooks/SECRET_TOKEN');
+    Log::spy();
+
+    $alert = new DiscordOpsAlert;
+    $alert->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once();
+});
+
+test('logging channels are configured', function () {
+    expect(config('logging.channels.daily.driver'))->toBe('daily')
+        ->and(config('logging.channels.daily.path'))->toEndWith('logs/laravel.log')
+        ->and((int) config('logging.channels.daily.days'))->toBe(14)
+        ->and(config('logging.channels.audit.driver'))->toBe('daily')
+        ->and(config('logging.channels.audit.path'))->toEndWith('logs/audit.log')
+        ->and((int) config('logging.channels.audit.days'))->toBe(90)
+        ->and(strtolower((string) config('logging.channels.audit.level')))->toBe('info')
+        ->and(config('logging.channels.stack.channels'))->toContain('daily')
+        ->and(config('logging.channels'))->not->toHaveKey('discord');
+});
+
+test('audit channel accepts writes', function () {
+    Log::channel('audit')->info('Subscription status changed', ['id' => 1]);
+
+    expect(true)->toBeTrue();
+});
