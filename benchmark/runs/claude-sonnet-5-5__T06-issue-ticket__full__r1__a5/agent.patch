+    expect(fn () => Queue::factory()->create(['entity_id' => $queue->entity_id, 'slug' => 'general']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('ticket factory defaults and relations', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->queue)->toBeInstanceOf(Queue::class)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->calledBy)->toBeNull();
+});
+
+test('forQueue allocates sequential codes', function () {
+    $queue = Queue::factory()->create();
+
+    $a = Ticket::factory()->forQueue($queue)->create();
+    $b = Ticket::factory()->forQueue($queue)->create();
+    $other = Ticket::factory()->create();
+
+    expect($a->code)->toBe('A001')
+        ->and($b->code)->toBe('A002')
+        ->and($other->code)->toBe('A001');
+});
+
+test('factory count allocates distinct codes and keeps an explicit code', function () {
+    $queue = Queue::factory()->create();
+
+    $many = Ticket::factory()->forQueue($queue)->count(3)->create();
+    $explicit = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
