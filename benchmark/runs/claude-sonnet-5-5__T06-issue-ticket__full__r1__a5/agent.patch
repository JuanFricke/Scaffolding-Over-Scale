+
+function memberOf(Entity $entity): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $user->id]);
+
+    return $user;
+}
+
+test('enums expose the expected string values', function () {
+    expect(TicketStatus::Waiting->value)->toBe('waiting')
+        ->and(TicketStatus::Called->value)->toBe('called')
+        ->and(TicketChannel::Totem->value)->toBe('totem')
+        ->and(TicketChannel::Virtual->value)->toBe('virtual')
+        ->and(TicketChannel::Printed->value)->toBe('printed');
+});
+
+test('queue factory creates an active queue with its entity and casts', function () {
+    $queue = Queue::factory()->create(['labels_i18n' => ['pt_BR' => 'Fila']]);
+
+    expect($queue->entity)->toBeInstanceOf(Entity::class)
+        ->and($queue->is_active)->toBeTrue()
+        ->and($queue->fresh()->labels_i18n)->toBe(['pt_BR' => 'Fila'])
+        ->and($queue->entity->queues)->toHaveCount(1);
+});
+
+test('queue slug is unique within an entity but not across entities', function () {
