diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..3307abf
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,111 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * The only attributes that may change once the ticket is issued.
+     *
+     * @var list<string>
+     */
+    private const MUTABLE = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    protected static function booted(): void
+    {
+        static::updating(function (Ticket $ticket) {
+            $immutable = array_diff(array_keys($ticket->getDirty()), self::MUTABLE);
+
+            if ($immutable !== []) {
+                throw new LogicException('Ticket is write-once; cannot change: '.implode(', ', $immutable).'.');
+            }
+        });
+    }
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for the queue: `A` + (last valid code's number + 1), zero padded to
+     * 3 digits. "Last" is by insertion order; codes not matching `A<digits>` are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = 0;
+
+        foreach (static::where('queue_id', $queueId)->orderByDesc('id')->pluck('code') as $code) {
+            if (preg_match('/^A(\d+)$/', $code, $m)) {
+                $last = (int) $m[1];
+                break;
+            }
+        }
+
+        return 'A'.str_pad((string) ($last + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call this ticket (once). Only members of the ticket's entity may call.
+     *
+     * @throws AuthorizationException when the user is not a member of the entity
+     * @throws LogicException when the ticket is not waiting
+     */
+    public function call(User $user): void
+    {
+        if (! $user->membershipFor($this->queue->entity_id)) {
+            throw new AuthorizationException('Only members of the ticket\'s entity may call it.');
+        }
+
+        DB::transaction(function () use ($user) {
+            // Re-read under lock: the in-memory status may be stale.
+            $locked = static::query()->lockForUpdate()->findOrFail($this->getKey());
+
+            if ($locked->status !== TicketStatus::Waiting) {
+                throw new LogicException('Ticket was already called.');
+            }
+
+            $locked->status = TicketStatus::Called;
+            $locked->called_at = now();
+            $locked->called_by_user_id = $user->id;
+            $locked->save();
+
+            $this->setRawAttributes($locked->getAttributes(), true);
+            $this->unsetRelation('calledBy');
+        });
+    }
+}
