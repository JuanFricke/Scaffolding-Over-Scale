@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    private const ATTEMPTS = 5;
+
+    /**
+     * Issue the next ticket of a queue.
+     *
+     * @throws InvalidArgumentException when the priority is negative
+     * @throws InactiveQueueException when the queue is inactive (checked in the database, not on $queue)
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    $locked = Queue::query()->lockForUpdate()->findOrFail($queue->getKey());
+
+                    if (! $locked->is_active) {
+                        throw new InactiveQueueException("Queue {$locked->slug} is inactive.");
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $locked->id,
+                        'code' => Ticket::nextCode($locked->id),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (UniqueConstraintViolationException $e) {
+                if ($attempt >= self::ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+    }
+}
