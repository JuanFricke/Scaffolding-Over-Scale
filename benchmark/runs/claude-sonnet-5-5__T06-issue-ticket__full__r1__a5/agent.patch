+<?php
+
+namespace Database\Factories;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\Factories\Factory;
+use Illuminate\Support\Collection;
+
+/**
+ * @extends Factory<Ticket>
+ */
+class TicketFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * `code` is left out: it is allocated per queue when the ticket is stored, unless given.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'queue_id' => Queue::factory(),
+            'priority' => 0,
+            'channel' => TicketChannel::Virtual,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ];
+    }
+
+    public function forQueue(Queue $queue): static
+    {
+        return $this->state(fn (array $attributes) => ['queue_id' => $queue->id]);
+    }
+
+    /**
+     * Allocate the code one ticket at a time, right before each insert, so a batch
+     * (`->count(3)`) gets consecutive codes.
+     */
+    protected function store(Collection $results): void
+    {
+        $results->each(function (Ticket $ticket) {
+            $ticket->code ??= Ticket::nextCode($ticket->queue_id);
+
+            parent::store(new Collection([$ticket]));
+        });
+    }
+}
