diff --git a/tests/Feature/PriorityPrefixTest.php b/tests/Feature/PriorityPrefixTest.php
new file mode 100644
index 0000000..7f85cbb
--- /dev/null
+++ b/tests/Feature/PriorityPrefixTest.php
@@ -0,0 +1,168 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function prefixOwner(Entity $entity): User
+{
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    return $owner;
+}
+
+it('resolves the default prefix by named level and range', function () {
+    expect(Queue::DEFAULT_PREFIX_MAP)->toBe([0 => 'N', 10 => 'P', 20 => 'E'])
+        ->and(Queue::defaultPrefixFor(0))->toBe('N')
+        ->and(Queue::defaultPrefixFor(10))->toBe('P')
+        ->and(Queue::defaultPrefixFor(20))->toBe('E')
+        ->and(Queue::defaultPrefixFor(5))->toBe('P')
+        ->and(Queue::defaultPrefixFor(15))->toBe('P')
+        ->and(Queue::defaultPrefixFor(-5))->toBe('N')
+        ->and(Queue::defaultPrefixFor(25))->toBe('E')
+        ->and(Queue::defaultPrefixFor(100))->toBe('E');
+});
+
+it('prefers custom entries and falls back to the default prefix', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z'],
+    ]);
+
+    expect($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('Z')
+        ->and($queue->prefixForPriority(5))->toBe('P')
+        ->and($queue->prefixForPriority(25))->toBe('E');
+
+    $defaultQueue = Queue::factory()->create();
+
+    expect($defaultQueue->prefixForPriority(0))->toBe('N')
+        ->and($defaultQueue->prefixForPriority(10))->toBe('P')
+        ->and($defaultQueue->prefixForPriority(20))->toBe('E');
+});
+
+it('allows factory creation with a custom map and normalizes an empty map to null', function () {
+    $custom = Queue::factory()->create([
+        'priority_prefix_map' => [0 => 'X', 10 => 'Y', 20 => 'Z'],
+    ]);
+
+    expect($custom->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z']);
+
+    $empty = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($empty->fresh()->priority_prefix_map)->toBeNull();
+
+    $this->assertDatabaseHas('queues', [
+        'id' => $empty->id,
+        'priority_prefix_map' => null,
+    ]);
+});
+
+it('rejects invalid maps whenever a queue is saved', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+})->with([
+    'non-numeric key' => [['foo' => 'X']],
+    'negative key' => [['-1' => 'X']],
+    'leading zero key' => [['010' => 'X']],
+    'lowercase value' => [[0 => 'n']],
+    'multi-character value' => [[0 => 'XX']],
+    'duplicate custom values' => [[0 => 'N', 10 => 'N']],
+    'custom collides with uncovered default' => [[0 => 'E']],
+    'custom collides with another default' => [[5 => 'N']],
+    'custom keys duplicate each other' => [[0 => 'X', 5 => 'X']],
+]);
+
+it('updates the map through UpdateQueue and clears it with an empty array', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: [0 => 'X', 10 => 'Y', 20 => 'Z']);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z'])
+        ->and($queue->fresh()->prefixForPriority(0))->toBe('X');
+
+    (new UpdateQueue)($queue->fresh(), $owner, priorityPrefixMap: []);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull()
+        ->and($queue->fresh()->prefixForPriority(0))->toBe('N');
+});
+
+it('leaves the map unchanged when UpdateQueue omits it', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixOwner($entity);
+    $queue = Queue::factory()->for($entity)->create([
+        'priority_prefix_map' => [0 => 'X', 10 => 'Y', 20 => 'Z'],
+    ]);
+
+    (new UpdateQueue)($queue, $owner, name: 'Renamed');
+
+    expect($queue->fresh()->name)->toBe('Renamed')
+        ->and($queue->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z']);
+});
+
+it('rejects an invalid map from UpdateQueue without changing the queue', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Original']);
+
+    try {
+        (new UpdateQueue)($queue, $owner, name: 'Changed', priorityPrefixMap: [0 => 'N', 10 => 'N']);
+        $this->fail('Expected a validation exception.');
+    } catch (ValidationException $e) {
+        expect($e->errors())->toHaveKey('priority_prefix_map');
+    }
+
+    expect($queue->fresh()->name)->toBe('Original')
+        ->and($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('factory issue_date follows issued_at and auto code uses that day and priority', function () {
+    $queue = Queue::factory()->create();
+
+    $today = Ticket::factory()->forQueue($queue)->create();
+    $backdated = Ticket::factory()->forQueue($queue)->create([
+        'issued_at' => '2026-09-28 10:30:00',
+    ]);
+    $priority = Ticket::factory()->forQueue($queue)->create([
+        'priority' => 10,
+        'issued_at' => '2026-09-28 11:00:00',
+    ]);
+    $explicit = Ticket::factory()->forQueue($queue)->create([
+        'code' => 'N777',
+        'issued_at' => '2026-09-28 12:00:00',
+    ]);
+    $issueDateOnly = Ticket::factory()->forQueue($queue)->create([
+        'issue_date' => '2026-09-30',
+    ]);
+
+    expect($today->code)->toBe('N001')
+        ->and($today->issue_date->toDateString())->toBe(now()->toDateString())
+        ->and($backdated->code)->toBe('N001')
+        ->and($backdated->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($priority->code)->toBe('P001')
+        ->and($priority->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($explicit->code)->toBe('N777')
+        ->and($explicit->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($issueDateOnly->code)->toBe('N001')
+        ->and($issueDateOnly->issue_date->toDateString())->toBe('2026-09-30')
+        ->and($issueDateOnly->issued_at->toDateString())->toBe('2026-09-30');
+});
+
+it('skips codes with fewer than three digits as malformed', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'N01']);
+
+    expect((new IssueTicket)($queue))->code->toBe('N001');
+});
