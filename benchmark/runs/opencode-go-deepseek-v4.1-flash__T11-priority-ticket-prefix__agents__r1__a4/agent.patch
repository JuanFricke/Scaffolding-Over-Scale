+     * values exactly one uppercase A-Z letter. Custom entries plus the default
+     * prefixes for uncovered levels 0/10/20 must all be distinct.
+     *
+     * @param  array<array-key, mixed>|null  $map
+     * @return array<int, string>|null
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function normalizePriorityPrefixMap(?array $map): ?array
+    {
+        if ($map === null || $map === []) {
+            return null;
+        }
+
+        $normalized = [];
+
+        foreach ($map as $priority => $prefix) {
+            $key = self::normalizePriorityKey($priority);
+
+            if (! is_string($prefix) || preg_match('/^[A-Z]$/', $prefix) !== 1) {
+                throw new InvalidArgumentException(
+                    'Priority prefix values must be exactly one uppercase letter A-Z.'
+                );
+            }
+
+            $normalized[$key] = $prefix;
+        }
+
+        ksort($normalized);
+
+        $effectivePrefixes = array_values($normalized);
+
+        foreach (self::PRIORITY_LEVELS as $level) {
+            if (! array_key_exists($level, $normalized)) {
+                $effectivePrefixes[] = self::defaultPrefixFor($level);
+            }
+        }
+
+        if (count($effectivePrefixes) !== count(array_unique($effectivePrefixes))) {
+            throw new InvalidArgumentException(
+                'Priority prefixes must be unique across custom and default priority levels.'
+            );
+        }
+
+        return $normalized;
+    }
+
+    /**
