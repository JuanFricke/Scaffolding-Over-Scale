diff --git a/tests/Feature/EntityDashboardTest.php b/tests/Feature/EntityDashboardTest.php
new file mode 100644
index 0000000..6dc9392
--- /dev/null
+++ b/tests/Feature/EntityDashboardTest.php
@@ -0,0 +1,67 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('an owner sees the dashboard with links, settings and the owner notice', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Acme Filas']);
+    EntityMembership::factory()->owner()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Acme Filas')
+        ->assertSee(__('ui.dashboard_welcome', ['entity' => $entity->name]))
+        ->assertSee(__('ui.nav_members'))
+        ->assertSee(route('entity.members', $entity), false)
+        ->assertSee(__('ui.nav_settings'))
+        ->assertSee(route('entity.settings', $entity), false)
+        ->assertSee('Você é o proprietário desta entidade.');
+});
+
+test('a non-owner member does not see settings or the owner notice', function (string $role) {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->{$role}()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(route('entity.members', $entity), false)
+        ->assertDontSee(route('entity.settings', $entity), false)
+        ->assertDontSee(__('ui.dashboard_owner_notice'));
+})->with(['admin', 'employee']);
+
+test('a non-member gets a 403 even when the session points at another entity', function () {
+    $user = User::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($otherEntity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $otherEntity->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertForbidden();
+});
+
+test('a guest is redirected to login', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('login'));
+});
+
+test('an unverified user is redirected to the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
diff --git a/tests/Feature/EntityMembersTest.php b/tests/Feature/EntityMembersTest.php
new file mode 100644
index 0000000..9079e59
--- /dev/null
+++ b/tests/Feature/EntityMembersTest.php
@@ -0,0 +1,193 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function pegafilaEntityMembersScene(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+
+    $ownerMembership = EntityMembership::factory()->owner()->for($entity)->for($owner)->create();
+    $adminMembership = EntityMembership::factory()->admin()->for($entity)->for($admin)->create();
+    $employeeMembership = EntityMembership::factory()->employee()->for($entity)->for($employee)->create();
+
+    return compact(
+        'entity',
+        'owner',
+        'admin',
+        'employee',
+        'ownerMembership',
+        'adminMembership',
+        'employeeMembership',
+    );
+}
+
+test('a manager can add an existing user by e-mail as an employee', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $newUser = User::factory()->create(['email' => 'new@example.com']);
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', 'new@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors();
+
+    $this->assertDatabaseHas('entity_memberships', [
+        'entity_id' => $entity->id,
+        'user_id' => $newUser->id,
+        'role' => UserRole::Employee->value,
+    ]);
+});
+
+test('adding an existing member is an error on email', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', $employee->email)
+        ->call('addMember')
+        ->assertHasErrors('email');
+
+    expect($entity->memberships()->where('user_id', $employee->id)->count())->toBe(1);
+});
+
+test('adding an unknown e-mail is an error on email', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', 'nobody@example.com')
+        ->call('addMember')
+        ->assertHasErrors('email');
+});
+
+test('an employee cannot add members', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $newUser = User::factory()->create(['email' => 'new@example.com']);
+
+    $this->actingAs($employee);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('email', 'new@example.com')
+        ->call('addMember')
+        ->assertForbidden();
+
+    $this->assertDatabaseMissing('entity_memberships', [
+        'entity_id' => $entity->id,
+        'user_id' => $newUser->id,
+    ]);
+});
+
+test('a manager can assign the admin and employee roles', function (string $role) {
+    extract(pegafilaEntityMembersScene());
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $employeeMembership->id, $role)
+        ->assertHasNoErrors();
+
+    expect($employeeMembership->fresh()->role)->toBe(UserRole::from($role));
+})->with(['admin', 'employee']);
+
+test('assigning the owner role is a validation error on role', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $employeeMembership->id, 'owner')
+        ->assertHasErrors('role');
+
+    expect($employeeMembership->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('an employee cannot assign roles', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $this->actingAs($employee);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $adminMembership->id, 'employee')
+        ->assertForbidden();
+
+    expect($adminMembership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('a membership from another entity cannot be targeted', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $otherEntity = Entity::factory()->create();
+    $otherMembership = EntityMembership::factory()->admin()->for($otherEntity)->create();
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $otherMembership->id, 'employee')
+        ->assertForbidden();
+
+    expect($otherMembership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('the owner can never be removed', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $this->actingAs($owner);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $ownerMembership->id)
+        ->assertForbidden();
+
+    $this->assertDatabaseHas('entity_memberships', ['id' => $ownerMembership->id]);
+});
+
+test('a manager can remove another non-owner member', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $this->actingAs($admin);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $employeeMembership->id);
+
+    $this->assertDatabaseMissing('entity_memberships', ['id' => $employeeMembership->id]);
+});
+
+test('an employee can remove themselves', function () {
+    extract(pegafilaEntityMembersScene());
+
+    $this->actingAs($employee);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $employeeMembership->id);
+
+    $this->assertDatabaseMissing('entity_memberships', ['id' => $employeeMembership->id]);
+});
+
+test('the last manager cannot be removed', function () {
+    $entity = Entity::factory()->create();
+    $admin = User::factory()->create();
+    $membership = EntityMembership::factory()->admin()->for($entity)->for($admin)->create();
+
+    $this->actingAs($admin);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $membership->id)
+        ->assertForbidden();
+
+    $this->assertDatabaseHas('entity_memberships', ['id' => $membership->id]);
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..5b4edf4
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,108 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('the entities table has the required columns and indexes', function () {
+    expect(Schema::hasColumns('entities', ['id', 'name', 'slug', 'created_at', 'updated_at', 'deleted_at']))->toBeTrue();
+
+    $indexes = collect(Schema::getIndexes('entities'))->pluck('name');
+
+    expect($indexes)->toContain('entities_slug_unique');
+});
+
+test('the entity memberships table has the required columns and indexes', function () {
+    expect(Schema::hasColumns('entity_memberships', [
+        'id', 'entity_id', 'user_id', 'role', 'owner_seq', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+
+    $indexes = collect(Schema::getIndexes('entity_memberships'))->pluck('name');
+
+    expect($indexes)->toContain('entity_memberships_entity_user_unique')
+        ->and($indexes)->toContain('entity_memberships_one_owner');
+});
+
+test('entities are bound by slug and support soft deletes', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('an entity exposes its memberships, users and owner', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $employee = User::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->for($owner)->create();
+    EntityMembership::factory()->employee()->for($entity)->for($employee)->create();
+
+    expect($entity->memberships()->count())->toBe(2)
+        ->and($entity->owner()->first()->user_id)->toBe($owner->id)
+        ->and($entity->users()->pluck('users.id')->all())->toBe([$owner->id, $employee->id]);
+});
+
+test('a user exposes memberships, entities and membershipFor', function () {
+    $entity = Entity::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    $membership = EntityMembership::factory()->admin()->for($entity)->for($user)->create();
+
+    expect($user->memberships()->count())->toBe(1)
+        ->and($user->memberships->first()->is($membership))->toBeTrue()
+        ->and($user->entities()->pluck('entities.id')->all())->toBe([$entity->id])
+        ->and($user->membershipFor($entity->id)?->is($membership))->toBeTrue()
+        ->and($user->membershipFor($otherEntity->id))->toBeNull();
+});
+
+test('membership roles are cast and have scopes', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->memberships()->owner()->count())->toBe(1)
+        ->and($entity->memberships()->admin()->count())->toBe(1)
+        ->and($entity->memberships()->employee()->count())->toBe(1)
+        ->and($entity->memberships()->owner()->first()->role)->toBe(UserRole::Owner);
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('the database rejects duplicate memberships for the same user and entity', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    expect(fn () => EntityMembership::factory()->admin()->for($entity)->for($user)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('the user role enum exposes the manageable roles', function () {
+    expect(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee')
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
diff --git a/tests/Feature/EntityPickTest.php b/tests/Feature/EntityPickTest.php
new file mode 100644
index 0000000..d816d51
--- /dev/null
+++ b/tests/Feature/EntityPickTest.php
@@ -0,0 +1,54 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+test('a member can pick an entity and it becomes the current entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    expect(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('a non-member cannot pick an entity and the session is untouched', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => 999])
+        ->post(route('entity.pick', $entity))
+        ->assertForbidden();
+
+    expect(session('current_entity_id'))->toBe(999);
+});
+
+test('picking an entity writes an audit log line', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    $audit = Mockery::mock();
+    Log::shouldReceive('channel')->once()->with('audit')->andReturn($audit);
+    $audit->shouldReceive('info')->once();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity));
+});
+
+test('a guest is redirected to login when picking an entity', function () {
+    $entity = Entity::factory()->create();
+
+    $this->post(route('entity.pick', $entity))
+        ->assertRedirect(route('login'));
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..13a255e
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,101 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function pegafilaEntityPolicyTeam(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $outsider = User::factory()->create();
+
+    $ownerMembership = EntityMembership::factory()->owner()->for($entity)->for($owner)->create();
+    $adminMembership = EntityMembership::factory()->admin()->for($entity)->for($admin)->create();
+    $employeeMembership = EntityMembership::factory()->employee()->for($entity)->for($employee)->create();
+
+    return compact(
+        'entity',
+        'owner',
+        'admin',
+        'employee',
+        'outsider',
+        'ownerMembership',
+        'adminMembership',
+        'employeeMembership',
+    );
+}
+
+test('the entity policy follows the role matrix', function () {
+    extract(pegafilaEntityPolicyTeam());
+
+    $policy = new EntityPolicy;
+
+    expect($policy->create($owner))->toBeTrue()
+        ->and($policy->view($owner, $entity))->toBeTrue()
+        ->and($policy->view($admin, $entity))->toBeTrue()
+        ->and($policy->view($employee, $entity))->toBeTrue()
+        ->and($policy->view($outsider, $entity))->toBeFalse()
+        ->and($policy->update($owner, $entity))->toBeTrue()
+        ->and($policy->update($admin, $entity))->toBeTrue()
+        ->and($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->delete($owner, $entity))->toBeTrue()
+        ->and($policy->delete($admin, $entity))->toBeTrue()
+        ->and($policy->delete($employee, $entity))->toBeFalse()
+        ->and($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse()
+        ->and($policy->manageSettings($employee, $entity))->toBeFalse();
+});
+
+test('the entity policy resolves through gates', function () {
+    extract(pegafilaEntityPolicyTeam());
+
+    expect($owner->can('create', Entity::class))->toBeTrue()
+        ->and($employee->can('view', $entity))->toBeTrue()
+        ->and($outsider->can('view', $entity))->toBeFalse()
+        ->and($admin->can('update', $entity))->toBeTrue()
+        ->and($owner->can('manageSettings', $entity))->toBeTrue()
+        ->and($admin->can('manageSettings', $entity))->toBeFalse();
+});
+
+test('the membership policy allows members to view and managers to assign roles', function () {
+    extract(pegafilaEntityPolicyTeam());
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($employee, $ownerMembership))->toBeTrue()
+        ->and($policy->view($outsider, $ownerMembership))->toBeFalse()
+        ->and($policy->assignRole($owner, $employeeMembership))->toBeTrue()
+        ->and($policy->assignRole($admin, $employeeMembership))->toBeTrue()
+        ->and($policy->assignRole($employee, $employeeMembership))->toBeFalse()
+        ->and($policy->assignRole($outsider, $employeeMembership))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    extract(pegafilaEntityPolicyTeam());
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($owner, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($admin, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($employee, $ownerMembership))->toBeFalse();
+});
+
+test('members can remove themselves and managers can remove other non-owner members', function () {
+    extract(pegafilaEntityPolicyTeam());
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($employee, $employeeMembership))->toBeTrue()
+        ->and($policy->delete($admin, $employeeMembership))->toBeTrue()
+        ->and($policy->delete($owner, $adminMembership))->toBeTrue()
+        ->and($policy->delete($employee, $adminMembership))->toBeFalse()
+        ->and($policy->delete($outsider, $employeeMembership))->toBeFalse();
+});
diff --git a/tests/Feature/EntitySettingsTest.php b/tests/Feature/EntitySettingsTest.php
new file mode 100644
index 0000000..bf5fb4f
--- /dev/null
+++ b/tests/Feature/EntitySettingsTest.php
@@ -0,0 +1,159 @@
+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function pegafilaEntitySettingsScene(): array
+{
+    $entity = Entity::factory()->create(['name' => 'Acme Filas', 'slug' => 'acme']);
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+
+    $ownerMembership = EntityMembership::factory()->owner()->for($entity)->for($owner)->create();
+    $adminMembership = EntityMembership::factory()->admin()->for($entity)->for($admin)->create();
+    $employeeMembership = EntityMembership::factory()->employee()->for($entity)->for($employee)->create();
+
+    return compact(
+        'entity',
+        'owner',
+        'admin',
+        'employee',
+        'ownerMembership',
+        'adminMembership',
+        'employeeMembership',
+    );
+}
+
+test('the owner sees the settings page including transfer ownership', function () {
+    extract(pegafilaEntitySettingsScene());
+
+    $this->actingAs($owner)
+        ->get(route('entity.settings', $entity))
+        ->assertOk()
+        ->assertSee('Acme Filas')
+        ->assertSee('Transferir propriedade')
+        ->assertSee('wire:model="name"', false)
+        ->assertSee('wire:model="slug"', false);
+});
+
+test('non-owners cannot open the settings page', function (string $role) {
+    extract(pegafilaEntitySettingsScene());
+
+    $user = $role === 'outsider' ? User::factory()->create() : ${$role};
+
+    $this->actingAs($user)
+        ->get(route('entity.settings', $entity))
+        ->assertForbidden();
+})->with(['admin', 'employee', 'outsider']);
+
+test('the owner can update the name and slug', function () {
+    extract(pegafilaEntitySettingsScene());
+
+    $this->actingAs($owner);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('name', 'Novo Nome')
+        ->set('slug', 'novo-nome')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    expect($entity->fresh()->name)->toBe('Novo Nome')
+        ->and($entity->fresh()->slug)->toBe('novo-nome');
+});
+
+test('the slug stays valid when unchanged and must be unique otherwise', function () {
+    extract(pegafilaEntitySettingsScene());
+
+    $other = Entity::factory()->create(['slug' => 'outra']);
+
+    $this->actingAs($owner);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('name', 'Acme Filas')
+        ->set('slug', 'acme')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('name', 'Acme Filas')
+        ->set('slug', 'outra')
+        ->call('save')
+        ->assertHasErrors('slug');
+
+    expect($entity->fresh()->slug)->toBe('acme')
+        ->and($other->fresh()->slug)->toBe('outra');
+});
+
+test('deleting an entity soft-deletes it, removes memberships and clears the current entity', function () {
+    extract(pegafilaEntitySettingsScene());
+
+    $this->actingAs($owner)
+        ->withSession(['current_entity_id' => $entity->id]);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->call('delete')
+        ->assertRedirect(route('home'));
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull()
+        ->and(EntityMembership::where('entity_id', $entity->id)->count())->toBe(0)
+        ->and(session('current_entity_id'))->toBeNull();
+});
+
+test('deleting an entity leaves another current entity in the session', function () {
+    extract(pegafilaEntitySettingsScene());
+
+    $other = Entity::factory()->create();
+
+    $this->actingAs($owner)
+        ->withSession(['current_entity_id' => $other->id]);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->call('delete')
+        ->assertRedirect(route('home'));
+
+    expect(session('current_entity_id'))->toBe($other->id);
+});
+
+test('ownership can be transferred to an admin of the entity', function () {
+    extract(pegafilaEntitySettingsScene());
+
+    $this->actingAs($owner);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', (string) $adminMembership->id)
+        ->call('transfer')
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    expect($ownerMembership->fresh()->role)->toBe(UserRole::Admin)
+        ->and($adminMembership->fresh()->role)->toBe(UserRole::Owner)
+        ->and($entity->owner()->first()->id)->toBe($adminMembership->id);
+});
+
+test('ownership cannot be transferred to a non-admin, a member of another entity or the owner', function () {
+    extract(pegafilaEntitySettingsScene());
+
+    $otherEntity = Entity::factory()->create();
+    $foreignAdmin = EntityMembership::factory()->admin()->for($otherEntity)->create();
+
+    $this->actingAs($owner);
+
+    foreach ([$employeeMembership->id, $foreignAdmin->id, $ownerMembership->id, 999999] as $targetId) {
+        Livewire::test(Settings::class, ['entity' => $entity])
+            ->set('targetMembershipId', (string) $targetId)
+            ->call('transfer')
+            ->assertForbidden();
+    }
+
+    expect($ownerMembership->fresh()->role)->toBe(UserRole::Owner)
+        ->and($employeeMembership->fresh()->role)->toBe(UserRole::Employee)
+        ->and($foreignAdmin->fresh()->role)->toBe(UserRole::Admin);
+});
