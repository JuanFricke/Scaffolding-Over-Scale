+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Anyone authenticated may create an entity (onboarding is a later task).
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    public function view(User $user, Entity $entity): bool
+    {
+        return $this->membership($user, $entity) !== null;
+    }
+
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $this->membership($user, $entity)?->role === UserRole::Owner;
+    }
+
+    private function membership(User $user, Entity $entity): ?EntityMembership
+    {
+        return $user->membershipFor($entity->id);
+    }
+
+    private function isManager(User $user, Entity $entity): bool
+    {
+        return in_array(
+            $this->membership($user, $entity)?->role,
+            [UserRole::Owner, UserRole::Admin],
+            true,
+        );
+    }
+}
