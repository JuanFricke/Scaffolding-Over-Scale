+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may see its memberships.
+     */
+    public function view(User $user, EntityMembership $entityMembership): bool
+    {
+        return $user->membershipFor($entityMembership->entity_id) !== null;
+    }
+
+    /**
+     * Owner and admin may assign the manageable roles.
+     */
+    public function assignRole(User $user, EntityMembership $entityMembership): bool
+    {
+        return $this->isManager($user, $entityMembership->entity_id);
+    }
+
+    /**
+     * The owner is never removable; anyone may remove themselves; managers may
+     * remove other non-owner members.
+     */
+    public function delete(User $user, EntityMembership $entityMembership): bool
+    {
+        if ($entityMembership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($entityMembership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->isManager($user, $entityMembership->entity_id);
+    }
+
+    private function isManager(User $user, int $entityId): bool
+    {
+        return in_array(
+            $user->membershipFor($entityId)?->role,
+            [UserRole::Owner, UserRole::Admin],
+            true,
+        );
+    }
+}
