@@ -0,0 +1,110 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|email:strict|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $this->authorize('assignRole', new EntityMembership(['entity_id' => $this->entity->id]));
+
+        $this->validate();
+
+        $user = User::where('email', $this->email)->first();
+
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            $this->addError('email', __('ui.member_already_exists'));
+
+            return;
+        }
+
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->reset('email');
+    }
+
+    public function assignRole(int|string $membershipId, string $role): void
+    {
+        $membership = $this->membership($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        if (! in_array($role, $this->manageableRoles(), true)) {
+            $this->addError('role', __('validation.in', ['attribute' => __('ui.role')]));
+
+            return;
+        }
+
+        abort_if($membership->role === UserRole::Owner, 403);
+
+        $membership->update(['role' => UserRole::from($role)]);
+    }
+
+    public function removeMember(int|string $membershipId): void
+    {
+        $membership = $this->membership($membershipId);
+
+        $this->authorize('delete', $membership);
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            $managerCount = $this->entity->memberships()
+                ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+                ->count();
+
+            abort_if($managerCount <= 1, 403);
+        }
+
+        $membership->delete();
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+        ]);
+    }
+
+    private function membership(int|string $membershipId): EntityMembership
+    {
+        $membership = $this->entity->memberships()->whereKey($membershipId)->first();
+
+        abort_if($membership === null, 403);
+
+        return $membership;
+    }
+
+    /**
+     * @return array<int, string>
+     */
+    private function manageableRoles(): array
+    {
+        return array_map(fn (UserRole $role): string => $role->value, UserRole::manageable());
+    }
+}
