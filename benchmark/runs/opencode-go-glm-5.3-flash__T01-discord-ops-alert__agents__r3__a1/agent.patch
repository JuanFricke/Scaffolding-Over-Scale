diff --git a/CHANGELOG.md b/CHANGELOG.md
index 4bd35fa..7622a8e 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -9,12 +9,16 @@ ## [Unreleased]
 
 ### Added
 
+- Discord ops alert notifier, `App\Ops\DiscordOpsAlert` (`app/Ops/DiscordOpsAlert.php`): explicit, human-pageable incident alerts to a Discord incoming webhook (`DISCORD_WEBHOOK_URL`, config `services.discord.webhook_url`). Silent no-op when unconfigured; sends `{"content": "..."}` (title + message + `key=value` context lines, truncated to 1800 chars) with recursive redaction (sensitive keys, `Bearer <token>` values, nested arrays) and soft-fail error logging that scrubs the webhook URL. Deliberately **not** a Monolog channel (no `logging.channels.discord`).
+- `audit` Monolog channel in `config/logging.php`: driver `daily`, `storage/logs/audit.log`, min level `info` (`LOG_AUDIT_LEVEL`, default `info`), 90 days retention (`LOG_AUDIT_DAYS`), for the durable "who changed what / who tried what" trail.
+- Logging decision guide (archive / audit / alert lanes) in [`docs/ops/logging.md`](docs/ops/logging.md).
 - Database schema and Mermaid diagram in [`docs/database-schema.md`](docs/database-schema.md).
 - Business rules documentation in [`docs/business-rules.md`](docs/business-rules.md): MVP queue management, entity/subscription, roles (admin, owner, employee), tickets, priorities, fairness (3-ticket rule), deterministic call panel, and channels (Flutter totem, web TV, attendant).
 - This changelog (Keep a Changelog).
 
 ### Changed
 
+- Default stack log channel is `daily` (rotated archive) instead of `single`; `LOG_STACK=daily` is the documented default (`.env.example`, pinned in `phpunit.xml`). The `daily` channel's `days` value is now cast to int from `LOG_DAILY_DAYS`.
 - Documented architecture: PegaFilaWeb is a single repository for frontend, backend and totem API; Flutter remains only as a separate client.
 - Simplified model: ticket is single-use (one call; write-once except `called_at`/`called_by`) — removed `ticket_calls` table; ticket knows only its queue (no `totem_id`). `tickets.priority` is now an integer (higher = more prioritized).
 - Expanded financial model: `billing_accounts` (1:0..1 with entity) + `subscriptions` + `plans` isolate financial data. New tables: `payment_options` (cycle, method, discount, refund window) and `payments` (individual charges). `billing_accounts` has `cpf_cnpj`. Subscription 1:1 with `billing_account_id` (UK); history in `payments`. Added `tickets.code`, explicit unique constraints, and circular FK note for owner. Removed per-queue user access limit.
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..0f440b9
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,122 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+/**
+ * Discord ops alert: an explicit, human-pageable incident notifier.
+ *
+ * Observability lanes: archive (Monolog `daily` channel), audit (Monolog `audit`
+ * channel) and alert (this class). Discord must never become a Monolog channel —
+ * call `send()` only for incidents worth waking an operator up for.
+ */
+class DiscordOpsAlert
+{
+    /**
+     * Message ceiling, safely under Discord's 2000-character limit.
+     */
+    private const MAX_CHARS = 1800;
+
+    /**
+     * HTTP timeout in seconds (a few seconds; soft-fail, do not stall callers).
+     */
+    private const TIMEOUT_SECONDS = 5;
+
+    /**
+     * Keys matching any of these (case-insensitive) redact their value.
+     */
+    private const SENSITIVE_KEYS = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    /**
+     * Strings containing a live bearer credential like `Bearer <token>`.
+     */
+    private const BEARER = '/Bearer\s+\S+/i';
+
+    /**
+     * Send one ops alert to the configured Discord webhook.
+     *
+     * A no-op when `services.discord.webhook_url` is not configured. The text is
+     * the title, the message, then one `key=value` line per context entry
+     * (nested arrays rendered as JSON), truncated to {@see MAX_CHARS}. Context
+     * values are redacted before anything leaves the process; failures are
+     * logged to the archive channel and never thrown.
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = trim((string) config('services.discord.webhook_url'));
+
+        if ($url === '') {
+            return;
+        }
+
+        $text = mb_substr(implode("\n", $this->render($title, $message, $context)), 0, self::MAX_CHARS);
+
+        try {
+            $response = Http::asJson()
+                ->timeout(self::TIMEOUT_SECONDS)
+                ->post($url, ['content' => $text]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (Throwable $e) {
+            Log::error('Discord ops alert failed', ['error' => str_replace($url, '[scrubbed]', $e->getMessage())]);
+        }
+    }
+
+    /**
+     * Render the alert text: title + message + redacted `key=value` context lines.
+     *
+     * @return list<string>
+     */
+    private function render(string $title, string $message, array $context): array
+    {
+        $lines = [$title, $message];
+
+        foreach ($this->redact($context) as $key => $value) {
+            $lines[] = $key.'='.(is_array($value) ? $this->toJson($value) : $this->stringify($value));
+        }
+
+        return $lines;
+    }
+
+    /**
+     * Redact a value recursively: sensitive keys and bearer strings become
+     * `[redacted]`, nested arrays are processed with the same rules.
+     */
+    private function redact(mixed $value): mixed
+    {
+        if (is_array($value)) {
+            $redacted = [];
+
+            foreach ($value as $key => $sub) {
+                $redacted[$key] = is_int($key) || $key === ''
+                    ? $this->redact($sub)
+                    : (preg_match(self::SENSITIVE_KEYS, $key) === 1 ? '[redacted]' : $this->redact($sub));
+            }
+
+            return $redacted;
+        }
+
+        return is_string($value) && preg_match(self::BEARER, $value) === 1 ? '[redacted]' : $value;
+    }
+
+    /**
+     * Render a scalar as a plain readable string.
+     */
+    private function stringify(mixed $value): string
+    {
+        return is_scalar($value) || $value === null ? (string) $value : json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
+    }
+
+    /**
+     * Encode an already-redacted nested array for rendering.
+     */
+    private function toJson(array $value): string
+    {
+        return json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
+    }
+}
