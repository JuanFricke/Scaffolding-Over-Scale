diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..c2e7a80
--- /dev/null
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -0,0 +1,147 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use GuzzleHttp\Exception\ConnectException;
+use GuzzleHttp\Psr7\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+function webhookUrl(): string
+{
+    return 'https://discord.com/api/webhooks/123456/very-secret-token';
+}
+
+test('it resolves from the container with no constructor arguments', function () {
+    $alert = app(DiscordOpsAlert::class);
+
+    expect($alert)->toBeInstanceOf(DiscordOpsAlert::class)
+        ->and((new ReflectionClass(DiscordOpsAlert::class))->getConstructor()?->getNumberOfParameters() ?? 0)->toBe(0);
+});
+
+test('it is a silent no-op when no webhook url is configured', function () {
+    config(['services.discord.webhook_url' => null]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Ops incident', 'Queue worker died');
+
+    Http::assertNothingSent();
+});
+
+test('it posts the rendered text to exactly the configured webhook url', function () {
+    config(['services.discord.webhook_url' => webhookUrl()]);
+    Http::fake(['*' => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Ops incident', 'Queue worker died', ['entity_id' => 42]);
+
+    Http::assertSent(function ($request) {
+        return $request->url() === webhookUrl()
+            && $request->hasHeader('Content-Type', 'application/json')
+            && $request['content'] === "Ops incident\nQueue worker died\nentity_id=42";
+    });
+});
+
+test('it renders each context entry as a key=value line', function () {
+    config(['services.discord.webhook_url' => webhookUrl()]);
+    Http::fake(['*' => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message', [
+        'queue' => 'asaas-webhooks',
+        'retries' => 3,
+    ]);
+
+    Http::assertSent(function ($request) {
+        return $request['content'] === "Title\nMessage\nqueue=asaas-webhooks\nretries=3";
+    });
+});
+
+test('it truncates a long message to exactly 1800 characters', function () {
+    config(['services.discord.webhook_url' => webhookUrl()]);
+    Http::fake(['*' => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Título', str_repeat('çãoé', 900));
+
+    Http::assertSent(function ($request) {
+        return mb_strlen($request['content']) === 1800;
+    });
+});
+
+test('it redacts sensitive context keys', function () {
+    config(['services.discord.webhook_url' => webhookUrl()]);
+    Http::fake(['*' => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message', [
+        'password' => 'hunter2',
+        'PaSsWoRd' => 'hunter2',
+        'auth_token' => 'abc123',
+        'API-KEY' => 'abc123',
+        'api_key' => 'abc123',
+        'apikey' => 'abc123',
+        'discord_webhook' => 'https://discord.com/api/webhooks/x/y',
+        'WebHook' => 'https://example.com',
+    ]);
+
+    Http::assertSent(function ($request) {
+        return $request['content'] === "Title\nMessage\npassword=[redacted]\nPaSsWoRd=[redacted]\nauth_token=[redacted]\nAPI-KEY=[redacted]\napi_key=[redacted]\napikey=[redacted]\ndiscord_webhook=[redacted]\nWebHook=[redacted]";
+    });
+});
+
+test('it redacts any string value containing a bearer credential', function () {
+    config(['services.discord.webhook_url' => webhookUrl()]);
+    Http::fake(['*' => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message', [
+        'queue' => 'asaas-webhooks',
+        'note' => 'sent Authorization: Bearer sk_live_abc123 to gateway',
+        'body' => 'Bearer xyz',
+    ]);
+
+    Http::assertSent(function ($request) {
+        return $request['content'] === "Title\nMessage\nqueue=asaas-webhooks\nnote=[redacted]\nbody=[redacted]";
+    });
+});
+
+test('it redacts nested arrays recursively and renders them as json', function () {
+    config(['services.discord.webhook_url' => webhookUrl()]);
+    Http::fake(['*' => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message', [
+        'meta' => [
+            'secret' => 'do-not-leak',
+            'inner' => ['api_key' => 'leaky'],
+            'fine' => 'visible',
+        ],
+    ]);
+
+    Http::assertSent(function ($request) {
+        return $request['content'] === "Title\nMessage\nmeta={\"secret\":\"[redacted]\",\"inner\":{\"api_key\":\"[redacted]\"},\"fine\":\"visible\"}";
+    });
+});
+
+test('it logs an error and never throws when discord answers non-2xx', function () {
+    config(['services.discord.webhook_url' => webhookUrl()]);
+    Http::fake(['*' => Http::response('oops', 500)]);
+    Log::shouldReceive('error')->once()->withArgs(function (string $message, array $logContext) {
+        return $message === 'Discord ops alert failed'
+            && ! str_contains(json_encode($logContext, JSON_THROW_ON_ERROR), webhookUrl());
+    });
+
+    expect(fn () => (new DiscordOpsAlert)->send('Title', 'Message'))->not->toThrow(Throwable::class);
+});
+
+test('it logs a scrubbed error and never throws when the transport fails', function () {
+    config(['services.discord.webhook_url' => webhookUrl()]);
+    Http::fake(function () {
+        throw new ConnectException(
+            'cURL error 28: connection to '.webhookUrl().' timed out',
+            new Request('POST', webhookUrl()),
+        );
+    });
+    Log::shouldReceive('error')->once()->withArgs(function (string $message, array $logContext) {
+        // The scrubbed exception text must not leak the webhook URL or its token.
+        return $message === 'Discord ops alert failed'
+            && ! str_contains(json_encode($logContext, JSON_THROW_ON_ERROR), webhookUrl())
+            && ! str_contains(json_encode($logContext, JSON_THROW_ON_ERROR), 'very-secret-token');
+    });
+
+    expect(fn () => (new DiscordOpsAlert)->send('Title', 'Message'))->not->toThrow(Throwable::class);
+});
diff --git a/tests/Feature/LoggingChannelsTest.php b/tests/Feature/LoggingChannelsTest.php
new file mode 100644
index 0000000..a981949
--- /dev/null
+++ b/tests/Feature/LoggingChannelsTest.php
@@ -0,0 +1,51 @@
+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('daily is the archive channel', function () {
+    $channel = config('logging.channels.daily');
+
+    expect($channel['driver'])->toBe('daily')
+        ->and($channel['path'])->toEndWith('logs/laravel.log')
+        ->and($channel['days'])->toBe(14);
+});
+
+test('daily retention is configurable via LOG_DAILY_DAYS', function () {
+    $_ENV['LOG_DAILY_DAYS'] = '7';
+    $_SERVER['LOG_DAILY_DAYS'] = '7';
+
+    $config = include config_path('logging.php');
+
+    expect($config['channels']['daily']['days'])->toBe(7);
+
+    unset($_ENV['LOG_DAILY_DAYS'], $_SERVER['LOG_DAILY_DAYS']);
+});
+
