--- /dev/null
+++ b/tests/Feature/Entities/PickEntityTest.php
@@ -0,0 +1,74 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+test('picking an entity the user belongs to stores it and redirects to its dashboard', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $entity = $membership->entity;
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('picking an entity the user does not belong to is forbidden and leaves the session alone', function () {
+    $mine = EntityMembership::factory()->owner()->create();
+    $theirs = Entity::factory()->create();
+
+    $this->withSession(['current_entity_id' => $mine->entity_id])
+        ->actingAs($mine->user)
+        ->post(route('entity.pick', $theirs))
+        ->assertForbidden();
+
+    $this->assertSame($mine->entity_id, session('current_entity_id'));
+});
+
+test('a successful pick is written to the audit channel', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    $channel = Mockery::spy();
+    Log::shouldReceive('channel')->with('audit')->andReturn($channel);
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $membership->entity));
+
+    $channel->shouldHaveReceived('info')
+        ->with('Entity picked', [
+            'user_id' => $membership->user_id,
+            'entity_id' => $membership->entity_id,
+        ])
+        ->once();
+});
+
+test('guests cannot pick an entity', function () {
+    $entity = Entity::factory()->create();
+
+    $this->post(route('entity.pick', $entity))
+        ->assertRedirect(route('login'));
+});
+
+test('unverified users cannot pick an entity', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $membership->user->forceFill(['email_verified_at' => null])->save();
+
+    $this->actingAs($membership->user->fresh())
+        ->post(route('entity.pick', $membership->entity))
+        ->assertRedirect(route('verification.notice'));
+
+    $this->assertNull(session('current_entity_id'));
+});
+
+test('a user with no membership at all cannot pick anything', function () {
+    $entity = Entity::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->post(route('entity.pick', $entity))
+        ->assertForbidden();
+});
diff --git a/tests/Feature/Entities/SettingsTest.php b/tests/Feature/Entities/SettingsTest.php
