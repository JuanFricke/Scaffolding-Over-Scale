@@ -0,0 +1,36 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Validation\ValidationException;
+
+class AddEntityMember
+{
+    /**
+     * Add an existing user to the entity as an employee.
+     *
+     * @throws AuthorizationException
+     * @throws ValidationException when the user is already a member
+     */
+    public function handle(Entity $entity, User $member): EntityMembership
+    {
+        Gate::authorize('update', $entity);
+
+        if ($entity->memberships()->where('user_id', $member->id)->exists()) {
+            throw ValidationException::withMessages([
+                'email' => __('ui.member_already_exists'),
+            ]);
+        }
+
+        return $entity->memberships()->create([
+            'user_id' => $member->id,
+            'role' => UserRole::Employee,
+        ]);
+    }
+}
