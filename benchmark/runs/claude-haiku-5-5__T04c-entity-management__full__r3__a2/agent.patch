diff --git a/tests/Feature/Entities/EntityLivewireEndpointTest.php b/tests/Feature/Entities/EntityLivewireEndpointTest.php
new file mode 100644
index 0000000..0e948a3
--- /dev/null
+++ b/tests/Feature/Entities/EntityLivewireEndpointTest.php
@@ -0,0 +1,75 @@
+<?php
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Mechanisms\HandleRequests\EndpointResolver;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Renders the page like a browser would and returns its Livewire snapshot and update URI.
+ *
+ * @return array{0: string, 1: string}
+ */
+function renderEntityPage($test, string $url): array
+{
+    $html = $test->get($url)->getContent();
+
+    preg_match('/wire:snapshot="([^"]+)"/', $html, $snapshot);
+    preg_match('/data-update-uri="([^"]+)"/', $html, $uri);
+
+    return [html_entity_decode($snapshot[1], ENT_QUOTES), html_entity_decode($uri[1], ENT_QUOTES)];
+}
+
+/**
+ * Posts an `addMember` call with the given e-mail to the real Livewire update endpoint.
+ */
+function postAddMemberCall($test, string $snapshot, string $uri, string $email)
+{
+    return $test->withHeaders(['X-Livewire' => 'true'])->postJson($uri, [
+        'components' => [[
+            'snapshot' => $snapshot,
+            'updates' => ['email' => $email],
+            'calls' => [['path' => '', 'method' => 'addMember', 'params' => []]],
+        ]],
+    ]);
+}
+
+test('an owner adds a member through the real Livewire endpoint', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $newcomer = User::factory()->create();
+
+    $this->actingAs($owner->user);
+    [$snapshot, $uri] = renderEntityPage($this, route('entity.members', $owner->entity));
+
+    postAddMemberCall($this, $snapshot, $uri, $newcomer->email)->assertOk();
+
+    $this->assertDatabaseHas('entity_memberships', [
+        'entity_id' => $owner->entity_id,
+        'user_id' => $newcomer->id,
+        'role' => 'employee',
+    ]);
+});
+
+test('an employee is refused by the real Livewire endpoint and nobody is added', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $newcomer = User::factory()->create();
+
+    $this->actingAs($employee->user);
+    [$snapshot, $uri] = renderEntityPage($this, route('entity.members', $owner->entity));
+
+    postAddMemberCall($this, $snapshot, $uri, $newcomer->email)->assertForbidden();
+
+    $this->assertDatabaseMissing('entity_memberships', ['user_id' => $newcomer->id]);
+});
+
+test('the endpoint prefix is the APP_KEY-derived one the page uses', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($owner->user);
+    [, $uri] = renderEntityPage($this, route('entity.members', $owner->entity));
+
+    expect($uri)->toEndWith(EndpointResolver::prefix().'/update');
+});
diff --git a/tests/Feature/Entities/EntityPoliciesTest.php b/tests/Feature/Entities/EntityPoliciesTest.php
new file mode 100644
index 0000000..db8975c
--- /dev/null
+++ b/tests/Feature/Entities/EntityPoliciesTest.php
@@ -0,0 +1,123 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+test('any authenticated user may create an entity', function () {
+    expect(Gate::forUser(User::factory()->create())->allows('create', Entity::class))->toBeTrue();
+});
+
+test('entity abilities follow the caller role', function (string $ability, ?string $role, bool $allowed) {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    if ($role !== null) {
+        EntityMembership::factory()->create([
+            'entity_id' => $entity->id,
+            'user_id' => $user->id,
+            'role' => $role,
+        ]);
+    }
+
+    expect(Gate::forUser($user)->allows($ability, $entity))->toBe($allowed);
+})->with([
+    'member may view' => ['view', 'employee', true],
+    'owner may view' => ['view', 'owner', true],
+    'non-member may not view' => ['view', null, false],
+
+    'owner may update' => ['update', 'owner', true],
+    'admin may update' => ['update', 'admin', true],
+    'employee may not update' => ['update', 'employee', false],
+    'non-member may not update' => ['update', null, false],
+
+    'owner may delete' => ['delete', 'owner', true],
+    'admin may delete' => ['delete', 'admin', true],
+    'employee may not delete' => ['delete', 'employee', false],
+    'non-member may not delete' => ['delete', null, false],
+
+    'owner manages settings' => ['manageSettings', 'owner', true],
+    'admin does not manage settings' => ['manageSettings', 'admin', false],
+    'employee does not manage settings' => ['manageSettings', 'employee', false],
+    'non-member does not manage settings' => ['manageSettings', null, false],
+]);
+
+test('membership view is open to every member of the entity', function (?string $role, bool $allowed) {
+    $target = EntityMembership::factory()->employee()->create();
+    $user = User::factory()->create();
+
+    if ($role !== null) {
+        EntityMembership::factory()->create([
+            'entity_id' => $target->entity_id,
+            'user_id' => $user->id,
+            'role' => $role,
+        ]);
+    }
+
+    expect(Gate::forUser($user)->allows('view', $target))->toBe($allowed);
+})->with([
+    'owner' => ['owner', true],
+    'admin' => ['admin', true],
+    'employee' => ['employee', true],
+    'non-member' => [null, false],
+]);
+
+test('only owner and admin assign roles, and the owner role is never reassigned', function (?string $callerRole, string $targetRole, bool $allowed) {
+    $target = EntityMembership::factory()->create(['role' => $targetRole]);
+
+    if ($callerRole === 'owner' && $targetRole === 'owner') {
+        // An entity has one owner, so the caller is the target itself.
+        $caller = $target->user;
+    } elseif ($callerRole === null) {
+        $caller = User::factory()->create();
+    } else {
+        $caller = EntityMembership::factory()->create([
+            'entity_id' => $target->entity_id,
+            'role' => $callerRole,
+        ])->user;
+    }
+
+    expect(Gate::forUser($caller)->allows('assignRole', $target))->toBe($allowed);
+})->with([
+    'owner promotes an employee' => ['owner', 'employee', true],
+    'owner demotes an admin' => ['owner', 'admin', true],
+    'owner cannot touch the owner role' => ['owner', 'owner', false],
+    'admin assigns roles' => ['admin', 'employee', true],
+    'admin cannot touch the owner role' => ['admin', 'owner', false],
+    'employee assigns nothing' => ['employee', 'employee', false],
+    'non-member assigns nothing' => [null, 'employee', false],
+]);
+
+test('membership deletion rules protect the owner and allow self-removal', function (?string $callerRole, string $targetRole, bool $self, bool $allowed) {
+    $target = EntityMembership::factory()->create(['role' => $targetRole]);
+
+    if ($self) {
+        $caller = $target->user;
+    } elseif ($callerRole === null) {
+        $caller = User::factory()->create();
+    } else {
+        $caller = EntityMembership::factory()->create([
+            'entity_id' => $target->entity_id,
+            'role' => $callerRole,
+        ])->user;
+    }
+
+    expect(Gate::forUser($caller)->allows('delete', $target))->toBe($allowed);
+})->with([
+    'owner removes an employee' => ['owner', 'employee', false, true],
+    'owner removes an admin' => ['owner', 'admin', false, true],
+    'owner cannot remove themself' => ['owner', 'owner', true, false],
+    'admin removes an employee' => ['admin', 'employee', false, true],
+    'admin removes another admin' => ['admin', 'admin', false, true],
+    'admin cannot remove the owner' => ['admin', 'owner', false, false],
+    'admin removes themself' => ['admin', 'admin', true, true],
+    'employee cannot remove a colleague' => ['employee', 'employee', false, false],
+    'employee removes themself' => ['employee', 'employee', true, true],
+    'employee cannot remove an admin' => ['employee', 'admin', false, false],
+    'employee cannot remove the owner' => ['employee', 'owner', false, false],
+    'non-member removes nobody' => [null, 'employee', false, false],
+]);
diff --git a/tests/Feature/Entities/EntitySchemaTest.php b/tests/Feature/Entities/EntitySchemaTest.php
new file mode 100644
index 0000000..b129b33
--- /dev/null
+++ b/tests/Feature/Entities/EntitySchemaTest.php
@@ -0,0 +1,183 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('the unique indexes carry the names the rest of the app relies on', function () {
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))
+        ->toContain('entities_slug_unique');
+
+    expect(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_entity_user_unique')
+        ->toContain('entity_memberships_one_owner');
+});
+
+test('entity slugs are unique', function () {
+    Entity::factory()->create(['slug' => 'padaria']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'padaria']))
+        ->toThrow(QueryException::class);
+});
+
+test('a user has at most one membership per entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(QueryException::class);
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('the database rejects promoting a second member to owner', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(fn () => $employee->update(['role' => UserRole::Owner]))
+        ->toThrow(QueryException::class);
+});
+
+test('owner_seq is 1 for the owner and NULL for everybody else', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect(DB::table('entity_memberships')->where('id', $owner->id)->value('owner_seq'))->toBe(1)
+        ->and(DB::table('entity_memberships')->where('id', $admin->id)->value('owner_seq'))->toBeNull()
+        ->and(DB::table('entity_memberships')->where('id', $employee->id)->value('owner_seq'))->toBeNull();
+});
+
+test('an entity may have many managers and employees alongside its single owner', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->count(3)->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(5);
+});
+
+test('the same user may own one entity and work in another', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $otherEntity = Entity::factory()->create();
+
+    EntityMembership::factory()->employee()->for($otherEntity)->create(['user_id' => $owner->user_id]);
+
+    expect($owner->user->memberships()->count())->toBe(2);
+});
+
+test('deleting a user removes their memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('deleting an entity removes its memberships at the database level', function () {
+    $membership = EntityMembership::factory()->create();
+
+    DB::table('entities')->where('id', $membership->entity_id)->delete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('entities are routed by slug and soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->getRouteKey())->toBe($entity->slug);
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('the membership role defaults to employee and is cast to the enum', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(EntityMembership::query()->owner()->count())->toBe(1)
+        ->and(EntityMembership::query()->admin()->count())->toBe(1)
+        ->and(EntityMembership::query()->employee()->count())->toBe(1);
+});
+
+test('entities expose their memberships, users and owner', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $entity = $owner->entity;
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users)->toHaveCount(2)
+        ->and($entity->owner->is($owner))->toBeTrue();
+});
+
+test('users reach their entities and the membership for a given entity', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+    $user = $membership->user;
+
+    expect($user->entities)->toHaveCount(1)
+        ->and($user->entities->first()->is($membership->entity))->toBeTrue()
+        ->and($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor(0))->toBeNull();
+});
+
+test('soft deleted entities drop out of the user relations', function () {
+    $membership = EntityMembership::factory()->create();
+    $membership->entity->delete();
+
+    expect($membership->user->fresh()->entities)->toHaveCount(0);
+});
+
+test('the membership factory creates its own entity and user as an employee', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->role)->toBe(UserRole::Employee);
+});
+
+test('the membership factory states set the role', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('manageable roles are admin and employee only', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('owner and admin are managers, employees are not', function () {
+    expect(UserRole::Owner->isManager())->toBeTrue()
+        ->and(UserRole::Admin->isManager())->toBeTrue()
+        ->and(UserRole::Employee->isManager())->toBeFalse();
+});
+
+test('user roles use the stored string values', function () {
+    expect(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee');
+});
