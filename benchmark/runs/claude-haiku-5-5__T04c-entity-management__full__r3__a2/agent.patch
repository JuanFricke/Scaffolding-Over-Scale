+test('employees see the members but no management controls', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+
+    // Employees may remove only themselves, so the sole removal button is their own row.
+    $this->actingAs($employee->user)
+        ->get(route('entity.members', $owner->entity))
+        ->assertOk()
+        ->assertDontSee('wire:submit="addMember"', false)
+        ->assertDontSee("wire:click=\"removeMember({$owner->id})\"", false)
+        ->assertDontSee('wire:click="assignRole', false)
+        ->assertSee("wire:click=\"removeMember({$employee->id})\"", false);
