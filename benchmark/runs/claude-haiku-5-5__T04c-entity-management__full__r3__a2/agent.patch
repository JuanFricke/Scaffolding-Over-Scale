+
+test('an admin can add members too', function () {
+    $admin = EntityMembership::factory()->admin()->create();
+    $newcomer = User::factory()->create();
+
+    $this->actingAs($admin->user);
+
+    Livewire::test(Members::class, ['entity' => $admin->entity])
+        ->set('email', $newcomer->email)
+        ->call('addMember')
+        ->assertHasNoErrors();
+
+    expect($admin->entity->memberships()->where('user_id', $newcomer->id)->exists())->toBeTrue();
+});
+
+test('adding an unknown e-mail is a validation error on email', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->set('email', 'ninguem@example.com')
+        ->call('addMember')
+        ->assertHasErrors(['email' => 'exists']);
+});
+
+test('adding members is rate limited so e-mails cannot be probed in bulk', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $newcomer = User::factory()->create(['email' => 'probe@example.com']);
+
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Members::class, ['entity' => $owner->entity]);
+
+    for ($attempt = 0; $attempt < 10; $attempt++) {
+        $component->set('email', 'ninguem'.$attempt.'@example.com')->call('addMember');
+    }
+
+    $component->set('email', $newcomer->email)
+        ->call('addMember')
+        ->assertHasErrors('email');
+
+    expect($owner->entity->memberships()->where('user_id', $newcomer->id)->exists())->toBeFalse();
+});
+
+test('adding a user who is already a member is a validation error on email', function () {
