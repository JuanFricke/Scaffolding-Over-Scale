+namespace App\Models;
+
+enum UserRole: string
+{
+    case Owner = 'owner';
+    case Admin = 'admin';
+    case Employee = 'employee';
+
+    /**
+     * Roles an owner or admin may hand out. The owner role only moves through ownership transfer.
+     *
+     * @return list<self>
+     */
+    public static function manageable(): array
+    {
+        return [self::Admin, self::Employee];
+    }
+
+    /**
+     * Owner and admin run the entity day to day; employees only work in it.
+     */
+    public function isManager(): bool
+    {
+        return $this !== self::Employee;
+    }
+}
