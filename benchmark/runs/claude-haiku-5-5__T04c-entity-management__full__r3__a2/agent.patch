--- /dev/null
+++ b/app/Actions/TransferEntityOwnership.php
@@ -0,0 +1,57 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class TransferEntityOwnership
+{
+    /**
+     * Hand the owner role to another admin. The current owner becomes an admin.
+     *
+     * The owner is demoted before the target is promoted: the unique index on
+     * (entity_id, owner_seq) rejects two owners even inside one transaction.
+     *
+     * @throws AuthorizationException when the caller is not the owner, the target is not
+     *                                another admin of this entity, or the owner row is gone
+     */
+    public function handle(Entity $entity, int $targetMembershipId): EntityMembership
+    {
+        Gate::authorize('manageSettings', $entity);
+
+        return DB::transaction(function () use ($entity, $targetMembershipId) {
+            $owner = $entity->memberships()->owner()->lockForUpdate()->first();
+
+            if ($owner === null || (int) $owner->user_id !== (int) auth()->id()) {
+                throw new AuthorizationException(__('ui.ownership_transfer_not_allowed'));
+            }
+
+            $target = $entity->memberships()
+                ->admin()
+                ->whereKeyNot($owner->getKey())
+                ->lockForUpdate()
+                ->find($targetMembershipId);
+
+            if ($target === null) {
+                throw new AuthorizationException(__('ui.ownership_transfer_not_allowed'));
+            }
+
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+
+            Log::channel('audit')->info('Entity ownership transferred', [
+                'entity_id' => $entity->id,
+                'from_membership_id' => $owner->id,
+                'to_membership_id' => $target->id,
+            ]);
+
+            return $target;
+        });
+    }
+}
