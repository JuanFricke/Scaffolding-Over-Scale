@@ -0,0 +1,42 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class RemoveEntityMember
+{
+    /**
+     * Remove a membership. The last manager of an entity can never be removed.
+     *
+     * @throws AuthorizationException
+     */
+    public function handle(EntityMembership $membership): void
+    {
+        Gate::authorize('delete', $membership);
+
+        if ($membership->role->isManager() && $this->managerCount($membership) <= 1) {
+            throw new AuthorizationException(__('ui.last_manager_cannot_be_removed'));
+        }
+
+        $membership->delete();
+
+        Log::channel('audit')->info('Entity member removed', [
+            'entity_id' => $membership->entity_id,
+            'membership_id' => $membership->id,
+            'role' => $membership->role->value,
+        ]);
+    }
+
+    protected function managerCount(EntityMembership $membership): int
+    {
+        return EntityMembership::query()
+            ->where('entity_id', $membership->entity_id)
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->count();
+    }
+}
