+
+test('an employee cannot add members', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $newcomer = User::factory()->create();
+
+    $this->actingAs($employee->user);
+
+    $component = Livewire::test(Members::class, ['entity' => $owner->entity])
