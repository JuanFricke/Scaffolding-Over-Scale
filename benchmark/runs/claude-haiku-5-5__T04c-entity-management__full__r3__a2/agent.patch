+
+test('the last manager cannot remove themself', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+
+    // Orphan the entity: the owner row goes away, leaving the admin as the only manager.
+    $owner->delete();
+
+    $this->actingAs($admin->user);
+
+    $component = Livewire::test(Members::class, ['entity' => $owner->entity]);
+
+    $component->call('removeMember', $admin->id)->assertForbidden();
