@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\AddEntityMember;
+use App\Actions\AssignEntityMemberRole;
+use App\Actions\RemoveEntityMember;
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|email:strict|exists:users,email')]
+    public string $email = '';
+
+    protected ?string $status = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $this->authorize('update', $this->entity);
+
+        // The e-mail rule reveals whether an address has an account, so bound how fast it can be probed.
+        $key = 'add-member:'.auth()->id();
+
+        if (RateLimiter::tooManyAttempts($key, 10)) {
+            throw ValidationException::withMessages([
+                'email' => __('ui.too_many_member_attempts', ['seconds' => RateLimiter::availableIn($key)]),
+            ]);
+        }
+
+        RateLimiter::hit($key, 60);
+
+        $validated = $this->validate();
+
+        app(AddEntityMember::class)->handle(
+            $this->entity,
+            User::where('email', $validated['email'])->firstOrFail(),
+        );
+
+        $this->reset('email');
+        $this->status = __('ui.member_added');
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        $validated = Validator::make(['role' => $role], [
+            'role' => ['required', Rule::enum(UserRole::class)->only(UserRole::manageable())],
+        ])->validate();
+
+        app(AssignEntityMemberRole::class)->handle($membership, UserRole::from($validated['role']));
+
+        $this->status = __('ui.role_updated');
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('delete', $membership);
+
+        app(RemoveEntityMember::class)->handle($membership);
+
+        if ((int) $membership->user_id === (int) auth()->id()) {
+            if ((int) session('current_entity_id') === $this->entity->id) {
+                session()->forget('current_entity_id');
+            }
+
+            $this->redirectRoute('home');
+
+            return;
+        }
+
+        $this->status = __('ui.member_removed');
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+            'status' => $this->status,
+        ]);
+    }
+}
