+
+test('removals cannot reach a membership of another entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $foreign = EntityMembership::factory()->employee()->create();
+
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Members::class, ['entity' => $owner->entity]);
+
+    expect(fn () => $component->call('removeMember', $foreign->id))
+        ->toThrow(ModelNotFoundException::class);
+
+    $this->assertModelExists($foreign);
+});
diff --git a/tests/Feature/Entities/PickEntityTest.php b/tests/Feature/Entities/PickEntityTest.php
new file mode 100644
