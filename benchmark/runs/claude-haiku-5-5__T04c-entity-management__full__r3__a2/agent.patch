+test('managers get the add member form and role controls', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->employee()->for($owner->entity)->create();
+
+    $this->actingAs($owner->user)
+        ->get(route('entity.members', $owner->entity))
+        ->assertOk()
+        ->assertSee('wire:submit="addMember"', false)
+        ->assertSee('wire:click="assignRole', false)
+        ->assertSee('wire:click="removeMember', false);
+});
+
+test('non-members cannot open the members page', function () {
+    $entity = EntityMembership::factory()->owner()->create()->entity;
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.members', $entity))
+        ->assertForbidden();
+});
+
+test('an owner adds an existing user to the entity as an employee', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $newcomer = User::factory()->create(['email' => 'ana@example.com']);
+
