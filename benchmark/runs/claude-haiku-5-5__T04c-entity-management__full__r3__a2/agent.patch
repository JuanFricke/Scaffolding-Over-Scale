+
+test('transfer is forbidden when the owner row has vanished', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('targetMembershipId', $admin->id);
+
+    $owner->delete();
+
+    $component->call('transfer')->assertForbidden();
