+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the owner sees the settings form and the transfer section', function () {
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => Entity::factory()->create(['name' => 'Padaria Central', 'slug' => 'padaria-central'])->id]);
+
+    $this->actingAs($owner->user)
+        ->get(route('entity.settings', $owner->entity))
+        ->assertOk()
+        ->assertSee('wire:model="name"', false)
+        ->assertSee('wire:model="slug"', false)
+        ->assertSee('Transferir propriedade');
+});
+
+test('the transfer section title is translated', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    app()->setLocale('en');
+
+    $this->actingAs($owner->user)
+        ->get(route('entity.settings', $owner->entity))
+        ->assertSee('Transfer ownership');
+});
+
+test('managers and employees cannot open the settings page', function (string $role) {
+    $owner = EntityMembership::factory()->owner()->create();
+    $member = EntityMembership::factory()->create(['entity_id' => $owner->entity_id, 'role' => $role]);
+
+    $this->actingAs($member->user)
+        ->get(route('entity.settings', $owner->entity))
+        ->assertForbidden();
+})->with(['admin', 'employee']);
+
+test('the settings page is not available to non-members', function () {
+    $entity = EntityMembership::factory()->owner()->create()->entity;
+
+    $this->actingAs(EntityMembership::factory()->owner()->create()->user)
+        ->get(route('entity.settings', $entity))
+        ->assertForbidden();
+});
+
+test('the owner renames the entity and changes its slug', function () {
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => Entity::factory()->create(['slug' => 'antiga'])->id]);
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('name', 'Padaria Nova')
