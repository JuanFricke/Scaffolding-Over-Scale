+        ->assertRedirect(route('entity.settings', ['entity' => 'padaria-nova']));
+
+    $this->assertDatabaseHas('entities', [
+        'id' => $owner->entity_id,
+        'name' => 'Padaria Nova',
+        'slug' => 'padaria-nova',
+    ]);
