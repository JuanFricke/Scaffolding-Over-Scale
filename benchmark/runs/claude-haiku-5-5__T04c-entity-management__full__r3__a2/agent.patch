+
+test('the owner may keep the slug the entity already has', function () {
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => Entity::factory()->create(['slug' => 'mesma'])->id]);
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('name', 'Outro nome')
+        ->call('save')
+        ->assertHasNoErrors();
+});
+
+test('a slug already used by another entity is a validation error on slug', function () {
+    Entity::factory()->create(['slug' => 'ocupada']);
+    $owner = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('slug', 'ocupada')
+        ->call('save')
+        ->assertHasErrors(['slug' => 'unique']);
+});
+
+test('a slug with spaces or symbols is a validation error on slug', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('slug', 'padaria nova!')
+        ->call('save')
+        ->assertHasErrors('slug');
+});
+
+test('a blank name is a validation error on name', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('name', '')
+        ->call('save')
+        ->assertHasErrors('name');
+});
+
+test('an owner demoted mid-session cannot save settings any more', function () {
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => Entity::factory()->create(['name' => 'Original'])->id]);
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Settings::class, ['entity' => $owner->entity]);
+
+    $owner->update(['role' => UserRole::Admin]);
+    $admin->update(['role' => UserRole::Owner]);
+
+    $component->set('name', 'Hackeado')->call('save')->assertForbidden();
+
+    expect($owner->entity->fresh()->name)->toBe('Original');
+});
+
+test('the owner deletes the entity, its memberships and the current-entity session key', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $entity = $owner->entity;
+
+    $this->actingAs($owner->user);
+    session(['current_entity_id' => $entity->id]);
+
+    Livewire::test(Settings::class, ['entity' => $entity])
+        ->call('delete')
