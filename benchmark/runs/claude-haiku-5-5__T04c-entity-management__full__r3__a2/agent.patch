+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $employee->id, 'admin')
+        ->assertHasNoErrors();
+
+    expect($employee->fresh()->role)->toBe(UserRole::Admin);
