@@ -0,0 +1,49 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may see its members.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Owner and admin assign roles. The owner's role only changes through ownership transfer.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $membership->role !== UserRole::Owner
+            && $this->isManagerOf($user, $membership->entity_id);
+    }
+
+    /**
+     * The owner's membership is never removed. Anyone may remove their own membership;
+     * otherwise owner and admin remove members.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->isManagerOf($user, $membership->entity_id);
+    }
+
+    protected function isManagerOf(User $user, int $entityId): bool
+    {
+        return $user->membershipFor($entityId)?->role->isManager() ?? false;
+    }
+}
