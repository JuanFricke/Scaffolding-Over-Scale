+        ->and($employee->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner cannot transfer ownership to themself', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('targetMembershipId', $owner->id);
+
