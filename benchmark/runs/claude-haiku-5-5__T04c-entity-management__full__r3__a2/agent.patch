+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class AssignEntityMemberRole
+{
+    /**
+     * Change a member's role to admin or employee. Callers validate the role first.
+     *
+     * @throws AuthorizationException
+     */
+    public function handle(EntityMembership $membership, UserRole $role): EntityMembership
+    {
+        Gate::authorize('assignRole', $membership);
+
+        $from = $membership->role;
+
+        $membership->update(['role' => $role]);
+
+        Log::channel('audit')->info('Entity member role changed', [
+            'entity_id' => $membership->entity_id,
+            'membership_id' => $membership->id,
+            'from' => $from->value,
+            'to' => $role->value,
+        ]);
+
+        return $membership;
+    }
+}
