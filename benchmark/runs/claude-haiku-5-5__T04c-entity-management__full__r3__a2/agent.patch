+
+test('an admin demotes an admin to employee', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+
+    $this->actingAs(EntityMembership::factory()->admin()->for($owner->entity)->create()->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $admin->id, 'employee')
+        ->assertHasNoErrors();
+
+    expect($admin->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('assigning the owner role is a validation error on role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $employee->id, 'owner')
+        ->assertHasErrors(['role']);
+
+    expect($employee->fresh()->role)->toBe(UserRole::Employee)
+        ->and($owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('an unknown role is a validation error on role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $employee->id, 'superuser')
+        ->assertHasErrors(['role']);
+});
+
+test('an employee cannot assign roles', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $colleague = EntityMembership::factory()->employee()->for($owner->entity)->create();
+
+    $this->actingAs($employee->user);
+
+    $component = Livewire::test(Members::class, ['entity' => $owner->entity]);
+
+    $component->call('assignRole', $colleague->id, 'admin')->assertForbidden();
+
+    expect($colleague->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('role changes cannot reach a membership of another entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $foreign = EntityMembership::factory()->employee()->create();
+
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Members::class, ['entity' => $owner->entity]);
+
+    expect(fn () => $component->call('assignRole', $foreign->id, 'admin'))
+        ->toThrow(ModelNotFoundException::class);
+
+    expect($foreign->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('an owner removes an employee', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $employee->id)
+        ->assertHasNoErrors();
+
+    $this->assertModelMissing($employee);
+});
+
+test('the owner membership can never be removed', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Members::class, ['entity' => $owner->entity]);
+
+    $component->call('removeMember', $owner->id)->assertForbidden();
+
+    $this->assertModelExists($owner);
+});
+
+test('an employee removes themself and is sent home', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+
+    $this->actingAs($employee->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $employee->id)
