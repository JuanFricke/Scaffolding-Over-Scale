diff --git a/tests/Feature/Entity/EntityInvitesTest.php b/tests/Feature/Entity/EntityInvitesTest.php
new file mode 100644
index 0000000..b9161fd
--- /dev/null
+++ b/tests/Feature/Entity/EntityInvitesTest.php
@@ -0,0 +1,443 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Livewire\Entity\PendingInvites;
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Mail;
+use Livewire\Livewire;
+use Psr\Log\LoggerInterface;
+
+uses(RefreshDatabase::class);
+
+test('invite e-mails are normalized to lowercase and trimmed', function () {
+    $invite = EntityInvite::factory()->create(['email' => '  NINA@Example.COM ']);
+
+    expect($invite->fresh()->email)->toBe('nina@example.com');
+});
+
+test('invite factory defaults and expired state', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->entity)->toBeInstanceOf(Entity::class)
+        ->and($invite->role)->toBe(UserRole::Employee)
+        ->and($invite->expires_at->isFuture())->toBeTrue()
+        ->and($invite->accepted_at)->toBeNull()
+        ->and($invite->isPending())->toBeTrue();
+
+    $expired = EntityInvite::factory()->expired()->create();
+
+    expect($expired->isPending())->toBeFalse()
+        ->and($expired->isExpired())->toBeTrue();
+});
+
+test('invites are unique per entity and e-mail', function () {
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']);
+
+    expect(fn () => EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']))
+        ->toThrow(QueryException::class);
+});
+
+test('manager can send an invite: creates, queues mail, audits, resets form', function () {
+    Mail::fake();
+
+    $audit = Mockery::mock(LoggerInterface::class);
+    $audit->shouldReceive('info')->once()->with('Invite sent', Mockery::on(function ($ctx) {
+        return ($ctx['entity_id'] ?? null) !== null && ($ctx['email'] ?? '') === 'nina@example.com';
+    }));
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', '  NINA@Example.COM ')
+        ->set('inviteRole', 'admin')
+        ->call('sendInvite')
+        ->assertHasNoErrors()
+        ->assertSet('inviteEmail', '')
+        ->assertSet('inviteRole', 'employee');
+
+    $invite = EntityInvite::where('entity_id', $entity->id)->first();
+
+    expect($invite)->not->toBeNull()
+        ->and($invite->email)->toBe('nina@example.com')
+        ->and($invite->role)->toBe(UserRole::Admin)
+        ->and($invite->invited_by)->toBe($admin->id)
+        ->and($invite->expires_at->gt(now()->addDays(6)))->toBeTrue()
+        ->and($invite->expires_at->lt(now()->addDays(8)))->toBeTrue();
+
+    Mail::assertQueued(EntityInviteMail::class, function ($mail) {
+        return $mail->hasTo('nina@example.com');
+    });
+});
+
+test('employees cannot send or cancel invites', function () {
+    $employee = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $invite = EntityInvite::factory()->for($entity)->create();
+
+    $this->actingAs($employee);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->assertForbidden();
+
+    expect(EntityInvite::where('entity_id', $entity->id)->count())->toBe(1);
+});
+
+test('sendInvite validates e-mail and role', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'not-an-email')
+        ->set('inviteRole', 'admin')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail' => 'email']);
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'nina@example.com')
+        ->set('inviteRole', 'owner')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteRole' => 'in']);
+
+    expect(EntityInvite::count())->toBe(0);
+});
+
+test('cannot invite an address that already belongs to a member', function () {
+    $admin = User::factory()->create();
+    $member = User::factory()->create(['email' => 'member@example.com']);
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($member)->employee()->create();
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'MEMBER@example.com')
+        ->set('inviteRole', 'admin')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::count())->toBe(0);
+});
+
+test('cannot invite an address with a pending invite, but an expired one may be replaced', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'pending@example.com']);
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'pending@example.com')
+        ->set('inviteRole', 'employee')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::where('email', 'pending@example.com')->count())->toBe(1);
+
+    EntityInvite::factory()->for($entity)->expired()->create(['email' => 'stale@example.com']);
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'stale@example.com')
+        ->set('inviteRole', 'employee')
+        ->call('sendInvite')
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::where('email', 'stale@example.com')->whereNull('accepted_at')->where('expires_at', '>', now())->count())->toBe(1);
+});
+
+test('a unique-constraint race at insert time becomes an error, never a 500', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+
+    // Simulate the race: a pending invite lands after validation passed by
+    // seeding one whose expiry check the component cannot see as pending,
+    // then force the collision through the unique index directly.
+    $this->actingAs($admin);
+    $component = Livewire::test(Members::class, ['entity' => $entity]);
+
+    // Expired row is deleted and replaced normally (no 500)…
+    EntityInvite::factory()->for($entity)->expired()->create(['email' => 'race@example.com']);
+
+    $component->set('inviteEmail', 'race@example.com')
+        ->set('inviteRole', 'employee')
+        ->call('sendInvite')
+        ->assertHasNoErrors();
+
+    // …and a genuine pending duplicate is rejected on the e-mail field.
+    $component->set('inviteEmail', 'race@example.com')
+        ->set('inviteRole', 'employee')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+});
+
+test('successful invites are rate limited per manager and entity', function () {
+    $admin = User::factory()->create();
+    $other = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($other)->admin()->create();
+
+    // Invalid input must not consume the quota.
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'not-an-email')
+        ->set('inviteRole', 'admin')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    for ($i = 0; $i < 10; $i++) {
+        $this->actingAs($admin);
+        Livewire::test(Members::class, ['entity' => $entity])
+            ->set('inviteEmail', "guest{$i}@example.com")
+            ->set('inviteRole', 'employee')
+            ->call('sendInvite')
+            ->assertHasNoErrors();
+    }
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'extra@example.com')
+        ->set('inviteRole', 'employee')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::where('entity_id', $entity->id)->count())->toBe(10);
+
+    // Another manager still has their own quota.
+    $this->actingAs($other);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'extra@example.com')
+        ->set('inviteRole', 'employee')
+        ->call('sendInvite')
+        ->assertHasNoErrors();
+});
+
+test('managers can cancel an invite of their entity', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+    $invite = EntityInvite::factory()->for($entity)->create();
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('cancelInvite', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::find($invite->id))->toBeNull();
+});
+
+test('cancelInvite of a foreign entity invite fails', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->owner()->create();
+    $foreign = EntityInvite::factory()->for($other)->create();
+
+    $this->actingAs($admin);
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('cancelInvite', $foreign->id)
+        ->assertNotFound();
+
+    expect(EntityInvite::find($foreign->id))->not->toBeNull();
+});
+
+test('invitee can accept: membership created, session set, redirected', function () {
+    $owner = User::factory()->create();
