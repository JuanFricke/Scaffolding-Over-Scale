+                        'icon' => 'ticket',
+                        'order' => $index + 1,
+                    ],
+                    'is_active' => true,
+                ];
+            });
+
+        return response()->json([
+            'entity' => [
+                'slug' => $totem->entity->slug,
+                'name' => $totem->entity->name,
+            ],
+            'queues' => $queues,
+        ]);
+    }
+}
