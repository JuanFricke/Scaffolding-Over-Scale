+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Http\Request;
+use Illuminate\Http\Response;
+
+class QueuesController
+{
+    public function index(Request $request, string $entity): Response
+    {
+        /** @var Totem $totem */
+        $totem = $request->attributes->get('totem');
+        /** @var TotemPreset $preset */
+        $preset = $request->attributes->get('preset');
+        /** @var array $jwtClaims */
+        $jwtClaims = $request->attributes->get('jwt_claims');
+
+        if ($totem->entity->slug !== $entity) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $allowedQueueIds = array_intersect(
+            $jwtClaims['queues'] ?? [],
+            $preset->queues()->pluck('queues.id')->toArray()
+        );
+
+        $queues = $totem->entity->queues()
+            ->whereIn('id', $allowedQueueIds)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->map(function ($queue, $index) {
+                return [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => '',
