+<?php
+
+namespace App\Services;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Support\Str;
+
+class TotemJwtService
+{
+    public function generate(Totem $totem, TotemPreset $preset): string
+    {
+        $secret = config('services.totem.jwt_secret');
+        $ttl = config('services.totem.jwt_ttl', 3600);
+
+        if (! $secret) {
+            throw new \RuntimeException('TOTEM_JWT_SECRET not configured');
+        }
+
+        $now = time();
+        $queues = $preset->queues()->pluck('id')->toArray();
+
+        $payload = [
+            'totem_id' => $totem->id,
+            'entity_id' => $totem->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => $queues,
+            'iat' => $now,
+            'exp' => $now + $ttl,
+            'jti' => Str::uuid()->toString(),
+        ];
+
+        return $this->encode($payload, $secret);
+    }
+
+    public function validate(string $token): ?array
+    {
+        $secret = config('services.totem.jwt_secret');
+
+        if (! $secret) {
+            return null;
+        }
+
+        try {
+            $decoded = $this->decode($token, $secret);
+            return (array) $decoded;
+        } catch (\Exception $e) {
+            return null;
+        }
+    }
+
+    private function encode(array $payload, string $secret): string
+    {
+        $header = json_encode(['typ' => 'JWT', 'alg' => 'HS256']);
+        $payload = json_encode($payload);
+
+        $headerB64 = $this->base64UrlEncode($header);
+        $payloadB64 = $this->base64UrlEncode($payload);
+
+        $signature = hash_hmac('sha256', "$headerB64.$payloadB64", $secret, true);
+        $signatureB64 = $this->base64UrlEncode($signature);
+
+        return "$headerB64.$payloadB64.$signatureB64";
+    }
+
+    private function decode(string $token, string $secret): object
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            throw new \Exception('Invalid token format');
+        }
+
+        [$headerB64, $payloadB64, $signatureB64] = $parts;
+
+        $payload = json_decode($this->base64UrlDecode($payloadB64));
+
+        if (! $payload) {
+            throw new \Exception('Invalid payload');
+        }
+
+        $signature = $this->base64UrlDecode($signatureB64);
+        $expectedSignature = hash_hmac('sha256', "$headerB64.$payloadB64", $secret, true);
+
+        if (! hash_equals($signature, $expectedSignature)) {
+            throw new \Exception('Invalid signature');
+        }
+
+        if (isset($payload->exp) && $payload->exp < time()) {
+            throw new \Exception('Token expired');
+        }
+
+        return $payload;
+    }
+
+    private function base64UrlEncode(string $data): string
+    {
+        return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');
+    }
+
+    private function base64UrlDecode(string $data): string
+    {
+        return base64_decode(strtr($data, '-_', '+/') . str_repeat('=', 4 - (strlen($data) % 4)));
+    }
+}
