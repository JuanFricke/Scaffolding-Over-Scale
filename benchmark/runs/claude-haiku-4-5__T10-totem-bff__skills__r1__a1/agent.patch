+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwtService;
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Http\Response;
+
+class TotemAuthMiddleware
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $this->getToken($request);
+
+        if (! $token) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $jwtService = app(TotemJwtService::class);
+        $claims = $jwtService->validate($token);
+
+        if (! $claims) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $totem = Totem::find($claims['totem_id'] ?? null);
+
+        if (! $totem || ! $totem->is_active) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $preset = TotemPreset::find($claims['preset_id'] ?? null);
+
+        if (! $preset || ! $preset->is_active || $preset->entity_id !== $totem->entity_id) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        if ($totem->entity_id !== $claims['entity_id']) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $totem->update(['last_seen_at' => now()]);
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('preset', $preset);
+        $request->attributes->set('jwt_claims', $claims);
+
+        return $next($request);
+    }
+
+    private function getToken(Request $request): ?string
+    {
+        $auth = $request->header('Authorization', '');
+
+        if (str_starts_with($auth, 'Bearer ')) {
+            return substr($auth, 7);
+        }
+
+        return null;
+    }
+}
