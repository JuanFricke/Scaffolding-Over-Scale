+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Http\Response;
+
+class TotemCorsMiddleware
+{
+    public function handle(Request $request, Closure $next, string $endpoint = ''): Response
+    {
+        if ($this->isTotemOrigin($request->header('Origin'))) {
+            return $this->corsResponse($request, $next, $request->header('Origin'));
+        }
+
+        return $next($request);
+    }
+
+    private function corsResponse(Request $request, Closure $next, string $origin): Response
+    {
+        if ($request->isMethod('OPTIONS')) {
+            return response('', 204)
+                ->header('Access-Control-Allow-Origin', $origin)
+                ->header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
+                ->header('Access-Control-Allow-Headers', 'Content-Type, Authorization')
+                ->header('Access-Control-Max-Age', '86400');
+        }
+
+        $response = $next($request);
+
+        return $response
+            ->header('Access-Control-Allow-Origin', $origin)
+            ->header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
+            ->header('Access-Control-Allow-Headers', 'Content-Type, Authorization');
+    }
+
+    private function isTotemOrigin(?string $origin): bool
+    {
+        if (! $origin) {
+            return false;
+        }
+
+        // Allow localhost:* and 127.0.0.1:*
+        if (preg_match('~^https?://(localhost|127\.0\.0\.1)(:\d+)?$~i', $origin)) {
+            return true;
+        }
+
+        // Allow optional TOTEM_WEB_ORIGIN env var
+        $totemWebOrigin = config('services.totem.web_origin');
+        if ($totemWebOrigin && $origin === $totemWebOrigin) {
+            return true;
+        }
+
+        return false;
+    }
+}
