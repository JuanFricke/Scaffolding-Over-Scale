+<?php
+
+namespace Tests\Feature\Totem;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwtService;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use PHPUnit\Framework\Attributes\Test;
+use Tests\TestCase;
+
+class TicketEndpointTest extends TestCase
+{
+    use RefreshDatabase;
+{
+    #[Test]
+    public function issues_ticket_with_valid_priority(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create(['slug' => 'general']);
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $preset->queues()->attach($queue);
+
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        $response = $this->postJson('/api/'.$entity->slug.'/general/ticket',
+            ['priority' => 0],
+            ['Authorization' => 'Bearer '.$token]
+        );
+
+        $response->assertStatus(201)
+            ->assertJsonStructure([
+                'slug',
+                'queue' => ['slug', 'label'],
+                'priority' => ['value', 'label'],
+                'issued_at',
+            ])
+            ->assertJson([
+                'queue' => ['slug' => 'general'],
+                'priority' => ['value' => 0, 'label' => 'Normal'],
+            ]);
+
+        $this->assertDatabaseHas('tickets', [
+            'queue_id' => $queue->id,
+            'priority' => 0,
+            'channel' => 'totem',
+            'status' => 'waiting',
+        ]);
+    }
+
+    #[Test]
+    public function issues_priority_ticket(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $preset->queues()->attach($queue);
+
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        $response = $this->postJson('/api/'.$entity->slug.'/'.$queue->slug.'/ticket',
+            ['priority' => 10],
+            ['Authorization' => 'Bearer '.$token]
+        );
+
+        $response->assertStatus(201)
+            ->assertJson([
+                'priority' => ['value' => 10, 'label' => 'Prioritário'],
+            ]);
+    }
+
+    #[Test]
+    public function rejects_invalid_priority(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $preset->queues()->attach($queue);
+
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        $response = $this->postJson('/api/'.$entity->slug.'/'.$queue->slug.'/ticket',
+            ['priority' => 99],
+            ['Authorization' => 'Bearer '.$token]
+        );
+
+        $response->assertStatus(422)
+            ->assertJson(['code' => 'invalid_priority']);
+    }
+
+    #[Test]
+    public function rejects_inactive_queue(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create(['is_active' => false]);
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $preset->queues()->attach($queue);
+
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        $response = $this->postJson('/api/'.$entity->slug.'/'.$queue->slug.'/ticket',
+            ['priority' => 0],
+            ['Authorization' => 'Bearer '.$token]
+        );
+
+        $response->assertStatus(422)
+            ->assertJson(['code' => 'inactive_queue']);
+    }
+
+    #[Test]
+    public function rejects_unknown_queue(): void
+    {
+        $entity = Entity::factory()->create();
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        $response = $this->postJson('/api/'.$entity->slug.'/unknown/ticket',
+            ['priority' => 0],
+            ['Authorization' => 'Bearer '.$token]
+        );
+
+        $response->assertStatus(404)
+            ->assertJson(['code' => 'queue_not_found']);
+    }
+
+    #[Test]
+    public function rejects_queue_outside_preset_scope(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue1 = Queue::factory()->for($entity)->create();
+        $queue2 = Queue::factory()->for($entity)->create();
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $preset->queues()->attach([$queue1->id]);
+
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        $response = $this->postJson('/api/'.$entity->slug.'/'.$queue2->slug.'/ticket',
+            ['priority' => 0],
+            ['Authorization' => 'Bearer '.$token]
+        );
+
+        $response->assertStatus(403)
+            ->assertJson(['code' => 'forbidden']);
+    }
+
+    #[Test]
+    public function rate_limits_ticket_issuance(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $preset->queues()->attach($queue);
+
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        for ($i = 0; $i < 31; $i++) {
+            $this->postJson('/api/'.$entity->slug.'/'.$queue->slug.'/ticket',
+                ['priority' => 0],
+                ['Authorization' => 'Bearer '.$token]
+            );
+        }
+
+        $response = $this->postJson('/api/'.$entity->slug.'/'.$queue->slug.'/ticket',
+            ['priority' => 0],
+            ['Authorization' => 'Bearer '.$token]
+        );
+
+        $response->assertStatus(429)
+            ->assertJson(['code' => 'rate_limited']);
+    }
+}
