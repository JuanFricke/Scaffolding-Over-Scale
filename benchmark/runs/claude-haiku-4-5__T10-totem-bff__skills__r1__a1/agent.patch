+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+
+class TotemPairingCodeCommand extends Command
+{
+    protected $signature = 'totem:pairing-code {preset : The preset ID}';
+
+    protected $description = 'Generate a 6-digit pairing code for a totem preset';
+
+    public function handle(): int
+    {
+        $preset = TotemPreset::find($this->argument('preset'));
+
+        if (! $preset) {
+            $this->error("Preset not found.");
+            return 1;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->update([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ]);
+
+        $this->line($code);
+
+        return 0;
+    }
+}
diff --git a/app/Http/Controllers/Totem/AuthController.php b/app/Http/Controllers/Totem/AuthController.php
new file mode 100644
index 0000000..77106fd
--- /dev/null
+++ b/app/Http/Controllers/Totem/AuthController.php
@@ -0,0 +1,98 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwtService;
+use Illuminate\Http\Request;
+use Illuminate\Http\Response;
+use Illuminate\Support\Facades\DB;
+
+class AuthController
+{
+    public function auth(Request $request, TotemJwtService $jwtService): Response
+    {
+        $code = $request->input('code', '');
+
+        if (! $this->isValidCodeFormat($code)) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        // Find preset without lock to validate first
+        $preset = TotemPreset::where('login_code', $code)->first();
+
+        if (! $this->isValidCode($preset)) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        // Lock preset row for atomicity
+        $result = DB::transaction(function () use ($preset, $jwtService) {
+            $preset = TotemPreset::query()
+                ->where('login_code', $preset->login_code)
+                ->lockForUpdate()
+                ->first();
+
+            // Re-validate in case state changed
+            if (! $this->isValidCode($preset)) {
+                return null;
+            }
+
+            $totem = Totem::updateOrCreate(
+                ['entity_id' => $preset->entity_id],
+                [
+                    'name' => $preset->name,
+                    'is_active' => true,
+                    'last_seen_at' => now(),
+                ]
+            );
+
+            $preset->update(['login_code_consumed_at' => now()]);
+
+            $token = $jwtService->generate($totem, $preset);
+            $ttl = config('services.totem.jwt_ttl', 3600);
+
+            return [
+                'token' => $token,
+                'token_type' => 'Bearer',
+                'expires_in' => $ttl,
+                'entity' => [
+                    'slug' => $preset->entity->slug,
+                    'name' => $preset->entity->name,
+                ],
+            ];
+        });
+
+        if (! $result) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        return response()->json($result, 200);
+    }
+
+    private function isValidCodeFormat(string $code): bool
+    {
+        return preg_match('/^\d{6}$/', $code) === 1;
+    }
+
+    private function isValidCode(?TotemPreset $preset): bool
+    {
+        if (! $preset) {
+            return false;
+        }
+
+        if (! $preset->is_active) {
+            return false;
+        }
+
+        if ($preset->login_code_consumed_at !== null) {
+            return false;
+        }
+
+        if ($preset->login_code_expires_at && $preset->login_code_expires_at->isPast()) {
+            return false;
+        }
+
+        return true;
+    }
+}
