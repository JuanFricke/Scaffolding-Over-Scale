+use App\Services\TotemJwtService;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use PHPUnit\Framework\Attributes\Test;
+use Tests\TestCase;
+
+class QueuesEndpointTest extends TestCase
+{
+    use RefreshDatabase;
+{
+    #[Test]
+    public function returns_queues_for_preset_scope(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue1 = Queue::factory()->for($entity)->create(['name' => 'Queue A', 'slug' => 'queue-a']);
+        $queue2 = Queue::factory()->for($entity)->create(['name' => 'Queue B', 'slug' => 'queue-b']);
+        $queue3 = Queue::factory()->for($entity)->create(['name' => 'Queue C', 'slug' => 'queue-c']);
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $preset->queues()->attach([$queue1->id, $queue2->id]);
+
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        $response = $this->getJson('/api/'.$entity->slug.'/queues', [
+            'Authorization' => 'Bearer '.$token,
+        ]);
+
+        $response->assertStatus(200)
+            ->assertJsonStructure([
+                'entity' => ['slug', 'name'],
+                'queues',
+            ])
+            ->assertJson([
+                'entity' => ['slug' => $entity->slug],
+                'queues' => [
+                    ['slug' => 'queue-a', 'label' => 'Queue A'],
+                    ['slug' => 'queue-b', 'label' => 'Queue B'],
+                ],
+            ]);
+
+        $this->assertCount(2, $response->json('queues'));
+    }
+
+    #[Test]
+    public function only_returns_active_queues(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue1 = Queue::factory()->for($entity)->create(['is_active' => true]);
+        $queue2 = Queue::factory()->for($entity)->create(['is_active' => false]);
+
+        $preset = TotemPreset::factory()->for($entity)->create();
+        $preset->queues()->attach([$queue1->id, $queue2->id]);
+
+        $totem = Totem::factory()->for($entity)->create();
+        $token = app(TotemJwtService::class)->generate($totem, $preset);
+
+        $response = $this->getJson('/api/'.$entity->slug.'/queues', [
+            'Authorization' => 'Bearer '.$token,
+        ]);
+
+        $this->assertCount(1, $response->json('queues'));
+    }
+
+    #[Test]
+    public function rejects_mismatched_entity_slug(): void
+    {
+        $entity = Entity::factory()->create(['slug' => 'entity-1']);
+        $otherEntity = Entity::factory()->create(['slug' => 'entity-2']);
+
+        $totem = Totem::factory()->for($entity)->create();
