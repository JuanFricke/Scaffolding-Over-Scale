+<?php
+
+namespace Tests\Feature\Totem;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use PHPUnit\Framework\Attributes\Test;
+use Tests\TestCase;
+
+class AuthEndpointTest extends TestCase
+{
+    use RefreshDatabase;
+{
+    #[Test]
+    public function returns_token_with_valid_code(): void
+    {
+        $entity = Entity::factory()->create();
+        $preset = TotemPreset::factory()
+            ->for($entity)
+            ->create([
+                'login_code' => '123456',
+                'login_code_expires_at' => now()->addMinutes(5),
+                'login_code_consumed_at' => null,
+            ]);
+        $queue = Queue::factory()->for($entity)->create();
+        $preset->queues()->attach($queue);
+
+        $response = $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+        $response->assertStatus(200)
+            ->assertJsonStructure([
+                'token',
+                'token_type',
+                'expires_in',
+                'entity' => ['slug', 'name'],
+            ])
+            ->assertJson(['token_type' => 'Bearer']);
+
+        $this->assertNotNull($response->json('token'));
+        $this->assertEquals(3600, $response->json('expires_in'));
+    }
+
+    #[Test]
+    public function marks_code_as_consumed(): void
+    {
+        $preset = TotemPreset::factory()
+            ->create([
+                'login_code' => '123456',
+                'login_code_expires_at' => now()->addMinutes(5),
+                'login_code_consumed_at' => null,
+            ]);
+
+        $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+        $preset->refresh();
+        $this->assertNotNull($preset->login_code_consumed_at);
+    }
+
+    #[Test]
+    public function creates_totem_row_on_auth(): void
+    {
+        $entity = Entity::factory()->create();
+        $preset = TotemPreset::factory()
+            ->for($entity)
+            ->create([
+                'login_code' => '123456',
+                'login_code_expires_at' => now()->addMinutes(5),
+                'login_code_consumed_at' => null,
+            ]);
+
+        $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+        $this->assertDatabaseHas('totems', [
+            'entity_id' => $entity->id,
+            'is_active' => true,
+        ]);
+        $this->assertDatabaseHas('totems', [
+            'last_seen_at' => now(),
+        ]);
+    }
+
+    #[Test]
+    public function rejects_invalid_code_format(): void
+    {
+        $response = $this->postJson('/api/totem/auth', ['code' => 'invalid']);
+
+        $response->assertStatus(400)
+            ->assertJson(['code' => 'invalid_code_format']);
+    }
+
+    #[Test]
+    public function rejects_code_with_wrong_length(): void
+    {
+        $response = $this->postJson('/api/totem/auth', ['code' => '12345']);
+
+        $response->assertStatus(400)
+            ->assertJson(['code' => 'invalid_code_format']);
+    }
+
+    #[Test]
+    public function rejects_empty_code(): void
+    {
+        $response = $this->postJson('/api/totem/auth', ['code' => '']);
+
+        $response->assertStatus(400)
+            ->assertJson(['code' => 'invalid_code_format']);
+    }
+
+    #[Test]
+    public function rejects_unknown_code(): void
+    {
+        $response = $this->postJson('/api/totem/auth', ['code' => '999999']);
+
+        $response->assertStatus(401)
+            ->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    #[Test]
+    public function rejects_expired_code(): void
+    {
+        TotemPreset::factory()
+            ->create([
+                'login_code' => '123456',
+                'login_code_expires_at' => now()->subMinutes(1),
+                'login_code_consumed_at' => null,
+            ]);
+
+        $response = $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+        $response->assertStatus(401)
+            ->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    #[Test]
+    public function rejects_consumed_code(): void
+    {
+        TotemPreset::factory()
+            ->create([
+                'login_code' => '123456',
+                'login_code_expires_at' => now()->addMinutes(5),
+                'login_code_consumed_at' => now()->subMinutes(1),
+            ]);
+
+        $response = $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+        $response->assertStatus(401)
+            ->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    #[Test]
+    public function rejects_inactive_preset(): void
+    {
+        TotemPreset::factory()
+            ->create([
+                'login_code' => '123456',
+                'login_code_expires_at' => now()->addMinutes(5),
+                'login_code_consumed_at' => null,
+                'is_active' => false,
+            ]);
+
+        $response = $this->postJson('/api/totem/auth', ['code' => '123456']);
+
+        $response->assertStatus(401)
+            ->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    #[Test]
+    public function rate_limits_auth_attempts(): void
+    {
+        for ($i = 0; $i < 11; $i++) {
+            $this->postJson('/api/totem/auth', ['code' => sprintf('%06d', $i)]);
+        }
+
+        $response = $this->postJson('/api/totem/auth', ['code' => '999999']);
+
+        $response->assertStatus(429)
+            ->assertJson(['code' => 'rate_limited']);
+    }
+}
