+
+        $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+            ->assertExitCode(0);
+
+        $preset->refresh();
+        $this->assertNotNull($preset->login_code);
+        $this->assertRegExp('/^\d{6}$/', $preset->login_code);
+    }
+
+    #[Test]
+    public function sets_code_expiry_to_10_minutes(): void
+    {
+        $preset = TotemPreset::factory()->create();
+        $now = now();
+
+        $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+            ->assertExitCode(0);
+
+        $preset->refresh();
+        $this->assertTrue($preset->login_code_expires_at->isBetween(
+            $now->addMinutes(9),
+            $now->addMinutes(11)
+        ));
+    }
+
+    #[Test]
+    public function clears_consumed_flag_on_regenerate(): void
+    {
+        $preset = TotemPreset::factory()
+            ->create([
+                'login_code' => '123456',
+                'login_code_consumed_at' => now(),
+            ]);
+
+        $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+            ->assertExitCode(0);
+
+        $preset->refresh();
+        $this->assertNull($preset->login_code_consumed_at);
+        $this->assertNotEquals('123456', $preset->login_code);
+    }
+
+    #[Test]
+    public function fails_for_unknown_preset(): void
+    {
+        $this->artisan('totem:pairing-code', ['preset' => 999])
+            ->assertExitCode(1);
+    }
+
+    #[Test]
+    public function outputs_code_to_console(): void
+    {
+        $preset = TotemPreset::factory()->create();
+
+        $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+            ->expectsOutput($preset->fresh()->login_code);
+    }
+}
