+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Http\Request;
+use Illuminate\Http\Response;
+
+class TicketsController
+{
+    private const VALID_PRIORITIES = [0, 10, 20];
+
+    public function store(Request $request, string $entity, string $queue, IssueTicket $issueTicket): Response
+    {
+        /** @var Totem $totem */
+        $totem = $request->attributes->get('totem');
+        /** @var TotemPreset $preset */
+        $preset = $request->attributes->get('preset');
+        /** @var array $jwtClaims */
+        $jwtClaims = $request->attributes->get('jwt_claims');
+
+        if ($totem->entity->slug !== $entity) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $queueModel = $totem->entity->queues()
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $queueModel) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        $allowedQueueIds = array_intersect(
+            $jwtClaims['queues'] ?? [],
+            $preset->queues()->pluck('queues.id')->toArray()
+        );
+
+        if (! in_array($queueModel->id, $allowedQueueIds)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priority = $request->input('priority');
+
+        if (! in_array($priority, self::VALID_PRIORITIES)) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        $ticket = $issueTicket($queueModel, $priority, TicketChannel::Totem);
+
+        $priorityLabel = $this->getPriorityLabel($priority);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $queueModel->slug,
+                'label' => $queueModel->name,
+            ],
+            'priority' => [
+                'value' => $priority,
+                'label' => $priorityLabel,
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+
+    private function getPriorityLabel(int $priority): string
+    {
+        return match ($priority) {
+            0 => 'Normal',
+            10 => 'Prioritário',
+            20 => 'Prioridade 80+',
+            default => 'Unknown',
+        };
+    }
+}
