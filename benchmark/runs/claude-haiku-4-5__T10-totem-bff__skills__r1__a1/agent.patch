+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Http\Request;
+use Illuminate\Http\Response;
+
+class PrioritiesController
+{
+    private const PRIORITIES = [
+        0 => ['label' => 'Normal', 'color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+        10 => ['label' => 'Prioritário', 'color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+        20 => ['label' => 'Prioridade 80+', 'color' => '#D4A017', 'icon' => 'senior', 'order' => 3],
+    ];
+
+    public function show(Request $request, string $entity, string $queue): Response
+    {
+        /** @var Totem $totem */
+        $totem = $request->attributes->get('totem');
+        /** @var TotemPreset $preset */
+        $preset = $request->attributes->get('preset');
+        /** @var array $jwtClaims */
+        $jwtClaims = $request->attributes->get('jwt_claims');
+
+        if ($totem->entity->slug !== $entity) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $queueModel = $totem->entity->queues()
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $queueModel) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        $allowedQueueIds = array_intersect(
+            $jwtClaims['queues'] ?? [],
+            $preset->queues()->pluck('queues.id')->toArray()
+        );
+
+        if (! in_array($queueModel->id, $allowedQueueIds)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priorities = array_map(function ($value, $spec) {
+            return [
+                'value' => $value,
+                'label' => $spec['label'],
+                'visual' => [
+                    'color' => $spec['color'],
+                    'icon' => $spec['icon'],
+                    'order' => $spec['order'],
+                ],
+            ];
+        }, array_keys(self::PRIORITIES), self::PRIORITIES);
+
+        return response()->json([
+            'entity' => ['slug' => $totem->entity->slug],
+            'queue' => [
+                'slug' => $queueModel->slug,
+                'label' => $queueModel->name,
+            ],
+            'priorities' => $priorities,
+        ]);
+    }
+}
