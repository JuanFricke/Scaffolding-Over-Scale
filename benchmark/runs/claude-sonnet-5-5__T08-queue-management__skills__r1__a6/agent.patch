+<?php
+
+namespace Database\Factories;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * The membership is created in the entity of the (already resolved)
+     * queue, so a default grant never crosses entities. `queue_id` must stay
+     * before `entity_membership_id` for that closure to see it.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'queue_id' => Queue::factory(),
+            'entity_membership_id' => fn (array $attributes) => EntityMembership::factory()->state([
+                'entity_id' => Queue::query()->findOrFail($attributes['queue_id'])->entity_id,
+            ]),
+            'permissions' => [QueuePermission::Call->value],
+        ];
+    }
+}
