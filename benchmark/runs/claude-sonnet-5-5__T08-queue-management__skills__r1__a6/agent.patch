--- /dev/null
+++ b/app/Actions/Concerns/ValidatesQueueAttributes.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Actions\Concerns;
+
+use App\Models\Queue;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Shared name/slug rules for the queue lifecycle actions.
+ */
+trait ValidatesQueueAttributes
+{
+    /**
+     * Trim and validate a queue name (1-255 chars).
+     */
+    protected function validName(string $name): string
+    {
+        $name = trim($name);
+
+        Validator::make(['name' => $name], ['name' => ['required', 'string', 'max:255']])->validate();
+
+        return $name;
+    }
+
+    /**
+     * Slugify a slug (or a name used as the default) and validate it: it must
+     * be non-empty, at most 255 chars, and unused by another queue of the
+     * entity (`$ignoreId` is the queue being updated).
+     */
+    protected function validSlug(string $source, int $entityId, ?int $ignoreId = null): string
+    {
+        $slug = Str::slug($source);
+
+        Validator::make(['slug' => $slug], ['slug' => ['required', 'string', 'max:255']])->validate();
+
+        if ($this->slugTaken($slug, $entityId, $ignoreId)) {
+            throw self::duplicateSlug();
+        }
+
+        return $slug;
+    }
+
+    protected function slugTaken(string $slug, int $entityId, ?int $ignoreId = null): bool
+    {
+        return Queue::query()
+            ->where('entity_id', $entityId)
+            ->where('slug', $slug)
+            ->when($ignoreId !== null, fn ($query) => $query->whereKeyNot($ignoreId))
+            ->exists();
+    }
+
+    /**
+     * Raised for a duplicate slug, including a lost race on the unique index.
+     */
+    protected static function duplicateSlug(): ValidationException
+    {
+        return ValidationException::withMessages([
+            'slug' => __('validation.unique', ['attribute' => 'slug']),
+        ]);
+    }
+}
