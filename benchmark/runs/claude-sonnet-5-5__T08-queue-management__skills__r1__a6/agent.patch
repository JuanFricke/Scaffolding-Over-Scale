@@ -0,0 +1,40 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\ValidatesQueueAttributes;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\Gate;
+
+class CreateQueue
+{
+    use ValidatesQueueAttributes;
+
+    /**
+     * Create an active queue in the entity (owner/admin only).
+     *
+     * The slug defaults to the slugified name; an explicit slug is slugified
+     * too. Slugs are unique per entity.
+     */
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $name = $this->validName($name);
+        $slug = $this->validSlug($slug ?? $name, $entity->id);
+
+        try {
+            return Queue::query()->create([
+                'entity_id' => $entity->id,
+                'name' => $name,
+                'slug' => $slug,
+                'is_active' => true,
+            ]);
+        } catch (UniqueConstraintViolationException) {
+            throw self::duplicateSlug();
+        }
+    }
+}
