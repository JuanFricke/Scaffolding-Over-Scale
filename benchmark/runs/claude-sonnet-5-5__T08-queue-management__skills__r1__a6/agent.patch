 }
+
+/**
+ * A user holding the given role in the queue's entity.
+ */
+function memberOf(Queue $queue, UserRole $role = UserRole::Employee): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->create([
+        'entity_id' => $queue->entity_id,
+        'user_id' => $user->id,
+        'role' => $role,
+    ]);
+
+    return $user;
+}
+
+/**
+ * An owner of the queue's entity (may always call on its queues).
+ */
+function managerOf(Queue $queue): User
+{
+    return memberOf($queue, UserRole::Owner);
+}
+
+/**
+ * A fresh entity and a user holding `$role` (owner|admin|employee) in it.
+ *
+ * @return array{0: Entity, 1: User}
+ */
+function entityWith(string $role): array
+{
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->{$role}()->create();
+
+    return [$entity, $user];
+}
