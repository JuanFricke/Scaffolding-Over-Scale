@@ -0,0 +1,91 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Set the permissions a membership has on a queue (owner/admin only).
+     *
+     * A non-empty list upserts the grant; an empty list revokes it. Both are
+     * recorded on the audit channel (a revoke only if a grant existed).
+     *
+     * @param  array<array-key, mixed>  $permissions  QueuePermission values
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'membership' => __('validation.exists', ['attribute' => 'membership']),
+            ]);
+        }
+
+        $permissions = $this->validPermissions($permissions);
+        $context = [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+        ];
+
+        if ($permissions === []) {
+            $deleted = QueueAccess::query()
+                ->where('entity_membership_id', $targetMembership->id)
+                ->where('queue_id', $queue->id)
+                ->delete();
+
+            if ($deleted > 0) {
+                Log::channel('audit')->info('queue.access.revoked', $context);
+            }
+
+            return;
+        }
+
+        // Atomic on the unique (membership, queue) index: two concurrent
+        // grants cannot collide. upsert() skips casts, so encode here.
+        QueueAccess::query()->upsert(
+            [[
+                'entity_membership_id' => $targetMembership->id,
+                'queue_id' => $queue->id,
+                'permissions' => json_encode($permissions),
+            ]],
+            ['entity_membership_id', 'queue_id'],
+            ['permissions'],
+        );
+
+        Log::channel('audit')->info('queue.access.granted', $context + ['permissions' => $permissions]);
+    }
+
+    /**
+     * @param  array<array-key, mixed>  $permissions
+     * @return list<string>
+     */
+    private function validPermissions(array $permissions): array
+    {
+        $allowed = array_column(QueuePermission::cases(), 'value');
+
+        foreach ($permissions as $permission) {
+            if (! is_string($permission) || ! in_array($permission, $allowed, true)) {
+                throw ValidationException::withMessages([
+                    'permissions' => __('validation.in', ['attribute' => 'permissions']),
+                ]);
+            }
+        }
+
+        return array_values(array_unique($permissions));
+    }
+}
