@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\ValidatesQueueAttributes;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+class UpdateQueue
+{
+    use ValidatesQueueAttributes;
+
+    /**
+     * Rename, re-slug and/or (de)activate a queue (owner/admin only).
+     *
+     * `null` leaves a field unchanged. There is deliberately no delete:
+     * deactivating (`isActive: false`) retires a queue and keeps its tickets.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        try {
+            DB::transaction(function () use ($queue, $name, $slug, $isActive): void {
+                // Same lock as IssueTicket/CallNextTicket, so deactivation is
+                // serialized with issuing and calling.
+                $locked = Queue::query()
+                    ->whereKey($queue->id)
+                    ->lockForUpdate()
+                    ->firstOrFail();
+
+                if ($name !== null) {
+                    $locked->name = $this->validName($name);
+                }
+
+                if ($slug !== null) {
+                    $locked->slug = $this->validSlug($slug, $locked->entity_id, $locked->id);
+                }
+
+                if ($isActive !== null) {
+                    $locked->is_active = $isActive;
+                }
+
+                $locked->save();
+            });
+        } catch (UniqueConstraintViolationException) {
+            throw self::duplicateSlug();
+        }
+
+        return $queue->refresh();
+    }
+}
