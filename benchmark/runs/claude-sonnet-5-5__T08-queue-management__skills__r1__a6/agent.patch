+<?php
+
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function can(User $user, string $ability, mixed ...$arguments): bool
+{
+    return Gate::forUser($user)->allows($ability, $arguments);
+}
+
+it('lets only owners and admins create, update and manage access', function () {
+    $queue = Queue::factory()->create();
+    $entity = $queue->entity;
+
+    foreach ([UserRole::Owner, UserRole::Admin] as $role) {
+        $manager = memberOf($queue, $role);
+
+        expect(can($manager, 'create', Queue::class, $entity))->toBeTrue()
+            ->and(can($manager, 'update', $queue))->toBeTrue()
+            ->and(can($manager, 'manageAccess', $queue))->toBeTrue();
+    }
+
+    $employee = memberOf($queue);
+    $outsider = User::factory()->create();
+    $foreignManager = managerOf(Queue::factory()->create());
+
+    foreach ([$employee, $outsider, $foreignManager] as $user) {
+        expect(can($user, 'create', Queue::class, $entity))->toBeFalse()
+            ->and(can($user, 'update', $queue))->toBeFalse()
+            ->and(can($user, 'manageAccess', $queue))->toBeFalse();
+    }
+});
+
+it('always lets owners and admins call, without a grant row', function () {
+    $queue = Queue::factory()->create();
+
+    expect(can(memberOf($queue, UserRole::Owner), 'call', $queue))->toBeTrue()
+        ->and(can(memberOf($queue, UserRole::Admin), 'call', $queue))->toBeTrue();
+});
+
+it('lets an employee call only with a call grant on that queue', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create(['entity_id' => $queue->entity_id]);
+    $employee = memberOf($queue);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->sole();
+
+    expect(can($employee, 'call', $queue))->toBeFalse();
+
+    QueueAccess::factory()->create(['queue_id' => $queue->id, 'entity_membership_id' => $membership->id]);
+
+    expect(can($employee, 'call', $queue))->toBeTrue()
+        ->and(can($employee, 'call', $other))->toBeFalse();
+});
+
+it('denies an employee whose grant lacks call', function () {
+    $queue = Queue::factory()->create();
+    $employee = memberOf($queue);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->sole();
+    QueueAccess::factory()->create([
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $membership->id,
+        'permissions' => [],
+    ]);
+
+    expect(can($employee, 'call', $queue))->toBeFalse();
+});
+
+it('denies an employee whose stored permissions are corrupted', function (string $raw) {
+    $queue = Queue::factory()->create();
+    $employee = memberOf($queue);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->sole();
+    $access = QueueAccess::factory()->create([
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $membership->id,
+    ]);
+    DB::table('queue_access')->where('id', $access->id)->update(['permissions' => $raw]);
+
+    expect(can($employee, 'call', $queue))->toBeFalse();
+})->with(['"call"', 'null', '123', 'true', 'not json', '{"call":true}']);
+
+it('denies a grant held by someone else, in another entity, or by a non-member', function () {
+    $queue = Queue::factory()->create();
+    $employee = memberOf($queue);
+    $colleague = memberOf($queue);
+    $colleagueMembership = EntityMembership::query()->where('user_id', $colleague->id)->sole();
+    QueueAccess::factory()->create(['queue_id' => $queue->id, 'entity_membership_id' => $colleagueMembership->id]);
+
+    $foreign = QueueAccess::factory()->create();
+
+    expect(can($employee, 'call', $queue))->toBeFalse()
+        ->and(can($foreign->membership->user, 'call', $queue))->toBeFalse()
+        ->and(can(User::factory()->create(), 'call', $queue))->toBeFalse();
