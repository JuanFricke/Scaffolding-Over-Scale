+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function employeeMembership(Queue $queue): EntityMembership
+{
+    return EntityMembership::query()->where('user_id', memberOf($queue)->id)->firstOrFail();
+}
+
+it('grants call to an employee and audits it', function (string $role) {
+    $queue = Queue::factory()->create();
+    $manager = memberOf($queue, UserRole::from($role));
+    $membership = employeeMembership($queue);
+
+    Log::shouldReceive('channel')->with('audit')->once()->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('queue.access.granted', Mockery::on(
+        fn (array $context) => $context['actor_id'] === $manager->id
+            && $context['queue_id'] === $queue->id
+            && $context['entity_membership_id'] === $membership->id
+    ));
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    $access = QueueAccess::query()->sole();
+    expect($access->permissions)->toBe(['call'])
+        ->and($access->entity_membership_id)->toBe($membership->id)
+        ->and($access->queue_id)->toBe($queue->id);
+})->with(['owner', 'admin']);
+
+it('upserts instead of duplicating the row', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue);
+    $membership = employeeMembership($queue);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call', 'call']);
+
+    expect(QueueAccess::query()->count())->toBe(1)
+        ->and(QueueAccess::query()->sole()->permissions)->toBe(['call']);
+});
+
+it('revokes with an empty list and audits it', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue);
+    $membership = employeeMembership($queue);
+    QueueAccess::factory()->create(['queue_id' => $queue->id, 'entity_membership_id' => $membership->id]);
+
+    Log::shouldReceive('channel')->with('audit')->once()->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('queue.access.revoked', Mockery::on(
+        fn (array $context) => $context['actor_id'] === $manager->id
+            && $context['queue_id'] === $queue->id
+            && $context['entity_membership_id'] === $membership->id
+    ));
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('does not audit a revoke when there was nothing to delete', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue);
+    $membership = employeeMembership($queue);
+
+    Log::shouldReceive('channel')->never();
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('only revokes the given queue', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create(['entity_id' => $queue->entity_id]);
+    $manager = managerOf($queue);
+    $membership = employeeMembership($queue);
+    QueueAccess::factory()->create(['queue_id' => $other->id, 'entity_membership_id' => $membership->id]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(1);
+});
+
+it('rejects unknown or non-string permissions and stores nothing', function (array $permissions) {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue);
+    $membership = employeeMembership($queue);
+
+    Log::shouldReceive('channel')->never();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, $permissions))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with([
+    'unknown' => [['admin']],
+    'mixed' => [['call', 'admin']],
+    'case' => [['Call']],
+    'int' => [[1]],
+    'null' => [[null]],
+    'array' => [[['call']]],
+    'bool' => [[true]],
+]);
+
+it('keeps an existing grant when an invalid update is rejected', function () {
+    $queue = Queue::factory()->create();
+    $membership = employeeMembership($queue);
+    QueueAccess::factory()->create(['queue_id' => $queue->id, 'entity_membership_id' => $membership->id]);
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, managerOf($queue), ['nope']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->sole()->permissions)->toBe(['call']);
+});
+
+it('rejects a membership and queue of different entities', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue);
+    $foreign = employeeMembership(Queue::factory()->create());
+
+    expect(fn () => (new SetQueueAccess)($foreign, $queue, $manager, ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('denies non-managers, including an employee granting themselves', function (string $who) {
+    $queue = Queue::factory()->create();
+    $membership = employeeMembership($queue);
+
+    $actor = match ($who) {
+        'self' => $membership->user,
+        'other employee' => memberOf($queue),
+        'other entity manager' => managerOf(Queue::factory()->create()),
+        'non-member' => User::factory()->create(),
+    };
+
+    Log::shouldReceive('channel')->never();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $actor, ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with(['self', 'other employee', 'other entity manager', 'non-member']);
+
+it('denies a non-manager revoking', function () {
+    $queue = Queue::factory()->create();
+    $membership = employeeMembership($queue);
+    QueueAccess::factory()->create(['queue_id' => $queue->id, 'entity_membership_id' => $membership->id]);
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $membership->user, []))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(1);
+});
+
+it('builds factory grants inside a single entity', function () {
+    $access = QueueAccess::factory()->create();
+
+    expect($access->permissions)->toBe(['call'])
+        ->and($access->membership->entity_id)->toBe($access->queue->entity_id);
+});
+
+it('cascades grants when the membership or queue is deleted', function () {
+    $access = QueueAccess::factory()->create();
+    $other = QueueAccess::factory()->create();
+
+    $access->membership->delete();
+    $other->queue->delete();
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
diff --git a/tests/Feature/UpdateQueueTest.php b/tests/Feature/UpdateQueueTest.php
new file mode 100644
index 0000000..fbea60a
--- /dev/null
+++ b/tests/Feature/UpdateQueueTest.php
@@ -0,0 +1,128 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('lets owners and admins rename, re-slug and deactivate', function (string $role) {
+    [$entity, $actor] = entityWith($role);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old']);
+
+    $updated = (new UpdateQueue)($queue, $actor, name: ' New name ', slug: 'Novo Slug', isActive: false);
+
+    expect($updated->name)->toBe('New name')
+        ->and($updated->slug)->toBe('novo-slug')
+        ->and($updated->is_active)->toBeFalse()
+        ->and($queue->fresh()->only('name', 'slug', 'is_active'))
+        ->toBe(['name' => 'New name', 'slug' => 'novo-slug', 'is_active' => false]);
+})->with(['owner', 'admin']);
+
+it('leaves fields that are null unchanged', function () {
+    [$entity, $actor] = entityWith('owner');
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old', 'is_active' => false]);
+
+    (new UpdateQueue)($queue, $actor, name: 'Renamed');
+    expect($queue->fresh()->only('name', 'slug', 'is_active'))
+        ->toBe(['name' => 'Renamed', 'slug' => 'old', 'is_active' => false]);
+
+    (new UpdateQueue)($queue, $actor, isActive: true);
+    expect($queue->fresh())->name->toBe('Renamed')->slug->toBe('old')->is_active->toBeTrue();
+});
+
+it('allows keeping the queue own slug', function () {
+    [$entity, $actor] = entityWith('owner');
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'mine']);
+
+    $updated = (new UpdateQueue)($queue, $actor, name: 'Renamed', slug: 'mine');
+
+    expect($updated->slug)->toBe('mine');
+});
+
+it('rejects taking another queue slug in the entity', function () {
+    [$entity, $actor] = entityWith('owner');
+    Queue::factory()->for($entity)->create(['slug' => 'taken']);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'mine']);
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'Renamed', slug: 'Taken'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh())->slug->toBe('mine')->name->not->toBe('Renamed');
+});
+
+it('allows a slug used by a queue of another entity', function () {
+    [$entity, $actor] = entityWith('owner');
+    Queue::factory()->for(Entity::factory())->create(['slug' => 'shared']);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'mine']);
+
+    expect((new UpdateQueue)($queue, $actor, slug: 'shared')->slug)->toBe('shared');
+});
+
+it('rejects invalid names and empty slugs', function () {
+    [$entity, $actor] = entityWith('owner');
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: '  '))->toThrow(ValidationException::class);
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: str_repeat('a', 256)))->toThrow(ValidationException::class);
+    expect(fn () => (new UpdateQueue)($queue, $actor, slug: '!!!'))->toThrow(ValidationException::class);
+});
+
+it('turns a unique index race into a validation error', function () {
+    [$entity, $actor] = entityWith('owner');
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'mine']);
+
+    Queue::updating(function (Queue $model) use ($entity): void {
+        Queue::query()->insert([
+            'entity_id' => $entity->id,
+            'name' => 'Winner',
+            'slug' => $model->slug,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    });
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, slug: 'contested'))
+        ->toThrow(ValidationException::class);
+
+    Queue::flushEventListeners();
+});
+
+it('keeps tickets and blocks issuing and calling once deactivated', function () {
+    [$entity, $actor] = entityWith('owner');
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = (new IssueTicket)($queue);
+
+    (new UpdateQueue)($queue, $actor, isActive: false);
+
+    expect(Ticket::query()->count())->toBe(1)
+        ->and(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class)
+        ->and(fn () => $ticket->call($actor))->toThrow(InactiveQueueException::class);
+});
+
+it('does not offer a way to delete queues', function () {
+    expect(glob(app_path('Actions/*Queue*.php')))
+        ->each->not->toMatch('/(Delete|Remove|Destroy)/i');
+});
+
+it('denies everyone but owners and admins', function (string $who) {
+    $queue = Queue::factory()->create(['name' => 'Old']);
+
+    $actor = match ($who) {
+        'employee' => memberOf($queue),
+        'other entity manager' => managerOf(Queue::factory()->create()),
+        'non-member' => User::factory()->create(),
+    };
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'New', isActive: false))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh())->name->toBe('Old')->is_active->toBeTrue();
+})->with(['employee', 'other entity manager', 'non-member']);
