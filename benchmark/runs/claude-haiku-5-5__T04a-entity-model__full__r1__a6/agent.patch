--- /dev/null
+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Owner and admin may assign roles. The owner's own role is never reassigned here:
+     * demoting the owner would leave the entity without one.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $membership->role !== UserRole::Owner
+            && $this->isOwnerOrAdmin($user, $membership->entity_id);
+    }
+
+    /**
+     * The owner membership is never deletable. Anyone may remove their own membership;
+     * otherwise only the owner or an admin of the entity may remove it.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        return $user->id === $membership->user_id
+            || $this->isOwnerOrAdmin($user, $membership->entity_id);
+    }
+
+    private function isOwnerOrAdmin(User $user, int $entityId): bool
+    {
+        return in_array($user->membershipFor($entityId)?->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
