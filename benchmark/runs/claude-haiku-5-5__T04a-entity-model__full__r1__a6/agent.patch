+<?php
+
+namespace App\Models;
+
+enum UserRole: string
+{
+    case Owner = 'owner';
+    case Admin = 'admin';
+    case Employee = 'employee';
+
+    /**
+     * The roles an owner or admin may hand out. The owner role is never assigned this way.
+     *
+     * @return list<self>
+     */
+    public static function manageable(): array
+    {
+        return [self::Admin, self::Employee];
+    }
+}
