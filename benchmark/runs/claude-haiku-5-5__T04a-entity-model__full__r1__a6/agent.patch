+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->policy = new EntityMembershipPolicy;
+    $this->entity = Entity::factory()->create();
+    $this->ownerMembership = EntityMembership::factory()->owner()->create(['entity_id' => $this->entity->id]);
+    $this->adminMembership = EntityMembership::factory()->admin()->create(['entity_id' => $this->entity->id]);
+    $this->employeeMembership = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+    $this->peerMembership = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+    $this->owner = $this->ownerMembership->user;
+    $this->admin = $this->adminMembership->user;
+    $this->employee = $this->employeeMembership->user;
+    $this->peer = $this->peerMembership->user;
+    $this->stranger = User::factory()->create();
+    $this->otherEntityAdmin = EntityMembership::factory()->admin()->create()->user;
+});
+
+test('every member of the entity may view its memberships', function () {
+    expect($this->policy->view($this->owner, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->view($this->admin, $this->peerMembership))->toBeTrue()
+        ->and($this->policy->view($this->employee, $this->ownerMembership))->toBeTrue();
+});
+
+test('non-members may not view the memberships of an entity', function () {
+    expect($this->policy->view($this->stranger, $this->employeeMembership))->toBeFalse()
+        ->and($this->policy->view($this->otherEntityAdmin, $this->employeeMembership))->toBeFalse();
+});
+
+test('owner and admin may assign roles to other members', function () {
+    expect($this->policy->assignRole($this->owner, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->assignRole($this->admin, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->assignRole($this->admin, $this->adminMembership))->toBeTrue();
+});
+
+test('employees, non-members and other entities cannot assign roles', function () {
+    expect($this->policy->assignRole($this->employee, $this->peerMembership))->toBeFalse()
+        ->and($this->policy->assignRole($this->stranger, $this->employeeMembership))->toBeFalse()
+        ->and($this->policy->assignRole($this->otherEntityAdmin, $this->employeeMembership))->toBeFalse();
+});
+
+test('the owner role is never reassigned through assignRole', function () {
+    expect($this->policy->assignRole($this->owner, $this->ownerMembership))->toBeFalse()
+        ->and($this->policy->assignRole($this->admin, $this->ownerMembership))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    expect($this->policy->delete($this->owner, $this->ownerMembership))->toBeFalse()
+        ->and($this->policy->delete($this->admin, $this->ownerMembership))->toBeFalse();
+});
+
+test('members may remove their own membership', function () {
+    expect($this->policy->delete($this->employee, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->delete($this->admin, $this->adminMembership))->toBeTrue();
+});
+
+test('owner and admin may delete other members', function () {
+    expect($this->policy->delete($this->owner, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->delete($this->admin, $this->peerMembership))->toBeTrue();
+});
+
+test('employees may not delete other members', function () {
+    expect($this->policy->delete($this->employee, $this->peerMembership))->toBeFalse();
+});
+
+test('non-members and other entities cannot delete memberships', function () {
+    expect($this->policy->delete($this->stranger, $this->employeeMembership))->toBeFalse()
+        ->and($this->policy->delete($this->otherEntityAdmin, $this->employeeMembership))->toBeFalse();
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..e2261fa
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,112 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('entities are bound in routes by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect((new Entity)->getRouteKeyName())->toBe('slug')
+        ->and($entity->resolveRouteBinding('acme')->is($entity))->toBeTrue();
+});
+
+test('entity factory creates a named entity with a unique slug', function () {
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    expect($first->name)->not->toBeEmpty()
+        ->and($first->slug)->not->toBeEmpty()
+        ->and($first->slug)->not->toBe($second->slug);
+});
+
+test('deleted entities are soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect(Entity::count())->toBe(0)
+        ->and(Entity::withTrashed()->find($entity->id)->trashed())->toBeTrue();
+});
+
+test('an entity exposes its memberships and the users through them', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $employee = EntityMembership::factory()->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users->modelKeys())->toEqualCanonicalizing([$owner->user_id, $employee->user_id]);
+});
+
+test('owner() returns the owner membership, or null when there is none', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->owner()->first())->toBeNull();
+
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue();
+});
+
+test('membership role is cast to UserRole', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('membership factory defaults to the employee role', function () {
+    expect(EntityMembership::factory()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('membership factory states set the matching role', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('membership belongs to an entity and a user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity->is(Entity::find($membership->entity_id)))->toBeTrue()
+        ->and($membership->user->is(User::find($membership->user_id)))->toBeTrue();
+});
+
+test('user relates to entities through memberships', function () {
+    $membership = EntityMembership::factory()->create();
+    $user = $membership->user;
+
+    expect($user->memberships)->toHaveCount(1)
+        ->and($user->entities)->toHaveCount(1)
+        ->and($user->entities->first()->is($membership->entity))->toBeTrue();
+});
+
+test('membershipFor returns the users membership in that entity, or null', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $otherEntity = Entity::factory()->create();
+
+    expect($membership->user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($membership->user->membershipFor($otherEntity->id))->toBeNull();
+});
+
+test('manageable roles are admin and employee', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee])
+        ->and(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee');
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..d57f936
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,64 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->policy = new EntityPolicy;
+    $this->entity = Entity::factory()->create();
+    $this->owner = EntityMembership::factory()->owner()->create(['entity_id' => $this->entity->id])->user;
+    $this->admin = EntityMembership::factory()->admin()->create(['entity_id' => $this->entity->id])->user;
+    $this->employee = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id])->user;
+    $this->stranger = User::factory()->create();
+    $this->otherEntityAdmin = EntityMembership::factory()->admin()->create()->user;
+});
+
+test('any authenticated user may create an entity', function () {
+    expect($this->policy->create($this->stranger))->toBeTrue()
+        ->and($this->policy->create($this->employee))->toBeTrue();
+});
+
+test('every member may view the entity', function () {
+    expect($this->policy->view($this->owner, $this->entity))->toBeTrue()
+        ->and($this->policy->view($this->admin, $this->entity))->toBeTrue()
+        ->and($this->policy->view($this->employee, $this->entity))->toBeTrue();
+});
+
+test('non-members may not view the entity', function () {
+    expect($this->policy->view($this->stranger, $this->entity))->toBeFalse()
+        ->and($this->policy->view($this->otherEntityAdmin, $this->entity))->toBeFalse();
+});
+
+test('owner and admin may update the entity', function () {
+    expect($this->policy->update($this->owner, $this->entity))->toBeTrue()
+        ->and($this->policy->update($this->admin, $this->entity))->toBeTrue();
+});
+
+test('employees and non-members may not update the entity', function () {
+    expect($this->policy->update($this->employee, $this->entity))->toBeFalse()
+        ->and($this->policy->update($this->stranger, $this->entity))->toBeFalse()
+        ->and($this->policy->update($this->otherEntityAdmin, $this->entity))->toBeFalse();
+});
+
+test('owner and admin may delete the entity', function () {
+    expect($this->policy->delete($this->owner, $this->entity))->toBeTrue()
+        ->and($this->policy->delete($this->admin, $this->entity))->toBeTrue();
+});
+
+test('employees and non-members may not delete the entity', function () {
+    expect($this->policy->delete($this->employee, $this->entity))->toBeFalse()
+        ->and($this->policy->delete($this->stranger, $this->entity))->toBeFalse()
+        ->and($this->policy->delete($this->otherEntityAdmin, $this->entity))->toBeFalse();
+});
+
+test('only the owner may manage settings', function () {
+    expect($this->policy->manageSettings($this->owner, $this->entity))->toBeTrue()
+        ->and($this->policy->manageSettings($this->admin, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($this->employee, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($this->stranger, $this->entity))->toBeFalse();
+});
diff --git a/tests/Feature/EntitySchemaTest.php b/tests/Feature/EntitySchemaTest.php
new file mode 100644
index 0000000..bb7afe3
--- /dev/null
+++ b/tests/Feature/EntitySchemaTest.php
@@ -0,0 +1,101 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities have a unique slug index with the agreed name', function () {
+    $index = collect(Schema::getIndexes('entities'))->firstWhere('name', 'entities_slug_unique');
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['slug']);
+});
+
+test('entity slugs cannot be duplicated', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+
+    Entity::factory()->create(['slug' => 'acme']);
+})->throws(QueryException::class);
+
+test('a user has at most one membership per entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]);
+})->throws(QueryException::class);
+
+test('the database rejects a second owner in the same entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $owner->entity_id]);
+})->throws(QueryException::class);
+
+test('different entities may each have their own owner', function () {
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect(EntityMembership::owner()->count())->toBe(2);
+});
+
+test('an entity may have any number of non-owner memberships', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->count(2)->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(3)->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->count())->toBe(6);
+});
+
+test('owner_seq is 1 for the owner and NULL for every other role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $owner->entity_id]);
+    $employee = EntityMembership::factory()->create(['entity_id' => $owner->entity_id]);
+
+    $sequence = fn (EntityMembership $membership) => DB::table('entity_memberships')
+        ->where('id', $membership->id)
+        ->value('owner_seq');
+
+    expect($sequence($owner))->toEqual(1)
+        ->and($sequence($admin))->toBeNull()
+        ->and($sequence($employee))->toBeNull();
+});
+
+test('membership role defaults to employee at the database level', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(DB::table('entity_memberships')->value('role'))->toBe('employee');
+});
+
+test('deleting a user removes their memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('force deleting an entity removes its memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
