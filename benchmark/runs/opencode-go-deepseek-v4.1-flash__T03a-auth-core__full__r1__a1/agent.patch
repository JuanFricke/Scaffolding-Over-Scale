diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..a2d0a42
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,127 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password page renders a single email field', function () {
+    $response = $this->get(route('password.request'));
+
+    $response->assertOk()
+        ->assertSee('Esqueceu sua senha?')
+        ->assertSee('name="email"', false);
+});
+
+test('a reset link is sent for an existing user without revealing the account', function () {
+    Notification::fake();
+
+    $user = User::factory()->create(['email' => 'staff@example.com']);
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown email gets the same status and no notification', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'missing@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('forgot password is throttled at six requests per minute', function () {
+    for ($i = 0; $i < 6; $i++) {
+        $this->post(route('password.email'), ['email' => 'staff@example.com'])
+            ->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'staff@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset page asks for the email exactly once', function () {
+    $response = $this->get(route('password.reset', [
+        'token' => 'test-token',
+        'email' => 'staff@example.com',
+    ]));
+
+    $response->assertOk()
+        ->assertSee('name="email"', false);
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('a valid token resets the password and rotates the remember token', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create([
+        'email' => 'staff@example.com',
+        'password' => 'OldPassword123',
+        'remember_token' => 'old-remember-token',
+    ]);
+
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'NewPassword123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewPassword123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-remember-token');
+
+    Event::assertDispatched(PasswordReset::class, fn (PasswordReset $event) => $event->user->is($user));
+});
+
+test('an invalid reset token fails on email', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com']);
+
+    $this->post(route('password.update'), [
+        'token' => 'invalid-token',
+        'email' => $user->email,
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'NewPassword123',
+    ])->assertSessionHasErrors('email');
+});
+
+test('the default password rule is enforced on reset', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'weak',
+        'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+});
+
+test('password reset passwords must be confirmed', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPassword123',
+        'password_confirmation' => 'OtherPassword123',
+    ])->assertSessionHasErrors('password');
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..44ba6b9
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,120 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the registration page', function () {
+    $response = $this->get(route('register'));
+
+    $response->assertOk()
+        ->assertSee('Nome')
+        ->assertSee('E-mail')
+        ->assertSee('Confirme a senha');
+});
+
+test('a user can register and is logged in unverified', function () {
+    Event::fake([Registered::class]);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Staff')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::whereEmail('maria@example.com')->firstOrFail();
+
+    $this->assertAuthenticatedAs($user);
+    expect($user->hasVerifiedEmail())->toBeFalse();
+
+    Event::assertDispatched(Registered::class, fn (Registered $event) => $event->user->is($user));
+});
+
+test('registration sends the email verification notification', function () {
+    Notification::fake();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Staff')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit');
+
+    Notification::assertSentTo(
+        User::whereEmail('maria@example.com')->firstOrFail(),
+        VerifyEmail::class,
+    );
+});
+
+test('a mismatched password confirmation fails on password', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Staff')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Different123')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    expect(User::whereEmail('maria@example.com')->exists())->toBeFalse();
+});
+
+test('the default password rule is enforced', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Staff')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'password')
+        ->set('password_confirmation', 'password')
+        ->call('submit')
+        ->assertHasErrors('password');
+
+    expect(User::whereEmail('maria@example.com')->exists())->toBeFalse();
+});
+
+test('email addresses must be unique', function () {
+    User::factory()->create(['email' => 'maria@example.com']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Staff')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+});
+
+test('registration is rate limited by ip after five attempts', function () {
+    $key = Str::transliterate('register|127.0.0.1');
+
+    for ($i = 0; $i < 5; $i++) {
+        Livewire::test(Register::class)
+            ->set('name', 'Maria Staff')
+            ->set('email', "maria{$i}@example.com")
+            ->set('password', 'Password123')
+            ->set('password_confirmation', 'Password123')
+            ->call('submit');
+    }
+
+    expect(RateLimiter::attempts($key))->toBe(5);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Staff')
+        ->set('email', 'blocked@example.com')
+        ->set('password', 'Password123')
+        ->set('password_confirmation', 'Password123')
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    expect(User::whereEmail('blocked@example.com')->exists())->toBeFalse();
+});
diff --git a/tests/Feature/Auth/VerificationTest.php b/tests/Feature/Auth/VerificationTest.php
new file mode 100644
index 0000000..fd07e5c
--- /dev/null
+++ b/tests/Feature/Auth/VerificationTest.php
@@ -0,0 +1,129 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Contracts\Auth\MustVerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+test('the user model must verify email', function () {
+    expect(User::factory()->make())->toBeInstanceOf(MustVerifyEmail::class);
+});
+
+test('unverified users see the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee('Verifique seu e-mail');
+});
+
+test('verified users can see home', function () {
+    $user = User::factory()->create(['name' => 'Maria Staff']);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertOk()
+        ->assertSee('Maria Staff');
+});
+
+test('unverified users are sent from home to the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('guests are sent from home to login', function () {
+    $this->get(route('home'))->assertRedirect(route('login'));
+});
+
+test('a valid signed link verifies the logged in user', function () {
+    Event::fake([Verified::class]);
+
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $this->actingAs($user)->get($url)->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+    Event::assertDispatched(Verified::class);
+});
+
+test('a verification link with a tampered id verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $tampered = str_replace('/'.$user->id.'/', '/'.$other->id.'/', $url);
+
+    $this->actingAs($other)->get($tampered)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a signed link for another user is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $this->actingAs($other)->get($url)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unverified user can resend the verification email', function () {
+    Notification::fake();
+
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect()
+        ->assertSessionHas('status');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('a verified user resending verification is redirected home and gets no email', function () {
+    Notification::fake();
+
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('verification resend is throttled', function () {
+    $user = User::factory()->unverified()->create();
+
+    for ($i = 0; $i < 6; $i++) {
+        $this->actingAs($user)->post(route('verification.send'))->assertRedirect();
+    }
+
+    $this->actingAs($user)->post(route('verification.send'))->assertStatus(429);
+});
