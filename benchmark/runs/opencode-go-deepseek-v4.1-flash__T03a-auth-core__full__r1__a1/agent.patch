+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the login page in brazilian portuguese', function () {
+    $response = $this->get(route('login'));
+
+    $response->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('a user can log in with valid credentials', function () {
+    $user = User::factory()->create([
+        'email' => 'staff@example.com',
+        'password' => 'Password123',
+    ]);
+
+    $oldSessionId = session()->getId();
+
+    Livewire::test(Login::class)
+        ->set('email', 'STAFF@example.com')
+        ->set('password', 'Password123')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+    expect(session()->getId())->not->toBe($oldSessionId);
+});
+
+test('invalid credentials fail with the auth failed message', function () {
+    User::factory()->create([
+        'email' => 'staff@example.com',
+        'password' => 'Password123',
+    ]);
+
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+
+    $this->assertGuest();
+});
+
+test('login is rate limited after five failed attempts', function () {
+    User::factory()->create([
+        'email' => 'staff@example.com',
+        'password' => 'Password123',
+    ]);
+
+    $key = Str::lower('staff@example.com').'|127.0.0.1';
+
+    for ($i = 0; $i < 5; $i++) {
+        Livewire::test(Login::class)
+            ->set('email', 'staff@example.com')
+            ->set('password', 'wrong-password')
+            ->call('submit')
+            ->assertHasErrors('email');
+    }
+
+    expect(RateLimiter::attempts($key))->toBe(5);
+
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'Password123')
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    $this->assertGuest();
+});
+
+test('authenticated users are redirected from login to home', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
