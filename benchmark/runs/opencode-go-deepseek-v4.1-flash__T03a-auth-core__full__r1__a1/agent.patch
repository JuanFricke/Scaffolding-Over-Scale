diff --git a/tests/Feature/Auth/LocalizationTest.php b/tests/Feature/Auth/LocalizationTest.php
new file mode 100644
index 0000000..c699f9d
--- /dev/null
+++ b/tests/Feature/Auth/LocalizationTest.php
@@ -0,0 +1,42 @@
+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the test suite runs in brazilian portuguese with an english fallback', function () {
+    expect(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('the login page can be rendered in english', function () {
+    $this->withSession([]);
+
+    app()->setLocale('en');
+
+    $response = $this->get(route('login'));
+
+    $response->assertOk()
+        ->assertSee('Log in')
+        ->assertSee('Password')
+        ->assertSee('Forgot your password?')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu a senha?');
+});
+
+test('views do not hardcode root urls', function () {
+    $files = new RecursiveIteratorIterator(
+        new RecursiveDirectoryIterator(resource_path('views')),
+    );
+
+    foreach ($files as $file) {
+        if (! $file->isFile() || ! str_ends_with($file->getFilename(), '.blade.php')) {
+            continue;
+        }
+
+        $contents = file_get_contents($file->getPathname());
+
+        expect($contents)->not->toMatch('/(?:href|action)\s*=\s*["\']\/[^"\']*["\']/');
+    }
+});
