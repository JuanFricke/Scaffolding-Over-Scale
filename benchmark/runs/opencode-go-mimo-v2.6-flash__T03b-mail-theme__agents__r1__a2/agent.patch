diff --git a/tests/Feature/AccountEmailsTest.php b/tests/Feature/AccountEmailsTest.php
new file mode 100644
index 0000000..d344e77
--- /dev/null
+++ b/tests/Feature/AccountEmailsTest.php
@@ -0,0 +1,82 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Mail;
+use Symfony\Component\Mime\Email;
+
+uses(RefreshDatabase::class);
+
+/**
+ * The last e-mail captured by the array mailer (phpunit pins MAIL_MAILER=array).
+ */
+function pegafilaLastSentEmail(): Email
+{
+    $messages = Mail::mailer('array')->getSymfonyTransport()->messages();
+    $message = $messages->last();
+
+    expect($message)->not->toBeNull();
+
+    return $message->getOriginalMessage();
+}
+
+test('the app identity is pinned in the test suite and shipped in env example', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+
+    $envExample = file_get_contents(base_path('.env.example'));
+
+    expect($envExample)
+        ->toContain('APP_NAME=PegaFila')
+        ->toContain('APP_LOCALE=pt_BR')
+        ->toContain('APP_FALLBACK_LOCALE=en');
+});
+
+test('markdown mail uses the pegafila theme with the brand primary color', function () {
+    expect(config('mail.markdown.theme'))->toBe('pegafila');
+
+    $theme = base_path('resources/views/vendor/mail/html/themes/pegafila.css');
+
+    expect($theme)->toBeFile()
+        ->and(str_contains(strtolower(file_get_contents($theme)), '#0f7490'))->toBeTrue();
+});
+
+test('the password reset notification renders in brazilian portuguese with the pegafila brand', function () {
+    $user = User::factory()->create(['email' => 'ana@pegafila.xyz']);
+
+    $user->notify(new ResetPassword('token-abc'));
+
+    $email = pegafilaLastSentEmail();
+    $html = (string) $email->getHtmlBody();
+
+    expect($email->getSubject())->toBe('Redefina sua senha')
+        ->and($html)->toContain('PegaFila')
+        ->and($html)->toContain('Olá!')
+        ->and($html)->toContain('Redefinir senha')
+        ->and($html)->toContain('Você recebeu esse e-mail')
+        ->and($html)->toContain('O link de redefinição de senha irá expirar em 60 minutos')
+        ->and($html)->toContain('copie e cole a URL abaixo')
+        ->and($html)->toContain('#0f7490')
+        ->and($html)->toContain('/reset-password/token-abc')
+        ->and($html)->not->toContain('having trouble clicking');
+});
+
+test('the email verification notification renders in portuguese and links the verification route', function () {
+    $user = User::factory()->unverified()->create(['email' => 'ana@pegafila.xyz']);
+
+    $user->notify(new VerifyEmail);
+
+    $email = pegafilaLastSentEmail();
+    $html = (string) $email->getHtmlBody();
+
+    expect($email->getSubject())->toBe('Verifique seu endereço de e-mail')
+        ->and($html)->toContain('PegaFila')
+        ->and($html)->toContain('Verifique o endereço de e-mail')
+        ->and($html)->toContain('Por favor, clique no botão abaixo para verificar seu endereço de e-mail.')
+        ->and($html)->toContain('/email/verify/'.$user->getKey().'/'.sha1($user->getEmailForVerification()))
+        ->and($html)->toContain('#0f7490')
+        ->and($html)->not->toContain('having trouble clicking');
+});
diff --git a/tests/Feature/EmailVerificationTest.php b/tests/Feature/EmailVerificationTest.php
new file mode 100644
index 0000000..6779605
--- /dev/null
+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,97 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Build a signed verification URL for the given user (optionally overriding the hash).
+ */
+function pegafilaSignedVerificationUrl(User $user, ?string $hash = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => $hash ?? sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('the verification route is registered under its contract name and protected', function () {
+    $route = Route::getRoutes()->getByName('verification.verify');
+
+    expect($route)->not->toBeNull()
+        ->and($route->uri())->toBe('email/verify/{id}/{hash}')
+        ->and($route->gatherMiddleware())->toContain('auth', 'signed');
+
+    expect(collect($route->gatherMiddleware())->first(
+        fn ($middleware) => str_starts_with($middleware, 'throttle')
+    ))->not->toBeNull();
+});
+
+test('a valid signed link verifies the logged-in user and redirects home', function () {
+    Event::fake([Verified::class]);
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(pegafilaSignedVerificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+    Event::assertDispatched(Verified::class, fn (Verified $event) => $event->user->is($user));
+});
+
+test('an already verified user hitting the link is still redirected home', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->get(pegafilaSignedVerificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link issued for another user is forbidden and verifies nothing', function () {
+    $owner = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($other)
+        ->get(pegafilaSignedVerificationUrl($owner))
+        ->assertForbidden();
+
+    expect($owner->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link whose hash does not match the user e-mail is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(pegafilaSignedVerificationUrl($user, str_repeat('a', 40)))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a tampered signed url is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(pegafilaSignedVerificationUrl($user).'&extra=1')
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned verification url is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get('/email/verify/'.$user->getKey().'/'.sha1($user->getEmailForVerification()))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
diff --git a/tests/Feature/PasswordResetFlowTest.php b/tests/Feature/PasswordResetFlowTest.php
new file mode 100644
index 0000000..23974fe
--- /dev/null
+++ b/tests/Feature/PasswordResetFlowTest.php
@@ -0,0 +1,165 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Facades\Route;
+
+uses(RefreshDatabase::class);
+
+test('the password reset routes are registered with their contract names', function () {
+    expect(Route::has('password.request'))->toBeTrue()
+        ->and(route('password.request'))->toBe(url('/forgot-password'))
+        ->and(route('password.email'))->toBe(url('/forgot-password'))
+        ->and(route('password.reset', ['token' => 'abc']))->toBe(url('/reset-password/abc'))
+        ->and(route('password.update'))->toBe(url('/reset-password'));
+});
+
+test('the password reset routes are guest only and the request endpoint is throttled', function () {
+    expect(Route::getRoutes()->getByName('password.request')->gatherMiddleware())->toContain('guest')
+        ->and(Route::getRoutes()->getByName('password.email')->gatherMiddleware())->toContain('guest', 'throttle:6,1')
+        ->and(Route::getRoutes()->getByName('password.reset')->gatherMiddleware())->toContain('guest')
+        ->and(Route::getRoutes()->getByName('password.update')->gatherMiddleware())->toContain('guest');
+});
+
+test('the forgot password form renders an e-mail field', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('name="email"', false)
+        ->assertSee('for="email"', false)
+        ->assertSee(route('password.email'), false);
+});
+
+test('authenticated users are kept out of the forgot password flow', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('password.request'))->assertRedirect('/');
+
+    $this->actingAs($user)
+        ->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect('/');
+
+    Notification::assertNothingSent();
+});
+
+test('requesting a reset link for a known e-mail notifies the user and flashes the standard status', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $response = $this->from(route('password.request'))->post(route('password.email'), [
+        'email' => $user->email,
+    ]);
+
+    $response->assertRedirect(route('password.request'));
+    $response->assertSessionHas('status', __('passwords.sent'));
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('requesting a reset link for an unknown e-mail flashes the very same status', function () {
+    Notification::fake();
+
+    $response = $this->from(route('password.request'))->post(route('password.email'), [
+        'email' => 'ninguem@exemplo.com',
+    ]);
+
+    $response->assertRedirect(route('password.request'));
+    $response->assertSessionHas('status', __('passwords.sent'));
+    Notification::assertNothingSent();
+});
+
+test('the forgot password request validates the e-mail', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nao-e-um-email'])
+        ->assertSessionHasErrors('email');
+
+    Notification::assertNothingSent();
+});
+
+test('the forgot password request allows six attempts per minute', function () {
+    foreach (range(1, 6) as $attempt) {
+        $this->post(route('password.email'), ['email' => "tente{$attempt}@exemplo.com"])
+            ->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'sete@exemplo.com'])->assertStatus(429);
+});
+
+test('the reset password form renders with a single e-mail input', function () {
+    $response = $this->get(route('password.reset', ['token' => 'meu-token']).'?email=ana@exemplo.com');
+
+    $response->assertOk()
+        ->assertSee('name="password"', false)
+        ->assertSee('name="password_confirmation"', false)
+        ->assertSee('name="token"', false);
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('the password update validates token, e-mail and password strength', function () {
+    $this->post(route('password.update'), [
+        'token' => '',
+        'email' => 'nao-e-um-email',
+        'password' => 'fraca',
+        'password_confirmation' => 'fraca',
+    ])->assertSessionHasErrors(['token', 'email', 'password']);
+
+    $this->post(route('password.update'), [
+        'token' => 'qualquer',
+        'email' => 'ana@exemplo.com',
+        'password' => 'soletras',
+        'password_confirmation' => 'soletras',
+    ])->assertSessionHasErrors('password');
+
+    $this->post(route('password.update'), [
+        'token' => 'qualquer',
+        'email' => 'ana@exemplo.com',
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'OutraSenha123',
+    ])->assertSessionHasErrors('password');
+});
+
+test('a valid reset saves the password, rotates the remember token and fires PasswordReset', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create();
+    $previousRememberToken = $user->remember_token;
+    $token = Password::broker()->createToken($user);
+
+    $response = $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ]);
+
+    $response->assertRedirect('/');
+    $response->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NovaSenha123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe($previousRememberToken);
+
+    Event::assertDispatched(PasswordReset::class, fn (PasswordReset $event) => $event->user->is($user));
+});
+
+test('an invalid reset token is rejected without touching the password', function () {
+    $user = User::factory()->create();
+    $password = $user->password;
+
+    $this->post(route('password.update'), [
+        'token' => 'token-invalido',
+        'email' => $user->email,
+        'password' => 'NovaSenha123',
+        'password_confirmation' => 'NovaSenha123',
+    ])->assertSessionHasErrors('email');
+
+    expect($user->fresh()->password)->toBe($password);
+});
