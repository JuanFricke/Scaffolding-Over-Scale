@@ -66,7 +69,25 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $footer = $this->mentionFooter();
+
+        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength - mb_strlen($footer)).$footer;
+    }
+
+    /**
+     * Discord user mention on its own line, or an empty string when no valid snowflake is configured.
+     */
+    private function mentionFooter(): string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (! is_string($id) && ! is_int($id)) {
+            return '';
+        }
+
+        $id = trim((string) $id);
+
+        return preg_match(self::MentionIdPattern, $id) === 1 ? "\n<@{$id}>" : '';
     }
 
     private function safe(string $key, mixed $value): string
