+    $zebra = Queue::factory()->for($entity)->create(['name' => 'Zebra', 'slug' => 'zebra', 'is_active' => true]);
+    $alpha = Queue::factory()->for($entity)->create(['name' => 'Alpha', 'slug' => 'alpha', 'is_active' => true]);
+    $hidden = Queue::factory()->for($entity)->create(['name' => 'Hidden', 'slug' => 'hidden', 'is_active' => true]);
+    $inactive = Queue::factory()->for($entity)->create(['name' => 'Aardvark', 'slug' => 'aardvark', 'is_active' => false]);
+    $preset->queues()->attach([$zebra->id, $alpha->id, $inactive->id]);
+
+    // Re-pair so the JWT scope includes the new queues.
+    $preset->update(['login_code' => '654321', 'login_code_expires_at' => now()->addMinutes(10), 'login_code_consumed_at' => null]);
+    $token = $this->postJson('/api/totem/auth', ['code' => '654321'])->assertStatus(200)->json('token');
+
+    $response = $this->getJson("/api/{$entity->slug}/queues", authHeaders($token));
+    $response->assertStatus(200);
+
+    $body = $response->json();
+    expect($body['entity'])->toBe(['slug' => $entity->slug, 'name' => $entity->name])
+        ->and(array_column($body['queues'], 'slug'))->toBe(['alpha', 'zebra']);
+
+    foreach ($body['queues'] as $index => $queue) {
+        expect($queue['label'])->toBeString()->not->toBeEmpty()
+            ->and($queue)->toHaveKeys(['slug', 'label', 'description', 'visual', 'is_active'])
+            ->and($queue['is_active'])->toBeTrue()
+            ->and($queue['visual']['order'])->toBe($index + 1)
+            ->and($queue['visual'])->toHaveKeys(['color', 'icon', 'order']);
+    }
+
+    expect(array_column($body['queues'], 'slug'))->not->toContain('hidden', 'aardvark');
+});
+
+it('forbids entity mismatch and unknown queue slugs', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $queue = $preset->queues()->first();
+
+    $other = Entity::factory()->create();
+    $otherQueue = Queue::factory()->for($other)->create(['is_active' => true]);
+
+    $this->getJson("/api/{$other->slug}/queues", authHeaders($token))->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+    $this->getJson("/api/{$entity->slug}/nope/priorities", authHeaders($token))->assertStatus(404)->assertExactJson(['code' => 'queue_not_found']);
+    $this->getJson("/api/{$entity->slug}/{$otherQueue->slug}/priorities", authHeaders($token))->assertStatus(404)->assertExactJson(['code' => 'queue_not_found']);
+    $this->postJson("/api/{$entity->slug}/nope/ticket", ['priority' => 0], authHeaders($token))->assertStatus(404)->assertExactJson(['code' => 'queue_not_found']);
+    expect($queue)->not->toBeNull();
+});
+
+it('forbids queues outside the effective scope', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $outside = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $this->getJson("/api/{$entity->slug}/{$outside->slug}/priorities", authHeaders($token))
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+
+    $this->postJson("/api/{$entity->slug}/{$outside->slug}/ticket", ['priority' => 0], authHeaders($token))
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+});
+
+it('applies preset queue removal to existing tokens immediately', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $queue = $preset->queues()->first();
+
+    $this->getJson("/api/{$entity->slug}/{$queue->slug}/priorities", authHeaders($token))->assertStatus(200);
+
+    $preset->queues()->detach($queue->id);
+
+    $this->getJson("/api/{$entity->slug}/{$queue->slug}/priorities", authHeaders($token))
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+});
+
+it('lists backend-owned priorities with labels and visuals', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $queue = $preset->queues()->first();
+
+    $response = $this->getJson("/api/{$entity->slug}/{$queue->slug}/priorities", authHeaders($token));
+    $response->assertStatus(200);
+
+    $body = $response->json();
+    expect($body['entity'])->toBe(['slug' => $entity->slug])
+        ->and($body['queue'])->toBe(['slug' => $queue->slug, 'label' => $queue->name])
+        ->and(array_column($body['priorities'], 'value'))->toBe([0, 10, 20])
+        ->and(array_column($body['priorities'], 'label'))->toBe(['Normal', 'Prioritário', 'Prioridade 80+']);
+
+    foreach ($body['priorities'] as $index => $priority) {
+        expect($priority['visual']['order'])->toBe($index + 1)
+            ->and($priority['visual'])->toHaveKeys(['color', 'icon', 'order']);
+    }
+});
+
+it('rejects priorities for inactive queues', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $queue = $preset->queues()->first();
+    $queue->update(['is_active' => false]);
+
+    $this->getJson("/api/{$entity->slug}/{$queue->slug}/priorities", authHeaders($token))
+        ->assertStatus(422)->assertExactJson(['code' => 'inactive_queue']);
+});
+
+it('issues totem tickets sequentially with explicit priority labels', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $queue = $preset->queues()->first();
+
+    $first = $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], authHeaders($token));
+    $first->assertStatus(201);
+    expect($first->json('slug'))->toBe('A001')
+        ->and($first->json('queue'))->toBe(['slug' => $queue->slug, 'label' => $queue->name])
+        ->and($first->json('priority'))->toBe(['value' => 0, 'label' => 'Normal'])
+        ->and($first->json('issued_at'))->toBeString();
+
+    $second = $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 10], authHeaders($token));
+    $second->assertStatus(201);
+    expect($second->json('slug'))->toBe('A002')
+        ->and($second->json('priority'))->toBe(['value' => 10, 'label' => 'Prioritário']);
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->pluck('channel')->all())
+        ->each->toBe(TicketChannel::Totem);
+});
+
+it('rejects invalid priorities and inactive queues without creating tickets', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $queue = $preset->queues()->first();
+
+    foreach ([-1, 1, 5, 99] as $priority) {
+        $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => $priority], authHeaders($token))
+            ->assertStatus(422)->assertExactJson(['code' => 'invalid_priority']);
+    }
+
+    $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", [], authHeaders($token))
+        ->assertStatus(422)->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+
+    $queue->update(['is_active' => false]);
+    $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], authHeaders($token))
+        ->assertStatus(422)->assertExactJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('throttles ticket issuance at 30 requests per minute', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $queue = $preset->queues()->first();
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], authHeaders($token))->assertStatus(201);
+    }
+
+    $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], authHeaders($token))
+        ->assertStatus(429)->assertExactJson(['code' => 'rate_limited']);
+});
diff --git a/tests/Feature/TotemAuthTest.php b/tests/Feature/TotemAuthTest.php
new file mode 100644
index 0000000..0425480
--- /dev/null
+++ b/tests/Feature/TotemAuthTest.php
@@ -0,0 +1,165 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function makePresetWithQueues(int $queueCount = 2): TotemPreset
+{
+    $preset = TotemPreset::factory()->create();
+
+    $queues = Queue::factory()->count($queueCount)->for($preset->entity)->create(['is_active' => true]);
+    $preset->queues()->attach($queues->pluck('id')->all());
+
+    return $preset->fresh();
+}
+
+it('rejects codes that are not exactly 6 digits', function (mixed $code) {
+    $payload = $code === '__missing__' ? [] : ['code' => $code];
+    $response = $this->postJson('/api/totem/auth', $payload);
+
+    $response->assertStatus(400)->assertExactJson(['code' => 'invalid_code_format']);
+})->with([
+    'empty string' => [''],
+    'five digits' => ['12345'],
+    'seven digits' => ['1234567'],
+    'letters' => ['abcdef'],
+    'mixed' => ['12a456'],
+    'null' => [null],
+    'missing' => ['__missing__'],
+]);
+
+it('rejects unknown pairing codes without oracle differences', function () {
+    $response = $this->postJson('/api/totem/auth', ['code' => '000000']);
+
+    $response->assertStatus(401)->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('rejects expired pairing codes', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '111111',
+        'login_code_expires_at' => now()->subMinute(),
+        'login_code_consumed_at' => null,
+        'is_active' => true,
+    ]);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => '111111']);
+
+    $response->assertStatus(401)->assertExactJson(['code' => 'invalid_pairing_code']);
+    expect($preset->fresh()->login_code_consumed_at)->toBeNull();
+});
+
+it('rejects already consumed pairing codes', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '222222',
+        'login_code_expires_at' => now()->addMinutes(10),
+        'login_code_consumed_at' => now(),
+        'is_active' => true,
+    ]);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => '222222']);
+
+    $response->assertStatus(401)->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('rejects pairing codes from inactive presets', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '333333',
+        'login_code_expires_at' => now()->addMinutes(10),
+        'login_code_consumed_at' => null,
+        'is_active' => false,
+    ]);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => '333333']);
+
+    $response->assertStatus(401)->assertExactJson(['code' => 'invalid_pairing_code']);
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('issues a JWT and creates an active totem on valid pairing', function () {
+    $preset = makePresetWithQueues(2);
+    $preset->update([
+        'login_code' => '444444',
+        'login_code_expires_at' => now()->addMinutes(10),
+        'login_code_consumed_at' => null,
+        'is_active' => true,
+    ]);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => '444444']);
+
+    $response->assertStatus(200);
+    $payload = $response->json();
+
+    expect($payload['token'])->toBeString()->not->toBeEmpty()
+        ->and($payload['token_type'])->toBe('Bearer')
+        ->and($payload['expires_in'])->toBe(3600)
+        ->and($payload['entity']['slug'])->toBe($preset->entity->slug)
+        ->and($payload['entity']['name'])->toBe($preset->entity->name);
+
+    expect($preset->fresh()->login_code_consumed_at)->not->toBeNull();
+
+    $totem = Totem::query()->first();
+    expect($totem)->not->toBeNull()
+        ->and($totem->entity_id)->toBe($preset->entity_id)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull();
+
+    $claims = app(TotemJwt::class)->decode($payload['token']);
+    expect($claims['totem_id'])->toBe($totem->id)
+        ->and($claims['entity_id'])->toBe($preset->entity_id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['queues'])->toEqualCanonicalizing($preset->queues()->pluck('queues.id')->all())
+        ->and($claims['exp'] - $claims['iat'])->toBe(3600);
+});
+
+it('consumes the pairing code atomically so it cannot be reused', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '555555',
+        'login_code_expires_at' => now()->addMinutes(10),
+        'login_code_consumed_at' => null,
+        'is_active' => true,
+    ]);
+
+    $this->postJson('/api/totem/auth', ['code' => '555555'])->assertStatus(200);
+    $this->postJson('/api/totem/auth', ['code' => '555555'])->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('throttles pairing attempts at 10 requests per minute', function () {
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '999999']);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '999999'])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('audit logs pairing success and failure without the full code', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '666666',
+        'login_code_expires_at' => now()->addMinutes(10),
+        'login_code_consumed_at' => null,
+        'is_active' => true,
+    ]);
+
+    $this->postJson('/api/totem/auth', ['code' => '666666'])->assertStatus(200);
+
+    // Use a code that is guaranteed invalid for the failure case.
+    $this->postJson('/api/totem/auth', ['code' => '000001'])->assertStatus(401);
+
+    $contents = '';
+    foreach ((array) glob(storage_path('logs/audit-*.log')) as $file) {
+        $contents .= (string) file_get_contents($file);
+    }
+
+    expect($contents)->toContain('totem.pairing.success')
+        ->and($contents)->toContain('totem.pairing.failed')
+        ->and($contents)->not->toContain('666666');
+});
diff --git a/tests/Feature/TotemCorsTest.php b/tests/Feature/TotemCorsTest.php
new file mode 100644
index 0000000..490adb4
--- /dev/null
+++ b/tests/Feature/TotemCorsTest.php
@@ -0,0 +1,45 @@
+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('answers preflight from localhost with the requesting origin', function () {
+    $response = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'http://localhost:8081',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+});
+
+it('answers preflight from 127.0.0.1 with the requesting origin', function () {
+    $response = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'http://127.0.0.1:3000',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('http://127.0.0.1:3000');
+});
+
+it('sends no allow-origin header for disallowed origins', function () {
+    $response = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'https://evil.example.com',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+
+    $preset = TotemPreset::factory()->create();
+    $actual = $this->getJson('/api/nonexistent/queues', ['Origin' => 'https://evil.example.com']);
+    expect($actual->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+});
+
+it('echoes allowed origins on actual api responses', function () {
+    $response = $this->postJson('/api/totem/auth', ['code' => '123456'], ['Origin' => 'http://localhost:8081']);
+
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+});
diff --git a/tests/Feature/TotemPairingCommandTest.php b/tests/Feature/TotemPairingCommandTest.php
new file mode 100644
index 0000000..244c21d
--- /dev/null
+++ b/tests/Feature/TotemPairingCommandTest.php
@@ -0,0 +1,51 @@
+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('generates a random 6-digit pairing code expiring in 10 minutes', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => null,
+        'login_code_expires_at' => null,
+        'login_code_consumed_at' => now(),
+    ]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+        ->assertSuccessful();
+
+    $preset->refresh();
+
+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->login_code_expires_at)->not->toBeNull()
+        ->and(now()->diffInMinutes($preset->login_code_expires_at))->toBeGreaterThanOrEqual(9);
+});
+
+it('regenerates the pairing code replacing the previous one', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+    $first = $preset->refresh()->login_code;
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+    $second = $preset->refresh()->login_code;
+
+    // Cryptographically random: collisions across regenerations are negligible.
+    expect($second)->toMatch('/^\d{6}$/');
+    expect($preset->login_code_consumed_at)->toBeNull();
+});
+
+it('prints the pairing code to the console', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => null]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+        ->expectsOutputToContain($preset->refresh()->login_code)
+        ->assertSuccessful();
+});
+
+it('fails for an unknown preset id', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999999])
+        ->assertFailed();
+});
