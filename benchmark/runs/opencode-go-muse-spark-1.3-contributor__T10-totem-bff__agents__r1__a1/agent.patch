@@ -0,0 +1,83 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use App\Support\TotemJwtException;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Validates the totem JWT on every data call.
+ *
+ * Failure (missing/invalid/expired token, inactive totem or preset, entity
+ * mismatch) answers `401 {"code":"invalid_token"}`. On success the resolved
+ * rows are bound to the request attributes (`totem`, `totem_preset`,
+ * `totem_entity`, `totem_scope`) and `totems.last_seen_at` is refreshed
+ * quietly (never failing the request).
+ *
+ * The effective queue scope is the intersection of the JWT `queues` claim
+ * with the preset's current queue join, so removing a queue from the preset
+ * takes effect immediately for existing tokens.
+ */
+class TotemAuth
+{
+    public function __construct(private TotemJwt $jwt) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null) {
+            return $this->invalid();
+        }
+
+        try {
+            $claims = $this->jwt->decode($token);
+        } catch (TotemJwtException) {
+            return $this->invalid();
+        }
+
+        $totem = Totem::query()->find($claims['totem_id']);
+        $preset = TotemPreset::query()->find($claims['preset_id']);
+        $entity = Entity::query()->find($claims['entity_id']);
+
+        if ($totem === null || $preset === null || $entity === null) {
+            return $this->invalid();
+        }
+
+        if (! $totem->is_active || ! $preset->is_active) {
+            return $this->invalid();
+        }
+
+        if ($totem->entity_id !== $entity->id || $preset->entity_id !== $entity->id) {
+            return $this->invalid();
+        }
+
+        $current = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+        $claimed = array_map(intval(...), (array) $claims['queues']);
+        $scope = array_values(array_intersect($claimed, $current));
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_scope', $scope);
+
+        try {
+            $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+        } catch (\Throwable) {
+            // Quiet refresh: a stale timestamp must never fail the request.
+        }
+
+        return $next($request);
+    }
+
+    private function invalid(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
