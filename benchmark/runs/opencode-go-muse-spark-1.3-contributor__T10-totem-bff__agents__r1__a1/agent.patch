+<?php
+
+namespace App\Support;
+
+use Illuminate\Support\Str;
+
+/**
+ * Minimal correct HS256 JWT for totem pairing tokens.
+ *
+ * Claims: `totem_id`, `entity_id`, `preset_id`, `queues` (allowed queue ids
+ * at pairing time), `iat`, `exp`, `jti`. Secret and TTL come from
+ * `services.totem` (`TOTEM_JWT_SECRET` / `TOTEM_JWT_TTL`).
+ */
+class TotemJwtException extends \RuntimeException {}
+
+class TotemJwt
+{
+    public function secret(): string
+    {
+        return (string) config('services.totem.jwt_secret');
+    }
+
+    public function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl', 3600);
+    }
+
+    /**
+     * Issue a signed token for the given totem scope.
+     *
+     * @param  array{totem_id: int, entity_id: int, preset_id: int, queues: list<int>}  $scope
+     */
+    public function issue(array $scope): string
+    {
+        $now = time();
+
+        return $this->encode(array_merge($scope, [
+            'iat' => $now,
+            'exp' => $now + $this->ttl(),
+            'jti' => (string) Str::uuid(),
+        ]));
+    }
+
+    /**
+     * Sign arbitrary claims (used by tests to craft expired tokens).
+     */
+    public function encode(array $claims): string
+    {
+        $header = $this->base64UrlEncode((string) json_encode(['alg' => 'HS256', 'typ' => 'JWT']));
+        $payload = $this->base64UrlEncode((string) json_encode($claims));
+        $signature = $this->base64UrlEncode(hash_hmac('sha256', $header.'.'.$payload, $this->secret(), true));
+
+        return $header.'.'.$payload.'.'.$signature;
+    }
+
+    /**
+     * Verify the signature, algorithm and expiry; return the claims.
+     *
+     * @return array<string, mixed>
+     *
+     * @throws TotemJwtException
+     */
+    public function decode(string $token): array
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            throw new TotemJwtException('Malformed token.');
+        }
+
+        [$headerB64, $payloadB64, $signatureB64] = $parts;
+
+        $header = json_decode($this->base64UrlDecode($headerB64), true);
+
+        if (! is_array($header) || ($header['alg'] ?? null) !== 'HS256') {
+            throw new TotemJwtException('Unsupported algorithm.');
+        }
+
+        $expected = $this->base64UrlEncode(hash_hmac('sha256', $headerB64.'.'.$payloadB64, $this->secret(), true));
+
+        if (! hash_equals($expected, $signatureB64)) {
+            throw new TotemJwtException('Invalid signature.');
+        }
+
+        $claims = json_decode($this->base64UrlDecode($payloadB64), true);
+
+        if (! is_array($claims)) {
+            throw new TotemJwtException('Malformed payload.');
+        }
+
+        foreach (['totem_id', 'entity_id', 'preset_id', 'queues', 'iat', 'exp'] as $claim) {
+            if (! array_key_exists($claim, $claims)) {
+                throw new TotemJwtException("Missing claim: {$claim}.");
+            }
+        }
+
+        if (! is_int($claims['exp']) && ! is_numeric($claims['exp'])) {
+            throw new TotemJwtException('Invalid expiry.');
+        }
+
+        if ((int) $claims['exp'] < time()) {
+            throw new TotemJwtException('Expired token.');
+        }
+
+        return $claims;
+    }
+
+    private function base64UrlEncode(string $data): string
+    {
+        return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');
+    }
+
+    private function base64UrlDecode(string $data): string
+    {
+        $padded = strtr($data, '-_', '+/').str_repeat('=', (4 - strlen($data) % 4) % 4);
+        $decoded = base64_decode($padded, true);
+
+        if ($decoded === false) {
+            throw new TotemJwtException('Malformed encoding.');
+        }
+
+        return $decoded;
+    }
+}
