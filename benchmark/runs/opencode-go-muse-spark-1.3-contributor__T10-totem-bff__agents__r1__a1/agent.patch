+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Open a pairing window for a totem preset.
+ *
+ * Generates the preset's own cryptographically random 6-digit code,
+ * expiring in 10 minutes. Regenerating replaces the previous code and
+ * clears any consumption, so the old code stops working immediately.
+ */
+class TotemPairingCode extends Command
+{
+    /**
+     * @var string
+     */
+    protected $signature = 'totem:pairing-code {preset}';
+
+    /**
+     * @var string
+     */
+    protected $description = 'Generate a 6-digit pairing code for a totem preset (valid 10 minutes)';
+
+    public function handle(): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if ($preset === null) {
+            $this->error('Totem preset not found.');
+
+            return self::FAILURE;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        // Audit the pairing window without the code itself.
+        Log::channel('audit')->info('totem.pairing-code.generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        $this->info("Pairing code for preset [{$preset->name}]: {$code}");
+        $this->line('Valid for 10 minutes. Single use.');
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemController.php b/app/Http/Controllers/Api/TotemController.php
new file mode 100644
index 0000000..7f2c78c
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemController.php
@@ -0,0 +1,233 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use App\Support\TotemPriorities;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Totem BFF: pairing login + queue/priority reads + ticket issuance.
+ *
+ * All data endpoints run behind the `totem.auth` middleware, which binds
+ * `totem`, `totem_preset`, `totem_entity` and `totem_scope` (effective queue
+ * ids: JWT claim ∩ preset's current join) to the request. Billing does not
+ * exist yet, so `entity_suspended` is reserved and never sent.
+ */
+class TotemController extends Controller
+{
+    public function __construct(private TotemJwt $jwt) {}
+
+    /**
+     * Pair a totem via the preset's 6-digit login code and issue a JWT.
+     */
+    public function auth(Request $request): Response
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || preg_match('/^\d{6}$/', $code) !== 1) {
+            Log::channel('audit')->info('totem.pairing.failed', ['reason' => 'invalid_code_format']);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $now = now();
+
+        $paired = DB::transaction(function () use ($code, $now): ?array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null
+                || ! $preset->is_active
+                || $preset->login_code_consumed_at !== null
+                || $preset->login_code_expires_at === null
+                || $preset->login_code_expires_at->lte($now)
+            ) {
+                return null;
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => $now])->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => $now,
+            ]);
+
+            $queueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+
+            $token = $this->jwt->issue([
+                'totem_id' => $totem->id,
+                'entity_id' => $preset->entity_id,
+                'preset_id' => $preset->id,
+                'queues' => $queueIds,
+            ]);
+
+            return [$preset, $totem, $token];
+        });
+
+        if ($paired === null) {
+            Log::channel('audit')->info('totem.pairing.failed', ['reason' => 'invalid_pairing_code']);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        /** @var TotemPreset $preset */
+        /** @var Totem $totem */
+        [$preset, $totem, $token] = $paired;
+
+        // Never log the full pairing code — only the resolved rows.
+        Log::channel('audit')->info('totem.pairing.success', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'totem_id' => $totem->id,
+        ]);
+
+        $entity = $preset->entity;
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => $this->jwt->ttl(),
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+        ]);
+    }
+
+    /**
+     * List the preset's active queues for the token's entity, ordered by name.
+     */
+    public function queues(Request $request, string $entity): Response
+    {
+        $tokenEntity = $request->attributes->get('totem_entity');
+
+        if ($entity !== $tokenEntity->slug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        /** @var list<int> $scope */
+        $scope = $request->attributes->get('totem_scope', []);
+
+        $queues = Queue::query()
+            ->where('entity_id', $tokenEntity->id)
+            ->whereIn('id', $scope)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug, 'name' => $tokenEntity->name],
+            'queues' => $queues->values()->map(fn (Queue $queue, int $index) => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => $queue->name,
+                'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => $index + 1],
+                'is_active' => true,
+            ])->all(),
+        ]);
+    }
+
+    /**
+     * List the backend-owned priority levels for a queue.
+     */
+    public function priorities(Request $request, string $entity, string $queue): Response
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof Response) {
+            return $resolved;
+        }
+
+        [$tokenEntity, $queueModel] = $resolved;
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => TotemPriorities::ALL,
+        ]);
+    }
+
+    /**
+     * Issue a ticket in a queue with a backend-owned priority value.
+     */
+    public function issue(Request $request, string $entity, string $queue): Response
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof Response) {
+            return $resolved;
+        }
+
+        [$tokenEntity, $queueModel] = $resolved;
+
+        $priority = $request->input('priority');
+
+        if (! is_int($priority) || TotemPriorities::find($priority) === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = (new IssueTicket)($queueModel->fresh(), $priority, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $level = TotemPriorities::find($priority);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => ['value' => $level['value'], 'label' => $level['label']],
+            'issued_at' => $ticket->issued_at->toISO8601String(),
+        ], 201);
+    }
+
+    /**
+     * Resolve `{entity}` against the token and `{queue}` within that entity.
+     *
+     * @return array{0: Entity, 1: Queue}|Response
+     */
+    private function resolveQueue(Request $request, string $entity, string $queue): array|Response
+    {
+        $tokenEntity = $request->attributes->get('totem_entity');
+
+        if ($entity !== $tokenEntity->slug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $queueModel = Queue::query()
+            ->where('entity_id', $tokenEntity->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if ($queueModel === null) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        /** @var list<int> $scope */
+        $scope = $request->attributes->get('totem_scope', []);
+
+        if (! in_array($queueModel->id, $scope, true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return [$tokenEntity, $queueModel];
+    }
+}
