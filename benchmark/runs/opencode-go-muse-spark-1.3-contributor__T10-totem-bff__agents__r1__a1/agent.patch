+<?php
+
+namespace App\Support;
+
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Shared CORS rules for the totem web build (`api/*` paths only).
+ *
+ * Allowed origins: `http(s)://localhost[:port]`,
+ * `http(s)://127.0.0.1[:port]`, plus an optional `TOTEM_WEB_ORIGIN` env
+ * (`services.totem.web_origin`). Anything else gets no
+ * `Access-Control-Allow-Origin` header. No credentials.
+ */
+class TotemCors
+{
+    public static function isAllowed(?string $origin): bool
+    {
+        if ($origin === null || $origin === '') {
+            return false;
+        }
+
+        $parts = parse_url($origin);
+
+        if (! is_array($parts) || ! in_array($parts['scheme'] ?? null, ['http', 'https'], true)) {
+            return false;
+        }
+
+        $host = strtolower((string) ($parts['host'] ?? ''));
+
+        if ($host === 'localhost' || $host === '127.0.0.1') {
+            return true;
+        }
+
+        $extra = (string) config('services.totem.web_origin');
+
+        return $extra !== '' && $origin === $extra;
+    }
+
+    public static function decorate(Response $response, ?string $origin): void
+    {
+        if (! self::isAllowed($origin)) {
+            return;
+        }
+
+        $response->headers->set('Access-Control-Allow-Origin', $origin);
+        $response->headers->set('Vary', 'Origin', false);
+    }
+
+    /**
+     * @return array<string, string>
+     */
+    public static function preflightHeaders(): array
+    {
+        return [
+            'Access-Control-Allow-Methods' => 'GET, POST, OPTIONS',
+            'Access-Control-Allow-Headers' => 'Authorization, Content-Type, Accept, X-Requested-With',
+            'Access-Control-Max-Age' => '86400',
+        ];
+    }
+}
