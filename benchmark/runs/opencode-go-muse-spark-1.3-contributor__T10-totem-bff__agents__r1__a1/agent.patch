+
+it('rejects unauthenticated data calls with invalid_token', function () {
+    [$preset] = totemSetup(1);
+    $entity = $preset->entity;
+
+    $this->getJson("/api/{$entity->slug}/queues")->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+    $this->getJson("/api/{$entity->slug}/queues", ['Authorization' => 'Bearer invalid'])->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects expired tokens and inactive totems or presets', function () {
+    [$preset, $token] = totemSetup(1);
+    $entity = $preset->entity;
+    $jwt = app(TotemJwt::class);
+
+    $claims = $jwt->decode($token);
+
+    // Expired token.
+    $expired = $jwt->encode(array_merge($claims, ['exp' => time() - 10]));
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders($expired))->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+
+    // Inactive totem.
+    Totem::query()->whereKey($claims['totem_id'])->update(['is_active' => false]);
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders($token))->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+    Totem::query()->whereKey($claims['totem_id'])->update(['is_active' => true]);
+
+    // Inactive preset.
+    $preset->update(['is_active' => false]);
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders($token))->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+    $preset->update(['is_active' => true]);
+
+    // Entity mismatch between token and stored rows.
+    $other = Entity::factory()->create();
+    Totem::query()->whereKey($claims['totem_id'])->update(['entity_id' => $other->id]);
+    $this->getJson("/api/{$entity->slug}/queues", authHeaders($token))->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
