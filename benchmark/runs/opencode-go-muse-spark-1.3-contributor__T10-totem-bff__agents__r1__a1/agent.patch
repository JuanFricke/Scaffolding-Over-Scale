+function totemSetup(int $queueCount = 2): array
+{
+    $preset = TotemPreset::factory()->create();
+    $queues = Queue::factory()->count($queueCount)->for($preset->entity)->create(['is_active' => true]);
+    $preset->queues()->attach($queues->pluck('id')->all());
+
+    $preset->update([
+        'login_code' => '123456',
+        'login_code_expires_at' => now()->addMinutes(10),
+        'login_code_consumed_at' => null,
+        'is_active' => true,
+    ]);
+
+    $response = test()->postJson('/api/totem/auth', ['code' => '123456']);
+    $response->assertStatus(200);
+
+    return [$preset->fresh(), $response->json('token')];
+}
+
+function authHeaders(string $token): array
+{
+    return ['Authorization' => 'Bearer '.$token];
+}
+
+it('exposes the totem contract: models, factories, command signature and config', function () {
+    expect(class_exists(Totem::class))->toBeTrue()
+        ->and(class_exists(TotemPreset::class))->toBeTrue()
+        ->and(method_exists(TotemPreset::class, 'entity'))->toBeTrue()
+        ->and(method_exists(TotemPreset::class, 'queues'))->toBeTrue()
+        ->and(method_exists(Entity::class, 'totems'))->toBeTrue()
+        ->and(method_exists(Entity::class, 'totemPresets'))->toBeTrue();
+
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->entity)->toBeInstanceOf(Entity::class)
+        ->and($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_expires_at)->not->toBeNull()
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->is_active)->toBeTrue();
+
+    expect(Totem::factory()->create())->toBeInstanceOf(Totem::class);
+
+    $preset->queues()->attach($q = Queue::factory()->for($preset->entity)->create()->id);
+    expect($preset->queues()->pluck('queues.id')->all())->toContain($q);
+    $preset->queues()->detach($q);
+    expect($preset->queues()->pluck('queues.id')->all())->not->toContain($q);
+
+    expect(config('services.totem.jwt_secret'))->toBeString()->not->toBeEmpty()
+        ->and(strlen((string) config('services.totem.jwt_secret')))->toBeGreaterThanOrEqual(32)
+        ->and((int) config('services.totem.jwt_ttl'))->toBe(3600);
