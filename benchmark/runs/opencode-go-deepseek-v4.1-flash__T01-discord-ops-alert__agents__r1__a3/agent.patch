diff --git a/tests/Feature/LoggingConfigTest.php b/tests/Feature/LoggingConfigTest.php
new file mode 100644
index 0000000..98569f0
--- /dev/null
+++ b/tests/Feature/LoggingConfigTest.php
@@ -0,0 +1,50 @@
+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('daily is configured as the archive channel', function () {
+    $daily = config('logging.channels.daily');
+
+    expect($daily)
+        ->toBeArray()
+        ->and($daily['driver'])->toBe('daily')
+        ->and($daily['path'])->toEndWith('logs/laravel.log')
+        ->and($daily['days'])->toBe(14);
+});
+
+test('audit is configured as its own rotated channel', function () {
+    $audit = config('logging.channels.audit');
+
+    expect($audit)
+        ->toBeArray()
+        ->and($audit['driver'])->toBe('daily')
+        ->and($audit['path'])->toEndWith('logs/audit.log')
+        ->and($audit['level'])->toBe('info')
+        ->and($audit['days'])->toBe(90);
+});
+
+test('the audit channel accepts writes', function () {
+    expect(Log::channel('audit'))->not->toBeNull();
+
+    Log::channel('audit')->info('Subscription status changed', ['entity_id' => 42]);
+
+    expect(true)->toBeTrue();
+});
+
+test('the default stack includes the archive channel', function () {
+    expect(config('logging.channels.stack.channels'))->toContain('daily');
+});
+
+test('there is no discord logging channel', function () {
+    expect(config('logging.channels'))->not->toHaveKey('discord');
+});
+
+test('the example environment documents the logging and alert keys', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)->toContain('LOG_STACK=daily');
+
+    foreach (['LOG_DAILY_DAYS', 'LOG_AUDIT_LEVEL', 'LOG_AUDIT_DAYS', 'DISCORD_WEBHOOK_URL'] as $key) {
+        expect($env)->toMatch('/^'.$key.'=/m');
+    }
+});
diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..f888fc5
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,165 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+beforeEach(function () {
+    $this->webhookUrl = 'https://discord.com/api/webhooks/123456/very-secret-token';
+
+    config()->set('services.discord.webhook_url', $this->webhookUrl);
+});
+
+test('it is a no-op when the webhook is not configured', function (?string $url) {
+    config()->set('services.discord.webhook_url', $url);
+
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Queue failure', 'Job exhausted retries');
+
+    Http::assertNothingSent();
+})->with([
+    'null' => null,
+    'empty string' => '',
+]);
+
+test('it posts the title, message and context to the configured webhook', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Queue failure', 'Job exhausted retries', [
+        'entity_id' => 42,
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        return $request->method() === 'POST'
+            && $request->url() === $this->webhookUrl
+            && $request['content'] === "Queue failure\nJob exhausted retries\nentity_id=42\nqueue=asaas-webhooks";
+    });
+});
+
+test('it truncates the alert text to 1800 characters', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Long message', str_repeat('a', 2000));
+
+    Http::assertSent(function (Request $request) {
+        return mb_strlen($request['content']) === 1800;
+    });
+});
+
+test('it truncates multibyte text without breaking characters', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Long message', str_repeat('😀', 2000));
+
+    Http::assertSent(function (Request $request) {
+        return mb_strlen($request['content']) === 1800
+            && mb_check_encoding($request['content'], 'UTF-8');
+    });
+});
+
+test('it can be resolved from the container', function () {
+    expect(app(DiscordOpsAlert::class))->toBeInstanceOf(DiscordOpsAlert::class);
+});
+
+test('it redacts context values whose key looks sensitive', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Queue failure', 'Job exhausted retries', [
+        'password' => 'hunter2',
+        'access_token' => 'abc',
+        'client_secret' => 'shh',
+        'Authorization' => 'Basic abc',
+        'api_key' => 'one',
+        'api-key' => 'two',
+        'apikey' => 'three',
+        'webhook_url' => 'https://example.test/hook',
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'];
+
+        return str_contains($content, 'password=[redacted]')
+            && str_contains($content, 'access_token=[redacted]')
+            && str_contains($content, 'client_secret=[redacted]')
+            && str_contains($content, 'Authorization=[redacted]')
+            && str_contains($content, 'api_key=[redacted]')
+            && str_contains($content, 'api-key=[redacted]')
+            && str_contains($content, 'apikey=[redacted]')
+            && str_contains($content, 'webhook_url=[redacted]')
+            && str_contains($content, 'queue=asaas-webhooks');
+    });
+});
+
+test('it redacts bearer credentials regardless of the context key', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Queue failure', 'Job exhausted retries', [
+        'upstream' => 'Bearer super-secret-value',
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        return str_contains($request['content'], 'upstream=[redacted]')
+            && str_contains($request['content'], 'queue=asaas-webhooks');
+    });
+});
+
+test('it redacts nested context arrays recursively and renders them as json', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Queue failure', 'Job exhausted retries', [
+        'payload' => [
+            'secret' => 'shh',
+            'note' => 'Bearer abc.def',
+            'safe' => 'ok',
+            'headers' => [
+                'Authorization' => 'Basic abc',
+                'accept' => 'application/json',
+            ],
+        ],
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        $expected = 'payload={"secret":"[redacted]","note":"[redacted]","safe":"ok","headers":{"Authorization":"[redacted]","accept":"application/json"}}';
+
+        return str_contains($request['content'], $expected);
+    });
+});
+
+test('it logs an error when discord responds with a non-successful status', function () {
+    Log::spy();
+    Http::fake([
+        '*' => Http::response('', 500),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue failure', 'Job exhausted retries');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(function (string $message, array $context = []) {
+            return $message === 'Discord ops alert failed'
+                && $context['status'] === 500
+                && ! str_contains(json_encode($context), $this->webhookUrl);
+        });
+});
+
+test('it catches transport errors and logs them without the webhook url', function () {
+    Log::spy();
+    Http::fake(function () {
+        throw new ConnectionException("cURL error 6: Could not resolve host for {$this->webhookUrl}");
+    });
+
+    (new DiscordOpsAlert)->send('Queue failure', 'Job exhausted retries');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(function (string $message, array $context = []) {
+            return $message === 'Discord ops alert failed'
+                && ! str_contains(json_encode($context), $this->webhookUrl);
+        });
+});
