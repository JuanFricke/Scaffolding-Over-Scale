diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..c48e441
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,120 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Throwable;
+
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const REDACTED = '[redacted]';
+
+    /**
+     * Send one human-pageable alert to the configured Discord webhook.
+     *
+     * The call is a silent no-op when no webhook is configured and never
+     * throws: delivery failures are logged so they cannot break the caller.
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhookUrl = config('services.discord.webhook_url');
+
+        if (! is_string($webhookUrl) || $webhookUrl === '') {
+            return;
+        }
+
+        try {
+            $response = Http::timeout(5)
+                ->asJson()
+                ->post($webhookUrl, [
+                    'content' => $this->format($title, $message, $context),
+                ]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (Throwable $exception) {
+            Log::error('Discord ops alert failed', [
+                'exception' => $exception::class,
+                'message' => Str::limit($this->scrub($exception->getMessage(), $webhookUrl), 500, ''),
+            ]);
+        }
+    }
+
+    private function format(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->renderValue((string) $key, $value);
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH, 'UTF-8');
+    }
+
+    private function renderValue(string $key, mixed $value): string
+    {
+        if ($this->isSensitiveKey($key)) {
+            return self::REDACTED;
+        }
+
+        if (is_array($value)) {
+            $json = json_encode(
+                $this->redactArray($value),
+                JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE,
+            );
+
+            return $json === false ? '[]' : $json;
+        }
+
+        if (is_string($value)) {
+            return $this->containsBearerCredential($value) ? self::REDACTED : $value;
+        }
+
+        return match (true) {
+            is_bool($value) => $value ? 'true' : 'false',
+            $value === null => 'null',
+            is_scalar($value) => (string) $value,
+            default => self::REDACTED,
+        };
+    }
+
+    /**
+     * @return array<array-key, mixed>
+     */
+    private function redactArray(array $values): array
+    {
+        foreach ($values as $key => $value) {
+            if (is_string($key) && $this->isSensitiveKey($key)) {
+                $values[$key] = self::REDACTED;
+            } elseif (is_array($value)) {
+                $values[$key] = $this->redactArray($value);
+            } elseif (is_string($value) && $this->containsBearerCredential($value)) {
+                $values[$key] = self::REDACTED;
+            }
+        }
+
+        return $values;
+    }
+
+    private function isSensitiveKey(string $key): bool
+    {
+        return preg_match('/password|token|secret|authorization|api[_-]?key|webhook/i', $key) === 1;
+    }
+
+    private function containsBearerCredential(string $value): bool
+    {
+        return preg_match('/\bBearer\s+\S+/i', $value) === 1;
+    }
+
+    private function scrub(string $message, string $webhookUrl): string
+    {
+        return str_replace($webhookUrl, self::REDACTED, $message);
+    }
+}
