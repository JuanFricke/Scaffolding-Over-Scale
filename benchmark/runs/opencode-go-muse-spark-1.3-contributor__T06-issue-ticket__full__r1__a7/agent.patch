+
+test('ticket factory keeps an explicit code', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X');
+});
+
+test('nextCode skips malformed codes and follows insertion order', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    $ordered = Queue::factory()->create();
+    Ticket::factory()->forQueue($ordered)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($ordered)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($ordered->id))->toBe('A002');
+});
+
+test('nextCode grows beyond A999', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('nextCode does not reuse numbers after a middle delete', function () {
+    $queue = Queue::factory()->create();
+
+    $a001 = Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    $a002 = Ticket::factory()->forQueue($queue)->create(['code' => 'A002']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A003']);
+    $a002->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004')
+        ->and($a001->code)->toBe('A001');
