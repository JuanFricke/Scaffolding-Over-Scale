+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Issue the next ticket in the queue.
+     *
+     * @throws InvalidArgumentException when the priority is negative.
+     * @throws InactiveQueueException when the queue is inactive.
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        $attempts = 0;
+        $maxAttempts = 5;
+
+        while (true) {
+            $attempts++;
+
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    $fresh = Queue::whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+                    if (! $fresh->is_active) {
+                        throw new InactiveQueueException('Queue is inactive.');
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $fresh->getKey(),
+                        'code' => Ticket::nextCode($fresh->getKey()),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (InactiveQueueException $e) {
+                throw $e;
+            } catch (QueryException $e) {
+                if ($attempts < $maxAttempts && $this->isUniqueViolation($e)) {
+                    continue;
+                }
+
+                throw $e;
+            }
+        }
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        // SQLSTATE 23000 covers unique violations on both SQLite and MySQL/MariaDB.
+        return $e->getCode() === '23000'
+            || str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate entry');
+    }
+}
