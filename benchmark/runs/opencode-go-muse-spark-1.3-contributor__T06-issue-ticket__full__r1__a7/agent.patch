+test('issue ticket rejects inactive queues read fresh inside the transaction', function () {
+    $queue = Queue::factory()->create();
+
+    // Deactivate behind the caller's back: the stale instance still says active.
+    Queue::whereKey($queue->id)->update(['is_active' => false]);
+    expect($queue->is_active)->toBeTrue();
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('issue ticket rejects a negative priority', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('ticket fields are write-once except call fields', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->code = 'A999';
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+
+    $ticket->refresh();
+    $ticket->priority = 5;
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+});
+
+test('entity member can call a waiting ticket exactly once', function () {
+    $queue = Queue::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($user)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $ticket->call($user);
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($user->id);
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+});
+
+test('non-member cannot call a ticket and it stays waiting', function () {
+    $queue = Queue::factory()->create();
+    $outsider = User::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class);
+
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
