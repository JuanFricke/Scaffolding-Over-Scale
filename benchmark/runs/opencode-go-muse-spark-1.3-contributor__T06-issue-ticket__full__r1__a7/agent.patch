+test('tickets table has required columns, unique code per queue and suggested index', function () {
+    expect(Schema::hasTable('tickets'))->toBeTrue()
+        ->and(Schema::hasColumns('tickets', [
+            'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+            'issued_at', 'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+        ]))->toBeTrue();
+
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    $rejected = false;
+    try {
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    } catch (Throwable) {
+        $rejected = true;
+    }
+
+    expect($rejected)->toBeTrue();
+
+    // Same code in another queue is allowed.
+    $other = Queue::factory()->create();
+    Ticket::factory()->forQueue($other)->create(['code' => 'A001']);
+
+    expect(Ticket::where('queue_id', $other->id)->where('code', 'A001')->count())->toBe(1);
+
+    expect(Schema::hasIndex('tickets', 'tickets_queue_id_status_priority_issued_at_index'))->toBeTrue();
+});
+
+test('queue factory creates its entity, unique slug and active by default', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity_id)->not->toBeNull()
+        ->and($queue->is_active)->toBeTrue()
+        ->and($queue->slug)->not->toBeEmpty();
+
+    $other = Queue::factory()->create();
+
+    expect($other->slug)->not->toBe($queue->slug);
+});
+
+test('ticket factory defaults and sequential codes via forQueue', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and($first->status)->toBe(TicketStatus::Waiting)
+        ->and($first->channel)->toBe(TicketChannel::Virtual)
+        ->and($first->priority)->toBe(0)
+        ->and($first->issued_at)->not->toBeNull();
