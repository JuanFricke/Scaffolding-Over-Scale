index 0000000..7caf700
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,118 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Attributes that may change after issuance. Everything else is write-once.
+     *
+     * @var string[]
+     */
+    private const MUTABLE_ATTRIBUTES = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        static::creating(function (self $ticket): void {
+            if (empty($ticket->code) && ! empty($ticket->queue_id)) {
+                $ticket->code = static::nextCode((int) $ticket->queue_id);
+            }
+        });
+
+        static::updating(function (self $ticket): void {
+            foreach (array_keys($ticket->getDirty()) as $key) {
+                if (! in_array($key, self::MUTABLE_ATTRIBUTES, true)) {
+                    throw new LogicException("Ticket attribute [{$key}] is immutable after issuance.");
+                }
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for the queue: last valid code (A<digits>) by
+     * insertion order + 1, or A001 when none exists. Malformed legacy codes
+     * are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = static::where('queue_id', $queueId)->orderBy('id')->pluck('code');
+
+        $last = 0;
+
+        foreach ($codes as $code) {
+            if (is_string($code) && preg_match('/\AA(\d+)\z/', $code, $matches) === 1) {
+                $last = (int) $matches[1];
+            }
+        }
+
+        return 'A'.str_pad((string) ($last + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Mark the ticket as called, exactly once, by an entity member.
+     *
+     * @throws LogicException when the ticket is not waiting.
+     * @throws AuthorizationException when the user is not a member of the ticket's entity.
+     */
+    public function call(User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Only waiting tickets can be called.');
+        }
+
+        $queue = $this->relationLoaded('queue') ? $this->queue : $this->queue()->first();
+
+        $entityId = $queue?->entity_id;
+
+        $isMember = $entityId !== null && EntityMembership::where('entity_id', $entityId)
+            ->where('user_id', $user->getKey())
+            ->exists();
+
+        if (! $isMember) {
+            throw new AuthorizationException('Only members of the ticket\'s entity may call tickets.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->getKey();
+        $this->save();
+    }
+}
