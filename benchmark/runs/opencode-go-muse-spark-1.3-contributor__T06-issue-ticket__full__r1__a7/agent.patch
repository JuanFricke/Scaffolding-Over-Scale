+
+test('queues table has required columns and unique slug per entity', function () {
+    expect(Schema::hasTable('queues'))->toBeTrue()
+        ->and(Schema::hasColumns('queues', [
+            'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+        ]))->toBeTrue();
+
+    $queue = Queue::factory()->create();
+
+    // Same slug in another entity is allowed; same entity is rejected.
+    Queue::factory()->create(['entity_id' => $queue->entity_id, 'slug' => 'other']);
+
+    $rejected = false;
+    try {
+        Queue::factory()->create(['entity_id' => $queue->entity_id, 'slug' => $queue->slug]);
+    } catch (Throwable) {
+        $rejected = true;
+    }
+
+    expect($rejected)->toBeTrue();
+});
