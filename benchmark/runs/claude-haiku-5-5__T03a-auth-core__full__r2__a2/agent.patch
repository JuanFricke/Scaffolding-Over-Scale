+<?php
+
+use Illuminate\Support\Arr;
+
+test('the test suite runs with the pt_BR locale and en fallback', function () {
+    expect(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('phpunit.xml pins the locale variables', function () {
+    $xml = file_get_contents(base_path('phpunit.xml'));
+
+    expect($xml)->toContain('<env name="APP_LOCALE" value="pt_BR"/>')
+        ->and($xml)->toContain('<env name="APP_FALLBACK_LOCALE" value="en"/>');
+});
+
+test('.env.example ships the PegaFila pt_BR defaults', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)->toContain("APP_NAME=PegaFila\n")
+        ->and($env)->toContain("APP_LOCALE=pt_BR\n")
+        ->and($env)->toContain("APP_FALLBACK_LOCALE=en\n");
+});
+
+test('ui strings exist in both locales with the same keys', function () {
+    $en = array_keys(Arr::dot(require lang_path('en/ui.php')));
+    $ptBr = array_keys(Arr::dot(require lang_path('pt_BR/ui.php')));
+
+    expect($en)->not->toBeEmpty()
+        ->and($ptBr)->toEqualCanonicalizing($en);
+});
+
+test('the login page is in Brazilian Portuguese by default', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('the login page is in English with the en locale and has no Portuguese', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu');
