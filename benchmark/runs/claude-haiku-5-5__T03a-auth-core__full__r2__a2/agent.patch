@@ -0,0 +1,92 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use App\Actions\RegisterUser;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Validation\Rules\Password;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('components.layouts.app')]
+class Register extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    #[Validate('required|string|email:rfc,strict|max:255|unique:users,email')]
+    public string $email = '';
+
+    public string $password = '';
+
+    public string $password_confirmation = '';
+
+    /**
+     * The password rule comes from the app-wide Password::defaults().
+     *
+     * @return array<string, array<int, mixed>>
+     */
+    protected function rules(): array
+    {
+        return [
+            'password' => ['required', 'confirmed', Password::defaults()],
+        ];
+    }
+
+    /**
+     * Create an unverified account and sign it in. Guests only; every submission counts towards
+     * the per-IP limit of five attempts a minute.
+     */
+    public function submit(): void
+    {
+        try {
+            if (Auth::check()) {
+                $this->redirectRoute('home');
+
+                return;
+            }
+
+            $this->ensureIsNotRateLimited();
+            RateLimiter::hit($this->throttleKey());
+
+            $data = $this->validate();
+
+            $user = app(RegisterUser::class)->handle($data['name'], $data['email'], $data['password']);
+
+            Auth::login($user);
+            session()->regenerate();
+
+            $this->redirectRoute('home');
+        } finally {
+            // Livewire serialises public properties into the page; never leave the passwords there.
+            $this->reset('password', 'password_confirmation');
+        }
+    }
+
+    /**
+     * Throw a validation error on e-mail once the IP has used up its five attempts.
+     */
+    protected function ensureIsNotRateLimited(): void
+    {
+        if (! RateLimiter::tooManyAttempts($this->throttleKey(), 5)) {
+            return;
+        }
+
+        throw ValidationException::withMessages([
+            'email' => __('auth.throttle', ['seconds' => RateLimiter::availableIn($this->throttleKey())]),
+        ]);
+    }
+
+    protected function throttleKey(): string
+    {
+        return str()->transliterate('register|'.request()->ip());
+    }
+
+    public function render()
+    {
+        return view('livewire.auth.register');
+    }
+}
