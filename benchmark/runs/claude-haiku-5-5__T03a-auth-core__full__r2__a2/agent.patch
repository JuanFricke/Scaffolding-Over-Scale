@@ -0,0 +1,25 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+
+class RegisterUser
+{
+    /**
+     * Create an unverified staff account. Firing Registered sends the verification mail.
+     */
+    public function handle(string $name, string $email, string $password): User
+    {
+        $user = User::create([
+            'name' => $name,
+            'email' => $email,
+            'password' => $password,
+        ]);
+
+        event(new Registered($user));
+
+        return $user;
+    }
+}
