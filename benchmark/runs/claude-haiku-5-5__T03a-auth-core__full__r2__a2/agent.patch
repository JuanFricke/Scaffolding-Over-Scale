+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('guests visiting home are sent to login', function () {
+    $this->get(route('home'))->assertRedirect(route('login'));
+});
+
+test('unverified users visiting home are sent to the verification notice', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('home'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('verified users see the home page', function () {
+    $user = User::factory()->create(['name' => 'Ana Souza']);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertOk()
+        ->assertSee(__('ui.home.welcome', ['name' => 'Ana Souza']));
+});
+
+test('logout is POST only', function () {
+    $this->actingAs(User::factory()->create())
+        ->get('/logout')
+        ->assertMethodNotAllowed();
+});
+
+test('guests cannot log out', function () {
+    $this->post(route('logout'))->assertRedirect(route('login'));
+});
+
+test('logout signs the user out and sends them to login', function () {
+    $this->actingAs(User::factory()->create());
+
+    $this->post(route('logout'))->assertRedirect(route('login'));
+
+    $this->assertGuest();
+});
+
+test('logout regenerates the CSRF token', function () {
+    $this->startSession();
+    $this->actingAs(User::factory()->create());
+    $before = session()->token();
+
+    $this->post(route('logout'));
+
+    expect(session()->token())->not->toBe($before);
+});
diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..ce41289
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,122 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function signedVerificationUrl(User $user, ?User $as = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $as?->getKey() ?? $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('guests are sent to login from the verification notice', function () {
+    $this->get(route('verification.notice'))->assertRedirect(route('login'));
+});
+
+test('unverified users see the verification notice', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee(__('ui.verify.title'));
+});
+
+test('verified users visiting the notice are sent home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('home'));
+});
+
+test('a valid signed link verifies the logged-in user and sends them home', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user))
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link whose id was tampered with returns 403 and verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $victim = User::factory()->unverified()->create();
+
+    $tampered = str_replace(
+        "/email/verify/{$user->getKey()}/",
+        "/email/verify/{$victim->getKey()}/",
+        signedVerificationUrl($user),
+    );
+
+    $this->actingAs($user)->get($tampered)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($victim->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a validly signed link made for another user is refused and verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $victim = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($victim, as: $victim))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($victim->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('guests cannot use the verification link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->get(signedVerificationUrl($user))->assertRedirect(route('login'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('resending sends the verification mail and flashes the status', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('verification.notice'))
+        ->assertSessionHas('status', 'verification-link-sent');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('resending for an already verified user sends nothing and redirects home', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('resending is throttled to six per minute', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    foreach (range(1, 6) as $_) {
+        $this->actingAs($user)->post(route('verification.send'))->assertRedirect(route('verification.notice'));
+    }
+
+    $this->actingAs($user)->post(route('verification.send'))->assertStatus(429);
+});
+
+test('guests cannot resend the verification mail', function () {
+    Notification::fake();
+
+    $this->post(route('verification.send'))->assertRedirect(route('login'));
+
+    Notification::assertNothingSent();
+});
