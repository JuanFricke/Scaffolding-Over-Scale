+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit');
+
+    expect($user->fresh()->remember_token)->toBeNull();
+});
+
+test('the e-mail must be a strictly valid address', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+
+    $this->assertGuest();
+});
+
+test('wrong credentials show auth.failed on email and clear the password', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee(__('auth.failed'))
+        ->assertSet('password', '');
+
+    $this->assertGuest();
+});
+
+test('five failed attempts lock the e-mail and IP and reject even the right password', function () {
+    $user = User::factory()->create();
+    $component = Livewire::test(Login::class)->set('email', $user->email);
+
+    foreach (range(1, 5) as $_) {
+        $component->set('password', 'wrong-password')->call('submit');
+    }
+
+    $key = Str::transliterate(Str::lower($user->email).'|127.0.0.1');
+
+    $component->set('password', 'password')->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee(__('auth.throttle', ['seconds' => RateLimiter::availableIn($key)]));
+
+    $this->assertGuest();
+});
+
+test('the lockout is scoped to the e-mail, other accounts can still sign in', function () {
+    $locked = User::factory()->create();
+    $other = User::factory()->create();
+
+    $component = Livewire::test(Login::class)->set('email', $locked->email);
+
+    foreach (range(1, 6) as $_) {
+        $component->set('password', 'wrong-password')->call('submit');
+    }
+
+    Livewire::test(Login::class)
+        ->set('email', $other->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($other);
+});
+
+test('an authenticated user cannot use the login form to switch accounts', function () {
+    $user = User::factory()->create();
+    $other = User::factory()->create();
+
+    Livewire::actingAs($user)
+        ->test(Login::class)
+        ->set('email', $other->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..27ad111
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,134 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the forgot password page', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee(__('ui.forgot_password.title'));
+});
+
+test('authenticated users are sent home from the forgot password page', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('password.request'))
+        ->assertRedirect(route('home'));
+});
+
+test('a reset link is sent to a registered e-mail', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown e-mail gets the same answer and no mail is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('the forgot password e-mail must be a valid address', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+});
+
+test('forgot password requests are throttled to six per minute', function () {
+    foreach (range(1, 6) as $_) {
+        $this->post(route('password.email'), ['email' => 'ghost@example.com'])
+            ->assertRedirect(route('password.request'));
+    }
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset page asks for the e-mail exactly once', function () {
+    $response = $this->get(route('password.reset', ['token' => 'abc', 'email' => 'ana@example.com']));
+
+    $response->assertOk();
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('authenticated users are sent home from the reset page', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('password.reset', ['token' => 'abc']))
+        ->assertRedirect(route('home'));
+});
+
+test('a valid token sets the new password, rotates remember_token and sends the user to login', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old-token']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewSecret123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token');
+
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token is rejected and the password is unchanged', function () {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => 'bogus-token',
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors('email');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+});
+
+test('the new password must follow the default password rule', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'weak',
+        'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+});
+
+test('a mismatched confirmation fails on password', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret124',
+    ])->assertSessionHasErrors('password');
+});
diff --git a/tests/Feature/Auth/PasswordRuleTest.php b/tests/Feature/Auth/PasswordRuleTest.php
new file mode 100644
index 0000000..c81b35a
--- /dev/null
+++ b/tests/Feature/Auth/PasswordRuleTest.php
@@ -0,0 +1,25 @@
+<?php
+
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rules\Password;
+
+function passesDefaultPasswordRule(string $value): bool
+{
+    return Validator::make(['password' => $value], ['password' => Password::defaults()])->passes();
+}
+
+test('the default password rule requires at least 8 characters', function () {
+    expect(passesDefaultPasswordRule('Sec1'))->toBeFalse()
+        ->and(passesDefaultPasswordRule('Secret12'))->toBeTrue();
+});
+
+test('the default password rule requires upper and lower case letters', function () {
+    expect(passesDefaultPasswordRule('secret123'))->toBeFalse()
+        ->and(passesDefaultPasswordRule('SECRET123'))->toBeFalse()
+        ->and(passesDefaultPasswordRule('Secret123'))->toBeTrue();
+});
+
+test('the default password rule requires a number', function () {
+    expect(passesDefaultPasswordRule('Secretabc'))->toBeFalse()
+        ->and(passesDefaultPasswordRule('Secret123'))->toBeTrue();
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..6fec5e7
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,158 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the register page', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSeeLivewire(Register::class);
+});
+
+test('authenticated users visiting register are sent home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
+
+test('a new user is created unverified, signed in, sent a verification mail and sent home', function () {
+    Notification::fake();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Souza')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'ana@example.com')->firstOrFail();
+
+    expect($user->name)->toBe('Ana Souza')
+        ->and($user->email_verified_at)->toBeNull()
+        ->and(Hash::check('Secret123', $user->password))->toBeTrue();
+
+    $this->assertAuthenticatedAs($user);
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('registering fires the Registered event', function () {
+    Event::fake([Registered::class]);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Souza')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit');
+
+    Event::assertDispatched(Registered::class);
+});
+
+test('the name is required', function () {
+    Livewire::test(Register::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('the e-mail must be a strictly valid address', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Souza')
+        ->set('email', 'not-an-email')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+});
+
+test('the e-mail must be unique', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Souza')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+
+    expect(User::count())->toBe(1);
+});
+
+test('a mismatched confirmation fails the confirmed rule on password', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Souza')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret124')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('a password that breaks the default rule is rejected', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Souza')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'secret')
+        ->set('password_confirmation', 'secret')
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('registration is limited to five attempts per IP and the sixth fails on email', function () {
+    $component = Livewire::test(Register::class);
+
+    foreach (range(1, 5) as $_) {
+        $component->call('submit');
+    }
+
+    $component->call('submit')->assertHasErrors(['email']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('the password fields are cleared after a failed attempt', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Souza')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Mismatch1')
+        ->call('submit')
+        ->assertSet('password', '')
+        ->assertSet('password_confirmation', '');
+});
+
+test('an authenticated user cannot register another account through the form', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)
+        ->test(Register::class)
+        ->set('name', 'Intruso')
+        ->set('email', 'intruso@example.com')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect(User::count())->toBe(1);
+    $this->assertAuthenticatedAs($user);
+});
diff --git a/tests/Feature/ViewConventionsTest.php b/tests/Feature/ViewConventionsTest.php
new file mode 100644
index 0000000..3f69fb4
--- /dev/null
+++ b/tests/Feature/ViewConventionsTest.php
@@ -0,0 +1,23 @@
+<?php
+
+use Illuminate\Support\Facades\File;
+
+test('views never hardcode a root-relative href or action', function () {
+    $offenders = collect(File::allFiles(resource_path('views')))
+        ->filter(fn ($file) => preg_match('/\b(href|action)="\//', file_get_contents($file->getPathname())))
+        ->map(fn ($file) => $file->getRelativePathname())
+        ->values()
+        ->all();
+
+    expect($offenders)->toBeEmpty();
+});
+
+test('controllers and Livewire classes never redirect to a hardcoded path', function () {
+    $offenders = collect(File::allFiles(app_path()))
+        ->filter(fn ($file) => preg_match("/redirect(?:Intended)?\(\s*['\"]\//", file_get_contents($file->getPathname())))
+        ->map(fn ($file) => $file->getRelativePathname())
+        ->values()
+        ->all();
+
+    expect($offenders)->toBeEmpty();
+});
