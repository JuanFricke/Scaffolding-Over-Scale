--- /dev/null
+++ b/tests/Feature/AuthenticationTest.php
@@ -0,0 +1,316 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password as PasswordBroker;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\URL;
+use Illuminate\Validation\Rules\Password;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the login page in brazilian portuguese', function () {
+    expect(config('app.locale'))->toBe('pt_BR');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeLivewire(Login::class)
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('the login page switches to english', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha');
+});
+
+test('authenticated users are redirected away from login', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('login'))->assertRedirect(route('home'));
+});
+
+test('users can log in with valid credentials', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('invalid credentials produce a localized validation error', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+
+    $this->assertGuest();
+});
+
+test('login is rate limited after five failed attempts', function () {
+    $user = User::factory()->create();
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        Livewire::test(Login::class)
+            ->set('email', $user->email)
+            ->set('password', 'wrong-password')
+            ->call('submit')
+            ->assertHasErrors(['email' => __('auth.failed')]);
+    }
+
+    $component = Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit');
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas');
+});
+
+test('users can register and are authenticated', function () {
+    Notification::fake();
+
+    $component = Livewire::test(Register::class)
