+<?php
+
+use App\Enums\QueuePermission;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
+
+uses(RefreshDatabase::class);
+
+function makeServePageOwner(Entity $entity, ?User $user = null): User
+{
+    $user ??= User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+test('any member can open the serve panel and the first callable queue is selected', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $inactive = Queue::factory()->for($entity)->create(['is_active' => false]);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.serve', $entity->slug))
+        ->assertOk()
+        ->assertSee(__('ui.serve_call_next'))
+        ->assertSee($queue->name)
+        ->assertDontSee($inactive->name);
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $queue->id)
+        ->assertSet('mode', 'any');
+});
+
+test('employees only see queues they are granted call access to', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $granted = Queue::factory()->for($entity)->create();
+    $denied = Queue::factory()->for($entity)->create();
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $granted->id,
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $granted->id)
+        ->assertSee($granted->name)
+        ->assertDontSee($denied->name);
+});
+
+test('the waiting list is in call order and shows code priority time and channel', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    Ticket::factory()->forQueue($queue)->create([
+        'code' => 'A001',
+        'priority' => 0,
+        'channel' => TicketChannel::Totem,
+        'issued_at' => now()->subMinutes(5),
+    ]);
+    Ticket::factory()->forQueue($queue)->create([
+        'code' => 'A002',
+        'priority' => 10,
+        'channel' => TicketChannel::Virtual,
+        'issued_at' => now(),
+    ]);
+    Ticket::factory()->forQueue($queue)->create([
+        'code' => 'A003',
+        'priority' => 0,
+        'channel' => TicketChannel::Printed,
+        'issued_at' => now(),
+        'status' => TicketStatus::Called,
+    ]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $html = Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSee('A001')
+        ->assertSee('A002')
+        ->assertDontSee('A003')
+        ->assertSee(__('ui.channel_totem'))
+        ->assertSee(__('ui.channel_virtual'))
+        ->html();
+
+    expect(strpos($html, 'A002'))->toBeLessThan(strpos($html, 'A001'));
+});
+
+test('the waiting list filters by call mode', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001', 'priority' => 0]);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A002', 'priority' => 10]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('mode', 'priority_only')
+        ->assertSee('A002')
+        ->assertDontSee('A001')
+        ->set('mode', 'normal_only')
+        ->assertSee('A001')
+        ->assertDontSee('A002');
+});
+
+test('a foreign selected queue discloses no tickets and shows only the empty state', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $foreignQueue = Queue::factory()->for($other)->create();
+    Ticket::factory()->forQueue($foreignQueue)->create(['code' => 'FOREIGN-1']);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $foreignQueue->id)
+        ->assertDontSee('FOREIGN-1')
+        ->assertSee(__('ui.serve_empty'));
+
+    expect($component->viewData('tickets'))->toBeEmpty();
+
+    try {
+        $component->call('callNext');
+        $this->fail('Calling a foreign queue should fail.');
+    } catch (NotFoundHttpException|ModelNotFoundException) {
+        expect(true)->toBeTrue();
+    }
+});
+
+test('calling the next ticket updates the notice and last called ticket', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('lastCalledTicketId', $ticket->id)
+        ->assertSet('notice', __('ui.serve_last_called', ['code' => 'A001']))
+        ->assertSee(__('ui.serve_last_called', ['code' => 'A001']));
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->fresh()->called_by_user_id)->toBe($owner->id);
+});
+
+test('calling with no selection is a quiet empty notice', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    Queue::factory()->for($entity)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', null)
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('notice', __('ui.serve_empty'));
+});
+
+test('calling an inactive queue and an empty queue set their notices', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $inactive = Queue::factory()->for($entity)->create(['is_active' => false]);
+    $empty = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $inactive->id)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_inactive'));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $empty->id)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_empty'));
+});
+
+test('an employee without a grant receives a 403 and nothing changes', function () {
+    $entity = Entity::factory()->create();
+    makeServePageOwner($entity);
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertForbidden();
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('successful calls are rate limited per user and entity', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    for ($i = 1; $i <= 12; $i++) {
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A'.str_pad((string) $i, 3, '0', STR_PAD_LEFT)]);
+    }
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity]);
+
+    for ($i = 0; $i < 10; $i++) {
+        $component->call('callNext')->assertHasNoErrors();
+    }
+
+    $component->call('callNext')->assertSet('notice', __('ui.serve_rate_limited'));
+
+    expect(Ticket::where('queue_id', $queue->id)->where('status', TicketStatus::Called)->count())->toBe(10)
+        ->and(Ticket::where('queue_id', $queue->id)->where('status', TicketStatus::Waiting)->count())->toBe(2);
+});
+
+test('navbar exposes queues to managers and serve to every member', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeServePageOwner($entity);
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertSee(route('entity.queues', $entity->slug), false)
+        ->assertSee(route('entity.serve', $entity->slug), false);
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertDontSee(route('entity.queues', $entity->slug), false)
+        ->assertSee(route('entity.serve', $entity->slug), false);
+});
