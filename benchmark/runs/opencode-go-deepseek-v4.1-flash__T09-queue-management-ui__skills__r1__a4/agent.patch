+
+test('renaming re-derives the slug and collisions are reported on the draft', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueuesPageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old']);
+    Queue::factory()->for($entity)->create(['name' => 'Taken', 'slug' => 'taken']);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('startRename', $queue->id)
+        ->assertSet('renameName', 'Old')
+        ->set('renameName', 'New')
+        ->call('rename')
+        ->assertHasNoErrors();
+
+    expect($queue->fresh()->name)->toBe('New')
+        ->and($queue->fresh()->slug)->toBe('new');
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('startRename', $queue->id)
+        ->set('renameName', 'Taken')
+        ->call('rename')
+        ->assertHasErrors('renameName');
+
+    expect($queue->fresh()->name)->toBe('New');
+});
+
+test('toggling a queue requires an in-page confirmation and reactivates it', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueuesPageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('confirmToggle')
+        ->assertSet('confirmingToggle', true);
+
+    $html = $component->html();
+
+    expect($html)->not->toContain('wire:confirm')
+        ->and($html)->toContain(__('ui.queues_toggle_title'))
+        ->and($html)->toContain($queue->name);
+
+    $component->call('cancelToggle')->assertSet('confirmingToggle', false);
+    expect($queue->fresh()->is_active)->toBeTrue();
+
+    $component->call('confirmToggle')->call('toggleActive', $queue->id)
+        ->assertSet('confirmingToggle', false);
+
+    expect($queue->fresh()->is_active)->toBeFalse();
+});
+
+test('access grants can be granted and revoked for entity memberships only', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    $owner = makeQueuesPageOwner($entity);
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $foreignMembership = EntityMembership::factory()->for($other)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openAccess', $queue->id)
+        ->assertSet('accessQueueId', $queue->id)
+        ->assertSet('managingAccess', true);
+
+    expect($component->viewData('accessQueue')->id)->toBe($queue->id)
+        ->and($component->viewData('accessGrants'))->toHaveCount(0);
+
+    $component->call('grantAccess', $membership->id)->assertHasNoErrors();
+
+    expect(QueueAccess::where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->first()?->permissions)->toBe([QueuePermission::Call->value]);
+
+    expect($component->call('revokeAccess', $membership->id)->viewData('accessGrants'))->toHaveCount(0);
+
+    expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openAccess', $queue->id)
+        ->call('grantAccess', $foreignMembership->id))
+        ->toThrow(ModelNotFoundException::class);
+});
+
+test('a tampered access queue discloses no queue or grants', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    $owner = makeQueuesPageOwner($entity);
+    $foreign = Queue::factory()->for($other)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('accessQueueId', $foreign->id)
+        ->set('managingAccess', true);
+
+    expect($component->viewData('accessQueue'))->toBeNull()
+        ->and($component->viewData('accessGrants'))->toBeEmpty();
+});
+
+test('a foreign queue cannot be opened renamed toggled or accessed', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    $owner = makeQueuesPageOwner($entity);
+    $foreign = Queue::factory()->for($other)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    foreach (['openQueue', 'startRename', 'toggleActive', 'openAccess'] as $method) {
+        try {
+            Livewire::test(Queues::class, ['entity' => $entity])->call($method, $foreign->id);
+            $this->fail("{$method} should reject a foreign queue.");
+        } catch (NotFoundHttpException|ModelNotFoundException) {
+            expect(true)->toBeTrue();
+        }
+    }
+
+    expect($foreign->fresh()->name)->not->toBe('Hacked')
+        ->and($foreign->fresh()->is_active)->toBeTrue();
+});
+
+test('closing the detail modal clears every nested state', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueuesPageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('startRename', $queue->id)
+        ->call('confirmToggle')
+        ->call('openAccess', $queue->id)
+        ->call('closeQueue')
+        ->assertSet('viewingQueueId', null)
+        ->assertSet('confirmingToggle', false)
+        ->assertSet('editingQueueId', null)
+        ->assertSet('renameName', '')
+        ->assertSet('accessQueueId', null)
+        ->assertSet('managingAccess', false);
+});
diff --git a/tests/Feature/Entity/ServePageTest.php b/tests/Feature/Entity/ServePageTest.php
