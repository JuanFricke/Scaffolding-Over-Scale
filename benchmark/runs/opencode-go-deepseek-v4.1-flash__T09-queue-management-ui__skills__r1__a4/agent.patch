+
+test('the detail modal exposes rename, toggle and access controls', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueuesPageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
