+
+    expect(Queue::where('entity_id', $entity->id)->count())->toBe(1);
+});
+
+test('the queue list only exposes the open action while no modal is open', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueuesPageOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
