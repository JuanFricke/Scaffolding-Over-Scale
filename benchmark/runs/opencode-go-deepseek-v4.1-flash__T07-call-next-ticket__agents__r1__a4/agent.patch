+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * Number of consecutive priority calls after which a waiting normal
+     * ticket takes precedence in the "any" mode.
+     */
+    private const FAIRNESS_STREAK = 3;
+
+    /**
+     * Call the next waiting ticket of a queue according to the requested mode.
+     *
+     * Selection is deterministic (priority, issuance time, id) and performed
+     * under a queue-row lock so concurrent calls are serialized. The chosen
+     * row is locked and re-checked before being marked, because
+     * Ticket::call() locks only the ticket row and may have won the race.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read the state from the database: the passed instance may be stale.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call the next ticket from an inactive queue.');
+            }
+
+            $skipped = [];
+
+            while (true) {
+                // "normal_only" is always normal-restricted; "any" is
+                // restricted only while the fairness streak holds.
+                $restrictToNormal = $mode === CallMode::NormalOnly
+                    || ($mode === CallMode::Any && $this->fairnessApplies($lockedQueue));
+
+                $candidate = $this->candidateQuery($lockedQueue, $mode, $restrictToNormal)
+                    ->when($skipped !== [], fn (Builder $query) => $query->whereNotIn('id', $skipped))
+                    ->first();
+
+                // In "any" mode a normal candidate may have been called
+                // concurrently, leaving only excluded ids in the restricted set.
+                // Retry with full ordering instead of failing the call.
+                if ($candidate === null && $mode === CallMode::Any && $restrictToNormal) {
+                    $candidate = $this->candidateQuery($lockedQueue, $mode, false)
+                        ->when($skipped !== [], fn (Builder $query) => $query->whereNotIn('id', $skipped))
+                        ->first();
+                }
+
+                if ($candidate === null) {
+                    throw new NoWaitingTicketsException(
+                        'No waiting tickets are eligible for the requested call mode.'
+                    );
+                }
+
+                // Re-check under the ticket-row lock: a concurrent Ticket::call()
+                // does not lock the queue and may have called it already.
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->getKey())
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    $skipped[] = $candidate->getKey();
+
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+        });
+    }
+
+    /**
+     * Build the deterministic candidate query for the requested mode.
+     *
+     * @return Builder<Ticket>
+     */
+    private function candidateQuery(Queue $queue, CallMode $mode, bool $restrictToNormal): Builder
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting);
+
+        if ($restrictToNormal) {
+            return $query->where('priority', 0)->orderBy('issued_at')->orderBy('id');
+        }
+
+        if ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0);
+        }
+
+        return $query->orderByDesc('priority')->orderBy('issued_at')->orderBy('id');
+    }
+
+    /**
+     * A normal ticket may not wait behind more than three consecutive
+     * priority calls in this queue. Calls from every mode count.
+     */
+    private function fairnessApplies(Queue $queue): bool
+    {
+        $recentCalls = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->whereNotNull('called_at')
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::FAIRNESS_STREAK)
+            ->get(['id', 'priority']);
+
+        $allPriority = $recentCalls->count() === self::FAIRNESS_STREAK
+            && ! $recentCalls->contains(fn (Ticket $ticket): bool => $ticket->priority <= 0);
+
+        if (! $allPriority) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
