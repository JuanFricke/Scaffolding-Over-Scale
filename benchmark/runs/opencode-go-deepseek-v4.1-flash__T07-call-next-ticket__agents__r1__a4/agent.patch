+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Create a waiting ticket in the given queue with the supplied attributes.
+ *
+ * @param  array<string, mixed>  $attributes
+ */
+function callNextWaitingTicket(Queue $queue, array $attributes = []): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create($attributes);
+}
+
+/**
+ * Create an already-called ticket for history/fairness tests.
+ *
+ * @param  array<string, mixed>  $attributes
+ */
+function callNextCalledTicket(Queue $queue, User $user, array $attributes = []): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create(array_merge([
+        'status' => TicketStatus::Called,
+        'called_at' => now(),
+        'called_by_user_id' => $user->id,
+    ], $attributes));
+}
+
+it('calls the highest priority then oldest waiting ticket', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $normal = callNextWaitingTicket($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(30)]);
+    $medium = callNextWaitingTicket($queue, ['priority' => 5, 'issued_at' => now()->subMinutes(20)]);
+    $highOlder = callNextWaitingTicket($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(10)]);
+    $highNewer = callNextWaitingTicket($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(5)]);
+
+    $action = new CallNextTicket;
+
+    expect($action($queue, $attendant)->is($highOlder))->toBeTrue();
+    expect($action($queue, $attendant)->is($highNewer))->toBeTrue();
+    expect($action($queue, $attendant)->is($medium))->toBeTrue();
+    expect($action($queue, $attendant)->is($normal))->toBeTrue();
+});
+
+it('uses the lowest id as the final tie-break', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $issuedAt = now()->subMinutes(5);
+
+    $first = callNextWaitingTicket($queue, ['issued_at' => $issuedAt]);
+    $second = callNextWaitingTicket($queue, ['issued_at' => $issuedAt]);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($first))->toBeTrue();
+    expect($first->id)->toBeLessThan($second->id);
+});
+
+it('only considers waiting tickets of the given queue', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $otherQueue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $other = callNextWaitingTicket($otherQueue, ['priority' => 99]);
+    $alreadyCalled = callNextCalledTicket($queue, $attendant, ['priority' => 50]);
+    $candidate = callNextWaitingTicket($queue);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($candidate))->toBeTrue()
+        ->and($called->is($other))->toBeFalse()
+        ->and($called->is($alreadyCalled))->toBeFalse()
+        ->and($other->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($alreadyCalled->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+it('marks the winner as called and returns the updated model', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $ticket = callNextWaitingTicket($queue, ['priority' => 7]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($ticket))->toBeTrue()
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_at)->not->toBeNull()
+        ->and($called->called_by_user_id)->toBe($attendant->id)
+        ->and($called->priority)->toBe(7)
+        ->and($called->code)->toBe($ticket->code)
+        ->and($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($attendant->id)
+        ->called_at->not->toBeNull();
+});
+
+it('calls only priority tickets in priority_only mode', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $normal = callNextWaitingTicket($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(10)]);
+    $priority = callNextWaitingTicket($queue, ['priority' => 3, 'issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue()
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls only normal tickets, oldest first, in normal_only mode', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $priority = callNextWaitingTicket($queue, ['priority' => 10]);
+    $olderNormal = callNextWaitingTicket($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(10)]);
+    $newerNormal = callNextWaitingTicket($queue, ['priority' => 0, 'issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly);
+
+    expect($called->is($olderNormal))->toBeTrue()
+        ->and($newerNormal->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('rejects calling from an inactive queue without changing anything', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $attendant = User::factory()->create();
+    $ticket = callNextWaitingTicket($queue);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->fresh()->called_at)->toBeNull()
+        ->and($ticket->fresh()->called_by_user_id)->toBeNull();
+});
+
+it('reads the queue state from the database instead of a stale instance', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+    $attendant = User::factory()->create();
+    $ticket = callNextWaitingTicket($queue);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('throws when no ticket is eligible for the requested mode', function () {
+    $attendant = User::factory()->create();
+    $action = new CallNextTicket;
+
+    $empty = Queue::factory()->create(['is_active' => true]);
+    expect(fn () => $action($empty, $attendant, CallMode::Any))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    $onlyNormals = Queue::factory()->create(['is_active' => true]);
+    callNextWaitingTicket($onlyNormals, ['priority' => 0]);
+    expect(fn () => $action($onlyNormals, $attendant, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    $onlyPriority = Queue::factory()->create(['is_active' => true]);
+    callNextWaitingTicket($onlyPriority, ['priority' => 10]);
+    expect(fn () => $action($onlyPriority, $attendant, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('applies fairness after three consecutive priority calls', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $priority = callNextWaitingTicket($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(30)]);
+    $normal = callNextWaitingTicket($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(10)]);
+
+    callNextCalledTicket($queue, $attendant, ['priority' => 10, 'called_at' => now()->subMinutes(9)]);
+    callNextCalledTicket($queue, $attendant, ['priority' => 20, 'called_at' => now()->subMinutes(8)]);
+    callNextCalledTicket($queue, $attendant, ['priority' => 30, 'called_at' => now()->subMinutes(7)]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($called->is($normal))->toBeTrue()
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('counts calls made in priority_only and normal_only modes in the fairness history', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $priority = callNextWaitingTicket($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(30)]);
