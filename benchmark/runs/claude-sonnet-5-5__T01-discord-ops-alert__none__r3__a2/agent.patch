diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..1ece558
--- /dev/null
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -0,0 +1,84 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+const WEBHOOK = 'https://discord.com/api/webhooks/123/SECRETTOKEN';
+
+it('is a no-op without a webhook', function (?string $url) {
+    config(['services.discord.webhook_url' => $url]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Http::assertNothingSent();
+})->with([null, '']);
+
+it('posts redacted, formatted content', function () {
+    config(['services.discord.webhook_url' => WEBHOOK]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Msg', [
+        'queue' => 'asaas-webhooks',
+        'entity_id' => 42,
+        'API-Key' => 'abc',
+        'note' => 'Bearer xyz',
+        'nested' => ['password' => 'p', 'ok' => 1],
+    ]);
+
+    Http::assertSent(function (Request $r) {
+        $c = $r['content'];
+
+        return $r->url() === WEBHOOK && $r->method() === 'POST'
+            && str_starts_with($c, "Title\nMsg\n")
+            && str_contains($c, 'queue=asaas-webhooks')
+            && str_contains($c, 'entity_id=42')
+            && str_contains($c, 'API-Key=[redacted]')
+            && str_contains($c, 'note=[redacted]')
+            && str_contains($c, 'nested={"password":"[redacted]","ok":1}');
+    });
+});
+
+it('truncates to 1800 characters', function () {
+    config(['services.discord.webhook_url' => WEBHOOK]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', str_repeat('é', 5000));
+
+    Http::assertSent(fn (Request $r) => mb_strlen($r['content']) === 1800);
+});
+
+it('logs non-2xx without the webhook url', function () {
+    config(['services.discord.webhook_url' => WEBHOOK]);
+    Http::fake(['*' => Http::response('', 500)]);
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(
+        fn ($m, $ctx) => $m === 'Discord ops alert failed' && ! str_contains(json_encode([$m, $ctx]), 'SECRETTOKEN')
+    );
+});
+
+it('swallows transport errors and scrubs the url', function () {
+    config(['services.discord.webhook_url' => WEBHOOK]);
+    Http::fake(fn () => throw new ConnectionException('cURL error for '.WEBHOOK));
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(
+        fn ($m, $ctx) => ! str_contains(json_encode([$m, $ctx]), 'SECRETTOKEN')
+    );
+});
+
+it('configures logging lanes', function () {
+    expect(config('logging.channels.daily.days'))->toBe(14)
+        ->and(config('logging.channels.audit.days'))->toBe(90)
+        ->and(config('logging.channels.audit.level'))->toBe('info')
+        ->and(config('logging.channels.stack.channels'))->toContain('daily')
+        ->and(config('logging.channels'))->not->toHaveKey('discord');
+});
