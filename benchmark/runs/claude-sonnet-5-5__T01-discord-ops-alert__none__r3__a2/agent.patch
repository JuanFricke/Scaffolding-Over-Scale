diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..1fd7db8
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,123 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Stringable;
+use Throwable;
+
+/**
+ * Sends human-pageable ops alerts to a Discord incoming webhook.
+ *
+ * This is an explicit call, never a Monolog channel. It is a no-op when no
+ * webhook is configured and never throws.
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const TIMEOUT_SECONDS = 5;
+
+    private const REDACTED = '[redacted]';
+
+    private const SENSITIVE_KEY = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const BEARER = '/\bBearer\s+\S+/i';
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (! is_string($url) || trim($url) === '') {
+            return;
+        }
+
+        try {
+            $response = Http::timeout(self::TIMEOUT_SECONDS)
+                ->asJson()
+                ->post($url, ['content' => $this->buildText($title, $message, $context)]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (Throwable $e) {
+            try {
+                Log::error('Discord ops alert failed', [
+                    'exception' => $e::class,
+                    'error' => $this->scrubUrl($e->getMessage(), $url),
+                ]);
+            } catch (Throwable) {
+                // Soft-fail: never break the caller.
+            }
+        }
+    }
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    private function buildText(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->render($this->redact((string) $key, $value));
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH);
+    }
+
+    private function redact(string $key, mixed $value): mixed
+    {
+        if (preg_match(self::SENSITIVE_KEY, $key) === 1) {
+            return self::REDACTED;
+        }
+
+        if (is_array($value)) {
+            $redacted = [];
+            foreach ($value as $k => $v) {
+                $redacted[$k] = $this->redact((string) $k, $v);
+            }
+
+            return $redacted;
+        }
+
+        if ($value instanceof Stringable) {
+            $value = (string) $value;
+        }
+
+        if (is_string($value) && preg_match(self::BEARER, $value) === 1) {
+            return self::REDACTED;
+        }
+
+        return $value;
+    }
+
+    private function render(mixed $value): string
+    {
+        return match (true) {
+            is_array($value) => (string) json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR),
+            is_bool($value) => $value ? 'true' : 'false',
+            $value === null => 'null',
+            is_scalar($value) => (string) $value,
+            is_object($value) => $value::class,
+            default => get_debug_type($value),
+        };
+    }
+
+    private function scrubUrl(string $text, string $url): string
+    {
+        $text = str_replace($url, '[webhook]', $text);
+
+        // Also scrub the token-bearing path in case the URL was re-encoded or trimmed.
+        $path = parse_url(trim($url), PHP_URL_PATH);
+        if (is_string($path) && strlen($path) > 1) {
+            $text = str_replace($path, '/[webhook]', $text);
+        }
+
+        return $text;
+    }
+}
