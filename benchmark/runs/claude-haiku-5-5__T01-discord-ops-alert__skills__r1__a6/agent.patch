+
+test('redacts nested arrays recursively and renders them as JSON', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message', [
+        'payload' => [
+            'token' => 'abc',
+            'queue' => 'asaas-webhooks',
