diff --git a/tests/Feature/Logging/LoggingChannelsTest.php b/tests/Feature/Logging/LoggingChannelsTest.php
new file mode 100644
index 0000000..6adc4f0
--- /dev/null
+++ b/tests/Feature/Logging/LoggingChannelsTest.php
@@ -0,0 +1,72 @@
+<?php
+
+use Illuminate\Support\Facades\File;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+
+test('the test environment pins the stack to the daily archive channel', function () {
+    expect(config('logging.channels.stack.channels'))->toBe(['daily']);
+});
+
+test('LOG_STACK defaults to daily when the variable is unset', function () {
+    $previous = [getenv('LOG_STACK'), $_ENV['LOG_STACK'] ?? null, $_SERVER['LOG_STACK'] ?? null];
+
+    putenv('LOG_STACK');
+    unset($_ENV['LOG_STACK'], $_SERVER['LOG_STACK']);
+
+    try {
+        $config = require config_path('logging.php');
+    } finally {
+        [$env, $envArray, $serverArray] = $previous;
+
+        if ($env !== false) {
+            putenv("LOG_STACK={$env}");
+        }
+
+        if ($envArray !== null) {
+            $_ENV['LOG_STACK'] = $envArray;
+        }
+
+        if ($serverArray !== null) {
+            $_SERVER['LOG_STACK'] = $serverArray;
+        }
+    }
+
+    expect($config['channels']['stack']['channels'])->toBe(['daily']);
+});
+
+test('the daily archive channel rotates at storage/logs/laravel.log and keeps 14 days by default', function () {
+    expect(config('logging.channels.daily.driver'))->toBe('daily')
+        ->and(config('logging.channels.daily.path'))->toEndWith('logs/laravel.log')
+        ->and((int) config('logging.channels.daily.days'))->toBe(14);
+});
+
+test('the audit channel is a daily file at logs/audit.log, info level, kept 90 days', function () {
+    expect(config('logging.channels.audit.driver'))->toBe('daily')
+        ->and(config('logging.channels.audit.path'))->toEndWith('logs/audit.log')
+        ->and(config('logging.channels.audit.level'))->toBe('info')
+        ->and((int) config('logging.channels.audit.days'))->toBe(90);
+});
+
+test('the audit channel writes info entries to its own file and drops debug', function () {
+    $dir = storage_path('framework/testing/audit-'.Str::random(8));
+    config(['logging.channels.audit.path' => $dir.'/audit.log']);
+    app('log')->forgetChannel('audit');
+
+    Log::channel('audit')->debug('debug noise that must not be written');
+    Log::channel('audit')->info('Subscription status changed', ['subscription_id' => 7, 'to' => 'past_due']);
+
+    $files = File::glob($dir.'/audit-*.log');
+    $contents = $files ? File::get($files[0]) : '';
+
+    File::deleteDirectory($dir);
+
+    expect($files)->toHaveCount(1)
+        ->and($contents)->toContain('Subscription status changed')
+        ->and($contents)->toContain('"subscription_id":7')
+        ->and($contents)->not->toContain('debug noise');
+});
+
+test('there is no discord log channel: Discord is an explicit call, not a Monolog channel', function () {
+    expect(config('logging.channels'))->not->toHaveKey('discord');
+});
diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..451fd6c
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,167 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+const DISCORD_TEST_WEBHOOK = 'https://discord.com/api/webhooks/123456/SECRET-TOKEN';
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => DISCORD_TEST_WEBHOOK]);
+});
+
+function discordSentContent(): string
+{
+    return Http::recorded()->first()[0]['content'];
+}
+
+test('the notifier resolves from the container without constructor arguments', function () {
+    expect(app(DiscordOpsAlert::class))->toBeInstanceOf(DiscordOpsAlert::class);
+});
+
+test('does nothing at all when no webhook is configured', function (?string $url) {
+    Http::fake();
+    config(['services.discord.webhook_url' => $url]);
+
+    app(DiscordOpsAlert::class)->send('Job exhausted retries', 'asaas-webhooks gave up');
+
+    Http::assertNothingSent();
+})->with([null, '']);
+
+test('posts one JSON payload with the content key to the configured webhook', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Payment webhook failing', 'Asaas webhook rejected', ['entity_id' => 42]);
+
+    Http::assertSentCount(1);
+    Http::assertSent(fn (Request $request) => $request->method() === 'POST'
+        && $request->url() === DISCORD_TEST_WEBHOOK
+        && $request->hasHeader('Content-Type', 'application/json')
+        && $request['content'] === "Payment webhook failing\nAsaas webhook rejected\nentity_id=42");
+});
+
+test('renders the title, then the message, then one key=value line per context entry', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message', [
+        'queue' => 'asaas-webhooks',
+        'attempts' => 5,
+        'retrying' => false,
+        'note' => null,
+    ]);
+
+    expect(discordSentContent())->toBe("Title\nMessage\nqueue=asaas-webhooks\nattempts=5\nretrying=false\nnote=null");
+});
+
+test('truncates the text to exactly 1800 multibyte characters', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', str_repeat('ç', 3000));
+
+    $content = discordSentContent();
+
+    expect(mb_strlen($content))->toBe(1800)
+        ->and(mb_check_encoding($content, 'UTF-8'))->toBeTrue()
+        ->and(mb_substr($content, 0, 6))->toBe("Title\n");
+});
+
+test('redacts context values whose key looks sensitive, case-insensitively', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message', [
+        'Password' => 'hunter2',
+        'access_token' => 'tok-123',
+        'client-secret' => 'sec-456',
+        'Authorization' => 'Basic dXNlcjpwYXNz',
+        'api_key' => 'key-1',
+        'api-key' => 'key-2',
+        'APIKEY' => 'key-3',
+        'webhook' => DISCORD_TEST_WEBHOOK,
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    expect(discordSentContent())
+        ->toContain("Password=[redacted]\n")
+        ->toContain("access_token=[redacted]\n")
+        ->toContain("client-secret=[redacted]\n")
+        ->toContain("Authorization=[redacted]\n")
+        ->toContain("api_key=[redacted]\n")
+        ->toContain("api-key=[redacted]\n")
+        ->toContain("APIKEY=[redacted]\n")
+        ->toContain("webhook=[redacted]\n")
+        ->toContain('queue=asaas-webhooks')
+        ->not->toContain('hunter2')
+        ->not->toContain('tok-123')
+        ->not->toContain('sec-456')
+        ->not->toContain('dXNlcjpwYXNz')
+        ->not->toContain('SECRET-TOKEN');
+});
+
+test('redacts any string value carrying a bearer credential, whatever its key', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message', [
+        'header' => 'Bearer eyJhbGciOi.payload.sig',
+        'detail' => 'calling upstream with bearer abc123 now',
+    ]);
+
+    expect(discordSentContent())
+        ->toContain("header=[redacted]\n")
+        ->toContain('detail=[redacted]')
+        ->not->toContain('eyJhbGciOi')
+        ->not->toContain('abc123');
+});
+
+test('redacts a bearer credential that appears in the message itself', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Upstream rejected Bearer abc123');
+
+    expect(discordSentContent())
+        ->toBe("Title\n[redacted]")
+        ->not->toContain('abc123');
