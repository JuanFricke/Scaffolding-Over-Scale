diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..28b2a0d
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Stringable;
+use Throwable;
+
+/**
+ * Pages a human about one actionable ops incident via a Discord incoming webhook.
+ *
+ * An explicit call made by code that decides an incident is worth waking someone for,
+ * never a Monolog channel. Soft-fails: it never throws and never breaks the caller.
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const REDACTED = '[redacted]';
+
+    private const SENSITIVE_KEY = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const BEARER = '/\bBearer\s+\S+/i';
+
+    /**
+     * Send one alert: the title, the message, then one `key=value` line per context entry.
+     *
+     * No-op (no HTTP request) when the webhook URL is not configured.
+     *
+     * @param  array<string, mixed>  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (blank($url)) {
+            return;
+        }
+
+        $lines = [$this->redactText($title), $this->redactText($message)];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->render($this->redactValue((string) $key, $value));
+        }
+
+        $content = mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH);
+
+        try {
+            $response = Http::timeout(5)->asJson()->post($url, ['content' => $content]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (Throwable $exception) {
+            Log::error('Discord ops alert failed', [
+                'exception' => $exception::class,
+                'error' => $this->scrub($exception->getMessage(), $url),
+            ]);
+        }
+    }
+
+    private function redactValue(string $key, mixed $value): mixed
+    {
+        if (preg_match(self::SENSITIVE_KEY, $key)) {
+            return self::REDACTED;
+        }
+
+        if (is_array($value)) {
+            $redacted = [];
+
+            foreach ($value as $childKey => $child) {
+                $redacted[$childKey] = $this->redactValue((string) $childKey, $child);
+            }
+
+            return $redacted;
+        }
+
+        return is_string($value) ? $this->redactText($value) : $value;
+    }
+
+    private function redactText(string $text): string
+    {
+        return preg_match(self::BEARER, $text) ? self::REDACTED : $text;
+    }
+
+    private function render(mixed $value): string
+    {
+        return match (true) {
+            is_array($value) => (string) json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE),
+            is_bool($value) => $value ? 'true' : 'false',
+            $value === null => 'null',
+            is_scalar($value), $value instanceof Stringable => (string) $value,
+            default => get_debug_type($value),
+        };
+    }
+
+    /**
+     * Remove the webhook URL and its path (which embeds the token) from transport error text.
+     */
+    private function scrub(string $text, string $url): string
+    {
+        $scrubbed = str_replace($url, self::REDACTED, $text);
+        $path = (string) parse_url($url, PHP_URL_PATH);
+
+        return $path === '' ? $scrubbed : str_replace($path, self::REDACTED, $scrubbed);
+    }
+}
