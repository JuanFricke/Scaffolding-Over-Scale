@@ -0,0 +1,52 @@
+<?php
+
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the invite mail is queued and renders the entity-invite markdown view', function () {
+    $mail = new EntityInviteMail(EntityInvite::factory()->create());
+
+    expect($mail)->toBeInstanceOf(ShouldQueue::class)
+        ->and($mail->content()->markdown)->toBe('emails.entity-invite');
+});
+
+test('the invite mail names the entity and role, links to sign-in and shows the expiry', function () {
+    app()->setLocale('en');
+
+    $entity = Entity::factory()->create(['name' => 'Acme Corp']);
+    $invite = EntityInvite::factory()->for($entity)->create(['role' => UserRole::Admin]);
+
+    $mail = new EntityInviteMail($invite);
+    $html = $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('You are invited to Acme Corp')
+        ->and($html)->toContain('You are invited to Acme Corp as Admin.')
+        ->and($html)->toContain('Access the link below to sign in and accept your invite:')
+        ->and($html)->toContain('Sign in to PegaFila')
+        ->and($html)->toContain(route('login'))
+        ->and($html)->toContain($invite->expires_at->format('d/m/Y'))
+        ->and($html)->toContain('Team PegaFila');
+});
+
+test('the invite mail is written in Brazilian Portuguese', function () {
+    app()->setLocale('pt_BR');
+
+    $entity = Entity::factory()->create(['name' => 'Acme Corp']);
+    $invite = EntityInvite::factory()->for($entity)->create(['role' => UserRole::Admin]);
+
+    $mail = new EntityInviteMail($invite);
+    $html = $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('Você foi convidado para Acme Corp')
+        ->and($html)->toContain('Você foi convidado para Acme Corp como Administrador.')
+        ->and($html)->toContain('Acesse o link abaixo para entrar e aceitar seu convite:')
+        ->and($html)->toContain('Entrar no PegaFila')
+        ->and($html)->toContain('Time PegaFila')
+        ->and($html)->toContain('Olá!');
+});
