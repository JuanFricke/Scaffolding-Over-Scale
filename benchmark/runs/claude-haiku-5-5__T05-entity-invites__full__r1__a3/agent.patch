@@ -0,0 +1,183 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    // Livewire requests default to the browser locale (en); assert against the Portuguese UI.
+    Livewire::withHeaders(['Accept-Language' => 'pt-BR']);
+    $this->withHeaders(['Accept-Language' => 'pt-BR']);
+
+    $this->entity = Entity::factory()->create();
+
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($this->entity)->for($owner)->owner()->create();
+
+    $this->admin = User::factory()->create(['name' => 'Bia Souza', 'email' => 'bia@example.com']);
+    $this->adminMembership = EntityMembership::factory()->for($this->entity)->for($this->admin)->admin()->create();
+
+    $this->employee = User::factory()->create(['name' => 'Carlos Lima', 'email' => 'carlos@example.com']);
+    $this->employeeMembership = EntityMembership::factory()->for($this->entity)->for($this->employee)->employee()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $this->entity->slug));
+});
+
+/**
+ * The markup of the first modal body on the page.
+ */
+function modalBody(string $html): string
+{
+    return substr($html, strpos($html, 'modal-card-body'));
+}
+
+test('openMember opens the modal for a membership of the entity, prefilled with its role', function () {
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('openMember', $this->employeeMembership->id)
+        ->assertSet('selectedMembershipId', $this->employeeMembership->id)
+        ->assertSet('memberRole', 'employee')
+        ->assertSeeHtml('<p class="modal-card-title">'.__('ui.members_details').'</p>');
+});
+
+test('the modal body shows the name first, then e-mail and role, with no empty role option', function () {
+    $html = Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('openMember', $this->adminMembership->id)
+        ->html();
+
+    $body = modalBody($html);
+
+    expect(strpos($body, 'Bia Souza'))->toBeLessThan(strpos($body, 'bia@example.com'))
+        ->and(strpos($body, 'bia@example.com'))->toBeLessThan(strpos($body, 'wire:model="memberRole"'))
+        ->and($body)->toContain('wire:model="memberRole"')
+        ->and($body)->not->toContain('<option value="">');
+});
+
+test('a membership from another entity cannot be opened', function () {
+    $foreign = EntityMembership::factory()->create();
+
+    $component = Livewire::test(Members::class, ['entity' => $this->entity]);
+
+    expect(fn () => $component->call('openMember', $foreign->id))
+        ->toThrow(ModelNotFoundException::class);
+
+    $component->assertSet('selectedMembershipId', null);
+});
+
+test('the owner membership is shown read-only, without a role select', function () {
+    $ownerMembership = $this->entity->ownerMembership();
+
+    $html = Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('openMember', $ownerMembership->id)
+        ->html();
+
+    expect(modalBody($html))->not->toContain('wire:model="memberRole"');
+});
+
+test('changing the role persists nothing until saveRole is called', function () {
+    $component = Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('openMember', $this->employeeMembership->id)
+        ->set('memberRole', 'admin');
+
+    expect($this->employeeMembership->fresh()->role)->toBe(UserRole::Employee);
+
+    $component->call('saveRole')->assertHasNoErrors();
+
+    expect($this->employeeMembership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('saveRole never assigns the owner role', function () {
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('openMember', $this->employeeMembership->id)
+        ->set('memberRole', 'owner')
+        ->call('saveRole')
+        ->assertHasErrors(['memberRole']);
+
+    expect($this->employeeMembership->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner membership cannot be changed', function () {
+    $ownerMembership = $this->entity->ownerMembership();
+
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('openMember', $ownerMembership->id)
+        ->set('memberRole', 'employee')
+        ->call('saveRole')
+        ->assertForbidden();
+
+    expect($ownerMembership->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('the last manager cannot be demoted', function () {
+    $solo = Entity::factory()->create();
+    $admin = User::factory()->create();
+    $adminMembership = EntityMembership::factory()->for($solo)->for($admin)->admin()->create();
+
+    $this->actingAs($admin)->post(route('entity.pick', $solo->slug));
+
+    Livewire::test(Members::class, ['entity' => $solo])
+        ->call('openMember', $adminMembership->id)
+        ->set('memberRole', 'employee')
+        ->call('saveRole')
+        ->assertForbidden();
+
+    expect($adminMembership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('a selection tampered to a foreign membership cannot be saved', function () {
+    $foreign = EntityMembership::factory()->employee()->create();
+
+    $component = Livewire::test(Members::class, ['entity' => $this->entity])
+        ->set('selectedMembershipId', $foreign->id)
+        ->set('memberRole', 'admin');
+
+    expect(fn () => $component->call('saveRole'))->toThrow(ModelNotFoundException::class);
+
+    expect($foreign->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('confirmRemoval opens a confirmation modal and cancelRemoval closes it without a browser confirm', function () {
+    $component = Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('openMember', $this->employeeMembership->id)
+        ->call('confirmRemoval')
+        ->assertSet('confirmingRemoval', true);
+
+    expect($component->html())
+        ->toContain(__('ui.members_remove_title'))
+        ->not->toContain('wire:confirm');
+
+    $component
+        ->call('cancelRemoval')
+        ->assertSet('confirmingRemoval', false)
+        ->assertSet('selectedMembershipId', $this->employeeMembership->id);
+
+    expect(EntityMembership::find($this->employeeMembership->id))->not->toBeNull();
+});
+
+test('the owner cannot be put through the removal confirmation', function () {
+    $ownerMembership = $this->entity->ownerMembership();
+
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('openMember', $ownerMembership->id)
+        ->call('confirmRemoval')
+        ->assertForbidden();
+
+    expect($ownerMembership->fresh())->not->toBeNull();
+});
+
+test('a foreign membership id cannot be removed through the page', function () {
+    $foreign = EntityMembership::factory()->create();
+
+    $component = Livewire::test(Members::class, ['entity' => $this->entity]);
+
+    expect(fn () => $component->call('removeMember', $foreign->id))
+        ->toThrow(ModelNotFoundException::class);
+
+    expect(EntityMembership::find($foreign->id))->not->toBeNull();
+});
