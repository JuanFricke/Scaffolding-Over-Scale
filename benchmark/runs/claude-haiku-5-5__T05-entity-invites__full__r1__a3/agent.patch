diff --git a/tests/Feature/Entity/PendingInvitesTest.php b/tests/Feature/Entity/PendingInvitesTest.php
new file mode 100644
index 0000000..9fd336d
--- /dev/null
+++ b/tests/Feature/Entity/PendingInvitesTest.php
@@ -0,0 +1,167 @@
+<?php
+
+use App\Livewire\Entity\PendingInvites;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('lists only the pending invites addressed to the signed-in user, ignoring case', function () {
+    $user = User::factory()->create(['email' => 'Ana@Example.com']);
+    $mine = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+    EntityInvite::factory()->create(['email' => 'other@example.com']);
+    EntityInvite::factory()->create(['email' => 'ana@example.com', 'accepted_at' => now()]);
+    EntityInvite::factory()->expired()->create(['email' => 'ana@example.com']);
+
+    $this->actingAs($user);
+
+    $html = Livewire::test(PendingInvites::class)->html();
+
+    expect($html)->toContain($mine->entity->name)
+        ->and(substr_count($html, 'wire:click="accept('))->toBe(1)
+        ->and(substr_count($html, 'wire:click="decline('))->toBe(1);
+});
+
+test('accepting creates the membership with the invited role and enters the entity', function () {
+    $user = User::factory()->create(['email' => 'Ana@Example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com', 'role' => UserRole::Admin]);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', $invite->entity->slug));
+
+    $membership = EntityMembership::where('entity_id', $invite->entity_id)->where('user_id', $user->id)->sole();
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull()
+        ->and(session('current_entity_id'))->toBe($invite->entity_id);
+});
+
+test('accepting an invite twice is a no-op without errors or duplicate memberships', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)->call('accept', $invite->id)->assertHasNoErrors();
+    Livewire::test(PendingInvites::class)->call('accept', $invite->id)->assertHasNoErrors();
+
+    expect(EntityMembership::where('user_id', $user->id)->count())->toBe(1);
+});
+
+test('accepting never duplicates an existing membership or changes its role', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com', 'role' => UserRole::Employee]);
+    EntityMembership::factory()->for($invite->entity)->for($user)->admin()->create();
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)->call('accept', $invite->id)->assertHasNoErrors();
+
+    $memberships = EntityMembership::where('entity_id', $invite->entity_id)->where('user_id', $user->id)->get();
+
+    expect($memberships)->toHaveCount(1)
+        ->and($memberships->first()->role)->toBe(UserRole::Admin);
+});
+
+test('an expired invite cannot be accepted', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->expired()->create(['email' => 'ana@example.com']);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasErrors(['invite']);
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+test('only the invitee can accept an invite', function () {
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+    $intruder = User::factory()->create(['email' => 'eve@example.com']);
+
+    $this->actingAs($intruder);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertForbidden();
+
+    expect($invite->fresh()->accepted_at)->toBeNull()
+        ->and(EntityMembership::count())->toBe(0);
+});
+
+test('declining deletes the invite for its invitee', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('decline', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::find($invite->id))->toBeNull()
+        ->and(EntityMembership::count())->toBe(0);
+});
+
+test('only the invitee can decline an invite', function () {
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+    $intruder = User::factory()->create(['email' => 'eve@example.com']);
+
+    $this->actingAs($intruder);
+
+    Livewire::test(PendingInvites::class)
+        ->call('decline', $invite->id)
+        ->assertForbidden();
+
+    expect(EntityInvite::find($invite->id))->not->toBeNull();
+});
+
+test('onboarding lists pending invites after the create form, separated by an hr', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    $html = $this->actingAs($user)
+        ->withHeaders(['Accept-Language' => 'pt-BR'])
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Convites pendentes')
+        ->assertSee($invite->entity->name)
+        ->assertSee('Aceitar')
+        ->assertSee('Recusar')
+        ->getContent();
+
+    expect(strpos($html, '<hr'))->toBeGreaterThan(strpos($html, 'wire:submit'));
+});
+
+test('onboarding renders no hr when there are no pending invites', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->withHeaders(['Accept-Language' => 'pt-BR'])
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertDontSee('<hr', false)
+        ->assertDontSee('Convites pendentes');
+});
+
+test('the entity switcher lists pending invites', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    $this->actingAs($user)
+        ->withHeaders(['Accept-Language' => 'pt-BR'])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Convites pendentes')
+        ->assertSee($invite->entity->name);
+});
diff --git a/tests/Feature/Entity/SendInviteTest.php b/tests/Feature/Entity/SendInviteTest.php
new file mode 100644
