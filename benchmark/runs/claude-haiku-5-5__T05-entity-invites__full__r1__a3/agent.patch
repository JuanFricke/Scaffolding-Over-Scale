@@ -0,0 +1,97 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    /**
+     * Accept an invite addressed to the signed-in user and enter its entity.
+     * Accepting an already accepted invite does nothing.
+     */
+    public function accept($inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorize('accept', $invite);
+
+        $entity = $invite->entity()->firstOrFail();
+
+        // Already accepted: idempotent, nothing to do and nothing to report.
+        if ($invite->accepted_at !== null) {
+            return;
+        }
+
+        if ($invite->expires_at->isPast()) {
+            $this->addError('invite', __('ui.invite_expired'));
+
+            return;
+        }
+
+        $claimed = DB::transaction(function () use ($invite) {
+            // Claim the invite atomically so a double submit cannot create the membership twice.
+            $claimed = EntityInvite::whereKey($invite->id)
+                ->whereNull('accepted_at')
+                ->update(['accepted_at' => now()]);
+
+            if ($claimed) {
+                EntityMembership::firstOrCreate(
+                    ['entity_id' => $invite->entity_id, 'user_id' => auth()->id()],
+                    ['role' => $invite->role->value],
+                );
+            }
+
+            return $claimed;
+        });
+
+        if (! $claimed) {
+            return;
+        }
+
+        session(['current_entity_id' => $entity->id]);
+
+        Log::channel('audit')->info('Entity invite accepted', [
+            'entity_id' => $entity->id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+
+        $this->redirect(route('entity.dashboard', $entity->slug));
+    }
+
+    /**
+     * Decline an invite addressed to the signed-in user, deleting it.
+     */
+    public function decline($inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorize('decline', $invite);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Entity invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.pending-invites', [
+            'invites' => EntityInvite::with('entity')
+                ->pending()
+                ->whereHas('entity')
+                ->where('email', EntityInvite::normalizeEmail(auth()->user()->email))
+                ->latest('id')
+                ->get(),
+        ]);
+    }
+}
