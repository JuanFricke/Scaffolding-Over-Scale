+    EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']);
+
+    expect(fn () => EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']))
+        ->toThrow(QueryException::class);
+});
+
+test('e-mails are stored lowercase and trimmed on every write path', function () {
+    $invite = EntityInvite::factory()->create(['email' => '  Ana.Silva@Example.COM ']);
+
+    expect($invite->fresh()->email)->toBe('ana.silva@example.com');
+
+    $invite->update(['email' => ' Bia@Example.com']);
+
+    expect($invite->fresh()->email)->toBe('bia@example.com');
+});
+
+test('the factory builds a pending employee invite that expires in seven days', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->role)->toBe(UserRole::Employee)
+        ->and($invite->accepted_at)->toBeNull()
+        ->and($invite->expires_at->isFuture())->toBeTrue()
+        ->and($invite->expires_at->between(now()->addDays(7)->subMinute(), now()->addDays(7)->addMinute()))->toBeTrue();
+});
+
+test('the expired state builds an invite that is already past its expiry', function () {
+    expect(EntityInvite::factory()->expired()->create()->expires_at->isPast())->toBeTrue();
+});
+
+test('pending invites exclude accepted and expired ones', function () {
+    $entity = Entity::factory()->create();
+    $pending = EntityInvite::factory()->for($entity)->create();
+    EntityInvite::factory()->for($entity)->create(['accepted_at' => now()]);
+    EntityInvite::factory()->for($entity)->expired()->create();
+
+    expect(EntityInvite::pending()->pluck('id')->all())->toBe([$pending->id]);
+});
+
+test('an entity exposes its invites and deleting it removes them', function () {
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->create();
+
+    expect($entity->invites)->toHaveCount(1);
+
+    $entity->forceDelete();
+
+    expect(EntityInvite::count())->toBe(0);
+});
