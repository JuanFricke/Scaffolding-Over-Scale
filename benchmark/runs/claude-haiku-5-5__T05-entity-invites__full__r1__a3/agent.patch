+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityInvite;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityInvitePolicy
+{
+    /**
+     * Only the invitee (e-mail match, case-insensitive) may accept an invite.
+     */
+    public function accept(User $user, EntityInvite $invite): bool
+    {
+        return $this->isInvitee($user, $invite);
+    }
+
+    /**
+     * Only the invitee (e-mail match, case-insensitive) may decline an invite.
+     */
+    public function decline(User $user, EntityInvite $invite): bool
+    {
+        return $this->isInvitee($user, $invite);
+    }
+
+    /**
+     * Cancelling an invite is a manager action (owner + admin) of its entity.
+     */
+    public function delete(User $user, EntityInvite $invite): bool
+    {
+        $membership = $user->membershipFor($invite->entity_id);
+
+        return $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    protected function isInvitee(User $user, EntityInvite $invite): bool
+    {
+        return $invite->email === EntityInvite::normalizeEmail($user->email);
+    }
+}
