+<?php
+
+use App\Livewire\Entity\Members;
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Mail;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = User::factory()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->owner)->owner()->create();
+
+    Mail::fake();
+
+    $this->actingAs($this->owner)->post(route('entity.pick', $this->entity->slug));
+});
+
+test('a manager invites an e-mail with a role and the invite e-mail is queued', function () {
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->set('inviteEmail', 'Ana@Example.com')
+        ->set('inviteRole', 'admin')
+        ->call('sendInvite')
+        ->assertHasNoErrors()
+        ->assertSet('inviteEmail', '')
+        ->assertSet('inviteRole', 'employee');
+
+    $invite = EntityInvite::where('entity_id', $this->entity->id)->sole();
+
+    expect($invite->email)->toBe('ana@example.com')
+        ->and($invite->role)->toBe(UserRole::Admin)
+        ->and($invite->invited_by)->toBe($this->owner->id)
+        ->and($invite->accepted_at)->toBeNull()
+        ->and($invite->expires_at->isFuture())->toBeTrue();
+
+    Mail::assertQueued(
+        EntityInviteMail::class,
+        fn (EntityInviteMail $mail) => $mail->hasTo('ana@example.com') && $mail->invite->is($invite),
+    );
+});
+
+test('an invalid e-mail is rejected and creates no invite', function () {
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->set('inviteEmail', 'not-an-email')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail' => 'email']);
+
+    expect(EntityInvite::count())->toBe(0);
+    Mail::assertNothingQueued();
+});
+
+test('the owner role is never invitable', function () {
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->set('inviteRole', 'owner')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteRole' => 'in']);
+
+    expect(EntityInvite::count())->toBe(0);
+});
+
+test('invalid input does not consume the invite quota', function () {
+    $component = Livewire::test(Members::class, ['entity' => $this->entity]);
+
+    for ($i = 0; $i < 11; $i++) {
+        $component->set('inviteEmail', 'not-an-email')->call('sendInvite');
+    }
+
+    $component
+        ->set('inviteEmail', 'ana@example.com')
+        ->call('sendInvite')
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::count())->toBe(1);
+});
+
+test('successful invites are limited to ten per hour for each manager and entity', function () {
+    $component = Livewire::test(Members::class, ['entity' => $this->entity]);
+
+    for ($i = 1; $i <= 10; $i++) {
+        $component
+            ->set('inviteEmail', "user{$i}@example.com")
+            ->call('sendInvite')
+            ->assertHasNoErrors();
+    }
+
+    $component
+        ->set('inviteEmail', 'late@example.com')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::count())->toBe(10);
+});
+
+test('an e-mail that already belongs to a member is rejected', function () {
+    $member = User::factory()->create(['email' => 'member@example.com']);
+    EntityMembership::factory()->for($this->entity)->for($member)->employee()->create();
+
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->set('inviteEmail', 'MEMBER@example.com')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::count())->toBe(0);
+    Mail::assertNothingQueued();
+});
+
+test('a second pending invite for the same e-mail is rejected', function () {
+    EntityInvite::factory()->for($this->entity)->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::count())->toBe(1);
+});
+
+test('an expired invite is replaced by a new pending one', function () {
+    $old = EntityInvite::factory()->for($this->entity)->expired()->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->call('sendInvite')
+        ->assertHasNoErrors();
+
+    $invites = EntityInvite::where('email', 'ana@example.com')->get();
+
+    expect($invites)->toHaveCount(1)
+        ->and($invites->first()->id)->not->toBe($old->id)
+        ->and($invites->first()->expires_at->isFuture())->toBeTrue();
+});
+
+test('a past accepted invite no longer blocks inviting that e-mail again', function () {
+    EntityInvite::factory()->for($this->entity)->create([
+        'email' => 'ana@example.com',
+        'accepted_at' => now()->subWeek(),
+    ]);
+
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->call('sendInvite')
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::where('email', 'ana@example.com')->pending()->count())->toBe(1);
+});
+
+test('a unique-constraint race at insert time becomes an error on the invite e-mail', function () {
+    EntityInvite::factory()->for($this->entity)->create(['email' => 'ana@example.com']);
+
+    // Simulates a concurrent request that inserted the invite after our pending check.
+    $component = new class extends Members
+    {
+        protected function hasPendingInvite(string $email): bool
+        {
+            return false;
+        }
+    };
+
+    Livewire::test($component::class, ['entity' => $this->entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::count())->toBe(1);
+    Mail::assertNothingQueued();
+});
+
+test('cancelling a pending invite of the entity deletes it', function () {
+    $invite = EntityInvite::factory()->for($this->entity)->create();
+
+    Livewire::test(Members::class, ['entity' => $this->entity])
+        ->call('cancelInvite', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::find($invite->id))->toBeNull();
+});
+
+test('cancelling an invite from another entity is not found and deletes nothing', function () {
+    $foreign = EntityInvite::factory()->create();
+
+    $component = Livewire::test(Members::class, ['entity' => $this->entity]);
+
+    expect(fn () => $component->call('cancelInvite', $foreign->id))
+        ->toThrow(ModelNotFoundException::class);
+
+    expect(EntityInvite::find($foreign->id))->not->toBeNull();
+});
+
+test('an employee cannot open the members page or send invites', function () {
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($this->entity)->for($employee)->employee()->create();
+
+    $this->actingAs($employee)->post(route('entity.pick', $this->entity->slug));
+
+    $this->actingAs($employee)
+        ->get(route('entity.members', $this->entity->slug))
+        ->assertForbidden();
+
+    Livewire::test(Members::class, ['entity' => $this->entity])->assertForbidden();
+
+    expect(EntityInvite::count())->toBe(0);
+});
