+    /**
+     * Normalize and validate a priority prefix map.
+     *
+     * @param  array<string|int, string>|null  $map
+     * @return array<string|int, string>|null
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function normalizePriorityPrefixMap(?array $map): ?array
+    {
+        if ($map === null || $map === []) {
+            return null;
+        }
+
+        foreach ($map as $key => $value) {
+            // keys: non-negative integers in canonical form
+            if (is_int($key)) {
+                if ($key < 0) {
+                    throw new InvalidArgumentException('Priority prefix map keys must be non-negative integers.');
+                }
+            } elseif (is_string($key)) {
+                if ($key === '' || ! ctype_digit($key)) {
+                    throw new InvalidArgumentException('Priority prefix map keys must be non-negative integers.');
+                }
+                if ($key !== '0' && str_starts_with($key, '0')) {
+                    throw new InvalidArgumentException('Priority prefix map keys must be in canonical form.');
+                }
+            } else {
+                throw new InvalidArgumentException('Priority prefix map keys must be non-negative integers.');
+            }
+
+            // values: exactly one uppercase letter
+            if (! is_string($value) || strlen($value) !== 1 || ! preg_match('/^[A-Z]$/', $value)) {
+                throw new InvalidArgumentException('Priority prefix map values must be a single uppercase letter.');
+            }
+        }
+
+        // Effective prefixes: custom entries plus default fallback for uncovered levels.
+        $letters = array_values($map);
+        foreach ([0, 10, 20] as $level) {
+            if (! array_key_exists($level, $map)) {
+                $letters[] = self::defaultPrefixFor($level);
+            }
+        }
+
+        if (count($letters) !== count(array_unique($letters))) {
+            throw new InvalidArgumentException('Priority prefixes must be unique.');
+        }
+
+        return $map;
+    }
+
+    public static function defaultPrefixFor(int $priority): string
+    {
+        if ($priority <= 0) {
+            return 'N';
+        }
+
+        if ($priority >= 20) {
+            return 'E';
+        }
+
+        return 'P';
+    }
+
+    public function prefixForPriority(int $priority): string
+    {
+        $map = $this->priority_prefix_map;
+
+        if (is_array($map) && array_key_exists($priority, $map)) {
+            return (string) $map[$priority];
+        }
+
+        return self::defaultPrefixFor($priority);
+    }
+
