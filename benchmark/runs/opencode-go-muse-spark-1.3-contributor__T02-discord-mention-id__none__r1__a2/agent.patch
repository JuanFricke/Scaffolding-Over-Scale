diff --git a/.env.example b/.env.example
index 2cf633c..a03bb0a 100644
--- a/.env.example
+++ b/.env.example
@@ -75,6 +75,8 @@ TELESCOPE_ENABLED=true
 
 # Discord ops alerts (incoming webhook). Empty = no-op. Alerts only — not a log sink.
 DISCORD_WEBHOOK_URL=
+# Optional Discord user ID to ping on every ops alert (17-20 digit snowflake). Empty = no ping.
+DISCORD_MENTION_ID=
 
 # Hostinger / PegaFila ops (bin/pf) — never commit real secrets.
 # GitHub Actions: store the same key as repository secret HOSTINGER_API
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..098053a 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -36,7 +36,7 @@ public function send(string $title, string $message, array $context = []): void
             return;
         }
 
-        $content = $this->formatContent($title, $message, $context);
+        $content = $this->formatContent($title, $message, $context, $this->mentionId());
 
         try {
             $response = Http::timeout(3)
@@ -58,7 +58,7 @@ public function send(string $title, string $message, array $context = []): void
     /**
      * @param  array<string, mixed>  $context
      */
-    private function formatContent(string $title, string $message, array $context): string
+    private function formatContent(string $title, string $message, array $context, ?string $mentionId = null): string
     {
         $lines = [$title, $message];
 
@@ -66,7 +66,43 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $base = implode("\n", $lines);
+
+        if ($mentionId === null) {
+            return mb_substr($base, 0, self::MaxContentLength);
+        }
+
+        $suffix = "\n<@{$mentionId}>";
+
+        return mb_substr($base, 0, self::MaxContentLength - mb_strlen($suffix)).$suffix;
+    }
+
+    /**
+     * Validated Discord user ID to ping, or null when unset/invalid.
+     *
+     * Only a Discord snowflake (17-20 ASCII digits, surrounding
+     * whitespace trimmed) is accepted; anything else is ignored silently
+     * so a misconfiguration can never inject `@everyone`/`@here`.
+     */
+    private function mentionId(): ?string
+    {
+        $raw = config('services.discord.mention_id');
+
+        if (is_int($raw)) {
+            $raw = (string) $raw;
+        }
+
+        if (! is_string($raw)) {
+            return null;
+        }
+
+        $candidate = trim($raw);
+
+        if (! preg_match('/^[0-9]{17,20}$/', $candidate)) {
+            return null;
+        }
+
+        return $candidate;
     }
 
     private function safe(string $key, mixed $value): string
