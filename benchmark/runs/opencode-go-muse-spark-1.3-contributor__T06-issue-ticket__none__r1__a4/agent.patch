+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        $attempts = 5;
+
+        while (true) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    // Re-read the queue inside the transaction (locking the row)
+                    // so a queue deactivated after the caller loaded it is still
+                    // rejected. Nothing is persisted on rejection.
+                    $locked = Queue::whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+                    if (! $locked->is_active) {
+                        throw new InactiveQueueException('Cannot issue tickets for an inactive queue.');
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $locked->id,
+                        'code' => Ticket::nextCode($locked->id),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (InactiveQueueException $e) {
+                throw $e;
+            } catch (QueryException $e) {
+                if ($attempts-- > 0 && self::isUniqueViolation($e)) {
+                    continue;
+                }
+
+                throw $e;
+            }
+        }
+    }
+
+    protected static function isUniqueViolation(QueryException $e): bool
+    {
+        if (($e->getCode() === '23000') || (string) $e->getCode() === '23000') {
+            return true;
+        }
+
+        $message = strtolower($e->getMessage());
+
+        return str_contains($message, 'unique')
+            || str_contains($message, 'duplicate');
+    }
+}
