+    test('a malformed e-mail is rejected', function () {
+        $this->post(route('password.email'), ['email' => 'nope'])
+            ->assertSessionHasErrors('email');
+    });
+
+    test('the request endpoint is throttled to 6 per minute', function () {
+        foreach (range(1, 6) as $_) {
+            $this->post(route('password.email'), ['email' => 'staff@example.com'])
+                ->assertRedirect();
+        }
+
+        $this->post(route('password.email'), ['email' => 'staff@example.com'])
+            ->assertStatus(429);
+    });
+});
+
+describe('reset password', function () {
+    test('the reset form asks for the e-mail exactly once', function () {
+        $response = $this->get(route('password.reset', ['token' => 'token-qualquer', 'email' => 'staff@example.com']))
+            ->assertOk()
+            ->assertSee('token-qualquer');
+
+        expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+    });
+
+    test('a valid token sets the new password, rotates remember_token and fires PasswordReset', function () {
+        Event::fake([PasswordReset::class]);
+        $rememberToken = $this->user->remember_token;
+        $token = Password::broker()->createToken($this->user);
+
+        $this->post(route('password.update'), [
+            'token' => $token,
+            'email' => 'staff@example.com',
+            'password' => 'NovaSenha123',
+            'password_confirmation' => 'NovaSenha123',
+        ])
+            ->assertRedirect(route('login'))
+            ->assertSessionHas('status', __('passwords.reset'));
+
+        $this->user->refresh();
+
+        expect(Hash::check('NovaSenha123', $this->user->password))->toBeTrue()
+            ->and($this->user->remember_token)->not->toBe($rememberToken);
+        Event::assertDispatched(PasswordReset::class);
+    });
+
+    test('an invalid token is rejected and the password does not change', function () {
+        $this->post(route('password.update'), [
+            'token' => 'token-invalido',
+            'email' => 'staff@example.com',
+            'password' => 'NovaSenha123',
+            'password_confirmation' => 'NovaSenha123',
+        ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+        expect(Hash::check('Senha1234', $this->user->fresh()->password))->toBeTrue();
+    });
+
+    test('the new password must follow the app-wide default rule', function () {
+        $token = Password::broker()->createToken($this->user);
+
+        $this->post(route('password.update'), [
+            'token' => $token,
+            'email' => 'staff@example.com',
+            'password' => 'fraca',
+            'password_confirmation' => 'fraca',
+        ])->assertSessionHasErrors('password');
+    });
+
+    test('a mismatched confirmation is rejected', function () {
+        $token = Password::broker()->createToken($this->user);
+
+        $this->post(route('password.update'), [
+            'token' => $token,
+            'email' => 'staff@example.com',
+            'password' => 'NovaSenha123',
+            'password_confirmation' => 'OutraSenha123',
+        ])->assertSessionHasErrors('password');
+    });
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..083bde0
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,135 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('guests can see the register page', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSeeHtml('wire:model="name"')
+        ->assertSeeHtml('wire:model="email"')
+        ->assertSeeHtml('wire:model="password"')
+        ->assertSeeHtml('wire:model="password_confirmation"');
+});
+
+test('authenticated users are redirected away from register', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
+
+test('registering creates an unverified user, sends the verification mail and signs in', function () {
+    Notification::fake();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Silva')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'ana@example.com')->firstOrFail();
+
+    expect($user->name)->toBe('Ana Silva')
+        ->and($user->email_verified_at)->toBeNull()
+        ->and(Hash::check('Senha1234', $user->password))->toBeTrue();
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+    $this->assertAuthenticatedAs($user);
+});
+
+test('the password must follow the app-wide default rule', function (string $password) {
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Silva')
+        ->set('email', 'ana@example.com')
+        ->set('password', $password)
+        ->set('password_confirmation', $password)
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    expect(User::count())->toBe(0);
+})->with([
+    'too short' => ['Ab1'],
+    'no numbers' => ['Senhaforte'],
+    'no mixed case' => ['senha1234'],
+    'no letters' => ['12345678'],
+]);
+
+test('a mismatched confirmation fails the confirmed rule on password', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Silva')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha5678')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+});
+
+test('an e-mail already in use is rejected', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Silva')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+
+    expect(User::count())->toBe(1);
+});
+
+test('a malformed e-mail is rejected', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Ana Silva')
+        ->set('email', 'ana@')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+});
+
+test('after five attempts from the same IP the limiter blocks on email', function () {
+    $this->freezeTime();
+
+    foreach (range(1, 5) as $_) {
+        RateLimiter::hit(str()->transliterate('register|127.0.0.1'));
+    }
+
+    $blocked = Livewire::test(Register::class)
+        ->set('name', 'Ana Silva')
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit');
+
+    $blocked->assertHasErrors(['email']);
+    expect($blocked->errors()->first('email'))
+        ->toBe(__('auth.throttle', ['seconds' => 60]));
+    expect(User::count())->toBe(0);
+});
+
+test('a signed-in user cannot create an account through the register component', function () {
+    $admin = User::factory()->create();
+    $this->actingAs($admin);
+
+    Livewire::test(Register::class)
+        ->set('name', 'Intruso')
+        ->set('email', 'intruso@example.com')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234')
+        ->call('submit');
+
+    expect(User::where('email', 'intruso@example.com')->exists())->toBeFalse();
+    $this->assertAuthenticatedAs($admin);
+});
diff --git a/tests/Feature/LocalizationTest.php b/tests/Feature/LocalizationTest.php
new file mode 100644
index 0000000..014dcb4
--- /dev/null
+++ b/tests/Feature/LocalizationTest.php
@@ -0,0 +1,50 @@
+<?php
+
+use Illuminate\Support\Arr;
+
+test('the test suite runs with the pt_BR locale', function () {
+    expect(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('phpunit pins the locale environment', function () {
+    $phpunit = file_get_contents(base_path('phpunit.xml'));
+
+    expect($phpunit)->toContain('<env name="APP_LOCALE" value="pt_BR"/>')
+        ->and($phpunit)->toContain('<env name="APP_FALLBACK_LOCALE" value="en"/>');
+});
+
+test('the example env ships the PegaFila locale defaults', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)->toContain('APP_NAME=PegaFila')
+        ->and($env)->toContain('APP_LOCALE=pt_BR')
+        ->and($env)->toContain('APP_FALLBACK_LOCALE=en');
+});
+
+test('the login page is in Brazilian Portuguese by default', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('the login page is in English when the locale is en', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu a senha?');
+});
+
+test('the en and pt_BR ui files define the same keys', function () {
+    $en = Arr::dot(require lang_path('en/ui.php'));
+    $ptBr = Arr::dot(require lang_path('pt_BR/ui.php'));
+
+    expect(array_keys($ptBr))->toEqualCanonicalizing(array_keys($en))
+        ->and($en)->not->toBeEmpty();
+});
diff --git a/tests/Feature/ViewConventionsTest.php b/tests/Feature/ViewConventionsTest.php
new file mode 100644
index 0000000..ce6f91e
--- /dev/null
+++ b/tests/Feature/ViewConventionsTest.php
@@ -0,0 +1,14 @@
+<?php
+
+use Illuminate\Support\Facades\File;
+
+test('views never hardcode internal href or action paths', function () {
+    $offenders = collect(File::allFiles(resource_path('views')))
+        ->filter(fn ($file) => str_ends_with($file->getFilename(), '.blade.php'))
+        ->filter(fn ($file) => preg_match('/\b(href|action)="\//', $file->getContents()))
+        ->map(fn ($file) => $file->getRelativePathname())
+        ->values()
+        ->all();
+
+    expect($offenders)->toBe([]);
+});
