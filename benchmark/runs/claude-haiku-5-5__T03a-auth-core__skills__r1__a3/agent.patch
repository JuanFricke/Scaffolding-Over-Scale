diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..be1ced5
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,150 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user): string
+{
+    return URL::temporarySignedRoute(
+        'verification.verify',
+        now()->addMinutes(60),
+        ['id' => $user->getKey(), 'hash' => sha1($user->getEmailForVerification())],
+    );
+}
+
+beforeEach(function () {
+    $this->unverified = User::factory()->unverified()->create();
+});
+
+describe('notice', function () {
+    test('guests are sent to login', function () {
+        $this->get(route('verification.notice'))
+            ->assertRedirect(route('login'));
+    });
+
+    test('unverified users see the notice and the resend form', function () {
+        $this->actingAs($this->unverified)
+            ->get(route('verification.notice'))
+            ->assertOk()
+            ->assertSee(__('ui.verify.title'))
+            ->assertSeeHtml('action="'.route('verification.send').'"');
+    });
+
+    test('verified users are sent home', function () {
+        $this->actingAs(User::factory()->create())
+            ->get(route('verification.notice'))
+            ->assertRedirect(route('home'));
+    });
+});
+
+describe('verify link', function () {
+    test('a valid signed link verifies the signed-in user and redirects home', function () {
+        $this->actingAs($this->unverified)
+            ->get(verificationUrl($this->unverified))
+            ->assertRedirect(route('home'));
+
+        expect($this->unverified->fresh()->hasVerifiedEmail())->toBeTrue();
+    });
+
+    test('an unsigned link is refused', function () {
+        $this->actingAs($this->unverified)
+            ->get(route('verification.verify', [
+                'id' => $this->unverified->getKey(),
+                'hash' => sha1($this->unverified->getEmailForVerification()),
+            ]))
+            ->assertForbidden();
+
+        expect($this->unverified->fresh()->hasVerifiedEmail())->toBeFalse();
+    });
+
+    test('a tampered id in a signed link returns 403 and verifies nobody', function () {
+        $other = User::factory()->unverified()->create();
+        $tampered = str_replace(
+            '/email/verify/'.$this->unverified->getKey().'/',
+            '/email/verify/'.$other->getKey().'/',
+            verificationUrl($this->unverified),
+        );
+
+        $this->actingAs($this->unverified)
+            ->get($tampered)
+            ->assertForbidden();
+
+        expect($this->unverified->fresh()->hasVerifiedEmail())->toBeFalse()
+            ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+    });
+
+    test('a validly signed link for another account does not verify the signed-in user', function () {
+        $other = User::factory()->unverified()->create();
+
+        $this->actingAs($this->unverified)
+            ->get(verificationUrl($other))
+            ->assertForbidden();
+
+        expect($this->unverified->fresh()->hasVerifiedEmail())->toBeFalse()
+            ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+    });
+
+    test('guests cannot use the verify link', function () {
+        $this->get(verificationUrl($this->unverified))
+            ->assertRedirect(route('login'));
+    });
+
+    test('the verify link is throttled', function () {
+        $this->actingAs($this->unverified);
+
+        foreach (range(1, 6) as $_) {
+            $this->get(verificationUrl($this->unverified))->assertRedirect(route('home'));
+        }
+
+        $this->get(verificationUrl($this->unverified))->assertStatus(429);
+    });
+});
+
+describe('resend', function () {
+    test('an unverified user gets a new VerifyEmail and a status flash', function () {
+        Notification::fake();
+
+        $this->actingAs($this->unverified)
+            ->post(route('verification.send'))
+            ->assertRedirect(route('verification.notice'))
+            ->assertSessionHas('status', 'verification-link-sent');
+
+        Notification::assertSentTo($this->unverified, VerifyEmail::class);
+    });
+
+    test('a verified user sends nothing and is redirected home', function () {
+        Notification::fake();
+        $verified = User::factory()->create();
+
+        $this->actingAs($verified)
+            ->post(route('verification.send'))
+            ->assertRedirect(route('home'));
+
+        Notification::assertNothingSent();
+    });
+
+    test('guests cannot resend', function () {
+        Notification::fake();
+
+        $this->post(route('verification.send'))
+            ->assertRedirect(route('login'));
+
+        Notification::assertNothingSent();
+    });
+
+    test('resend is throttled to 6 per minute', function () {
+        Notification::fake();
+        $this->actingAs($this->unverified);
+
+        foreach (range(1, 6) as $_) {
+            $this->post(route('verification.send'))->assertRedirect(route('verification.notice'));
+        }
+
+        $this->post(route('verification.send'))->assertStatus(429);
+    });
+});
