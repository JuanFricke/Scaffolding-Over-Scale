@@ -0,0 +1,40 @@
+<?php
+
+namespace App\Http\Requests\Auth;
+
+use Illuminate\Foundation\Http\FormRequest;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rules\Password;
+
+class ResetPasswordRequest extends FormRequest
+{
+    /**
+     * The reset token is the credential here; the route is guest-only.
+     */
+    public function authorize(): bool
+    {
+        return true;
+    }
+
+    /**
+     * Normalize the e-mail so it matches the lowercase address stored on the account.
+     */
+    protected function prepareForValidation(): void
+    {
+        if (is_string($this->input('email'))) {
+            $this->merge(['email' => Str::lower($this->input('email'))]);
+        }
+    }
+
+    /**
+     * @return array<string, array<int, mixed>>
+     */
+    public function rules(): array
+    {
+        return [
+            'token' => ['required', 'string'],
+            'email' => ['required', 'string', 'email:rfc,strict', 'max:255'],
+            'password' => ['required', 'string', 'confirmed', Password::defaults()],
+        ];
+    }
+}
diff --git a/app/Livewire/Auth/Login.php b/app/Livewire/Auth/Login.php
new file mode 100644
index 0000000..c68d584
--- /dev/null
+++ b/app/Livewire/Auth/Login.php
@@ -0,0 +1,59 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('components.layouts.app')]
+class Login extends Component
+{
+    #[Validate('required|string|email:rfc,strict|max:255')]
+    public string $email = '';
+
+    #[Validate('required|string')]
+    public string $password = '';
+
+    public bool $remember = false;
+
+    /**
+     * Attempt to sign in. Failed attempts are rate limited per lowercase e-mail and IP.
+     */
+    public function submit(): void
+    {
+        $this->ensureGuest();
+        $this->validate();
+
+        $email = str()->lower($this->email);
+        $throttleKey = str()->transliterate($email.'|'.request()->ip());
+
+        if (RateLimiter::tooManyAttempts($throttleKey, 5)) {
+            throw ValidationException::withMessages([
+                'email' => __('auth.throttle', ['seconds' => RateLimiter::availableIn($throttleKey)]),
+            ]);
+        }
+
+        if (! Auth::attempt(['email' => $email, 'password' => $this->password], $this->remember)) {
+            RateLimiter::hit($throttleKey, 60);
+
+            throw ValidationException::withMessages(['email' => __('auth.failed')]);
+        }
+
+        RateLimiter::clear($throttleKey);
+        session()->regenerate();
+
+        $this->redirectIntended(route('home'));
+    }
+
+    /**
+     * Livewire update requests do not run the page's `guest` middleware, so check here too.
+     */
+    protected function ensureGuest(): void
+    {
+        abort_if(Auth::check(), 403);
+    }
+}
