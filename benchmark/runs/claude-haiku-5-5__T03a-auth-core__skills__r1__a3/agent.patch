diff --git a/tests/Feature/Auth/LoginTest.php b/tests/Feature/Auth/LoginTest.php
new file mode 100644
index 0000000..0204fdb
--- /dev/null
+++ b/tests/Feature/Auth/LoginTest.php
@@ -0,0 +1,170 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->user = User::factory()->create([
+        'email' => 'staff@example.com',
+        'password' => 'Senha1234',
+    ]);
+});
+
+test('guests can see the login page', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeHtml('wire:model="email"')
+        ->assertSeeHtml('wire:model="password"')
+        ->assertSeeHtml('wire:model="remember"');
+});
+
+test('authenticated users are redirected away from login', function () {
+    $this->actingAs($this->user)
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('valid credentials sign in, regenerate the session and redirect home', function () {
+    $sessionId = session()->getId();
+
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($this->user);
+    expect(session()->getId())->not->toBe($sessionId);
+});
+
+test('the e-mail is matched case-insensitively', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'STAFF@Example.com')
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $this->assertAuthenticatedAs($this->user);
+});
+
+test('a malformed e-mail is rejected by validation', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+
+    $this->assertGuest();
+});
+
+test('wrong credentials show the auth.failed message on email', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'errada-123')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+
+    $this->assertGuest();
+});
+
+test('an unknown e-mail gets the same message as a wrong password', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'ninguem@example.com')
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+});
+
+test('a password equal to the stored hash does not sign in', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', $this->user->password)
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+
+    $this->assertGuest();
+});
+
+test('five failed attempts lock the e-mail and IP, even for the right password', function () {
+    $this->freezeTime();
+
+    foreach (range(1, 5) as $_) {
+        Livewire::test(Login::class)
+            ->set('email', 'staff@example.com')
+            ->set('password', 'errada-123')
+            ->call('submit');
+    }
+
+    $locked = Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'Senha1234')
+        ->call('submit');
+
+    $locked->assertHasErrors(['email']);
+    expect($locked->errors()->first('email'))
+        ->toBe(__('auth.throttle', ['seconds' => 60]));
+
+    $this->assertGuest();
+});
+
+test('the lockout is scoped to the e-mail, other accounts keep working', function () {
+    foreach (range(1, 5) as $_) {
+        Livewire::test(Login::class)
+            ->set('email', 'staff@example.com')
+            ->set('password', 'errada-123')
+            ->call('submit');
+    }
+
+    $other = User::factory()->create(['email' => 'outra@example.com', 'password' => 'Senha1234']);
+
+    Livewire::test(Login::class)
+        ->set('email', $other->email)
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $this->assertAuthenticatedAs($other);
+});
+
+test('remember me rotates the remember token', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'Senha1234')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect($this->user->fresh()->remember_token)->not->toBeNull();
+});
+
+test('a signed-in user cannot switch accounts through the login component', function () {
+    $other = User::factory()->create(['email' => 'outra@example.com', 'password' => 'Senha1234']);
+    $this->actingAs($this->user);
+
+    Livewire::test(Login::class)
+        ->set('email', $other->email)
+        ->set('password', 'Senha1234')
+        ->call('submit');
+
+    $this->assertAuthenticatedAs($this->user);
+});
+
+test('the rate limit is keyed by lowercase e-mail and IP', function () {
+    foreach (range(1, 5) as $_) {
+        Livewire::test(Login::class)
+            ->set('email', 'Staff@Example.com')
+            ->set('password', 'errada-123')
+            ->call('submit');
+    }
+
+    expect(RateLimiter::tooManyAttempts(
+        str()->transliterate('staff@example.com|127.0.0.1'),
+        5,
+    ))->toBeTrue();
+});
