@@ -0,0 +1,58 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /** Attempts before a persistent `(queue_id, code)` collision is surfaced. */
+    private const MAX_ATTEMPTS = 3;
+
+    /**
+     * Issue the next ticket of a queue.
+     *
+     * @throws InvalidArgumentException when $priority is negative
+     * @throws InactiveQueueException when the queue is inactive (checked against the database)
+     * @throws UniqueConstraintViolationException when concurrent issuers keep colliding on the code
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be zero or greater.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    // Lock + re-read: the caller's instance may predate a deactivation.
+                    $current = Queue::query()->lockForUpdate()->findOrFail($queue->getKey());
+
+                    if (! $current->is_active) {
+                        throw new InactiveQueueException("Queue [{$current->slug}] is inactive.");
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $current->getKey(),
+                        'code' => Ticket::nextCode($current->getKey()),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (UniqueConstraintViolationException $e) {
+                if ($attempt >= self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+    }
+}
