+++ b/tests/Feature/Domain/QueueTest.php
@@ -0,0 +1,52 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('queue factory creates an active queue with its own entity', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity)->toBeInstanceOf(Entity::class)
+        ->and($queue->is_active)->toBeTrue()
+        ->and($queue->labels_i18n)->toBeNull()
+        ->and(Queue::factory()->create()->slug)->not->toBe($queue->slug);
+});
+
+test('labels_i18n round-trips as an array', function () {
+    $queue = Queue::factory()->create(['labels_i18n' => ['pt_BR' => 'Caixa', 'en' => 'Cashier']]);
+
+    expect($queue->fresh()->labels_i18n)->toBe(['pt_BR' => 'Caixa', 'en' => 'Cashier']);
+});
+
+test('slug is unique within an entity but reusable across entities', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->create(['slug' => 'caixa']);
+
+    Queue::factory()->create(['slug' => 'caixa']);
+
+    expect(fn () => Queue::factory()->for($entity)->create(['slug' => 'caixa']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('entity has many queues and a queue has many tickets', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    expect($entity->queues)->toHaveCount(1)
+        ->and($queue->tickets)->toHaveCount(1);
+});
+
+test('deleting an entity row cascades to queues and tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $queue->entity->forceDelete();
+
+    expect(Queue::count())->toBe(0)->and(Ticket::count())->toBe(0);
+});
diff --git a/tests/Feature/Domain/TicketCodeTest.php b/tests/Feature/Domain/TicketCodeTest.php
new file mode 100644
index 0000000..5a7c9b8
--- /dev/null
+++ b/tests/Feature/Domain/TicketCodeTest.php
@@ -0,0 +1,92 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('ticket factory defaults', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->queue)->toBeInstanceOf(Queue::class)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('the first code of a queue is A001', function () {
+    expect(Ticket::nextCode(Queue::factory()->create()->id))->toBe('A001');
+});
+
+test('factory allocates sequential codes for the same queue, one by one or in batch', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+    $batch = Ticket::factory()->forQueue($queue)->count(2)->create();
+
+    expect([$first->code, $second->code, $batch[0]->code, $batch[1]->code])
+        ->toBe(['A001', 'A002', 'A003', 'A004']);
+});
+
+test('sequences are per queue', function () {
+    $a = Ticket::factory()->create();
+    $b = Ticket::factory()->create();
+
+    expect([$a->code, $b->code])->toBe(['A001', 'A001']);
+});
+
+test('factory keeps an explicit code', function () {
+    expect(Ticket::factory()->create(['code' => 'A-X'])->code)->toBe('A-X');
+});
+
+test('codes grow beyond 999 and follow insertion order, not string order', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    expect(Ticket::nextCode($queue->id))->toBe('A1000');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('deleting a ticket does not reuse its number', function () {
+    $queue = Queue::factory()->create();
+    $tickets = Ticket::factory()->forQueue($queue)->count(3)->create();
+    $tickets[1]->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('malformed legacy codes are skipped', function () {
+    $only = Queue::factory()->create();
+    Ticket::factory()->forQueue($only)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($only->id))->toBe('A001');
+
+    $mixed = Queue::factory()->create();
+    Ticket::factory()->forQueue($mixed)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($mixed)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($mixed->id))->toBe('A002');
+});
+
+test('lookalike codes are not valid', function (string $code) {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => $code]);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+})->with(['a005', 'B005', 'A', 'A5X', 'A 5', "A5\n", 'A99999999999999999999']);
+
+test('code is unique per queue', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    expect(fn () => Ticket::factory()->forQueue($queue)->create(['code' => 'A001']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
diff --git a/tests/Feature/Domain/TicketWriteOnceTest.php b/tests/Feature/Domain/TicketWriteOnceTest.php
new file mode 100644
index 0000000..7100029
--- /dev/null
+++ b/tests/Feature/Domain/TicketWriteOnceTest.php
@@ -0,0 +1,105 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+dataset('immutable changes', [
+    'code' => [['code' => 'A999']],
+    'priority' => [['priority' => 10]],
+    'channel' => [['channel' => TicketChannel::Totem]],
+    'issued_at' => [['issued_at' => '2000-01-01 00:00:00']],
+    'queue_id' => [['queue_id' => 999]],
+]);
+
+test('immutable fields cannot be changed after issuance', function (array $changes) {
+    $ticket = Ticket::factory()->create();
+    $before = $ticket->fresh()->getAttributes();
+
+    expect(fn () => $ticket->forceFill($changes)->save())->toThrow(LogicException::class)
+        ->and(fn () => $ticket->update($changes))->toThrow(LogicException::class);
+
+    expect(Ticket::find($ticket->id)->getAttributes())->toBe($before);
+})->with('immutable changes');
+
+test('saving an unchanged ticket or re-assigning equal values is fine', function () {
+    $ticket = Ticket::factory()->create(['priority' => 5]);
+
+    $ticket->priority = '5';
+    $ticket->code = $ticket->code;
+    $ticket->save();
+
+    expect($ticket->touch())->toBeTrue();
+});
+
+test('a member can call a waiting ticket exactly once', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->employee()->create();
+    $ticket = Ticket::factory()->forQueue(Queue::factory()->for($entity)->create())->create();
+
+    $ticket->call($user);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Called)
+        ->and($fresh->called_at)->not->toBeNull()
+        ->and($fresh->called_by_user_id)->toBe($user->id)
+        ->and($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->calledBy->is($user))->toBeTrue();
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+});
+
+test('a second call through a stale instance is rejected and keeps the first caller', function () {
+    $entity = Entity::factory()->create();
+    [$first, $second] = User::factory()->count(2)->create();
+    foreach ([$first, $second] as $user) {
+        EntityMembership::factory()->for($entity)->for($user)->create();
+    }
+    $ticket = Ticket::factory()->forQueue(Queue::factory()->for($entity)->create())->create();
+    $stale = Ticket::find($ticket->id);
+
+    $ticket->call($first);
+
+    expect(fn () => $stale->call($second))->toThrow(LogicException::class)
+        ->and($ticket->fresh()->called_by_user_id)->toBe($first->id);
+});
+
+test('non members cannot call and the ticket is untouched', function () {
+    $ticket = Ticket::factory()->create();
+    $stranger = User::factory()->create();
+    EntityMembership::factory()->for(Entity::factory()->create())->for($stranger)->owner()->create();
+
+    expect(fn () => $ticket->call($stranger))->toThrow(AuthorizationException::class);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Waiting)
+        ->and($fresh->called_at)->toBeNull()
+        ->and($fresh->called_by_user_id)->toBeNull();
+});
+
+test('a non member gets an authorization error even for an already called ticket', function () {
+    $ticket = Ticket::factory()->create(['status' => TicketStatus::Called]);
+
+    expect(fn () => $ticket->call(User::factory()->create()))
+        ->toThrow(AuthorizationException::class);
+});
+
+test('calling is not rejected because of pending changes to call fields only', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->admin()->create();
+    $ticket = Ticket::factory()->forQueue(Queue::factory()->for($entity)->create())->create();
+
+    $ticket->call($user);
+
+    expect($ticket->isDirty())->toBeFalse();
+});
