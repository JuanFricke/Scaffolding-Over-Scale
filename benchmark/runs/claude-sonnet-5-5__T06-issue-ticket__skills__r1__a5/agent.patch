diff --git a/tests/Feature/Domain/IssueTicketTest.php b/tests/Feature/Domain/IssueTicketTest.php
new file mode 100644
index 0000000..9028273
--- /dev/null
+++ b/tests/Feature/Domain/IssueTicketTest.php
@@ -0,0 +1,122 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+test('issues a waiting virtual ticket with priority 0 by default', function () {
+    Carbon::setTestNow('2026-03-04 10:00:00');
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at->equalTo(now()))->toBeTrue()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+
+    Carbon::setTestNow();
+});
+
+test('stores priority and channel and resolves from the container', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = app(IssueTicket::class)($queue, 20, TicketChannel::Totem);
+
+    expect($ticket->fresh())
+        ->priority->toBe(20)
+        ->channel->toBe(TicketChannel::Totem);
+});
+
+test('codes increase per queue', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    expect([$issue($queue)->code, $issue($queue)->code, $issue($queue)->code])
+        ->toBe(['A001', 'A002', 'A003']);
+});
+
+test('continues after tickets created elsewhere', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+
+    expect((new IssueTicket)($queue)->code)->toBe('A1000');
+});
+
+test('a negative priority is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))->toThrow(InvalidArgumentException::class);
+    expect(Ticket::count())->toBe(0);
+});
+
+test('an inactive queue is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+    expect(Ticket::count())->toBe(0);
+});
+
+test('InactiveQueueException is a RuntimeException', function () {
+    expect(new InactiveQueueException)->toBeInstanceOf(RuntimeException::class);
+});
+
+test('a queue deactivated after the caller loaded it is still rejected', function () {
+    $queue = Queue::factory()->create();
+    $stale = Queue::find($queue->id);
+    $queue->update(['is_active' => false]);
+
+    expect($stale->is_active)->toBeTrue();
+    expect(fn () => (new IssueTicket)($stale))->toThrow(InactiveQueueException::class);
+    expect(Ticket::count())->toBe(0);
+});
+
+test('a queue reactivated after the caller loaded it is accepted', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $stale = Queue::find($queue->id);
+    $queue->update(['is_active' => true]);
+
+    expect((new IssueTicket)($stale)->code)->toBe('A001');
+});
+
+test('retries on a code collision from concurrent issuance', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    $collisions = 0;
+
+    // Simulate a racing issuer that grabbed the number first: the first insert reuses A001.
+    Ticket::creating(function (Ticket $ticket) use (&$collisions) {
+        if ($collisions++ < 2) {
+            $ticket->code = 'A001';
+        }
+    });
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($collisions)->toBe(3)
+        ->and($ticket->code)->toBe('A002')
+        ->and(Ticket::count())->toBe(2);
+});
+
+test('gives up after a few collisions', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    Ticket::creating(fn (Ticket $ticket) => $ticket->code = 'A001');
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(UniqueConstraintViolationException::class);
+    expect(Ticket::count())->toBe(1);
+});
diff --git a/tests/Feature/Domain/QueueTest.php b/tests/Feature/Domain/QueueTest.php
