diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..3a2714d
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,116 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Database\Factories\TicketFactory;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use LogicException;
+
+/**
+ * Single-use unit of service. Write-once: after issuance only the call fields
+ * (`status`, `called_at`, `called_by_user_id`) may change, and only via {@see self::call()}.
+ */
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at'])]
+class Ticket extends Model
+{
+    /** @use HasFactory<TicketFactory> */
+    use HasFactory;
+
+    /** Fields that may change after issuance (`updated_at` rides along). */
+    private const MUTABLE = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        static::updating(function (self $ticket) {
+            $immutable = array_diff(array_keys($ticket->getDirty()), self::MUTABLE);
+
+            if ($immutable !== []) {
+                throw new LogicException('Ticket fields are write-once after issuance: '.implode(', ', $immutable).'.');
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: `A` + (number of the last valid code by
+     * insertion order) + 1, zero padded to 3 digits and growing beyond 999.
+     * Codes not shaped `A<digits>` are skipped; deleted tickets are not reused
+     * unless they were the newest.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $tickets = static::query()->where('queue_id', $queueId)->lazyByIdDesc(50);
+
+        foreach ($tickets as $ticket) {
+            // Up to 15 digits keeps the number inside a native int.
+            if (preg_match('/^A(\d{1,15})\z/', (string) $ticket->code, $match)) {
+                return sprintf('A%03d', (int) $match[1] + 1);
+            }
+        }
+
+        return 'A001';
+    }
+
+    /**
+     * Call this ticket (exactly once) on behalf of a member of its entity.
+     *
+     * @throws AuthorizationException when $user is not a member of the entity
+     * @throws LogicException when the ticket was already called
+     */
+    public function call(User $user): void
+    {
+        Gate::forUser($user)->authorize('call', $this);
+
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Ticket was already called.');
+        }
+
+        DB::transaction(function () use ($user) {
+            // Re-check against the database: this instance may be stale.
+            $current = static::query()->lockForUpdate()->find($this->getKey());
+
+            if ($current?->status !== TicketStatus::Waiting) {
+                throw new LogicException('Ticket was already called.');
+            }
+
+            $this->forceFill([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+            ])->save();
+        });
+    }
+}
