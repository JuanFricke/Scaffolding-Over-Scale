+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the application ships configured for Brazilian Portuguese', function () {
+    expect(file_get_contents(base_path('.env.example')))
+        ->toContain('APP_LOCALE=pt_BR')
+        ->toContain('APP_FALLBACK_LOCALE=en')
+        ->and(config('app.locale'))->toBe('pt_BR');
+});
+
+test('the login screen renders in Brazilian Portuguese', function () {
+    $this->get('/login')
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('screen text comes from translation files rather than hardcoded strings', function () {
+    app()->setLocale('en');
+
+    $this->get('/login')
+        ->assertSee('Log in')
+        ->assertDontSee('Senha');
+});
+
+test('failed login reports the error in Brazilian Portuguese', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    $errors = Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'senha-errada')
+        ->call('submit')
+        ->errors();
+
+    expect($errors->first('email'))->toBe(__('auth.failed'))
+        ->and($errors->first('email'))->toContain('credenciais');
+});
