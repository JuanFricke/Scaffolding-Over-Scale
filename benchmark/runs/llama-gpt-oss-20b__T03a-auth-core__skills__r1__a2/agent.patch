+++ b/app/Livewire/Auth/Login.php
@@ -0,0 +1,56 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use Livewire\Component;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+// use Illuminate\Support\Facades\Redirect;
+// use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Lang;
+use Illuminate\Support\Str;
+// use Illuminate\Foundation\Support\Http\RedirectResponse;
+
+class Login extends Component
+{
+    public string $email = '';
+    public string $password = '';
+    public bool $remember = false;
+
+    protected function rules(): array
+    {
+        return [
+            'email' => 'required|email',
+            'password' => 'required',
+        ];
+    }
+
+    public function submit(): void
+    {
+        $validated = $this->validate();
+
+        $emailKey = Str::lower($this->email);
+        $ip = request()->ip();
+        $limiterKey = "login:{$ip}:{$emailKey}";
+
+        if (RateLimiter::tooManyAttempts($limiterKey, 5)) {
+            $this->addError('email', Lang::get('auth.throttle', ['seconds' => RateLimiter::availableIn($limiterKey)]));
+            return;
+        }
+
+        if (!Auth::attempt(['email' => $this->email, 'password' => $this->password], $this->remember)) {
+            RateLimiter::hit($limiterKey, 60);
+            $this->addError('email', Lang::get('auth.failed'));
+            return;
+        }
+
+        RateLimiter::clear($limiterKey);
+        request()->session()->regenerate();
+        return redirect()->route('home');
+    }
+
+    public function render()
+    {
+        return view('livewire.auth.login');
+    }
+}
diff --git a/app/Livewire/Auth/Register.php b/app/Livewire/Auth/Register.php
