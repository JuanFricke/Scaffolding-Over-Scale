+<?php
+
+use Illuminate\Support\Facades\Route;
+
+test('every auth route is named', function () {
+    foreach (['login', 'register', 'logout', 'home', 'password.request', 'password.reset', 'verification.notice'] as $name) {
+        expect(Route::has($name))->toBeTrue("Route [{$name}] is not defined");
+    }
+});
+
+test('views link through named routes instead of hardcoded paths', function () {
+    $views = array_merge(
+        glob(base_path('resources/views/*.blade.php')),
+        glob(base_path('resources/views/*/*.blade.php')),
+        glob(base_path('resources/views/*/*/*.blade.php')),
+    );
+
+    foreach ($views as $view) {
+        expect(file_get_contents($view))
+            ->not->toMatch('/(href|action)="\/\w/', "Hardcoded path in {$view}");
+    }
+});
+
+test('redirects use named routes instead of hardcoded paths', function () {
+    foreach (glob(base_path('app/{Http/Controllers,Http/Controllers/Auth,Livewire/Auth}/*.php'), GLOB_BRACE) as $class) {
+        expect(file_get_contents($class))
+            ->not->toMatch("/redirect(Intended)?\('\/\w/", "Hardcoded path in {$class}");
+    }
+});
+
+test('the password reset form asks for the e-mail only once', function () {
+    $view = file_get_contents(base_path('resources/views/auth/reset-password.blade.php'));
+
+    expect(substr_count($view, 'name="email"'))->toBe(1);
+});
