diff --git a/tests/Feature/Entity/EntityInviteTest.php b/tests/Feature/Entity/EntityInviteTest.php
new file mode 100644
index 0000000..5668d4b
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteTest.php
@@ -0,0 +1,120 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Mail;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity_invites has the expected columns and unique entity/email index', function () {
+    expect(Schema::hasTable('entity_invites'))->toBeTrue()
+        ->and(Schema::hasColumns('entity_invites', [
+            'id', 'entity_id', 'invited_by', 'email', 'role',
+            'expires_at', 'accepted_at', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('entity_invites', 'entity_invites_entity_id_email_unique'))->toBeTrue();
+});
+
+test('invite e-mails are normalized on every write path', function () {
+    $invite = EntityInvite::factory()->create(['email' => '  Invitee@Example.COM ']);
+
+    expect($invite->email)->toBe('invitee@example.com');
+
+    $invite->update(['email' => '  OTHER@Example.COM ']);
+
+    expect($invite->fresh()->email)->toBe('other@example.com');
+});
+
+test('invite role and timestamps are cast and expired state works', function () {
+    $invite = EntityInvite::factory()->create([
+        'role' => UserRole::Admin->value,
+        'expires_at' => now()->addDays(2),
+        'accepted_at' => now(),
+    ]);
+
+    expect($invite->role)->toBe(UserRole::Admin)
+        ->and($invite->expires_at)->toBeInstanceOf(DateTimeInterface::class)
+        ->and($invite->accepted_at)->toBeInstanceOf(DateTimeInterface::class)
+        ->and(EntityInvite::factory()->expired()->create()->isExpired())->toBeTrue();
+});
+
+test('entity exposes its invites', function () {
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create();
+
+    expect($entity->invites()->get())->toHaveCount(1)
+        ->and($entity->invites()->first()->is($invite))->toBeTrue();
+});
+
+test('the invite mail uses the markdown view, subject, role translation and login link', function () {
+    app()->setLocale('en');
+
