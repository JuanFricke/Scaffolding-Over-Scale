@@ -0,0 +1,107 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    public function accept($inviteId): void
+    {
+        $user = $this->invitee();
+        $invite = EntityInvite::with('entity')->findOrFail($inviteId);
+
+        $this->authorizeInvitee($invite, $user);
+
+        // Accepting is idempotent: an already accepted invite is a no-op.
+        if ($invite->accepted_at !== null) {
+            return;
+        }
+
+        if ($invite->isExpired()) {
+            $this->addError('invite', __('ui.invites_expired'));
+
+            return;
+        }
+
+        DB::transaction(function () use ($invite, $user) {
+            EntityMembership::firstOrCreate(
+                [
+                    'entity_id' => $invite->entity_id,
+                    'user_id' => $user->id,
+                ],
+                ['role' => $invite->role->value],
+            );
+
+            $invite->update(['accepted_at' => now()]);
+        });
+
+        session(['current_entity_id' => $invite->entity_id]);
+
+        Log::channel('audit')->info('Invite accepted', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $user->id,
+            'invite_id' => $invite->id,
+            'role' => $invite->role->value,
+        ]);
+
+        $this->redirect(route('entity.dashboard', $invite->entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $user = $this->invitee();
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorizeInvitee($invite, $user);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $user->id,
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        $user = auth()->user();
+
+        $invites = $user
+            ? EntityInvite::with('entity')
+                ->pending()
+                ->whereRaw('LOWER(email) = ?', [Str::lower(trim($user->email))])
+                ->latest('id')
+                ->get()
+            : collect();
+
+        return view('livewire.entity.pending-invites', [
+            'invites' => $invites,
+        ]);
+    }
+
+    protected function invitee(): User
+    {
+        $user = auth()->user();
+
+        abort_if(! $user, 403);
+
+        return $user;
+    }
+
+    protected function authorizeInvitee(EntityInvite $invite, User $user): void
+    {
+        abort_unless(
+            Str::lower(trim($invite->email)) === Str::lower(trim($user->email)),
+            403,
+        );
+    }
+}
