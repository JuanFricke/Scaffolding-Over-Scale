+    expect($html)->toContain(__('ui.invites_accept'))
+        ->and($html)->toContain(__('ui.invites_decline'))
+        ->and($html)->not->toContain('someone@example.com')
+        ->and($html)->not->toContain($expiredEntity->name)
+        ->and($html)->not->toContain($acceptedEntity->name);
+});
