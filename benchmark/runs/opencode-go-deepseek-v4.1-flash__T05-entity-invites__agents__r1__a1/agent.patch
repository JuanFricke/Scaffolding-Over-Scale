+
+    $mine = EntityInvite::factory()->for($entity)->create(['email' => 'INVITEE@example.com']);
+    EntityInvite::factory()->for($otherEntity)->create(['email' => 'someone@example.com']);
+    EntityInvite::factory()->for($expiredEntity)->expired()->create(['email' => 'invitee@example.com']);
+    EntityInvite::factory()->for($acceptedEntity)->create(['email' => 'invitee@example.com', 'accepted_at' => now()]);
