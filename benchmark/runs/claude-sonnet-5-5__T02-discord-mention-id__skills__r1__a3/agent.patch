@@ -121,3 +121,52 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends the configured user mention on its own last line', function (string|int $id, string $expected) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $id]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues', ['entity_id' => 42]);
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'], "\nentity_id=42\n<@{$expected}>"));
+})->with([
+    'string' => ['123456789012345678', '123456789012345678'],
+    'trimmed' => [" 123456789012345678\n", '123456789012345678'],
+    'integer' => [123456789012345678, '123456789012345678'],
+    '17 digits' => ['12345678901234567', '12345678901234567'],
+    '20 digits' => ['12345678901234567890', '12345678901234567890'],
+]);
+
+test('adds no mention when the id is unset or invalid', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $id]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'], '<@')
+        && ! str_contains($request['content'], '@everyone')
+        && $request['content'] === "Plan limit\nEntity hit max queues");
+})->with([
+    'null' => [null], 'empty' => [''], 'blank' => ['   '], '@everyone' => ['@everyone'], '@here' => ['@here'], 'abc' => ['abc'], 'short' => ['123'],
+    '16 digits' => ['1234567890123456'], '21 digits' => ['123456789012345678901'],
+    'newline injection' => ["123\n@everyone"], 'bracket injection' => ["123> \n@everyone"],
+    'trailing newline injection' => ["123456789012345678\n@everyone"], 'trailing bracket' => ['123456789012345678>'],
+    'raw mention' => ['<@123456789012345678>'], 'arabic digits' => ['١٢٣٤٥٦٧٨٩٠١٢٣٤٥٦٧٨'],
+    'short int' => [12345], 'bool' => [true], 'float' => [1.5], 'array' => [[]],
+]);
+
+test('keeps the mention when truncating long alerts to 1800 characters', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(fn (Request $request) => mb_strlen($request['content']) === 1800
+        && str_ends_with($request['content'], "\n<@123456789012345678>"));
+});
