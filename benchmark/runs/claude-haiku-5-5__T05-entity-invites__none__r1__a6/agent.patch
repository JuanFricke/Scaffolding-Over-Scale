+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+
+return new class extends Migration
+{
+    /**
+     * Run the migrations.
+     */
+    public function up(): void
+    {
+        Schema::create('entity_invites', function (Blueprint $table) {
+            $table->id();
+            $table->foreignId('entity_id')->constrained()->cascadeOnDelete();
+            $table->foreignId('invited_by')->nullable()->constrained('users')->nullOnDelete();
+            // Always stored lowercase and trimmed (see EntityInvite::email()).
+            $table->string('email');
+            $table->string('role')->default('employee');
+            $table->timestamp('expires_at');
+            $table->timestamp('accepted_at')->nullable();
+            $table->timestamps();
+
+            // One invite row per address per entity; expired/accepted rows are replaced on re-invite.
+            $table->unique(['entity_id', 'email']);
+            // Invitees look their pending invites up by e-mail across entities.
+            $table->index('email');
+        });
+    }
+
+    /**
+     * Reverse the migrations.
+     */
+    public function down(): void
+    {
+        Schema::dropIfExists('entity_invites');
+    }
+};
