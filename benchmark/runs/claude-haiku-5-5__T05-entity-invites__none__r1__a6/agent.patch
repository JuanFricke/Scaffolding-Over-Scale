+<?php
+
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('invite e-mail is written in Brazilian Portuguese with the PegaFila theme', function () {
+    $entity = Entity::factory()->create(['name' => 'Acme Cafe']);
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com', 'role' => 'admin']);
+
+    $mail = new EntityInviteMail($invite);
+    $html = (string) $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('Você foi convidado para Acme Cafe')
+        ->and($html)->toContain('#0f7490')
+        ->and($html)->toContain('Olá!')
+        ->and($html)->toContain('Você foi convidado para entrar em Acme Cafe como Administrador.')
+        ->and($html)->toContain('Acesse o link abaixo para entrar e aceitar seu convite:')
+        ->and($html)->toContain('Entrar no PegaFila')
+        ->and($html)->toContain(route('login'))
+        ->and($html)->toContain('Este convite expira em')
+        ->and($html)->toContain('Time PegaFila');
+});
+
+test('invite e-mail is written in English when the app locale is English', function () {
+    app()->setLocale('en');
+
+    $entity = Entity::factory()->create(['name' => 'Acme Cafe']);
+    $invite = EntityInvite::factory()->for($entity)->create(['role' => 'employee']);
+
+    $mail = new EntityInviteMail($invite);
+    $html = (string) $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('You are invited to Acme Cafe')
+        ->and($html)->toContain('You are invited to Acme Cafe as Employee.')
+        ->and($html)->toContain('Access the link below to sign in and accept your invite:')
+        ->and($html)->toContain('Sign in to PegaFila')
+        ->and($html)->toContain('Team PegaFila');
+});
diff --git a/tests/Feature/Entity/EntityInviteModelTest.php b/tests/Feature/Entity/EntityInviteModelTest.php
new file mode 100644
index 0000000..8794bef
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteModelTest.php
@@ -0,0 +1,88 @@
+<?php
+
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+test('entity exposes its invites', function () {
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create();
+
+    expect($entity->invites()->pluck('id')->all())->toBe([$invite->id])
+        ->and($invite->entity->is($entity))->toBeTrue();
+});
+
+test('e-mails are stored lowercase and trimmed on every write path', function () {
+    $invite = EntityInvite::factory()->create(['email' => '  Ana@Example.COM ']);
+
+    expect($invite->email)->toBe('ana@example.com')
+        ->and(DB::table('entity_invites')->where('id', $invite->id)->value('email'))->toBe('ana@example.com');
+
+    $invite->update(['email' => 'Bia@Example.com']);
+
+    expect(DB::table('entity_invites')->where('id', $invite->id)->value('email'))->toBe('bia@example.com');
+});
+
+test('role is cast to the UserRole enum and timestamps are cast to dates', function () {
+    $invite = EntityInvite::factory()->create(['role' => 'admin']);
+
+    $fresh = $invite->fresh();
+
+    expect($fresh->role)->toBe(UserRole::Admin)
+        ->and($fresh->expires_at)->toBeInstanceOf(DateTimeInterface::class)
+        ->and($fresh->accepted_at)->toBeNull();
+});
+
+test('factory defaults to an employee invite expiring in 7 days', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->role)->toBe(UserRole::Employee)
+        ->and($invite->expires_at->diffInDays(now(), true))->toBeGreaterThan(6.9)
+        ->and($invite->expires_at->diffInDays(now(), true))->toBeLessThan(7.1)
+        ->and($invite->isPending())->toBeTrue();
+});
+
+test('expired state produces a non pending invite', function () {
+    $invite = EntityInvite::factory()->expired()->create();
+
+    expect($invite->expires_at->isPast())->toBeTrue()
+        ->and($invite->isPending())->toBeFalse()
+        ->and(EntityInvite::pending()->count())->toBe(0);
+});
+
+test('pending scope excludes accepted and expired invites', function () {
+    $pending = EntityInvite::factory()->create();
+    EntityInvite::factory()->expired()->create();
+    EntityInvite::factory()->accepted()->create();
+
+    expect(EntityInvite::pending()->pluck('id')->all())->toBe([$pending->id]);
+});
+
+test('forEmail matches case-insensitively', function () {
+    $invite = EntityInvite::factory()->create(['email' => 'ana@example.com']);
+
+    expect(EntityInvite::forEmail(' ANA@example.com ')->pluck('id')->all())->toBe([$invite->id]);
+});
+
+test('invites are removed with their entity', function () {
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create();
+
+    $entity->forceDelete();
+
+    expect(EntityInvite::where('id', $invite->id)->exists())->toBeFalse();
+});
+
+test('the invite mailable is queued and uses the markdown view', function () {
+    $invite = EntityInvite::factory()->create();
+    $mail = new EntityInviteMail($invite);
+
+    expect($mail)->toBeInstanceOf(ShouldQueue::class)
+        ->and($mail->content()->markdown)->toBe('emails.entity-invite');
+});
