@@ -0,0 +1,101 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    public function accept($inviteId): void
+    {
+        $invite = $this->invitation($inviteId);
+
+        // Already accepted (double click, stale tab): nothing left to do, and no error.
+        if ($invite->accepted_at) {
+            return;
+        }
+
+        if ($invite->expires_at->isPast()) {
+            $this->addError('invite', __('ui.invite_expired'));
+
+            return;
+        }
+
+        // The entity may have been soft-deleted since the invite was sent.
+        abort_unless($invite->entity, 404);
+
+        $userId = auth()->id();
+
+        $claimed = DB::transaction(function () use ($invite, $userId) {
+            // Claim the invite atomically so concurrent accepts create a single membership.
+            $claimed = EntityInvite::whereKey($invite->id)
+                ->whereNull('accepted_at')
+                ->update(['accepted_at' => now()]);
+
+            if ($claimed) {
+                EntityMembership::firstOrCreate(
+                    ['entity_id' => $invite->entity_id, 'user_id' => $userId],
+                    ['role' => $invite->role->value],
+                );
+            }
+
+            return $claimed;
+        });
+
+        if (! $claimed) {
+            return;
+        }
+
+        session(['current_entity_id' => $invite->entity_id]);
+
+        Log::channel('audit')->info('Invite accepted', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $userId,
+            'invite_id' => $invite->id,
+        ]);
+
+        $this->redirect(route('entity.dashboard', $invite->entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $invite = $this->invitation($inviteId);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.pending-invites', [
+            'invites' => EntityInvite::with('entity')
+                ->forEmail(auth()->user()->email)
+                ->pending()
+                ->whereHas('entity')
+                ->latest('id')
+                ->get(),
+        ]);
+    }
+
+    /**
+     * Resolve an invite the signed-in user is the invitee of; anyone else gets 403.
+     */
+    protected function invitation($inviteId): EntityInvite
+    {
+        $invite = EntityInvite::with('entity')->findOrFail($inviteId);
+
+        abort_unless($invite->email === EntityInvite::normalizeEmail(auth()->user()->email), 403);
+
+        return $invite;
+    }
+}
