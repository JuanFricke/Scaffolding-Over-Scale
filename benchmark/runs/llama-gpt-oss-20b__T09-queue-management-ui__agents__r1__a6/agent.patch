new file mode 100644
index 0000000..322d813
--- /dev/null
+++ b/app/Livewire/Entity/Serve.php
@@ -0,0 +1,106 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Actions\CallNextTicket;
+use App\Enums\QueuePermission;
+use App\Models\UserRole;
+use App\Models\QueueAccess;
+use Illuminate\Contracts\View\View;
+use Livewire\Component;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Illuminate\Support\Facades\Gate;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+
+#[Layout('layouts::default-page')]
+class Serve extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public ?int $selectedQueueId = null;
+    public string $mode = 'any';
+    public ?int $lastCalledTicketId = null;
+    public ?string $notice = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+        $this->selectedQueueId = $this->callableQueues->first()?->id ?? null;
+    }
+
+    public function getCallableQueuesProperty(): \Illuminate\Database\Eloquent\Collection
+    {
+        $queues = $this->entity->queues()->where('is_active', true)->get();
+
+        $membership = auth()->user()->membershipFor($this->entity->id);
+        if (!$membership) {
+            return collect();
+        }
+
+        if (in_array($membership->role, [\App\Models\UserRole::Owner->value, \App\Models\UserRole::Admin->value], true)) {
+            return $queues;
+        }
+
+        return $queues->filter(fn ($queue) => QueueAccess::query()->where('queue_id', $queue->id)->where('entity_membership_id', $membership->id)->whereJsonContains('permissions', QueuePermission::Call->value)->exists());
+    }
+
+    public function callNext(): void
+    {
+        if (!$this->selectedQueueId) {
+            $this->notice = __('ui.serve_empty');
+            return;
+        }
+
+        $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+        $this->authorize('call', $queue);
+
+        try {
+            $ticket = (new CallNextTicket)($queue, auth()->user(), CallMode::from($this->mode));
+            $this->lastCalledTicketId = $ticket->id;
+            $this->notice = __('ui.serve_last_called', ['code' => $ticket->code]);
+        } catch (InactiveQueueException) {
+            $this->notice = __('ui.serve_inactive');
+        } catch (NoWaitingTicketsException) {
+            $this->notice = __('ui.serve_empty');
+        }
+    }
+
+    public function render(): View
+    {
+        $queue = $this->selectedQueueId
+            ? $this->entity->queues()->findOrFail($this->selectedQueueId)
+            : null;
+
+        $tickets = null;
+        if ($queue) {
+            $query = $queue->tickets()->where('status', TicketStatus::Waiting);
+
+            if ($this->mode === 'priority_only') {
+                $query->where('priority', '>', 0);
+            } elseif ($this->mode === 'normal_only') {
+                $query->where('priority', 0);
+            }
+
+            $tickets = $query->orderByDesc('priority')
+                ->orderBy('issued_at')
+                ->orderBy('id')
+                ->take(30)
+                ->get();
+        }
+
+        return view('livewire.entity.serve', [
+            'callableQueues' => $this->callableQueues,
+            'selectedQueue' => $queue,
+            'tickets' => $tickets,
+        ]);
+    }
+}
