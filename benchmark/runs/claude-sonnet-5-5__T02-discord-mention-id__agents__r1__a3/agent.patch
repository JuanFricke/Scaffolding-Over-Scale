diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..80c1975 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -15,12 +15,16 @@
  *         'job' => $jobClass,
  *     ]);
  *
- * Unconfigured (empty DISCORD_WEBHOOK_URL) is a silent no-op.
+ * Unconfigured (empty DISCORD_WEBHOOK_URL) is a silent no-op. When
+ * DISCORD_MENTION_ID holds a valid Discord user ID (17-20 digits), every alert
+ * ends with a `<@id>` mention on its own line; any other value is ignored.
  */
 class DiscordOpsAlert
 {
     private const int MaxContentLength = 1800;
 
+    private const string SnowflakePattern = '/^\d{17,20}\z/';
+
     private const string SecretKeyPattern = '/password|token|secret|authorization|api[_-]?key|webhook/i';
 
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
@@ -66,7 +70,32 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $mention = $this->mention();
+        $suffix = $mention === null ? '' : "\n".$mention;
+
+        $body = mb_substr(implode("\n", $lines), 0, self::MaxContentLength - mb_strlen($suffix));
+
+        return $body.$suffix;
+    }
+
+    /**
+     * The `<@id>` mention for the configured user, or null when unset/invalid.
+     */
+    private function mention(): ?string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (is_int($id)) {
+            $id = (string) $id;
+        }
+
+        if (! is_string($id)) {
+            return null;
+        }
+
+        $id = trim($id);
+
+        return preg_match(self::SnowflakePattern, $id) === 1 ? '<@'.$id.'>' : null;
     }
 
     private function safe(string $key, mixed $value): string
