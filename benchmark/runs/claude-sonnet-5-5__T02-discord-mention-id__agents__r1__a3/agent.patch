@@ -121,3 +121,63 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends the configured mention on its own final line', function (mixed $configured, string $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $configured]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message', ['k' => 'v']);
+
+    Http::assertSent(fn (Request $request) => $request['content'] === "Title\nMessage\nk=v\n<@{$id}>");
+})->with([
+    'string' => ['123456789012345678', '123456789012345678'],
+    'trimmed' => ["  123456789012345678\n", '123456789012345678'],
+    'integer' => [123456789012345678, '123456789012345678'],
+    '17 digits' => ['12345678901234567', '12345678901234567'],
+    '20 digits' => ['12345678901234567890', '12345678901234567890'],
+]);
+
+test('adds no mention when unset or invalid', function (mixed $configured) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $configured]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertSent(fn (Request $request) => $request['content'] === "Title\nMessage");
+})->with([
+    'null' => [null],
+    'empty' => [''],
+    'blank' => ['   '],
+    'everyone' => ['@everyone'],
+    'here' => ['@here'],
+    'letters' => ['abc'],
+    'too short' => ['123'],
+    '16 digits' => ['1234567890123456'],
+    '21 digits' => ['123456789012345678901'],
+    'newline injection' => ["123\n@everyone"],
+    'bracket injection' => ["123> \n@everyone"],
+    'embedded newline' => ["12345678901234567\n8"],
+    'trailing junk' => ['123456789012345678>'],
+    'non-ascii digits' => ['١٢٣٤٥٦٧٨٩٠١٢٣٤٥٦٧٨'],
+    'float' => [1.2345678901234568e17],
+    'array' => [['123456789012345678']],
+]);
+
+test('keeps the mention when a long alert is truncated to 1800 characters', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return mb_strlen($content) === 1800 && str_ends_with($content, "\n<@123456789012345678>");
+    });
+});
