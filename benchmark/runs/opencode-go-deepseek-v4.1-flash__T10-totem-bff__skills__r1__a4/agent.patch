+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+abstract class TotemApiController extends Controller
+{
+    protected function entity(Request $request): Entity
+    {
+        return $request->attributes->get('totem_entity');
+    }
+
+    protected function entityMismatch(Request $request): bool
+    {
+        return $request->route('entity') !== $this->entity($request)->slug;
+    }
+
+    protected function resolveQueue(Request $request, string $slug): Queue|JsonResponse
+    {
+        $queue = $this->entity($request)->queues()->where('slug', $slug)->first();
+
+        if ($queue === null) {
+            return $this->error('queue_not_found', 404);
+        }
+
+        if (! in_array((int) $queue->id, $request->attributes->get('totem_queue_ids', []), true)) {
+            return $this->error('forbidden', 403);
+        }
+
+        return $queue;
+    }
+
+    protected function error(string $code, int $status): JsonResponse
+    {
+        return response()->json(['code' => $code], $status);
+    }
+}
