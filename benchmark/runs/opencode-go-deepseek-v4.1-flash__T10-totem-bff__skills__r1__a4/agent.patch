+<?php
+
+namespace App\Totem;
+
+/**
+ * Backend-owned priority levels for the totem API.
+ *
+ * The same list validates ticket issuance and feeds the priorities endpoint,
+ * so the client can never invent a value outside the domain vocabulary.
+ */
+final class TicketPriority
+{
+    public const int NORMAL = 0;
+
+    public const int PRIORITY = 10;
+
+    public const int PRIORITY_80 = 20;
+
+    /**
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function all(): array
+    {
+        return [
+            [
+                'value' => self::NORMAL,
+                'label' => 'Normal',
+                'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            ],
+            [
+                'value' => self::PRIORITY,
+                'label' => 'Prioritário',
+                'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            ],
+            [
+                'value' => self::PRIORITY_80,
+                'label' => 'Prioridade 80+',
+                'visual' => ['color' => '#6A1B9A', 'icon' => 'elderly', 'order' => 3],
+            ],
+        ];
+    }
+
+    public static function isValid(mixed $value): bool
+    {
+        return is_int($value) && in_array($value, self::values(), true);
+    }
+
+    /**
+     * @return list<int>
+     */
+    public static function values(): array
+    {
+        return array_column(self::all(), 'value');
+    }
+
+    /**
+     * @return array{value: int, label: string, visual: array{color: string, icon: string, order: int}}|null
+     */
+    public static function find(int $value): ?array
+    {
+        foreach (self::all() as $priority) {
+            if ($priority['value'] === $value) {
+                return $priority;
+            }
+        }
+
+        return null;
+    }
+}
diff --git a/app/Totem/TotemJwt.php b/app/Totem/TotemJwt.php
new file mode 100644
index 0000000..d08bbe6
--- /dev/null
+++ b/app/Totem/TotemJwt.php
@@ -0,0 +1,128 @@
+<?php
+
+namespace App\Totem;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Support\Str;
+use RuntimeException;
+
+/**
+ * Small, dependency-free HS256 JWT implementation for the totem API.
+ *
+ * Only HS256 is accepted when decoding; `alg: none` and algorithm confusion
+ * attempts are rejected before the signature is checked.
+ */
+final class TotemJwt
+{
+    /**
+     * @param  list<int>  $queueIds
+     */
+    public function issue(Totem $totem, TotemPreset $preset, array $queueIds): string
+    {
+        $now = now()->getTimestamp();
+        $ttl = $this->ttl();
+
+        $header = ['typ' => 'JWT', 'alg' => 'HS256'];
+        $payload = [
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => array_values(array_map('intval', $queueIds)),
+            'iat' => $now,
+            'exp' => $now + $ttl,
+            'jti' => (string) Str::uuid(),
+        ];
+
+        $headerPart = $this->encodeSegment(json_encode($header, JSON_UNESCAPED_SLASHES) ?: '{}');
+        $payloadPart = $this->encodeSegment(json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?: '{}');
+        $signature = hash_hmac('sha256', $headerPart.'.'.$payloadPart, $this->secret(), true);
+
+        return $headerPart.'.'.$payloadPart.'.'.$this->encodeSegment($signature);
+    }
+
+    /**
+     * Decode and validate a token. Returns null for any invalid/expired token.
+     *
+     * @return array<string, mixed>|null
+     */
+    public function decode(string $token): ?array
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            return null;
+        }
+
+        [$headerPart, $payloadPart, $signaturePart] = $parts;
+
+        $headerJson = $this->decodeSegment($headerPart);
+        $payloadJson = $this->decodeSegment($payloadPart);
+        $signature = $this->decodeSegment($signaturePart);
+
+        if ($headerJson === null || $payloadJson === null || $signature === null) {
+            return null;
+        }
+
+        $header = json_decode($headerJson, true);
+        $payload = json_decode($payloadJson, true);
+
+        if (! is_array($header) || ! is_array($payload)) {
+            return null;
+        }
+
+        if (($header['alg'] ?? null) !== 'HS256' || ($header['typ'] ?? null) !== 'JWT') {
+            return null;
+        }
+
+        $expected = hash_hmac('sha256', $headerPart.'.'.$payloadPart, $this->secret(), true);
+
+        if (! hash_equals($expected, $signature)) {
+            return null;
+        }
+
+        if (! isset($payload['exp']) || ! is_numeric($payload['exp']) || (int) $payload['exp'] <= now()->getTimestamp()) {
+            return null;
+        }
+
+        return $payload;
+    }
+
+    public function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl', 3600);
+    }
+
+    private function secret(): string
+    {
+        $secret = config('services.totem.jwt_secret');
+
+        if (! is_string($secret) || $secret === '') {
+            throw new RuntimeException('The totem JWT secret is not configured.');
+        }
+
+        return $secret;
+    }
+
+    private function encodeSegment(string $value): string
+    {
+        return rtrim(strtr(base64_encode($value), '+/', '-_'), '=');
+    }
+
+    private function decodeSegment(string $value): ?string
+    {
+        if ($value === '' || preg_match('/[^A-Za-z0-9_-]/', $value) === 1) {
+            return null;
+        }
+
+        $padding = strlen($value) % 4;
+
+        if ($padding !== 0) {
+            $value .= str_repeat('=', 4 - $padding);
+        }
+
+        $decoded = base64_decode(strtr($value, '-_', '+/'), true);
+
+        return $decoded === false ? null : $decoded;
+    }
+}
