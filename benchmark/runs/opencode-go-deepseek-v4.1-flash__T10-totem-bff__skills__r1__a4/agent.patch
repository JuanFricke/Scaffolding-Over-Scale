@@ -0,0 +1,57 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+#[Signature('totem:pairing-code {preset}')]
+#[Description('Open a 10-minute pairing window for a totem preset')]
+class TotemPairingCode extends Command
+{
+    /**
+     * Execute the console command.
+     */
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+        $preset = is_numeric($presetId) ? TotemPreset::query()->find((int) $presetId) : null;
+
+        if ($preset === null) {
+            $this->error("Totem preset [{$presetId}] not found.");
+
+            return self::FAILURE;
+        }
+
+        $code = $this->generateCode($preset->id, $preset->login_code);
+
+        $preset->login_code = $code;
+        $preset->login_code_expires_at = now()->addMinutes(10);
+        $preset->login_code_consumed_at = null;
+        $preset->save();
+
+        Log::channel('audit')->info('totem.pairing_code.generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        $this->info("Pairing code for preset {$preset->id}: {$code}");
+
+        return self::SUCCESS;
+    }
+
+    private function generateCode(int $presetId, ?string $currentCode): string
+    {
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while ($code === $currentCode || TotemPreset::query()
+            ->where('login_code', $code)
+            ->where('id', '!=', $presetId)
+            ->exists());
+
+        return $code;
+    }
+}
