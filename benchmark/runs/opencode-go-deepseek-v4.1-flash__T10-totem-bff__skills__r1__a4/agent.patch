new file mode 100644
index 0000000..89cf606
--- /dev/null
+++ b/app/Http/Middleware/TotemAuthenticate.php
@@ -0,0 +1,89 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class TotemAuthenticate
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $header = $request->header('Authorization');
+
+        if (! is_string($header) || preg_match('/^Bearer\s+(\S+)$/i', $header, $matches) !== 1) {
+            return $this->invalidToken();
+        }
+
+        $claims = app(TotemJwt::class)->decode($matches[1]);
+
+        if ($claims === null) {
+            return $this->invalidToken();
+        }
+
+        $totemId = $this->positiveInt($claims['totem_id'] ?? null);
+        $entityId = $this->positiveInt($claims['entity_id'] ?? null);
+        $presetId = $this->positiveInt($claims['preset_id'] ?? null);
+
+        if ($totemId === null || $entityId === null || $presetId === null || ! is_array($claims['queues'] ?? null)) {
+            return $this->invalidToken();
+        }
+
+        $totem = Totem::query()->find($totemId);
+        $preset = TotemPreset::query()->find($presetId);
+        $entity = Entity::query()->find($entityId);
+
+        if ($totem === null || $preset === null || $entity === null) {
+            return $this->invalidToken();
+        }
+
+        if (! $totem->is_active
+            || ! $preset->is_active
+            || $totem->entity_id !== $entityId
+            || $preset->entity_id !== $entityId
+            || $preset->entity_id !== $totem->entity_id) {
+            return $this->invalidToken();
+        }
+
+        $claimedQueues = array_map('intval', $claims['queues']);
+        $currentQueues = $preset->queues()
+            ->pluck('queues.id')
+            ->map(fn (mixed $id): int => (int) $id)
+            ->all();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_queue_ids', array_values(array_intersect($claimedQueues, $currentQueues)));
+
+        $totem->last_seen_at = now();
+        $totem->saveQuietly();
+
+        return $next($request);
+    }
+
+    private function positiveInt(mixed $value): ?int
+    {
+        if (is_int($value)) {
+            return $value > 0 ? $value : null;
+        }
+
+        if (is_string($value) && ctype_digit($value)) {
+            $value = (int) $value;
+
+            return $value > 0 ? $value : null;
+        }
+
+        return null;
+    }
+
+    private function invalidToken(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
