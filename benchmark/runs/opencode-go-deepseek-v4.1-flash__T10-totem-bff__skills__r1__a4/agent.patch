+<?php
+
+use App\Http\Controllers\Api\TotemAuthController;
+use App\Http\Controllers\Api\TotemPriorityController;
+use App\Http\Controllers\Api\TotemQueueController;
+use App\Http\Controllers\Api\TotemTicketController;
+use Illuminate\Support\Facades\Route;
+
+Route::post('/totem/auth', [TotemAuthController::class, 'store'])
+    ->middleware('throttle:10,1')
+    ->name('api.totem.auth');
+
+Route::middleware('totem.auth')->group(function () {
+    Route::get('/{entity}/queues', [TotemQueueController::class, 'index'])
+        ->name('api.totem.queues');
+
+    Route::get('/{entity}/{queue}/priorities', [TotemPriorityController::class, 'index'])
+        ->name('api.totem.priorities');
+
+    Route::post('/{entity}/{queue}/ticket', [TotemTicketController::class, 'store'])
+        ->middleware('throttle:30,1')
+        ->name('api.totem.ticket');
+});
diff --git a/tests/Feature/TotemApiTest.php b/tests/Feature/TotemApiTest.php
new file mode 100644
index 0000000..7b205db
--- /dev/null
+++ b/tests/Feature/TotemApiTest.php
@@ -0,0 +1,288 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Collection;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @param  list<array<string, mixed>>  $queueAttributes
+ * @return array{entity: Entity, preset: TotemPreset, queues: Collection<int, Queue>, totem: Totem, token: string}
+ */
+function pegafilaTotemFixture(array $queueAttributes = []): array
+{
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $queues = collect($queueAttributes)
+        ->map(fn (array $attributes): Queue => Queue::factory()->for($entity)->create($attributes));
+
+    $preset->queues()->attach($queues->pluck('id')->all());
+
+    $totem = Totem::factory()->for($entity)->create(['last_seen_at' => null]);
+    $queueIds = $preset->queues()->pluck('queues.id')->map(fn (mixed $id): int => (int) $id)->all();
+    $token = app(TotemJwt::class)->issue($totem, $preset, $queueIds);
+
+    return compact('entity', 'preset', 'queues', 'totem', 'token');
+}
+
+function pegafilaBearer(string $token): array
+{
+    return ['Authorization' => 'Bearer '.$token];
+}
+
+it('lists active queues in the current preset scope ordered by name', function () {
+    ['entity' => $entity, 'queues' => $queues, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Zebra', 'slug' => 'zebra', 'labels_i18n' => ['description' => 'Fila final']],
+        ['name' => 'Alpha', 'slug' => 'alpha'],
+        ['name' => 'Inativa', 'slug' => 'inativa', 'is_active' => false],
+    ]);
+
+    $response = $this->getJson("/api/{$entity->slug}/queues", pegafilaBearer($token));
+
+    $response->assertOk()
+        ->assertJsonCount(2, 'queues')
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('entity.name', $entity->name)
+        ->assertJsonPath('queues.0.slug', 'alpha')
+        ->assertJsonPath('queues.0.label', 'Alpha')
+        ->assertJsonPath('queues.0.is_active', true)
+        ->assertJsonPath('queues.0.visual.order', 1)
+        ->assertJsonPath('queues.1.slug', 'zebra')
+        ->assertJsonPath('queues.1.label', 'Zebra')
+        ->assertJsonPath('queues.1.description', 'Fila final')
+        ->assertJsonPath('queues.1.visual.order', 2);
+
+    expect($response->json('queues.0.visual'))->toHaveKeys(['color', 'icon', 'order']);
+});
+
+it('rejects the wrong entity slug', function () {
+    ['token' => $token] = pegafilaTotemFixture();
+
+    $this->getJson('/api/another-entity/queues', pegafilaBearer($token))
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('rejects missing, malformed, tampered and expired tokens', function () {
+    ['entity' => $entity, 'totem' => $totem, 'preset' => $preset, 'token' => $token] = pegafilaTotemFixture();
+
+    $this->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+
+    $this->getJson("/api/{$entity->slug}/queues", pegafilaBearer('not-a-token'))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+
+    $parts = explode('.', $token);
+    $parts[1] = rtrim(strtr(base64_encode(json_encode(['sub' => 'tampered'])), '+/', '-_'), '=');
+    $tampered = implode('.', $parts);
+
+    $this->getJson("/api/{$entity->slug}/queues", pegafilaBearer($tampered))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+
+    $expired = app(TotemJwt::class)->issue($totem, $preset, []);
+    $this->travel(2)->hours();
+
+    $this->getJson("/api/{$entity->slug}/queues", pegafilaBearer($expired))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects an inactive totem or preset', function () {
+    ['entity' => $entity, 'totem' => $totem, 'token' => $token] = pegafilaTotemFixture();
+
+    $totem->update(['is_active' => false]);
+
+    $this->getJson("/api/{$entity->slug}/queues", pegafilaBearer($token))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+
+    ['entity' => $entity, 'preset' => $preset, 'token' => $token] = pegafilaTotemFixture();
+    $preset->update(['is_active' => false]);
+
+    $this->getJson("/api/{$entity->slug}/queues", pegafilaBearer($token))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose totem and preset belong to different entities', function () {
+    ['preset' => $preset, 'token' => $token] = pegafilaTotemFixture();
+    $otherEntity = Entity::factory()->create();
+    $otherTotem = Totem::factory()->for($otherEntity)->create();
+
+    $mismatched = app(TotemJwt::class)->issue($otherTotem, $preset, []);
+
+    // The token above is validly signed but its totem/preset/entity claims disagree.
+    $this->getJson("/api/{$preset->entity->slug}/queues", pegafilaBearer($mismatched))
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_token']);
+
+    expect($token)->toBeString();
+});
+
+it('quietly records the last time the totem was seen', function () {
+    ['entity' => $entity, 'totem' => $totem, 'token' => $token] = pegafilaTotemFixture();
+
+    expect($totem->last_seen_at)->toBeNull();
+
+    $this->getJson("/api/{$entity->slug}/queues", pegafilaBearer($token))->assertOk();
+
+    expect($totem->fresh()->last_seen_at)->not->toBeNull();
+});
+
+it('uses the intersection of token queues and the current preset queues', function () {
+    ['entity' => $entity, 'preset' => $preset, 'queues' => $queues, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Geral', 'slug' => 'geral'],
+        ['name' => 'Removida', 'slug' => 'removida'],
+    ]);
+
+    $preset->queues()->detach($queues[1]->id);
+
+    $this->getJson("/api/{$entity->slug}/queues", pegafilaBearer($token))
+        ->assertOk()
+        ->assertJsonCount(1, 'queues')
+        ->assertJsonPath('queues.0.slug', 'geral');
+
+    $this->getJson("/api/{$entity->slug}/removida/priorities", pegafilaBearer($token))
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
+
+it('returns the backend-owned priority levels', function () {
+    ['entity' => $entity, 'preset' => $preset, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Geral', 'slug' => 'geral'],
+    ]);
+
+    $response = $this->getJson("/api/{$entity->slug}/geral/priorities", pegafilaBearer($token));
+
+    $response->assertOk()
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('queue.slug', 'geral')
+        ->assertJsonPath('queue.label', 'Geral')
+        ->assertJsonPath('priorities.0.value', 0)
+        ->assertJsonPath('priorities.0.label', 'Normal')
+        ->assertJsonPath('priorities.1.value', 10)
+        ->assertJsonPath('priorities.1.label', 'Prioritário')
+        ->assertJsonPath('priorities.2.value', 20)
+        ->assertJsonPath('priorities.2.label', 'Prioridade 80+');
+
+    expect($response->json('priorities.0.visual'))->toHaveKeys(['color', 'icon', 'order']);
+});
+
+it('does not leak queues from another entity', function () {
+    ['entity' => $entity, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Geral', 'slug' => 'geral'],
+    ]);
+    $otherQueue = Queue::factory()->for(Entity::factory())->create(['slug' => 'other-only']);
+
+    $this->getJson("/api/{$entity->slug}/{$otherQueue->slug}/priorities", pegafilaBearer($token))
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    $this->getJson("/api/{$entity->slug}/unknown/priorities", pegafilaBearer($token))
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+});
+
+it('rejects priorities for an inactive queue', function () {
+    ['entity' => $entity, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Inativa', 'slug' => 'inativa', 'is_active' => false],
+    ]);
+
+    $this->getJson("/api/{$entity->slug}/inativa/priorities", pegafilaBearer($token))
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+});
+
+it('issues a totem ticket and returns the public contract', function () {
+    ['entity' => $entity, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Geral', 'slug' => 'geral'],
+    ]);
+
+    $response = $this->postJson("/api/{$entity->slug}/geral/ticket", ['priority' => 10], pegafilaBearer($token));
+
+    $response->assertCreated()
+        ->assertJsonPath('slug', 'A001')
+        ->assertJsonPath('queue.slug', 'geral')
+        ->assertJsonPath('queue.label', 'Geral')
+        ->assertJsonPath('priority.value', 10)
+        ->assertJsonPath('priority.label', 'Prioritário');
+
+    expect($response->json('issued_at'))->toBeString();
+
+    $this->assertDatabaseHas('tickets', [
+        'code' => 'A001',
+        'priority' => 10,
+        'channel' => TicketChannel::Totem->value,
+    ]);
+
+    $this->postJson("/api/{$entity->slug}/geral/ticket", ['priority' => 0], pegafilaBearer($token))
+        ->assertCreated()
+        ->assertJsonPath('slug', 'A002');
+});
+
+it('rejects priorities outside the backend-owned values without creating a ticket', function (array $body) {
+    ['entity' => $entity, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Geral', 'slug' => 'geral'],
+    ]);
+
+    $this->postJson("/api/{$entity->slug}/geral/ticket", $body, pegafilaBearer($token))
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+})->with([
+    'missing' => [[]],
+    'negative' => [['priority' => -1]],
+    'unknown' => [['priority' => 15]],
+    'string' => [['priority' => '10']],
+    'float' => [['priority' => 10.5]],
+    'null' => [['priority' => null]],
+]);
+
+it('rejects tickets in an inactive or out-of-scope queue', function () {
+    ['entity' => $entity, 'preset' => $preset, 'queues' => $queues, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Inativa', 'slug' => 'inativa', 'is_active' => false],
+        ['name' => 'Geral', 'slug' => 'geral'],
+    ]);
+
+    $this->postJson("/api/{$entity->slug}/inativa/ticket", ['priority' => 0], pegafilaBearer($token))
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+
+    $preset->queues()->detach($queues[1]->id);
+
+    $this->postJson("/api/{$entity->slug}/geral/ticket", ['priority' => 0], pegafilaBearer($token))
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+
+    $this->postJson("/api/{$entity->slug}/missing/ticket", ['priority' => 0], pegafilaBearer($token))
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('rate limits ticket issuance', function () {
+    ['entity' => $entity, 'token' => $token] = pegafilaTotemFixture([
+        ['name' => 'Geral', 'slug' => 'geral'],
+    ]);
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson("/api/{$entity->slug}/geral/ticket", ['priority' => 0], pegafilaBearer($token))
+            ->assertCreated();
+    }
+
+    $this->postJson("/api/{$entity->slug}/geral/ticket", ['priority' => 0], pegafilaBearer($token))
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
diff --git a/tests/Feature/TotemCorsTest.php b/tests/Feature/TotemCorsTest.php
new file mode 100644
index 0000000..bb91323
--- /dev/null
+++ b/tests/Feature/TotemCorsTest.php
@@ -0,0 +1,67 @@
+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('answers CORS preflight from a local totem web origin', function () {
+    $response = $this->call('OPTIONS', '/api/totem/auth', server: [
+        'HTTP_ORIGIN' => 'http://localhost:8081',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    $response->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+
+    expect($response->headers->get('Access-Control-Allow-Credentials'))->toBeNull();
+});
+
+it('allows localhost and loopback origins with or without ports', function (string $origin) {
+    $this->call('OPTIONS', '/api/totem/auth', server: ['HTTP_ORIGIN' => $origin])
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', $origin);
+})->with([
+    'https://localhost',
+    'http://localhost:3000',
+    'https://127.0.0.1',
+    'http://127.0.0.1:8081',
+]);
+
+it('adds CORS headers to actual API responses', function () {
+    $this->getJson('/api/example/queues', ['Origin' => 'http://localhost:8081'])
+        ->assertStatus(401)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+});
+
+it('does not allow unknown origins', function () {
+    $response = $this->call('OPTIONS', '/api/totem/auth', server: [
+        'HTTP_ORIGIN' => 'https://evil.example',
+    ]);
+
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+
+    $actual = $this->getJson('/api/example/queues', ['Origin' => 'https://evil.example']);
+    expect($actual->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+});
+
+it('allows the optional configured web origin', function () {
+    config(['services.totem.web_origin' => 'https://totem.example.com']);
+
+    $this->call('OPTIONS', '/api/totem/auth', server: [
+        'HTTP_ORIGIN' => 'https://totem.example.com',
+    ])
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem.example.com');
+});
+
+it('keeps CORS headers on rate limited API responses', function () {
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'], ['Origin' => 'http://localhost:8081'])
+            ->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'], ['Origin' => 'http://localhost:8081'])
+        ->assertStatus(429)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+});
diff --git a/tests/Feature/TotemPairingTest.php b/tests/Feature/TotemPairingTest.php
new file mode 100644
index 0000000..e58d34f
--- /dev/null
+++ b/tests/Feature/TotemPairingTest.php
@@ -0,0 +1,152 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+
+uses(RefreshDatabase::class);
+
+it('opens a ten minute pairing window with a random six digit code', function () {
+    Event::fake([MessageLogged::class]);
+
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '111111',
+        'login_code_consumed_at' => now(),
+    ]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+        ->assertSuccessful();
+
+    $preset->refresh();
+
+    expect($preset->login_code)->toMatch('/^[0-9]{6}$/')
+        ->and($preset->login_code_expires_at->between(now()->addMinutes(9), now()->addMinutes(11)))->toBeTrue()
+        ->and($preset->login_code_consumed_at)->toBeNull();
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($preset) {
+        return $log->message === 'totem.pairing_code.generated'
+            && $log->context['preset_id'] === $preset->id
+            && ! str_contains(json_encode($log->context), $preset->login_code);
+    });
+});
+
+it('replaces the previous code when a new pairing window is opened', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '000000']);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+        ->assertSuccessful();
+
+    expect($preset->fresh()->login_code)->not->toBe('000000');
+});
+
+it('fails for an unknown preset', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 999999])
+        ->assertFailed();
+});
+
+it('issues a bearer token scoped to the preset and its queues on pairing', function () {
+    Event::fake([MessageLogged::class]);
+
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $preset->entity->slug)
+        ->assertJsonPath('entity.name', $preset->entity->name);
+
+    $claims = app(TotemJwt::class)->decode($response->json('token'));
+
+    expect($claims)->not->toBeNull()
+        ->and($claims['totem_id'])->toBeInt()
+        ->and($claims['entity_id'])->toBe($preset->entity_id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['queues'])->toBe([$queue->id])
+        ->and($claims['exp'] - $claims['iat'])->toBe(3600)
+        ->and($claims['jti'])->toBeString();
+
+    $this->assertDatabaseHas('totems', [
+        'id' => $claims['totem_id'],
+        'entity_id' => $preset->entity_id,
+        'is_active' => true,
+    ]);
+
+    expect(TotemPreset::find($preset->id)->login_code_consumed_at)->not->toBeNull();
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($preset) {
+        return $log->message === 'totem.pairing.succeeded'
+            && $log->context['preset_id'] === $preset->id
+            && ! str_contains(json_encode($log->context), $preset->login_code);
+    });
+});
+
+it('rejects malformed pairing codes', function (string $code) {
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with(['', '12345', '1234567', 'abcdef', '12345a', ' 123456']);
+
+it('answers the same 401 for every unusable pairing code', function (array $state) {
+    $preset = TotemPreset::factory()->create($state);
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with([
+    'expired' => [['login_code_expires_at' => now()->subMinute()]],
+    'consumed' => [['login_code_consumed_at' => now()]],
+    'inactive' => [['is_active' => false]],
+]);
+
+it('answers the same 401 for an unknown pairing code', function () {
+    $this->postJson('/api/totem/auth', ['code' => '999999'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('consumes a pairing code only once', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('rate limits pairing attempts', function () {
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('never writes the pairing code to the audit log on failure', function () {
+    Event::fake([MessageLogged::class]);
+
+    $this->postJson('/api/totem/auth', ['code' => '424242'])
+        ->assertStatus(401);
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) {
+        return $log->message === 'totem.pairing.failed'
+            && ! str_contains(json_encode($log->context), '424242');
+    });
+});
