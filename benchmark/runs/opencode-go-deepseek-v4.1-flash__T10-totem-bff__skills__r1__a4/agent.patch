+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Totem\TicketPriority;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemTicketController extends TotemApiController
+{
+    public function store(Request $request, string $entitySlug, string $queue, IssueTicket $issueTicket): JsonResponse
+    {
+        if ($this->entityMismatch($request)) {
+            return $this->error('forbidden', 403);
+        }
+
+        $queue = $this->resolveQueue($request, $queue);
+
+        if ($queue instanceof JsonResponse) {
+            return $queue;
+        }
+
+        if (! $queue->is_active) {
+            return $this->error('inactive_queue', 422);
+        }
+
+        $priorityValue = $request->input('priority');
+
+        if (! TicketPriority::isValid($priorityValue)) {
+            return $this->error('invalid_priority', 422);
+        }
+
+        $priority = TicketPriority::find($priorityValue);
+
+        try {
+            $ticket = $issueTicket($queue, $priorityValue, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return $this->error('inactive_queue', 422);
+        }
+
+        Log::channel('audit')->info('totem.ticket.issued', [
+            'entity_id' => $queue->entity_id,
+            'queue_id' => $queue->id,
+            'ticket_id' => $ticket->id,
+            'priority' => $priorityValue,
+        ]);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priority' => ['value' => $priority['value'], 'label' => $priority['label']],
+            'issued_at' => $ticket->issued_at->toIso8601ZuluString(),
+        ], 201);
+    }
+}
