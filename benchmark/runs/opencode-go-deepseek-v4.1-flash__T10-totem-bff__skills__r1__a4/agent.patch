+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('builds a ready-to-use preset from the factory', function () {
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->entity)->toBeInstanceOf(Entity::class)
+        ->and($preset->login_code)->toMatch('/^[0-9]{6}$/')
+        ->and($preset->login_code_expires_at)->not->toBeNull()
+        ->and($preset->login_code_expires_at->isFuture())->toBeTrue()
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->is_active)->toBeTrue();
+});
+
+it('attaches and detaches preset queues through the pivot', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    $preset->queues()->attach($queue);
+
+    expect($preset->fresh()->queues)->toHaveCount(1)
+        ->and($preset->fresh()->queues->first()->is($queue))->toBeTrue();
+
+    $preset->queues()->detach($queue);
+
+    expect($preset->fresh()->queues)->toHaveCount(0);
+});
+
+it('exposes totems and presets from an entity', function () {
+    $entity = Entity::factory()->create();
+    $totem = Totem::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    expect($entity->totems()->pluck('id')->all())->toBe([$totem->id])
+        ->and($entity->totemPresets()->pluck('id')->all())->toBe([$preset->id]);
+});
+
+it('configures the totem JWT secret and TTL', function () {
+    $secret = config('services.totem.jwt_secret');
+
+    expect($secret)->toBeString()
+        ->and(strlen((string) $secret))->toBeGreaterThanOrEqual(32)
+        ->and(config('services.totem.jwt_ttl'))->toBe(3600);
+});
