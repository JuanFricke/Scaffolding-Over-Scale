+<?php
+
+namespace App\Actions;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Support\Facades\DB;
+
+class PairTotem
+{
+    /**
+     * Consume a pairing code and register a new totem device.
+     *
+     * Returns null for every failure mode so callers answer the same 401 and
+     * do not reveal whether a code exists, expired, was consumed or belongs
+     * to an inactive preset.
+     *
+     * @return array{totem: Totem, preset: TotemPreset}|null
+     */
+    public function __invoke(string $code): ?array
+    {
+        return DB::transaction(function () use ($code): ?array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null
+                || ! $preset->is_active
+                || $preset->login_code_consumed_at !== null
+                || $preset->login_code_expires_at === null
+                || ! $preset->login_code_expires_at->isFuture()) {
+                return null;
+            }
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $preset->login_code_consumed_at = now();
+            $preset->save();
+
+            return ['totem' => $totem, 'preset' => $preset];
+        });
+    }
+}
