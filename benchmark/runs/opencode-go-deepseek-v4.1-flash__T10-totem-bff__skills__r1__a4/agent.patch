@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Totem\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends TotemApiController
+{
+    public function store(Request $request, PairTotem $pairTotem, TotemJwt $jwt): JsonResponse
+    {
+        $code = $this->pairingCode($request->input('code'));
+
+        if ($code === null) {
+            $this->auditFailure('invalid_code_format');
+
+            return $this->error('invalid_code_format', 400);
+        }
+
+        $paired = $pairTotem($code);
+
+        if ($paired === null) {
+            $this->auditFailure('invalid_pairing_code');
+
+            return $this->error('invalid_pairing_code', 401);
+        }
+
+        ['totem' => $totem, 'preset' => $preset] = $paired;
+
+        $queueIds = $preset->queues()
+            ->pluck('queues.id')
+            ->map(fn (mixed $id): int => (int) $id)
+            ->all();
+
+        $token = $jwt->issue($totem, $preset, $queueIds);
+        $entity = $preset->entity;
+
+        Log::channel('audit')->info('totem.pairing.succeeded', [
+            'totem_id' => $totem->id,
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'ip' => $request->ip(),
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => $jwt->ttl(),
+            'entity' => [
+                'slug' => $entity->slug,
+                'name' => $entity->name,
+            ],
+        ]);
+    }
+
+    private function pairingCode(mixed $value): ?string
+    {
+        if (is_int($value)) {
+            $value = (string) $value;
+        }
+
+        if (! is_string($value) || preg_match('/^[0-9]{6}$/', $value) !== 1) {
+            return null;
+        }
+
+        return $value;
+    }
+
+    private function auditFailure(string $reason): void
+    {
+        // Never include the submitted code: it is a short-lived credential.
+        Log::channel('audit')->warning('totem.pairing.failed', [
+            'reason' => $reason,
+            'ip' => request()->ip(),
+        ]);
+    }
+}
