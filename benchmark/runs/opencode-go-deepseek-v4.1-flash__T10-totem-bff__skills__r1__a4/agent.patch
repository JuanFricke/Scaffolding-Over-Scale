+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController extends TotemApiController
+{
+    private const array COLORS = ['#0055FF', '#2E7D32', '#C62828', '#6A1B9A', '#EF6C00', '#00838F'];
+
+    private const array ICONS = ['ticket', 'users', 'person', 'flag', 'star', 'clock'];
+
+    public function index(Request $request): JsonResponse
+    {
+        if ($this->entityMismatch($request)) {
+            return $this->error('forbidden', 403);
+        }
+
+        $entity = $this->entity($request);
+
+        $queues = $entity->queues()
+            ->whereIn('id', $request->attributes->get('totem_queue_ids', []))
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->values()
+            ->map(fn (Queue $queue, int $index): array => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => $this->description($queue),
+                'visual' => [
+                    'color' => self::COLORS[$index % count(self::COLORS)],
+                    'icon' => self::ICONS[$index % count(self::ICONS)],
+                    'order' => $index + 1,
+                ],
+                'is_active' => true,
+            ]);
+
+        return response()->json([
+            'entity' => [
+                'slug' => $entity->slug,
+                'name' => $entity->name,
+            ],
+            'queues' => $queues,
+        ]);
+    }
+
+    private function description(Queue $queue): string
+    {
+        $description = $queue->labels_i18n['description'] ?? '';
+
+        return is_string($description) ? $description : '';
+    }
+}
