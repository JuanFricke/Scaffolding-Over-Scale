new file mode 100644
index 0000000..fa5bbad
--- /dev/null
+++ b/app/Policies/EntityInvitePolicy.php
@@ -0,0 +1,45 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityInvite;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Str;
+
+class EntityInvitePolicy
+{
+    /**
+     * Only managers (owner/admin) of the entity may invite or cancel.
+     */
+    public function invite(User $user, EntityInvite $invite): bool
+    {
+        return $this->isManagerOf($user, $invite->entity_id);
+    }
+
+    public function delete(User $user, EntityInvite $invite): bool
+    {
+        return $this->isManagerOf($user, $invite->entity_id);
+    }
+
+    /**
+     * Only the user whose email matches (case-insensitive) may accept/decline.
+     */
+    public function accept(User $user, EntityInvite $invite): bool
+    {
+        return Str::lower(trim($user->email)) === Str::lower(trim($invite->email));
+    }
+
+    public function decline(User $user, EntityInvite $invite): bool
+    {
+        return $this->accept($user, $invite);
+    }
+
+    protected function isManagerOf(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
