--- /dev/null
+++ b/app/Livewire/Entity/PendingInvites.php
@@ -0,0 +1,86 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class PendingInvites extends Component
+{
+    public bool $embedded = false;
+
+    public function accept($inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorize('accept', $invite);
+
+        if ($invite->accepted_at !== null) {
+            return;
+        }
+
+        if ($invite->isExpired()) {
+            $this->addError('invite', __('ui.invites_expired'));
+
+            return;
+        }
+
+        DB::transaction(function () use ($invite) {
+            EntityMembership::firstOrCreate(
+                ['entity_id' => $invite->entity_id, 'user_id' => auth()->id()],
+                ['role' => $invite->role->value]
+            );
+
+            $invite->update(['accepted_at' => now()]);
+        });
+
+        Log::channel('audit')->info('Entity invite accepted', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+
+        session(['current_entity_id' => $invite->entity_id]);
+
+        $this->redirect(route('entity.dashboard', $invite->entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorize('decline', $invite);
+
+        Log::channel('audit')->info('Entity invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+
+        $invite->delete();
+    }
+
+    public function render(): View
+    {
+        $email = auth()->user()->email ?? null;
+        $email = $email ? Str::lower(trim($email)) : null;
+
+        return view('livewire.entity.pending-invites', [
+            'invites' => $email
+                ? EntityInvite::with('entity')
+                    ->where('email', $email)
+                    ->whereNull('accepted_at')
+                    ->where('expires_at', '>', now())
+                    ->latest('id')
+                    ->get()
+                : collect(),
+        ]);
+    }
+}
