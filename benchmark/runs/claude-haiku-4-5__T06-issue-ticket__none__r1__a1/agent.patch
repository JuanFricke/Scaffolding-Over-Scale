+++ b/database/factories/TicketFactory.php
@@ -0,0 +1,76 @@
+<?php
+
+namespace Database\Factories;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<Ticket>
+ */
+class TicketFactory extends Factory
+{
+    private static array $queueCodeCounts = [];
+
+    /**
+     * Define the model's default state.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        $queue = Queue::factory();
+
+        return [
+            'queue_id' => $queue,
+            'code' => '',
+            'priority' => 0,
+            'channel' => TicketChannel::Virtual,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+            'called_at' => null,
+            'called_by_user_id' => null,
+        ];
+    }
+
+    /**
+     * Configure the factory to generate a code for the ticket.
+     */
+    public function configure(): static
+    {
+        return $this->afterMaking(function (Ticket $ticket) {
+            if (empty($ticket->code)) {
+                $ticket->code = Ticket::nextCode($ticket->queue_id);
+            }
+        });
+    }
+
+    /**
+     * Generate tickets for a specific queue.
+     */
+    public function forQueue(Queue $queue): static
+    {
+        return $this->state([
+            'queue_id' => $queue->id,
+        ])->afterMaking(function (Ticket $ticket) {
+            if (empty($ticket->code)) {
+                $ticket->code = Ticket::nextCode($ticket->queue_id);
+            }
+        });
+    }
+
+    /**
+     * Allow passing an explicit code (e.g. for testing malformed codes).
+     */
+    public function withCode(string $code): static
+    {
+        return $this->state([
+            'code' => $code,
+        ])->afterMaking(function (Ticket $ticket) {
+            // Keep the explicit code
+        });
+    }
+}
