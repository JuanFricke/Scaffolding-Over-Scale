@@ -0,0 +1,111 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Get the next display code for the given queue.
+     *
+     * Format: A<digits>, e.g. A001, A002, ..., A999, A1000, A1001.
+     * Skips malformed codes (not matching A<digits>).
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $tickets = self::where('queue_id', $queueId)
+            ->orderBy('id')
+            ->pluck('code')
+            ->all();
+
+        $maxNum = 0;
+        foreach ($tickets as $code) {
+            if (preg_match('/^A(\d+)$/', $code, $matches)) {
+                $num = (int) $matches[1];
+                if ($num > $maxNum) {
+                    $maxNum = $num;
+                }
+            }
+        }
+
+        $nextNum = $maxNum + 1;
+        $padding = max(3, strlen((string) $maxNum));
+        return sprintf('A%0' . $padding . 'd', $nextNum);
+    }
+
+    /**
+     * Call this ticket (mark as called, record caller and timestamp).
+     *
+     * @throws \LogicException if ticket is not waiting
+     * @throws \Illuminate\Auth\Access\AuthorizationException if user is not entity member
+     */
+    public function call(User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new \LogicException('Ticket is not in waiting status.');
+        }
+
+        $queue = $this->queue;
+        $entity = $queue->entity;
+
+        if (! $user->membershipFor($entity->id)) {
+            throw new \Illuminate\Auth\Access\AuthorizationException('User is not a member of the ticket\'s entity.');
+        }
+
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->status = TicketStatus::Called;
+        $this->save();
+    }
+
+    protected static function booting(): void
+    {
+        parent::booting();
+
+        static::saving(function (self $model) {
+            if ($model->isDirty()) {
+                $original = $model->getOriginal();
+
+                if (! empty($original)) {
+                    $immutableFields = ['code', 'priority', 'channel', 'issued_at'];
+
+                    foreach ($immutableFields as $field) {
+                        if ($model->isDirty($field) && isset($original[$field])) {
+                            throw new \LogicException("Ticket field '{$field}' is immutable after issuance.");
+                        }
+                    }
+                }
+            }
+        });
+    }
+}
