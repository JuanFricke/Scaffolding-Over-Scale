+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Priority must be >= 0.');
+        }
+
+        $ticket = null;
+        $maxRetries = 5;
+        $attempt = 0;
+
+        while ($attempt < $maxRetries) {
+            $attempt++;
+
+            $queue = Queue::lockForUpdate()->findOrFail($queue->id);
+
+            if (! $queue->is_active) {
+                throw new InactiveQueueException('Cannot issue ticket to an inactive queue.');
+            }
+
+            $code = Ticket::nextCode($queue->id);
+
+            try {
+                $ticket = Ticket::create([
+                    'queue_id' => $queue->id,
+                    'code' => $code,
+                    'priority' => $priority,
+                    'channel' => $channel,
+                    'status' => TicketStatus::Waiting,
+                    'issued_at' => now(),
+                ]);
+
+                break;
+            } catch (\Illuminate\Database\QueryException $e) {
+                if ($e->getCode() === '23000' && $attempt < $maxRetries) {
+                    continue;
+                }
+
+                throw $e;
+            }
+        }
+
+        if (! $ticket) {
+            throw new \RuntimeException('Failed to issue ticket after maximum retries.');
+        }
+
+        return $ticket;
+    }
+}
