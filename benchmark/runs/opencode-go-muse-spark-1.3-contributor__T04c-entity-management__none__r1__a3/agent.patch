@@ -0,0 +1,134 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public $name = '';
+
+    public $slug = '';
+
+    public $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    protected function currentEntity(): Entity
+    {
+        return Entity::findOrFail($this->entity->id);
+    }
+
+    public function save(): void
+    {
+        $entity = $this->currentEntity();
+
+        $this->authorize('manageSettings', $entity);
+
+        $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => ['required', 'string', 'max:255', 'unique:entities,slug,'.$entity->id],
+        ]);
+
+        $entity->name = $this->name;
+        $entity->slug = $this->slug;
+        $entity->save();
+
+        $this->entity = $entity->fresh();
+    }
+
+    public function delete(): void
+    {
+        $entity = $this->currentEntity();
+
+        $this->authorize('manageSettings', $entity);
+
+        $entity->memberships()->delete();
+        $entity->delete();
+
+        if ((int) session('current_entity_id') === (int) $entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirect(route('home'));
+    }
+
+    public function transfer(): void
+    {
+        $entity = $this->currentEntity();
+
+        $this->authorize('manageSettings', $entity);
+
+        $owner = EntityMembership::where('entity_id', $entity->id)
+            ->where('role', UserRole::Owner->value)
+            ->first();
+
+        if ($owner === null) {
+            abort(403);
+        }
+
+        if ($owner->user_id !== auth()->id()) {
+            abort(403);
+        }
+
+        $target = EntityMembership::where('entity_id', $entity->id)
+            ->where('id', $this->targetMembershipId)
+            ->first();
+
+        if ($target === null) {
+            abort(403);
+        }
+
+        if ($target->role !== UserRole::Admin) {
+            abort(403);
+        }
+
+        if ($target->id === $owner->id || $target->user_id === auth()->id()) {
+            abort(403);
+        }
+
+        DB::transaction(function () use ($owner, $target) {
+            $owner->role = UserRole::Admin;
+            $owner->save();
+
+            $target->role = UserRole::Owner;
+            $target->save();
+        });
+
+        $this->redirect(route('entity.dashboard', $entity->fresh()));
+    }
+
+    public function render(): View
+    {
+        $entity = $this->currentEntity();
+
+        $admins = EntityMembership::where('entity_id', $entity->id)
+            ->where('role', UserRole::Admin->value)
+            ->with('user')
+            ->orderBy('id')
+            ->get();
+
+        return view('livewire.entity.settings', [
+            'entity' => $entity,
+            'admins' => $admins,
+        ]);
+    }
+}
