+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $entity = Entity::findOrFail($this->entity->id);
+
+        $this->authorize('update', $entity);
+
+        $this->validate([
+            'email' => ['required', 'email', 'exists:users,email'],
+        ]);
+
+        $user = User::where('email', $this->email)->first();
+
+        if ($user === null) {
+            throw ValidationException::withMessages([
+                'email' => __('validation.exists', ['attribute' => 'email']),
+            ]);
+        }
+
+        $alreadyMember = EntityMembership::where('entity_id', $entity->id)
+            ->where('user_id', $user->id)
+            ->exists();
+
+        if ($alreadyMember) {
+            throw ValidationException::withMessages([
+                'email' => __('validation.unique', ['attribute' => 'email']),
+            ]);
+        }
+
+        EntityMembership::create([
+            'entity_id' => $entity->id,
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->reset('email');
+    }
+
+    public function assignRole($membershipId, string $role): void
+    {
+        $entity = Entity::findOrFail($this->entity->id);
+
+        $membership = EntityMembership::where('entity_id', $entity->id)
+            ->findOrFail($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        $allowed = array_map(fn (UserRole $r) => $r->value, UserRole::manageable());
+
+        if (! in_array($role, $allowed, true)) {
+            throw ValidationException::withMessages([
+                'role' => __('validation.in', ['attribute' => 'role']),
+            ]);
+        }
+
+        if ($membership->role === UserRole::Owner) {
+            abort(403);
+        }
+
+        $membership->role = UserRole::from($role);
+        $membership->save();
+    }
+
+    public function removeMember($membershipId): void
+    {
+        $entity = Entity::findOrFail($this->entity->id);
+
+        $membership = EntityMembership::where('entity_id', $entity->id)
+            ->findOrFail($membershipId);
+
+        if ($membership->role === UserRole::Owner) {
+            abort(403);
+        }
+
+        $this->authorize('delete', $membership);
+
+        $isManager = in_array($membership->role->value, [UserRole::Owner->value, UserRole::Admin->value], true);
+
+        if ($isManager) {
+            $managerCount = EntityMembership::where('entity_id', $entity->id)
+                ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+                ->count();
+
+            if ($managerCount <= 1) {
+                abort(403);
+            }
+        }
+
+        $membership->delete();
+    }
+
+    public function render(): View
+    {
+        $entity = Entity::findOrFail($this->entity->id);
+
+        $memberships = EntityMembership::where('entity_id', $entity->id)
+            ->with('user')
+            ->orderBy('id')
+            ->get();
+
+        return view('livewire.entity.members', [
+            'entity' => $entity,
+            'memberships' => $memberships,
+        ]);
+    }
+}
