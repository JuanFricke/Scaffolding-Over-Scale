+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    public function accept($inviteId)
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $userEmail = strtolower(trim((string) auth()->user()->email));
+
+        abort_unless(strtolower(trim((string) $invite->email)) === $userEmail, 403);
+
+        if ($invite->accepted_at !== null) {
+            return;
+        }
+
+        if ($invite->expires_at !== null && $invite->expires_at->isPast()) {
+            $this->addError('invite', __('This invite has expired.'));
+
+            return;
+        }
+
+        $exists = EntityMembership::where('entity_id', $invite->entity_id)
+            ->where('user_id', auth()->id())
+            ->exists();
+
+        if (! $exists) {
+            EntityMembership::create([
+                'entity_id' => $invite->entity_id,
+                'user_id' => auth()->id(),
+                'role' => $invite->role instanceof UserRole
+                    ? $invite->role->value
+                    : (string) $invite->role,
+            ]);
+        }
+
+        $invite->update(['accepted_at' => now()]);
+
+        session(['current_entity_id' => $invite->entity_id]);
+
+        $this->redirect(route('entity.dashboard', $invite->entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $userEmail = strtolower(trim((string) auth()->user()->email));
+
+        abort_unless(strtolower(trim((string) $invite->email)) === $userEmail, 403);
+
+        $invite->delete();
+    }
+
+    public function render(): View
+    {
+        $email = auth()->check() ? strtolower(trim((string) auth()->user()->email)) : '';
+
+        $invites = $email !== ''
+            ? EntityInvite::with('entity')
+                ->whereRaw('LOWER(email) = ?', [$email])
+                ->whereNull('accepted_at')
+                ->where('expires_at', '>', now())
+                ->latest('id')
+                ->get()
+            : collect();
+
+        return view('livewire.entity.pending-invites', [
+            'invites' => $invites,
+        ]);
+    }
+}
