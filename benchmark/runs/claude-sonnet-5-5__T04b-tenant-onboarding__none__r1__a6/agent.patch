+<?php
+
+namespace App\Tenancy;
+
+use App\Models\Entity;
+
+/**
+ * The entity the current request works in. Filled by the `current_entity` middleware
+ * (the only reader of the session); everything below the HTTP layer reads it from here.
+ */
+class TenantContext
+{
+    private ?Entity $entity = null;
+
+    public function set(?Entity $entity): void
+    {
+        $this->entity = $entity;
+    }
+
+    public function entity(): ?Entity
+    {
+        return $this->entity;
+    }
+
+    public function id(): ?int
+    {
+        return $this->entity?->id;
+    }
+}
