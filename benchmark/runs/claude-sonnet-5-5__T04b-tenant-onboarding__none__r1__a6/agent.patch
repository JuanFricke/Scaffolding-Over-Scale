+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use App\Tenancy\EntityLanding;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+
+class HomeController extends Controller
+{
+    public function __invoke(Request $request, EntityLanding $landing): RedirectResponse
+    {
+        $user = $request->user();
+
+        // Keep working in the entity already picked, as long as the user still belongs to it.
+        $sessionId = $request->session()->get(EntityLanding::SESSION_KEY);
+
+        if ($sessionId !== null && $user->entities()->whereKey((int) $sessionId)->exists()) {
+            return redirect()->route('entity.dashboard', Entity::findOrFail((int) $sessionId));
+        }
+
+        $target = $landing->resolve($user);
+
+        return $target instanceof Entity
+            ? redirect()->route('entity.dashboard', $target)
+            : $target;
+    }
+}
