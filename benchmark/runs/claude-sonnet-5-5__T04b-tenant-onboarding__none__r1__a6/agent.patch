+test('onboarding creates the entity with the user as its only owner', function () {
+    $user = User::factory()->create();
+
+    Log::shouldReceive('channel')->with('audit')->once()->andReturnSelf();
+    Log::shouldReceive('info')->once()->withArgs(fn ($m, $c) => $m === 'Entity created'
+        && $c['actor_id'] === $user->id && isset($c['entity_id']));
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', ['entity' => 'acme-corp']));
+
+    $entity = Entity::firstWhere('slug', 'acme-corp');
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->owner->user_id)->toBe($user->id)
+        ->and($entity->memberships)->toHaveCount(1)
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
