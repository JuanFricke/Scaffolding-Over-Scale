diff --git a/tests/Feature/EntityTest.php b/tests/Feature/EntityTest.php
new file mode 100644
index 0000000..377593e
--- /dev/null
+++ b/tests/Feature/EntityTest.php
@@ -0,0 +1,339 @@
+<?php
+
+use App\Livewire\Entity\CreateEntity;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function memberOf(User $user, UserRole $role = UserRole::Employee, array $entity = []): Entity
+{
+    $entity = Entity::factory()->create($entity);
+    EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $user->id, 'role' => $role]);
+
+    return $entity;
+}
+
+// --- data model -----------------------------------------------------------
+
+test('the database rejects a second owner but allows many admins and employees', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->count(2)->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(2)->create(['entity_id' => $entity->id]);
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]))
+        ->toThrow(QueryException::class);
+
+    // Another entity may have its own owner.
+    EntityMembership::factory()->owner()->create();
+    expect(EntityMembership::owner()->count())->toBe(2);
+});
+
+test('a user can join an entity only once', function () {
+    $m = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create(['entity_id' => $m->entity_id, 'user_id' => $m->user_id]))
+        ->toThrow(QueryException::class);
+});
+
+test('slugs are unique, memberships default to employee and relations work', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))->toThrow(QueryException::class);
+
+    $user = User::factory()->create();
+    $membership = EntityMembership::create(['entity_id' => $entity->id, 'user_id' => $user->id]);
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+
+    expect($membership->fresh()->role)->toBe(UserRole::Employee)
+        ->and($entity->owner->is($owner))->toBeTrue()
+        ->and($entity->users)->toHaveCount(2)
+        ->and($user->entities->first()->is($entity))->toBeTrue()
+        ->and($user->membershipFor($entity->id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor(0))->toBeNull()
+        ->and(EntityMembership::employee()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(0)
+        ->and($entity->getRouteKeyName())->toBe('slug')
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+// --- policies -------------------------------------------------------------
+
+test('entity policy', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+    $as = fn (?UserRole $role) => tap(User::factory()->create(), fn ($u) => $role && EntityMembership::factory()
+        ->create(['entity_id' => $entity->id, 'user_id' => $u->id, 'role' => $role]));
+
+    [$owner, $admin, $employee, $stranger] = [$as(UserRole::Owner), $as(UserRole::Admin), $as(UserRole::Employee), $as(null)];
+
+    expect($policy->create($stranger))->toBeTrue()
+        ->and([$owner, $admin, $employee, $stranger])->each->toBeInstanceOf(User::class);
+
+    foreach (['view' => [true, true, true, false], 'update' => [true, true, false, false],
+        'delete' => [true, true, false, false], 'manageSettings' => [true, false, false, false]] as $ability => $expected) {
+        foreach ([$owner, $admin, $employee, $stranger] as $i => $user) {
+            expect($policy->{$ability}($user, $entity))->toBe($expected[$i], "$ability #$i");
+        }
+    }
+});
+
+test('membership policy', function () {
+    $entity = Entity::factory()->create();
+    $policy = new EntityMembershipPolicy;
+    $make = fn (UserRole $role) => EntityMembership::factory()->create(['entity_id' => $entity->id, 'role' => $role]);
+
+    $owner = $make(UserRole::Owner);
+    $admin = $make(UserRole::Admin);
+    $employee = $make(UserRole::Employee);
+    $other = $make(UserRole::Employee);
+    $stranger = User::factory()->create();
+
+    expect($policy->view($employee->user, $owner))->toBeTrue()
+        ->and($policy->view($stranger, $owner))->toBeFalse()
+        ->and($policy->assignRole($owner->user, $employee))->toBeTrue()
+        ->and($policy->assignRole($admin->user, $employee))->toBeTrue()
+        ->and($policy->assignRole($employee->user, $other))->toBeFalse()
+        ->and($policy->assignRole($stranger, $employee))->toBeFalse()
+        ->and($policy->delete($owner->user, $owner))->toBeFalse()
+        ->and($policy->delete($admin->user, $owner))->toBeFalse()
+        ->and($policy->delete($employee->user, $employee))->toBeTrue()
+        ->and($policy->delete($admin->user, $employee))->toBeTrue()
+        ->and($policy->delete($owner->user, $admin))->toBeTrue()
+        ->and($policy->delete($employee->user, $other))->toBeFalse()
+        ->and($policy->delete($stranger, $other))->toBeFalse();
+});
+
+// --- /home dispatch, middleware, pick ---------------------------------------
+
+test('guests are redirected to login from every entity page', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+    $this->get(route('entity.switcher'))->assertRedirect(route('login'));
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+});
+
+test('unverified users cannot open entity pages', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('onboarding'))->assertRedirect(route('verification.notice'));
+});
+
+test('home sends a user without entities to onboarding', function () {
+    $this->actingAs(User::factory()->create())->get(route('home'))->assertRedirect(route('onboarding'));
+});
+
+test('home sets the session and opens the dashboard for a single entity, any role', function (UserRole $role) {
+    $user = User::factory()->create();
+    $entity = memberOf($user, $role);
+
+    $this->actingAs($user)->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    expect(session('current_entity_id'))->toBe($entity->id);
+})->with([UserRole::Owner, UserRole::Admin, UserRole::Employee]);
+
+test('home sends a user with several entities to the switcher', function () {
+    $user = User::factory()->create();
+    memberOf($user);
+    memberOf($user);
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('entity.switcher'));
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('a deleted entity does not count as a membership', function () {
+    $user = User::factory()->create();
+    memberOf($user)->delete();
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('onboarding'));
+});
+
+test('the dashboard shows the entity name', function () {
+    $user = User::factory()->create();
+    $entity = memberOf($user, UserRole::Owner, ['name' => 'Padaria Central']);
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))
+        ->assertOk()->assertSee('Padaria Central');
+});
+
+test('the dashboard dispatches like home when the session is empty', function () {
+    $user = User::factory()->create();
+    $this->actingAs($user)->get(route('entity.dashboard', Entity::factory()->create()))
+        ->assertRedirect(route('onboarding'));
+
+    $a = memberOf($user);
+    memberOf($user);
+    $this->get(route('entity.dashboard', $a))->assertRedirect(route('entity.switcher'));
+});
+
+test('a non-member gets 403 on the dashboard, even with a session for another entity', function () {
+    $user = User::factory()->create();
+    $mine = memberOf($user);
+    $foreign = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.dashboard', $foreign))->assertForbidden();
+});
+
+test('a session pointing at an entity the user does not belong to is a 403', function () {
