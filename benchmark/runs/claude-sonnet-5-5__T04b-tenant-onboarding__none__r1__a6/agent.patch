+<?php
+
+namespace App\Tenancy;
+
+use App\Models\Entity;
+use App\Models\User;
+use Illuminate\Http\RedirectResponse;
+
+/**
+ * Decides where a user without a usable tenant session goes next:
+ * no entity -> onboarding, one entity -> that entity (session set), several -> switcher.
+ */
+class EntityLanding
+{
+    public const SESSION_KEY = 'current_entity_id';
+
+    public function resolve(User $user): Entity|RedirectResponse
+    {
+        $entities = $user->entities()->orderBy('entities.id')->limit(2)->get();
+
+        if ($entities->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($entities->count() > 1) {
+            return redirect()->route('entity.switcher');
+        }
+
+        $entity = $entities->first();
+        session()->put(self::SESSION_KEY, $entity->id);
+
+        return $entity;
+    }
+}
