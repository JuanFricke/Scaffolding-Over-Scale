+test('onboarding derives unique slugs', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme-corp']);
+    Entity::factory()->create(['slug' => 'acme-corp-2'])->delete();
+    Entity::factory()->create(['slug' => 'switcher']);
+
+    foreach (['Acme Corp', '###', 'Switcher'] as $name) {
+        Livewire::actingAs($user)->test(CreateEntity::class)->set('name', $name)->call('submit');
+    }
+
+    expect(Entity::pluck('slug')->all())->toContain('acme-corp-3', 'entity', 'switcher-2');
+});
