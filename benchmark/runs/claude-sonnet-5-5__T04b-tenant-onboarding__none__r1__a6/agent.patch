index 0000000..026a3d7
--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,101 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use App\Tenancy\EntityLanding;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    private const MAX_ATTEMPTS = 5;
+
+    /** Slugs that would shadow a static route under /e. */
+    private const RESERVED_SLUGS = ['switcher'];
+
+    public string $name = '';
+
+    protected function rules(): array
+    {
+        return [
+            'name' => ['required', 'string', 'max:255'],
+        ];
+    }
+
+    public function submit(): void
+    {
+        $this->validate();
+
+        $user = auth()->user();
+        $name = trim($this->name);
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                $entity = DB::transaction(function () use ($name, $user) {
+                    $entity = Entity::create([
+                        'name' => $name,
+                        'slug' => $this->uniqueSlug($name),
+                    ]);
+
+                    EntityMembership::create([
+                        'entity_id' => $entity->id,
+                        'user_id' => $user->id,
+                        'role' => UserRole::Owner,
+                    ]);
+
+                    return $entity;
+                });
+
+                break;
+            } catch (UniqueConstraintViolationException $e) {
+                // A concurrent request took the slug between the check and the insert.
+                if ($attempt >= self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session()->put(EntityLanding::SESSION_KEY, $entity->id);
+
+        $this->redirectRoute('entity.dashboard', ['entity' => $entity]);
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::limit(Str::slug($name), 200, '');
+        $base = trim($base, '-') ?: 'entity';
+
+        $slug = $base;
+
+        for ($suffix = 2; $this->slugTaken($slug); $suffix++) {
+            $slug = $base.'-'.$suffix;
+        }
+
+        return $slug;
+    }
+
+    private function slugTaken(string $slug): bool
+    {
+        return in_array($slug, self::RESERVED_SLUGS, true)
+            || Entity::withTrashed()->where('slug', $slug)->exists();
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->title(__('ui.onboarding_title'));
+    }
+}
