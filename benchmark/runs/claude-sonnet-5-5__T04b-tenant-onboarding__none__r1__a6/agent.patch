--- /dev/null
+++ b/app/Http/Middleware/EnsureCurrentEntity.php
@@ -0,0 +1,65 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Tenancy\EntityLanding;
+use App\Tenancy\TenantContext;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class EnsureCurrentEntity
+{
+    public function __construct(
+        private readonly TenantContext $tenant,
+        private readonly EntityLanding $landing,
+    ) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        /** @var User $user */
+        $user = $request->user();
+        $session = $request->session();
+
+        $current = null;
+        $sessionId = $session->get(EntityLanding::SESSION_KEY);
+
+        if ($sessionId !== null) {
+            if ($user->membershipFor((int) $sessionId) === null) {
+                abort(403);
+            }
+
+            $current = Entity::find((int) $sessionId);
+
+            // The entity was deleted after being picked: drop the stale session.
+            if ($current === null) {
+                $session->forget(EntityLanding::SESSION_KEY);
+            }
+        }
+
+        if ($current === null) {
+            $landed = $this->landing->resolve($user);
+
+            if (! $landed instanceof Entity) {
+                return $landed;
+            }
+
+            $current = $landed;
+        }
+
+        // A route bound to another entity must belong to the user as well.
+        $routeEntity = $request->route('entity');
+
+        if ($routeEntity instanceof Entity && $routeEntity->isNot($current)) {
+            abort_if($user->membershipFor($routeEntity->id) === null, 403);
+
+            $current = $routeEntity;
+        }
+
+        $this->tenant->set($current);
+
+        return $next($request);
+    }
+}
