+test('onboarding retries when the slug is taken between the check and the insert', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme']);
+
+    $component = new class extends CreateEntity
+    {
+        public int $calls = 0;
+
+        protected function uniqueSlug(string $name): string
+        {
+            return ++$this->calls === 1 ? 'acme' : 'acme-fresh';
+        }
+    };
+
+    Livewire::actingAs($user)->test($component::class)
+        ->set('name', 'Acme')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', ['entity' => 'acme-fresh']));
+
+    expect(Entity::count())->toBe(2)
+        ->and(EntityMembership::count())->toBe(1);
+});
