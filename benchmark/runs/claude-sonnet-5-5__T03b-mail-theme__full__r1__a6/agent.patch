+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+
+function renderedMail(object $notification): array
+{
+    $user = User::factory()->make(['id' => 1]);
+    $message = $notification->toMail($user);
+
+    return [$message, (string) $message->render()];
+}
+
+test('the app speaks pt-BR as PegaFila', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(app()->getLocale())->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('markdown mail uses the pegafila theme', function () {
+    expect(config('mail.markdown.theme'))->toBe('pegafila')
+        ->and(file_exists(resource_path('views/vendor/mail/html/themes/pegafila.css')))->toBeTrue();
+});
+
+test('the reset mail is translated and branded', function () {
+    [$message, $html] = renderedMail(new ResetPassword('token'));
+
+    expect($message->subject)->toBe('Redefina sua senha')
+        ->and($html)->toContain('PegaFila')
+        ->toContain('Olá!')
+        ->toContain('Redefinir senha')
+        ->toContain('Você recebeu esse e-mail')
+        ->toContain('Se você estiver tendo problemas')
+        ->not->toContain('having trouble clicking')
+        ->toContain('#0f7490');
+});
+
+test('the verification mail is translated and branded', function () {
+    [$message, $html] = renderedMail(new VerifyEmail);
+
+    expect($message->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($html)->toContain('Verifique o endereço de e-mail')
+        ->toContain('Olá!')
+        ->not->toContain('having trouble clicking')
+        ->toContain('#0f7490');
+});
diff --git a/tests/Feature/PasswordResetTest.php b/tests/Feature/PasswordResetTest.php
new file mode 100644
index 0000000..8003617
--- /dev/null
+++ b/tests/Feature/PasswordResetTest.php
@@ -0,0 +1,135 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password form renders for guests', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('name="email"', false)
+        ->assertSee('for="email"', false);
+});
+
+test('authenticated users cannot see the password reset pages', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('password.request'))
+        ->assertRedirect();
+});
+
+test('a reset link is sent to an existing user', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown address gets the same response and no mail', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('a throttled broker request does not reveal the user', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email]);
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+});
+
+test('the forgot password email is validated', function (mixed $email) {
+    $this->post(route('password.email'), ['email' => $email])
+        ->assertSessionHasErrors('email');
+})->with([null, 'not-an-email']);
+
+test('the forgot password route is throttled', function () {
+    foreach (range(1, 6) as $i) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertStatus(429);
+});
+
+test('the reset form has a single email input', function () {
+    $this->get(route('password.reset', ['token' => 'abc', 'email' => 'a@example.com']))
+        ->assertOk()
+        ->assertSee('value="abc"', false)
+        ->assertSee('value="a@example.com"', false);
+
+    $html = $this->get(route('password.reset', ['token' => 'abc']))->getContent();
+    expect(substr_count($html, 'name="email"'))->toBe(1);
+});
+
+test('the password is reset with a valid token', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old-token']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPassw0rd',
+        'password_confirmation' => 'NewPassw0rd',
+    ])
+        ->assertRedirect('/')
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NewPassw0rd', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token');
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token does not reset the password', function () {
+    $user = User::factory()->create();
+    $oldHash = $user->password;
+
+    $this->from(route('password.request'))->post(route('password.update'), [
+        'token' => 'wrong',
+        'email' => $user->email,
+        'password' => 'NewPassw0rd',
+        'password_confirmation' => 'NewPassw0rd',
+    ])->assertSessionHasErrors('email');
+
+    expect($user->refresh()->password)->toBe($oldHash);
+});
+
+test('weak passwords are rejected', function (string $password, ?string $confirmation) {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => Password::createToken($user),
+        'email' => $user->email,
+        'password' => $password,
+        'password_confirmation' => $confirmation ?? $password,
+    ])->assertSessionHasErrors('password');
+})->with([
+    'too short' => ['Ab1cdef', null],
+    'no numbers' => ['Abcdefgh', null],
+    'no letters' => ['12345678', null],
+    'no mixed case' => ['abcdefg1', null],
+    'not confirmed' => ['NewPassw0rd', 'Different1A'],
+]);
+
+test('token and email are required to reset', function () {
+    $this->post(route('password.update'), ['password' => 'NewPassw0rd', 'password_confirmation' => 'NewPassw0rd'])
+        ->assertSessionHasErrors(['token', 'email']);
+});
