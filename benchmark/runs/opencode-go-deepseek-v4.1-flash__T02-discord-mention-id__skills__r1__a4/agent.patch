+    /**
+     * Build the validated Discord user mention suffix, or an empty string.
+     */
+    private function mention(): string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (is_int($id)) {
+            $id = (string) $id;
+        }
+
+        if (! is_string($id)) {
+            return '';
+        }
+
+        $id = trim($id);
+
+        if (preg_match('/^[0-9]{17,20}$/', $id) !== 1) {
+            return '';
+        }
+
+        return "\n<@".$id.'>';
+    }
+
     /**
