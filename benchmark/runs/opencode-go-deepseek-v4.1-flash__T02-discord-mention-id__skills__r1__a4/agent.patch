+test('appends a mention when a valid discord user id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '123456789012345678',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n<@123456789012345678>")
+            && substr_count($content, '<@') === 1;
+    });
+});
+
+test('trims surrounding whitespace and accepts an integer user id', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@123456789012345678>"));
+})->with([
+    'padded string' => "  123456789012345678 \t",
+    'integer' => 123456789012345678,
+]);
+
+test('does not add a mention when the setting is missing or empty', function (?string $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '', '   ']);
+
+test('silently ignores invalid mention ids', function (mixed $id) {
