+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use Illuminate\Contracts\Auth\Authenticatable;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Auth;
+use App\Http\Controllers\Controller;
+
+class EntityController extends Controller
+{
+    public function pick(Entity $entity): RedirectResponse
+    {
+        $user = Auth::user();
+        $membership = $user->membershipFor($entity->id);
+        if (!$membership) {
+            abort(403);
+        }
+        session(['current_entity_id' => $entity->id]);
+        Log::channel('audit')->info('Entity picked', [
+            'user_id' => $user->id,
+            'entity_id' => $entity->id,
+        ]);
+        return redirect()->route('entity.dashboard', $entity);
+    }
+}
