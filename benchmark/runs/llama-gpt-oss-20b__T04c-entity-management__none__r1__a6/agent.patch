+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Auth;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+use Livewire\Attributes\Layout;
+
+#[Layout('layouts::app')]
+class Members extends Component
+{
+    public Entity $entity;
+    #[Validate('required|email|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $data = $this->validate();
+        $user = User::where('email', $data['email'])->first();
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            $this->addError('email', __('validation.exists', ['attribute' => 'email']));
+            return;
+        }
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee->value,
+        ]);
+        $this->email = '';
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        $manageable = array_map(fn($r)=>$r->value, UserRole::manageable());
+        if (!in_array($role, $manageable)) {
+            $this->addError('role', __('validation.in', ['attribute' => 'role']));
+            return;
+        }
+        $membership = EntityMembership::findOrFail($membershipId);
+        $this->authorize('assignRole', $membership);
+        $membership->update(['role' => $role]);
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+        $this->authorize('delete', $membership);
+        // Prevent removing owner
+        if ($membership->role === UserRole::Owner->value) {
+            abort(403);
+        }
+        // Prevent removing last manager
+        $managerCount = $this->entity->memberships()->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])->count();
+        if ($managerCount <= 1) {
+            abort(403);
+        }
+        $membership->delete();
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->get(),
+        ]);
+    }
+}
