+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Redirect;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\DB;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+use Livewire\Attributes\Layout;
+
+#[Layout('layouts::app')]
+class Settings extends Component
+{
+    public Entity $entity;
+        public string $name = '';
+        public string $slug = '';
+    public int $targetMembershipId = 0;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        $this->validate([
+            'name' => 'required|string',
+            'slug' => 'required|string|unique:entities,slug,' . $this->entity->id,
+        ]);
+        $this->entity->update([
+            'name' => $this->name,
+            'slug' => $this->slug,
+        ]);
+        return redirect()->route('entity.dashboard', $this->entity);
+    }
+
+    public function delete(): void
+    {
+        $userId = Auth::id();
+        $currentEntityId = session('current_entity_id');
+        $this->entity->delete();
+        $this->entity->memberships()->delete();
+        if ($currentEntityId == $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+        return redirect()->route('home');
+    }
+
+    public function transfer(): void
+    {
+        $target = EntityMembership::findOrFail($this->targetMembershipId);
+        if ($target->entity_id !== $this->entity->id || $target->role !== UserRole::Admin->value) {
+            abort(403);
+        }
+        $currentOwner = $this->entity->memberships()->where('role', UserRole::Owner->value)->first();
+        if (!$currentOwner) {
+            abort(403);
+        }
+        DB::transaction(function () use ($currentOwner, $target) {
+            $currentOwner->update(['role' => UserRole::Admin->value]);
+            $target->update(['role' => UserRole::Owner->value]);
+        });
+        return redirect()->route('entity.dashboard', $this->entity);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'memberships' => $this->entity->memberships()->where('role', UserRole::Admin->value)->get(),
+        ]);
+    }
+}
