+<?php
+
+namespace Database\Factories;
+
+use App\Models\EntityMembership;
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\Factories\Factory;
+use Illuminate\Support\Str;
+
+class EntityMembershipFactory extends Factory
+{
+    protected $model = EntityMembership::class;
+
+    public function definition(): array
+    {
+        return [
+            'role' => UserRole::Employee->value,
+        ];
+    }
+
+    public function configure()
+    {
+        return $this->afterCreating(function (EntityMembership $membership) {
+            if (!$membership->entity_id) {
+                $membership->entity()->associate(Entity::factory()->create());
+            }
+            if (!$membership->user_id) {
+                $membership->user()->associate(User::factory()->create());
+            }
+            $membership->save();
+        });
+    }
+
+    public function owner()
+    {
+        return $this->state(fn () => ['role' => UserRole::Owner->value]);
+    }
+
+    public function admin()
+    {
+        return $this->state(fn () => ['role' => UserRole::Admin->value]);
+    }
+
+    public function employee()
+    {
+        return $this->state(fn () => ['role' => UserRole::Employee->value]);
+    }
+}
