@@ -0,0 +1,64 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+use RuntimeException;
+
+class IssueTicket
+{
+    /**
+     * Issue a ticket for the given queue.
+     *
+     * @throws InactiveQueueException
+     * @throws LogicException
+     * @throws RuntimeException
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new LogicException('Negative priority is not allowed');
+        }
+
+        // retry on unique constraint violation for code
+        $maxAttempts = 3;
+        $attempt = 0;
+        while (true) {
+            $attempt++;
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    // lock the queue row for update to avoid concurrent active status changes
+                    $queueLocked = Queue::where('id', $queue->id)->lockForUpdate()->first();
+                    if (! $queueLocked || ! $queueLocked->is_active) {
+                        throw new InactiveQueueException();
+                    }
+
+                    $code = Ticket::nextCode($queue->id);
+                    $ticket = Ticket::create([
+                        'queue_id' => $queue->id,
+                        'code' => $code,
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                    return $ticket;
+                });
+            } catch (\Illuminate\Database\QueryException $e) {
+                // unique constraint on queue_id+code
+                if ($attempt < $maxAttempts && $e->getCode() === '23000') {
+                    // retry
+                    continue;
+                }
+                throw $e;
+            }
+        }
+    }
+}
