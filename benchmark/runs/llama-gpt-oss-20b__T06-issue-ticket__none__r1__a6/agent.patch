+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\HasMany;
+
+#[Fillable(['entity_id', 'name', 'slug', 'is_active', 'labels_i18n'])]
+class Queue extends Model
+{
+    use HasFactory;
+
+    /**
+     * The attributes that should be cast.
+     */
+    protected function casts(): array
+    {
+        return [
+            'is_active' => 'boolean',
+            'labels_i18n' => 'array',
+        ];
+    }
+
+    /**
+     * Get the owning entity.
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Get the tickets for this queue.
+     */
+    public function tickets(): HasMany
+    {
+        return $this->hasMany(Ticket::class);
+    }
+}
diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..130389a
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,105 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+use RuntimeException;
+use App\Models\User;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * The attributes that should be cast.
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'int',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    /**
+     * Get the owning queue.
+     */
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    /**
+     * The user who called this ticket.
+     */
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Generate the next display code for a queue.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = Ticket::where('queue_id', $queueId)
+            ->where('code', 'like', 'A%')
+            ->orderByDesc('id')
+            ->first();
+
+        if ($last && preg_match('/^A(\d+)$/', $last->code, $matches)) {
+            $next = (int)$matches[1] + 1;
+        } else {
+            $next = 1;
+        }
+
+        $prefix = 'A';
+        return $prefix . ($next < 1000 ? str_pad((string)$next, 3, '0', STR_PAD_LEFT) : (string)$next);
+    }
+
+    /**
+     * Call this ticket.
+     */
+    public function call(User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Ticket already called');
+        }
+
+        $entity = $this->queue->entity;
+        if (!$entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw new \Illuminate\Auth\Access\AuthorizationException('User not member of entity');
+        }
+
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->status = TicketStatus::Called;
+        $this->save();
+    }
+
+    /**
+     * Ensure write-once integrity.
+     */
+    protected static function booted(): void
+    {
+        static::updating(function (self $ticket) {
+            $immutable = ['queue_id', 'code', 'priority', 'channel', 'issued_at'];
+            foreach ($immutable as $attr) {
+                if ($ticket->isDirty($attr)) {
+                    throw new LogicException("Cannot modify {$attr} after issuance");
+                }
+            }
+        });
+    }
+}
