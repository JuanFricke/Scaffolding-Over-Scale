+<?php
+
+namespace App\Policies;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\HandlesAuthorization;
+
+class QueuePolicy
+{
+    use HandlesAuthorization;
+
+    public function create(User $user, array $parameters): bool
+    {
+        [$entity] = $parameters;
+        return $user->memberships()->where('entity_id', $entity->id)
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->exists();
+    }
+
+    public function update(User $user, Queue $queue): bool
+    {
+        return $user->memberships()->where('entity_id', $queue->entity_id)
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->exists();
+    }
+
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->update($user, $queue);
+    }
+
+    public function call(User $user, Queue $queue): bool
+    {
+        // Owner/Admin always allowed
+        if ($user->memberships()->where('entity_id', $queue->entity_id)
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->exists()) {
+            return true;
+        }
+
+        // Find membership id
+        $membershipId = $user->memberships()->where('entity_id', $queue->entity_id)->value('id');
+        if (!$membershipId) {
+            return false;
+        }
+
+        $hasPermission = QueueAccess::where('queue_id', $queue->id)
+            ->where('entity_membership_id', $membershipId)
+            ->where('permissions', 'LIKE', '%"'.QueuePermission::Call->value.'"%')
+            ->exists();
+        return $hasPermission;
+    }
+}
