+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    public function __invoke(Queue $queue, User $actor, ?string $name = null, ?string $slug = null, ?bool $isActive = null): Queue
+    {
+        // Authorization
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $updates = [];
+        if ($name !== null) {
+            $name = trim($name);
+            Validator::make([
+                'name' => $name,
+            ], [
+                'name' => 'required|string|min:1|max:255',
+            ])->validate();
+            $updates['name'] = $name;
+        }
+        if ($slug !== null) {
+            $slug = Str::slug($slug);
+            $updates['slug'] = $slug;
+        }
+        if ($isActive !== null) {
+            $updates['is_active'] = $isActive;
+        }
+
+        if (empty($updates)) {
+            return $queue;
+        }
+
+        try {
+            DB::transaction(function () use ($queue, $updates) {
+                $queue->fill($updates);
+                $queue->save();
+            });
+        } catch (\Illuminate\Database\QueryException $e) {
+            if ($e->errorInfo[1] == 1062) {
+                throw ValidationException::withMessages([
+                    'slug' => ['The slug has already been taken for this entity.'],
+                ]);
+            }
+            throw $e;
+        }
+        return $queue;
+    }
+}
