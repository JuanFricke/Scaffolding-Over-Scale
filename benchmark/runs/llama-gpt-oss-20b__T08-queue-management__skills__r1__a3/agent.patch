@@ -0,0 +1,65 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    public function __invoke(EntityMembership $targetMembership, Queue $queue, User $actor, array $permissions): void
+    {
+        // Authorization: actor must be manager of queue's entity
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        // Validation: membership and queue must belong to same entity
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'membership' => ['Membership and queue must belong to the same entity.'],
+            ]);
+        }
+
+        // Validate permissions array
+        $validPermissions = array_map(fn($p) => (string) $p, $permissions);
+        foreach ($validPermissions as $p) {
+            if (!in_array($p, array_column(QueuePermission::cases(), 'value'), true)) {
+                throw ValidationException::withMessages([
+                    'permissions' => ['Invalid permission: '.$p],
+                ]);
+            }
+        }
+
+        DB::transaction(function () use ($targetMembership, $queue, $validPermissions) {
+            if (empty($validPermissions)) {
+                // Revoke: delete if exists
+                $deleted = QueueAccess::where('entity_membership_id', $targetMembership->id)
+                    ->where('queue_id', $queue->id)
+                    ->delete();
+                if ($deleted) {
+                    Log::channel('audit')->info('queue.access.revoked', [
+                        'actor_id' => auth()->id(),
+                        'queue_id' => $queue->id,
+                        'entity_membership_id' => $targetMembership->id,
+                    ]);
+                }
+            } else {
+                $access = QueueAccess::updateOrCreate(
+                    ['entity_membership_id' => $targetMembership->id, 'queue_id' => $queue->id],
+                    ['permissions' => $validPermissions]
+                );
+                Log::channel('audit')->info('queue.access.granted', [
+                    'actor_id' => auth()->id(),
+                    'queue_id' => $queue->id,
+                    'entity_membership_id' => $targetMembership->id,
+                ]);
+            }
+        });
+    }
+}
