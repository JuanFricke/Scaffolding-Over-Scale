@@ -0,0 +1,54 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\ValidationException;
+use Illuminate\Support\Str;
+
+class CreateQueue
+{
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        // Authorization
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $name = trim($name);
+        Validator::make([
+            'name' => $name,
+        ], [
+            'name' => 'required|string|min:1|max:255',
+        ])->validate();
+
+        if ($slug === null) {
+            $slug = Str::slug($name);
+        } else {
+            $slug = Str::slug($slug);
+        }
+
+        try {
+            return DB::transaction(function () use ($entity, $name, $slug) {
+                return Queue::create([
+                    'entity_id' => $entity->id,
+                    'name' => $name,
+                    'slug' => $slug,
+                    'is_active' => true,
+                ]);
+            });
+        } catch (\Illuminate\Database\QueryException $e) {
+            // Assuming unique constraint violation
+            if ($e->errorInfo[1] == 1062) { // MySQL duplicate
+                throw ValidationException::withMessages([
+                    'slug' => ['The slug has already been taken for this entity.'],
+                ]);
+            }
+            throw $e;
+        }
+    }
+}
