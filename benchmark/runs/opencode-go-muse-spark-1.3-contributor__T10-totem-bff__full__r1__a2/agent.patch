+<?php
+
+namespace App\Models;
+
+use Database\Factories\TotemPresetFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Database\Eloquent\Relations\BelongsToMany;
+
+#[Fillable([
+    'entity_id',
+    'name',
+    'login_code',
+    'login_code_expires_at',
+    'login_code_consumed_at',
+    'appearance',
+    'is_active',
+])]
+class TotemPreset extends Model
+{
+    /** @use HasFactory<TotemPresetFactory> */
+    use HasFactory;
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'login_code_expires_at' => 'datetime',
+            'login_code_consumed_at' => 'datetime',
+            'appearance' => 'array',
+            'is_active' => 'boolean',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Entity, $this>
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Queues this preset may see and issue from.
+     *
+     * @return BelongsToMany<Queue, $this>
+     */
+    public function queues(): BelongsToMany
+    {
+        return $this->belongsToMany(Queue::class, 'totem_preset_queue', 'preset_id', 'queue_id')
+            ->withTimestamps();
+    }
+}
diff --git a/app/Support/TotemJwt.php b/app/Support/TotemJwt.php
new file mode 100644
index 0000000..545884d
--- /dev/null
+++ b/app/Support/TotemJwt.php
@@ -0,0 +1,93 @@
+<?php
+
+namespace App\Support;
+
+use InvalidArgumentException;
+use RuntimeException;
+
+/**
+ * Minimal correct HS256 JWT implementation for totem device tokens.
+ *
+ * Keeps the totem BFF free of an extra JWT dependency: sign/verify is just
+ * base64url + HMAC-SHA256 with constant-time signature comparison.
+ */
+final class TotemJwt
+{
+    /**
+     * Sign claims into a JWT.
+     *
+     * @param  array<string, mixed>  $claims
+     */
+    public static function encode(array $claims, string $secret): string
+    {
+        if ($secret === '') {
+            throw new RuntimeException('Totem JWT secret is not configured.');
+        }
+
+        $header = self::base64UrlEncode((string) json_encode(['alg' => 'HS256', 'typ' => 'JWT']));
+        $payload = self::base64UrlEncode((string) json_encode($claims));
+        $signature = self::base64UrlEncode(hash_hmac('sha256', $header.'.'.$payload, $secret, true));
+
+        return $header.'.'.$payload.'.'.$signature;
+    }
+
+    /**
+     * Verify a JWT and return its claims.
+     *
+     * @return array<string, mixed>
+     *
+     * @throws InvalidArgumentException when the token is malformed, has an
+     *                                  unexpected algorithm, a bad signature,
+     *                                  or is expired.
+     */
+    public static function decode(string $token, string $secret): array
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3 || $parts[0] === '' || $parts[1] === '' || $parts[2] === '') {
+            throw new InvalidArgumentException('Malformed token.');
+        }
+
+        [$headerB64, $payloadB64, $signatureB64] = $parts;
+
+        $header = json_decode(self::base64UrlDecode($headerB64), true);
+
+        if (! is_array($header) || ($header['alg'] ?? null) !== 'HS256') {
+            throw new InvalidArgumentException('Unexpected token algorithm.');
+        }
+
+        $expected = hash_hmac('sha256', $headerB64.'.'.$payloadB64, $secret, true);
+
+        if (! hash_equals($expected, self::base64UrlDecode($signatureB64))) {
+            throw new InvalidArgumentException('Invalid token signature.');
+        }
+
+        $claims = json_decode(self::base64UrlDecode($payloadB64), true);
+
+        if (! is_array($claims)) {
+            throw new InvalidArgumentException('Malformed token payload.');
+        }
+
+        if (isset($claims['exp']) && (int) $claims['exp'] < time()) {
+            throw new InvalidArgumentException('Expired token.');
+        }
+
+        return $claims;
+    }
+
+    private static function base64UrlEncode(string $bytes): string
+    {
+        return rtrim(strtr(base64_encode($bytes), '+/', '-_'), '=');
+    }
+
+    private static function base64UrlDecode(string $input): string
+    {
+        $decoded = base64_decode(strtr($input, '-_', '+/'), true);
+
+        if ($decoded === false) {
+            throw new InvalidArgumentException('Malformed token encoding.');
+        }
+
+        return $decoded;
+    }
+}
