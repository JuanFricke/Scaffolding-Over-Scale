+<?php
+
+namespace App\Totem;
+
+/**
+ * Backend-owned totem priority levels: the single source used both by the
+ * priorities endpoint and by ticket issuance validation. No per-entity
+ * custom priorities.
+ */
+final class TotemPriorities
+{
+    /**
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
