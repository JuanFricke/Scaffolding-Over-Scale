+function totemPair(Entity $entity, array $queues = []): array
+{
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach(collect($queues)->map->id->all());
+
+    $response = test()->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    return [$preset, $response->json('token')];
+}
+
+function totemHeaders(string $token, ?string $origin = null): array
+{
+    $headers = ['Authorization' => 'Bearer '.$token];
+
+    if ($origin !== null) {
+        $headers['Origin'] = $origin;
+    }
+
+    return $headers;
+}
+
+it('opens a pairing window via artisan command', function () {
