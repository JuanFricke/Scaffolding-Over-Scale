@@ -0,0 +1,97 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+
+class TotemAuthController extends Controller
+{
+    public function __invoke(Request $request)
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) && ! is_int($code)) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $code = (string) $code;
+
+        if (preg_match('/^\d{6}$/', $code) !== 1) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $result = DB::transaction(function () use ($code) {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (! $preset instanceof TotemPreset
+                || ! $preset->is_active
+                || $preset->login_code_consumed_at !== null
+                || $preset->login_code_expires_at === null
+                || $preset->login_code_expires_at->isPast()) {
+                return null;
+            }
+
+            $queueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $entity = $preset->entity()->firstOrFail();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => 'Totem '.$preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $ttl = (int) config('services.totem.jwt_ttl', 3600);
+            $now = time();
+
+            $token = TotemJwt::encode([
+                'totem_id' => $totem->id,
+                'entity_id' => $preset->entity_id,
+                'preset_id' => $preset->id,
+                'queues' => $queueIds,
+                'iat' => $now,
+                'exp' => $now + $ttl,
+                'jti' => (string) Str::uuid(),
+            ], (string) config('services.totem.jwt_secret'));
+
+            return [$totem, $preset->id, $entity, $token, $ttl];
+        });
+
+        if ($result === null) {
+            Log::channel('audit')->info('Totem pairing failed', ['reason' => 'invalid_pairing_code']);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        [$totem, $presetId, $entity, $token, $ttl] = $result;
+
+        Log::channel('audit')->info('Totem pairing succeeded', [
+            'totem_id' => $totem->id,
+            'preset_id' => $presetId,
+            'entity_id' => $entity->id,
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => $ttl,
+            'entity' => [
+                'slug' => $entity->slug,
+                'name' => $entity->name,
+            ],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemQueueController.php b/app/Http/Controllers/Api/TotemQueueController.php
new file mode 100644
index 0000000..d93bf37
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemQueueController.php
@@ -0,0 +1,163 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Totem\TotemPriorities;
+use Illuminate\Http\Request;
+
+class TotemQueueController extends Controller
+{
+    /**
+     * Resolve the entity slug against the token's entity.
+     */
+    private function resolveEntity(Request $request, string $entitySlug): ?Entity
+    {
+        /** @var Entity $tokenEntity */
+        $tokenEntity = $request->attributes->get('totem_entity');
+
+        if ($tokenEntity->slug !== $entitySlug) {
+            return null;
+        }
+
+        return $tokenEntity;
+    }
+
+    /**
+     * Resolve a queue slug within the entity and the token's effective scope.
+     *
+     * @return array{queue: Queue}|array{error: string, status: int}
+     */
+    private function resolveQueue(Request $request, Entity $entity, string $queueSlug): array
+    {
+        $queue = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $queueSlug)
+            ->first();
+
+        if (! $queue instanceof Queue) {
+            return ['error' => 'queue_not_found', 'status' => 404];
+        }
+
+        /** @var list<int> $scope */
+        $scope = $request->attributes->get('totem_queues', []);
+
+        if (! in_array((int) $queue->id, array_map('intval', $scope), true)) {
+            return ['error' => 'forbidden', 'status' => 403];
+        }
+
+        return ['queue' => $queue];
+    }
+
+    public function queues(Request $request, string $entity)
+    {
+        $tokenEntity = $this->resolveEntity($request, $entity);
+
+        if (! $tokenEntity instanceof Entity) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        /** @var list<int> $scope */
+        $scope = array_map('intval', (array) $request->attributes->get('totem_queues', []));
+
+        $queues = Queue::query()
+            ->where('entity_id', $tokenEntity->id)
+            ->whereIn('id', $scope)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        $payload = $queues->values()->map(fn (Queue $queue, int $index) => [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => null,
+            'visual' => [
+                'color' => '#0055FF',
+                'icon' => 'ticket',
+                'order' => $index + 1,
+            ],
+            'is_active' => true,
+        ])->all();
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug, 'name' => $tokenEntity->name],
+            'queues' => $payload,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue)
+    {
+        $tokenEntity = $this->resolveEntity($request, $entity);
+
+        if (! $tokenEntity instanceof Entity) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $resolved = $this->resolveQueue($request, $tokenEntity, $queue);
+
+        if (isset($resolved['error'])) {
+            return response()->json(['code' => $resolved['error']], $resolved['status']);
+        }
+
+        /** @var Queue $queueModel */
+        $queueModel = $resolved['queue'];
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => TotemPriorities::all(),
+        ]);
+    }
+
+    public function issue(Request $request, string $entity, string $queue)
+    {
+        $tokenEntity = $this->resolveEntity($request, $entity);
+
+        if (! $tokenEntity instanceof Entity) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $resolved = $this->resolveQueue($request, $tokenEntity, $queue);
+
+        if (isset($resolved['error'])) {
+            return response()->json(['code' => $resolved['error']], $resolved['status']);
+        }
+
+        /** @var Queue $queueModel */
+        $queueModel = $resolved['queue'];
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priority = $request->input('priority');
+
+        if (! is_numeric($priority) || ! in_array((int) $priority, TotemPriorities::values(), true)) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        $priority = (int) $priority;
+
+        try {
+            $ticket = (new IssueTicket)($queueModel->fresh(), $priority, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => ['value' => $ticket->priority, 'label' => TotemPriorities::labelFor((int) $ticket->priority)],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+}
diff --git a/app/Http/Middleware/TotemAuth.php b/app/Http/Middleware/TotemAuth.php
new file mode 100644
index 0000000..3b99324
--- /dev/null
+++ b/app/Http/Middleware/TotemAuth.php
@@ -0,0 +1,88 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+use Throwable;
+
+/**
+ * Validates the totem JWT on every authenticated totem call.
+ *
+ * Missing/invalid/expired token, unknown or inactive totem, unknown or
+ * inactive preset, or any entity mismatch between claims, totem and preset
+ * all answer the same 401 {code: invalid_token}.
+ *
+ * The effective queue scope is the intersection of the JWT `queues` claim
+ * with the preset's current queue join, so removing a queue from the preset
+ * takes effect immediately for existing tokens.
+ */
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            return $this->invalidToken();
+        }
+
+        try {
+            $claims = TotemJwt::decode($token, (string) config('services.totem.jwt_secret'));
+        } catch (Throwable) {
+            return $this->invalidToken();
+        }
+
+        if (! isset($claims['totem_id'], $claims['entity_id'], $claims['preset_id'], $claims['queues'])
+            || ! is_array($claims['queues'])) {
+            return $this->invalidToken();
+        }
+
+        $totem = Totem::query()->find($claims['totem_id']);
+        $preset = TotemPreset::query()->find($claims['preset_id']);
+
+        if (! $totem instanceof Totem || ! $totem->is_active) {
+            return $this->invalidToken();
+        }
+
+        if (! $preset instanceof TotemPreset || ! $preset->is_active) {
+            return $this->invalidToken();
+        }
+
+        $entity = Entity::query()->find($claims['entity_id']);
+
+        if (! $entity instanceof Entity) {
+            return $this->invalidToken();
+        }
+
+        if ((int) $totem->entity_id !== (int) $entity->id
+            || (int) $preset->entity_id !== (int) $entity->id
+            || (int) $totem->entity_id !== (int) $preset->entity_id) {
+            return $this->invalidToken();
+        }
+
+        $currentQueueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+        $claimQueueIds = array_map('intval', $claims['queues']);
+        $effectiveQueueIds = array_values(array_intersect($claimQueueIds, $currentQueueIds));
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_queues', $effectiveQueueIds);
+        $request->attributes->set('totem_claims', $claims);
+
+        return $next($request);
+    }
+
+    private function invalidToken(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
