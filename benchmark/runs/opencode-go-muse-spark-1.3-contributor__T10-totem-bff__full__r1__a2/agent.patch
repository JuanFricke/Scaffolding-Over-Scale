+<?php
+
+use App\Http\Controllers\Api\TotemAuthController;
+use App\Http\Controllers\Api\TotemQueueController;
+use Illuminate\Support\Facades\Route;
+
+Route::post('/totem/auth', TotemAuthController::class)->middleware('throttle:10,1');
+
+Route::middleware(['totem.auth'])->group(function () {
+    Route::get('/{entity}/queues', [TotemQueueController::class, 'queues']);
+    Route::get('/{entity}/{queue}/priorities', [TotemQueueController::class, 'priorities']);
+    Route::post('/{entity}/{queue}/ticket', [TotemQueueController::class, 'issue'])->middleware('throttle:30,1');
+});
+
+Route::options('/{any}', fn () => response()->noContent(204))->where('any', '.*');
