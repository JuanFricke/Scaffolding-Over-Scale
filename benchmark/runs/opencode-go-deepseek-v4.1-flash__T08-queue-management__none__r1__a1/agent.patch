+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $attributes = [];
+
+        if ($name !== null) {
+            $attributes['name'] = trim($name);
+        }
+
+        if ($slug !== null) {
+            $attributes['slug'] = Str::slug($slug);
+        }
+
+        if ($isActive !== null) {
+            $attributes['is_active'] = $isActive;
+        }
+
+        $rules = [];
+
+        if (array_key_exists('name', $attributes)) {
+            $rules['name'] = ['required', 'string', 'max:255'];
+        }
+
+        if (array_key_exists('slug', $attributes)) {
+            $rules['slug'] = [
+                'required',
+                'string',
+                'max:255',
+                Rule::unique('queues', 'slug')
+                    ->where(fn ($query) => $query->where('entity_id', $queue->entity_id))
+                    ->ignore($queue->id),
+            ];
+        }
+
+        Validator::make($attributes, $rules)->validate();
+
+        if ($attributes === []) {
+            return $queue;
+        }
+
+        try {
+            $queue->fill($attributes);
+            $queue->save();
+        } catch (QueryException $e) {
+            if (! self::isUniqueViolation($e)) {
+                throw $e;
+            }
+
+            throw ValidationException::withMessages([
+                'slug' => 'A queue with this slug already exists in the entity.',
+            ]);
+        }
+
+        return $queue;
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
