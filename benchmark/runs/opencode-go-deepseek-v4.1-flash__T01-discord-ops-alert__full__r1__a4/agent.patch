diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..7b2ba5f
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,122 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+beforeEach(function () {
+    config()->set('services.discord.webhook_url', 'https://discord.example/api/webhooks/123/secret-token');
+});
+
+test('it does nothing when the webhook is not configured', function (?string $webhook) {
+    config()->set('services.discord.webhook_url', $webhook);
+
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertNothingSent();
+})->with([
+    'null' => [null],
+    'empty string' => [''],
+]);
+
+test('it posts the title, message and context to the configured webhook', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Job failed', 'The webhook job exhausted its retries.', [
+        'queue' => 'asaas-webhooks',
+        'entity_id' => 42,
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        return $request->method() === 'POST'
+            && $request->url() === 'https://discord.example/api/webhooks/123/secret-token'
+            && $request->data() === [
+                'content' => "Job failed\nThe webhook job exhausted its retries.\nqueue=asaas-webhooks\nentity_id=42",
+            ];
+    });
+});
+
+test('it truncates the content to 1800 multibyte characters', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', str_repeat('é', 3000));
+
+    Http::assertSent(function (Request $request) {
+        return mb_strlen($request->data()['content']) === 1800;
+    });
+});
+
+test('it redacts sensitive context values', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message', [
+        'password' => 'super-secret',
+        'API_KEY' => 'key-value',
+        'webhook_url' => 'https://example.test/hook',
+        'note' => 'Authorization: Bearer abc123',
+        'queue' => 'asaas-webhooks',
+        'payload' => [
+            'token' => 'nested-secret',
+            'queue' => 'asaas-webhooks',
+            'header' => 'Bearer nested-token',
+        ],
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        $lines = explode("\n", $request->data()['content']);
+
+        expect($lines)->toContain(
+            'password=[redacted]',
+            'API_KEY=[redacted]',
+            'webhook_url=[redacted]',
+            'note=[redacted]',
+            'queue=asaas-webhooks',
+        );
+
+        $payloadLine = collect($lines)->first(fn (string $line) => str_starts_with($line, 'payload='));
+
+        $payload = json_decode(substr($payloadLine, strlen('payload=')), true);
+
+        expect($payload)->toBe([
+            'token' => '[redacted]',
+            'queue' => 'asaas-webhooks',
+            'header' => '[redacted]',
+        ]);
+
+        return true;
+    });
+});
+
+test('it logs an error without leaking the webhook when discord answers with a failure', function () {
+    Log::spy();
+    Http::fake(['*' => Http::response('nope', 500)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(fn (string $message, array $context = []) => str_contains($message, 'Discord ops alert failed')
+            && str_contains(json_encode($context), '500')
+            && ! str_contains($message, 'secret-token')
+            && ! str_contains(json_encode($context), 'secret-token'));
+});
+
+test('it logs an error without leaking the webhook when the transport throws', function () {
+    Log::spy();
+
+    Http::fake(function () {
+        throw new ConnectionException('Connection to https://discord.example/api/webhooks/123/secret-token failed');
+    });
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(fn (string $message, array $context = []) => str_contains($message, 'Discord ops alert failed')
+            && ! str_contains($message, 'secret-token')
+            && ! str_contains(json_encode($context), 'secret-token'));
+});
diff --git a/tests/Feature/Ops/LoggingChannelsTest.php b/tests/Feature/Ops/LoggingChannelsTest.php
new file mode 100644
index 0000000..84ec043
--- /dev/null
+++ b/tests/Feature/Ops/LoggingChannelsTest.php
@@ -0,0 +1,34 @@
+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('the daily channel is the archive lane', function () {
+    $daily = config('logging.channels.daily');
+
+    expect($daily['driver'])->toBe('daily')
+        ->and($daily['path'])->toEndWith('logs/laravel.log')
+        ->and($daily['days'])->toBe(14);
+});
+
+test('the audit channel writes to its own rotated file', function () {
+    $audit = config('logging.channels.audit');
+
+    expect($audit['driver'])->toBe('daily')
+        ->and($audit['path'])->toEndWith('logs/audit.log')
+        ->and($audit['days'])->toBe(90)
+        ->and($audit['level'])->toBe('info');
+});
+
+test('the stack logs to the archive channel', function () {
+    expect(config('logging.channels.stack.channels'))->toContain('daily');
+});
+
+test('there is no discord logging channel', function () {
+    expect(config('logging.channels'))->not->toHaveKey('discord');
+});
+
+test('the audit channel accepts writes', function () {
+    Log::channel('audit')->info('Subscription status changed', ['entity_id' => 42]);
+
+    expect(true)->toBeTrue();
+});
