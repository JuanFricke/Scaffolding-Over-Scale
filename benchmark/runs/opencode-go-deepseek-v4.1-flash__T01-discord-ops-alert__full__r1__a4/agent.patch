diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..91d6547
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,159 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+/**
+ * Sends human-pageable operations incidents to a Discord incoming webhook.
+ *
+ * Discord is deliberately not a Monolog channel: application code decides when
+ * an incident is worth paging someone. Every failure is soft — the notifier
+ * never throws and never leaks the webhook token into the logs.
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const TIMEOUT_SECONDS = 5;
+
+    /**
+     * Key fragments that mark a context value as sensitive.
+     *
+     * @var list<string>
+     */
+    private const SENSITIVE_KEY_FRAGMENTS = [
+        'password',
+        'token',
+        'secret',
+        'authorization',
+        'api_key',
+        'api-key',
+        'apikey',
+        'webhook',
+    ];
+
+    /**
+     * Send one alert. A missing webhook configuration is a silent no-op.
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhookUrl = config('services.discord.webhook_url');
+
+        if (blank($webhookUrl)) {
+            return;
+        }
+
+        $webhookUrl = (string) $webhookUrl;
+
+        try {
+            $content = $this->content($title, $message, $context);
+
+            $response = Http::timeout(self::TIMEOUT_SECONDS)->post($webhookUrl, [
+                'content' => $content,
+            ]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (Throwable $exception) {
+            Log::error('Discord ops alert failed', [
+                'exception' => $this->scrub($exception->getMessage(), $webhookUrl),
+            ]);
+        }
+    }
+
+    /**
+     * Build the Discord message body, redacting and truncating it.
+     */
+    private function content(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->renderValue((string) $key, $value);
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH);
+    }
+
+    /**
+     * Render a single context value, redacting it first when needed.
+     */
+    private function renderValue(string $key, mixed $value): string
+    {
+        if ($this->isSensitiveKey($key)) {
+            return '[redacted]';
+        }
+
+        if (is_array($value)) {
+            return (string) json_encode(
+                $this->redactArray($value),
+                JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE,
+            );
+        }
+
+        if (is_string($value) && $this->containsBearerCredential($value)) {
+            return '[redacted]';
+        }
+
+        return match (true) {
+            $value === null => '',
+            $value === true => 'true',
+            $value === false => 'false',
+            default => (string) $value,
+        };
+    }
+
+    /**
+     * Redact an associative array recursively using the same rules.
+     */
+    private function redactArray(array $values): array
+    {
+        $redacted = [];
+
+        foreach ($values as $key => $value) {
+            if (is_string($key) && $this->isSensitiveKey($key)) {
+                $redacted[$key] = '[redacted]';
+            } elseif (is_array($value)) {
+                $redacted[$key] = $this->redactArray($value);
+            } elseif (is_string($value) && $this->containsBearerCredential($value)) {
+                $redacted[$key] = '[redacted]';
+            } else {
+                $redacted[$key] = $value;
+            }
+        }
+
+        return $redacted;
+    }
+
+    private function isSensitiveKey(string $key): bool
+    {
+        $key = strtolower($key);
+
+        foreach (self::SENSITIVE_KEY_FRAGMENTS as $fragment) {
+            if (str_contains($key, $fragment)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function containsBearerCredential(string $value): bool
+    {
+        return preg_match('/bearer\s+\S+/i', $value) === 1;
+    }
+
+    /**
+     * Remove the webhook URL (which embeds its token) from log output.
+     */
+    private function scrub(string $value, string $webhookUrl): string
+    {
+        return str_replace($webhookUrl, '[redacted]', $value);
+    }
+}
