+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the members list is the default tab and invites appear only on the invites tab', function () {
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'pend@example.com']);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->assertSet('activeTab', 'members')
+        ->assertDontSee('inviteEmail', false)
+        ->assertDontSee('pend@example.com', false)
+        ->call('setActiveTab', 'invites')
+        ->assertSet('activeTab', 'invites')
+        ->assertSee('inviteEmail', false)
+        ->assertSee('pend@example.com', false);
+});
+
+test('setActiveTab ignores anything other than the two known tabs', function () {
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('setActiveTab', 'invites')
+        ->call('setActiveTab', 'settings')
+        ->assertSet('activeTab', 'invites')
+        ->call('setActiveTab', '')
+        ->assertSet('activeTab', 'invites');
+});
+
+test('an unknown tab value written directly falls back to the members list', function () {
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'pend@example.com']);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('activeTab', 'bogus')
+        ->assertDontSee('inviteEmail', false)
+        ->assertDontSee('pend@example.com', false)
+        ->assertSee('role="tablist"', false);
+});
