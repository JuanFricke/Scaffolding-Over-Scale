+<?php
+
+use App\Livewire\Entity\Queues;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array{0: Entity, 1: User}
+ */
+function queuesEntityWithOwner(string $name = 'Acme'): array
+{
+    $entity = Entity::factory()->create(['name' => $name]);
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    return [$entity, $owner];
+}
+
+test('owner creates a queue from the modal and the slug is derived from the name', function () {
+    [$entity, $owner] = queuesEntityWithOwner();
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openCreate')
+        ->assertSet('creating', true)
+        ->set('name', 'Atendimento Geral')
+        ->call('create')
+        ->assertHasNoErrors()
+        ->assertSet('creating', false)
+        ->assertSet('name', '');
+
+    expect(Queue::query()->where('entity_id', $entity->id)->first())
+        ->name->toBe('Atendimento Geral')
+        ->slug->toBe('atendimento-geral')
+        ->is_active->toBeTrue();
+});
+
+test('a duplicate derived slug is reported on the name field and creates nothing', function () {
+    [$entity, $owner] = queuesEntityWithOwner();
+    Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openCreate')
+        ->set('name', 'Geral')
+        ->call('create')
+        ->assertHasErrors(['name'])
+        ->assertSet('creating', true);
+
+    expect(Queue::query()->where('entity_id', $entity->id)->count())->toBe(1);
+});
+
+test('the create modal rejects an empty name before reaching the domain', function () {
+    [$entity, $owner] = queuesEntityWithOwner();
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openCreate')
+        ->set('name', '   ')
+        ->call('create')
+        ->assertHasErrors(['name' => 'required']);
+
