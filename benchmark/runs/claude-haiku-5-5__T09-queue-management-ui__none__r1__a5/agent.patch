+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array{0: Entity, 1: User}
+ */
+function serveEntityWithOwner(string $name = 'Acme'): array
+{
+    $entity = Entity::factory()->create(['name' => $name]);
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    return [$entity, $owner];
+}
+
+function serveEmployee(Entity $entity, array $grantedQueues = []): User
+{
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    foreach ($grantedQueues as $queue) {
+        QueueAccess::query()->create([
+            'entity_membership_id' => $membership->id,
+            'queue_id' => $queue->id,
+            'permissions' => ['call'],
+        ]);
+    }
+
+    return $employee;
+}
+
+function serveQueue(Entity $entity, string $name, bool $active = true): Queue
+{
+    return Queue::factory()->for($entity)->create([
+        'name' => $name,
+        'slug' => str($name)->slug()->toString(),
+        'is_active' => $active,
+    ]);
+}
+
+test('the panel defaults to the first active queue the owner can call', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    serveQueue($entity, 'Zeta');
+    $alpha = serveQueue($entity, 'Alpha');
+    serveQueue($entity, 'Beta', active: false);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $alpha->id)
+        ->assertSet('mode', 'any')
+        ->assertSet('lastCalledTicketId', null)
+        ->assertDontSee('Beta');
+});
+
+test('employees only see and default to queues they hold a call grant for', function () {
+    [$entity] = serveEntityWithOwner();
+    $granted = serveQueue($entity, 'Granted');
+    serveQueue($entity, 'Blocked');
+    $employee = serveEmployee($entity, [$granted]);
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $granted->id)
+        ->assertSee('Granted')
+        ->assertDontSee('Blocked');
+});
+
+test('an employee with no grants gets an empty panel and nothing to call', function () {
+    [$entity] = serveEntityWithOwner();
+    serveQueue($entity, 'Geral');
+    $employee = serveEmployee($entity);
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', null)
+        ->assertSee(__('ui.serve_empty'))
+        ->assertDontSee('Geral');
+});
+
+test('calling next takes the head of the waiting list and reports the code', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    $queue = serveQueue($entity, 'Geral');
+    $normal = (new IssueTicket)($queue, 0);
+    $priority = (new IssueTicket)($queue, 2);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('lastCalledTicketId', $priority->id)
+        ->assertSet('notice', __('ui.serve_last_called', ['code' => $priority->code]));
+
+    expect($priority->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('calling with no selection only sets a notice', function () {
+    [$entity] = serveEntityWithOwner();
+    $employee = serveEmployee($entity);
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('notice', __('ui.serve_empty'))
+        ->assertSet('lastCalledTicketId', null);
+});
+
+test('a foreign selected queue is not found and no ticket is called', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    serveQueue($entity, 'Geral');
+    [$otherEntity] = serveEntityWithOwner('Other');
+    $foreignQueue = serveQueue($otherEntity, 'Foreign');
+    $ticket = (new IssueTicket)($foreignQueue, 0);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $foreignQueue->id);
+
+    expect(fn () => $component->call('callNext'))->toThrow(ModelNotFoundException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a foreign selected queue shows no tickets, only the empty state', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    serveQueue($entity, 'Geral');
+    [$otherEntity] = serveEntityWithOwner('Other');
+    $foreignQueue = serveQueue($otherEntity, 'Foreign');
+    (new IssueTicket)($foreignQueue, 0);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $foreignQueue->id)
+        ->assertDontSee('A001')
+        ->assertSee(__('ui.serve_empty'));
+});
+
+test('an inactive queue reports the inactive notice', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    $queue = serveQueue($entity, 'Geral');
+    $ticket = (new IssueTicket)($queue, 0);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity]);
+
+    $queue->update(['is_active' => false]);
+
+    $component->call('callNext')
+        ->assertSet('notice', __('ui.serve_inactive'))
+        ->assertSet('lastCalledTicketId', null);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('an empty queue reports the empty notice', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    serveQueue($entity, 'Geral');
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('notice', __('ui.serve_empty'));
+});
+
+test('an employee without a grant who forces a queue id is refused with 403 and nothing changes', function () {
+    [$entity] = serveEntityWithOwner();
+    $queue = serveQueue($entity, 'Geral');
+    $ticket = (new IssueTicket)($queue, 0);
+    $employee = serveEmployee($entity);
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertForbidden();
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a tampered mode lists nothing and cannot be called', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    $queue = serveQueue($entity, 'Geral');
+    $ticket = (new IssueTicket)($queue, 0);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('mode', 'bogus')
+        ->assertDontSee($ticket->code)
+        ->call('callNext')
+        ->assertStatus(422);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('the last called ticket is locked against client writes', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    expect(fn () => Livewire::test(Serve::class, ['entity' => $entity])->set('lastCalledTicketId', 99))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
+
+test('the waiting list follows call order and the mode filters it', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    $queue = serveQueue($entity, 'Geral');
+    (new IssueTicket)($queue, 0);        // A001 normal
+    (new IssueTicket)($queue, 2);        // A002 priority
+    (new IssueTicket)($queue, 1);        // A003 priority
+    (new IssueTicket)($queue, 0);        // A004 normal
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $html = Livewire::test(Serve::class, ['entity' => $entity])->html();
+
+    expect(strpos($html, 'A002'))->toBeLessThan(strpos($html, 'A003'))
+        ->and(strpos($html, 'A003'))->toBeLessThan(strpos($html, 'A001'))
+        ->and(strpos($html, 'A001'))->toBeLessThan(strpos($html, 'A004'));
+
+    $priorityOnly = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('mode', 'priority_only')
+        ->html();
+
+    expect($priorityOnly)->toContain('A002')->toContain('A003')
+        ->not->toContain('A001')->not->toContain('A004');
+
+    $normalOnly = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('mode', 'normal_only')
+        ->html();
+
+    expect($normalOnly)->toContain('A001')->toContain('A004')
+        ->not->toContain('A002')->not->toContain('A003');
+});
+
+test('the waiting list is capped at thirty tickets', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    $queue = serveQueue($entity, 'Geral');
+    for ($i = 0; $i < 31; $i++) {
+        (new IssueTicket)($queue, 0);
+    }
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $html = Livewire::test(Serve::class, ['entity' => $entity])->html();
+
+    expect(substr_count($html, 'is-block has-text-weight-semibold'))->toBe(30);
+});
+
+test('the channel is translated in the waiting list', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    $queue = serveQueue($entity, 'Geral');
+    (new IssueTicket)($queue, 0, TicketChannel::Printed);
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    app()->setLocale('pt_BR');
+    Livewire::test(Serve::class, ['entity' => $entity])->assertSee('Impresso');
+
+    app()->setLocale('en');
+    Livewire::test(Serve::class, ['entity' => $entity])->assertSee('Printed');
+});
+
+test('successful calls are rate limited per user and entity', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    $queue = serveQueue($entity, 'Geral');
+    for ($i = 0; $i < 11; $i++) {
+        (new IssueTicket)($queue, 0);
+    }
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity]);
+
+    for ($i = 0; $i < 10; $i++) {
+        $component->call('callNext');
+    }
+
+    expect(Ticket::query()->where('status', TicketStatus::Called)->count())->toBe(10);
+
+    $component->call('callNext')
+        ->assertSet('notice', __('ui.serve_rate_limited'));
+
+    expect(Ticket::query()->where('status', TicketStatus::Called)->count())->toBe(10);
+});
+
+test('the serve page is reachable for members and redirects guests', function () {
+    [$entity, $owner] = serveEntityWithOwner();
+    serveQueue($entity, 'Geral');
+
+    $this->get(route('entity.serve', $entity->slug))->assertRedirect(route('login'));
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+    $this->get(route('entity.serve', $entity->slug))->assertOk();
+
+    $employee = serveEmployee($entity);
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+    $this->get(route('entity.serve', $entity->slug))
+        ->assertOk()
+        ->assertSee(__('ui.serve_empty'));
+});
+
+test('clearing the queue selector leaves the panel without a queue', function () {
