+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Carbon\Carbon;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function makeCalled(Queue $queue, User $by, int $priority = 0, ?Carbon $calledAt = null, ?Carbon $issuedAt = null): Ticket
+{
+    $ticket = Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Waiting,
+        'issued_at' => $issuedAt ?? now()->subHour(),
+    ]);
+
+    $ticket->status = TicketStatus::Called;
+    $ticket->called_at = $calledAt ?? now();
+    $ticket->called_by_user_id = $by->id;
+    $ticket->save();
+
+    return $ticket->refresh();
+}
+
+it('exposes the call mode enum values', function () {
+    expect(CallMode::Any->value)->toBe('any')
+        ->and(CallMode::PriorityOnly->value)->toBe('priority_only')
+        ->and(CallMode::NormalOnly->value)->toBe('normal_only');
+});
+
+it('throws NoWaitingTicketsException extending RuntimeException', function () {
+    expect(new NoWaitingTicketsException('x'))->toBeInstanceOf(RuntimeException::class);
+});
+
+it('calls the highest priority then oldest ticket in any mode', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $base = now()->subMinutes(10);
+
+    $normalOld = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => $base->copy()->subMinutes(3)]);
+    $priorityNew = Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'issued_at' => $base->copy()->addMinutes(2)]);
+    $priorityOld = Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'issued_at' => $base->copy()->subMinutes(5)]);
+    $priorityHigher = Ticket::factory()->forQueue($queue)->create(['priority' => 20, 'issued_at' => $base->copy()->addMinutes(5)]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($priorityHigher->id)
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_by_user_id)->toBe($attendant->id)
+        ->and($called->called_at)->not->toBeNull();
+
+    $second = (new CallNextTicket)($queue, $attendant);
+
+    expect($second->id)->toBe($priorityOld->id);
+});
+
+it('breaks issued_at ties by lowest id', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    $issuedAt = now()->subMinutes(5);
+
+    $first = Ticket::factory()->forQueue($queue)->create(['priority' => 5, 'issued_at' => $issuedAt]);
+    $second = Ticket::factory()->forQueue($queue)->create(['priority' => 5, 'issued_at' => $issuedAt]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe(min($first->id, $second->id));
+});
+
+it('only selects waiting tickets of the given queue', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $other = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $otherPriority = Ticket::factory()->forQueue($other)->create(['priority' => 99, 'issued_at' => now()->subHour()]);
+    $mine = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($mine->id)
+        ->and($otherPriority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('never calls an already called ticket again', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $old = Ticket::factory()->forQueue($queue)->create(['priority' => 99, 'issued_at' => now()->subHour()]);
+    $old->status = TicketStatus::Called;
+    $old->called_at = now()->subMinutes(30);
+    $old->called_by_user_id = $attendant->id;
+    $old->save();
+
+    $waiting = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($waiting->id);
+});
+
+it('skips tickets concurrently called via Ticket::call', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+    // Ticket::call() requires entity membership.
+    $membershipQueue = Queue::factory()->create(['is_active' => true]);
+    $entity = $membershipQueue->entity;
+    $member = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($member)->create();
+    $queue->update(['entity_id' => $entity->id]);
+
+    $first = Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'issued_at' => now()->subMinutes(10)]);
+    $second = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subMinutes(5)]);
+
+    $first->call($member);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($second->id);
+});
+
+it('supports priority_only mode ignoring fairness', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    // Build a 3-priority streak that would force fairness in any mode.
+    foreach (range(1, 3) as $i) {
+        makeCalled($queue, $attendant, priority: 10, calledAt: now()->subMinutes(10 - $i));
+    }
+    $normal = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subHour()]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->id)->toBe($priority->id)
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('supports normal_only mode oldest first', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 50, 'issued_at' => now()->subHour()]);
+    $normalNew = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()]);
+    $normalOld = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subMinutes(30)]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly);
+
+    expect($called->id)->toBe($normalOld->id)
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('enforces fairness after three consecutive priority calls', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    foreach (range(1, 3) as $i) {
+        makeCalled($queue, $attendant, priority: 10, calledAt: now()->subMinutes(10 - $i));
+    }
+
+    $normalOld = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subHour()]);
+    Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()]);
+    Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'issued_at' => now()->subMinutes(90)]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($called->id)->toBe($normalOld->id);
+});
+
+it('does not enforce fairness with fewer than three calls', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    foreach (range(1, 2) as $i) {
+        makeCalled($queue, $attendant, priority: 10, calledAt: now()->subMinutes(10 - $i));
+    }
+
+    Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subHour()]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($priority->id);
+});
+
+it('resets the fairness streak after a normal call', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    makeCalled($queue, $attendant, priority: 10, calledAt: now()->subMinutes(40));
+    makeCalled($queue, $attendant, priority: 10, calledAt: now()->subMinutes(30));
+    makeCalled($queue, $attendant, priority: 0, calledAt: now()->subMinutes(20));
+    makeCalled($queue, $attendant, priority: 10, calledAt: now()->subMinutes(10));
+
+    Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subHour()]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($priority->id);
+});
+
+it('keeps calling priority when no normal is waiting despite a streak', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    foreach (range(1, 3) as $i) {
+        makeCalled($queue, $attendant, priority: 10, calledAt: now()->subMinutes(10 - $i));
+    }
+
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($priority->id);
+});
+
+it('counts priority_only and normal_only calls in fairness history', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $p1 = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+    $p2 = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+    $p3 = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+    $normal = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subHour()]);
+    $priorityWaiting = Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'issued_at' => now()]);
+
+    (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly)->refresh();
+    // Second and third priority calls via the action to build history.
+    (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+    (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($p1->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($p2->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($p3->fresh()->status)->toBe(TicketStatus::Called);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($called->id)->toBe($normal->id);
+    expect($priorityWaiting->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('rejects calling from an inactive queue reading fresh state', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+    $attendant = User::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->where('status', TicketStatus::Waiting)->count())->toBe(1);
+});
+
