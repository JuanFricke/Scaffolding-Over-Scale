+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $restrictToNormal = $mode === CallMode::Any && $this->fairnessApplies($lockedQueue->id);
+
+            $winner = $this->takeNext($lockedQueue->id, $mode, $restrictToNormal, $calledBy);
+
+            // A fairness-restricted pass may have been exhausted by concurrent
+            // Ticket::call() wins after the snapshot: no normal is waiting
+            // anymore, so fall back to full ordering instead of failing
+            // while priority tickets are still waiting.
+            if ($winner === null && $restrictToNormal) {
+                $stillWaitingNormal = Ticket::query()
+                    ->where('queue_id', $lockedQueue->id)
+                    ->where('status', TicketStatus::Waiting)
+                    ->where('priority', 0)
+                    ->exists();
+
+                if (! $stillWaitingNormal) {
+                    $winner = $this->takeNext($lockedQueue->id, $mode, false, $calledBy);
+                }
+            }
+
+            if ($winner === null) {
+                throw new NoWaitingTicketsException('No waiting tickets eligible for the requested mode.');
+            }
+
+            return $winner;
+        });
+    }
+
+    /**
+     * Fairness (any mode only): a normal ticket may not wait behind more
+     * than 3 consecutive priority calls. Look at the last 3 called tickets
+     * (most recent first by called_at, then id); when all 3 exist and are
+     * priority tickets and at least one normal is waiting, restrict to normals.
+     */
+    private function fairnessApplies(int $queueId): bool
+    {
+        $lastThree = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->get();
+
+        if ($lastThree->count() !== 3) {
+            return false;
+        }
+
+        if (! $lastThree->every(fn (Ticket $ticket): bool => $ticket->priority > 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+
+    private function takeNext(int $queueId, CallMode $mode, bool $restrictToNormal, User $calledBy): ?Ticket
+    {
+        foreach ($this->candidateIds($queueId, $mode, $restrictToNormal) as $id) {
+            $ticket = Ticket::query()
+                ->whereKey($id)
+                ->lockForUpdate()
+                ->first();
+
+            if ($ticket === null) {
+                continue;
+            }
+
+            // Re-check under the row lock: Ticket::call() does not lock the
+            // queue row, so the snapshot may hold a ticket called concurrently.
+            if ($ticket->queue_id !== $queueId || $ticket->status !== TicketStatus::Waiting) {
+                continue;
+            }
+
+            $ticket->status = TicketStatus::Called;
+            $ticket->called_at = now();
+            $ticket->called_by_user_id = $calledBy->id;
+            $ticket->save();
+
+            return $ticket->refresh();
+        }
+
+        return null;
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function candidateIds(int $queueId, CallMode $mode, bool $restrictToNormal): array
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting);
+
+        if ($mode === CallMode::PriorityOnly) {
+            $query
+                ->where('priority', '>', 0)
+                ->orderByDesc('priority')
+                ->orderBy('issued_at')
+                ->orderBy('id');
+        } elseif ($mode === CallMode::NormalOnly || $restrictToNormal) {
+            $query
+                ->where('priority', 0)
+                ->orderBy('issued_at')
+                ->orderBy('id');
+        } else {
+            $query
+                ->orderByDesc('priority')
+                ->orderBy('issued_at')
+                ->orderBy('id');
+        }
+
+        return $query->pluck('id')->all();
+    }
+}
