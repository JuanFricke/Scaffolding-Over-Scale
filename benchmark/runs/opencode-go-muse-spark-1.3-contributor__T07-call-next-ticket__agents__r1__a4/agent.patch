+it('returns the updated ticket and respects the write-once rule', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $attendant = User::factory()->create();
+
+    $ticket = Ticket::factory()->forQueue($queue)->create([
+        'priority' => 0,
+        'code' => 'A001',
+        'issued_at' => now()->subMinutes(5),
