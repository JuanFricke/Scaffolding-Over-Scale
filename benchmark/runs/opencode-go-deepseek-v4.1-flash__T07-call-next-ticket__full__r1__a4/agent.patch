+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+    $ticket = callNextTestTicket($queue);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, User::factory()->create()))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('marks the winning ticket as called and returns the updated model', function () {
+    $queue = Queue::factory()->create();
+    $user = User::factory()->create();
+    $ticket = callNextTestTicket($queue, [
+        'code' => 'A042',
+        'priority' => 7,
+        'issued_at' => now()->subMinute(),
+    ]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($ticket))->toBeTrue()
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_at)->not->toBeNull()
+        ->and($called->called_by_user_id)->toBe($user->id)
+        ->and($called->priority)->toBe(7)
+        ->and($called->code)->toBe('A042')
+        ->and($called->getChanges())->toHaveKeys(['status', 'called_at', 'called_by_user_id']);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_at->not->toBeNull()
+        ->called_by_user_id->toBe($user->id);
+});
