+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+function callNextTestTicket(Queue $queue, array $attributes = []): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create($attributes);
+}
+
+it('calls the highest-priority waiting ticket first in any mode', function () {
+    $queue = Queue::factory()->create();
+    $normal = callNextTestTicket($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(10)]);
+    $priority = callNextTestTicket($queue, ['priority' => 10, 'issued_at' => now()->subMinute()]);
+
+    $ticket = (new CallNextTicket)($queue, User::factory()->create());
+
+    expect($ticket->is($priority))->toBeTrue()
+        ->and($ticket->status)->toBe(TicketStatus::Called)
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls the oldest ticket within the same priority', function () {
+    $queue = Queue::factory()->create();
+    $older = callNextTestTicket($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(10)]);
+    $newer = callNextTestTicket($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(5)]);
+
+    $ticket = (new CallNextTicket)($queue, User::factory()->create());
+
+    expect($ticket->is($older))->toBeTrue()
+        ->and($newer->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('uses the lowest id to break a priority and issued_at tie', function () {
+    $queue = Queue::factory()->create();
+    $issuedAt = now()->subMinute();
+    $first = callNextTestTicket($queue, ['priority' => 5, 'issued_at' => $issuedAt]);
+    $second = callNextTestTicket($queue, ['priority' => 5, 'issued_at' => $issuedAt]);
+
+    $ticket = (new CallNextTicket)($queue, User::factory()->create());
+
+    expect($ticket->is($first))->toBeTrue()
+        ->and($second->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('never selects tickets from another queue', function () {
+    $queue = Queue::factory()->create();
+    $otherQueue = Queue::factory()->create();
+    $other = callNextTestTicket($otherQueue, ['priority' => 100, 'issued_at' => now()->subHour()]);
+    $ours = callNextTestTicket($queue, ['priority' => 0]);
+
+    $ticket = (new CallNextTicket)($queue, User::factory()->create());
+
+    expect($ticket->is($ours))->toBeTrue()
+        ->and($other->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('never calls an already called ticket', function () {
+    $queue = Queue::factory()->create();
+    $called = callNextTestTicket($queue, [
+        'priority' => 100,
+        'issued_at' => now()->subHour(),
+        'status' => TicketStatus::Called,
+        'called_at' => now()->subMinute(),
+    ]);
+    $waiting = callNextTestTicket($queue, ['priority' => 0]);
+
+    $ticket = (new CallNextTicket)($queue, User::factory()->create());
+
+    expect($ticket->is($waiting))->toBeTrue()
+        ->and($called->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+it('skips a candidate that was called between selection and locking', function () {
+    $queue = Queue::factory()->create();
+    $top = callNextTestTicket($queue, ['priority' => 10]);
+    $next = callNextTestTicket($queue, ['priority' => 0]);
+
+    $intercepted = false;
+
+    // Simulate Ticket::call() winning the race after this action selected the
+    // top candidate but before it locked that row.
+    DB::beforeExecuting(function (string $query, array $bindings) use (&$intercepted, $top): void {
+        if ($intercepted || ! str_contains($query, 'tickets') || ! in_array($top->id, $bindings, true)) {
+            return;
+        }
+
+        $intercepted = true;
+
+        DB::table('tickets')->where('id', $top->id)->update([
+            'status' => TicketStatus::Called->value,
+            'called_at' => now(),
+        ]);
+    });
+
+    $ticket = (new CallNextTicket)($queue, User::factory()->create());
+
+    expect($intercepted)->toBeTrue()
+        ->and($ticket->is($next))->toBeTrue()
+        ->and($top->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+it('calls only priority tickets in priority_only mode', function () {
