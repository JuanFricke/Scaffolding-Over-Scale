+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * Call the next eligible waiting ticket of a queue.
+     *
+     * The queue row lock serializes call-next operations, while each candidate
+     * row is locked and re-checked so a concurrent Ticket::call() cannot make
+     * this action call the same ticket twice.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $candidateIds = $this->candidateQuery($lockedQueue->id, $mode)->pluck('id');
+
+            foreach ($candidateIds as $candidateId) {
+                $ticket = Ticket::query()
+                    ->whereKey($candidateId)
+                    ->lockForUpdate()
+                    ->first();
+
+                // The ticket may have been called between selection and locking
+                // (Ticket::call() does not take the queue lock). Skip it.
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+
+            throw new NoWaitingTicketsException(
+                sprintf('No waiting tickets are eligible for call mode [%s].', $mode->value)
+            );
+        });
+    }
+
+    /**
+     * @return Builder<Ticket>
+     */
+    private function candidateQuery(int $queueId, CallMode $mode): Builder
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting);
+
+        return match ($mode) {
+            CallMode::PriorityOnly => $query
+                ->where('priority', '>', 0)
+                ->orderByDesc('priority')
+                ->orderBy('issued_at')
+                ->orderBy('id'),
+            CallMode::NormalOnly => $query
+                ->where('priority', 0)
+                ->orderBy('issued_at')
+                ->orderBy('id'),
+            CallMode::Any => $this->shouldServeNormalFirst($queueId)
+                ? $query->where('priority', 0)->orderBy('issued_at')->orderBy('id')
+                : $query->orderByDesc('priority')->orderBy('issued_at')->orderBy('id'),
+        };
+    }
+
+    /**
+     * Whether the last three calls were priority tickets while a normal ticket
+     * is still waiting, in which case the next call must serve a normal ticket.
+     */
+    private function shouldServeNormalFirst(int $queueId): bool
+    {
+        $recent = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->whereNotNull('called_at')
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->get(['id', 'priority']);
+
+        if ($recent->count() < 3 || ! $recent->every(fn (Ticket $ticket): bool => $ticket->priority > 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
