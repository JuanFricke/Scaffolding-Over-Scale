+
+test('appends discord user mention when mention_id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    $mentionId = '123456789012345678'; // Valid 18-digit snowflake
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something happened');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n<@123456789012345678>");
+    });
+});
+
+test('does not add mention when mention_id is null or empty', function (?string $mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
