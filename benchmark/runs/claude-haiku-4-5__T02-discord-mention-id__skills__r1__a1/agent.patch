+test('reserves space for mention within 1800 character limit', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    $mentionId = '123456789012345678';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    // Create a very long alert that would exceed 1800 when including the mention
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) use ($mentionId) {
+        $content = $request['content'] ?? '';
+        // 1800 total limit minus mention length (20 chars for newline + <@...>)
+        // The mention is "\n<@123456789012345678>" which is 21 characters
+        $expectedMentionLength = 21; // \n + <@> + 18 digits
+        $maxContentPart = 1800 - $expectedMentionLength;
+
