diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..5ff2725 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -25,6 +25,8 @@ class DiscordOpsAlert
 
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
 
+    private const string DiscordSnowflakePattern = '/^\d{17,20}$/';
+
     /**
      * @param  array<string, mixed>  $context
      */
@@ -66,7 +68,30 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $mention = $this->getMention();
+        $mentionLength = $mention === '' ? 0 : mb_strlen($mention);
+        $maxContentLength = self::MaxContentLength - $mentionLength;
+
+        $content = mb_substr(implode("\n", $lines), 0, max(0, $maxContentLength));
+
+        return $content.$mention;
+    }
+
+    private function getMention(): string
+    {
+        $mentionId = config('services.discord.mention_id');
+
+        if (! is_string($mentionId) || $mentionId === '') {
+            return '';
+        }
+
+        $mentionId = trim($mentionId);
+
+        if (! preg_match(self::DiscordSnowflakePattern, $mentionId)) {
+            return '';
+        }
+
+        return "\n<@{$mentionId}>";
     }
 
     private function safe(string $key, mixed $value): string
