+            if (preg_match('/^\\d{17,20}$/', $trimmed)) {
+                $mentionId = $trimmed;
+            } else {
+                $mentionId = null;
+            }
+        } else {
+            $mentionId = null;
+        }
+
+        $content = $this->formatContent($title, $message, $context, $mentionId);
 
