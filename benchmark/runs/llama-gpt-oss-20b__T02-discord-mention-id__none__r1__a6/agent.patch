+        if ($mentionId !== null) {
+            $mention = "\n<@{$mentionId}>";
+            // Reserve space for the mention. Truncate the base content further if needed.
+            $maxBaseLength = self::MaxContentLength - strlen($mention);
+            $contentWithoutMention = mb_substr($contentWithoutMention, 0, $maxBaseLength);
