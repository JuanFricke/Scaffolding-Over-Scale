+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /** Consecutive priority calls after which a waiting normal ticket goes next. */
+    private const FAIRNESS_STREAK = 3;
+
+    /**
+     * Call the next waiting ticket of the queue for the given mode.
+     *
+     * The caller is trusted: authorization is out of scope here.
+     *
+     * @throws InactiveQueueException when the queue is inactive
+     * @throws NoWaitingTicketsException when no ticket is eligible for the mode
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read the state from the database under lock, never from the
+            // (possibly stale) passed instance.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            // Ticket::call() does not lock the queue, so a candidate may have
+            // been called concurrently: re-check it under its own lock and
+            // skip it (never retry the same id) when it is gone.
+            $skipped = [];
+
+            while (($candidate = $this->pick($lockedQueue, $mode, $skipped)) !== null) {
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    $skipped[] = $candidate->id;
+
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+
+            throw new NoWaitingTicketsException('No waiting ticket is eligible to be called.');
+        });
+    }
+
+    /**
+     * @param  list<int>  $skipped
+     */
+    private function pick(Queue $queue, CallMode $mode, array $skipped): ?Ticket
+    {
+        $waiting = fn (): Builder => Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->whereNotIn('id', $skipped);
+
+        $normals = fn (): Builder => $waiting()
+            ->where('priority', 0)
+            ->orderBy('issued_at')
+            ->orderBy('id');
+
+        if ($mode === CallMode::NormalOnly) {
+            return $normals()->first();
+        }
+
+        $ordered = fn (): Builder => $waiting()
+            ->when($mode === CallMode::PriorityOnly, fn (Builder $q) => $q->where('priority', '>', 0))
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+
+        if ($mode === CallMode::Any && $this->priorityStreakReached($queue)) {
+            return $normals()->first() ?? $ordered()->first();
+        }
+
+        return $ordered()->first();
+    }
+
+    /** Whether the last calls in the queue were all priority tickets. */
+    private function priorityStreakReached(Queue $queue): bool
+    {
+        $last = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::FAIRNESS_STREAK)
+            ->pluck('priority');
+
+        return $last->count() === self::FAIRNESS_STREAK
+            && $last->every(fn (int $priority): bool => $priority > 0);
+    }
+}
