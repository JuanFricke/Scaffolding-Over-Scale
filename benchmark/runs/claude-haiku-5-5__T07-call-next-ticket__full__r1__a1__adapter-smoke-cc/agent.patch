+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /** A normal ticket may wait behind at most this many consecutive priority calls. */
+    private const MAX_PRIORITY_STREAK = 3;
+
+    /**
+     * Call the next waiting ticket of the queue, chosen by the given mode.
+     *
+     * Authorization is not checked here; the caller must be trusted.
+     *
+     * @throws InactiveQueueException when the queue is inactive (read from the database).
+     * @throws NoWaitingTicketsException when no ticket is eligible for the mode.
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Queue-row lock serializes calls with issuance and deactivation, and
+            // keeps the fairness history stable while the winner is chosen.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $normalOnly = $mode === CallMode::NormalOnly
+                || ($mode === CallMode::Any && $this->fairnessRequiresNormal($lockedQueue->id));
+
+            $skipped = [];
+
+            while (true) {
+                $candidateId = $this->candidates($lockedQueue->id, $mode, $normalOnly)
+                    ->whereNotIn('id', $skipped)
+                    ->value('id');
+
+                if ($candidateId === null) {
+                    throw new NoWaitingTicketsException('No waiting ticket is eligible for this call.');
+                }
+
+                // Ticket::call() does not take the queue lock, so re-check the
+                // candidate under its own row lock and skip it if it was called meanwhile.
+                $ticket = Ticket::query()
+                    ->whereKey($candidateId)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket?->status === TicketStatus::Waiting) {
+                    $ticket->status = TicketStatus::Called;
+                    $ticket->called_at = now();
+                    $ticket->called_by_user_id = $calledBy->id;
+                    $ticket->save();
+
+                    return $ticket;
+                }
+
+                $skipped[] = $candidateId;
+            }
+        });
+    }
+
+    /**
+     * Waiting tickets of the queue in call order, filtered by mode.
+     *
+     * @return Builder<Ticket>
+     */
+    private function candidates(int $queueId, CallMode $mode, bool $normalOnly): Builder
+    {
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->when($mode === CallMode::PriorityOnly, fn (Builder $query) => $query->where('priority', '>', 0))
+            ->when($normalOnly, fn (Builder $query) => $query->where('priority', 0))
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+    }
+
+    /**
+     * True when the last MAX_PRIORITY_STREAK calls were all priority and a normal ticket is waiting.
+     */
+    private function fairnessRequiresNormal(int $queueId): bool
+    {
+        $recentCalls = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::MAX_PRIORITY_STREAK)
+            ->get(['priority']);
+
+        if ($recentCalls->count() < self::MAX_PRIORITY_STREAK
+            || ! $recentCalls->every(fn (Ticket $ticket) => $ticket->priority > 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
