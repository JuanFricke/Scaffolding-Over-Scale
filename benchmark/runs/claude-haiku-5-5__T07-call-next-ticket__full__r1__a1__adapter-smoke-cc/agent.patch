@@ -0,0 +1,236 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->attendant = User::factory()->create();
+    $this->queue = Queue::factory()->create(['is_active' => true]);
+});
+
+function makeCallTestTicket(Queue $queue, int $priority = 0, ?DateTimeInterface $issuedAt = null): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'issued_at' => $issuedAt ?? now(),
+    ]);
+}
+
+it('calls the highest priority first, then the oldest, then the lowest id', function () {
+    $oldNormal = makeCallTestTicket($this->queue, 0, now()->subMinutes(5));
+    $tieA = makeCallTestTicket($this->queue, 0, now()->subMinute());
+    $tieB = makeCallTestTicket($this->queue, 0, now()->subMinute());
+    $olderPriority = makeCallTestTicket($this->queue, 10, now()->subMinutes(3));
+    $topPriority = makeCallTestTicket($this->queue, 20, now());
+
+    $order = collect(range(1, 5))
+        ->map(fn () => (new CallNextTicket)($this->queue, $this->attendant)->id)
+        ->all();
+
+    expect($order)->toBe([
+        $topPriority->id,
+        $olderPriority->id,
+        $oldNormal->id,
+        $tieA->id,
+        $tieB->id,
+    ]);
+});
+
+it('ignores tickets of other queues and tickets already called', function () {
+    $otherQueue = Queue::factory()->create(['is_active' => true]);
+    makeCallTestTicket($otherQueue, 20, now()->subHour());
+
+    Ticket::factory()->forQueue($this->queue)->create([
+        'priority' => 20,
+        'status' => TicketStatus::Called,
+        'issued_at' => now()->subHour(),
+        'called_at' => now()->subMinute(),
+        'called_by_user_id' => $this->attendant->id,
+    ]);
+
+    $waiting = makeCallTestTicket($this->queue, 0, now());
+
+    $called = (new CallNextTicket)($this->queue, $this->attendant);
+
+    expect($called->is($waiting))->toBeTrue();
+});
+
+it('calls only priority tickets in priority_only mode', function () {
+    $normal = makeCallTestTicket($this->queue, 0, now()->subHour());
+    $priority = makeCallTestTicket($this->queue, 10, now());
+
+    $called = (new CallNextTicket)($this->queue, $this->attendant, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue()
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls only normal tickets in normal_only mode', function () {
+    $priority = makeCallTestTicket($this->queue, 10, now()->subHour());
+    $normal = makeCallTestTicket($this->queue, 0, now());
+
+    $called = (new CallNextTicket)($this->queue, $this->attendant, CallMode::NormalOnly);
+
+    expect($called->is($normal))->toBeTrue()
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('throws when no ticket is eligible for the requested mode and changes nothing', function () {
+    expect(fn () => (new CallNextTicket)($this->queue, $this->attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    $normal = makeCallTestTicket($this->queue, 0);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->attendant, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('rejects calling from an inactive queue read from the database', function () {
+    $ticket = makeCallTestTicket($this->queue, 10);
+    $stale = Queue::query()->findOrFail($this->queue->id);
+
+    $this->queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $this->attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('marks the winner called and returns the updated ticket', function () {
+    $ticket = makeCallTestTicket($this->queue, 10);
+
+    $called = (new CallNextTicket)($this->queue, $this->attendant);
+
+    expect($called)
+        ->toBeInstanceOf(Ticket::class)
+        ->status->toBe(TicketStatus::Called)
+        ->called_at->not->toBeNull()
+        ->called_by_user_id->toBe($this->attendant->id)
+        ->priority->toBe(10);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($this->attendant->id)
+        ->called_at->not->toBeNull();
+});
+
+it('never calls the same ticket twice', function () {
+    $first = makeCallTestTicket($this->queue, 0, now()->subMinutes(2));
+    $second = makeCallTestTicket($this->queue, 0, now()->subMinute());
+
+    $calls = [
+        (new CallNextTicket)($this->queue, $this->attendant)->id,
+        (new CallNextTicket)($this->queue, $this->attendant)->id,
+    ];
+
+    expect($calls)->toBe([$first->id, $second->id]);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('restricts to normal after three consecutive priority calls when a normal waits', function () {
+    $p1 = makeCallTestTicket($this->queue, 10, now()->subMinutes(10));
+    $p2 = makeCallTestTicket($this->queue, 10, now()->subMinutes(9));
+    $p3 = makeCallTestTicket($this->queue, 10, now()->subMinutes(8));
+    $p4 = makeCallTestTicket($this->queue, 10, now()->subMinutes(7));
+    $normal = makeCallTestTicket($this->queue, 0, now()->subMinutes(20));
+
+    $order = collect(range(1, 5))
+        ->map(fn () => (new CallNextTicket)($this->queue, $this->attendant)->id)
+        ->all();
+
+    expect($order)->toBe([$p1->id, $p2->id, $p3->id, $normal->id, $p4->id]);
+});
+
+it('keeps calling priority tickets when no normal is waiting', function () {
+    $p1 = makeCallTestTicket($this->queue, 10, now()->subMinutes(4));
+    $p2 = makeCallTestTicket($this->queue, 10, now()->subMinutes(3));
+    $p3 = makeCallTestTicket($this->queue, 10, now()->subMinutes(2));
+    $p4 = makeCallTestTicket($this->queue, 10, now()->subMinute());
+
+    $order = collect(range(1, 4))
+        ->map(fn () => (new CallNextTicket)($this->queue, $this->attendant)->id)
+        ->all();
+
+    expect($order)->toBe([$p1->id, $p2->id, $p3->id, $p4->id]);
+});
+
+it('does not restrict fairness with fewer than three priority calls', function () {
+    makeCallTestTicket($this->queue, 10, now()->subMinutes(10));
+    makeCallTestTicket($this->queue, 10, now()->subMinutes(9));
+    makeCallTestTicket($this->queue, 10, now()->subMinutes(8));
+    makeCallTestTicket($this->queue, 0, now()->subMinutes(20));
+
+    (new CallNextTicket)($this->queue, $this->attendant);
+    (new CallNextTicket)($this->queue, $this->attendant);
+
+    $third = (new CallNextTicket)($this->queue, $this->attendant);
+
+    expect($third->priority)->toBe(10);
+});
+
+it('counts priority_only calls in the fairness history', function () {
+    $p1 = makeCallTestTicket($this->queue, 10, now()->subMinutes(10));
+    $p2 = makeCallTestTicket($this->queue, 10, now()->subMinutes(9));
+    $p3 = makeCallTestTicket($this->queue, 10, now()->subMinutes(8));
+    $p4 = makeCallTestTicket($this->queue, 10, now()->subMinutes(7));
+    $normal = makeCallTestTicket($this->queue, 0, now()->subMinutes(20));
+
+    collect(range(1, 3))->each(fn () => (new CallNextTicket)($this->queue, $this->attendant, CallMode::PriorityOnly));
+
+    expect((new CallNextTicket)($this->queue, $this->attendant)->is($normal))->toBeTrue()
+        ->and($p4->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('ignores fairness in priority_only mode', function () {
+    $p1 = makeCallTestTicket($this->queue, 10, now()->subMinutes(10));
+    $p2 = makeCallTestTicket($this->queue, 10, now()->subMinutes(9));
+    $p3 = makeCallTestTicket($this->queue, 10, now()->subMinutes(8));
+    $p4 = makeCallTestTicket($this->queue, 10, now()->subMinutes(7));
+    makeCallTestTicket($this->queue, 0, now()->subMinutes(20));
+
+    collect(range(1, 3))->each(fn () => (new CallNextTicket)($this->queue, $this->attendant));
+
+    $called = (new CallNextTicket)($this->queue, $this->attendant, CallMode::PriorityOnly);
+
+    expect($called->is($p4))->toBeTrue();
+});
+
+it('resets the fairness streak after a normal call', function () {
+    $p1 = makeCallTestTicket($this->queue, 10, now()->subMinutes(10));
+    $p2 = makeCallTestTicket($this->queue, 10, now()->subMinutes(9));
+    $p3 = makeCallTestTicket($this->queue, 10, now()->subMinutes(8));
+    $normal = makeCallTestTicket($this->queue, 0, now()->subMinutes(20));
+    $p4 = makeCallTestTicket($this->queue, 10, now()->subMinutes(7));
+    $p5 = makeCallTestTicket($this->queue, 10, now()->subMinutes(6));
+
+    $order = collect(range(1, 6))
+        ->map(fn () => (new CallNextTicket)($this->queue, $this->attendant)->id)
+        ->all();
+
+    expect($order)->toBe([$p1->id, $p2->id, $p3->id, $normal->id, $p4->id, $p5->id]);
+});
+
+it('issues and calls tickets through the real issuance flow', function () {
+    (new IssueTicket)($this->queue, 10);
+    (new IssueTicket)($this->queue, 0);
+
+    $called = (new CallNextTicket)($this->queue, $this->attendant);
+
+    expect($called->code)->toBe('A001')
+        ->and($called->status)->toBe(TicketStatus::Called);
+});
