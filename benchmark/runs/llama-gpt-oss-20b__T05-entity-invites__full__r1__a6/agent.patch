+<?php
+
+namespace App\Mail;
+
+use App\Models\EntityInvite;
+use Illuminate\Mail\Mailable;
+use Illuminate\Mail\Queueable;
+use Illuminate\Support\Facades\Lang;
+
+class EntityInviteMail extends Mailable
+{
+    use Queueable;
+
+    public function __construct(public EntityInvite $invite)
+    {
+        $this->subject(
+            Lang::get('emails.entity_invite.subject', ['entity' => $this->invite->entity->name])
+        );
+    }
+
+    public function build()
+    {
+        return $this->markdown('emails.entity-invite');
+    }
+}
