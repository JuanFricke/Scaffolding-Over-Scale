@@ -0,0 +1,52 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use Illuminate\Support\Facades\Log;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    public function accept(int $inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+        // Only invitee can accept
+        abort_if(strtolower(auth()->user()->email) !== strtolower($invite->email), 403);
+        if ($invite->accepted_at) {
+            return; // idempotent
+        }
+        if ($invite->expires_at->isPast()) {
+            $this->addError('invite', __('entity.invite_expired'));
+            return;
+        }
+        $invite->update(['accepted_at' => now()]);
+        // Create membership
+        $invite->entity->memberships()->create([
+            'user_id' => auth()->id(),
+            'role' => $invite->role,
+        ]);
+        Log::channel('audit')->info('Invite accepted', [
+            'invite_id' => $invite->id,
+            'user_id' => auth()->id(),
+        ]);
+        // TODO: set tenant session and redirect
+    }
+
+    public function decline(int $inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+        abort_if(strtolower(auth()->user()->email) !== strtolower($invite->email), 403);
+        $invite->delete();
+    }
+
+    public function render()
+    {
+        $userEmail = strtolower(auth()->user()->email);
+        $invites = EntityInvite::where('email', $userEmail)
+            ->whereNull('accepted_at')
+            ->where('expires_at', '>', now())
+            ->get();
+        return view('livewire.entity.pending-invites', ['invites' => $invites]);
+    }
+}
