diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..e94bfaf
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,133 @@
+<?php
+
+namespace App\
+Ops;
+
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Config;
+use Illuminate\Support\Str;
+
+class DiscordOpsAlert
+{
+    /**
+     * Send an ops alert to Discord.
+     *
+     * @param  string  $title
+     * @param  string  $message
+     * @param  array   $context
+     * @return void
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = Config::get('services.discord.webhook_url');
+        if (empty($url)) {
+            return;
+        }
+
+        // Build text
+        $lines = [];
+        $lines[] = $title;
+        if ($message !== '') {
+            $lines[] = $message;
+        }
+        foreach ($this->sanitizeContext($context) as $key => $value) {
+            $lines[] = "$key=$value";
+        }
+        $text = implode("\n", $lines);
+
+        // Truncate to 1800 characters multibyte safe
+        if (mb_strlen($text) > 1800) {
+            $text = mb_substr($text, 0, 1800);
+        }
+
+        try {
+            $response = Http::timeout(5)
+                ->asJson()
+                ->post($url, [
+                    'content' => $text,
+                ]);
+
+            if (! $response->successful()) {
+                $status = $response->status();
+                Log::error("Discord ops alert failed", [
+                    'status' => $status,
+                    'title' => $title,
+                    'message' => $message,
+                    'context' => $context,
+                ]);
+            }
+        } catch (\Throwable $e) {
+            // Sanitize exception message to avoid leaking the webhook
+            $sanitized = $this->sanitizeException($e);
+            Log::error("Discord ops alert error", [
+                'exception' => $sanitized,
+                'title' => $title,
+                'message' => $message,
+                'context' => $context,
+            ]);
+        }
+    }
+
+    /**
+     * Redact sensitive keys and values.
+     */
+    private function sanitizeContext(array $data): array
+    {
+        $redactedKeys = [
+            'password',
+            'token',
+            'secret',
+            'authorization',
+            'api_key',
+            'api-key',
+            'apikey',
+            'webhook',
+        ];
+
+        $redacted = [];
+        foreach ($data as $key => $value) {
+            // Key-based redaction
+            $lower = Str::lower($key);
+            $isRedactedKey = false;
+            foreach ($redactedKeys as $k) {
+                if ($lower === Str::lower($k)) {
+                    $isRedactedKey = true;
+                    break;
+                }
+            }
+
+            if ($isRedactedKey) {
+                $redacted[$key] = '[redacted]';
+                continue;
+            }
+
+            // Value-based redaction
+            if (is_string($value)) {
+                if (stripos($value, 'bearer ') !== false || stripos($value, 'Bearer ') !== false) {
+                    $redacted[$key] = '[redacted]';
+                    continue;
+                }
+                $redacted[$key] = $value;
+            } elseif (is_array($value)) {
+                $redacted[$key] = json_encode($this->sanitizeContext($value));
+            } else {
+                $redacted[$key] = $value;
+            }
+        }
+        return $redacted;
+    }
+
+    /**
+     * Remove webhook URL from exception messages.
+     */
+    private function sanitizeException(\Throwable $e): string
+    {
+        $message = (string)$e;
+        $url = Config::get('services.discord.webhook_url');
+        if ($url) {
+            $message = str_replace($url, '[redacted]', $message);
+        }
+        return $message;
+    }
+}
