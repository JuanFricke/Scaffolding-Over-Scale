--- /dev/null
+++ b/tests/Feature/EntityTest.php
@@ -0,0 +1,316 @@
+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Livewire\Entity\Members;
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function member(Entity $entity, string $role = 'employee'): array
+{
+    $m = EntityMembership::factory()->{$role}()->create(['entity_id' => $entity->id]);
+
+    return [$m->user, $m];
+}
+
+test('the database rejects a second owner but allows many admins', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->count(2)->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->owner()->create(); // another entity
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]))
+        ->toThrow(QueryException::class);
+});
+
+test('the database rejects a duplicate membership', function () {
+    $m = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create(['entity_id' => $m->entity_id, 'user_id' => $m->user_id]))
+        ->toThrow(QueryException::class);
+});
+
+test('model helpers', function () {
+    $entity = Entity::factory()->create();
+    [$owner] = member($entity, 'owner');
+
+    expect($entity->owner->user_id)->toBe($owner->id)
+        ->and($owner->membershipFor($entity->id)->role)->toBe(UserRole::Owner)
+        ->and($owner->membershipFor(0))->toBeNull()
+        ->and($owner->entities)->toHaveCount(1)
+        ->and($entity->users)->toHaveCount(1)
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('entity policy', function () {
+    $entity = Entity::factory()->create();
+    [$owner] = member($entity, 'owner');
+    [$admin] = member($entity, 'admin');
+    [$employee] = member($entity);
+    $stranger = User::factory()->create();
+    $p = new EntityPolicy;
+
+    expect($p->create($stranger))->toBeTrue()
+        ->and($p->view($employee, $entity))->toBeTrue()
+        ->and($p->view($stranger, $entity))->toBeFalse()
+        ->and($p->update($admin, $entity))->toBeTrue()
+        ->and($p->update($employee, $entity))->toBeFalse()
+        ->and($p->delete($owner, $entity))->toBeTrue()
+        ->and($p->delete($employee, $entity))->toBeFalse()
+        ->and($p->manageSettings($owner, $entity))->toBeTrue()
+        ->and($p->manageSettings($admin, $entity))->toBeFalse();
+});
+
+test('membership policy', function () {
+    $entity = Entity::factory()->create();
+    [$owner, $ownerM] = member($entity, 'owner');
+    [$admin, $adminM] = member($entity, 'admin');
+    [$employee, $employeeM] = member($entity);
+    $stranger = User::factory()->create();
+    $p = new EntityMembershipPolicy;
+
+    expect($p->view($employee, $ownerM))->toBeTrue()
+        ->and($p->view($stranger, $ownerM))->toBeFalse()
+        ->and($p->assignRole($admin, $employeeM))->toBeTrue()
+        ->and($p->assignRole($employee, $adminM))->toBeFalse()
+        ->and($p->delete($owner, $ownerM))->toBeFalse()
+        ->and($p->delete($admin, $ownerM))->toBeFalse()
+        ->and($p->delete($employee, $employeeM))->toBeTrue()
+        ->and($p->delete($employee, $adminM))->toBeFalse()
+        ->and($p->delete($admin, $employeeM))->toBeTrue()
+        ->and($p->delete($stranger, $employeeM))->toBeFalse();
+});
+
+test('pick stores the entity, audits and redirects', function () {
+    $entity = Entity::factory()->create();
+    [$user] = member($entity);
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once();
+
+    $this->actingAs($user)->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('pick is forbidden for non-members and leaves the session alone', function () {
+    $mine = Entity::factory()->create();
+    [$user] = member($mine);
+    $other = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $mine->id])
+        ->post(route('entity.pick', $other))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->id);
+});
+
+test('pages require authentication and verification', function () {
+    $entity = Entity::factory()->create();
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+
+    $user = User::factory()->unverified()->create();
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))->assertRedirect(route('verification.notice'));
+});
+
+test('dashboard shows settings link and notice only to the owner', function () {
+    $entity = Entity::factory()->create(['name' => 'Acme Ltda']);
+    [$owner] = member($entity, 'owner');
+    [$admin] = member($entity, 'admin');
+
+    $this->actingAs($owner)->get(route('entity.dashboard', $entity))
+        ->assertOk()->assertSee('Acme Ltda')
+        ->assertSee(route('entity.settings', $entity))
+        ->assertSee(route('entity.members', $entity))
+        ->assertSee('Você é o proprietário desta entidade.');
+
+    $this->actingAs($admin)->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertDontSee(route('entity.settings', $entity))
+        ->assertDontSee('Você é o proprietário');
+
+    app()->setLocale('en');
+    $this->actingAs($owner)->get(route('entity.dashboard', $entity))->assertSee('You are the owner of this entity.');
+});
+
+test('non-members get 403 even when the session points at another entity', function () {
+    $mine = Entity::factory()->create();
+    [$user] = member($mine);
+    $other = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $mine->id]);
+
+    foreach (['entity.dashboard', 'entity.members', 'entity.settings'] as $route) {
+        $this->get(route($route, $other))->assertForbidden();
+    }
+    $this->get(route('entity.settings', $mine))->assertForbidden();
+});
+
+test('members can be added, duplicates and unknown users are rejected', function () {
+    $entity = Entity::factory()->create();
+    [$owner] = member($entity, 'owner');
+    $new = User::factory()->create();
+
+    $c = Livewire::actingAs($owner)->test(Members::class, ['entity' => $entity])
+        ->set('email', $new->email)->call('addMember')->assertHasNoErrors();
