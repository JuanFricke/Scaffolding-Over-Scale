new file mode 100644
index 0000000..b7316f1
--- /dev/null
+++ b/app/Livewire/Entity/Members.php
@@ -0,0 +1,146 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        Gate::authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        Gate::authorize('update', $this->entity);
+
+        $validated = $this->validate([
+            'email' => ['required', 'email', 'exists:users,email'],
+        ]);
+
+        $user = User::where('email', $validated['email'])->firstOrFail();
+
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw ValidationException::withMessages(['email' => __('ui.member_already_exists')]);
+        }
+
+        $membership = $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        Log::channel('audit')->info('Entity member added', [
+            'actor_id' => auth()->id(),
+            'entity_id' => $this->entity->id,
+            'membership_id' => $membership->id,
+            'user_id' => $user->id,
+        ]);
+
+        $this->reset('email');
+    }
+
+    public function assignRole(int|string $membershipId, string $role): void
+    {
+        $membership = $this->findMembership($membershipId);
+
+        Gate::authorize('assignRole', $membership);
+
+        Validator::make(['role' => $role], [
+            'role' => ['required', Rule::in(array_column(UserRole::manageable(), 'value'))],
+        ])->validate();
+
+        // The owner's role only changes through ownership transfer.
+        abort_if($membership->role === UserRole::Owner, 403);
+
+        $from = $membership->role;
+        $membership->update(['role' => UserRole::from($role)]);
+
+        Log::channel('audit')->info('Entity member role changed', [
+            'actor_id' => auth()->id(),
+            'entity_id' => $this->entity->id,
+            'membership_id' => $membership->id,
+            'from' => $from->value,
+            'to' => $role,
+        ]);
+    }
+
+    public function removeMember(int|string $membershipId): void
+    {
+        $membership = $this->findMembership($membershipId);
+
+        Gate::authorize('delete', $membership);
+
+        DB::transaction(function () use ($membership) {
+            $isManager = in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+
+            if ($isManager) {
+                $managers = $this->entity->memberships()
+                    ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+                    ->count();
+
+                abort_if($managers <= 1, 403);
+            }
+
+            $membership->delete();
+        });
+
+        Log::channel('audit')->info('Entity member removed', [
+            'actor_id' => auth()->id(),
+            'entity_id' => $this->entity->id,
+            'membership_id' => $membership->id,
+            'user_id' => $membership->user_id,
+        ]);
+
+        if ($membership->user_id === auth()->id()) {
+            if ((int) session('current_entity_id') === $this->entity->id) {
+                session()->forget('current_entity_id');
+            }
+
+            $this->redirectRoute('home');
+        }
+    }
+
+    public function render(): View
+    {
+        $actor = auth()->user();
+
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+            'canManage' => Gate::allows('update', $this->entity),
+            'actorId' => $actor->id,
+            'roles' => UserRole::manageable(),
+        ]);
+    }
+
+    private function findMembership(int|string $membershipId): EntityMembership
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+
+        // A membership of another entity is never reachable from this page.
+        abort_unless($membership->entity_id === $this->entity->id, 403);
+
+        return $membership;
+    }
+}
diff --git a/app/Livewire/Entity/Settings.php b/app/Livewire/Entity/Settings.php
new file mode 100644
index 0000000..4d12427
--- /dev/null
+++ b/app/Livewire/Entity/Settings.php
@@ -0,0 +1,136 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    public $targetMembershipId = null;
+
+    public bool $saved = false;
+
+    public function mount(Entity $entity): void
+    {
+        Gate::authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        Gate::authorize('manageSettings', $this->entity);
+
+        $validated = $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => [
+                'required', 'string', 'max:255', 'alpha_dash:ascii', 'lowercase',
+                Rule::unique('entities', 'slug')->ignore($this->entity->id),
+            ],
+        ]);
+
+        $slugChanged = $validated['slug'] !== $this->entity->slug;
+
+        $this->entity->update($validated);
+
+        Log::channel('audit')->info('Entity settings updated', [
+            'actor_id' => auth()->id(),
+            'entity_id' => $this->entity->id,
+        ]);
+
+        if ($slugChanged) {
+            // The page URL carries the slug, so move to the new one.
+            $this->redirectRoute('entity.settings', ['entity' => $this->entity->slug]);
+
+            return;
+        }
+
+        $this->saved = true;
+    }
+
+    public function delete(): void
+    {
+        Gate::authorize('manageSettings', $this->entity);
+
+        DB::transaction(function () {
+            $this->entity->memberships()->delete();
+            $this->entity->delete();
+        });
+
+        Log::channel('audit')->info('Entity deleted', [
+            'actor_id' => auth()->id(),
+            'entity_id' => $this->entity->id,
+        ]);
+
+        if ((int) session('current_entity_id') === $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirectRoute('home');
+    }
+
+    public function transfer(): void
+    {
+        Gate::authorize('manageSettings', $this->entity);
+
+        abort_unless(is_int($this->targetMembershipId) || ctype_digit((string) $this->targetMembershipId), 403);
+
+        DB::transaction(function () {
+            $owner = $this->entity->memberships()->owner()->lockForUpdate()->first();
+
+            abort_if($owner === null || $owner->user_id !== auth()->id(), 403);
+
+            $target = $this->entity->memberships()
+                ->admin()
+                ->whereKeyNot($owner->id)
+                ->lockForUpdate()
+                ->find((int) $this->targetMembershipId);
+
+            abort_if($target === null, 403);
+
+            // Demote first: the unique owner index allows only one owner at any moment.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+
+            Log::channel('audit')->info('Entity ownership transferred', [
+                'actor_id' => auth()->id(),
+                'entity_id' => $this->entity->id,
+                'from_membership_id' => $owner->id,
+                'to_membership_id' => $target->id,
+            ]);
+        });
+
+        $this->redirectRoute('entity.dashboard', ['entity' => $this->entity->slug]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'admins' => $this->entity->memberships()
+                ->admin()
+                ->where('user_id', '!=', auth()->id())
+                ->with('user')
+                ->orderBy('id')
+                ->get(),
+        ]);
+    }
+}
