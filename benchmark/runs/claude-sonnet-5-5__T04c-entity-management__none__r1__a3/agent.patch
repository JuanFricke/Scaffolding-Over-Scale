+test('removeMember rules', function () {
+    $entity = Entity::factory()->create();
+    [$owner, $ownerM] = member($entity, 'owner');
+    [$admin, $adminM] = member($entity, 'admin');
+    [$employee, $employeeM] = member($entity);
+    [, $foreign] = member(Entity::factory()->create());
+
+    foreach ([$ownerM, $foreign] as $forbidden) {
+        Livewire::actingAs($admin)->test(Members::class, ['entity' => $entity])
+            ->call('removeMember', $forbidden->id)->assertForbidden();
+    }
+    Livewire::actingAs($admin)->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $employeeM->id)->assertHasNoErrors();
+    expect(EntityMembership::find($employeeM->id))->toBeNull();
+
+    // last manager guard (corrupted entity without an owner)
+    $ownerM->delete();
+    Livewire::actingAs($admin)->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $adminM->id)->assertForbidden();
+    expect(EntityMembership::find($adminM->id))->not->toBeNull();
+});
