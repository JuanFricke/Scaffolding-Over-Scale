+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the dashboard shows the entity name to a member', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $entity = $membership->entity;
+    $entity->update(['name' => 'Padaria do Zé']);
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Padaria do Zé');
+});
+
+test('a user who is not a member of the requested entity gets 403, even with a session for another entity', function () {
+    $own = EntityMembership::factory()->owner()->create();
+    $foreign = Entity::factory()->create(['name' => 'Foreign Inc']);
+
+    $this->actingAs($own->user)
+        ->withSession([CurrentEntity::SESSION_KEY => $own->entity_id])
+        ->get(route('entity.dashboard', $foreign))
+        ->assertForbidden();
+});
+
+test('the dashboard is for verified users', function () {
+    $user = User::factory()->unverified()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['user_id' => $user->id, 'entity_id' => $entity->id]);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the dashboard component cannot be re-pointed at another entity by the client', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $foreign = Entity::factory()->create();
+
+    $component = Livewire::actingAs($membership->user)
+        ->test(Dashboard::class, ['entity' => $membership->entity]);
+
+    expect(fn () => $component->set('entity', $foreign))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
diff --git a/tests/Feature/EntityDataModelTest.php b/tests/Feature/EntityDataModelTest.php
