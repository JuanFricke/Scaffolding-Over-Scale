+<?php
+
+namespace App\Tenancy;
+
+use App\Models\EntityMembership;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Reads and writes the entity the user works in (session key `current_entity_id`).
+ * Only the HTTP layer uses this; domain code receives the tenant explicitly.
+ */
+class CurrentEntity
+{
+    public const SESSION_KEY = 'current_entity_id';
+
+    /**
+     * The membership for the session's entity, or null when the session holds none.
+     *
+     * Aborts 403 when the session points at an entity the user no longer belongs to.
+     * The stale pointer is dropped first, so the next request picks an entity again.
+     */
+    public function membership(Request $request): ?EntityMembership
+    {
+        $entityId = $request->session()->get(self::SESSION_KEY);
+
+        if ($entityId === null) {
+            return null;
+        }
+
+        $membership = $request->user()->membershipFor((int) $entityId);
+
+        if ($membership === null) {
+            $request->session()->forget(self::SESSION_KEY);
+
+            abort(403);
+        }
+
+        return $membership;
+    }
+
+    /**
+     * Chooses the entity for a session that holds none. With no memberships the user
+     * goes to onboarding, with several to the switcher. With exactly one, that entity
+     * is stored in the session and returned.
+     */
+    public function choose(Request $request): EntityMembership|RedirectResponse
+    {
+        $entities = $request->user()->entities()->limit(2)->get();
+
+        if ($entities->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($entities->count() > 1) {
+            return redirect()->route('entity.switcher');
+        }
+
+        $membership = $request->user()->membershipFor($entities->first()->id);
+
+        $request->session()->put(self::SESSION_KEY, $membership->entity_id);
+
+        return $membership;
+    }
+}
