+     */
+    public function up(): void
+    {
+        Schema::create('entity_memberships', function (Blueprint $table) {
+            $table->id();
+            $table->foreignId('entity_id')->constrained('entities')->cascadeOnDelete();
+            $table->foreignId('user_id')->constrained('users')->cascadeOnDelete();
+            $table->string('role')->default('employee');
+
+            // 1 for the owner, NULL otherwise. NULLs never collide in a unique index
+            // (SQLite and MariaDB alike), so the index below allows exactly one owner per entity.
+            $table->unsignedTinyInteger('owner_seq')->nullable()->storedAs("case when role = 'owner' then 1 else null end");
