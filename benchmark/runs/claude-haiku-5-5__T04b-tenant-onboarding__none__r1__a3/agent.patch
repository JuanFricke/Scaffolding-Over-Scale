@@ -0,0 +1,54 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may see its member list.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $this->actorRole($user, $membership) !== null;
+    }
+
+    /**
+     * The owner's role only changes through an ownership transfer, so it is never
+     * reassigned here. That keeps every entity at exactly one owner.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $membership->role !== UserRole::Owner
+            && $this->isOwnerOrAdmin($user, $membership);
+    }
+
+    /**
+     * The owner's membership can never be deleted. Anyone may remove their own membership.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->isOwnerOrAdmin($user, $membership);
+    }
+
+    private function isOwnerOrAdmin(User $user, EntityMembership $membership): bool
+    {
+        return in_array($this->actorRole($user, $membership), [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    private function actorRole(User $user, EntityMembership $membership): ?UserRole
+    {
+        return $user->membershipFor($membership->entity_id)?->role;
+    }
+}
