+<?php
+
+namespace App\Http\Controllers;
+
+use App\Tenancy\CurrentEntity;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+
+class HomeController extends Controller
+{
+    /**
+     * Sends the user to the dashboard of their current entity, or to onboarding or the switcher.
+     */
+    public function __invoke(Request $request, CurrentEntity $current): RedirectResponse
+    {
+        $membership = $current->membership($request) ?? $current->choose($request);
+
+        if ($membership instanceof RedirectResponse) {
+            return $membership;
+        }
+
+        return redirect()->route('entity.dashboard', $membership->entity);
+    }
+}
