+<?php
+
+namespace App\Http\Controllers\Entity;
+
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class EntityPickController extends Controller
+{
+    public function __invoke(Request $request, Entity $entity): RedirectResponse
+    {
+        Gate::authorize('view', $entity);
+
+        $request->session()->put(CurrentEntity::SESSION_KEY, $entity->id);
+
+        Log::channel('audit')->info('Entity switched', [
+            'entity_id' => $entity->id,
+            'actor_id' => $request->user()->id,
+        ]);
+
+        return redirect()->route('entity.dashboard', $entity);
+    }
+}
