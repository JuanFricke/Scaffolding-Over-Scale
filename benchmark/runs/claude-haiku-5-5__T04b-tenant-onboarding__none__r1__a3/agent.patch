@@ -0,0 +1,35 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Tenancy\CurrentEntity;
+use App\Tenancy\TenantContext;
+use Closure;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Resolves the user's current entity into the in-request TenantContext (route alias `current_entity`).
+ * Requires the `auth` middleware to run first.
+ */
+class ResolveCurrentEntity
+{
+    public function __construct(
+        private readonly CurrentEntity $current,
+        private readonly TenantContext $tenant,
+    ) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $membership = $this->current->membership($request) ?? $this->current->choose($request);
+
+        if ($membership instanceof RedirectResponse) {
+            return $membership;
+        }
+
+        $this->tenant->set($membership);
+
+        return $next($request);
+    }
+}
diff --git a/app/Livewire/Entity/CreateEntity.php b/app/Livewire/Entity/CreateEntity.php
new file mode 100644
index 0000000..88ced96
--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,106 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    private const MAX_ATTEMPTS = 5;
+
+    /** Slugs that collide with fixed routes (e.g. /e/switcher). */
+    private const RESERVED_SLUGS = ['switcher'];
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->validate();
+
+        $this->authorize('create', Entity::class);
+
+        $name = trim($this->name);
+
+        // The slug is checked, then inserted. A concurrent request can take the same slug
+        // in between, so a unique violation means "pick again", not a failure.
+        for ($attempt = 1; ; $attempt++) {
+            $slug = $this->uniqueSlug($name);
+
+            try {
+                $entity = $this->createOwnedBy(Auth::user()->id, $name, $slug);
+                break;
+            } catch (UniqueConstraintViolationException $exception) {
+                if ($attempt === self::MAX_ATTEMPTS) {
+                    throw $exception;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => Auth::user()->id,
+        ]);
+
+        session()->put(CurrentEntity::SESSION_KEY, $entity->id);
+
+        $this->redirectRoute('entity.dashboard', $entity);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->title(__('ui.onboarding_title'));
+    }
+
+    /**
+     * `acme-corp`, then `acme-corp-2`, `acme-corp-3`, ... Soft-deleted entities keep their
+     * slugs too, because the unique index covers them.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = rtrim(substr(Str::slug($name), 0, 200), '-') ?: 'entity';
+
+        $slug = $base;
+
+        for ($suffix = 2; $this->slugTaken($slug); $suffix++) {
+            $slug = $base.'-'.$suffix;
+        }
+
+        return $slug;
+    }
+
+    private function slugTaken(string $slug): bool
+    {
+        return in_array($slug, self::RESERVED_SLUGS, true)
+            || Entity::withTrashed()->where('slug', $slug)->exists();
+    }
+
+    /**
+     * The creator is always the owner. Entity and membership are written together or not at all.
+     */
+    private function createOwnedBy(int $userId, string $name, string $slug): Entity
+    {
+        return DB::transaction(function () use ($userId, $name, $slug) {
+            $entity = Entity::create(['name' => $name, 'slug' => $slug]);
+
+            $entity->memberships()->create([
+                'user_id' => $userId,
+                'role' => UserRole::Owner,
+            ]);
+
+            return $entity;
+        });
+    }
+}
