+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+function indexNames(string $table): array
+{
+    return collect(Schema::getIndexes($table))->pluck('name')->all();
+}
+
+test('entity slugs are unique under the agreed index name', function () {
+    expect(indexNames('entities'))->toContain('entities_slug_unique');
+
+    Entity::factory()->create(['slug' => 'acme']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('a user has at most one membership per entity', function () {
+    expect(indexNames('entity_memberships'))->toContain('entity_memberships_entity_user_unique');
+
+    $membership = EntityMembership::factory()->employee()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    expect(indexNames('entity_memberships'))->toContain('entity_memberships_one_owner');
+
+    $owner = EntityMembership::factory()->owner()->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->create([
+        'entity_id' => $owner->entity_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('owner_seq is 1 for the owner and NULL for every other role', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(2)->create(['entity_id' => $entity->id]);
+
+    $seqs = DB::table('entity_memberships')
+        ->orderBy('id')
+        ->get(['role', 'owner_seq'])
+        ->map(fn ($row) => [$row->role => $row->owner_seq])
+        ->collapse()
+        ->all();
+
+    expect($seqs)->toBe([
+        'owner' => 1,
+        'admin' => null,
+        'employee' => null,
+        'employee' => null,
+    ]);
+});
+
+test('owners of different entities do not clash', function () {
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect(DB::table('entity_memberships')->where('owner_seq', 1)->count())->toBe(2);
+});
+
+test('the role column defaults to employee', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(DB::table('entity_memberships')->value('role'))->toBe('employee');
+});
+
+test('deleting an entity removes its memberships but soft-deleting does not', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $membership->entity->delete();
+
+    expect(EntityMembership::count())->toBe(1);
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('deleting a user removes their memberships', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('soft-deleted entities drop out of the user relations and membership lookup', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $user = $membership->user;
+
+    expect($user->entities()->count())->toBe(1)
+        ->and($user->membershipFor($membership->entity_id))->not->toBeNull();
+
+    $membership->entity->delete();
+
+    expect($user->fresh()->entities()->count())->toBe(0)
+        ->and($user->fresh()->membershipFor($membership->entity_id))->toBeNull();
+});
+
+test('membershipFor returns null for an entity the user does not belong to', function () {
+    $user = User::factory()->create();
+    $other = EntityMembership::factory()->owner()->create();
+
+    expect($user->membershipFor($other->entity_id))->toBeNull();
+});
+
+test('membership role is cast to UserRole and the scopes filter by it', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect(EntityMembership::query()->owner()->first()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::query()->admin()->count())->toBe(1)
+        ->and(EntityMembership::query()->employee()->count())->toBe(1);
+});
+
+test('UserRole::manageable lists only admin and employee', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee])
+        ->and(UserRole::from('owner'))->toBe(UserRole::Owner);
+});
+
+test('entities are routed by slug', function () {
+    expect((new Entity)->getRouteKeyName())->toBe('slug')
+        ->and(Entity::factory()->create(['slug' => 'acme-corp'])->getRouteKey())->toBe('acme-corp');
+});
+
+test('the owner relation returns the owner membership', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $owner->entity_id]);
+
+    expect($owner->entity->owner()->first()->is($owner))->toBeTrue()
+        ->and($owner->entity->owner->is($owner))->toBeTrue();
+});
+
+test('factories create an entity and a user for each membership', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and(Entity::factory()->make()->slug)->not->toBeEmpty();
+});
diff --git a/tests/Feature/EntityOnboardingTest.php b/tests/Feature/EntityOnboardingTest.php
new file mode 100644
index 0000000..1e53c49
--- /dev/null
+++ b/tests/Feature/EntityOnboardingTest.php
@@ -0,0 +1,200 @@
+<?php
+
+use App\Livewire\Entity\CreateEntity;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Simulates a race: the first slug handed out is already taken by another request.
+ */
+class SlugRacingCreateEntity extends CreateEntity
+{
+    public static array $slugs = [];
+
+    protected function uniqueSlug(string $name): string
+    {
+        return array_shift(self::$slugs);
+    }
+}
+
+test('the onboarding page is for verified users and renders the entity heading', function () {
+    app()->setLocale('pt_BR');
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee(__('ui.onboarding_heading'))
+        ->assertSee('Crie sua empresa');
+});
+
+test('guests are redirected to login from onboarding', function () {
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+});
+
+test('unverified users are sent to email verification from onboarding', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('onboarding'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('creating an entity makes the creator its owner, sets the session and redirects to the dashboard', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $entity = Entity::where('slug', 'acme-corp')->firstOrFail();
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->owner->user_id)->toBe($user->id)
+        ->and($entity->owner->role)->toBe(UserRole::Owner)
+        ->and($entity->memberships()->count())->toBe(1);
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Second Co')
+        ->call('submit')
+        ->assertRedirect(route('entity.dashboard', Entity::where('slug', 'second-co')->first()));
+});
+
+test('the session points at the new entity after onboarding', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user);
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertRedirect(route('entity.dashboard', Entity::where('slug', 'acme-corp')->first()));
+
+    expect(session(CurrentEntity::SESSION_KEY))->toBe(Entity::where('slug', 'acme-corp')->value('id'));
+});
+
+test('creating an entity writes an audit log line', function () {
+    $user = User::factory()->create();
+
+    $channel = Mockery::mock();
+    $channel->shouldReceive('info')
+        ->once()
+        ->with('Entity created', Mockery::on(fn ($context) => $context['actor_id'] === $user->id
+            && is_int($context['entity_id'])));
+    Log::shouldReceive('channel')->with('audit')->andReturn($channel);
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+});
+
+test('slugs get a numeric suffix when the name is taken', function () {
+    $user = User::factory()->create();
+
+    foreach (['Acme Corp', 'Acme Corp', 'Acme Corp'] as $name) {
+        Livewire::actingAs($user)
+            ->test(CreateEntity::class)
+            ->set('name', $name)
+            ->call('submit');
+    }
+
+    expect(Entity::orderBy('id')->pluck('slug')->all())
+        ->toBe(['acme-corp', 'acme-corp-2', 'acme-corp-3']);
+});
+
+test('a soft-deleted entity keeps its slug', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme-corp'])->delete();
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    expect(Entity::where('name', 'Acme Corp')->value('slug'))->toBe('acme-corp-2');
+});
+
+test('the switcher slug is reserved because it is a fixed route', function () {
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', 'Switcher')
+        ->call('submit');
+
+    expect(Entity::value('slug'))->toBe('switcher-2');
+});
+
+test('onboarding retries with a fresh slug when the insert collides with a concurrent request', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    SlugRacingCreateEntity::$slugs = ['acme-corp', 'acme-corp-2'];
+
+    Livewire::actingAs($user)
+        ->test(SlugRacingCreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect(Entity::where('name', 'Acme Corp')->value('slug'))->toBe('acme-corp-2')
+        ->and(Entity::count())->toBe(2)
+        ->and(EntityMembership::where('user_id', $user->id)->value('role'))->toBe(UserRole::Owner);
+});
+
+test('onboarding gives up after repeated slug collisions and leaves nothing behind', function () {
+    $user = User::factory()->create();
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    SlugRacingCreateEntity::$slugs = array_fill(0, 10, 'acme-corp');
+
+    expect(fn () => Livewire::actingAs($user)
+        ->test(SlugRacingCreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit'))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    expect(Entity::count())->toBe(1)
+        ->and(EntityMembership::count())->toBe(0);
+});
+
+test('the name is required', function () {
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', '   ')
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('the entity screens have strings in both locales', function () {
+    foreach (['onboarding_title', 'onboarding_heading', 'entity_name', 'create_entity', 'switch_entity', 'choose_entity', 'entity_dashboard'] as $key) {
+        app()->setLocale('en');
+        $en = __("ui.{$key}");
+        app()->setLocale('pt_BR');
+        $ptBr = __("ui.{$key}");
+
+        expect($en)->not->toBe("ui.{$key}")
+            ->and($ptBr)->not->toBe("ui.{$key}");
+    }
+
+    app()->setLocale('pt_BR');
+
+    expect(__('ui.onboarding_title'))->toBe('Crie sua entidade')
+        ->and(__('ui.switch_entity'))->toBe('Trocar de entidade');
+
+    app()->setLocale('en');
+
+    expect(__('ui.onboarding_title'))->toBe('Create your entity')
+        ->and(__('ui.onboarding_heading'))->toBe('Create your company')
+        ->and(__('ui.switch_entity'))->toBe('Switch entity');
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..839f97e
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,154 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array{User, Entity}
+ */
+function memberOf(string $role): array
+{
+    $membership = EntityMembership::factory()->{$role}()->create();
+
+    return [$membership->user, $membership->entity];
+}
+
+test('policies are discovered for the entity models', function () {
+    expect(Gate::getPolicyFor(Entity::class))->toBeInstanceOf(EntityPolicy::class)
+        ->and(Gate::getPolicyFor(EntityMembership::class))->toBeInstanceOf(EntityMembershipPolicy::class);
+});
+
+test('any authenticated user may create an entity', function () {
+    expect((new EntityPolicy)->create(User::factory()->create()))->toBeTrue();
+});
+
+test('any member may view the entity, outsiders may not', function () {
+    [$employee, $entity] = memberOf('employee');
+    $outsider = User::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->view($employee, $entity))->toBeTrue()
+        ->and($policy->view($outsider, $entity))->toBeFalse();
+});
+
+test('owner and admin may update and delete the entity, employees and outsiders may not', function () {
+    $policy = new EntityPolicy;
+    [$owner, $entity] = memberOf('owner');
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $outsider = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+    EntityMembership::factory()->employee()->create(['entity_id' => $entity->id, 'user_id' => $employee->id]);
+
+    expect($policy->update($owner, $entity))->toBeTrue()
+        ->and($policy->update($admin, $entity))->toBeTrue()
+        ->and($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->update($outsider, $entity))->toBeFalse()
+        ->and($policy->delete($owner, $entity))->toBeTrue()
+        ->and($policy->delete($admin, $entity))->toBeTrue()
+        ->and($policy->delete($employee, $entity))->toBeFalse()
+        ->and($policy->delete($outsider, $entity))->toBeFalse();
+});
+
+test('only the owner may manage entity settings', function () {
+    $policy = new EntityPolicy;
+    [$owner, $entity] = memberOf('owner');
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+
+    expect($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse();
+});
+
+test('any member may view the membership list, outsiders may not', function () {
+    [$employee, $entity] = memberOf('employee');
+    $target = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+    $outsider = User::factory()->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($employee, $target))->toBeTrue()
+        ->and($policy->view($outsider, $target))->toBeFalse();
+});
+
+test('owner and admin may assign roles to other members, employees may not', function () {
+    $policy = new EntityMembershipPolicy;
+    [$owner, $entity] = memberOf('owner');
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+    EntityMembership::factory()->employee()->create(['entity_id' => $entity->id, 'user_id' => $employee->id]);
+    $target = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($policy->assignRole($owner, $target))->toBeTrue()
+        ->and($policy->assignRole($admin, $target))->toBeTrue()
+        ->and($policy->assignRole($employee, $target))->toBeFalse();
+});
+
+test('the owner membership role cannot be reassigned, even by the owner', function () {
+    $policy = new EntityMembershipPolicy;
+    [$owner, $entity] = memberOf('owner');
+    $ownerMembership = $entity->owner;
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+
+    expect($policy->assignRole($owner, $ownerMembership))->toBeFalse()
+        ->and($policy->assignRole($admin, $ownerMembership))->toBeFalse();
+});
+
+test('the owner membership is never deletable, not even by the owner themself', function () {
+    $policy = new EntityMembershipPolicy;
+    [$owner, $entity] = memberOf('owner');
+    $ownerMembership = $entity->owner;
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+
+    expect($policy->delete($owner, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($admin, $ownerMembership))->toBeFalse();
+});
+
+test('anyone may remove their own membership, including an admin', function () {
+    $policy = new EntityMembershipPolicy;
+    [$admin, $entity] = memberOf('admin');
+    $selfMembership = $admin->membershipFor($entity->id);
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($policy->delete($admin, $selfMembership))->toBeTrue()
+        ->and($policy->delete($employee->user, $employee))->toBeTrue();
+});
+
+test('owner and admin may remove other members, employees may not', function () {
+    $policy = new EntityMembershipPolicy;
+    [$owner, $entity] = memberOf('owner');
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+    $employeeMembership = EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $employee->id,
+    ]);
+    $target = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($policy->delete($owner, $target))->toBeTrue()
+        ->and($policy->delete($admin, $target))->toBeTrue()
+        ->and($policy->delete($employee, $target))->toBeFalse()
+        ->and($policy->delete($employee, $employeeMembership))->toBeTrue();
+});
+
+test('an admin may not remove the owner, and outsiders may not remove anyone', function () {
+    $policy = new EntityMembershipPolicy;
+    [, $entity] = memberOf('owner');
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+    $target = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+    $outsider = User::factory()->create();
+
+    expect($policy->delete($outsider, $target))->toBeFalse()
+        ->and($policy->delete($admin, $entity->owner))->toBeFalse();
+});
diff --git a/tests/Feature/EntitySessionTest.php b/tests/Feature/EntitySessionTest.php
new file mode 100644
index 0000000..72b908a
--- /dev/null
+++ b/tests/Feature/EntitySessionTest.php
@@ -0,0 +1,223 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Tenancy\CurrentEntity;
+use App\Tenancy\TenantContext;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array{User, Entity}
+ */
+function userIn(string $role = 'employee'): array
+{
+    $membership = EntityMembership::factory()->{$role}()->create();
+
+    return [$membership->user, $membership->entity];
+}
+
+function joinEntity(User $user, Entity $entity, string $role = 'employee'): void
+{
+    EntityMembership::factory()->{$role}()->create(['user_id' => $user->id, 'entity_id' => $entity->id]);
+}
+
+test('home sends a user with no entities to onboarding', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('home sends a user with one entity straight to its dashboard, whatever their role', function () {
+    [$employee, $entity] = userIn('employee');
+
+    $this->actingAs($employee)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    expect(session(CurrentEntity::SESSION_KEY))->toBe($entity->id);
+});
+
+test('home sends a user with several entities to the switcher', function () {
+    [$user] = userIn();
+    joinEntity($user, Entity::factory()->create());
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('home goes to the dashboard of the entity already in the session', function () {
+    [$user, $first] = userIn();
+    $second = Entity::factory()->create();
+    joinEntity($user, $second, 'owner');
+
+    $this->actingAs($user)
+        ->withSession([CurrentEntity::SESSION_KEY => $second->id])
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $second));
+});
+
+test('a deleted entity does not count as a membership', function () {
+    [$user, $entity] = userIn();
+    $entity->delete();
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('guests are redirected to login from home, the switcher and the dashboard', function () {
+    [, $entity] = userIn();
+
+    $this->get(route('home'))->assertRedirect(route('login'));
+    $this->get(route('entity.switcher'))->assertRedirect(route('login'));
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+});
+
+test('the current_entity middleware sends a user with several entities to the switcher on the dashboard', function () {
+    [$user, $entity] = userIn();
+    joinEntity($user, Entity::factory()->create());
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('the current_entity middleware stores the only entity in the session and runs the request', function () {
+    [$user, $entity] = userIn();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk();
+
+    expect(session(CurrentEntity::SESSION_KEY))->toBe($entity->id);
+});
+
+test('the current_entity middleware sets the in-request tenant from the session', function () {
+    [$user, $entity] = userIn('admin');
+
+    $this->actingAs($user)
+        ->withSession([CurrentEntity::SESSION_KEY => $entity->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk();
+
+    $tenant = app(TenantContext::class);
+
+    expect($tenant->entity()?->is($entity))->toBeTrue()
+        ->and($tenant->membership()->user_id)->toBe($user->id);
+});
+
+test('a session pointing at an entity the user does not belong to gets 403', function () {
+    [$user] = userIn();
+    [, $foreign] = userIn();
+
+    $this->actingAs($user)
+        ->withSession([CurrentEntity::SESSION_KEY => $foreign->id])
+        ->get(route('entity.dashboard', $foreign))
+        ->assertForbidden();
+});
+
+test('the stale session pointer is dropped on 403 so the next visit picks an entity again', function () {
+    [$user, $entity] = userIn();
+    [, $foreign] = userIn();
+
+    $this->actingAs($user)
+        ->withSession([CurrentEntity::SESSION_KEY => $foreign->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertForbidden();
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity));
+});
+
+test('picking an entity sets the session, audits the switch and redirects to its dashboard', function () {
+    [$user, $entity] = userIn();
+    $other = Entity::factory()->create();
+    joinEntity($user, $other, 'admin');
+
+    $channel = Mockery::mock();
+    $channel->shouldReceive('info')
+        ->once()
+        ->with('Entity switched', ['entity_id' => $other->id, 'actor_id' => $user->id]);
+    Log::shouldReceive('channel')->with('audit')->andReturn($channel);
+
+    $this->actingAs($user)
+        ->withSession([CurrentEntity::SESSION_KEY => $entity->id])
+        ->post(route('entity.pick', $other))
+        ->assertRedirect(route('entity.dashboard', $other));
+
+    expect(session(CurrentEntity::SESSION_KEY))->toBe($other->id);
+});
+
+test('picking an entity the user does not belong to is forbidden and leaves the session alone', function () {
+    [$user, $entity] = userIn();
+    [, $foreign] = userIn();
+
+    $this->actingAs($user)
+        ->withSession([CurrentEntity::SESSION_KEY => $entity->id])
+        ->post(route('entity.pick', $foreign))
+        ->assertForbidden();
+
+    expect(session(CurrentEntity::SESSION_KEY))->toBe($entity->id);
+});
+
+test('picking requires a verified user and a POST', function () {
+    [, $entity] = userIn();
+
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+    $this->get("/e/{$entity->slug}/pick")->assertMethodNotAllowed();
+});
+
+test('the switcher lists only the user\'s entities, marks the current one and posts each pick', function () {
+    [$user, $current] = userIn('owner');
+    $admin = Entity::factory()->create(['name' => 'Beta Ltd']);
+    joinEntity($user, $admin, 'admin');
+    $foreign = Entity::factory()->create(['name' => 'Foreign Inc']);
+
+    $response = $this->actingAs($user)
+        ->withSession([CurrentEntity::SESSION_KEY => $current->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee(__('ui.switch_entity'))
+        ->assertSee($current->name)
+        ->assertSee($admin->name)
+        ->assertDontSee($foreign->name);
+
+    $response->assertSee('class="button is-fullwidth is-link" data-current="1"', false)
+        ->assertSee('class="button is-fullwidth is-light"', false)
+        ->assertSee('action="'.route('entity.pick', $admin).'"', false)
+        ->assertSee('action="'.route('entity.pick', $current).'"', false);
+
+    expect(substr_count($response->getContent(), 'data-current'))->toBe(1);
+});
+
+test('the switcher hides deleted entities', function () {
+    [$user] = userIn();
+    $deleted = Entity::factory()->create(['name' => 'Gone Ltd']);
+    joinEntity($user, $deleted);
+    $deleted->delete();
+
+    $this->actingAs($user)
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertDontSee('Gone Ltd');
+});
+
+test('the navbar links to the switcher only for users with more than one entity', function () {
