+    expect(fn () => Queue::factory()->create(['entity_id' => $entity->id, 'slug' => 'guiche']))
+        ->toThrow(QueryException::class);
+
+    // Same slug is allowed in another entity.
+    $other = Entity::factory()->create();
+    Queue::factory()->create(['entity_id' => $other->id, 'slug' => 'guiche']);
+    expect(true)->toBeTrue();
+});
