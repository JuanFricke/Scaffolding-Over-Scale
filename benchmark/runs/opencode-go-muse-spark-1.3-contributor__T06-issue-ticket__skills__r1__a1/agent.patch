+test('ticket can be called exactly once by an entity member', function () {
+    $queue = Queue::factory()->create();
+    $entity = $queue->entity;
+    $member = User::factory()->create();
+    $entity->users()->attach($member->id, ['role' => 'employee']);
+    $outsider = User::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class);
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+
+    $ticket->call($member);
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($member->id);
+
+    expect(fn () => $ticket->call($member))->toThrow(LogicException::class);
+});
