@@ -0,0 +1,46 @@
+<?php
+
+namespace Database\Factories;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<Ticket>
+ */
+class TicketFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * `queue_id` is declared before `code` on purpose: the code closure runs
+     * during attribute expansion, after the nested queue factory has been
+     * created, so `nextCode` sees the tickets already stored for that queue.
+     * An explicit `code` passed to `create()` replaces the closure.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'queue_id' => Queue::factory(),
+            'code' => fn (array $attributes) => Ticket::nextCode($attributes['queue_id']),
+            'priority' => 0,
+            'channel' => TicketChannel::Virtual,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+            'called_at' => null,
+            'called_by_user_id' => null,
+        ];
+    }
+
+    public function forQueue(Queue $queue): static
+    {
+        return $this->state(fn (array $attributes) => [
+            'queue_id' => $queue->getKey(),
+        ]);
+    }
+}
