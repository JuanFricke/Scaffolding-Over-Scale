+test('deleting an entity or queue cascades to queues and tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    $entityId = $queue->entity_id;
+
+    $queue->delete();
+    expect(Ticket::count())->toBe(0);
+
+    $queue2 = Queue::factory()->create(['entity_id' => $entityId]);
+    Ticket::factory()->forQueue($queue2)->create();
+    Entity::find($entityId)->forceDelete(); // hard delete cascades; soft delete keeps rows
+    expect(Queue::where('entity_id', $entityId)->count())->toBe(0)
+        ->and(Ticket::count())->toBe(0);
+});
