--- /dev/null
+++ b/app/Actions/IssueTicket.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+
+class IssueTicket
+{
+    /**
+     * Issue the next ticket in the queue.
+     *
+     * @throws \InvalidArgumentException on negative priority.
+     * @throws InactiveQueueException when the queue is not active.
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new \InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        return DB::transaction(function () use ($queue, $priority, $channel) {
+            // Re-read the queue inside the transaction: the passed instance may be stale.
+            $fresh = Queue::whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+            if (! $fresh->is_active) {
+                throw new InactiveQueueException('Cannot issue a ticket into an inactive queue.');
+            }
+
+            $attempts = 0;
+
+            do {
+                try {
+                    return Ticket::create([
+                        'queue_id' => $fresh->getKey(),
+                        'code' => Ticket::nextCode($fresh->getKey()),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                } catch (QueryException $e) {
+                    if (! $this->isUniqueViolation($e) || ++$attempts >= 5) {
+                        throw $e;
+                    }
+                }
+            } while (true);
+        });
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        // SQLSTATE 23000 = integrity constraint (SQLite + MySQL/MariaDB).
+        return $e->getCode() === '23000'
+            && (str_contains(strtolower($e->getMessage()), 'unique')
+                || str_contains(strtolower($e->getMessage()), 'duplicate'));
+    }
+}
