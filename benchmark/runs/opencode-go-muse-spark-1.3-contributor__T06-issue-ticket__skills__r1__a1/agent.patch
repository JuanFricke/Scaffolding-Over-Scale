+test('issue ticket rejects inactive queue even from a stale model instance', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::find($queue->id);
+
+    Queue::find($queue->id)->update(['is_active' => false]);
+    expect($stale->is_active)->toBeTrue(); // caller holds a stale active copy
+
+    expect(fn () => (new IssueTicket)($stale))->toThrow(InactiveQueueException::class);
+    expect(Ticket::count())->toBe(0);
+});
