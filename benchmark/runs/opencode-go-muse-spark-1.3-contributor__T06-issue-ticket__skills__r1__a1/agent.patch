+test('issue ticket assigns sequential codes with waiting defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $first = (new IssueTicket)($queue);
+    $second = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and($first->status)->toBe(TicketStatus::Waiting)
+        ->and($first->channel)->toBe(TicketChannel::Virtual)
+        ->and($first->priority)->toBe(0)
+        ->and($second->priority)->toBe(10)
+        ->and($second->channel)->toBe(TicketChannel::Totem)
+        ->and($first->issued_at)->not->toBeNull();
+});
