diff --git a/CHANGELOG.md b/CHANGELOG.md
index 4bd35fa..e93953d 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -12,9 +12,13 @@ ### Added
 - Database schema and Mermaid diagram in [`docs/database-schema.md`](docs/database-schema.md).
 - Business rules documentation in [`docs/business-rules.md`](docs/business-rules.md): MVP queue management, entity/subscription, roles (admin, owner, employee), tickets, priorities, fairness (3-ticket rule), deterministic call panel, and channels (Flutter totem, web TV, attendant).
 - This changelog (Keep a Changelog).
+- Observability lanes documented in [`docs/ops/observability.md`](docs/ops/observability.md): archive, audit and alert.
+- `App\Ops\DiscordOpsAlert`: explicit, soft-failing Discord webhook notifier for ops incidents (redacts secrets, truncates to 1800 characters).
+- `audit` logging channel (`storage/logs/audit.log`, `LOG_AUDIT_LEVEL`, `LOG_AUDIT_DAYS`).
 
 ### Changed
 
+- Default log stack is now `daily` (`storage/logs/laravel.log`, `LOG_DAILY_DAYS`) instead of `single`.
 - Documented architecture: PegaFilaWeb is a single repository for frontend, backend and totem API; Flutter remains only as a separate client.
 - Simplified model: ticket is single-use (one call; write-once except `called_at`/`called_by`) — removed `ticket_calls` table; ticket knows only its queue (no `totem_id`). `tickets.priority` is now an integer (higher = more prioritized).
 - Expanded financial model: `billing_accounts` (1:0..1 with entity) + `subscriptions` + `plans` isolate financial data. New tables: `payment_options` (cycle, method, discount, refund window) and `payments` (individual charges). `billing_accounts` has `cpf_cnpj`. Subscription 1:1 with `billing_account_id` (UK); history in `payments`. Added `tickets.code`, explicit unique constraints, and circular FK note for owner. Removed per-queue user access limit.
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..d5f53bd
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,111 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Stringable;
+use Throwable;
+
+/**
+ * Pages humans about actionable production incidents through a Discord webhook.
+ *
+ * This is an explicit call made by code that has decided an incident is worth
+ * waking someone up for. It is not a Monolog channel. It soft-fails: a broken
+ * alert is logged and never breaks the job, webhook or handler that raised it.
+ */
+class DiscordOpsAlert
+{
+    // Discord rejects message content above 2000 characters; keep a safety margin.
+    private const MAX_LENGTH = 1800;
+
+    private const TIMEOUT_SECONDS = 5;
+
+    private const REDACTED = '[redacted]';
+
+    private const SENSITIVE_KEY = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const BEARER = '/\bbearer\s+\S+/i';
+
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = $this->webhookUrl();
+
+        if ($url === null) {
+            return;
+        }
+
+        try {
+            $response = Http::timeout(self::TIMEOUT_SECONDS)
+                ->asJson()
+                ->post($url, ['content' => $this->compose($url, $title, $message, $context)]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (Throwable $e) {
+            Log::error('Discord ops alert failed', [
+                'exception' => $e::class,
+                'error' => $this->scrub($e->getMessage(), $url),
+            ]);
+        }
+    }
+
+    private function webhookUrl(): ?string
+    {
+        $url = config('services.discord.webhook_url');
+
+        return is_string($url) && trim($url) !== '' ? $url : null;
+    }
+
+    private function compose(string $url, string $title, string $message, array $context): string
+    {
+        $lines = [$this->sanitize($title, $url), $this->sanitize($message, $url)];
+
+        foreach ($this->redact($context, $url) as $key => $value) {
+            $lines[] = $key.'='.$this->render($value);
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH, 'UTF-8');
+    }
+
+    private function redact(array $data, string $url): array
+    {
+        foreach ($data as $key => $value) {
+            $data[$key] = match (true) {
+                preg_match(self::SENSITIVE_KEY, (string) $key) === 1 => self::REDACTED,
+                is_array($value) => $this->redact($value, $url),
+                is_string($value) => $this->sanitize($value, $url),
+                default => $value,
+            };
+        }
+
+        return $data;
+    }
+
+    private function render(mixed $value): string
+    {
+        return match (true) {
+            is_array($value) => (string) json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR),
+            is_bool($value) => $value ? 'true' : 'false',
+            $value === null => 'null',
+            is_scalar($value), $value instanceof Stringable => (string) $value,
+            default => get_debug_type($value),
+        };
+    }
+
+    private function sanitize(string $text, string $url): string
+    {
+        $leaksCredential = preg_match(self::BEARER, $text) === 1 || str_contains($text, $url);
+
+        return $leaksCredential ? self::REDACTED : $text;
+    }
+
+    private function scrub(string $text, string $url): string
+    {
+        $text = str_replace($url, self::REDACTED, $text);
+        $text = preg_replace('#/api/webhooks/\S+#', '/api/webhooks/'.self::REDACTED, $text) ?? self::REDACTED;
+
+        return $this->sanitize($text, $url);
+    }
+}
