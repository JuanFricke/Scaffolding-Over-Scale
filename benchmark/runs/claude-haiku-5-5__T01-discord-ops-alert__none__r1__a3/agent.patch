diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..d468d36
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,102 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => 'https://discord.com/api/webhooks/123456/super-secret-token']);
+});
+
+test('sends nothing when the webhook is not configured', function (?string $url) {
+    config(['services.discord.webhook_url' => $url]);
+    Http::fake();
+    Log::spy();
+
+    app(DiscordOpsAlert::class)->send('Job failed', 'Retries exhausted', ['entity_id' => 42]);
+
+    Http::assertNothingSent();
+    Log::shouldNotHaveReceived('error');
+})->with([null, '']);
+
+test('posts the alert as a json content body to the configured webhook', function () {
+    Http::fake(['discord.com/*' => Http::response(null, 204)]);
+
+    app(DiscordOpsAlert::class)->send('Queue job failed', 'Retries exhausted', ['entity_id' => 42]);
+
+    Http::assertSent(fn (Request $request) => $request->method() === 'POST'
+        && $request->url() === 'https://discord.com/api/webhooks/123456/super-secret-token'
+        && $request->isJson()
+        && $request->data() === ['content' => "Queue job failed\nRetries exhausted\nentity_id=42"]);
+});
+
+test('joins title, message and context lines without a context when none is given', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message');
+
+    Http::assertSent(fn (Request $request) => $request['content'] === "Title\nMessage");
+});
+
+test('truncates multibyte text to exactly 1800 characters', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Title', str_repeat('é', 5000));
+
+    Http::assertSent(fn (Request $request) => mb_strlen($request['content']) === 1800
+        && str_starts_with($request['content'], "Title\nééé"));
+});
+
+test('redacts sensitive keys, bearer credentials and nested secrets while keeping plain values', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Gateway webhook failing', 'Asaas rejected the event', [
+        'queue' => 'asaas-webhooks',
+        'password' => 'hunter2',
+        'api-key' => 'abc',
+        'Authorization' => 'Basic xyz',
+        'webhook_url' => 'https://example.test/hook',
+        'header' => 'Bearer abc.def',
+        'payload' => ['access_token' => 'zzz', 'entity_id' => 7],
+    ]);
+
+    Http::assertSent(fn (Request $request) => $request['content'] === implode("\n", [
+        'Gateway webhook failing',
+        'Asaas rejected the event',
+        'queue=asaas-webhooks',
+        'password=[redacted]',
+        'api-key=[redacted]',
+        'Authorization=[redacted]',
+        'webhook_url=[redacted]',
+        'header=[redacted]',
+        'payload={"access_token":"[redacted]","entity_id":7}',
+    ]));
+});
+
+test('logs an error with only the status when discord answers non-2xx', function () {
+    Http::fake(['discord.com/*' => Http::response('nope', 500)]);
+    Log::spy();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->with('Discord ops alert failed', ['status' => 500]);
+});
+
+test('catches transport failures and logs them without the webhook url or token', function () {
+    Http::fake(fn () => throw new ConnectionException(
+        'cURL error 28: Operation timed out for https://discord.com/api/webhooks/123456/super-secret-token'
+    ));
+    Log::spy();
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->once()
+        ->withArgs(fn (string $message, array $context) => $message === 'Discord ops alert failed'
+            && ! str_contains(json_encode([$message, $context]), 'super-secret-token')
+            && ! str_contains(json_encode([$message, $context]), 'discord.com/api/webhooks'));
+});
diff --git a/tests/Feature/Ops/LoggingChannelsTest.php b/tests/Feature/Ops/LoggingChannelsTest.php
new file mode 100644
index 0000000..9d0d065
--- /dev/null
+++ b/tests/Feature/Ops/LoggingChannelsTest.php
@@ -0,0 +1,25 @@
+<?php
+
+test('daily archive channel keeps laravel.log for 14 days by default', function () {
+    expect(config('logging.channels.daily.driver'))->toBe('daily')
+        ->and(config('logging.channels.daily.path'))->toEndWith('logs/laravel.log')
+        ->and(config('logging.channels.daily.days'))->toBe(14);
+});
+
+test('audit channel writes to its own rotated file at info level for 90 days', function () {
+    expect(config('logging.channels.audit.driver'))->toBe('daily')
+        ->and(config('logging.channels.audit.path'))->toEndWith('logs/audit.log')
+        ->and(config('logging.channels.audit.level'))->toBe('info')
+        ->and(config('logging.channels.audit.days'))->toBe(90);
+});
+
+test('default stack uses the daily archive channel and not single', function () {
+    $channels = config('logging.channels.stack.channels');
+
+    expect($channels)->toContain('daily')
+        ->and($channels)->not->toContain('single');
+});
+
+test('there is no discord log channel', function () {
+    expect(config('logging.channels'))->not->toHaveKey('discord');
+});
