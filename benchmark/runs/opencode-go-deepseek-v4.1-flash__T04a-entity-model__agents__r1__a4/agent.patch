@@ -0,0 +1,87 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities table has the expected columns and unique slug index', function () {
+    expect(Schema::hasTable('entities'))->toBeTrue()
+        ->and(Schema::hasColumn('entities', 'id'))->toBeTrue()
+        ->and(Schema::hasColumn('entities', 'name'))->toBeTrue()
+        ->and(Schema::hasColumn('entities', 'slug'))->toBeTrue()
+        ->and(Schema::hasColumn('entities', 'created_at'))->toBeTrue()
+        ->and(Schema::hasColumn('entities', 'updated_at'))->toBeTrue()
+        ->and(Schema::hasColumn('entities', 'deleted_at'))->toBeTrue()
+        ->and(Schema::hasIndex('entities', 'entities_slug_unique'))->toBeTrue();
+});
+
+test('entity factory creates a non-empty name and a unique slug', function () {
+    $entities = Entity::factory()->count(3)->create();
+
+    expect($entities->every(fn (Entity $entity) => filled($entity->name)))->toBeTrue()
+        ->and($entities->every(fn (Entity $entity) => filled($entity->slug)))->toBeTrue()
+        ->and($entities->pluck('slug')->unique())->toHaveCount(3);
+});
+
+test('entity slugs are unique at the database level', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))
+        ->toThrow(QueryException::class);
+});
+
+test('entities are soft deleted and route bound by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id)->trashed())->toBeTrue();
+});
+
+test('an entity exposes its memberships users and owner membership', function () {
+    $entity = Entity::factory()->create();
+    $ownerUser = User::factory()->create();
+    $adminUser = User::factory()->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->for($ownerUser)->create();
+    EntityMembership::factory()->admin()->for($entity)->for($adminUser)->create();
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users->pluck('id')->all())->toEqualCanonicalizing([$ownerUser->id, $adminUser->id])
+        ->and($entity->owner()->first()?->is($owner))->toBeTrue()
+        ->and($entity->owner()->first()?->role)->toBe(UserRole::Owner);
+});
+
+test('an entity without an owner returns null from the owner relation', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->owner()->first())->toBeNull();
+});
+
+test('the users relation exposes the membership role on the pivot', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect($entity->users()->first()?->pivot->role)->toBe(UserRole::Admin->value);
+});
+
+test('force deleting an entity cascades to its memberships', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->employee()->for($entity)->create();
+
+    $entity->forceDelete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
