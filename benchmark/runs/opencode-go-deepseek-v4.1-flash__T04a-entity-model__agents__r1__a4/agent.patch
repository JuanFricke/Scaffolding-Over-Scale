+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+test('any authenticated user may create an entity', function () {
+    $user = User::factory()->create();
+
+    expect(Gate::forUser($user)->allows('create', Entity::class))->toBeTrue();
+});
+
+test('any member may view an entity but non-members may not', function () {
+    $entity = Entity::factory()->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $employee = EntityMembership::factory()->employee()->for($entity)->create()->user;
+    $outsider = User::factory()->create();
+    $otherEntityMember = EntityMembership::factory()->owner()->create()->user;
+
+    expect(Gate::forUser($owner)->allows('view', $entity))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('view', $entity))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('view', $entity))->toBeTrue()
+        ->and(Gate::forUser($outsider)->allows('view', $entity))->toBeFalse()
+        ->and(Gate::forUser($otherEntityMember)->allows('view', $entity))->toBeFalse();
+});
+
+test('only owners and admins may update an entity', function () {
+    $entity = Entity::factory()->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $employee = EntityMembership::factory()->employee()->for($entity)->create()->user;
+    $outsider = User::factory()->create();
+    $otherEntityOwner = EntityMembership::factory()->owner()->create()->user;
+
+    expect(Gate::forUser($owner)->allows('update', $entity))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('update', $entity))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('update', $entity))->toBeFalse()
+        ->and(Gate::forUser($outsider)->allows('update', $entity))->toBeFalse()
+        ->and(Gate::forUser($otherEntityOwner)->allows('update', $entity))->toBeFalse();
+});
+
+test('only owners and admins may delete an entity', function () {
+    $entity = Entity::factory()->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $employee = EntityMembership::factory()->employee()->for($entity)->create()->user;
+    $outsider = User::factory()->create();
+
+    expect(Gate::forUser($owner)->allows('delete', $entity))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('delete', $entity))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('delete', $entity))->toBeFalse()
+        ->and(Gate::forUser($outsider)->allows('delete', $entity))->toBeFalse();
+});
+
+test('only the owner may manage entity settings', function () {
+    $entity = Entity::factory()->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $employee = EntityMembership::factory()->employee()->for($entity)->create()->user;
+    $outsider = User::factory()->create();
+    $otherEntityOwner = EntityMembership::factory()->owner()->create()->user;
+
+    expect(Gate::forUser($owner)->allows('manageSettings', $entity))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('manageSettings', $entity))->toBeFalse()
+        ->and(Gate::forUser($employee)->allows('manageSettings', $entity))->toBeFalse()
+        ->and(Gate::forUser($outsider)->allows('manageSettings', $entity))->toBeFalse()
+        ->and(Gate::forUser($otherEntityOwner)->allows('manageSettings', $entity))->toBeFalse();
+});
+
+test('the entity policy can be constructed without arguments', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $policy = new EntityPolicy;
+
+    expect($policy->create($owner))->toBeTrue()
+        ->and($policy->view($owner, $entity))->toBeTrue()
+        ->and($policy->update($owner, $entity))->toBeTrue()
+        ->and($policy->delete($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($owner, $entity))->toBeTrue();
+});
