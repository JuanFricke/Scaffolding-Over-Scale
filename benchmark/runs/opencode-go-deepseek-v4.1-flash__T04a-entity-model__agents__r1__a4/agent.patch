+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity memberships table has the expected columns and indexes', function () {
+    expect(Schema::hasTable('entity_memberships'))->toBeTrue()
+        ->and(Schema::hasColumn('entity_memberships', 'id'))->toBeTrue()
+        ->and(Schema::hasColumn('entity_memberships', 'entity_id'))->toBeTrue()
+        ->and(Schema::hasColumn('entity_memberships', 'user_id'))->toBeTrue()
+        ->and(Schema::hasColumn('entity_memberships', 'role'))->toBeTrue()
+        ->and(Schema::hasColumn('entity_memberships', 'owner_seq'))->toBeTrue()
+        ->and(Schema::hasColumn('entity_memberships', 'created_at'))->toBeTrue()
+        ->and(Schema::hasColumn('entity_memberships', 'updated_at'))->toBeTrue()
+        ->and(Schema::hasIndex('entity_memberships', 'entity_memberships_entity_user_unique'))->toBeTrue()
+        ->and(Schema::hasIndex('entity_memberships', 'entity_memberships_one_owner'))->toBeTrue();
+});
+
+test('membership factory creates an entity and user with the employee role', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->owner_seq)->toBeNull();
+});
+
+test('membership factory states set the matching role', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('the role column defaults to employee at the database level', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    $membership = EntityMembership::firstOrFail();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->owner_seq)->toBeNull();
+});
+
+test('membership roles are cast to the UserRole enum', function () {
+    $membership = EntityMembership::factory()->create(['role' => 'admin']);
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('membership local scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('owner_seq is generated from the role', function () {
+    $owner = EntityMembership::factory()->owner()->create()->refresh();
+    $admin = EntityMembership::factory()->admin()->create()->refresh();
+    $employee = EntityMembership::factory()->employee()->create()->refresh();
+
+    expect($owner->owner_seq)->toBe(1)
+        ->and($admin->owner_seq)->toBeNull()
+        ->and($employee->owner_seq)->toBeNull();
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('different entities may each have an owner', function () {
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    $firstOwner = EntityMembership::factory()->owner()->for($first)->create()->refresh();
+    $secondOwner = EntityMembership::factory()->owner()->for($second)->create()->refresh();
+
+    expect($firstOwner->owner_seq)->toBe(1)
+        ->and($secondOwner->owner_seq)->toBe(1);
+});
+
+test('an entity accepts any number of non-owner memberships', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->count(3)->create();
+
+    expect($entity->memberships()->count())->toBe(5);
+});
+
+test('the same user cannot join the same entity twice', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    expect(fn () => EntityMembership::factory()->admin()->for($entity)->for($user)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('deleting a user cascades to their memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
diff --git a/tests/Feature/EntityMembershipPolicyTest.php b/tests/Feature/EntityMembershipPolicyTest.php
new file mode 100644
index 0000000..4b9d36f
--- /dev/null
+++ b/tests/Feature/EntityMembershipPolicyTest.php
@@ -0,0 +1,99 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+test('any member of the same entity may view a membership', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->employee()->for($entity)->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $employee = EntityMembership::factory()->employee()->for($entity)->create()->user;
+    $outsider = User::factory()->create();
+    $otherEntityMember = EntityMembership::factory()->owner()->create()->user;
+
+    expect(Gate::forUser($owner)->allows('view', $membership))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('view', $membership))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('view', $membership))->toBeTrue()
+        ->and(Gate::forUser($outsider)->allows('view', $membership))->toBeFalse()
+        ->and(Gate::forUser($otherEntityMember)->allows('view', $membership))->toBeFalse();
+});
+
+test('only owners and admins of the entity may assign roles', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->employee()->for($entity)->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $employee = EntityMembership::factory()->employee()->for($entity)->create()->user;
+    $outsider = User::factory()->create();
+    $otherEntityOwner = EntityMembership::factory()->owner()->create()->user;
+
+    expect(Gate::forUser($owner)->allows('assignRole', $membership))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('assignRole', $membership))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('assignRole', $membership))->toBeFalse()
+        ->and(Gate::forUser($outsider)->allows('assignRole', $membership))->toBeFalse()
+        ->and(Gate::forUser($otherEntityOwner)->allows('assignRole', $membership))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    $entity = Entity::factory()->create();
+    $ownerMembership = EntityMembership::factory()->owner()->for($entity)->create();
+    $otherOwner = EntityMembership::factory()->owner()->create()->user;
+
+    expect(Gate::forUser($ownerMembership->user)->allows('delete', $ownerMembership))->toBeFalse()
+        ->and(Gate::forUser($otherOwner)->allows('delete', $ownerMembership))->toBeFalse()
+        ->and(Gate::forUser($otherOwner)->denies('delete', $ownerMembership))->toBeTrue();
+});
+
+test('a member may remove their own non-owner membership', function () {
+    $entity = Entity::factory()->create();
+    $employeeMembership = EntityMembership::factory()->employee()->for($entity)->create();
+    $adminMembership = EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect(Gate::forUser($employeeMembership->user)->allows('delete', $employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($adminMembership->user)->allows('delete', $adminMembership))->toBeTrue();
+});
+
+test('owners and admins may delete other non-owner memberships', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create()->user;
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $employeeMembership = EntityMembership::factory()->employee()->for($entity)->create();
+    $otherAdminMembership = EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect(Gate::forUser($owner)->allows('delete', $employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($owner)->allows('delete', $otherAdminMembership))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('delete', $employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('delete', $otherAdminMembership))->toBeTrue();
+});
+
+test('employees outsiders and members of other entities cannot delete memberships', function () {
+    $entity = Entity::factory()->create();
+    $employeeMembership = EntityMembership::factory()->employee()->for($entity)->create();
+    $targetMembership = EntityMembership::factory()->employee()->for($entity)->create();
+
+    $outsider = User::factory()->create();
+    $otherEntityOwner = EntityMembership::factory()->owner()->create()->user;
+
+    expect(Gate::forUser($employeeMembership->user)->allows('delete', $targetMembership))->toBeFalse()
+        ->and(Gate::forUser($outsider)->allows('delete', $targetMembership))->toBeFalse()
+        ->and(Gate::forUser($otherEntityOwner)->allows('delete', $targetMembership))->toBeFalse();
+});
+
+test('the membership policy can be constructed without arguments', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $owner = EntityMembership::factory()->owner()->for($membership->entity)->create()->user;
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($owner, $membership))->toBeTrue()
+        ->and($policy->assignRole($owner, $membership))->toBeTrue()
+        ->and($policy->delete($owner, $membership))->toBeTrue();
+});
