+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+#[Fillable(['entity_id', 'user_id', 'role'])]
+class EntityMembership extends Model
+{
+    /** @use HasFactory<EntityMembershipFactory> */
+    use HasFactory;
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'role' => UserRole::class,
+        ];
+    }
+
+    /**
+     * The entity the membership belongs to.
+     */
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * The user the membership belongs to.
+     */
+    public function user(): BelongsTo
+    {
+        return $this->belongsTo(User::class);
+    }
+
+    /**
+     * Limit the query to owner memberships.
+     */
+    public function scopeOwner(Builder $query): Builder
+    {
+        return $query->where('role', UserRole::Owner->value);
+    }
+
+    /**
+     * Limit the query to admin memberships.
+     */
+    public function scopeAdmin(Builder $query): Builder
+    {
+        return $query->where('role', UserRole::Admin->value);
+    }
+
+    /**
+     * Limit the query to employee memberships.
+     */
+    public function scopeEmployee(Builder $query): Builder
+    {
+        return $query->where('role', UserRole::Employee->value);
+    }
+}
