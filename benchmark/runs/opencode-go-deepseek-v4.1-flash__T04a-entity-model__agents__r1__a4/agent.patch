+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Determine whether the user can create an entity.
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    /**
+     * Determine whether the user can view the entity.
+     */
+    public function view(User $user, Entity $entity): bool
+    {
+        return $this->membershipFor($user, $entity) !== null;
+    }
+
+    /**
+     * Determine whether the user can update the entity.
+     */
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    /**
+     * Determine whether the user can delete the entity.
+     */
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity);
+    }
+
+    /**
+     * Determine whether the user can manage the entity's settings.
+     */
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $this->membershipFor($user, $entity)?->role === UserRole::Owner;
+    }
+
+    /**
+     * Get the user's membership in the entity.
+     */
+    private function membershipFor(User $user, Entity $entity): ?EntityMembership
+    {
+        return $user->membershipFor($entity->id);
+    }
+
+    /**
+     * Determine whether the user is an owner or admin of the entity.
+     */
+    private function isManager(User $user, Entity $entity): bool
+    {
+        return in_array(
+            $this->membershipFor($user, $entity)?->role,
+            [UserRole::Owner, UserRole::Admin],
+            true,
+        );
+    }
+}
