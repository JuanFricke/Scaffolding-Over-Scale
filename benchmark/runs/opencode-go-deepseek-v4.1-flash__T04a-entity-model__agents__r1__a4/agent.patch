+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('a user exposes memberships entities and the membership for an entity', function () {
+    $user = User::factory()->create();
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    $firstMembership = EntityMembership::factory()->owner()->for($first)->for($user)->create();
+    $secondMembership = EntityMembership::factory()->employee()->for($second)->for($user)->create();
+
+    expect($user->memberships)->toHaveCount(2)
+        ->and($user->entities->pluck('id')->all())->toEqualCanonicalizing([$first->id, $second->id])
+        ->and($user->membershipFor($first->id)?->is($firstMembership))->toBeTrue()
+        ->and($user->membershipFor($second->id)?->is($secondMembership))->toBeTrue();
+});
+
+test('membershipFor returns null when the user does not belong to the entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    expect($user->membershipFor($entity->id))->toBeNull();
+});
+
+test('the user entities relation exposes the membership role on the pivot', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->for($user)->create();
+
+    expect($user->entities()->first()?->pivot->role)->toBe('owner');
+});
