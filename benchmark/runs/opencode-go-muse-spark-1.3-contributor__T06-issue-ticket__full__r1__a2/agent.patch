@@ -0,0 +1,85 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+
+class IssueTicket
+{
+    /**
+     * Maximum attempts to allocate a unique display code on collision.
+     */
+    private const MAX_CODE_ATTEMPTS = 5;
+
+    /**
+     * Create a new class instance.
+     */
+    public function __construct()
+    {
+        //
+    }
+
+    /**
+     * Issue the next ticket in the given queue.
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new \InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        return DB::transaction(function () use ($queue, $priority, $channel) {
+            $fresh = Queue::query()->whereKey($queue->id)->lockForUpdate()->firstOrFail();
+
+            if (! $fresh->is_active) {
+                throw new InactiveQueueException('Cannot issue a ticket into an inactive queue.');
+            }
+
+            $lastError = null;
+
+            for ($attempt = 0; $attempt < self::MAX_CODE_ATTEMPTS; $attempt++) {
+                $code = Ticket::nextCode($fresh->id);
+
+                try {
+                    return Ticket::query()->create([
+                        'queue_id' => $fresh->id,
+                        'code' => $code,
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                } catch (QueryException $e) {
+                    $lastError = $e;
+
+                    if (! self::isUniqueViolation($e)) {
+                        throw $e;
+                    }
+                    // Collision on (queue_id, code): retry with the next code.
+                }
+            }
+
+            throw $lastError;
+        });
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $code = (string) $e->getCode();
+
+        if ($code === '23000') {
+            return true;
+        }
+
+        $message = strtolower($e->getMessage());
+
+        return str_contains($message, 'unique')
+            || str_contains($message, 'duplicate');
+    }
+}
