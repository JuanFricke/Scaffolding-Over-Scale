+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has required columns, unique slug per entity and cascades on entity delete', function () {
+    expect(Schema::hasTable('queues'))->toBeTrue();
+    expect(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+
+    expect(Schema::hasIndex('queues', 'queues_entity_slug_unique'))->toBeTrue();
+
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity, 'entity')->create(['slug' => 'same']);
+    $other = Entity::factory()->create();
+    // Same slug allowed on a different entity.
+    $ok = Queue::factory()->for($other, 'entity')->create(['slug' => 'same']);
+    expect($ok->slug)->toBe('same');
+
+    // Duplicate slug within same entity is rejected.
+    expect(fn () => Queue::factory()->for($entity, 'entity')->create(['slug' => 'same']))
+        ->toThrow(QueryException::class);
+
+    $queueId = $queue->id;
+    $entity->forceDelete();
+    expect(Queue::whereKey($queueId)->exists())->toBeFalse();
+});
+
+test('tickets table has required columns, unique code per queue, suggested index and cascade on queue delete', function () {
+    expect(Schema::hasTable('tickets'))->toBeTrue();
+    expect(Schema::hasColumns('tickets', [
+        'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+        'issued_at', 'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+
+    expect(Schema::hasIndex('tickets', 'tickets_queue_code_unique'))->toBeTrue();
+    expect(Schema::hasIndex('tickets', 'tickets_queue_status_priority_issued_index'))->toBeTrue();
+
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $ticketId = $ticket->id;
+    $queue->delete();
+    expect(Ticket::whereKey($ticketId)->exists())->toBeFalse();
+});
+
+test('queue factory creates its entity, unique slug and is active by default', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity)->toBeInstanceOf(Entity::class);
+    expect($queue->is_active)->toBeTrue();
+    expect($queue->slug)->not->toBeEmpty();
+    expect($queue->entity()->getForeignKeyName())->toBe('entity_id');
+});
+
+test('entity has many queues', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity, 'entity')->create();
+
+    expect($entity->queues)->toHaveCount(1);
+    expect($entity->queues->first()->is($queue))->toBeTrue();
+});
+
+test('ticket factory defaults and sequential codes per queue', function () {
+    $queue = Queue::factory()->create();
+
+    $a = Ticket::factory()->forQueue($queue)->create();
+    $b = Ticket::factory()->forQueue($queue)->create();
+
+    expect($a->code)->toBe('A001');
+    expect($b->code)->toBe('A002');
+
+    expect($a->status)->toBe(TicketStatus::Waiting);
+    expect($a->channel)->toBe(TicketChannel::Virtual);
+    expect($a->priority)->toBe(0);
+    expect($a->issued_at)->not->toBeNull();
+    expect($a->queue_id)->toBe($queue->id);
+    expect($a->queue->is($queue))->toBeTrue();
+});
+
+test('ticket factory keeps an explicit code when given', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X');
+});
+
+test('next code grows beyond 999 without padding limit', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1000');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('next code follows insertion order not string order and skips malformed codes', function () {
+    $queue = Queue::factory()->create();
+
+    // Only malformed present -> A001.
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    // A001 then malformed -> A002.
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+
+    // A999 then A1000 (string order would put A1000 first) -> A1001.
+    $queue2 = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue2)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue2)->create(['code' => 'A1000']);
+    expect(Ticket::nextCode($queue2->id))->toBe('A1001');
+});
+
+test('next code does not reuse numbers of deleted tickets', function () {
+    $queue = Queue::factory()->create();
+    $t1 = Ticket::factory()->forQueue($queue)->create(); // A001
+    Ticket::factory()->forQueue($queue)->create(); // A002
+    $t3 = Ticket::factory()->forQueue($queue)->create(); // A003
+    expect([$t1->code, $t3->code])->toBe(['A001', 'A003']);
+
+    Ticket::where('code', 'A002')->where('queue_id', $queue->id)->delete();
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('issue ticket creates a waiting ticket with defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->status)->toBe(TicketStatus::Waiting);
+    expect($ticket->channel)->toBe(TicketChannel::Virtual);
+    expect($ticket->priority)->toBe(0);
+    expect($ticket->code)->toBe('A001');
+    expect($ticket->issued_at)->not->toBeNull();
+    expect($ticket->called_at)->toBeNull();
+    expect($ticket->called_by_user_id)->toBeNull();
+});
+
+test('issue ticket honors priority and channel arguments', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(10);
+    expect($ticket->channel)->toBe(TicketChannel::Totem);
+});
+
+test('issue ticket rejects negative priority and persists nothing', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))
+        ->toThrow(InvalidArgumentException::class);
+    expect(Ticket::where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('issue ticket rejects inactive queues and persists nothing', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+    expect(Ticket::where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('issue ticket re-reads queue state from the database inside the transaction', function () {
+    $queue = Queue::factory()->create();
+    // Caller holds a stale (still active) model instance.
+    $stale = Queue::find($queue->id);
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($stale))
+        ->toThrow(InactiveQueueException::class);
+    expect(Ticket::where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('issue ticket issues sequential codes', function () {
+    $queue = Queue::factory()->create();
+
+    $first = (new IssueTicket)($queue);
+    $second = (new IssueTicket)($queue, 0, TicketChannel::Printed);
+
+    expect($first->code)->toBe('A001');
+    expect($second->code)->toBe('A002');
+    expect($second->channel)->toBe(TicketChannel::Printed);
+});
+
+test('ticket fields are write-once except call fields', function () {
+    $ticket = Ticket::factory()->create();
+
+    // Mutable: status, called_at, called_by_user_id (via call()).
+    // Immutable: everything else.
+    foreach (['code' => 'A999', 'priority' => 5, 'queue_id' => Queue::factory()->create()->id] as $field => $value) {
+        $copy = Ticket::find($ticket->id);
+        $copy->{$field} = $value;
+        expect(fn () => $copy->save())->toThrow(LogicException::class, null, "field {$field}");
+    }
+
+    $ticket->refresh();
+    expect($ticket->code)->not->toBe('A999');
+});
+
+test('ticket call marks it called with the calling member', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity, 'entity')->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $user->id]);
+    $ticket = (new IssueTicket)($queue);
+
+    $ticket->call($user);
+    $ticket->refresh();
+
+    expect($ticket->status)->toBe(TicketStatus::Called);
+    expect($ticket->called_at)->not->toBeNull();
+    expect($ticket->called_by_user_id)->toBe($user->id);
+    expect($ticket->calledBy->is($user))->toBeTrue();
+});
+
+test('ticket call rejects non-members and leaves the ticket unchanged', function () {
+    $queue = Queue::factory()->create();
+    $outsider = User::factory()->create();
+    $ticket = (new IssueTicket)($queue);
+
+    expect(fn () => $ticket->call($outsider))
+        ->toThrow(AuthorizationException::class);
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Waiting);
+    expect($ticket->called_at)->toBeNull();
+});
+
+test('ticket call is single: calling twice throws', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity, 'entity')->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $user->id]);
+    $ticket = (new IssueTicket)($queue);
+    $ticket->call($user);
+
+    expect(fn () => $ticket->refresh()->call($user))
+        ->toThrow(LogicException::class);
+});
