+    /**
+     * Resolve the code letter for a given priority.
+     */
+    public function prefixForPriority(int $priority): string
+    {
+        // Custom map overrides
+        $customMap = $this->priority_prefix_map ?? [];
+        $key = (string) $priority;
+        if (array_key_exists($key, $customMap)) {
+            return $customMap[$key];
+        }
+
+        // Default mapping based on range
+        if ($priority <= 0) {
+            return self::DEFAULT_PREFIX_MAP[0];
