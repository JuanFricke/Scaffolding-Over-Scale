+name: Tests
+
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+  workflow_call:
+
+jobs:
+  pest:
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Start the local Docker stack
