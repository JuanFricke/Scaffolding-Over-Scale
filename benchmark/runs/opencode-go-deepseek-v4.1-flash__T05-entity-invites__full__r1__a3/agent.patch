diff --git a/tests/Feature/Entity/EntityInviteTest.php b/tests/Feature/Entity/EntityInviteTest.php
new file mode 100644
index 0000000..e824943
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteTest.php
@@ -0,0 +1,76 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity invites table has the required columns and unique constraint', function () {
+    $this->assertTrue(Schema::hasTable('entity_invites'));
+
+    $this->assertTrue(Schema::hasColumns('entity_invites', [
+        'id', 'entity_id', 'invited_by', 'email', 'role', 'expires_at', 'accepted_at', 'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('entity_invites', 'entity_invites_entity_id_email_unique'));
+});
+
+test('entity invite factory creates a pending employee invite that expires in seven days', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->entity)->toBeInstanceOf(Entity::class)
+        ->and($invite->role)->toBe(UserRole::Employee)
+        ->and($invite->accepted_at)->toBeNull()
+        ->and($invite->isPending())->toBeTrue()
+        ->and($invite->expires_at->between(now()->addDays(6), now()->addDays(8)))->toBeTrue();
+});
+
+test('entity invite factory has an expired state', function () {
