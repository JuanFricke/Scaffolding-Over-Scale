+
+test('the pending invite list only shows the signed-in user pending invites', function () {
+    app()->setLocale('en');
+
+    $user = User::factory()->create(['email' => 'Invitee@Example.com']);
+    $invitedEntity = Entity::factory()->create(['name' => 'Inviting Co']);
+    $otherEntity = Entity::factory()->create(['name' => 'Other Co']);
+
+    EntityInvite::factory()->for($invitedEntity)->create(['email' => 'invitee@example.com']);
+    EntityInvite::factory()->for($otherEntity)->expired()->create(['email' => 'invitee@example.com']);
+    EntityInvite::factory()->create(['email' => 'someone.else@example.com']);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->assertSee('Inviting Co')
+        ->assertDontSee('Other Co')
+        ->assertDontSee('someone.else@example.com')
+        ->assertSeeText('Pending invites')
+        ->assertSeeText('Accept')
+        ->assertSeeText('Decline');
+});
+
+test('the invitee accepts an invite and becomes a member with the invited role', function () {
+    $user = User::factory()->create(['email' => 'Invitee@Example.com']);
+    $entity = Entity::factory()->create(['slug' => 'inviting-co']);
+    $invite = EntityInvite::factory()->for($entity)->create([
+        'email' => 'invitee@example.com',
+        'role' => UserRole::Admin->value,
+    ]);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', $entity->slug));
+
+    $membership = EntityMembership::where('entity_id', $entity->id)->where('user_id', $user->id)->first();
+
+    expect($membership)->not->toBeNull()
+        ->and($membership->role)->toBe(UserRole::Admin)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull()
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('accepting an invite twice is idempotent and never duplicates the membership', function () {
