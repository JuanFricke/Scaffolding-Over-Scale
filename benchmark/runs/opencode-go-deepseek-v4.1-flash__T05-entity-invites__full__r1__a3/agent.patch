+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    public function accept($inviteId): void
+    {
+        $invite = EntityInvite::with('entity')->findOrFail($inviteId);
+
+        $this->authorizeInvitee($invite);
+
+        // Idempotent: accepting twice must not error or duplicate a membership.
+        if ($invite->isAccepted()) {
+            return;
+        }
+
+        if ($invite->isExpired()) {
+            $this->addError('invite', __('This invite has expired.'));
+
+            return;
+        }
+
+        $user = auth()->user();
+        $entity = $invite->entity;
+
+        abort_if(! $entity, 404);
+
+        DB::transaction(function () use ($invite, $user) {
+            EntityMembership::firstOrCreate(
+                [
+                    'entity_id' => $invite->entity_id,
+                    'user_id' => $user->id,
+                ],
+                ['role' => $invite->role->value],
+            );
+
+            $invite->update(['accepted_at' => now()]);
+        });
+
+        Log::channel('audit')->info('Entity invite accepted', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $user->id,
+            'invite_id' => $invite->id,
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirect(route('entity.dashboard', $entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorizeInvitee($invite);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Entity invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        $email = Str::lower(trim((string) auth()->user()?->email));
+
+        $invites = EntityInvite::query()
+            ->with('entity')
+            ->pending()
+            ->whereRaw('LOWER(email) = ?', [$email])
+            ->latest('id')
+            ->get();
+
+        return view('livewire.entity.pending-invites', [
+            'invites' => $invites,
+        ]);
+    }
+
+    /**
+     * Only the invited e-mail address may act on the invite.
+     */
+    protected function authorizeInvitee(EntityInvite $invite): void
+    {
+        $email = Str::lower(trim((string) auth()->user()?->email));
+
+        abort_if($email === '' || $email !== Str::lower(trim($invite->email)), 403);
+    }
+}
