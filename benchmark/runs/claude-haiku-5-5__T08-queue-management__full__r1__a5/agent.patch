+<?php
+
+namespace App\Models;
+
+use Database\Factories\QueueAccessFactory;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Attributes\Table;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+/**
+ * Per-queue permissions granted to an employee membership.
+ *
+ * Owners and admins never need a row; only employees are granted access.
+ * Use App\Actions\SetQueueAccess to change grants so they are authorized and audited.
+ */
+#[Table('queue_access')]
+#[Fillable(['entity_membership_id', 'queue_id', 'permissions'])]
+class QueueAccess extends Model
+{
+    /** @use HasFactory<QueueAccessFactory> */
+    use HasFactory;
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'permissions' => 'array',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<EntityMembership, $this>
+     */
+    public function membership(): BelongsTo
+    {
+        return $this->belongsTo(EntityMembership::class, 'entity_membership_id');
+    }
+
+    /**
+     * @return BelongsTo<Queue, $this>
+     */
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+}
