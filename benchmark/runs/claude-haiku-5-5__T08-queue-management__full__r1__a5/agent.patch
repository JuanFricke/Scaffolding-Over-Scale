+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use App\Support\UniqueViolation;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class CreateQueue
+{
+    /**
+     * Create an active queue in the entity.
+     *
+     * The slug defaults to the name and is slugified either way; it is unique
+     * within the entity.
+     *
+     * @throws AuthorizationException when the actor is not an owner or admin of the entity
+     * @throws ValidationException when the name or slug is invalid or the slug is already used in the entity
+     */
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $name = trim($name);
+        $slug = Str::slug($slug ?? $name);
+
+        Validator::make(['name' => $name, 'slug' => $slug], [
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => ['required', 'string', 'max:255', Rule::unique('queues')->where('entity_id', $entity->id)],
+        ])->validate();
+
+        try {
+            return $entity->queues()->create([
+                'name' => $name,
+                'slug' => $slug,
+                'is_active' => true,
+            ]);
+        } catch (QueryException $e) {
+            // Another request took the slug between validation and insert.
+            if (! UniqueViolation::matches($e)) {
+                throw $e;
+            }
+
+            throw ValidationException::withMessages([
+                'slug' => __('validation.unique', ['attribute' => 'slug']),
+            ]);
+        }
+    }
+}
