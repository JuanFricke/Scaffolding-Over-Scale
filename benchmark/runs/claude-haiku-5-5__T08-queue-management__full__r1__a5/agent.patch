diff --git a/app/Policies/QueuePolicy.php b/app/Policies/QueuePolicy.php
new file mode 100644
index 0000000..6c63e4f
--- /dev/null
+++ b/app/Policies/QueuePolicy.php
@@ -0,0 +1,78 @@
+<?php
+
+namespace App\Policies;
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+
+/**
+ * Single source of truth for queue authorization.
+ *
+ * Queues are retired by deactivation, never deleted, so there is no delete ability:
+ * undefined abilities are denied by Gate.
+ */
+class QueuePolicy
+{
+    /**
+     * Determine whether the user can create queues in the entity (owner + admin).
+     */
+    public function create(User $user, Entity $entity): bool
+    {
+        return $this->isManagerOf($user, $entity->id);
+    }
+
+    /**
+     * Determine whether the user can rename, re-slug or (de)activate the queue (owner + admin).
+     */
+    public function update(User $user, Queue $queue): bool
+    {
+        return $this->isManagerOf($user, $queue->entity_id);
+    }
+
+    /**
+     * Determine whether the user can grant or revoke per-queue permissions (owner + admin).
+     */
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->isManagerOf($user, $queue->entity_id);
+    }
+
+    /**
+     * Determine whether the user can call tickets of the queue.
+     *
+     * Owners and admins always can. Anyone else needs a queue_access row for this
+     * queue whose permissions are an array containing `call`.
+     */
+    public function call(User $user, Queue $queue): bool
+    {
+        if ($this->isManagerOf($user, $queue->entity_id)) {
+            return true;
+        }
+
+        $membership = $user->membershipFor($queue->entity_id);
+
+        if ($membership === null) {
+            return false;
+        }
+
+        $access = QueueAccess::query()
+            ->where('entity_membership_id', $membership->id)
+            ->where('queue_id', $queue->id)
+            ->first();
+
+        return is_array($access?->permissions)
+            && in_array(QueuePermission::Call->value, $access->permissions, true);
+    }
+
+    protected function isManagerOf(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
