+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use LogicException;
+
+uses(RefreshDatabase::class);
+
+/**
+ * An employee of the entity; grants `call` on the queue when $granted is true.
+ */
+function callerFor(Queue $queue, bool $granted): User
+{
+    $employee = memberOf($queue->entity, UserRole::Employee);
+
+    if ($granted) {
+        QueueAccess::factory()->create([
+            'entity_membership_id' => $employee->memberships()->firstOrFail()->id,
+            'queue_id' => $queue->id,
+        ]);
+    }
+
+    return $employee;
+}
+
+it('refuses to call next ticket for an employee without a grant in every call mode', function (CallMode $mode) {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue, 0);
+    $employee = callerFor($queue, granted: false);
+
+    expect(fn () => (new CallNextTicket)($queue, $employee, $mode))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Waiting)
+        ->called_by_user_id->toBeNull();
+})->with([
+    'any' => [CallMode::Any],
+    'priority only' => [CallMode::PriorityOnly],
+    'normal only' => [CallMode::NormalOnly],
+]);
+
+it('refuses to call next ticket for outsiders and managers of another entity', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue, 0);
+    $outsider = User::factory()->create();
+    $otherManager = memberOf(Entity::factory()->create(), UserRole::Admin);
+
+    expect(fn () => (new CallNextTicket)($queue, $outsider))->toThrow(AuthorizationException::class);
+    expect(fn () => (new CallNextTicket)($queue, $otherManager))->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('lets an employee with a call grant call next ticket in every mode', function (CallMode $mode, int $priority) {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue, $priority);
+    $employee = callerFor($queue, granted: true);
+
+    $called = (new CallNextTicket)($queue, $employee, $mode);
+
+    expect($called->id)->toBe($ticket->id)
+        ->and($called->called_by_user_id)->toBe($employee->id);
+})->with([
+    'any' => [CallMode::Any, 0],
+    'priority only' => [CallMode::PriorityOnly, 10],
+    'normal only' => [CallMode::NormalOnly, 0],
+]);
+
+it('does not let a call grant on one queue call tickets of another queue', function () {
+    $entity = Entity::factory()->create();
+    $granted = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $other = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($other, 0);
+    $employee = callerFor($granted, granted: true);
+
+    expect(fn () => (new CallNextTicket)($other, $employee))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('reports an inactive queue before authorization when calling next ticket', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $outsider = User::factory()->create();
+
+    expect(fn () => (new CallNextTicket)($queue, $outsider))
+        ->toThrow(InactiveQueueException::class);
+});
+
+it('refuses Ticket::call for an employee without a grant and leaves the ticket waiting', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue, 0);
+    $employee = callerFor($queue, granted: false);
+
+    expect(fn () => $ticket->call($employee))->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('lets an employee with a call grant call a ticket', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue, 0);
+    $employee = callerFor($queue, granted: true);
+
+    $ticket->call($employee);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($employee->id);
+});
+
+it('reports an unauthorized caller before the already-called check on Ticket::call', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue, 0);
+    $manager = memberOf($queue->entity, UserRole::Admin);
+    $ticket->call($manager);
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->fresh()->call($outsider))->toThrow(AuthorizationException::class);
+    expect(fn () => $ticket->fresh()->call($manager))->toThrow(LogicException::class);
+});
+
+it('reports an inactive queue before authorization on Ticket::call', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue, 0);
+    $outsider = User::factory()->create();
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => $ticket->call($outsider))->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('keeps Ticket::call locked to waiting tickets for authorized callers', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue, 0);
+    $manager = memberOf($queue->entity, UserRole::Admin);
+    $ticket->call($manager);
+
+    expect(fn () => $ticket->fresh()->call($manager))->toThrow(LogicException::class);
+});
