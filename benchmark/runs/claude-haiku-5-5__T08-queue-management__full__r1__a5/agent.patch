index 0000000..3b88a8a
--- /dev/null
+++ b/app/Actions/SetQueueAccess.php
@@ -0,0 +1,89 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Set the permissions a membership holds on a queue.
+     *
+     * A non-empty list grants them (creating or replacing the row); an empty list
+     * revokes the row. Grants and revokes are written to the audit channel. A revoke
+     * with no existing row is a no-op and is not audited.
+     *
+     * @param  list<string>  $permissions
+     *
+     * @throws AuthorizationException when the actor is not an owner or admin of the queue's entity
+     * @throws ValidationException when a permission is unknown or the membership and queue are in different entities
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        Validator::make(['permissions' => $permissions], [
+            'permissions' => ['array', 'list'],
+            'permissions.*' => ['string', Rule::enum(QueuePermission::class)],
+        ])->validate();
+
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => 'The membership and the queue must belong to the same entity.',
+            ]);
+        }
+
+        $permissions = array_values(array_unique($permissions));
+
+        if ($permissions === []) {
+            $revoked = QueueAccess::query()
+                ->where('entity_membership_id', $targetMembership->id)
+                ->where('queue_id', $queue->id)
+                ->delete();
+
+            if ($revoked > 0) {
+                Log::channel('audit')->info('queue.access.revoked', [
+                    'actor_id' => $actor->id,
+                    'queue_id' => $queue->id,
+                    'entity_membership_id' => $targetMembership->id,
+                ]);
+            }
+
+            return;
+        }
+
+        // Single atomic statement, so two managers granting at once cannot collide on the unique pair.
+        QueueAccess::query()->upsert(
+            [[
+                'entity_membership_id' => $targetMembership->id,
+                'queue_id' => $queue->id,
+                'permissions' => json_encode($permissions, JSON_THROW_ON_ERROR),
+                'created_at' => now(),
+                'updated_at' => now(),
+            ]],
+            ['entity_membership_id', 'queue_id'],
+            ['permissions', 'updated_at'],
+        );
+
+        Log::channel('audit')->info('queue.access.granted', [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+            'permissions' => $permissions,
+        ]);
+    }
+}
