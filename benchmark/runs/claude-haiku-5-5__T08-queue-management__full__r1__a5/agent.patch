+    Queue::query()->whereKey($byQueue->queue_id)->delete();
+
+    expect(QueueAccess::query()->whereKey([$byMembership->id, $byQueue->id])->count())->toBe(0);
+});
+
+it('casts permissions to an array', function () {
+    $access = QueueAccess::factory()->create(['permissions' => [QueuePermission::Call->value]]);
+
+    expect($access->fresh()->permissions)->toBe(['call']);
+});
+
+it('defaults the factory to a call grant', function () {
+    $access = QueueAccess::factory()->create();
+
+    expect($access->fresh()->permissions)->toBe(['call']);
+});
+
+it('keeps the factory membership and queue in the same entity', function () {
+    $access = QueueAccess::factory()->create();
+
+    expect($access->membership->entity_id)->toBe($access->queue->entity_id);
+});
+
+it('keeps the factory membership and queue in the same entity when the queue is given', function () {
+    $queue = Queue::factory()->create();
+
+    $access = QueueAccess::factory()->create(['queue_id' => $queue->id]);
+
+    expect($access->membership->entity_id)->toBe($queue->entity_id)
+        ->and(DB::table('queue_access')->where('id', $access->id)->value('queue_id'))->toBe($queue->id);
+});
diff --git a/tests/Feature/Queue/QueuePolicyTest.php b/tests/Feature/Queue/QueuePolicyTest.php
new file mode 100644
index 0000000..a49eec3
--- /dev/null
+++ b/tests/Feature/Queue/QueuePolicyTest.php
@@ -0,0 +1,112 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+it('lets owners and admins create, update, manage access to and call on their entity queues', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $gate = Gate::forUser(memberOf($entity, $role));
+
+    expect($gate->allows('create', [Queue::class, $entity]))->toBeTrue()
+        ->and($gate->allows('update', $queue))->toBeTrue()
+        ->and($gate->allows('manageAccess', $queue))->toBeTrue()
+        ->and($gate->allows('call', $queue))->toBeTrue();
+})->with([
+    'owner' => [UserRole::Owner],
+    'admin' => [UserRole::Admin],
+]);
+
+it('denies employees create, update and manageAccess even with a call grant', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $employee->memberships()->firstOrFail()->id,
+        'queue_id' => $queue->id,
+    ]);
+    $gate = Gate::forUser($employee);
+
+    expect($gate->allows('create', [Queue::class, $entity]))->toBeFalse()
+        ->and($gate->allows('update', $queue))->toBeFalse()
+        ->and($gate->allows('manageAccess', $queue))->toBeFalse()
+        ->and($gate->allows('call', $queue))->toBeTrue();
+});
+
+it('denies an employee without a grant every ability', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $gate = Gate::forUser(memberOf($entity, UserRole::Employee));
+
+    expect($gate->allows('create', [Queue::class, $entity]))->toBeFalse()
+        ->and($gate->allows('update', $queue))->toBeFalse()
+        ->and($gate->allows('manageAccess', $queue))->toBeFalse()
+        ->and($gate->allows('call', $queue))->toBeFalse();
+});
+
+it('denies a call grant that is for a different queue of the same entity', function () {
+    $entity = Entity::factory()->create();
+    $granted = Queue::factory()->for($entity)->create();
+    $other = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $employee->memberships()->firstOrFail()->id,
+        'queue_id' => $granted->id,
+    ]);
+
+    expect(Gate::forUser($employee)->allows('call', $granted))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('call', $other))->toBeFalse();
+});
+
+it('denies a grant that lists permissions without call', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $employee->memberships()->firstOrFail()->id,
+        'queue_id' => $queue->id,
+        'permissions' => ['view'],
+    ]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+});
+
+it('denies call when the stored permissions are not an array', function (string $raw) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    $access = QueueAccess::factory()->create([
+        'entity_membership_id' => $employee->memberships()->firstOrFail()->id,
+        'queue_id' => $queue->id,
+    ]);
+    DB::table('queue_access')->where('id', $access->id)->update(['permissions' => $raw]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+})->with([
+    'json string' => ['"call"'],
+    'not json' => ['call'],
+    'json number' => ['1'],
+]);
+
+it('denies members of another entity and outsiders every ability', function (Closure $actorFor) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $gate = Gate::forUser($actorFor($entity));
+
+    expect($gate->allows('create', [Queue::class, $entity]))->toBeFalse()
+        ->and($gate->allows('update', $queue))->toBeFalse()
+        ->and($gate->allows('manageAccess', $queue))->toBeFalse()
+        ->and($gate->allows('call', $queue))->toBeFalse();
+})->with([
+    'admin of another entity' => [fn () => memberOf(Entity::factory()->create(), UserRole::Admin)],
+    'employee of another entity' => [fn () => memberOf(Entity::factory()->create(), UserRole::Employee)],
+    'outsider' => [fn () => User::factory()->create()],
+]);
diff --git a/tests/Feature/Queue/SetQueueAccessTest.php b/tests/Feature/Queue/SetQueueAccessTest.php
new file mode 100644
index 0000000..fac3aad
--- /dev/null
+++ b/tests/Feature/Queue/SetQueueAccessTest.php
@@ -0,0 +1,170 @@
+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Psr\Log\LoggerInterface;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Route the audit channel to a spy so each test can assert on the trail.
+ */
+function auditSpy(): LoggerInterface
+{
+    $audit = Mockery::spy(LoggerInterface::class);
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    return $audit;
+}
+
+it('grants call to an employee on a queue of the same entity', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberOf($entity, UserRole::Employee);
+    $membership = $employee->memberships()->firstOrFail();
+
+    (new SetQueueAccess)($membership, $queue, memberOf($entity, UserRole::Admin), ['call']);
+
+    $access = QueueAccess::query()
+        ->where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->firstOrFail();
+
+    expect($access->permissions)->toBe(['call']);
+});
+
+it('updates the existing grant instead of adding a second row', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $membership = memberOf($entity, UserRole::Employee)->memberships()->firstOrFail();
+    $manager = memberOf($entity, UserRole::Admin);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    expect(QueueAccess::query()->where('queue_id', $queue->id)->count())->toBe(1);
+});
+
+it('stores each permission once', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $membership = memberOf($entity, UserRole::Employee)->memberships()->firstOrFail();
+
+    (new SetQueueAccess)($membership, $queue, memberOf($entity, UserRole::Admin), ['call', 'call']);
+
+    expect(QueueAccess::query()->where('queue_id', $queue->id)->firstOrFail()->permissions)->toBe(['call']);
+});
+
+it('revokes the grant when the permission list is empty', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $membership = memberOf($entity, UserRole::Employee)->memberships()->firstOrFail();
+    $manager = memberOf($entity, UserRole::Admin);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->where('queue_id', $queue->id)->exists())->toBeFalse();
+});
+
+it('logs queue.access.granted with the actor, queue and membership', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $membership = memberOf($entity, UserRole::Employee)->memberships()->firstOrFail();
+    $manager = memberOf($entity, UserRole::Admin);
+    $audit = auditSpy();
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    $audit->shouldHaveReceived('info')
+        ->with('queue.access.granted', Mockery::on(fn (array $context) => $context['actor_id'] === $manager->id
+            && $context['queue_id'] === $queue->id
+            && $context['entity_membership_id'] === $membership->id))
+        ->once();
+});
+
+it('logs queue.access.revoked when an existing grant is removed', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $membership = memberOf($entity, UserRole::Employee)->memberships()->firstOrFail();
+    $manager = memberOf($entity, UserRole::Admin);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    $audit = auditSpy();
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    $audit->shouldHaveReceived('info')
+        ->with('queue.access.revoked', Mockery::on(fn (array $context) => $context['actor_id'] === $manager->id
+            && $context['queue_id'] === $queue->id
+            && $context['entity_membership_id'] === $membership->id))
+        ->once();
+});
+
+it('does not log a revoke when there was no grant to delete', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $membership = memberOf($entity, UserRole::Employee)->memberships()->firstOrFail();
+    $audit = auditSpy();
+
+    (new SetQueueAccess)($membership, $queue, memberOf($entity, UserRole::Admin), []);
+
+    $audit->shouldNotHaveReceived('info');
+});
+
+it('rejects unknown permissions and stores nothing', function (array $permissions) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $membership = memberOf($entity, UserRole::Employee)->memberships()->firstOrFail();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, memberOf($entity, UserRole::Admin), $permissions))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with([
+    'unknown string' => [['delete']],
+    'known and unknown mixed' => [['call', 'manage']],
+    'wrong case' => [['CALL']],
+    'integer entry' => [[1]],
+    'null entry' => [[null]],
+    'nested list' => [[['call']]],
+    'keyed map' => [['grant' => 'call']],
+]);
+
+it('rejects a membership and a queue from different entities', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $foreign = memberOf(Entity::factory()->create(), UserRole::Employee)->memberships()->firstOrFail();
+
+    expect(fn () => (new SetQueueAccess)($foreign, $queue, memberOf($entity, UserRole::Admin), ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('refuses grants from employees (including self-grants), other-entity managers and outsiders', function (Closure $actorFor) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $membership = memberOf($entity, UserRole::Employee)->memberships()->firstOrFail();
+    $actor = $actorFor($entity, $membership);
+    $audit = auditSpy();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $actor, ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+    $audit->shouldNotHaveReceived('info');
+})->with([
+    'employee granting themselves' => [fn (Entity $entity, EntityMembership $membership) => $membership->user],
+    'other employee' => [fn (Entity $entity) => memberOf($entity, UserRole::Employee)],
+    'admin of another entity' => [fn () => memberOf(Entity::factory()->create(), UserRole::Admin)],
+    'outsider' => [fn () => User::factory()->create()],
+]);
diff --git a/tests/Feature/Queue/UpdateQueueTest.php b/tests/Feature/Queue/UpdateQueueTest.php
new file mode 100644
index 0000000..3a54b75
--- /dev/null
+++ b/tests/Feature/Queue/UpdateQueueTest.php
@@ -0,0 +1,169 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('renames a queue and leaves its slug and active flag alone', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral', 'is_active' => true]);
+
+    (new UpdateQueue)($queue, memberOf($entity, UserRole::Admin), name: '  Triagem  ');
+
+    expect($queue->fresh())
+        ->name->toBe('Triagem')
+        ->slug->toBe('geral')
+        ->is_active->toBeTrue();
+});
+
+it('changes the slug, slugifying the explicit value', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral']);
+
+    (new UpdateQueue)($queue, memberOf($entity, UserRole::Owner), slug: 'Caixa Rápido');
+
+    expect($queue->fresh()->slug)->toBe('caixa-rapido');
+});
+
+it('keeps its own slug when the same slug is passed again', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral']);
+
+    (new UpdateQueue)($queue, memberOf($entity, UserRole::Admin), slug: 'geral');
+
+    expect($queue->fresh()->slug)->toBe('geral');
+});
+
+it('rejects taking the slug of another queue in the same entity', function () {
+    $entity = Entity::factory()->create();
+    $manager = memberOf($entity, UserRole::Admin);
+    Queue::factory()->for($entity)->create(['slug' => 'geral']);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'caixa']);
+
+    expect(fn () => (new UpdateQueue)($queue, $manager, slug: 'geral'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->slug)->toBe('caixa');
+});
+
+it('allows taking a slug used by a queue of another entity', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    Queue::factory()->for($other)->create(['slug' => 'geral']);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'caixa']);
+
+    (new UpdateQueue)($queue, memberOf($entity, UserRole::Admin), slug: 'geral');
+
+    expect($queue->fresh()->slug)->toBe('geral');
+});
+
+it('turns a slug collision caught only by the database index into a validation error', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'caixa']);
+
+    // Another request takes the slug between validation and update.
+    Queue::updating(function () use ($entity): void {
+        DB::table('queues')->insert([
+            'entity_id' => $entity->id,
+            'name' => 'Outra',
+            'slug' => 'novo',
+            'is_active' => true,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    });
+
+    try {
+        expect(fn () => (new UpdateQueue)($queue, memberOf($entity, UserRole::Admin), slug: 'novo'))
+            ->toThrow(ValidationException::class);
+    } finally {
+        Queue::flushEventListeners();
+    }
+
+    expect($queue->fresh()->slug)->toBe('caixa');
+});
+
+it('rejects a blank name without writing', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    expect(fn () => (new UpdateQueue)($queue, memberOf($entity, UserRole::Admin), name: ' '))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->name)->toBe('Geral');
+});
+
+it('deactivates a queue and keeps its tickets', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    (new IssueTicket)($queue);
+    (new IssueTicket)($queue, 10);
+
+    (new UpdateQueue)($queue, memberOf($entity, UserRole::Admin), isActive: false);
+
+    expect($queue->fresh()->is_active)->toBeFalse()
+        ->and(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(2);
+});
+
+it('blocks issuing into a deactivated queue until it is reactivated', function () {
+    $entity = Entity::factory()->create();
+    $manager = memberOf($entity, UserRole::Admin);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    (new UpdateQueue)($queue, $manager, isActive: false);
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+
+    (new UpdateQueue)($queue, $manager, isActive: true);
+
+    expect((new IssueTicket)($queue))->toBeInstanceOf(Ticket::class);
+});
+
+it('does nothing when no field is given', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral', 'is_active' => true]);
+
+    $updated = (new UpdateQueue)($queue, memberOf($entity, UserRole::Admin));
+
+    expect($updated->fresh())
+        ->name->toBe('Geral')
+        ->slug->toBe('geral')
+        ->is_active->toBeTrue();
+});
+
+it('refuses employees, managers of another entity and outsiders without writing', function (Closure $actorFor) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'is_active' => true]);
+    $actor = $actorFor($entity, $queue);
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'Hack', isActive: false))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh())
+        ->name->toBe('Geral')
+        ->is_active->toBeTrue();
+})->with([
+    'employee with a call grant' => [function (Entity $entity, Queue $queue) {
+        $employee = memberOf($entity, UserRole::Employee);
+        QueueAccess::factory()->create([
+            'entity_membership_id' => $employee->memberships()->firstOrFail()->id,
+            'queue_id' => $queue->id,
+        ]);
+
+        return $employee;
+    }],
+    'admin of another entity' => [fn () => memberOf(Entity::factory()->create(), UserRole::Admin)],
+    'outsider' => [fn () => User::factory()->create()],
+]);
