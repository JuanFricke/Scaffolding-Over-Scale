+<?php
+
+namespace App\Support;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+
+/**
+ * In-request tenant context: the entity the user is working in and their membership of it.
+ *
+ * Filled by the `current_entity` middleware (the only place that reads the session) and
+ * registered as a scoped binding so it never leaks between requests.
+ */
+class CurrentEntity
+{
+    private ?Entity $entity = null;
+
+    private ?EntityMembership $membership = null;
+
+    public function set(Entity $entity, EntityMembership $membership): void
+    {
+        $this->entity = $entity;
+        $this->membership = $membership;
+    }
+
+    public function entity(): ?Entity
+    {
+        return $this->entity;
+    }
+
+    public function membership(): ?EntityMembership
+    {
+        return $this->membership;
+    }
+}
