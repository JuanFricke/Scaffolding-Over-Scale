@@ -0,0 +1,54 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\User;
+use App\Support\CurrentEntity;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Resolves `session('current_entity_id')` into the in-request {@see CurrentEntity} context.
+ *
+ * This middleware is the only reader of that session key. Must run after `auth`.
+ */
+class EnsureCurrentEntity
+{
+    public function __construct(private CurrentEntity $tenant) {}
+
+    /**
+     * @param  Closure(Request): (Response)  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        /** @var User $user */
+        $user = $request->user();
+        $entityId = $request->session()->get('current_entity_id');
+
+        if ($entityId === null) {
+            $entities = $user->entities()->limit(2)->get();
+
+            if ($entities->isEmpty()) {
+                return redirect()->route('onboarding');
+            }
+
+            if ($entities->count() > 1) {
+                return redirect()->route('entity.switcher');
+            }
+
+            $entityId = $entities->first()->id;
+            $request->session()->put('current_entity_id', $entityId);
+        }
+
+        // Also rejects a stale session pointing at a deleted entity.
+        $membership = $user->membershipFor((int) $entityId);
+        $entity = $membership?->entity;
+
+        abort_if($entity === null, 403);
+
+        $this->tenant->set($entity, $membership);
+
+        return $next($request);
+    }
+}
