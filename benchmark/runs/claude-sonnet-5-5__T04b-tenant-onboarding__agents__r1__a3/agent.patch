+<?php
+
+namespace App\Http\Controllers;
+
+use App\Models\Entity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class EntityController extends Controller
+{
+    /**
+     * Sends the user to the right place for the number of entities they belong to.
+     */
+    public function home(Request $request): RedirectResponse
+    {
+        $entities = $request->user()->entities()->limit(2)->get();
+
+        if ($entities->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($entities->count() > 1) {
+            return redirect()->route('entity.switcher');
+        }
+
+        $request->session()->put('current_entity_id', $entities->first()->id);
+
+        return redirect()->route('entity.dashboard', $entities->first());
+    }
+
+    public function switcher(Request $request): View
+    {
+        return view('entity.switcher', [
+            'entities' => $request->user()->entities()->orderBy('name')->get(),
+            'currentId' => (int) $request->session()->get('current_entity_id'),
+        ]);
+    }
+
+    public function pick(Request $request, Entity $entity): RedirectResponse
+    {
+        Gate::authorize('view', $entity);
+
+        $request->session()->put('current_entity_id', $entity->id);
+
+        Log::channel('audit')->info('Entity picked', [
+            'entity_id' => $entity->id,
+            'actor_id' => $request->user()->id,
+        ]);
+
+        return redirect()->route('entity.dashboard', $entity);
+    }
+}
