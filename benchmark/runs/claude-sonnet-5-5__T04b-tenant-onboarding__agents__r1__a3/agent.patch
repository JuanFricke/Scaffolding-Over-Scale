+<?php
+
+use App\Http\Middleware\EnsureCurrentEntity;
+use App\Livewire\Entity\CreateEntity;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Support\CurrentEntity;
+use Illuminate\Database\QueryException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Http\Request;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function joined(User $user, UserRole $role = UserRole::Employee, array $entity = []): Entity
+{
+    $entity = Entity::factory()->create($entity);
+    EntityMembership::factory()->for($entity)->for($user)->create(['role' => $role]);
+
+    return $entity;
+}
+
+function auditEntries(): array
+{
+    return Event::dispatched(MessageLogged::class)->map(fn ($args) => $args[0])->all();
+}
+
+// --- guests ---------------------------------------------------------------
+
+test('guests are redirected to login from every new page', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+    $this->get(route('entity.switcher'))->assertRedirect(route('login'));
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+});
+
+test('unverified users are sent to e-mail verification', function () {
+    $this->actingAs(User::factory()->unverified()->create());
+    $entity = Entity::factory()->create();
+
+    $this->get(route('onboarding'))->assertRedirect(route('verification.notice'));
+    $this->get(route('entity.switcher'))->assertRedirect(route('verification.notice'));
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('verification.notice'));
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('verification.notice'));
+});
+
+test('the routes have the contracted URLs', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect(route('onboarding', absolute: false))->toBe('/onboarding')
+        ->and(route('entity.switcher', absolute: false))->toBe('/e/switcher')
+        ->and(route('entity.pick', $entity, false))->toBe('/e/acme/pick')
+        ->and(route('entity.dashboard', $entity, false))->toBe('/e/acme');
+});
+
+// --- /home dispatch -------------------------------------------------------
+
+test('home sends a user without entities to onboarding', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('home sends a user with one entity to its dashboard and sets the session, whatever the role', function (UserRole $role) {
+    $user = User::factory()->create();
+    $entity = joined($user, $role);
+    joined(User::factory()->create());
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+})->with([UserRole::Owner, UserRole::Admin, UserRole::Employee]);
+
+test('home sends a user with several entities to the switcher without picking one', function () {
+    $user = User::factory()->create();
+    joined($user);
+    joined($user);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertRedirect(route('entity.switcher'))
+        ->assertSessionMissing('current_entity_id');
+});
+
+// --- current_entity middleware -------------------------------------------
+
+test('with an empty session, one membership is picked automatically', function () {
+    $user = User::factory()->create();
+    $entity = joined($user, UserRole::Employee, ['name' => 'Solo Ltda']);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Solo Ltda')
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('with an empty session and several memberships the middleware sends the user to the switcher', function () {
+    $user = User::factory()->create();
+    $entity = joined($user);
+    joined($user);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('with an empty session and no memberships the middleware sends the user to onboarding', function () {
+    $entity = Entity::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('a session entity the user does not belong to is a 403', function (string $case) {
+    $user = User::factory()->create();
+    $entity = joined($user);
+
+    $id = match ($case) {
+        'someone else' => Entity::factory()->create()->id,
+        'missing' => 999999,
+        'junk' => 'abc',
+        'deleted' => tap(joined($user))->delete()->id,
+    };
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertForbidden();
+})->with(['someone else', 'missing', 'junk', 'deleted']);
+
+test('the middleware fills the in-request tenant context', function () {
+    $user = User::factory()->create();
+    $entity = joined($user, UserRole::Admin);
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $entity->id]);
+
+    $request = Request::create('/x');
+    $request->setLaravelSession(app('session.store'));
+    $request->setUserResolver(fn () => $user);
+
+    app(EnsureCurrentEntity::class)->handle($request, fn () => response('ok'));
+
+    $tenant = app(CurrentEntity::class);
+
+    expect($tenant->entity()->is($entity))->toBeTrue()
+        ->and($tenant->membership()->role)->toBe(UserRole::Admin);
+});
+
+// --- dashboard ------------------------------------------------------------
+
+test('the dashboard shows the entity name to any member', function (UserRole $role) {
+    $user = User::factory()->create();
+    $entity = joined($user, $role, ['name' => 'Padaria Boa']);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $entity->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Padaria Boa')
+        ->assertSee('<title>Padaria Boa', false);
+})->with([UserRole::Owner, UserRole::Admin, UserRole::Employee]);
+
+test('a non-member gets 403 on the dashboard even with a valid session for another entity', function () {
+    $user = User::factory()->create();
+    $mine = joined($user);
+    $theirs = Entity::factory()->create(['name' => 'Segredo SA']);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.dashboard', $theirs))
+        ->assertForbidden()
+        ->assertDontSee('Segredo SA');
+});
+
+test('an unknown or deleted entity slug is a 404', function () {
+    $user = User::factory()->create();
+    $entity = joined($user);
+    $deleted = joined($user);
+    $deleted->delete();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $entity->id]);
+
+    $this->get('/e/nope')->assertNotFound();
+    $this->get(route('entity.dashboard', $deleted))->assertNotFound();
+});
+
+// --- pick -----------------------------------------------------------------
+
+test('picking an entity sets the session, audits it and redirects to its dashboard', function () {
+    Event::fake([MessageLogged::class]);
+    $user = User::factory()->create();
+    joined($user);
+    $entity = joined($user);
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+
+    Event::assertDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->message === 'Entity picked'
+        && $log->context === ['entity_id' => $entity->id, 'actor_id' => $user->id]);
+});
+
+test('picking an entity the user does not belong to is a 403 and leaves the session alone', function () {
+    Event::fake([MessageLogged::class]);
+    $user = User::factory()->create();
+    $mine = joined($user);
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $mine->id])
+        ->post(route('entity.pick', $theirs))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->id);
+
+    Event::assertNotDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->message === 'Entity picked');
+});
+
+test('picking requires POST', function () {
+    $user = User::factory()->create();
+    $entity = joined($user);
+
+    $this->actingAs($user)->get('/e/'.$entity->slug.'/pick')->assertStatus(405);
+});
+
+// --- switcher -------------------------------------------------------------
+
+test('the switcher lists only the user\'s entities, marking the current one', function () {
+    $user = User::factory()->create();
+    $a = joined($user, UserRole::Owner, ['name' => 'Alfa']);
+    $b = joined($user, UserRole::Employee, ['name' => 'Beta']);
+    Entity::factory()->create(['name' => 'Gama Alheia']);
+
+    $html = $this->actingAs($user)
+        ->withSession(['current_entity_id' => $b->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Trocar de entidade')
+        ->assertSee('<form method="POST" action="'.route('entity.pick', $a).'"', false)
+        ->assertSee('<form method="POST" action="'.route('entity.pick', $b).'"', false)
+        ->assertSee('class="button is-fullwidth is-link" data-current="1">Beta</button>', false)
+        ->assertSee('class="button is-fullwidth is-light">Alfa</button>', false)
+        ->assertDontSee('Gama Alheia')
+        ->getContent();
+
+    expect(substr_count($html, 'data-current="1"'))->toBe(1)
+        ->and($html)->not->toContain('class="tag');
+});
+
+test('the switcher marks nothing as current when the session is empty', function () {
+    $user = User::factory()->create();
+    joined($user);
+    joined($user);
+
+    $this->actingAs($user)
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertDontSee('data-current', false)
+        ->assertDontSee('is-link');
+});
+
+test('the switcher does not mark a stale session entity of someone else', function () {
+    $user = User::factory()->create();
+    joined($user);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => Entity::factory()->create()->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertDontSee('data-current', false);
+});
+
+test('the switcher is translated', function () {
+    $user = User::factory()->create();
+    joined($user);
+    app()->setLocale('en');
+
+    $this->actingAs($user)->get(route('entity.switcher'))->assertSee('Switch entity');
+});
+
+// --- navbar ---------------------------------------------------------------
+
+test('the navbar links to the switcher only with more than one membership', function () {
+    $user = User::factory()->create(['name' => 'Maria Navbar']);
+    $first = joined($user);
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $first->id]);
+
+    $this->get(route('entity.dashboard', $first))
+        ->assertSee('Maria Navbar')
+        ->assertDontSee('href="'.route('entity.switcher').'"', false);
+
+    joined($user);
+
+    $this->get(route('entity.dashboard', $first))
+        ->assertSee('Maria Navbar')
+        ->assertSee('href="'.route('entity.switcher').'"', false);
+});
+
+// --- onboarding -----------------------------------------------------------
+
+test('the onboarding page renders in both locales', function () {
+    $this->actingAs(User::factory()->create());
+
+    $this->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Crie sua empresa')
+        ->assertSee('<title>Crie sua entidade', false)
+        ->assertSee('wire:model="name"', false);
+
+    app()->setLocale('en');
+
+    $this->get(route('onboarding'))
+        ->assertSee('Create your company')
+        ->assertSee('<title>Create your entity', false);
+});
+
+test('onboarding creates the entity with the creator as its only owner', function () {
+    Event::fake([MessageLogged::class]);
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertSessionHas('current_entity_id', fn ($id) => $id === Entity::firstWhere('slug', 'acme-corp')->id)
+        ->assertRedirect(route('entity.dashboard', ['entity' => 'acme-corp']));
+
+    $entity = Entity::firstWhere('slug', 'acme-corp');
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->memberships)->toHaveCount(1)
+        ->and($entity->owner->user_id)->toBe($user->id);
+
+    Event::assertDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->message === 'Entity created'
+        && $log->context === ['entity_id' => $entity->id, 'actor_id' => $user->id]);
+});
+
+test('onboarding validates the name', function (string $name) {
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', $name)
+        ->call('submit')
+        ->assertHasErrors('name');
+
+    expect(Entity::count())->toBe(0);
+})->with(['empty' => '', 'blank' => '   ', 'too long' => str_repeat('a', 256)]);
+
+test('onboarding derives unique slugs from the name', function () {
+    $component = fn (User $user) => Livewire::actingAs($user)->test(CreateEntity::class);
+
+    $component(User::factory()->create())->set('name', 'Acme Corp')->call('submit');
+    $component(User::factory()->create())->set('name', ' Acme  Corp! ')->call('submit');
+    $component(User::factory()->create())->set('name', 'Acme Corp')->call('submit');
+
+    expect(Entity::orderBy('id')->pluck('slug')->all())->toBe(['acme-corp', 'acme-corp-2', 'acme-corp-3']);
+});
+
+test('onboarding counts soft-deleted entities as taken slugs', function () {
+    Entity::factory()->create(['slug' => 'acme-corp'])->delete();
+
+    Livewire::actingAs(User::factory()->create())
+        ->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    expect(Entity::pluck('slug')->all())->toBe(['acme-corp-2']);
+});
+
+test('onboarding never hands out a slug that shadows a fixed route or is empty', function () {
+    $component = fn () => Livewire::actingAs(User::factory()->create())->test(CreateEntity::class);
+
+    $component()->set('name', 'Switcher')->call('submit');
+    $component()->set('name', '!!!')->call('submit');
+
+    expect(Entity::orderBy('id')->pluck('slug')->all())->toBe(['switcher-2', 'entity']);
+});
+
+test('onboarding retries when the slug is taken between the check and the insert', function () {
+    Event::fake([MessageLogged::class]);
+    $user = User::factory()->create();
+
+    $component = new class extends CreateEntity
+    {
+        public array $slugs = ['taken', 'taken-2', 'fresh'];
+
+        public int $calls = 0;
+
+        protected function uniqueSlug(string $name): string
+        {
+            $this->calls++;
+
+            return array_shift($this->slugs);
+        }
+    };
+
+    Entity::factory()->create(['slug' => 'taken']);
+    Entity::factory()->create(['slug' => 'taken-2']);
+
+    Livewire::actingAs($user)
+        ->test($component::class)
+        ->set('name', 'Acme')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', ['entity' => 'fresh']));
+
+    expect(Entity::where('slug', 'fresh')->exists())->toBeTrue()
+        ->and(EntityMembership::where('user_id', $user->id)->owner()->count())->toBe(1)
+        ->and(Entity::count())->toBe(3);
+});
+
+test('onboarding gives up after repeated slug collisions and leaves nothing behind', function () {
+    Entity::factory()->create(['slug' => 'taken']);
+
+    $component = new class extends CreateEntity
+    {
+        protected function uniqueSlug(string $name): string
+        {
+            return 'taken';
+        }
+    };
+
+    $user = User::factory()->create();
+
+    expect(fn () => Livewire::actingAs($user)->test($component::class)->set('name', 'Acme')->call('submit'))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    expect(Entity::count())->toBe(1)
+        ->and(EntityMembership::where('user_id', $user->id)->count())->toBe(0);
+});
+
+test('a failed membership insert rolls the entity back', function () {
+    $user = User::factory()->create();
+    // The user row vanishes mid-request: the membership FK fails after the entity insert.
+    $user->id = 999999;
+
+    expect(fn () => Livewire::actingAs($user)->test(CreateEntity::class)->set('name', 'Ghost')->call('submit'))
+        ->toThrow(QueryException::class);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('onboarding cannot be driven by client input to change the role or owner', function () {
+    $user = User::factory()->create();
+
+    $component = Livewire::actingAs($user)->test(CreateEntity::class);
+
+    expect(fn () => $component->set('role', 'admin'))->toThrow(Exception::class);
+
+    $component->set('name', 'Mine')->call('submit');
+
+    expect(EntityMembership::first()->role)->toBe(UserRole::Owner);
+});
+
+test('a guest cannot call the onboarding action', function () {
+    Livewire::test(CreateEntity::class)->set('name', 'Nope')->call('submit')->assertForbidden();
+
+    expect(Entity::count())->toBe(0);
+});
