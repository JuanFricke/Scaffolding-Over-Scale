diff --git a/tests/Feature/EntityDataModelTest.php b/tests/Feature/EntityDataModelTest.php
new file mode 100644
index 0000000..40afd9e
--- /dev/null
+++ b/tests/Feature/EntityDataModelTest.php
@@ -0,0 +1,226 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Database\QueryException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->create(['role' => $role]);
+
+    return $user;
+}
+
+test('the entities table has the expected columns and unique slug index', function () {
+    expect(Schema::getColumnListing('entities'))->toEqualCanonicalizing(['id', 'name', 'slug', 'created_at', 'updated_at', 'deleted_at']);
+
+    $indexes = collect(Schema::getIndexes('entities'))->keyBy('name');
+
+    expect($indexes['entities_slug_unique']['unique'])->toBeTrue()
+        ->and($indexes['entities_slug_unique']['columns'])->toBe(['slug']);
+});
+
+test('the entity memberships table has the named unique indexes', function () {
+    $indexes = collect(Schema::getIndexes('entity_memberships'))->keyBy('name');
+
+    expect($indexes['entity_memberships_entity_user_unique']['columns'])->toBe(['entity_id', 'user_id'])
+        ->and($indexes['entity_memberships_entity_user_unique']['unique'])->toBeTrue()
+        ->and($indexes['entity_memberships_one_owner']['columns'])->toBe(['entity_id', 'owner_seq'])
+        ->and($indexes['entity_memberships_one_owner']['unique'])->toBeTrue();
+});
+
+test('a membership role defaults to employee and is cast to the enum', function () {
+    $membership = EntityMembership::create([
+        'entity_id' => Entity::factory()->create()->id,
+        'user_id' => User::factory()->create()->id,
+    ])->fresh();
+
+    expect($membership->role)->toBe(UserRole::Employee);
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->owner()->create();
+
+    expect(fn () => EntityMembership::factory()->for($entity)->owner()->create())
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the database rejects promoting a second member to owner', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->owner()->create();
+    $admin = EntityMembership::factory()->for($entity)->admin()->create();
+
+    expect(fn () => $admin->update(['role' => UserRole::Owner]))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('many admins and employees plus one owner per entity are fine, and owners of other entities too', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->owner()->create();
+    EntityMembership::factory()->for($entity)->admin()->count(2)->create();
+    EntityMembership::factory()->for($entity)->employee()->count(2)->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect(EntityMembership::count())->toBe(6);
+});
+
+test('a user can only join an entity once', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->for($membership->entity)->for($membership->user)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('deleting an entity or a user cascades to memberships', function () {
+    $membership = EntityMembership::factory()->create();
+    $other = EntityMembership::factory()->create();
+
+    $membership->entity->forceDelete();
+    $other->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('entities are soft deleted and route by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect($entity->getRouteKeyName())->toBe('slug');
+
+    $entity->delete();
+
+    expect(Entity::count())->toBe(0)
+        ->and(Entity::withTrashed()->count())->toBe(1);
+});
+
+test('relations and scopes connect users, entities and memberships', function () {
+    $entity = Entity::factory()->create();
+    $owner = memberOf($entity, UserRole::Owner);
+    $admin = memberOf($entity, UserRole::Admin);
+    $employee = memberOf($entity, UserRole::Employee);
+
+    expect($entity->memberships)->toHaveCount(3)
+        ->and($entity->users->pluck('id')->all())->toEqualCanonicalizing([$owner->id, $admin->id, $employee->id])
+        ->and($entity->owner->user_id)->toBe($owner->id)
+        ->and($entity->owner()->first()->role)->toBe(UserRole::Owner)
+        ->and($owner->entities->pluck('id')->all())->toBe([$entity->id])
+        ->and($owner->memberships)->toHaveCount(1)
+        ->and($owner->memberships->first()->entity->is($entity))->toBeTrue()
+        ->and($owner->memberships->first()->user->is($owner))->toBeTrue()
+        ->and(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->first()->user_id)->toBe($admin->id)
+        ->and(EntityMembership::employee()->first()->user_id)->toBe($employee->id);
+});
+
+test('membershipFor finds the membership in one entity only', function () {
+    $entity = Entity::factory()->create();
+    $user = memberOf($entity, UserRole::Admin);
+
+    expect($user->membershipFor($entity->id)->role)->toBe(UserRole::Admin)
+        ->and($user->membershipFor(Entity::factory()->create()->id))->toBeNull();
+});
+
+test('UserRole::manageable lists the roles that can be assigned', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('entity factories create their dependencies', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and(Entity::factory()->count(2)->create()->pluck('slug')->unique())->toHaveCount(2);
+});
+
+test('entity policy: anyone authenticated may create', function () {
+    expect(new EntityPolicy()->create(User::factory()->create()))->toBeTrue();
+});
+
+test('entity policy by role', function (UserRole $role, bool $view, bool $update, bool $delete, bool $settings) {
+    $entity = Entity::factory()->create();
+    $user = memberOf($entity, $role);
+    $policy = new EntityPolicy;
+
+    expect($policy->view($user, $entity))->toBe($view)
+        ->and($policy->update($user, $entity))->toBe($update)
+        ->and($policy->delete($user, $entity))->toBe($delete)
+        ->and($policy->manageSettings($user, $entity))->toBe($settings);
+})->with([
+    'owner' => [UserRole::Owner, true, true, true, true],
+    'admin' => [UserRole::Admin, true, true, true, false],
+    'employee' => [UserRole::Employee, true, false, false, false],
+]);
+
+test('entity policy denies everything to non-members', function () {
+    $entity = Entity::factory()->create();
+    $stranger = User::factory()->create();
+    memberOf(Entity::factory()->create(), UserRole::Owner);
+    $policy = new EntityPolicy;
+
+    expect($policy->view($stranger, $entity))->toBeFalse()
+        ->and($policy->update($stranger, $entity))->toBeFalse()
+        ->and($policy->delete($stranger, $entity))->toBeFalse()
+        ->and($policy->manageSettings($stranger, $entity))->toBeFalse();
+});
+
+test('policies are discovered by the gate', function () {
+    $entity = Entity::factory()->create();
+    $owner = memberOf($entity, UserRole::Owner);
+    $employee = memberOf($entity, UserRole::Employee);
+
+    expect(Gate::forUser($owner)->allows('manageSettings', $entity))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('manageSettings', $entity))->toBeFalse()
+        ->and(Gate::forUser($employee)->allows('view', EntityMembership::where('user_id', $owner->id)->first()))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('delete', EntityMembership::where('user_id', $owner->id)->first()))->toBeFalse();
+});
+
+test('membership policy by role', function (UserRole $role, bool $view, bool $assign, bool $deleteOther) {
+    $entity = Entity::factory()->create();
+    $actor = memberOf($entity, $role);
+    $target = EntityMembership::factory()->for($entity)->employee()->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($actor, $target))->toBe($view)
+        ->and($policy->assignRole($actor, $target))->toBe($assign)
+        ->and($policy->delete($actor, $target))->toBe($deleteOther);
+})->with([
+    'owner' => [UserRole::Owner, true, true, true],
+    'admin' => [UserRole::Admin, true, true, true],
+    'employee' => [UserRole::Employee, true, false, false],
+]);
+
+test('membership policy: self removal is allowed except for the owner', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->for($entity)->owner()->create();
+    $admin = EntityMembership::factory()->for($entity)->admin()->create();
+    $employee = EntityMembership::factory()->for($entity)->employee()->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($employee->user, $employee))->toBeTrue()
+        ->and($policy->delete($admin->user, $admin))->toBeTrue()
+        ->and($policy->delete($owner->user, $owner))->toBeFalse()
+        ->and($policy->delete($admin->user, $owner))->toBeFalse()
+        ->and($policy->delete($employee->user, $owner))->toBeFalse();
+});
+
+test('membership policy denies non-members, even admins of other entities', function () {
+    $target = EntityMembership::factory()->employee()->create();
+    $outsider = memberOf(Entity::factory()->create(), UserRole::Owner);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($outsider, $target))->toBeFalse()
+        ->and($policy->assignRole($outsider, $target))->toBeFalse()
+        ->and($policy->delete($outsider, $target))->toBeFalse();
+});
diff --git a/tests/Feature/EntityTenantTest.php b/tests/Feature/EntityTenantTest.php
