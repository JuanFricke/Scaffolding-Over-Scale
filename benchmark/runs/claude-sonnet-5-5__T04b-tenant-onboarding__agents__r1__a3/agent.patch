@@ -0,0 +1,94 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    /** Slugs that would shadow a fixed `/e/...` route. */
+    private const RESERVED_SLUGS = ['switcher'];
+
+    private const MAX_SLUG_ATTEMPTS = 5;
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->authorize('create', Entity::class);
+
+        $name = trim($this->validate()['name']);
+
+        /** @var User $user */
+        $user = auth()->user();
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                $entity = DB::transaction(function () use ($name, $user) {
+                    $entity = Entity::create(['name' => $name, 'slug' => $this->uniqueSlug($name)]);
+
+                    // The creator is always the owner; nothing from the client reaches this.
+                    $entity->memberships()->create(['user_id' => $user->id, 'role' => UserRole::Owner]);
+
+                    return $entity;
+                });
+
+                break;
+            } catch (UniqueConstraintViolationException $e) {
+                // A concurrent request took the slug after our uniqueness check: pick again.
+                if ($attempt >= self::MAX_SLUG_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session()->put('current_entity_id', $entity->id);
+
+        $this->redirect(route('entity.dashboard', $entity));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->title(__('ui.create_entity_title'));
+    }
+
+    /**
+     * First free slug for the name: `acme-corp`, `acme-corp-2`, `acme-corp-3`...
+     * Soft-deleted entities keep their slug, so they count as taken.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = rtrim(Str::limit(Str::slug($name), 200, ''), '-') ?: 'entity';
+
+        $taken = Entity::withTrashed()
+            ->where(fn ($query) => $query->where('slug', $base)->orWhere('slug', 'like', $base.'-%'))
+            ->pluck('slug')
+            ->merge(self::RESERVED_SLUGS)
+            ->all();
+
+        $slug = $base;
+
+        for ($suffix = 2; in_array($slug, $taken, true); $suffix++) {
+            $slug = $base.'-'.$suffix;
+        }
+
+        return $slug;
+    }
+}
