+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $this->roleIn($user, $membership) !== null;
+    }
+
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->canManage($user, $membership);
+    }
+
+    /**
+     * The owner's membership is never deletable (transfer ownership first); anyone may leave
+     * on their own; otherwise only owner/admin may remove a member.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        return $membership->user_id === $user->id || $this->canManage($user, $membership);
+    }
+
+    private function canManage(User $user, EntityMembership $membership): bool
+    {
+        return in_array($this->roleIn($user, $membership), [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    private function roleIn(User $user, EntityMembership $membership): ?UserRole
+    {
+        return $user->membershipFor($membership->entity_id)?->role;
+    }
+}
