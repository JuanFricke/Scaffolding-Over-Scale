+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use Illuminate\Contracts\View\View;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Dashboard extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    /**
+     * Runs on every Livewire update request, which skips the page's route middleware.
+     * Re-checking here stops a user who lost access from re-rendering the entity.
+     */
+    public function hydrate(): void
+    {
+        $this->authorize('view', $this->entity);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.dashboard')->title($this->entity->name);
+    }
+}
