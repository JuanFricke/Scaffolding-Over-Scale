+<?php
+
+namespace App\Http\Controllers;
+
+use App\Tenancy\CurrentEntity;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+
+class HomeController extends Controller
+{
+    /**
+     * Send the user to the place they can work: onboarding without an entity, the
+     * dashboard of their only entity, or the switcher when they have several.
+     */
+    public function __invoke(Request $request): RedirectResponse
+    {
+        $entities = $request->user()->entities()->get();
+
+        if ($entities->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($entities->count() > 1) {
+            return redirect()->route('entity.switcher');
+        }
+
+        $request->session()->put(CurrentEntity::SESSION_KEY, $entities->first()->id);
+
+        return redirect()->route('entity.dashboard', $entities->first());
+    }
+}
