@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Owners and admins may assign roles. The owner's own role is never reassigned:
+     * ownership changes hands only through a transfer.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        return $this->canManage($user, $membership);
+    }
+
+    /**
+     * The owner's membership is never deleted. Anyone may remove their own membership;
+     * owners and admins may remove other members.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ((int) $membership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->canManage($user, $membership);
+    }
+
+    private function canManage(User $user, EntityMembership $membership): bool
+    {
+        $actor = $user->membershipFor($membership->entity_id);
+
+        return $actor !== null && in_array($actor->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
