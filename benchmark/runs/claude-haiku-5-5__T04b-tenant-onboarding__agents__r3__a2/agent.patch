+<?php
+
+use App\Livewire\Entity\CreateEntity;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Simulates a concurrent request that inserts the slug after this request's uniqueness
+ * check: the first attempt reads "acme-corp" as free, so the insert collides and the
+ * component must retry with a fresh slug.
+ */
+class CreateEntityWithStaleSlug extends CreateEntity
+{
+    public static int $calls = 0;
+
+    protected function uniqueSlug(string $name): string
+    {
+        return ++static::$calls === 1 ? 'acme-corp' : parent::uniqueSlug($name);
+    }
+}
+
+test('onboarding is for authenticated, verified users only', function () {
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('onboarding'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('onboarding renders its title and heading in Brazilian Portuguese by default', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Crie sua entidade')
+        ->assertSee('Crie sua empresa');
+});
+
+test('onboarding renders its title and heading in English', function () {
+    app()->setLocale('en');
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Create your entity')
+        ->assertSee('Create your company');
+});
+
+test('the name is required', function () {
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', '   ')
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('the name is limited to 255 characters', function () {
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', str_repeat('a', 256))
+        ->call('submit')
+        ->assertHasErrors(['name' => 'max']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('creating an entity makes the creator its only owner and opens its dashboard', function () {
+    $user = User::factory()->create();
+    $this->actingAs($user);
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', ['entity' => 'acme-corp']));
+
+    $entity = Entity::where('slug', 'acme-corp')->firstOrFail();
+    $membership = EntityMembership::where('entity_id', $entity->id)->sole();
+
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($membership->user_id)->toBe($user->id)
+        ->and($membership->role)->toBe(UserRole::Owner)
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('the slug is suffixed when the base slug is already taken', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+    Entity::factory()->create(['slug' => 'acme-corp-2']);
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect(Entity::where('slug', 'acme-corp-3')->exists())->toBeTrue();
+});
+
+test('a soft-deleted entity still reserves its slug', function () {
+    Entity::factory()->create(['slug' => 'acme-corp'])->delete();
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit');
+
+    expect(Entity::where('slug', 'acme-corp-2')->exists())->toBeTrue();
+});
+
+test('a name that would slug to a route segment of the app is kept out of the slug', function () {
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Switcher')
+        ->call('submit');
+
+    expect(Entity::where('slug', 'switcher-2')->exists())->toBeTrue();
+});
+
+test('a slug collision at insert time is retried with a fresh slug', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+    CreateEntityWithStaleSlug::$calls = 0;
+    Livewire::component('create-entity-with-stale-slug', CreateEntityWithStaleSlug::class);
+    $user = User::factory()->create();
+    $this->actingAs($user);
+
+    Livewire::test('create-entity-with-stale-slug')
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $entity = Entity::where('slug', 'acme-corp-2')->firstOrFail();
+
+    expect(CreateEntityWithStaleSlug::$calls)->toBe(2)
+        ->and(Entity::where('slug', 'acme-corp')->count())->toBe(1)
+        ->and(EntityMembership::where('entity_id', $entity->id)->sole()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::where('user_id', $user->id)->count())->toBe(1);
+});
+
+test('a new entity is audited with its id and the acting user', function () {
+    $user = User::factory()->create();
+    $this->actingAs($user);
+
+    $audit = Mockery::mock();
+    $audit->shouldReceive('info')->once()->withArgs(function (string $message, array $context) use ($user) {
+        return $message === 'Entity created'
+            && $context === ['entity_id' => Entity::firstOrFail()->id, 'actor_id' => $user->id];
+    });
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors();
+});
+
+test('a user who already belongs to an entity can create another one as its owner', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->employee()->for($user)->create();
+    $this->actingAs($user);
+
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Second Shop')
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    $entity = Entity::where('slug', 'second-shop')->firstOrFail();
+
+    expect($user->membershipFor($entity->id)?->role)->toBe(UserRole::Owner)
+        ->and($user->memberships()->count())->toBe(2);
+});
+
+test('an unauthenticated call to submit is refused and creates nothing', function () {
+    Livewire::test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertForbidden();
+
+    expect(Entity::count())->toBe(0);
+});
diff --git a/tests/Feature/Entity/DashboardAndSwitcherTest.php b/tests/Feature/Entity/DashboardAndSwitcherTest.php
new file mode 100644
index 0000000..06bec7f
--- /dev/null
+++ b/tests/Feature/Entity/DashboardAndSwitcherTest.php
@@ -0,0 +1,131 @@
+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the switcher requires login and a verified e-mail', function () {
+    $this->get(route('entity.switcher'))->assertRedirect(route('login'));
+
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('entity.switcher'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the dashboard requires login and a verified e-mail', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the dashboard shows the name of the entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Acme Padaria']);
+    EntityMembership::factory()->employee()->for($user)->for($entity)->create();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Acme Padaria');
+});
+
+test('the dashboard forbids a member-less user, even with a valid session for another entity', function () {
+    $user = User::factory()->create();
+    $own = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($user)->for($own)->create();
+
+    $stranger = Entity::factory()->create(['name' => 'Someone Else']);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $own->id])
+        ->get(route('entity.dashboard', $stranger))
+        ->assertForbidden()
+        ->assertDontSee('Someone Else');
+});
+
+test('the switcher lists only the entities the user belongs to', function () {
+    $user = User::factory()->create();
+    $mine = Entity::factory()->create(['name' => 'Minha Loja']);
+    $second = Entity::factory()->create(['name' => 'Segunda Loja']);
+    $other = Entity::factory()->create(['name' => 'Loja Alheia']);
+    EntityMembership::factory()->owner()->for($user)->for($mine)->create();
+    EntityMembership::factory()->employee()->for($user)->for($second)->create();
+    EntityMembership::factory()->employee()->for($other)->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Minha Loja')
+        ->assertSee('Segunda Loja')
+        ->assertDontSee('Loja Alheia');
+});
+
+test('the switcher marks the current entity and posts each entity to entity.pick', function () {
+    $user = User::factory()->create();
+    $current = Entity::factory()->create(['name' => 'Atual']);
+    $another = Entity::factory()->create(['name' => 'Outra']);
+    EntityMembership::factory()->owner()->for($user)->for($current)->create();
+    EntityMembership::factory()->employee()->for($user)->for($another)->create();
+
+    $html = $this->actingAs($user)
+        ->withSession(['current_entity_id' => $current->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->getContent();
+
+    $dom = new DOMDocument;
+    libxml_use_internal_errors(true);
+    $dom->loadHTML($html);
+    libxml_clear_errors();
+    $xpath = new DOMXPath($dom);
+
+    $currentButton = $xpath->query('//button[@data-current="1"]');
+    $otherButtons = $xpath->query('//button[contains(concat(" ", normalize-space(@class), " "), " is-light ")]');
+    $currentForm = $xpath->query('ancestor::form', $currentButton->item(0))->item(0);
+    $otherForm = $xpath->query('ancestor::form', $otherButtons->item(0))->item(0);
+
+    expect($currentButton)->toHaveCount(1)
+        ->and($currentButton->item(0)->getAttribute('class'))->toContain('is-fullwidth is-link')
+        ->and($currentButton->item(0)->textContent)->toBe('Atual')
+        ->and($currentForm->getAttribute('action'))->toBe(route('entity.pick', $current))
+        ->and($currentForm->getAttribute('method'))->toBe('POST')
+        ->and($otherButtons)->toHaveCount(1)
+        ->and($otherButtons->item(0)->textContent)->toBe('Outra')
+        ->and($otherButtons->item(0)->hasAttribute('data-current'))->toBeFalse()
+        ->and($otherForm->getAttribute('action'))->toBe(route('entity.pick', $another))
+        ->and($xpath->query('//*[contains(concat(" ", normalize-space(@class), " "), " tag ")]'))->toHaveCount(0);
+});
+
+test('the switcher title is in both locales', function () {
+    expect(__('ui.switch_entity', [], 'en'))->toBe('Switch entity')
+        ->and(__('ui.switch_entity', [], 'pt_BR'))->toBe('Trocar de entidade');
+
+    app()->setLocale('en');
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Switch entity');
+});
+
+test('a later Livewire request re-checks membership before the dashboard renders again', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->employee()->for($user)->for($entity)->create();
+    $this->actingAs($user);
+
+    $component = Livewire::test(Dashboard::class, ['entity' => $entity]);
+
+    $membership->delete();
+
+    $component->call('$refresh')->assertForbidden();
+});
diff --git a/tests/Feature/Entity/EntityModelTest.php b/tests/Feature/Entity/EntityModelTest.php
new file mode 100644
index 0000000..4f9a282
--- /dev/null
+++ b/tests/Feature/Entity/EntityModelTest.php
@@ -0,0 +1,77 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('entities are routed by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect($entity->getRouteKey())->toBe('acme-corp')
+        ->and($entity->getRouteKeyName())->toBe('slug');
+});
+
+test('owner() returns the owner membership of the entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect($entity->owner()->first()?->is($owner))->toBeTrue();
+});
+
+test('users() lists the members with their role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    $users = $entity->users()->get();
+
+    expect($users->pluck('id')->sort()->values()->all())
+        ->toBe(collect([$owner->user_id, $employee->user_id])->sort()->values()->all())
+        ->and($users->firstWhere('id', $owner->user_id)->pivot->role)->toBe('owner');
+});
+
+test('the membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->count(2)->for($entity)->create();
+
+    expect(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(2);
+});
+
+test('the manageable roles are admin and employee, never owner', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('User::entities() lists the entities the user belongs to, without soft-deleted ones', function () {
+    $user = User::factory()->create();
+    $live = EntityMembership::factory()->for($user)->create()->entity;
+    $deleted = EntityMembership::factory()->for($user)->create()->entity;
+    $deleted->delete();
+
+    expect($user->entities()->pluck('entities.id')->all())->toBe([$live->id]);
+});
+
+test('User::membershipFor() returns the membership, or null for a non-member', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->admin()->for($user)->create();
+    $stranger = Entity::factory()->create();
+
+    expect($user->membershipFor($membership->entity_id)?->is($membership))->toBeTrue()
+        ->and($user->membershipFor($stranger->id))->toBeNull();
+});
+
+test('User::membershipFor() returns null for a soft-deleted entity', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->for($user)->create();
+    $membership->entity->delete();
+
+    expect($user->membershipFor($membership->entity_id))->toBeNull();
+});
diff --git a/tests/Feature/Entity/EntityPoliciesTest.php b/tests/Feature/Entity/EntityPoliciesTest.php
new file mode 100644
index 0000000..6640525
--- /dev/null
+++ b/tests/Feature/Entity/EntityPoliciesTest.php
@@ -0,0 +1,98 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->ownerMembership = EntityMembership::factory()->owner()->for($this->entity)->create();
+    $this->adminMembership = EntityMembership::factory()->admin()->for($this->entity)->create();
+    $this->employeeMembership = EntityMembership::factory()->employee()->for($this->entity)->create();
+
+    $this->owner = $this->ownerMembership->user;
+    $this->admin = $this->adminMembership->user;
+    $this->employee = $this->employeeMembership->user;
+    $this->outsider = User::factory()->create();
+});
+
+test('policies are constructed without arguments', function () {
+    expect((new ReflectionClass(EntityPolicy::class))->getConstructor())->toBeNull()
+        ->and((new ReflectionClass(EntityMembershipPolicy::class))->getConstructor())->toBeNull();
+});
+
+test('any authenticated user may create an entity', function () {
+    expect(Gate::forUser($this->outsider)->allows('create', Entity::class))->toBeTrue();
+});
+
+test('every member may view the entity and outsiders may not', function () {
+    expect(Gate::forUser($this->owner)->allows('view', $this->entity))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows('view', $this->entity))->toBeTrue()
+        ->and(Gate::forUser($this->employee)->allows('view', $this->entity))->toBeTrue()
+        ->and(Gate::forUser($this->outsider)->allows('view', $this->entity))->toBeFalse();
+});
+
+test('only the owner and admins may update or delete the entity', function (string $ability) {
+    expect(Gate::forUser($this->owner)->allows($ability, $this->entity))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows($ability, $this->entity))->toBeTrue()
+        ->and(Gate::forUser($this->employee)->allows($ability, $this->entity))->toBeFalse()
+        ->and(Gate::forUser($this->outsider)->allows($ability, $this->entity))->toBeFalse();
+})->with(['update', 'delete']);
+
+test('only the owner may manage the entity settings', function () {
+    expect(Gate::forUser($this->owner)->allows('manageSettings', $this->entity))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows('manageSettings', $this->entity))->toBeFalse()
+        ->and(Gate::forUser($this->employee)->allows('manageSettings', $this->entity))->toBeFalse()
+        ->and(Gate::forUser($this->outsider)->allows('manageSettings', $this->entity))->toBeFalse();
+});
+
+test('a soft-deleted entity grants no access to anyone', function () {
+    $this->entity->delete();
+
+    expect(Gate::forUser($this->owner)->allows('view', $this->entity))->toBeFalse()
+        ->and(Gate::forUser($this->owner)->allows('update', $this->entity))->toBeFalse();
+});
+
+test('any member may view a membership of their entity; outsiders may not', function () {
+    expect(Gate::forUser($this->employee)->allows('view', $this->ownerMembership))->toBeTrue()
+        ->and(Gate::forUser($this->outsider)->allows('view', $this->ownerMembership))->toBeFalse();
+});
+
+test('owner and admins may assign roles to other members', function () {
+    expect(Gate::forUser($this->owner)->allows('assignRole', $this->employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows('assignRole', $this->employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->employee)->allows('assignRole', $this->adminMembership))->toBeFalse()
+        ->and(Gate::forUser($this->outsider)->allows('assignRole', $this->employeeMembership))->toBeFalse();
+});
+
+test('the owner role cannot be reassigned, which keeps exactly one owner', function () {
+    expect(Gate::forUser($this->owner)->allows('assignRole', $this->ownerMembership))->toBeFalse()
+        ->and(Gate::forUser($this->admin)->allows('assignRole', $this->ownerMembership))->toBeFalse();
+});
+
+test('the owner membership can never be deleted, not even by the owner', function () {
+    expect(Gate::forUser($this->owner)->allows('delete', $this->ownerMembership))->toBeFalse()
+        ->and(Gate::forUser($this->admin)->allows('delete', $this->ownerMembership))->toBeFalse();
+});
+
+test('any member may remove their own membership', function () {
+    expect(Gate::forUser($this->employee)->allows('delete', $this->employeeMembership))->toBeTrue();
+});
+
+test('owner and admins may remove other members', function () {
+    expect(Gate::forUser($this->owner)->allows('delete', $this->employeeMembership))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows('delete', $this->employeeMembership))->toBeTrue();
+});
+
+test('an employee may not remove another member', function () {
+    $colleague = EntityMembership::factory()->employee()->for($this->entity)->create();
+
+    expect(Gate::forUser($this->employee)->allows('delete', $colleague))->toBeFalse()
+        ->and(Gate::forUser($this->outsider)->allows('delete', $this->employeeMembership))->toBeFalse();
+});
diff --git a/tests/Feature/Entity/EntitySchemaTest.php b/tests/Feature/Entity/EntitySchemaTest.php
new file mode 100644
index 0000000..d9bc979
--- /dev/null
+++ b/tests/Feature/Entity/EntitySchemaTest.php
@@ -0,0 +1,128 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities.slug has a unique index named entities_slug_unique', function () {
+    $index = collect(Schema::getIndexes('entities'))->firstWhere('name', 'entities_slug_unique');
+
+    expect($index)->toMatchArray(['columns' => ['slug'], 'unique' => true]);
+});
+
+test('memberships are unique per entity and user', function () {
+    $index = collect(Schema::getIndexes('entity_memberships'))->firstWhere('name', 'entity_memberships_entity_user_unique');
+
+    expect($index)->toMatchArray(['columns' => ['entity_id', 'user_id'], 'unique' => true]);
+});
+
+test('the one-owner index covers entity_id and the generated owner_seq column', function () {
+    $index = collect(Schema::getIndexes('entity_memberships'))->firstWhere('name', 'entity_memberships_one_owner');
+
+    expect($index)->toMatchArray(['columns' => ['entity_id', 'owner_seq'], 'unique' => true]);
+});
+
+test('a duplicate slug is rejected by the database', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme-corp']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('a user cannot hold two memberships in the same entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('owner_seq is 1 for the owner and NULL for every other role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    $seq = fn (EntityMembership $membership) => DB::table('entity_memberships')->where('id', $membership->id)->value('owner_seq');
+
+    expect($seq($owner))->toBe(1)
+        ->and($seq($admin))->toBeNull()
+        ->and($seq($employee))->toBeNull();
+});
+
+test('an entity can have one owner alongside any number of admins and employees', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->count(2)->for($entity)->create();
+    EntityMembership::factory()->employee()->count(3)->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(6);
+});
+
+test('the same user can belong to several entities', function () {
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->for($user)->count(2)->create();
+
+    expect($user->memberships()->count())->toBe(2);
+});
+
+test('role defaults to employee', function () {
+    $entity = Entity::factory()->create();
+
+    $row = DB::table('entity_memberships')->insertGetId([
+        'entity_id' => $entity->id,
+        'user_id' => User::factory()->create()->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(DB::table('entity_memberships')->where('id', $row)->value('role'))->toBe('employee');
+});
+
+test('deleting a user removes their memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('deleting an entity permanently removes its memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('entities are soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect(Entity::count())->toBe(0)
+        ->and(Entity::withTrashed()->find($entity->id)?->deleted_at)->not->toBeNull();
+});
+
+test('the role column is cast to the UserRole enum', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Owner);
+});
diff --git a/tests/Feature/Entity/TenantSessionTest.php b/tests/Feature/Entity/TenantSessionTest.php
new file mode 100644
index 0000000..387c69a
--- /dev/null
+++ b/tests/Feature/Entity/TenantSessionTest.php
@@ -0,0 +1,153 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+test('guests are sent to login from home and from the pick endpoint', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('home'))->assertRedirect(route('login'));
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+});
+
+test('home sends a user with no entity to onboarding', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('onboarding'));
+});
+
+test('home sends a user with one entity to its dashboard, whatever the role', function (string $role) {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->state(['role' => $role])->for($user)->for($entity)->create();
+
+    $this->actingAs($user)->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+})->with(['owner', 'admin', 'employee']);
+
+test('home sends a user with several entities to the switcher', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($user)->count(2)->create();
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('entity.switcher'));
+});
+
+test('a user with no session entity is onboarded when they have no membership', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('the current_entity middleware sets the session when the user has exactly one entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Acme Padaria']);
+    EntityMembership::factory()->employee()->for($user)->for($entity)->create();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('the current_entity middleware sends a user with several entities to the switcher', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($user)->count(2)->create();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('entity.switcher'));
+});
+
+test('a session entity the user does not belong to is forbidden', function () {
+    $user = User::factory()->create();
+    $own = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($user)->for($own)->create();
+    $other = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $other->id])
+        ->get(route('entity.dashboard', $own))
+        ->assertForbidden();
+});
+
+test('a session entity the user has left is forbidden even when they have other entities', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($user)->count(2)->create();
+    $left = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $left->id])
+        ->get(route('entity.dashboard', $left))
+        ->assertForbidden();
+});
+
+test('a soft-deleted entity gives the member no access', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($user)->for($entity)->create();
+    $entity->delete();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $entity->id])
+        ->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $entity->id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertNotFound();
+});
+
+test('picking an entity sets the session, audits it and redirects to its dashboard', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($user)->for($entity)->create();
+    EntityMembership::factory()->for($user)->create();
+
+    $audit = Mockery::mock();
+    $audit->shouldReceive('info')->once()->with('Entity picked', [
+        'entity_id' => $entity->id,
+        'actor_id' => $user->id,
+    ]);
+    Log::shouldReceive('channel')->once()->with('audit')->andReturn($audit);
+
+    $this->actingAs($user)->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('picking an entity the user does not belong to is forbidden and leaves the session alone', function () {
+    $user = User::factory()->create();
+    $own = Entity::factory()->create();
+    EntityMembership::factory()->for($user)->for($own)->create();
+    $other = Entity::factory()->create();
+
+    Log::shouldReceive('channel')->never();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $own->id])
+        ->post(route('entity.pick', $other))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $own->id);
+});
+
+test('the navbar links to the switcher only for users with several entities', function () {
+    $user = User::factory()->create();
+    $first = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($user)->for($first)->create();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $first))
+        ->assertOk()
+        ->assertDontSee(route('entity.switcher'));
+
+    EntityMembership::factory()->employee()->for($user)->create();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $first))
+        ->assertOk()
+        ->assertSee(route('entity.switcher'));
+});
