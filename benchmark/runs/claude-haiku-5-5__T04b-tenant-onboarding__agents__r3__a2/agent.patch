@@ -0,0 +1,42 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class CreateEntity
+{
+    /**
+     * Create an entity and make the actor its owner, in one transaction.
+     *
+     * A slug taken at insert time throws UniqueConstraintViolationException (and rolls
+     * back), so the caller can pick another slug and try again.
+     */
+    public function handle(User $actor, string $name, string $slug): Entity
+    {
+        Gate::forUser($actor)->authorize('create', Entity::class);
+
+        $entity = DB::transaction(function () use ($actor, $name, $slug) {
+            $entity = Entity::create(['name' => $name, 'slug' => $slug]);
+
+            $entity->memberships()->create([
+                'user_id' => $actor->id,
+                'role' => UserRole::Owner,
+            ]);
+
+            return $entity;
+        });
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $actor->id,
+        ]);
+
+        return $entity;
+    }
+}
