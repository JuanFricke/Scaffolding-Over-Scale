--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,73 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateEntity as CreateEntityAction;
+use App\Models\Entity;
+use App\Tenancy\CurrentEntity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+use Throwable;
+
+#[Layout('layouts::default-page')]
+class CreateEntity extends Component
+{
+    private const MAX_ATTEMPTS = 5;
+
+    /** Slugs that collide with fixed routes (`/e/switcher`) and so can never name an entity. */
+    private const RESERVED_SLUGS = ['switcher'];
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->authorize('create', Entity::class);
+
+        $name = trim($this->validate()['name']);
+
+        // Another request can take the slug between uniqueSlug() and the insert. That
+        // insert fails and rolls back, so try again with a fresh slug.
+        $entity = retry(
+            self::MAX_ATTEMPTS,
+            fn () => app(CreateEntityAction::class)->handle(auth()->user(), $name, $this->uniqueSlug($name)),
+            0,
+            fn (Throwable $e) => $e instanceof UniqueConstraintViolationException,
+        );
+
+        session()->put(CurrentEntity::SESSION_KEY, $entity->id);
+
+        $this->redirectRoute('entity.dashboard', ['entity' => $entity]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->title(__('ui.onboarding_title'));
+    }
+
+    /**
+     * URL-safe slug for the name, suffixed -2, -3, ... while taken. Soft-deleted
+     * entities keep their slugs, so they are checked too.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name) ?: 'entity';
+        $slug = $base;
+
+        for ($suffix = 2; $this->slugIsTaken($slug); $suffix++) {
+            $slug = "{$base}-{$suffix}";
+        }
+
+        return $slug;
+    }
+
+    private function slugIsTaken(string $slug): bool
+    {
+        return in_array($slug, self::RESERVED_SLUGS, true)
+            || Entity::withTrashed()->where('slug', $slug)->exists();
+    }
+}
