@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Tenancy\CurrentEntity;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class EnsureCurrentEntity
+{
+    /**
+     * Resolve the session's entity into the request's tenant context.
+     *
+     * With no entity in the session, a single membership is selected automatically;
+     * otherwise the user is sent to onboarding or the switcher. A session entity the
+     * user does not belong to is forbidden.
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $session = $request->session();
+
+        if ($session->missing(CurrentEntity::SESSION_KEY)) {
+            $entities = $request->user()->entities()->get();
+
+            if ($entities->isEmpty()) {
+                return redirect()->route('onboarding');
+            }
+
+            if ($entities->count() > 1) {
+                return redirect()->route('entity.switcher');
+            }
+
+            $session->put(CurrentEntity::SESSION_KEY, $entities->first()->id);
+        }
+
+        $membership = $request->user()->membershipFor((int) $session->get(CurrentEntity::SESSION_KEY));
+
+        if ($membership === null) {
+            abort(403);
+        }
+
+        app(CurrentEntity::class)->set($membership);
+
+        return $next($request);
+    }
+}
diff --git a/app/Livewire/Entity/CreateEntity.php b/app/Livewire/Entity/CreateEntity.php
