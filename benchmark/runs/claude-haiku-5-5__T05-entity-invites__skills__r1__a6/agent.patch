+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Entity with an owner (signed in) and an employee; returns the employee membership too.
+ *
+ * @return array{0: Entity, 1: User, 2: EntityMembership, 3: EntityMembership}
+ */
+function detailsFixture($test): array
+{
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $ownerMem = EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $employeeMem = EntityMembership::factory()->for($entity)->for(User::factory()->create())->employee()->create();
+
+    $test->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    return [$entity, $owner, $ownerMem, $employeeMem];
+}
+
+test('opening a member shows the details modal with the current role prefilled', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $employeeMem->id)
+        ->assertSet('selectedMembershipId', $employeeMem->id)
+        ->assertSet('memberRole', 'employee')
+        ->assertSeeHtml('<p class="modal-card-title">'.__('ui.members_details').'</p>')
+        ->assertSee($employeeMem->user->name)
+        ->assertSee($employeeMem->user->email)
+        ->assertSee('<option value="admin">', false)
+        ->assertDontSeeHtml('<option value="">');
+});
+
+test('the details modal header is the modal title, not the member name', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+
+    $html = Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $employeeMem->id)
+        ->html();
+
+    expect($html)->toContain('<p class="modal-card-title">'.__('ui.members_details').'</p>')
+        ->and($html)->not->toContain('<p class="modal-card-title">'.$employeeMem->user->name.'</p>');
+});
+
+test('a membership of another entity cannot be opened and nothing is selected', function () {
+    [$entity] = detailsFixture($this);
+    $foreign = EntityMembership::factory()->for(User::factory()->create())->employee()->create();
+    $component = Livewire::test(Members::class, ['entity' => $entity]);
+
+    expect(fn () => $component->call('openMember', $foreign->id))->toThrow(ModelNotFoundException::class);
+
+    expect($component->get('selectedMembershipId'))->toBeNull();
+});
+
+test('the selected membership id cannot be tampered from the client', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+
+    expect(fn () => Livewire::test(Members::class, ['entity' => $entity])
+        ->set('selectedMembershipId', $employeeMem->id))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
+
+test('changing the role draft persists nothing until save', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+
+    $component = Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $employeeMem->id)
+        ->set('memberRole', 'admin');
+
+    expect($employeeMem->fresh()->role)->toBe(UserRole::Employee);
+
+    $component->call('saveRole')->assertHasNoErrors();
+
+    expect($employeeMem->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('save role rejects the owner role as a target', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $employeeMem->id)
+        ->set('memberRole', 'owner')
+        ->call('saveRole')
+        ->assertHasErrors(['memberRole']);
+
+    expect($employeeMem->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner membership is immutable', function () {
+    [$entity, , $ownerMem] = detailsFixture($this);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $ownerMem->id)
+        ->set('memberRole', 'admin')
+        ->call('saveRole')
+        ->assertForbidden();
+
+    expect($ownerMem->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('the last manager cannot be demoted', function () {
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    // Corrupt-but-possible state: no owner, a single admin.
+    $adminMem = EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    EntityMembership::factory()->for($entity)->for(User::factory()->create())->employee()->create();
+    $this->actingAs($admin)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $adminMem->id)
+        ->set('memberRole', 'employee')
+        ->call('saveRole')
+        ->assertForbidden();
+
+    expect($adminMem->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('a manager can demote an admin while another manager remains', function () {
+    [$entity, , $ownerMem] = detailsFixture($this);
+    $adminMem = EntityMembership::factory()->for($entity)->for(User::factory()->create())->admin()->create();
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $adminMem->id)
+        ->set('memberRole', 'employee')
+        ->call('saveRole')
+        ->assertHasNoErrors();
+
+    expect($adminMem->fresh()->role)->toBe(UserRole::Employee)
+        ->and($ownerMem->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('an employee cannot save a role', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+    $component = Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $employeeMem->id)
+        ->set('memberRole', 'admin');
+
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $this->actingAs($employee);
+
+    $component->call('saveRole')->assertForbidden();
+
+    expect($employeeMem->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('an employee cannot open a member', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+    $component = Livewire::test(Members::class, ['entity' => $entity]);
+
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $this->actingAs($employee);
+
+    $component->call('openMember', $employeeMem->id)->assertForbidden();
+
+    expect($component->get('selectedMembershipId'))->toBeNull();
+});
+
+test('an employee cannot open the removal confirmation', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+    $component = Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $employeeMem->id);
+
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $this->actingAs($employee);
+
+    $component->call('confirmRemoval')->assertForbidden()->assertSet('confirmingRemoval', false);
+
+    expect(EntityMembership::where('id', $employeeMem->id)->exists())->toBeTrue();
+});
+
+test('closing the details modal clears the selection', function () {
+    [$entity, , , $employeeMem] = detailsFixture($this);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('openMember', $employeeMem->id)
+        ->call('closeMember')
+        ->assertSet('selectedMembershipId', null)
+        ->assertSet('confirmingRemoval', false);
+});
+
+test('opening an unknown membership id is not found', function () {
+    [$entity] = detailsFixture($this);
