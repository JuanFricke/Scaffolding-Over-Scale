+});
+
+test('a unique-constraint race at insert becomes an error on inviteEmail, not a server error', function () {
+    Mail::fake();
+    [$entity] = inviteOwnerFixture($this);
+
+    // Another manager inserts the same invite between our pending check and our insert.
+    EntityInvite::creating(function () use ($entity) {
+        DB::table('entity_invites')->insert([
+            'entity_id' => $entity->id,
+            'email' => 'ana@example.com',
+            'role' => 'employee',
+            'expires_at' => now()->addDays(7),
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    });
+
+    $component = Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->call('sendInvite');
+
+    EntityInvite::flushEventListeners();
+
+    $component->assertHasErrors(['inviteEmail']);
+    expect($component->errors()->first('inviteEmail'))->toBe(__('An invite for this e-mail is already pending.'));
+
+    // The racing row shares this test's transaction, so the savepoint that rolls back our
+    // failed insert removes it too. In production the other manager's row is committed.
+    expect(EntityInvite::count())->toBe(0);
+    Mail::assertNothingQueued();
+});
+
+test('invalid input does not consume the invite quota', function () {
+    Mail::fake();
+    [$entity] = inviteOwnerFixture($this);
+    $component = Livewire::test(Members::class, ['entity' => $entity]);
+
+    for ($i = 0; $i < 12; $i++) {
+        $component->set('inviteEmail', 'bad-address')->call('sendInvite');
+    }
+
+    for ($i = 1; $i <= 10; $i++) {
+        $component->set('inviteEmail', "guest{$i}@example.com")->call('sendInvite')->assertHasNoErrors();
+    }
+
+    expect(EntityInvite::count())->toBe(10);
+});
+
+test('successful invites are limited to ten per hour per manager and entity', function () {
+    Mail::fake();
