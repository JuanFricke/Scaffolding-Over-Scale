+<?php
+
+use App\Livewire\Entity\PendingInvites;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Signed-in invitee whose stored e-mail is mixed case (registration does not lowercase).
+ */
+function invitee(): User
+{
+    return User::factory()->create(['email' => 'Bia@Example.com']);
+}
+
+test('lists only the signed-in user pending invites, matching e-mail case-insensitively', function () {
+    $bia = invitee();
+    $this->actingAs($bia);
+    $alpha = Entity::factory()->create(['name' => 'Alpha Co']);
+    $beta = Entity::factory()->create(['name' => 'Beta Co']);
+    $gamma = Entity::factory()->create(['name' => 'Gamma Co']);
+    $delta = Entity::factory()->create(['name' => 'Delta Co']);
+    EntityInvite::factory()->for($alpha)->create(['email' => 'bia@example.com']);
+    EntityInvite::factory()->for($beta)->create(['email' => 'someone@example.com']);
+    EntityInvite::factory()->for($gamma)->expired()->create(['email' => 'bia@example.com']);
+    EntityInvite::factory()->for($delta)->create(['email' => 'bia@example.com', 'accepted_at' => now()]);
+
+    Livewire::test(PendingInvites::class)
+        ->assertSee('Alpha Co')
+        ->assertDontSee('Beta Co')
+        ->assertDontSee('Gamma Co')
+        ->assertDontSee('Delta Co');
+});
+
+test('accepting creates the membership with the invite role, sets the tenant and redirects', function () {
+    $bia = invitee();
+    $this->actingAs($bia);
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'bia@example.com', 'role' => UserRole::Admin->value]);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', $entity->slug));
+
+    expect(EntityMembership::where(['entity_id' => $entity->id, 'user_id' => $bia->id])->sole()->role)
+        ->toBe(UserRole::Admin)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull()
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('accepting twice is a no-op without errors and never duplicates the membership', function () {
+    $bia = invitee();
+    $this->actingAs($bia);
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'bia@example.com']);
+
+    Livewire::test(PendingInvites::class)->call('accept', $invite->id);
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityMembership::where(['entity_id' => $entity->id, 'user_id' => $bia->id])->count())->toBe(1);
+});
+
+test('accepting an expired invite is an error on the invite key', function () {
+    $bia = invitee();
+    $this->actingAs($bia);
+    $invite = EntityInvite::factory()->expired()->create(['email' => 'bia@example.com']);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasErrors(['invite']);
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+test('accepting when already a member keeps the existing membership and role', function () {
+    $bia = invitee();
+    $this->actingAs($bia);
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($bia)->admin()->create();
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'bia@example.com', 'role' => UserRole::Employee->value]);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityMembership::where(['entity_id' => $entity->id, 'user_id' => $bia->id])->sole()->role)
+        ->toBe(UserRole::Admin);
+});
+
+test('only the invitee may accept an invite', function () {
+    $this->actingAs(invitee());
+    $invite = EntityInvite::factory()->create(['email' => 'someone-else@example.com']);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertForbidden();
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+test('only the invitee may decline an invite, and declining deletes it', function () {
+    $this->actingAs(invitee());
+    $other = EntityInvite::factory()->create(['email' => 'someone-else@example.com']);
+    $mine = EntityInvite::factory()->create(['email' => 'bia@example.com']);
+
+    Livewire::test(PendingInvites::class)->call('decline', $other->id)->assertForbidden();
+    expect(EntityInvite::find($other->id))->not->toBeNull();
+
+    Livewire::test(PendingInvites::class)->call('decline', $mine->id)->assertHasNoErrors();
+    expect(EntityInvite::find($mine->id))->toBeNull();
+});
+
+test('the onboarding page lists invites after the form, separated by a rule', function () {
+    $bia = invitee();
+    EntityInvite::factory()->create(['email' => 'bia@example.com']);
+
+    $this->actingAs($bia)
+        ->withHeaders(['Accept-Language' => 'pt-BR'])
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSeeInOrder(['Crie sua empresa', '<hr>', 'Convites pendentes', 'Aceitar', 'Recusar'], false);
+});
+
+test('the onboarding page renders no rule when there are no invites', function () {
+    $this->actingAs(invitee())
+        ->withHeaders(['Accept-Language' => 'pt-BR'])
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertDontSeeHtml('<hr>')
+        ->assertDontSee('Convites pendentes');
+});
+
+test('the onboarding invite buttons follow the browser language', function () {
+    $bia = invitee();
+    EntityInvite::factory()->create(['email' => 'bia@example.com']);
+
+    $this->actingAs($bia)
+        ->withHeaders(['Accept-Language' => 'en'])
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Pending invites')
+        ->assertSee('Accept')
+        ->assertSee('Decline');
+});
+
+test('the entity switcher lists pending invites', function () {
+    $bia = invitee();
+    $a = Entity::factory()->create(['slug' => 'alpha']);
+    $b = Entity::factory()->create(['slug' => 'beta']);
+    EntityMembership::factory()->for($a)->for($bia)->owner()->create();
+    EntityMembership::factory()->for($b)->for($bia)->admin()->create();
+    $invited = Entity::factory()->create(['name' => 'Invited Co']);
+    EntityInvite::factory()->for($invited)->create(['email' => 'bia@example.com']);
+
+    $this->actingAs($bia)
+        ->withHeaders(['Accept-Language' => 'pt-BR'])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Invited Co')
+        ->assertSee('Convites pendentes');
+});
