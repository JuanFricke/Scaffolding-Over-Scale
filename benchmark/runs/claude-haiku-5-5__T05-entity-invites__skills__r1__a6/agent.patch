@@ -0,0 +1,304 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Mail;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Entity with an owner signed in and picked as the tenant.
+ *
+ * @return array{0: Entity, 1: User}
+ */
+function inviteOwnerFixture($test): array
+{
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    $test->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    return [$entity, $owner];
+}
+
+test('manager invites an e-mail with a role, queues the mail and resets the form', function () {
+    Mail::fake();
+    [$entity, $owner] = inviteOwnerFixture($this);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'Ana@Example.com')
+        ->set('inviteRole', 'admin')
+        ->call('sendInvite')
+        ->assertHasNoErrors()
+        ->assertSet('inviteEmail', '')
+        ->assertSet('inviteRole', 'employee');
+
+    $invite = EntityInvite::where('entity_id', $entity->id)->sole();
+
+    expect($invite->email)->toBe('ana@example.com')
+        ->and($invite->role)->toBe(UserRole::Admin)
+        ->and($invite->invited_by)->toBe($owner->id)
+        ->and($invite->accepted_at)->toBeNull()
+        ->and($invite->expires_at->between(now()->addDays(7)->subMinute(), now()->addDays(7)->addMinute()))->toBeTrue();
+
+    Mail::assertQueued(EntityInviteMail::class, fn (EntityInviteMail $mail) => $mail->hasTo('ana@example.com')
+        && $mail->invite->is($invite));
+    Mail::assertQueuedCount(1);
+});
+
+test('the owner role can never be invited', function () {
+    Mail::fake();
+    [$entity] = inviteOwnerFixture($this);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->set('inviteRole', 'owner')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteRole']);
+
+    expect(EntityInvite::count())->toBe(0);
+    Mail::assertNothingQueued();
+});
+
+test('an invalid e-mail is rejected without creating an invite', function () {
+    Mail::fake();
+    [$entity] = inviteOwnerFixture($this);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'not-an-email')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail' => 'email']);
+
+    expect(EntityInvite::count())->toBe(0);
+    Mail::assertNothingQueued();
+});
+
+test('inviting an address that already belongs to a member is an error on inviteEmail', function () {
+    Mail::fake();
+    [$entity] = inviteOwnerFixture($this);
+    $member = User::factory()->create(['email' => 'Bia@Example.com']);
+    EntityMembership::factory()->for($entity)->for($member)->employee()->create();
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'bia@example.com')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::count())->toBe(0);
+    Mail::assertNothingQueued();
+});
+
+test('a pending invite for the same address is an error on inviteEmail', function () {
+    Mail::fake();
+    [$entity] = inviteOwnerFixture($this);
+    EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::count())->toBe(1);
+    Mail::assertNothingQueued();
+});
+
+test('an expired invite for the same address is replaced', function () {
+    Mail::fake();
+    [$entity] = inviteOwnerFixture($this);
+    EntityInvite::factory()->for($entity)->expired()->create(['email' => 'ana@example.com']);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'ana@example.com')
+        ->set('inviteRole', 'admin')
+        ->call('sendInvite')
+        ->assertHasNoErrors();
+
+    $invite = EntityInvite::where('entity_id', $entity->id)->sole();
+
+    expect($invite->role)->toBe(UserRole::Admin)
+        ->and($invite->isPending())->toBeTrue();
