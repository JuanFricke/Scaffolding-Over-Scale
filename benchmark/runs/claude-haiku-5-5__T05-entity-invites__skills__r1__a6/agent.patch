+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Livewire\Component;
+
+/**
+ * The signed-in user's pending invites, embedded in onboarding and the entity switcher.
+ */
+class PendingInvites extends Component
+{
+    /**
+     * Accept an invite addressed to the signed-in user and enter the entity.
+     */
+    public function accept($inviteId): void
+    {
+        $invite = EntityInvite::with('entity')->findOrFail($inviteId);
+
+        $this->authorize('accept', $invite);
+
+        // Already accepted: nothing to do, and no error for a repeated click.
+        if ($invite->accepted_at !== null) {
+            return;
+        }
+
+        if (! $invite->isPending()) {
+            $this->addError('invite', __('This invite has expired.'));
+
+            return;
+        }
+
+        $entity = $invite->entity ?? abort(404);
+
+        DB::transaction(function () use ($invite, $entity) {
+            // createOrFirst never duplicates: an existing membership keeps its role.
+            EntityMembership::createOrFirst(
+                ['entity_id' => $entity->id, 'user_id' => auth()->id()],
+                ['role' => $invite->role->value],
+            );
+
+            $invite->update(['accepted_at' => now()]);
+        });
+
+        Log::channel('audit')->info('Invite accepted', [
+            'entity_id' => $entity->id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirect(route('entity.dashboard', $entity->slug));
+    }
+
+    /**
+     * Decline an invite addressed to the signed-in user, which deletes it.
+     */
+    public function decline($inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorize('decline', $invite);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.pending-invites', [
+            'invites' => EntityInvite::pending()
+                ->where('email', EntityInvite::normalizeEmail(auth()->user()->email))
+                ->whereHas('entity')
+                ->with('entity')
+                ->latest('id')
+                ->get(),
+        ]);
+    }
+}
