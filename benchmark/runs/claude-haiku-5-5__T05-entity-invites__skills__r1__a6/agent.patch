diff --git a/app/Models/EntityInvite.php b/app/Models/EntityInvite.php
new file mode 100644
index 0000000..97242af
--- /dev/null
+++ b/app/Models/EntityInvite.php
@@ -0,0 +1,71 @@
+<?php
+
+namespace App\Models;
+
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Database\Eloquent\Casts\Attribute;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+#[Fillable(['entity_id', 'invited_by', 'email', 'role', 'expires_at', 'accepted_at'])]
+class EntityInvite extends Model
+{
+    use HasFactory;
+
+    /**
+     * Days an invite stays valid after it is sent.
+     */
+    public const TTL_DAYS = 7;
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'role' => UserRole::class,
+            'expires_at' => 'datetime',
+            'accepted_at' => 'datetime',
+        ];
+    }
+
+    /**
+     * Every write path stores the address normalized, so lookups can compare exactly.
+     */
+    protected function email(): Attribute
+    {
+        return Attribute::make(
+            set: fn (string $value) => self::normalizeEmail($value),
+        );
+    }
+
+    /**
+     * Normalize an e-mail for storage and comparison (lowercase, trimmed).
+     */
+    public static function normalizeEmail(string $email): string
+    {
+        return strtolower(trim($email));
+    }
+
+    public function entity(): BelongsTo
+    {
+        return $this->belongsTo(Entity::class);
+    }
+
+    /**
+     * Invites that can still be accepted: not accepted and not expired.
+     */
+    public function scopePending(Builder $query): Builder
+    {
+        return $query->whereNull('accepted_at')->where('expires_at', '>', now());
+    }
+
+    public function isPending(): bool
+    {
+        return $this->accepted_at === null && $this->expires_at->isFuture();
+    }
+}
