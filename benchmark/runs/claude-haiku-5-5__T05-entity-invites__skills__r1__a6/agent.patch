+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityInvite;
+use App\Models\User;
+
+/**
+ * Invites are answered by the invitee only, matched on the e-mail address.
+ * Managing invites (send, cancel) is authorized through EntityPolicy::manageMembers.
+ */
+class EntityInvitePolicy
+{
+    /**
+     * Determine whether the user can accept the invite.
+     */
+    public function accept(User $user, EntityInvite $invite): bool
+    {
+        return $this->isInvitee($user, $invite);
+    }
+
+    /**
+     * Determine whether the user can decline the invite.
+     */
+    public function decline(User $user, EntityInvite $invite): bool
+    {
+        return $this->isInvitee($user, $invite);
+    }
+
+    protected function isInvitee(User $user, EntityInvite $invite): bool
+    {
+        return EntityInvite::normalizeEmail($user->email) === $invite->email;
+    }
+}
