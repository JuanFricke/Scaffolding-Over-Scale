--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteMailTest.php
@@ -0,0 +1,69 @@
+<?php
+
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Mail;
+
+uses(RefreshDatabase::class);
+
+function inviteMailFixture(): EntityInvite
+{
+    $entity = Entity::factory()->create(['name' => 'Acme Ltda']);
+
+    return EntityInvite::factory()->for($entity)->create([
+        'email' => 'ana@example.com',
+        'role' => UserRole::Admin->value,
+    ]);
+}
+
+test('invite mail is queued to the invitee', function () {
+    Mail::fake();
+    $invite = inviteMailFixture();
+
+    Mail::to($invite->email)->queue(new EntityInviteMail($invite));
+
+    Mail::assertQueued(EntityInviteMail::class, fn (EntityInviteMail $mail) => $mail->hasTo('ana@example.com'));
+});
+
+test('the invite mail is a queued markdown mail using the entity-invite view', function () {
+    $mail = new EntityInviteMail(inviteMailFixture());
+
+    expect($mail)->toBeInstanceOf(ShouldQueue::class)
+        ->and($mail->content()->markdown)->toBe('emails.entity-invite');
+});
+
+test('the invite e-mail renders in English with the PegaFila theme', function () {
+    app()->setLocale('en');
+    $invite = inviteMailFixture();
+
+    $mail = new EntityInviteMail($invite);
+    $html = (string) $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('You are invited to Acme Ltda')
+        ->and($html)->toContain('You are invited to Acme Ltda as Admin.')
+        ->and($html)->toContain('Access the link below to sign in and accept your invite:')
+        ->and($html)->toContain('Sign in to PegaFila')
+        ->and($html)->toContain('href="'.route('login').'"')
+        ->and($html)->toContain($invite->expires_at->format('d/m/Y'))
+        ->and($html)->toContain('Team PegaFila')
+        ->and($html)->toContain('#0f7490');
+});
+
+test('the invite e-mail renders in Brazilian Portuguese', function () {
+    app()->setLocale('pt_BR');
+    $invite = inviteMailFixture();
+
+    $mail = new EntityInviteMail($invite);
+    $html = (string) $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('Você foi convidado para Acme Ltda')
+        ->and($html)->toContain('Você foi convidado para Acme Ltda como Administrador.')
+        ->and($html)->toContain('Acesse o link abaixo para entrar e aceitar seu convite:')
+        ->and($html)->toContain('Entrar no PegaFila')
+        ->and($html)->toContain('Time PegaFila')
+        ->and($html)->not->toContain('Sign in to PegaFila');
+});
diff --git a/tests/Feature/Entity/EntityInviteTest.php b/tests/Feature/Entity/EntityInviteTest.php
new file mode 100644
index 0000000..694fd58
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteTest.php
@@ -0,0 +1,87 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity_invites table has required columns and a unique (entity, email) index', function () {
+    expect(Schema::hasColumns('entity_invites', [
+        'id', 'entity_id', 'invited_by', 'email', 'role', 'expires_at', 'accepted_at', 'created_at', 'updated_at',
+    ]))->toBeTrue()
+        ->and(Schema::hasIndex('entity_invites', ['entity_id', 'email'], 'unique'))->toBeTrue();
+});
+
+test('emails are stored lowercase and trimmed on every write path', function () {
+    $invite = EntityInvite::factory()->create(['email' => '  Ana@Example.COM ']);
+
+    expect($invite->fresh()->email)->toBe('ana@example.com');
+
+    $invite->update(['email' => 'Bia@Example.com']);
+
+    expect($invite->fresh()->email)->toBe('bia@example.com');
+});
+
+test('role casts to UserRole and the dates to datetimes', function () {
+    $invite = EntityInvite::factory()->create(['role' => UserRole::Admin->value, 'accepted_at' => now()]);
+    $fresh = $invite->fresh();
+
+    expect($fresh->role)->toBe(UserRole::Admin)
+        ->and($fresh->expires_at)->toBeInstanceOf(DateTimeInterface::class)
+        ->and($fresh->accepted_at)->toBeInstanceOf(DateTimeInterface::class);
+});
+
+test('factory defaults to an employee invite expiring in seven days', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->role)->toBe(UserRole::Employee)
+        ->and($invite->entity)->toBeInstanceOf(Entity::class)
+        ->and($invite->expires_at->between(now()->addDays(7)->subMinute(), now()->addDays(7)->addMinute()))->toBeTrue()
+        ->and($invite->isPending())->toBeTrue();
+});
+
+test('expired factory state is not pending', function () {
+    $invite = EntityInvite::factory()->expired()->create();
+
+    expect($invite->expires_at->isPast())->toBeTrue()
+        ->and($invite->isPending())->toBeFalse();
+});
+
+test('an accepted invite is not pending', function () {
+    $invite = EntityInvite::factory()->create(['accepted_at' => now()]);
+
+    expect($invite->isPending())->toBeFalse();
+});
+
+test('pending scope keeps only invites that are neither accepted nor expired', function () {
+    $entity = Entity::factory()->create();
+    $pending = EntityInvite::factory()->for($entity)->create();
+    EntityInvite::factory()->for($entity)->create(['accepted_at' => now()]);
+    EntityInvite::factory()->for($entity)->expired()->create();
+
+    expect(EntityInvite::pending()->pluck('id')->all())->toBe([$pending->id]);
+});
+
+test('an entity has many invites and a (entity, email) pair is unique', function () {
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']);
+
+    expect($entity->invites)->toHaveCount(1);
+
+    // Same address after normalization: must collide with the unique index.
+    expect(fn () => EntityInvite::factory()->for($entity)->create(['email' => 'ANA@example.com']))
+        ->toThrow(QueryException::class);
+});
+
+test('invites are removed together with their entity', function () {
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->create();
+
+    $entity->forceDelete();
+
+    expect(EntityInvite::count())->toBe(0);
+});
