+
+    $component = Livewire::test(Members::class, ['entity' => $entity]);
+
+    for ($i = 1; $i <= 10; $i++) {
+        $component->set('inviteEmail', "guest{$i}@example.com")->call('sendInvite')->assertHasNoErrors();
+    }
+
+    $component->set('inviteEmail', 'guest11@example.com')
+        ->call('sendInvite')
+        ->assertHasErrors(['inviteEmail']);
+
+    expect(EntityInvite::count())->toBe(10);
+
+    // The quota belongs to the manager: another manager of the same entity is not blocked.
+    $this->actingAs($admin);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->set('inviteEmail', 'guest11@example.com')
+        ->call('sendInvite')
+        ->assertHasNoErrors();
+});
+
+test('an employee cannot send invites', function () {
