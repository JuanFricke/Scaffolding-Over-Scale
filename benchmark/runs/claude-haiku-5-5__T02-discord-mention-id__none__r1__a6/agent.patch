diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
index 6a778a4..c137279 100644
--- a/tests/Feature/DiscordOpsAlertTest.php
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -121,3 +121,107 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends a mention of the configured user on its own line', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '12345678901234567',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue error', 'Worker failed', ['queue' => 'default']);
+
+    Http::assertSent(function (Request $request) {
+        return $request['content'] === "Queue error\nWorker failed\nqueue=default\n<@12345678901234567>";
+    });
+});
+
+test('accepts an integer mention id and trims surrounding whitespace', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@12345678901234567>"));
+})->with([
+    '12345678901234567',
+    '  12345678901234567  ',
+    12345678901234567,
+]);
+
+test('does not mention anyone when the mention id is unset or empty', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '', '   ']);
+
+test('ignores mention ids that are not a 17-20 digit snowflake', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([
+    '@everyone',
+    '@here',
+    'abc',
+    '123',
+    '1234567890123456',
+    '123456789012345678901',
+    '12345678901234567a',
+    "123\n@everyone",
+    "123> \n@everyone",
+    '<@12345678901234567>',
+    '-12345678901234567',
+    12345,
+]);
+
+test('keeps the mention within the 1800 character limit by truncating the alert body', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '12345678901234567',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return mb_strlen($content) === 1800
+            && str_ends_with($content, "\n<@12345678901234567>");
+    });
+});
