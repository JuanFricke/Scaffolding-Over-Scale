diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..bd7bdfa 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -16,6 +16,9 @@
  *     ]);
  *
  * Unconfigured (empty DISCORD_WEBHOOK_URL) is a silent no-op.
+ *
+ * When DISCORD_MENTION_ID is a valid Discord user snowflake (17–20 digits), every
+ * alert ends with `<@ID>` on its own line so the on-call person gets a push notification.
  */
 class DiscordOpsAlert
 {
@@ -25,6 +28,8 @@ class DiscordOpsAlert
 
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
 
+    private const string MentionIdPattern = '/\A[0-9]{17,20}\z/';
+
     /**
      * @param  array<string, mixed>  $context
      */
@@ -66,7 +71,36 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $mention = $this->mention();
+
+        // Reserve room for the mention so truncation only ever cuts title/message/context.
+        $body = mb_substr(implode("\n", $lines), 0, self::MaxContentLength - mb_strlen($mention));
+
+        return $body.$mention;
+    }
+
+    /**
+     * Returns "\n<@ID>" for a valid DISCORD_MENTION_ID, otherwise an empty string.
+     */
+    private function mention(): string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (is_int($id)) {
+            $id = (string) $id;
+        }
+
+        if (! is_string($id)) {
+            return '';
+        }
+
+        $id = trim($id);
+
+        if (preg_match(self::MentionIdPattern, $id) !== 1) {
+            return '';
+        }
+
+        return "\n<@{$id}>";
     }
 
     private function safe(string $key, mixed $value): string
