@@ -0,0 +1,112 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields that may change after issuance (plus `updated_at`).
+     *
+     * @var string[]
+     */
+    private const MUTABLE_FIELDS = ['status', 'called_at', 'called_by_user_id'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        static::updating(function (Ticket $ticket) {
+            $changed = array_keys($ticket->getDirty());
+            $changed = array_diff($changed, [...self::MUTABLE_FIELDS, 'updated_at']);
+
+            if ($changed !== []) {
+                throw new LogicException('Tickets are write-once; only call fields may change.');
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: last valid `A<digits>` code by insertion
+     * order plus one (`A001`, `A002`, ...; grows past `A999` to `A1000`).
+     * Malformed legacy codes are skipped; deleted numbers are not reused.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = static::query()
+            ->where('queue_id', $queueId)
+            ->orderBy('id')
+            ->pluck('code')
+            ->reverse()
+            ->first(fn (string $code) => preg_match('/\AA(\d+)\z/', $code) === 1);
+
+        $next = $last === null ? 1 : ((int) substr($last, 1)) + 1;
+
+        return 'A'.str_pad((string) $next, 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Mark the ticket called by the given user. Only members of the ticket's
+     * entity may call, and each ticket may be called exactly once.
+     *
+     * @throws AuthorizationException when the user is not an entity member.
+     * @throws LogicException when the ticket is not waiting.
+     */
+    public function call(User $user): void
+    {
+        $entityId = $this->queue()->value('entity_id');
+
+        $isMember = EntityMembership::query()
+            ->where('entity_id', $entityId)
+            ->where('user_id', $user->getKey())
+            ->exists();
+
+        if (! $isMember) {
+            throw new AuthorizationException('Only entity members may call tickets.');
+        }
+
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Only waiting tickets may be called.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->getKey();
+        $this->save();
+    }
+}
