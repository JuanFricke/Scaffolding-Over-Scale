@@ -0,0 +1,68 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    private const MAX_CODE_ATTEMPTS = 5;
+
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        return DB::transaction(function () use ($queue, $priority, $channel) {
+            $fresh = Queue::query()->whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+            if (! $fresh->is_active) {
+                throw new InactiveQueueException('Cannot issue tickets into an inactive queue.');
+            }
+
+            $attempts = 0;
+
+            do {
+                try {
+                    return Ticket::create([
+                        'queue_id' => $fresh->getKey(),
+                        'code' => Ticket::nextCode($fresh->getKey()),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                } catch (UniqueConstraintViolationException) {
+                    $attempts++;
+                } catch (QueryException $e) {
+                    if (! $this->isUniqueViolation($e) || ++$attempts >= self::MAX_CODE_ATTEMPTS) {
+                        throw $e;
+                    }
+                }
+            } while ($attempts < self::MAX_CODE_ATTEMPTS);
+
+            throw new QueryException(
+                'insert into `tickets` (`queue_id`, `code`) values (?, ?)',
+                [$fresh->getKey(), Ticket::nextCode($fresh->getKey())],
+                new \PDOException('Could not allocate a unique ticket code.'),
+            );
+        });
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        return in_array($e->getCode(), ['23000', '23505'], true);
+    }
+}
