+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issue ticket allocates sequential codes per queue', function () {
+    $queue = Queue::factory()->create();
+
+    $first = (new IssueTicket)($queue);
+    $second = (new IssueTicket)($queue);
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and($first->status)->toBe(TicketStatus::Waiting)
+        ->and($first->channel)->toBe(TicketChannel::Virtual)
+        ->and($first->priority)->toBe(0)
+        ->and($first->issued_at)->not->toBeNull();
+});
+
+test('ticket factory forQueue issues A001 then A002', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')->and($second->code)->toBe('A002');
+});
+
+test('ticket factory keeps an explicit code', function () {
+    $ticket = Ticket::factory()->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X');
+});
+
+test('next code grows beyond 999 and ignores string order', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('deleted ticket numbers are not reused', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A002']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A003']);
+    Ticket::where('queue_id', $queue->id)->where('code', 'A002')->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('malformed legacy codes are skipped', function () {
+    $onlyBad = Queue::factory()->create();
+    Ticket::factory()->forQueue($onlyBad)->create(['code' => 'A-X']);
+
+    $mixed = Queue::factory()->create();
+    Ticket::factory()->forQueue($mixed)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($mixed)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($onlyBad->id))->toBe('A001')
+        ->and(Ticket::nextCode($mixed->id))->toBe('A002');
+});
+
+test('issuance rejects inactive queues, even from a stale model', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    Queue::whereKey($queue->id)->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('negative priority is rejected and persists nothing', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('ticket fields are write-once except call fields', function () {
+    $ticket = Ticket::factory()->create(['code' => 'A001']);
+
+    expect(fn () => $ticket->update(['priority' => 5]))
+        ->toThrow(LogicException::class);
+
+    $ticket->refresh();
+    expect($ticket->priority)->toBe(0);
+});
+
+test('a member can call a waiting ticket exactly once', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $ticket->call($user);
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($user->id);
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+});
+
+test('non-members cannot call a ticket', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Waiting);
+});
