--- /dev/null
+++ b/app/Actions/CreateQueue.php
@@ -0,0 +1,40 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\NormalizesQueueAttributes;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+
+class CreateQueue
+{
+    use NormalizesQueueAttributes;
+
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $name = $this->normalizeName($name);
+        $slug = $this->normalizeSlug($slug ?? $name);
+
+        $this->assertSlugAvailable($entity->id, $slug);
+
+        try {
+            return Queue::query()->create([
+                'entity_id' => $entity->id,
+                'name' => $name,
+                'slug' => $slug,
+                'is_active' => true,
+            ]);
+        } catch (QueryException $e) {
+            if (! $this->isSlugConflict($e)) {
+                throw $e;
+            }
+
+            throw $this->slugTakenException();
+        }
+    }
+}
diff --git a/app/Actions/SetQueueAccess.php b/app/Actions/SetQueueAccess.php
new file mode 100644
index 0000000..90d266a
--- /dev/null
+++ b/app/Actions/SetQueueAccess.php
@@ -0,0 +1,115 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Replace the per-queue permissions of a membership. A non-empty list
+     * upserts the grant row; an empty list revokes it.
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        $permissions = $this->validatedPermissions($permissions);
+
+        // Cast: PDO drivers may hand back ids as strings, which would make !== misfire.
+        if ((int) $targetMembership->entity_id !== (int) $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => ['The membership and the queue must belong to the same entity.'],
+            ]);
+        }
+
+        if ($permissions === []) {
+            $this->revoke($targetMembership, $queue, $actor);
+
+            return;
+        }
+
+        DB::transaction(function () use ($targetMembership, $queue, $permissions): void {
+            $this->lockQueue($queue);
+
+            QueueAccess::query()->updateOrCreate(
+                [
+                    'entity_membership_id' => $targetMembership->id,
+                    'queue_id' => $queue->id,
+                ],
+                ['permissions' => $permissions],
+            );
+        });
+
+        Log::channel('audit')->info('queue.access.granted', [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+            'permissions' => $permissions,
+        ]);
+    }
+
+    private function revoke(EntityMembership $targetMembership, Queue $queue, User $actor): void
+    {
+        $revoked = DB::transaction(function () use ($targetMembership, $queue): bool {
+            $this->lockQueue($queue);
+
+            return QueueAccess::query()
+                ->where('entity_membership_id', $targetMembership->id)
+                ->where('queue_id', $queue->id)
+                ->delete() > 0;
+        });
+
+        // Only a real removal is audited; revoking nothing is a no-op.
+        if (! $revoked) {
+            return;
+        }
+
+        Log::channel('audit')->info('queue.access.revoked', [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+        ]);
+    }
+
+    /**
+     * Serializes grant changes per queue so concurrent upserts cannot race
+     * past each other into the unique index.
+     */
+    private function lockQueue(Queue $queue): void
+    {
+        Queue::query()->whereKey($queue->id)->lockForUpdate()->firstOrFail();
+    }
+
+    /**
+     * @return list<string>
+     *
+     * @throws ValidationException when an entry is not a known permission string
+     */
+    private function validatedPermissions(array $permissions): array
+    {
+        $validated = Validator::make(
+            ['permissions' => $permissions],
+            [
+                'permissions' => ['array'],
+                'permissions.*' => ['string', Rule::enum(QueuePermission::class)],
+            ],
+        )->validate();
+
+        return array_values(array_unique($validated['permissions']));
+    }
+}
diff --git a/app/Actions/UpdateQueue.php b/app/Actions/UpdateQueue.php
new file mode 100644
index 0000000..b198766
--- /dev/null
+++ b/app/Actions/UpdateQueue.php
@@ -0,0 +1,68 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\NormalizesQueueAttributes;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+class UpdateQueue
+{
+    use NormalizesQueueAttributes;
+
+    /**
+     * `null` means "leave unchanged" for every parameter. Retiring a queue is
+     * done with `isActive: false`; queues are never hard-deleted.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $changes = [];
+
+        if ($name !== null) {
+            $changes['name'] = $this->normalizeName($name);
+        }
+
+        if ($slug !== null) {
+            $changes['slug'] = $this->normalizeSlug($slug);
+        }
+
+        if ($isActive !== null) {
+            $changes['is_active'] = $isActive;
+        }
+
+        try {
+            return DB::transaction(function () use ($queue, $changes): Queue {
+                // Queue-row lock serializes updates with issuance and calls,
+                // which lock the same row before reading is_active.
+                $lockedQueue = Queue::query()
+                    ->whereKey($queue->id)
+                    ->lockForUpdate()
+                    ->firstOrFail();
+
+                if (isset($changes['slug'])) {
+                    $this->assertSlugAvailable($lockedQueue->entity_id, $changes['slug'], $lockedQueue->id);
+                }
+
+                $lockedQueue->update($changes);
+
+                return $lockedQueue;
+            });
+        } catch (QueryException $e) {
+            if (! $this->isSlugConflict($e)) {
+                throw $e;
+            }
+
+            throw $this->slugTakenException();
+        }
+    }
+}
