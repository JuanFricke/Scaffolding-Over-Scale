+++ b/tests/Feature/Queue/CallAuthorizationTest.php
@@ -0,0 +1,141 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use LogicException;
+
+uses(RefreshDatabase::class);
+
+/**
+ * An active queue with one waiting ticket, plus an employee of the same entity.
+ *
+ * @return array{0: Queue, 1: Ticket, 2: User, 3: EntityMembership}
+ */
+function callAuthFixture(): array
+{
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue);
+    $employee = memberWithRole($entity, UserRole::Employee);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->firstOrFail();
+
+    return [$queue, $ticket, $employee, $membership];
+}
+
+it('lets an employee without a grant be refused by CallNextTicket in every mode', function (CallMode $mode) {
+    [$queue, $ticket, $employee] = callAuthFixture();
+
+    expect(fn () => (new CallNextTicket)($queue, $employee, $mode))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->fresh()->called_by_user_id)->toBeNull();
+})->with([CallMode::Any, CallMode::PriorityOnly, CallMode::NormalOnly]);
+
+it('lets an employee with a call grant call through CallNextTicket', function () {
+    [$queue, $ticket, $employee, $membership] = callAuthFixture();
+    QueueAccess::factory()->forMembership($membership)->create(['queue_id' => $queue->id]);
+
+    $called = (new CallNextTicket)($queue, $employee, CallMode::Any);
+
+    expect($called->id)->toBe($ticket->id)
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_by_user_id)->toBe($employee->id);
+});
+
+it('refuses CallNextTicket for a grant on another queue', function () {
+    [$queue, $ticket, $employee, $membership] = callAuthFixture();
+    $otherQueue = Queue::factory()->for($queue->entity)->create(['is_active' => true]);
+    QueueAccess::factory()->forMembership($membership)->create(['queue_id' => $otherQueue->id]);
+
+    expect(fn () => (new CallNextTicket)($queue, $employee, CallMode::Any))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('refuses CallNextTicket for a non-member', function () {
+    [$queue, $ticket] = callAuthFixture();
+    $stranger = User::factory()->create();
+
+    expect(fn () => (new CallNextTicket)($queue, $stranger, CallMode::Any))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('lets a manager call through CallNextTicket without a grant', function () {
+    [$queue, $ticket] = callAuthFixture();
+    $admin = memberWithRole($queue->entity, UserRole::Admin);
+
+    $called = (new CallNextTicket)($queue, $admin, CallMode::Any);
+
+    expect($called->id)->toBe($ticket->id);
+});
+
+it('checks the inactive queue before authorization in CallNextTicket', function () {
+    [$queue, , $employee, $membership] = callAuthFixture();
+    QueueAccess::factory()->forMembership($membership)->create(['queue_id' => $queue->id]);
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($queue, $employee, CallMode::Any))
+        ->toThrow(InactiveQueueException::class);
+
+    $stranger = User::factory()->create();
+    expect(fn () => (new CallNextTicket)($queue, $stranger, CallMode::Any))
+        ->toThrow(InactiveQueueException::class);
+});
+
+it('refuses Ticket::call for an employee without a grant and leaves the ticket waiting', function () {
+    [, $ticket, $employee] = callAuthFixture();
+
+    expect(fn () => $ticket->call($employee))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('lets an employee with a call grant call a ticket via Ticket::call', function () {
+    [$queue, $ticket, $employee, $membership] = callAuthFixture();
+    QueueAccess::factory()->forMembership($membership)->create(['queue_id' => $queue->id]);
+
+    $ticket->call($employee);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($employee->id);
+});
+
+it('authorizes before the waiting-state check in Ticket::call', function () {
+    [$queue, $ticket, $employee, $membership] = callAuthFixture();
+    $admin = memberWithRole($queue->entity, UserRole::Admin);
+    $ticket->call($admin);
+
+    expect(fn () => $ticket->fresh()->call($employee))
+        ->toThrow(AuthorizationException::class);
+
+    expect(fn () => $ticket->fresh()->call($admin))
+        ->toThrow(LogicException::class);
+});
+
+it('checks the inactive queue before authorization in Ticket::call', function () {
+    [$queue, $ticket, $employee] = callAuthFixture();
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => $ticket->call($employee))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
