+<?php
+
+namespace Database\Factories;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * The queue is created in the membership's entity, so the grant is
+     * always same-entity unless a test overrides both sides on purpose.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'entity_membership_id' => EntityMembership::factory(),
+            'queue_id' => fn (array $attributes) => Queue::factory()->for(
+                EntityMembership::query()->findOrFail($attributes['entity_membership_id'])->entity
+            ),
+            'permissions' => [QueuePermission::Call->value],
+        ];
+    }
+
+    public function forMembership(EntityMembership $membership): static
+    {
+        return $this->state(fn (): array => [
+            'entity_membership_id' => $membership->id,
+            'queue_id' => Queue::factory()->for($membership->entity),
+        ]);
+    }
+
+    public function forQueue(Queue $queue): static
+    {
+        return $this->state(fn (): array => [
+            'entity_membership_id' => EntityMembership::factory()->for($queue->entity),
+            'queue_id' => $queue->id,
+        ]);
+    }
+}
