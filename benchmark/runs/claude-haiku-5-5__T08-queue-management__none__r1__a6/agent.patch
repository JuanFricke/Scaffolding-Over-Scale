+
+it('resolves the policy for Queue via auto-discovery', function () {
+    expect(Gate::getPolicyFor(Queue::class))->toBeInstanceOf(QueuePolicy::class);
+});
+
+it('allows create only to owners and admins of that entity', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+
+    expect(Gate::forUser(memberWithRole($entity, UserRole::Owner))->allows('create', [Queue::class, $entity]))->toBeTrue()
+        ->and(Gate::forUser(memberWithRole($entity, UserRole::Admin))->allows('create', [Queue::class, $entity]))->toBeTrue()
+        ->and(Gate::forUser(memberWithRole($entity, UserRole::Employee))->allows('create', [Queue::class, $entity]))->toBeFalse()
+        ->and(Gate::forUser(memberWithRole($other, UserRole::Owner))->allows('create', [Queue::class, $entity]))->toBeFalse();
+});
+
+it('allows update and manageAccess only to owners and admins of the queue entity', function (string $ability) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(Gate::forUser(memberWithRole($entity, UserRole::Owner))->allows($ability, $queue))->toBeTrue()
+        ->and(Gate::forUser(memberWithRole($entity, UserRole::Admin))->allows($ability, $queue))->toBeTrue()
+        ->and(Gate::forUser(memberWithRole($entity, UserRole::Employee))->allows($ability, $queue))->toBeFalse()
+        ->and(Gate::forUser(memberWithRole(Entity::factory()->create(), UserRole::Owner))->allows($ability, $queue))->toBeFalse();
+})->with(['update', 'manageAccess']);
+
+it('lets owners and admins call on any queue of their entity without a grant', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(Gate::forUser(memberWithRole($entity, UserRole::Owner))->allows('call', $queue))->toBeTrue()
+        ->and(Gate::forUser(memberWithRole($entity, UserRole::Admin))->allows('call', $queue))->toBeTrue();
+});
+
+it('lets an employee call only with a call grant on that exact queue', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $otherQueue = Queue::factory()->for($entity)->create();
+    $employee = memberWithRole($entity, UserRole::Employee);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->firstOrFail();
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+
+    QueueAccess::factory()->forMembership($membership)->create(['queue_id' => $otherQueue->id]);
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+
+    QueueAccess::factory()->forMembership($membership)->create(['queue_id' => $queue->id]);
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeTrue();
+});
+
+it('denies an employee whose grant has no call permission', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberWithRole($entity, UserRole::Employee);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->firstOrFail();
+
+    QueueAccess::factory()->forMembership($membership)->create(['permissions' => []]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+});
+
+it('denies call when the stored permissions are corrupted', function (string $raw) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberWithRole($entity, UserRole::Employee);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->firstOrFail();
+    QueueAccess::factory()->forMembership($membership)->create(['queue_id' => $queue->id]);
+
+    DB::table('queue_access')
+        ->where('entity_membership_id', $membership->id)
+        ->update(['permissions' => $raw]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+})->with([
+    'json string' => ['"call"'],
+    'json null' => ['null'],
+    'json object' => ['{"call": true}'],
+    'not json' => ['call'],
+]);
+
+it('denies call to non-members and to members of another entity holding a grant', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $stranger = memberWithRole(Entity::factory()->create(), UserRole::Employee);
+
+    $foreignMembership = EntityMembership::query()->where('user_id', $stranger->id)->firstOrFail();
+    QueueAccess::factory()->forMembership($foreignMembership)->create(['queue_id' => $queue->id]);
+
+    $outsider = User::factory()->create();
+
+    expect(Gate::forUser($stranger)->allows('call', $queue))->toBeFalse()
+        ->and(Gate::forUser($outsider)->allows('call', $queue))->toBeFalse();
+});
diff --git a/tests/Feature/Queue/SetQueueAccessTest.php b/tests/Feature/Queue/SetQueueAccessTest.php
new file mode 100644
index 0000000..13897eb
--- /dev/null
+++ b/tests/Feature/Queue/SetQueueAccessTest.php
@@ -0,0 +1,162 @@
+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array{0: Entity, 1: Queue, 2: EntityMembership, 3: User}
+ */
+function accessFixture(): array
+{
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $employee = memberWithRole($entity, UserRole::Employee);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->firstOrFail();
+
+    return [$entity, $queue, $membership, $employee];
+}
+
+it('grants call on a queue by upserting the access row', function () {
+    [$entity, $queue, $membership] = accessFixture();
+    $admin = memberWithRole($entity, UserRole::Admin);
+
+    (new SetQueueAccess)($membership, $queue, $admin, ['call']);
+
+    $access = QueueAccess::query()
+        ->where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->sole();
+
+    expect($access->permissions)->toBe(['call']);
+});
+
+it('deduplicates repeated permissions and upserts instead of duplicating rows', function () {
+    [$entity, $queue, $membership] = accessFixture();
+    $owner = memberWithRole($entity, UserRole::Owner);
+
+    (new SetQueueAccess)($membership, $queue, $owner, ['call']);
+    (new SetQueueAccess)($membership, $queue, $owner, ['call', 'call']);
+
+    expect(QueueAccess::query()->count())->toBe(1)
+        ->and(QueueAccess::query()->sole()->permissions)->toBe(['call']);
+});
+
+it('revokes by deleting the row when given an empty list', function () {
+    [$entity, $queue, $membership] = accessFixture();
+    $owner = memberWithRole($entity, UserRole::Owner);
+    (new SetQueueAccess)($membership, $queue, $owner, ['call']);
+
+    (new SetQueueAccess)($membership, $queue, $owner, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('does nothing when revoking a membership that has no row', function () {
+    [$entity, $queue, $membership] = accessFixture();
+    $owner = memberWithRole($entity, UserRole::Owner);
+    Event::fake([MessageLogged::class]);
+
+    (new SetQueueAccess)($membership, $queue, $owner, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+    Event::assertNotDispatched(
+        MessageLogged::class,
+        fn (MessageLogged $log) => $log->message === 'queue.access.revoked',
+    );
+});
+
+it('audits grants and revokes on the audit channel with actor, queue and membership', function () {
+    [$entity, $queue, $membership] = accessFixture();
+    $owner = memberWithRole($entity, UserRole::Owner);
+    Event::fake([MessageLogged::class]);
+
+    (new SetQueueAccess)($membership, $queue, $owner, ['call']);
+    (new SetQueueAccess)($membership, $queue, $owner, []);
+
+    Event::assertDispatched(
+        MessageLogged::class,
+        fn (MessageLogged $log) => $log->level === 'info'
+            && $log->message === 'queue.access.granted'
+            && $log->context['actor_id'] === $owner->id
+            && $log->context['queue_id'] === $queue->id
+            && $log->context['entity_membership_id'] === $membership->id,
+    );
+    Event::assertDispatched(
+        MessageLogged::class,
+        fn (MessageLogged $log) => $log->level === 'info'
+            && $log->message === 'queue.access.revoked'
+            && $log->context['actor_id'] === $owner->id
+            && $log->context['queue_id'] === $queue->id
+            && $log->context['entity_membership_id'] === $membership->id,
+    );
+});
+
+it('rejects unknown or non-string permissions without storing anything', function (array $permissions) {
+    [$entity, $queue, $membership] = accessFixture();
+    $owner = memberWithRole($entity, UserRole::Owner);
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $owner, $permissions))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with([
+    'unknown string' => [['manage']],
+    'wrong case' => [['Call']],
+    'mixed valid and unknown' => [['call', 'delete']],
+    'integer entry' => [[1]],
+    'null entry' => [[null]],
+    'nested array' => [[['call']]],
+]);
+
+it('rejects a membership and queue from different entities', function () {
+    [, $queue] = accessFixture();
+    $otherEntity = Entity::factory()->create();
+    $otherEmployee = memberWithRole($otherEntity, UserRole::Employee);
+    $foreignMembership = EntityMembership::query()->where('user_id', $otherEmployee->id)->firstOrFail();
+    $queueOwner = memberWithRole($queue->entity, UserRole::Owner);
+
+    expect(fn () => (new SetQueueAccess)($foreignMembership, $queue, $queueOwner, ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('lets owners and admins of the queue entity manage access', function (UserRole $role) {
+    [$entity, $queue, $membership] = accessFixture();
+    $manager = memberWithRole($entity, $role);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    expect(QueueAccess::query()->count())->toBe(1);
+})->with([UserRole::Owner, UserRole::Admin]);
+
+it('denies employees, including an employee granting themselves', function () {
+    [$entity, $queue, $membership, $employee] = accessFixture();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $employee, ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('denies non-members and managers of another entity without writing', function () {
+    [, $queue, $membership] = accessFixture();
+    $stranger = memberWithRole(Entity::factory()->create(), UserRole::Owner);
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $stranger, ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
diff --git a/tests/Feature/Queue/UpdateQueueTest.php b/tests/Feature/Queue/UpdateQueueTest.php
new file mode 100644
