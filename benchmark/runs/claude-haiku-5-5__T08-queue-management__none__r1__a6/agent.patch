+++ b/tests/Feature/Queue/UpdateQueueTest.php
@@ -0,0 +1,184 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\CreateQueue;
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Enums\CallMode;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function updateQueueFixture(): array
+{
+    $entity = Entity::factory()->create();
+    $admin = memberWithRole($entity, UserRole::Admin);
+    $queue = (new CreateQueue)($entity, $admin, 'Atendimento Geral');
+
+    return [$entity, $admin, $queue];
+}
+
+it('leaves every field unchanged when all arguments are null', function () {
+    [, $admin, $queue] = updateQueueFixture();
+
+    $updated = (new UpdateQueue)($queue, $admin);
+
+    expect($updated)
+        ->name->toBe('Atendimento Geral')
+        ->slug->toBe('atendimento-geral')
+        ->is_active->toBeTrue();
+});
+
+it('renames without touching the slug', function () {
+    [, $admin, $queue] = updateQueueFixture();
+
+    $updated = (new UpdateQueue)($queue, $admin, name: '  Preferencial ');
+
+    expect($updated->name)->toBe('Preferencial')
+        ->and($updated->slug)->toBe('atendimento-geral');
+});
+
+it('changes the slug and slugifies it', function () {
+    [, $admin, $queue] = updateQueueFixture();
+
+    $updated = (new UpdateQueue)($queue, $admin, slug: 'Balcao Novo!');
+
+    expect($updated->slug)->toBe('balcao-novo')
+        ->and($queue->fresh()->slug)->toBe('balcao-novo');
+});
+
+it('keeps the queue own slug without a conflict', function () {
+    [, $admin, $queue] = updateQueueFixture();
+
+    $updated = (new UpdateQueue)($queue, $admin, name: 'Outro', slug: 'atendimento-geral');
+
+    expect($updated->slug)->toBe('atendimento-geral');
+});
+
+it('rejects taking the slug of another queue in the same entity', function () {
+    [$entity, $admin, $queue] = updateQueueFixture();
+    (new CreateQueue)($entity, $admin, 'Preferencial');
+
+    expect(fn () => (new UpdateQueue)($queue, $admin, slug: 'preferencial'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->slug)->toBe('atendimento-geral');
+});
+
+it('allows taking the slug of a queue in another entity', function () {
+    [, $admin, $queue] = updateQueueFixture();
+    $other = Entity::factory()->create();
+    $otherAdmin = memberWithRole($other, UserRole::Admin);
+    (new CreateQueue)($other, $otherAdmin, 'Preferencial');
+
+    $updated = (new UpdateQueue)($queue, $admin, slug: 'preferencial');
+
+    expect($updated->slug)->toBe('preferencial');
+});
+
+it('rejects a blank name and a blank slug', function (array $args) {
+    [, $admin, $queue] = updateQueueFixture();
+
+    expect(fn () => (new UpdateQueue)($queue, $admin, ...$args))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh())
+        ->name->toBe('Atendimento Geral')
+        ->slug->toBe('atendimento-geral');
+})->with([
+    'blank name' => [['name' => '  ']],
+    'blank slug' => [['slug' => '!!!']],
+]);
+
+it('retires a queue by deactivating it without deleting it or its tickets', function () {
+    [, $admin, $queue] = updateQueueFixture();
+    $ticket = (new IssueTicket)($queue);
+
+    $updated = (new UpdateQueue)($queue, $admin, isActive: false);
+
+    expect($updated->is_active)->toBeFalse()
+        ->and(Queue::query()->whereKey($queue->id)->exists())->toBeTrue()
+        ->and(Ticket::query()->whereKey($ticket->id)->exists())->toBeTrue();
+});
+
+it('makes issuing and calling fail on a deactivated queue', function () {
+    [, $admin, $queue] = updateQueueFixture();
+    (new IssueTicket)($queue);
+    (new UpdateQueue)($queue, $admin, isActive: false);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(fn () => (new CallNextTicket)($queue, $admin, CallMode::Any))
+        ->toThrow(InactiveQueueException::class);
+});
+
+it('reactivates a queue when asked', function () {
+    [, $admin, $queue] = updateQueueFixture();
+    (new UpdateQueue)($queue, $admin, isActive: false);
+
+    $updated = (new UpdateQueue)($queue, $admin, isActive: true);
+
+    expect($updated->is_active)->toBeTrue();
+});
+
+it('applies name, slug and active flag together', function () {
+    [, $admin, $queue] = updateQueueFixture();
+
+    $updated = (new UpdateQueue)(
+        $queue,
+        $admin,
+        name: 'Caixa',
+        slug: 'caixa-1',
+        isActive: false,
+    );
+
+    expect($updated)
+        ->name->toBe('Caixa')
+        ->slug->toBe('caixa-1')
+        ->is_active->toBeFalse();
+});
+
+it('denies employees and non-managers without writing', function (string $who) {
+    [$entity, , $queue] = updateQueueFixture();
+    $actor = match ($who) {
+        'employee' => memberWithRole($entity, UserRole::Employee),
+        'stranger' => memberWithRole(Entity::factory()->create(), UserRole::Owner),
+    };
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'Novo', isActive: false))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh())
+        ->name->toBe('Atendimento Geral')
+        ->is_active->toBeTrue();
+})->with(['employee', 'stranger']);
+
+it('turns a slug unique-index race into a validation error', function () {
+    [$entity, $admin, $queue] = updateQueueFixture();
+
+    // Concurrent insert of the target slug lands after our check and before our UPDATE.
+    Queue::updating(function (Queue $queue) use ($entity): void {
+        DB::table('queues')->insert([
+            'entity_id' => $entity->id,
+            'name' => 'Concorrente',
+            'slug' => 'caixa-disputada',
+            'is_active' => true,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    });
+
+    expect(fn () => (new UpdateQueue)($queue, $admin, slug: 'caixa-disputada'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->slug)->toBe('atendimento-geral');
+});
