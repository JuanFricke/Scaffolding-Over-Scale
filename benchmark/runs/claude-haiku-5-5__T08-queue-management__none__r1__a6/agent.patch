diff --git a/app/Actions/Concerns/NormalizesQueueAttributes.php b/app/Actions/Concerns/NormalizesQueueAttributes.php
new file mode 100644
index 0000000..12f7e07
--- /dev/null
+++ b/app/Actions/Concerns/NormalizesQueueAttributes.php
@@ -0,0 +1,75 @@
+<?php
+
+namespace App\Actions\Concerns;
+
+use App\Models\Queue;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Name/slug rules shared by CreateQueue and UpdateQueue so both write paths
+ * agree on trimming, slugification and per-entity slug uniqueness.
+ */
+trait NormalizesQueueAttributes
+{
+    protected function normalizeName(string $name): string
+    {
+        $name = trim($name);
+
+        Validator::make(
+            ['name' => $name],
+            ['name' => ['required', 'string', 'max:255']],
+        )->validate();
+
+        return $name;
+    }
+
+    protected function normalizeSlug(string $slug): string
+    {
+        $slug = Str::slug($slug);
+
+        Validator::make(
+            ['slug' => $slug],
+            ['slug' => ['required', 'string', 'max:255']],
+        )->validate();
+
+        return $slug;
+    }
+
+    /**
+     * @throws ValidationException when another queue of the entity owns the slug
+     */
+    protected function assertSlugAvailable(int $entityId, string $slug, ?int $exceptQueueId = null): void
+    {
+        $taken = Queue::query()
+            ->where('entity_id', $entityId)
+            ->where('slug', $slug)
+            ->when($exceptQueueId !== null, fn ($query) => $query->whereKeyNot($exceptQueueId))
+            ->exists();
+
+        if ($taken) {
+            throw $this->slugTakenException();
+        }
+    }
+
+    /**
+     * The unique index can still fire when two requests race past the
+     * existence check above; surface it as the same validation error.
+     */
+    protected function isSlugConflict(QueryException $e): bool
+    {
+        $message = strtolower($e->getMessage());
+
+        return str_contains($message, 'queues_entity_id_slug_unique')
+            || str_contains($message, 'queues.entity_id, queues.slug');
+    }
+
+    protected function slugTakenException(): ValidationException
+    {
+        return ValidationException::withMessages([
+            'slug' => ['This slug is already used by another queue in this entity.'],
+        ]);
+    }
+}
diff --git a/app/Actions/CreateQueue.php b/app/Actions/CreateQueue.php
