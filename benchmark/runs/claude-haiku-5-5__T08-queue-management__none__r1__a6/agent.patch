 }
+
+/**
+ * A user who is an admin of the queue's entity, so they may call its tickets.
+ */
+function managerOf(Queue $queue): User
+{
+    return memberWithRole($queue->entity, UserRole::Admin);
+}
+
+/**
+ * A fresh user holding the given role in the entity.
+ */
+function memberWithRole(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+
+    EntityMembership::factory()
+        ->for($entity)
+        ->for($user)
+        ->state(['role' => $role->value])
+        ->create();
+
+    return $user;
+}
