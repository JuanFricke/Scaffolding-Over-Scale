+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Entity $entity, string $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->{$role}()->create();
+
+    return $user;
+}
+
+it('is discovered by the Gate', function () {
+    $entity = Entity::factory()->create();
+    $owner = memberOf($entity, 'owner');
+
+    expect(Gate::forUser($owner)->allows('manageSettings', $entity))->toBeTrue()
+        ->and(Gate::getPolicyFor(Entity::class))->toBeInstanceOf(EntityPolicy::class)
+        ->and(Gate::getPolicyFor(EntityMembership::class))->toBeInstanceOf(EntityMembershipPolicy::class);
+});
+
+it('lets anyone create an entity', function () {
+    expect((new EntityPolicy)->create(User::factory()->create()))->toBeTrue();
+});
+
+it('applies the entity rules per role', function (?string $role, bool $view, bool $update, bool $delete, bool $settings) {
+    $entity = Entity::factory()->create();
+    $user = $role ? memberOf($entity, $role) : User::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->view($user, $entity))->toBe($view)
+        ->and($policy->update($user, $entity))->toBe($update)
+        ->and($policy->delete($user, $entity))->toBe($delete)
+        ->and($policy->manageSettings($user, $entity))->toBe($settings);
+})->with([
+    'owner' => ['owner', true, true, true, true],
+    'admin' => ['admin', true, true, true, false],
+    'employee' => ['employee', true, false, false, false],
+    'non-member' => [null, false, false, false, false],
+]);
+
+it('denies members of another entity', function () {
+    $entity = Entity::factory()->create();
+    $outsider = memberOf(Entity::factory()->create(), 'owner');
+
+    expect((new EntityPolicy)->view($outsider, $entity))->toBeFalse()
+        ->and((new EntityPolicy)->manageSettings($outsider, $entity))->toBeFalse();
+});
+
+it('applies the membership rules per role', function (?string $role, bool $view, bool $assign, bool $deleteOther) {
+    $entity = Entity::factory()->create();
+    $user = $role ? memberOf($entity, $role) : User::factory()->create();
+    $target = EntityMembership::factory()->for($entity)->employee()->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($user, $target))->toBe($view)
+        ->and($policy->assignRole($user, $target))->toBe($assign)
+        ->and($policy->delete($user, $target))->toBe($deleteOther);
+})->with([
+    'owner' => ['owner', true, true, true],
+    'admin' => ['admin', true, true, true],
+    'employee' => ['employee', true, false, false],
+    'non-member' => [null, false, false, false],
+]);
+
+it('never allows deleting the owner membership, even by the owner', function () {
+    $entity = Entity::factory()->create();
+    $ownerMembership = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = memberOf($entity, 'admin');
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($ownerMembership->user, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($admin, $ownerMembership))->toBeFalse();
+});
+
+it('allows self-removal for non-owners', function (string $role) {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->{$role}()->create();
+
+    expect((new EntityMembershipPolicy)->delete($membership->user, $membership))->toBeTrue();
+})->with(['admin', 'employee']);
+
+it('does not let admins of another entity touch a membership', function () {
+    $target = EntityMembership::factory()->employee()->create();
+    $outsider = memberOf(Entity::factory()->create(), 'admin');
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($outsider, $target))->toBeFalse()
+        ->and($policy->assignRole($outsider, $target))->toBeFalse()
+        ->and($policy->delete($outsider, $target))->toBeFalse();
+});
