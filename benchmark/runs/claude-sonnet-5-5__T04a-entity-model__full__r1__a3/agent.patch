+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,146 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+it('has the expected tables and columns', function () {
+    expect(Schema::hasColumns('entities', ['id', 'name', 'slug', 'created_at', 'updated_at', 'deleted_at']))->toBeTrue()
+        ->and(Schema::hasColumns('entity_memberships', ['id', 'entity_id', 'user_id', 'role', 'owner_seq', 'created_at', 'updated_at']))->toBeTrue();
+});
+
+it('names the unique indexes as specified', function () {
+    $slug = collect(Schema::getIndexes('entities'))->where('unique', true)->pluck('name');
+    expect($slug)->toContain('entities_slug_unique');
+
+    $names = collect(Schema::getIndexes('entity_memberships'))->where('unique', true)->pluck('name');
+    expect($names)->toContain('entity_memberships_entity_user_unique', 'entity_memberships_one_owner');
+});
+
+it('exposes UserRole values and manageable roles', function () {
+    expect(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee')
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+it('binds entities by slug', function () {
+    expect((new Entity)->getRouteKeyName())->toBe('slug');
+});
+
+it('creates entities with a name and a unique slug', function () {
+    $a = Entity::factory()->create();
+    $b = Entity::factory()->create();
+
+    expect($a->name)->not->toBeEmpty()->and($a->slug)->not->toBe($b->slug);
+});
+
+it('rejects duplicate slugs', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+    Entity::factory()->create(['slug' => 'acme']);
+})->throws(QueryException::class);
+
+it('soft deletes entities', function () {
+    $entity = Entity::factory()->create();
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+it('defaults memberships to employee and casts the role', function () {
+    $membership = EntityMembership::factory()->create()->refresh();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+});
+
+it('defaults the role column to employee at the database level', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    $membership = EntityMembership::create(['entity_id' => $entity->id, 'user_id' => $user->id])->refresh();
+
+    expect($membership->role)->toBe(UserRole::Employee);
+});
+
+it('has role states and scopes', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->count(2)->create();
+
+    expect(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(2);
+});
+
+it('resolves the owner, members and users of an entity', function () {
+    $entity = Entity::factory()->create();
+    expect($entity->owner()->first())->toBeNull();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->for($entity)->create();
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue()
+        ->and($entity->memberships)->toHaveCount(2)
+        ->and($entity->users)->toHaveCount(2);
+});
+
+it('resolves user memberships, entities and membershipFor', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->admin()->for($user)->create();
+    $other = Entity::factory()->create();
+
+    expect($user->memberships)->toHaveCount(1)
+        ->and($user->entities->first()->is($membership->entity))->toBeTrue()
+        ->and($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor($other->id))->toBeNull();
+});
+
+it('rejects a second owner in the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+})->throws(QueryException::class);
+
+it('rejects promoting a member to a second owner', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    $member = EntityMembership::factory()->for($entity)->create();
+
+    $member->update(['role' => UserRole::Owner]);
+})->throws(QueryException::class);
+
+it('allows one owner per entity and any number of non-owners', function () {
+    $a = Entity::factory()->create();
+    $b = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($a)->create();
+    EntityMembership::factory()->owner()->for($b)->create();
+    EntityMembership::factory()->admin()->count(2)->for($a)->create();
+    EntityMembership::factory()->employee()->count(3)->for($a)->create();
+
+    expect(EntityMembership::count())->toBe(7);
+});
+
+it('rejects the same user twice in one entity', function () {
+    $membership = EntityMembership::factory()->create();
+    EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]);
+})->throws(QueryException::class);
+
+it('cascades memberships when the user is deleted', function () {
+    $membership = EntityMembership::factory()->create();
+    $membership->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..8dab996
--- /dev/null
