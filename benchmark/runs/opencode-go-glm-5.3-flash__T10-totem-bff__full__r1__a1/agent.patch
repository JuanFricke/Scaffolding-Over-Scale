+<?php
+
+namespace Database\Factories;
+
+use App\Models\Entity;
+use App\Models\TotemPreset;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<TotemPreset>
+ */
+class TotemPresetFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * A preset factory row is pairing-ready: its own unique six-digit
+     * `login_code` is unconsumed, expires in 10 minutes and the preset is
+     * active.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'entity_id' => Entity::factory(),
+            'name' => fake()->unique()->words(2, true),
+            'login_code' => self::unusedCode(),
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+            'appearance' => null,
+            'is_active' => true,
+        ];
+    }
+
+    /**
+     * A fresh six-digit code no stored preset owns (collisions are safe to
+     * retry: a 10-digit space grows monolithically slower than test rows).
+     */
+    private static function unusedCode(): string
+    {
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while (TotemPreset::query()->where('login_code', $code)->exists());
+
+        return $code;
+    }
+}
