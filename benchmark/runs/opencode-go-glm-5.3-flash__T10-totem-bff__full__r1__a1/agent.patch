@@ -0,0 +1,46 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Open the pairing window for a totem preset.
+ *
+ * Replaces the preset's one-time six-digit login code with a fresh
+ * cryptographically random one (zero-padded, digits only), expiring in
+ * 10 minutes and unconsumed — any previous code stops working immediately.
+ * Regeneration resets nothing else; pairing itself is `App\Actions\PairTotem`.
+ */
+class OpenPairingWindow
+{
+    public const CODE_TTL_MINUTES = 10;
+
+    public function __invoke(TotemPreset $preset): TotemPreset
+    {
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        return DB::transaction(function () use ($preset, $code): TotemPreset {
+            // Row lock serializes regeneration against concurrent pairing.
+            $locked = TotemPreset::query()
+                ->whereKey($preset->getKey())
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            $locked->forceFill([
+                'login_code' => $code,
+                'login_code_expires_at' => now()->addMinutes(self::CODE_TTL_MINUTES),
+                'login_code_consumed_at' => null,
+            ])->save();
+
+            Log::channel('audit')->info('totem.pairing_code.generated', [
+                'preset_id' => $locked->getKey(),
+                'entity_id' => $locked->entity_id,
+            ]);
+
+            return $locked->withoutRelations();
+        });
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
new file mode 100644
index 0000000..4753609
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use App\Support\TotemSession;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Consume a pairing code and mint the paired totem session.
+ *
+ * Atomically (preset row lock): unknown, expired, consumed or inactive
+ * presets all fail with the same InvalidPairingCodeException — the sender
+ * renders `{"code":"invalid_pairing_code"}` with no oracle. On success the
+ * code is marked consumed, a fresh `totems` row is registered for the
+ * preset's entity and the JWT is signed. Pairing success and rejection are
+ * audit-logged; the full code is never logged.
+ */
+class PairTotem
+{
+    public function __invoke(string $code): TotemSession
+    {
+        [$totem, $preset] = DB::transaction(function () use ($code): array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null || ! self::isPairable($preset)) {
+                Log::channel('audit')->info('totem.pairing.rejected', [
+                    'preset_id' => $preset?->getKey(),
+                ]);
+
+                throw new InvalidPairingCodeException('The pairing code is not valid.');
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = Totem::create([
+                'entity_id' => (int) $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            return [$totem, $preset->withoutRelations()];
+        });
+
+        Log::channel('audit')->info('totem.pairing.succeeded', [
+            'totem_id' => $totem->getKey(),
+            'entity_id' => $totem->entity_id,
+            'preset_id' => $preset->getKey(),
+        ]);
+
+        $service = app(TotemJwt::class);
+
+        return new TotemSession(
+            token: $service->issue($totem, $preset),
+            expiresIn: $service->ttl(),
+            entity: $totem->entity,
+            totem: $totem,
+        );
+    }
+
+    /**
+     * Pairing rules: preset active, code not consumed, code not expired.
+     * (Called under the preset row lock.)
+     */
+    private static function isPairable(TotemPreset $preset): bool
+    {
+        return $preset->is_active
+            && $preset->login_code_consumed_at === null
+            && $preset->login_code_expires_at !== null
+            && $preset->login_code_expires_at->isFuture();
+    }
+}
