+<?php
+
+use App\Http\Controllers\Totem\AuthController;
+use App\Http\Controllers\Totem\TotemController;
+use Illuminate\Support\Facades\Route;
+
+/*
+|--------------------------------------------------------------------------
+| Totem BFF (docs/api/totem.md)
+|--------------------------------------------------------------------------
+|
+| Pairing login + the three totem data endpoints consumed by the Flutter
+| totem client. `totem.auth` validates the pairing JWT on every
+| authenticated call.
+|
+*/
+
+Route::post('totem/auth', [AuthController::class, 'pair'])
+    ->middleware('throttle:totem-auth');
+
+Route::middleware('totem.auth')->group(function (): void {
+    Route::get('{entity}/queues', [TotemController::class, 'queues']);
+
+    Route::get('{entity}/{queue}/priorities', [TotemController::class, 'priorities']);
+
+    Route::post('{entity}/{queue}/ticket', [TotemController::class, 'ticket'])
+        ->middleware('throttle:totem-ticket');
+});
diff --git a/tests/Feature/TotemApiTest.php b/tests/Feature/TotemApiTest.php
new file mode 100644
index 0000000..7d24d7c
--- /dev/null
+++ b/tests/Feature/TotemApiTest.php
@@ -0,0 +1,372 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * A paired totem: entity with the given number of queues scoped into a preset
+ * and a signed token for a fresh device row.
+ *
+ * @return array{entity: Entity, queues: list<Queue>, preset: TotemPreset, totem: Totem, token: string}
+ */
+function pairedTotem(int $queueCount = 1): array
+{
+    $entity = Entity::factory()->create();
+    $queues = Queue::factory()->count($queueCount)->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queues);
+    $totem = Totem::factory()->for($entity)->create();
+
+    return [
+        'entity' => $entity,
+        'queues' => $queues,
+        'preset' => $preset,
+        'totem' => $totem,
+        'token' => app(TotemJwt::class)->issue($totem, $preset),
+    ];
+}
+
+/**
+ * Bearer headers for an issued totem token.
+ *
+ * @return array<string, string>
+ */
+function bearer(string $token): array
+{
+    return ['Authorization' => 'Bearer '.$token];
+}
+
+// ---------------------------------------------------------------------------
+// Middleware (token validation)
+// ---------------------------------------------------------------------------
+
+it('rejects unauthenticated totem calls', function () {
+    ['entity' => $entity] = pairedTotem();
+
+    $this->getJson("/api/{$entity->slug}/queues")
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('rejects a malformed bearer token', function () {
+    ['entity' => $entity] = pairedTotem();
+
+    $this->getJson("/api/{$entity->slug}/queues", bearer('garbage.here.now'))
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('rejects a tampered token', function () {
+    // payload.signature where payload is well-formed but unsigned
+    ['entity' => $entity] = pairedTotem();
+
+    $payload = base64_encode(json_encode(['totem_id' => 1, 'entity_id' => 1, 'preset_id' => 1, 'queues' => []]));
+    $this->getJson("/api/{$entity->slug}/queues", bearer("{$payload}.tampered"))
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('rejects an expired token', function () {
+    ['entity' => $entity, 'totem' => $totem, 'preset' => $preset] = pairedTotem();
+
+    $expired = app(TotemJwt::class)->encode([
+        'totem_id' => $totem->id,
+        'entity_id' => $totem->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => $preset->queues()->pluck('queues.id')->all(),
+        'iat' => time() - 7200,
+        'exp' => time() - 3600,
+        'jti' => bin2hex(random_bytes(16)),
+    ]);
+
+    $this->getJson("/api/{$entity->slug}/queues", bearer($expired))
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('rejects a token whose claims disagree with the totem rows', function () {
+    ['entity' => $entity, 'totem' => $totem, 'preset' => $preset] = pairedTotem();
+
+    // Same signature as a real token, but the entity claim points elsewhere.
+    $claims = app(TotemJwt::class)->encode([
+        'totem_id' => $totem->id,
+        'entity_id' => $totem->entity_id + 1,
+        'preset_id' => $preset->id,
+        'queues' => [],
+        'iat' => time(),
+        'exp' => time() + 3600,
+        'jti' => bin2hex(random_bytes(16)),
+    ]);
+    unset($token);
+
+    $this->getJson("/api/{$entity->slug}/queues", bearer($claims))
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('rejects a call from a deactivated totem', function () {
+    ['entity' => $entity, 'totem' => $totem, 'preset' => $preset, 'token' => $token] = pairedTotem();
+    $totem->update(['is_active' => false]);
+
+    $this->getJson("/api/{$entity->slug}/queues", bearer($token))
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('rejects a call from a deactivated preset', function () {
+    ['entity' => $entity, 'totem' => $totem, 'preset' => $preset] = pairedTotem();
+    $preset->update(['is_active' => false]);
+
+    $this->getJson("/api/{$entity->slug}/queues", bearer(app(TotemJwt::class)->issue($totem, $preset->refresh())))
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('records last seen on every authenticated call', function () {
+    ['entity' => $entity, 'totem' => $totem, 'token' => $token] = pairedTotem();
+
+    expect($totem->last_seen_at)->toBeNull();
+
+    $this->travelTo(now()->addMinutes(5));
+    $this->getJson("/api/{$entity->slug}/queues", bearer($token))->assertOk();
+
+    expect($totem->refresh()->last_seen_at)->not->toBeNull();
+});
+
+// ---------------------------------------------------------------------------
+// GET /api/{entity}/queues
+// ---------------------------------------------------------------------------
+
+it('lists scoped active queues with display order', function () {
+    ['entity' => $entity, 'queues' => $queues, 'token' => $token] = pairedTotem(3);
+
+    $payload = $this->getJson("/api/{$entity->slug}/queues", bearer($token))
+
+        ->assertOk()
+        ->assertJsonStructure([
+            'entity' => ['slug', 'name'],
+            'queues' => [['slug', 'label', 'description', 'visual' => ['color', 'icon', 'order'], 'is_active']],
+        ])->json();
+
+    expect($payload['entity']['slug'])->toBe($entity->slug)
+        ->and($payload['entity']['name'])->toBe($entity->name)
+        ->and($payload['queues'])->toHaveCount(3);
+
+    $sorted = $queues->sortBy('name')->values();
+    foreach ($payload['queues'] as $i => $queue) {
+        expect($queue['slug'])->toBe($sorted[$i]->slug)
+            ->and($queue['label'])->toBe($sorted[$i]->name)
+            ->and($queue['is_active'])->toBeTrue()
+            ->and($queue['visual']['order'])->toBe($i + 1);
+    }
+});
+
+it('answers 403 forbidden when the path entity is not the token entity', function () {
+    ['entity' => $entity, 'token' => $token] = pairedTotem();
+    $other = Entity::factory()->create();
+
+    $this->getJson("/api/{$other->slug}/queues", bearer($token))
+        ->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+});
+
+it('lists only queues in the preset scope', function () {
+    $entity = Entity::factory()->create();
+    $inScope = Queue::factory()->for($entity)->create();
+    $outScope = Queue::factory()->for($entity)->create();
+    Queue::factory()->create(); // another entity's queue
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($inScope);
+    $totem = Totem::factory()->for($entity)->create();
+    $token = app(TotemJwt::class)->issue($totem, $preset);
+
+    $payload = $this->getJson("/api/{$entity->slug}/queues", bearer($token))->assertOk()->json();
+
+    expect(collect($payload['queues'])->pluck('slug')->all())->toBe([$inScope->slug])
+        ->not->toContain($outScope->slug);
+});
+
+it('excludes inactive queues from the listing', function () {
+    ['entity' => $entity, 'queues' => $queues, 'token' => $token] = pairedTotem(2);
+    $queues->first()->update(['is_active' => false]);
+
+    $payload = $this->getJson("/api/{$entity->slug}/queues", bearer($token))->assertOk()->json();
+
+    expect(count($payload['queues']))->toBe(1)
+        ->and($payload['queues'][0]['is_active'])->toBeTrue();
+});
+
+// ---------------------------------------------------------------------------
+// GET /api/{entity}/{queue}/priorities
+// ---------------------------------------------------------------------------
+
+it('lists the backend owned priority levels for a queue', function () {
+    ['entity' => $entity, 'queues' => [$queue], 'token' => $token] = pairedTotem(1);
+
+    $this->getJson("/api/{$entity->slug}/{$queue->slug}/priorities", bearer($token))
+        ->assertOk()
+        ->assertJson([
+            'entity' => ['slug' => $entity->slug],
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priorities' => [
+                ['value' => 0, 'label' => 'Normal', 'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1]],
+                ['value' => 10, 'label' => 'Prioritário', 'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2]],
+                ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => ['color' => '#6A1B9A', 'icon' => 'elderly', 'order' => 3]],
+            ],
+        ]);
+});
+
+it('answers 404 for another entitys queue slug', function () {
+    ['entity' => $entity, 'token' => $token] = pairedTotem(1);
+    $otherQueue = Queue::factory()->create();
+
+    $this->getJson("/api/{$entity->slug}/{$otherQueue->slug}/priorities", bearer($token))
+        ->assertStatus(404)
+        ->assertJson(['code' => 'queue_not_found']);
+});
+
+it('answers 403 when the queue is outside the preset scope', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $unscoped = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+    $totem = Totem::factory()->for($entity)->create();
+    $token = app(TotemJwt::class)->issue($totem, $preset);
+
+    $this->getJson("/api/{$entity->slug}/{$unscoped->slug}/priorities", bearer($token))
+        ->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+});
+
+it('answers 422 for an inactive queue on priorities', function () {
+    ['entity' => $entity, 'queues' => [$queue], 'token' => $token] = pairedTotem(1);
+    $queue->update(['is_active' => false]);
+
+    $this->getJson("/api/{$entity->slug}/{$queue->slug}/priorities", bearer($token))
+        ->assertStatus(422)
+        ->assertJson(['code' => 'inactive_queue']);
+});
+
+// ---------------------------------------------------------------------------
+// POST /api/{entity}/{queue}/ticket
+// ---------------------------------------------------------------------------
+
+it('issues a totem ticket with a sequential per-queue code', function () {
+    ['entity' => $entity, 'queues' => [$queue], 'token' => $token] = pairedTotem(1);
+
+    $first = $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 10], bearer($token));
+
+    $first->assertStatus(201)
+        ->assertJsonStructure(['slug', 'queue' => ['slug', 'label'], 'priority' => ['value', 'label'], 'issued_at'])
+        ->assertJson([
+            'slug' => 'A001',
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priority' => ['value' => 10, 'label' => 'Prioritário'],
+        ]);
+
+    expect($first->json('issued_at'))->not->toBeNull();
+
+    $ticket = Ticket::query()->sole();
+    expect($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->channel->value)->toBe('totem')
+        ->and($ticket->status->value)->toBe('waiting');
+
+    $second = $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], bearer($token));
+
+    $second->assertStatus(201)->assertJson(['slug' => 'A002', 'priority' => ['value' => 0, 'label' => 'Normal']]);
+});
+
+it('rejects unknown priorities without creating a ticket', function (mixed $priority) {
+    ['entity' => $entity, 'queues' => [$queue], 'token' => $token] = pairedTotem(1);
+
+    $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => $priority], bearer($token))
+        ->assertStatus(422)
+        ->assertJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::query()->count())->toBe(0);
+})->with([
+    'unowned value' => 5,
+    'above range' => 30,
+    'negative' => -1,
+    'string' => 'ten',
+    'numeric string' => '5',
+    'missing' => null,
+]);
+
+it('rejects issuance into an inactive queue', function () {
+    ['entity' => $entity, 'queues' => [$queue], 'token' => $token] = pairedTotem(1);
+    $queue->update(['is_active' => false]);
+
+    $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], bearer($token))
+        ->assertStatus(422)
+        ->assertJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('answers 404 for an unknown queue slug on issuance', function () {
+    ['entity' => $entity, 'token' => $token] = pairedTotem(1);
+
+    $this->postJson("/api/{$entity->slug}/no-such-queue/ticket", ['priority' => 0], bearer($token))
+        ->assertStatus(404)
+        ->assertJson(['code' => 'queue_not_found']);
+});
+
+it('answers 403 for an out-of-scope queue on issuance', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $totem = Totem::factory()->for($entity)->create();
+    $token = app(TotemJwt::class)->issue($totem, $preset);
+
+    $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], bearer($token))
+        ->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('applies preset queue removals immediately for existing tokens', function () {
+    $entity = Entity::factory()->create();
+    $kept = Queue::factory()->for($entity)->create();
+    $removed = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach([$kept->id, $removed->id]);
+    $totem = Totem::factory()->for($entity)->create();
+    $token = app(TotemJwt::class)->issue($totem, $preset);
+
+    $preset->queues()->detach($removed);
+
+    $this->postJson("/api/{$entity->slug}/{$removed->slug}/ticket", ['priority' => 0], bearer($token))
+        ->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+
+    $this->getJson("/api/{$entity->slug}/{$removed->slug}/priorities", bearer($token))
+        ->assertStatus(403)
+        ->assertJson(['code' => 'forbidden']);
+
+    // The kept queue still works under the same token.
+    $this->postJson("/api/{$entity->slug}/{$kept->slug}/ticket", ['priority' => 0], bearer($token))
+        ->assertStatus(201);
+});
+
+it('rates limits totem issuance at thirty per minute', function () {
+    ['entity' => $entity, 'queues' => [$queue], 'token' => $token] = pairedTotem(1);
+
+    for ($i = 0; $i < 30; $i++) {
+        $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], bearer($token))
+            ->assertStatus(201);
+    }
+
+    $this->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0], bearer($token))
+        ->assertStatus(429)
+        ->assertJson(['code' => 'rate_limited']);
+});
