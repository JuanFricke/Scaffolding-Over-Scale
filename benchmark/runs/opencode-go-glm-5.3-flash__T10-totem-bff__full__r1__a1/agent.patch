@@ -0,0 +1,48 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Actions\OpenPairingWindow;
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+
+class TotemPairingCode extends Command
+{
+    /**
+     * The console command signature.
+     */
+    protected $signature = 'totem:pairing-code {preset : Totem preset id}';
+
+    /**
+     * The console command description.
+     */
+    protected $description = 'Open a pairing window for a totem preset and print its one-time login code';
+
+    /**
+     * Execute the console command.
+     */
+    public function handle(): int
+    {
+        /** @var mixed $argument */
+        $argument = $this->argument('preset');
+
+        $preset = is_numeric($argument) ? TotemPreset::find((int) $argument) : null;
+
+        if (! $preset instanceof TotemPreset) {
+            $this->error('No totem preset found for the given id.');
+
+            return self::FAILURE;
+        }
+
+        $preset = (new OpenPairingWindow)($preset);
+
+        $this->info(sprintf(
+            'Pairing code for "%s" (expires %s): %s',
+            $preset->name,
+            $preset->login_code_expires_at?->format('Y-m-d H:i'),
+            $preset->login_code,
+        ));
+
+        return self::SUCCESS;
+    }
+}
