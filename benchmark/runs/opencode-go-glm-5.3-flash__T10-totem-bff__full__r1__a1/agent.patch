@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use App\Http\Controllers\Controller;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+use Symfony\Component\HttpFoundation\Response;
+
+class AuthController extends Controller
+{
+    /**
+     * POST /api/totem/auth — exchange a one-time pairing code for a JWT
+     * (docs/api/totem.md). Format failures audit + 400; anything the pair
+     * action rejects renders the same 401 (no oracle). Rate limited
+     * 10/minute via the `totem-auth` limiter.
+     */
+    public function pair(Request $request): Response
+    {
+        /** @var string|null $code */
+        $code = $request->input('code');
+
+        if (! is_string($code) || preg_match('/^\d{6}$/', $code) !== 1) {
+            Log::channel('audit')->info('totem.pairing.rejected', [
+                'preset_id' => null,
+                'reason' => 'invalid_code_format',
+            ]);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        try {
+            $session = (new PairTotem)($code);
+        } catch (InvalidPairingCodeException) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        return response()->json([
+            'token' => $session->token,
+            'token_type' => 'Bearer',
+            'expires_in' => $session->expiresIn,
+            'entity' => ['slug' => $session->entity->slug, 'name' => $session->entity->name],
+        ]);
+    }
+}
