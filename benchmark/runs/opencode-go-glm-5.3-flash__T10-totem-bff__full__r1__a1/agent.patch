@@ -0,0 +1,258 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Event;
+
+uses(RefreshDatabase::class);
+
+/**
+ * A pairing-ready preset whose login code is known and unused.
+ */
+function pairingPreset(): TotemPreset
+{
+    return TotemPreset::factory()->create();
+}
+
+/**
+ * A six-digit code no stored preset owns.
+ */
+function unknownPairingCode(): string
+{
+    do {
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+    } while (TotemPreset::query()->where('login_code', $code)->exists());
+
+    return $code;
+}
+
+it('rejects a pairing code that is not exactly six digits', function (mixed $code) {
+    TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertJson(['code' => 'invalid_code_format']);
+})->with([
+    'empty string' => '',
+    'null' => null,
+    'too short' => '12345',
+    'too long' => '1234567',
+    'letters' => 'abcdef',
+    'mixed' => '12345a',
+    'integer' => 123456,
+]);
+
+it('rejects a pairing request without a code field', function () {
+    TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', [])
+        ->assertStatus(400)
+        ->assertJson(['code' => 'invalid_code_format']);
+});
+
+it('exchanges a valid pairing code for a token and a totem row', function () {
+    $preset = pairingPreset();
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk();
+
+    expect($response->json('token'))->toBeString()->not->toBeEmpty()
+        ->and($response->json('token_type'))->toBe('Bearer')
+        ->and($response->json('expires_in'))->toBe(3600)
+        ->and($response->json('entity.slug'))->toBe($preset->entity->slug)
+        ->and($response->json('entity.name'))->toBe($preset->entity->name);
+
+    $preset->refresh();
+    expect($preset->login_code_consumed_at)->not->toBeNull();
+
+    $totem = Totem::query()->sole();
+    expect($totem->entity_id)->toBe($preset->entity_id)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull();
+
+    $claims = app(TotemJwt::class)->decode($response->json('token'));
+
+    expect($claims)->not->toBeNull()
+        ->and($claims['totem_id'])->toBe($totem->id)
+        ->and($claims['entity_id'])->toBe($preset->entity_id)
+        ->and($claims['preset_id'])->toBe($preset->id);
+});
+
+it('carries the preset queue ids in the token scope claim', function () {
+    $preset = TotemPreset::factory()->create();
+    $inside = Queue::factory()->for($preset->entity)->create();
+    $outside = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($inside);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $claims = app(TotemJwt::class)->decode($response->json('token'));
+
+    expect($claims['queues'])->toBe([$inside->id])->not->toContain($outside->id);
+});
+
+it('answers the same 401 for unknown codes', function () {
+    TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => unknownPairingCode()])
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('answers the same 401 for expired codes', function () {
+    $preset = TotemPreset::factory()->create();
+    $preset->update(['login_code_expires_at' => now()->subMinute()]);
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('answers the same 401 for consumed codes', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertOk();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('answers the same 401 for inactive presets', function () {
+    $preset = TotemPreset::factory()->create(['is_active' => false]);
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertJson(['code' => 'invalid_pairing_code']);
+});
+
+it('keeps a code usable after rejected attempts', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(401);
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertOk();
+});
+
+it('rates limits pairing attempts at ten per minute', function () {
+    $preset = TotemPreset::factory()->create();
+
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])
+            ->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(429)
+        ->assertJson(['code' => 'rate_limited']);
+});
+
+it('audits pairing success without logging the full code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    Event::fake([MessageLogged::class]);
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertOk();
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($preset) {
+        $pairs = json_encode([$log->message, $log->context]);
+
+        return str_contains($pairs, 'totem.pairing.succeeded')
+            && ! str_contains($pairs, $preset->login_code);
+    });
+});
+
+it('audits pairing rejection without logging the full code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    Event::fake([MessageLogged::class]);
+
+    $this->postJson('/api/totem/auth', ['code' => '000000']);
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($preset) {
+        $pairs = json_encode([$log->message, $log->context]);
+
+        return str_contains($pairs, 'totem.pairing.rejected')
+            && ! str_contains($pairs, $preset->login_code);
+    });
+});
+
+it('opens a pairing window with a fresh six digit code', function () {
+    $preset = TotemPreset::factory()->create();
+    $old = $preset->login_code;
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+    $output = Artisan::output();
+
+    $preset->refresh();
+
+    expect($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code)->not->toBe($old)
+        ->and($preset->login_code_expires_at)
+        ->toBeGreaterThan(now())
+        ->toBeLessThanOrEqual(now()->addMinutes(10)->addSecond())
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($output)->toContain($preset->login_code);
+});
+
+it('prints a zero padded pairing code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+    Artisan::output();
+
+    $preset = $preset->refresh();
+
+    // The printed code equals the stored, zero-padded code.
+    expect($preset->login_code)->toHaveLength(6);
+});
+
+it('replaces a previous pairing code on regeneration', function () {
+    $preset = TotemPreset::factory()->create();
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+    $first = $preset->refresh()->login_code;
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+    $second = $preset->refresh()->login_code;
+
+    expect($second)->not->toBe($first)
+        ->and($preset->login_code_consumed_at)->toBeNull();
+});
+
+it('stops a consumed code by opening a new pairing window', function () {
+    $preset = TotemPreset::factory()->create();
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    $preset->refresh();
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertOk();
+});
+
+it('fails with an error message and exit code for an unknown preset', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 99999999])
+        ->assertFailed();
+});
+
+it('audits pairing code generation', function () {
+    $preset = TotemPreset::factory()->create();
+
+    Event::fake([MessageLogged::class]);
+
+    Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($preset) {
+        $pairs = json_encode([$log->message, $log->context]);
+
+        return str_contains($pairs, 'totem.pairing_code.generated')
+            && ! str_contains($pairs, $preset->login_code);
+    });
+});
diff --git a/tests/Unit/TotemJwtTest.php b/tests/Unit/TotemJwtTest.php
new file mode 100644
index 0000000..0691b62
--- /dev/null
+++ b/tests/Unit/TotemJwtTest.php
@@ -0,0 +1,63 @@
+<?php
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+uses(TestCase::class, RefreshDatabase::class);
+
+it('round trips totem claims through sign and verify', function () {
+    $totem = Totem::factory()->create();
+    $preset = TotemPreset::factory()->for($totem->entity)->create();
+    $totem->loadMissing('entity');
+    $preset->queues()->attach($totem->entity->queues()->create(['name' => 'G', 'slug' => 'g']));
+
+    $now = time();
+    Date::setTestNow(now()->setTimestamp($now));
+
+    $token = app(TotemJwt::class)->issue($totem, $preset);
+    $claims = app(TotemJwt::class)->decode($token);
+
+    expect($claims)->not->toBeNull()
+        ->and($claims['totem_id'])->toBe($totem->id)
+        ->and($claims['entity_id'])->toBe($totem->entity_id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['iat'])->toBe($now)
+        ->and($claims['exp'])->toBe($now + 3600)
+        ->and($claims['jti'])->toMatch('/^[0-9a-f]{32}$/');
+});
+
+it('rejects a token signed with a foreign secret', function () {
+    $totem = Totem::factory()->create();
+    $preset = TotemPreset::factory()->for($totem->entity)->create();
+
+    $claims = app(TotemJwt::class)->issue($totem, $preset);
+
+    config()->set('services.totem.jwt_secret', 'another-secret-with-at-least-32-characters!');
+
+    expect(app(TotemJwt::class)->decode($claims))->toBeNull();
+});
+
+it('rejects expired tokens', function () {
+    $totem = Totem::factory()->create();
+    $preset = TotemPreset::factory()->for($totem->entity)->create();
+
+    $expired = app(TotemJwt::class)->encode([
+        'totem_id' => $totem->id,
+        'entity_id' => $totem->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+        'iat' => time() - 7200,
+        'exp' => time() - 3600,
+        'jti' => bin2hex(random_bytes(16)),
+    ]);
+
+    expect(app(TotemJwt::class)->decode($expired))->toBeNull();
+});
+
+it('rejects garbage tokens', function () {
+    expect(app(TotemJwt::class)->decode(''))->toBeNull()
+        ->and(app(TotemJwt::class)->decode('a.b.c'))->toBeNull();
+});
