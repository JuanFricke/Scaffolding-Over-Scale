new file mode 100644
index 0000000..8e3d24e
--- /dev/null
+++ b/app/Services/TotemJwt.php
@@ -0,0 +1,92 @@
+<?php
+
+namespace App\Services;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use RuntimeException;
+use Throwable;
+
+/**
+ * HS256 token minting and verification for paired totems (docs/api/totem.md).
+ *
+ * Claims: totem_id, entity_id, preset_id, queues (pairing-time queue scope),
+ * iat, exp, jti. Secret and TTL come from `services.totem.*` (TOTEM_JWT_*).
+ */
+class TotemJwt
+{
+    private const ALG = 'HS256';
+
+    /**
+     * Sign the pairing token for a freshly paired totem. The `queues` claim
+     * records the preset's queue join at pairing time; the effective scope
+     * stays the intersection with the join (TotemAuth middleware).
+     */
+    public function issue(Totem $totem, TotemPreset $preset): string
+    {
+        $issuedAt = $this->now();
+
+        return $this->encode([
+            'totem_id' => (int) $totem->getKey(),
+            'entity_id' => (int) $totem->entity_id,
+            'preset_id' => (int) $preset->getKey(),
+            'queues' => $preset->queues()
+                ->pluck('queues.id')
+                ->map(fn (mixed $id): int => (int) $id)
+                ->all(),
+            'iat' => $issuedAt,
+            'exp' => $issuedAt + $this->ttl(),
+            'jti' => bin2hex(random_bytes(16)),
+        ]);
+    }
+
+    /**
+     * Encode a claims payload.
+     *
+     * @param  array<string, mixed>  $claims
+     */
+    public function encode(array $claims): string
+    {
+        return JWT::encode($claims, $this->secret(), self::ALG);
+    }
+
+    /**
+     * Verified claims, or null for any tampered/expired/malformed token.
+     *
+     * @return array<string, mixed>|null
+     */
+    public function decode(string $token): ?array
+    {
+        try {
+            return (array) JWT::decode($token, new Key($this->secret(), self::ALG));
+        } catch (Throwable) {
+            return null;
+        }
+    }
+
+    /**
+     * Token lifetime in seconds (services.totem.jwt_ttl).
+     */
+    public function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl', 3600);
+    }
+
+    private function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if ($secret === '') {
+            throw new RuntimeException('TOTEM_JWT_SECRET (services.totem.jwt_secret) is not configured.');
+        }
+
+        return $secret;
+    }
+
+    private function now(): int
+    {
+        return (int) now()->getTimestamp();
+    }
+}
