+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Testing\TestResponse;
+
+uses(RefreshDatabase::class);
+
+/**
+ * OPTIONS with the preflight markers for a given origin.
+ */
+function preflight(string $origin): TestResponse
+{
+    unset($preset);
+
+    return test()->options('/api/totem/auth', [], [
+        'Origin' => $origin,
+        'Access-Control-Request-Method' => 'POST',
+        'Access-Control-Request-Headers' => 'content-type',
+    ]);
+}
+
+it('serves a cors preflight for localhost origins', function (string $origin) {
+    $response = preflight($origin);
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe($origin)
+        ->and($response->headers->get('Access-Control-Allow-Credentials'))->toBeNull();
+})->with([
+    'http with port' => 'http://localhost:8081',
+    'http default port' => 'http://localhost',
+    'https default port' => 'https://localhost',
+    'loopback' => 'http://127.0.0.1:3000',
+]);
+
+it('answers actual totem requests with the allowed origin', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code], [
+        'Origin' => 'http://localhost:8123',
+    ]);
+
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8123');
+});
+
+it('withholds cors headers from unknown origins', function (string $origin) {
+    $response = preflight($origin);
+
+    $response->assertStatus(204);
+    expect($response->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+})->with([
+    'random https' => 'https://collector.example.com',
+    'localhost subdomain' => 'http://notlocalhost:8081',
+]);
+
+it('adds origins from the cors configuration (TOTEM_WEB_ORIGIN env)', function () {
+    $this->app['config']->set('cors.allowed_origins', [
+        'http://localhost:*',
+        'https://localhost:*',
+        'http://127.0.0.1:*',
+        'https://127.0.0.1:*',
+        'https://totem-web.example.com',
+    ]);
+
+    preflight('https://totem-web.example.com')
+        ->assertStatus(204)
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem-web.example.com');
+});
diff --git a/tests/Feature/TotemPairingTest.php b/tests/Feature/TotemPairingTest.php
