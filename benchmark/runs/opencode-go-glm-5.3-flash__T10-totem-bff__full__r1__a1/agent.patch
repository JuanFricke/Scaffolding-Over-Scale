+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned priority vocabulary for totem issuance.
+ *
+ * Single source for both `GET /api/{entity}/{queue}/priorities` and the
+ * `POST /api/{entity}/{queue}/ticket` validation (out of scope for now:
+ * per-entity custom priorities — see docs/api/totem.md). Higher value =
+ * more prioritized.
+ */
+enum TicketPriority: int
+{
+    case Normal = 0;
+    case High = 10;
+    case Eighty = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::High => 'Prioritário',
+            self::Eighty => 'Prioridade 80+',
+        };
+    }
+
+    /**
+     * Presentation-only default color (the totem may render without styles).
+     */
+    public function color(): string
+    {
+        return match ($this) {
+            self::Normal => '#2E7D32',
+            self::High => '#C62828',
+            self::Eighty => '#6A1B9A',
+        };
+    }
+
+    /**
+     * Presentation-only suggest icon name.
+     */
+    public function icon(): string
+    {
+        return match ($this) {
+            self::Normal => 'person',
+            self::High => 'priority',
+            self::Eighty => 'elderly',
+        };
+    }
+
+    /**
+     * All levels, in display order, shaped for the totem priorities endpoint.
+     *
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function levels(): array
+    {
+        return collect(self::cases())
+            ->values()
+            ->map(fn (self $priority, int $position): array => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+                'visual' => ['color' => $priority->color(), 'icon' => $priority->icon(), 'order' => $position + 1],
+            ])
+            ->all();
+    }
+}
