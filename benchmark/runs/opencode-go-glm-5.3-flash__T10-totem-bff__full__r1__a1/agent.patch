@@ -0,0 +1,88 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwt;
+use App\Support\TotemContext;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Totem API authentication (docs/api/totem.md).
+ *
+ * Validates the Bearer pairing JWT and the rows it refers to: token missing,
+ * malformed, tampered or expired; totem or preset missing/inactive; or any
+ * entity mismatch between claims, totem and preset → `401{"code":
+ * "invalid_token"}` with no oracle. On success it quietly refreshes
+ * `totems.last_seen_at`, computes the effective queue scope (JWT claim ∩ the
+ * preset's **current** queue join, so preset edits apply immediately) and
+ * attaches a `TotemContext` for downstream controllers.
+ */
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        $claims = $token === null ? null : app(TotemJwt::class)->decode($token);
+
+        if ($claims === null) {
+            return $this->reject();
+        }
+
+        /** @var int|string|null $totemId */
+        $totemId = $claims['totem_id'] ?? null;
+
+        /** @var int|string|null $presetId */
+        $presetId = $claims['preset_id'] ?? null;
+
+        $totem = is_scalar($totemId) ? Totem::query()->find($totemId) : null;
+        $preset = is_scalar($presetId) ? TotemPreset::query()->find($presetId) : null;
+
+        if (
+            ! $totem instanceof Totem
+            || ! $totem->is_active
+            || ! $preset instanceof TotemPreset
+            || ! $preset->is_active
+            || (int) ($claims['entity_id'] ?? 0) !== (int) $totem->entity_id
+            || (int) $totem->entity_id !== (int) $preset->entity_id
+        ) {
+            return $this->reject();
+        }
+
+        $context = new TotemContext(
+            totem: $totem,
+            preset: $preset,
+            entity: $totem->entity,
+            queueIds: self::effectiveScope($claims, $preset),
+        );
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $request->attributes->set(TotemContext::class, $context);
+
+        return $next($request);
+    }
+
+    /**
+     * @param  array<string, mixed>  $claims
+     * @return list<int>
+     */
+    private static function effectiveScope(array $claims, TotemPreset $preset): array
+    {
+        $claimed = array_map(intval(...), (array) ($claims['queues'] ?? []));
+
+        return array_values(array_intersect(
+            $claimed,
+            $preset->queues()->pluck('queues.id')->map(intval(...))->all(),
+        ));
+    }
+
+    private function reject(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
