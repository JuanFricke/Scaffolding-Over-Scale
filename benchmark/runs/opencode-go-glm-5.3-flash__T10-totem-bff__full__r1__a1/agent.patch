@@ -0,0 +1,148 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Queue;
+use App\Support\TotemContext;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Authenticated totem reads + issuance (docs/api/totem.md). The bearer JWT
+ * is validated by `totem.auth`; `{entity}` must equal the token's entity and
+ * `{queue}` resolves within that entity only.
+ */
+class TotemController extends Controller
+{
+    /**
+     * GET /api/{entity}/queues — active queues of the effective preset scope,
+     * ordered by name with 1-based display position.
+     */
+    public function queues(Request $request, string $entity): Response
+    {
+        $context = $this->context($request);
+        $e = $context->entity;
+
+        if ($e->slug !== $entity) {
+            return $this->forbidden();
+        }
+
+        $queues = Queue::query()
+            ->whereIn('id', $context->queueIds)
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get();
+
+        return response()->json([
+            'entity' => ['slug' => $e->slug, 'name' => $e->name],
+            'queues' => $queues->values()->map(fn (Queue $queue, int $position): array => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => null,
+                'visual' => ['color' => null, 'icon' => null, 'order' => $position + 1],
+                'is_active' => true,
+            ])->all(),
+        ]);
+    }
+
+    /**
+     * GET /api/{entity}/{queue}/priorities — backend-owned priority levels.
+     */
+    public function priorities(Request $request, string $entity, string $queue): Response
+    {
+        $context = $this->context($request);
+
+        $queue = $this->authorizeQueue($context, $entity, $queue);
+
+        if ($queue instanceof Response) {
+            return $queue;
+        }
+
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $context->entity->slug],
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priorities' => TicketPriority::levels(),
+        ]);
+    }
+
+    /**
+     * POST /api/{entity}/{queue}/ticket — issue via the domain action
+     * (channel `totem`); priority must be a backend-owned value.
+     */
+    public function ticket(Request $request, string $entity, string $queue): Response
+    {
+        $context = $this->context($request);
+
+        $queue = $this->authorizeQueue($context, $entity, $queue);
+
+        if ($queue instanceof Response) {
+            return $queue;
+        }
+
+        /** @var mixed $input */
+        $input = $request->input('priority');
+        $priority = is_int($input) ? TicketPriority::tryFrom($input) : null;
+
+        if (! $priority instanceof TicketPriority) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = (new IssueTicket)($queue, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priority' => ['value' => $priority->value, 'label' => $priority->label()],
+            'issued_at' => $ticket->issued_at?->toISOString(),
+        ], 201);
+    }
+
+    private function context(Request $request): TotemContext
+    {
+        return $request->attributes->get(TotemContext::class);
+    }
+
+    /**
+     * Resolve `{queue}` within the token's entity and scope. Returns either
+     * the queue or an error response to forward.
+     */
+    private function authorizeQueue(TotemContext $context, string $entity, string $queue): Queue|Response
+    {
+        if ($context->entity->slug !== $entity) {
+            return $this->forbidden();
+        }
+
+        $queue = Queue::query()
+            ->where('entity_id', $context->entity->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $queue instanceof Queue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! $context->allowsQueue($queue)) {
+            return $this->forbidden();
+        }
+
+        return $queue;
+    }
+
+    private function forbidden(): Response
+    {
+        return response()->json(['code' => 'forbidden'], 403);
+    }
+}
