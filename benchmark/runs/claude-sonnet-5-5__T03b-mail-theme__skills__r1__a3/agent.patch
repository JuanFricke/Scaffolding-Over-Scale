+++ b/tests/Feature/EmailVerificationTest.php
@@ -0,0 +1,65 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user, ?string $hash = null, ?int $id = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $id ?? $user->id,
+        'hash' => $hash ?? sha1($user->email),
+    ]);
+}
+
+test('the verification notification links to the verification.verify route', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = (new VerifyEmail)->toMail($user)->actionUrl;
+
+    expect($url)->toContain('/email/verify/'.$user->id.'/'.sha1($user->email))
+        ->and($url)->toContain('signature=');
+});
+
+test('a logged-in user verifies their email with a valid signed link', function () {
+    Event::fake([Verified::class]);
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($user))->assertRedirect('/');
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+    Event::assertDispatched(Verified::class);
+});
+
+test('a wrong hash is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($user, sha1('other@example.com')))->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link for another user id is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($other))->assertForbidden();
+
+    expect($other->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get('/email/verify/'.$user->id.'/'.sha1($user->email))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
diff --git a/tests/Feature/PasswordResetTest.php b/tests/Feature/PasswordResetTest.php
new file mode 100644
index 0000000..28c3b32
--- /dev/null
+++ b/tests/Feature/PasswordResetTest.php
@@ -0,0 +1,132 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password form renders', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('type="email"', false)
+        ->assertSee('for="email"', false);
+});
+
+test('a reset link is sent to an existing user', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown address gets the same response and no notification', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('the reset link request validates the email', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+    $this->post(route('password.email'), [])
+        ->assertSessionHasErrors('email');
+});
+
+test('the reset link request is throttled', function () {
+    foreach (range(1, 6) as $i) {
+        $this->post(route('password.email'), ['email' => 'ghost@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])->assertStatus(429);
+});
+
+test('authenticated users cannot use the password reset routes', function () {
+    $this->actingAs(User::factory()->create());
+
+    $this->get(route('password.request'))->assertRedirect();
+    $this->post(route('password.email'), ['email' => 'a@example.com'])->assertRedirect();
+});
+
+test('the reset form renders with the token and a single email input', function () {
+    $response = $this->get(route('password.reset', ['token' => 'abc123', 'email' => 'a@example.com']))
+        ->assertOk()
+        ->assertSee('value="abc123"', false)
+        ->assertSee('value="a@example.com"', false);
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+function resetPayload(User $user, array $overrides = []): array
+{
+    return array_merge([
+        'token' => Password::createToken($user),
+        'email' => $user->email,
+        'password' => 'NewPassw0rd',
+        'password_confirmation' => 'NewPassw0rd',
+    ], $overrides);
+}
+
+test('a valid token resets the password', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create();
+    $oldRemember = $user->remember_token;
+
+    $this->post(route('password.update'), resetPayload($user))
+        ->assertRedirect('/')
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NewPassw0rd', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe($oldRemember);
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token does not reset the password', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create();
+    $oldHash = $user->password;
+
+    $this->post(route('password.update'), resetPayload($user, ['token' => 'wrong']))
+        ->assertSessionHasErrors('email');
+
+    expect($user->fresh()->password)->toBe($oldHash);
+    Event::assertNotDispatched(PasswordReset::class);
+});
+
+test('a weak or unconfirmed password is rejected', function (string $password, ?string $confirmation) {
+    $user = User::factory()->create();
+    $oldHash = $user->password;
+
+    $this->post(route('password.update'), resetPayload($user, [
+        'password' => $password,
+        'password_confirmation' => $confirmation,
+    ]))->assertSessionHasErrors('password');
+
+    expect($user->fresh()->password)->toBe($oldHash);
+})->with([
+    'too short' => ['Ab1', 'Ab1'],
+    'no numbers' => ['Abcdefghij', 'Abcdefghij'],
+    'no letters' => ['1234567890', '1234567890'],
+    'no mixed case' => ['abcdefg123', 'abcdefg123'],
+    'not confirmed' => ['NewPassw0rd', 'Different1Pass'],
+]);
+
+test('the reset update validates the token and email', function () {
+    $this->post(route('password.update'), ['password' => 'NewPassw0rd', 'password_confirmation' => 'NewPassw0rd'])
+        ->assertSessionHasErrors(['token', 'email']);
+});
