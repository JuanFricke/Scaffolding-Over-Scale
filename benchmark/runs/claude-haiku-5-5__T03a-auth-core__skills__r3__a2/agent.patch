diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..19938e0
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,130 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function signedVerificationUrl(User $user): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('the verification notice is shown to unverified users', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee(__('ui.verify.resend'));
+});
+
+test('guests are sent to login from the verification notice', function () {
+    $this->get(route('verification.notice'))->assertRedirect(route('login'));
+});
+
+test('verified users are sent home from the verification notice', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('home'));
+});
+
+test('a signed link verifies the logged-in user and redirects home', function () {
+    Event::fake([Verified::class]);
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user))
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+    Event::assertDispatched(Verified::class);
+});
+
+test('a verification link with a tampered id is forbidden and verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $tampered = preg_replace(
+        '#/email/verify/\d+/#',
+        '/email/verify/'.$other->getKey().'/',
+        signedVerificationUrl($user),
+        1,
+    );
+
+    $this->actingAs($user)->get($tampered)->assertForbidden();
+    $this->actingAs($other)->get($tampered)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a valid link for another user cannot verify the logged-in user', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($other)
+        ->get(signedVerificationUrl($user))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned verification link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('the verification link requires a logged-in user', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->get(signedVerificationUrl($user))->assertRedirect(route('login'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('resending sends the verification mail and flashes the status', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect()
+        ->assertSessionHas('status', 'verification-link-sent');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('resending for an already verified user sends nothing and redirects home', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('resending verification mail is throttled', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->actingAs($user)->post(route('verification.send'))->assertRedirect();
+    }
+
+    $this->actingAs($user)->post(route('verification.send'))->assertStatus(429);
+});
diff --git a/tests/Feature/Auth/LoginTest.php b/tests/Feature/Auth/LoginTest.php
new file mode 100644
index 0000000..a323c0a
--- /dev/null
+++ b/tests/Feature/Auth/LoginTest.php
@@ -0,0 +1,181 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('login page renders in portuguese by default', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('login page renders in english without portuguese text for the en locale', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu');
+});
+
+test('authenticated users visiting login are redirected home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('a valid login signs the user in and redirects home', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com', 'password' => 'Secret123']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('a successful login regenerates the session id', function () {
+    User::factory()->create(['email' => 'ana@example.com', 'password' => 'Secret123']);
+
+    $this->startSession();
+    $before = session()->getId();
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->call('submit');
+
+    expect(session()->getId())->not->toBe($before);
+});
+
+test('remember me issues a remember token for the session', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com', 'password' => 'Secret123', 'remember_token' => null]);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->remember_token)->not->toBeNull();
+});
+
+test('a login without remember me issues no remember token', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com', 'password' => 'Secret123', 'remember_token' => null]);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->remember_token)->toBeNull();
+});
+
+test('wrong credentials show the auth.failed message on email', function () {
+    User::factory()->create(['email' => 'ana@example.com', 'password' => 'Secret123']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee(__('auth.failed'))
+        ->assertSet('password', '');
+
+    $this->assertGuest();
+});
+
+test('a malformed email fails strict validation on email', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+
+    $this->assertGuest();
+});
+
+test('an injection-style email is rejected before any credential check', function () {
+    Livewire::test(Login::class)
+        ->set('email', "admin'--@example.com")
+        ->set('password', 'x')
+        ->call('submit')
+        ->assertHasErrors(['email']);
+
+    $this->assertGuest();
+});
+
+test('five failed attempts lock the email and IP even with the right password', function () {
+    Carbon::setTestNow(now());
+    User::factory()->create(['email' => 'ana@example.com', 'password' => 'Secret123']);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        Livewire::test(Login::class)
+            ->set('email', 'ana@example.com')
+            ->set('password', 'wrong-password')
+            ->call('submit');
+    }
+
+    $key = str()->transliterate('ana@example.com|127.0.0.1');
+    $seconds = RateLimiter::availableIn($key);
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee(__('auth.throttle', ['seconds' => $seconds]));
+
+    $this->assertGuest();
+
+    Carbon::setTestNow();
+});
+
+test('the throttle key is the lowercase email so casing does not dodge the lock', function () {
+    User::factory()->create(['email' => 'ana@example.com', 'password' => 'Secret123']);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        Livewire::test(Login::class)
+            ->set('email', 'ANA@example.com')
+            ->set('password', 'wrong-password')
+            ->call('submit');
+    }
+
+    Livewire::test(Login::class)
+        ->set('email', 'ana@example.com')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['email']);
+
+    $this->assertGuest();
+});
+
+test('an authenticated user cannot use the guest login action to switch accounts', function () {
+    $current = User::factory()->create(['email' => 'current@example.com']);
+    User::factory()->create(['email' => 'other@example.com', 'password' => 'Secret123']);
+
+    $this->actingAs($current);
+
+    Livewire::test(Login::class)
+        ->set('email', 'other@example.com')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($current);
+});
diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..bdc82ad
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,110 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password form asks for the email once', function () {
+    $response = $this->get(route('password.request'))->assertOk();
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('a reset link is sent to an existing user', function () {
+    Notification::fake();
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    $this->post(route('password.email'), ['email' => 'ana@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown email gets the same status and nothing is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('a malformed email is rejected on the forgot password form', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+});
+
+test('forgot password requests are throttled to six per minute', function () {
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertStatus(429);
+});
+
+test('the reset form asks for the email exactly once', function () {
+    $response = $this->get(route('password.reset', ['token' => 'some-token', 'email' => 'ana@example.com']))
+        ->assertOk();
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('a valid token resets the password, rotates the remember token and redirects to login', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['email' => 'ana@example.com', 'password' => 'OldPass123']);
+    $oldRememberToken = $user->remember_token;
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => 'ana@example.com',
+        'password' => 'NewPass123',
+        'password_confirmation' => 'NewPass123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewPass123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe($oldRememberToken);
+
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token is reported on email and changes nothing', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com', 'password' => 'OldPass123']);
+
+    $this->post(route('password.update'), [
+        'token' => 'forged-token',
+        'email' => 'ana@example.com',
+        'password' => 'NewPass123',
+        'password_confirmation' => 'NewPass123',
+    ])
+        ->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect(Hash::check('OldPass123', $user->fresh()->password))->toBeTrue();
+});
+
+test('a weak new password fails the default password rule', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => 'ana@example.com',
+        'password' => 'weakpass',
+        'password_confirmation' => 'weakpass',
+    ])
+        ->assertSessionHasErrors('password');
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..9739b84
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,155 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rules\Password;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function registerForm(array $overrides = []): array
+{
+    return array_merge([
+        'name' => 'Ana Souza',
+        'email' => 'ana@example.com',
+        'password' => 'Secret123',
+        'password_confirmation' => 'Secret123',
+    ], $overrides);
+}
+
+function fillRegisterForm($test, array $data)
+{
+    foreach ($data as $field => $value) {
+        $test->set($field, $value);
+    }
+
+    return $test;
+}
+
+test('register page renders in portuguese by default', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSee('Criar conta')
+        ->assertSee('Confirmar senha');
+});
+
+test('a valid registration creates an unverified user, signs them in and sends the verification mail', function () {
+    Notification::fake();
+
+    fillRegisterForm(Livewire::test(Register::class), registerForm())
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'ana@example.com')->firstOrFail();
+
+    expect($user->name)->toBe('Ana Souza')
+        ->and($user->email_verified_at)->toBeNull()
+        ->and(Hash::check('Secret123', $user->password))->toBeTrue();
+
+    $this->assertAuthenticatedAs($user);
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('a registration regenerates the session id', function () {
+    $this->startSession();
+    $before = session()->getId();
+
+    fillRegisterForm(Livewire::test(Register::class), registerForm())->call('submit');
+
+    expect(session()->getId())->not->toBe($before);
+});
+
+test('weak passwords fail the app-wide default rule', function (string $password) {
+    fillRegisterForm(Livewire::test(Register::class), registerForm([
+        'password' => $password,
+        'password_confirmation' => $password,
+    ]))
+        ->call('submit')
+        ->assertHasErrors(['password']);
+
+    $this->assertDatabaseMissing('users', ['email' => 'ana@example.com']);
+})->with([
+    'too short' => 'Aa1',
+    'no numbers' => 'Abcdefgh',
+    'no uppercase' => 'abcdefg1',
+    'no lowercase' => 'ABCDEFG1',
+]);
+
+test('a mismatched password confirmation fails the confirmed rule on password', function () {
+    fillRegisterForm(Livewire::test(Register::class), registerForm([
+        'password_confirmation' => 'Different123',
+    ]))
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    $this->assertDatabaseMissing('users', ['email' => 'ana@example.com']);
+});
+
+test('a duplicate email fails the unique rule on email', function () {
+    User::factory()->create(['email' => 'ana@example.com']);
+
+    fillRegisterForm(Livewire::test(Register::class), registerForm())
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+
+    expect(User::where('email', 'ana@example.com')->count())->toBe(1);
+});
+
+test('an uppercase email is rejected so stored addresses stay lowercase', function () {
+    fillRegisterForm(Livewire::test(Register::class), registerForm(['email' => 'ANA@example.com']))
+        ->call('submit')
+        ->assertHasErrors(['email' => 'lowercase']);
+
+    $this->assertDatabaseMissing('users', ['email' => 'ANA@example.com']);
+});
+
+test('registration is limited to five attempts per IP and reports the lock on email', function () {
+    Carbon::setTestNow(now());
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        Livewire::test(Register::class)->set('name', '')->call('submit');
+    }
+
+    $key = str()->transliterate('register|127.0.0.1');
+    $seconds = RateLimiter::availableIn($key);
+
+    fillRegisterForm(Livewire::test(Register::class), registerForm())
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee(__('auth.throttle', ['seconds' => $seconds]));
+
+    $this->assertDatabaseMissing('users', ['email' => 'ana@example.com']);
+    $this->assertGuest();
+
+    Carbon::setTestNow();
+});
+
+test('an authenticated user cannot use the guest registration action', function () {
+    $current = User::factory()->create();
+
+    $this->actingAs($current);
+
+    fillRegisterForm(Livewire::test(Register::class), registerForm())
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    $this->assertDatabaseMissing('users', ['email' => 'ana@example.com']);
+    $this->assertAuthenticatedAs($current);
+});
+
+test('the app-wide password default requires eight characters with letters, mixed case and numbers', function () {
+    $rule = ['password' => Password::defaults()];
+
+    expect(Validator::make(['password' => 'Secret123'], $rule)->passes())->toBeTrue()
+        ->and(Validator::make(['password' => 'Secret1'], $rule)->fails())->toBeTrue()
+        ->and(Validator::make(['password' => 'secret123'], $rule)->fails())->toBeTrue()
+        ->and(Validator::make(['password' => 'Secretabc'], $rule)->fails())->toBeTrue();
+});
diff --git a/tests/Feature/Auth/SessionPagesTest.php b/tests/Feature/Auth/SessionPagesTest.php
new file mode 100644
index 0000000..1f7c069
--- /dev/null
+++ b/tests/Feature/Auth/SessionPagesTest.php
@@ -0,0 +1,56 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('guests are sent to login from home', function () {
+    $this->get(route('home'))->assertRedirect(route('login'));
+});
+
+test('unverified users are sent to the verification notice from home', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('home'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('verified users see home with their name', function () {
+    $user = User::factory()->create(['name' => 'Ana Souza']);
+
+    $this->actingAs($user)
+        ->get(route('home'))
+        ->assertOk()
+        ->assertSee('Ana Souza')
+        ->assertSee(__('ui.logout'));
+});
+
+test('logout ends the session and redirects to login', function () {
+    $this->actingAs(User::factory()->create())
+        ->post(route('logout'))
+        ->assertRedirect(route('login'));
+
+    $this->assertGuest();
+});
+
+test('logout requires authentication', function () {
+    $this->post(route('logout'))->assertRedirect(route('login'));
+
+    $this->assertGuest();
+});
+
+test('logout only accepts POST', function () {
+    $this->actingAs(User::factory()->create())
+        ->get('/logout')
+        ->assertMethodNotAllowed();
+});
+
+test('logout regenerates the csrf token', function () {
+    $this->startSession();
+    $this->actingAs(User::factory()->create());
+    session()->put('_token', 'old-token');
+
+    $this->post(route('logout'));
+
+    expect(session()->token())->not->toBe('old-token');
+});
