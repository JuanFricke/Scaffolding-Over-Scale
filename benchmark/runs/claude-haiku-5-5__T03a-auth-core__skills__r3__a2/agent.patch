--- /dev/null
+++ b/app/Livewire/Auth/Register.php
@@ -0,0 +1,79 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Validation\Rules\Password;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('components.layouts.app')]
+class Register extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    #[Validate('required|string|lowercase|email:rfc,strict|max:255|unique:users,email')]
+    public string $email = '';
+
+    public string $password = '';
+
+    public string $password_confirmation = '';
+
+    private const MAX_ATTEMPTS = 5;
+
+    public function render()
+    {
+        return view('livewire.auth.register')->title(__('ui.register.title'));
+    }
+
+    /**
+     * @return array<string, array<int, mixed>>
+     */
+    protected function rules(): array
+    {
+        return [
+            'password' => ['required', 'string', 'confirmed', Password::defaults()],
+        ];
+    }
+
+    /**
+     * Create an unverified account and sign it in. Guest-only, rate-limited per IP.
+     */
+    public function submit(): void
+    {
+        if (Auth::check()) {
+            $this->redirectRoute('home');
+
+            return;
+        }
+
+        $throttleKey = str()->transliterate('register|'.request()->ip());
+
+        if (RateLimiter::tooManyAttempts($throttleKey, self::MAX_ATTEMPTS)) {
+            $this->addError('email', __('auth.throttle', ['seconds' => RateLimiter::availableIn($throttleKey)]));
+
+            return;
+        }
+
+        RateLimiter::hit($throttleKey);
+
+        $this->validate();
+
+        $user = User::create([
+            'name' => $this->name,
+            'email' => $this->email,
+            'password' => $this->password,
+        ]);
+
+        event(new Registered($user));
+        Auth::login($user);
+        session()->regenerate();
+
+        $this->redirectRoute('home');
+    }
+}
