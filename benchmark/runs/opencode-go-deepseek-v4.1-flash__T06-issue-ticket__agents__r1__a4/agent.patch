+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has required columns and a slug unique per entity', function () {
+    $this->assertTrue(Schema::hasTable('queues'));
+
+    $this->assertTrue(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n',
+        'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('queues', 'queues_entity_id_slug_unique'));
+
+    $entity = DB::table('entities')->insertGetId(['name' => 'E', 'slug' => 'e']);
+    $id = DB::table('queues')->insertGetId([
+        'entity_id' => $entity,
+        'name' => 'Queue',
+        'slug' => 'queue',
+    ]);
+
+    $queue = DB::table('queues')->where('id', $id)->first();
+    expect((bool) $queue->is_active)->toBeTrue()
+        ->and($queue->labels_i18n)->toBeNull();
+});
+
+test('tickets table has required columns, unique code per queue and ordering index', function () {
+    $this->assertTrue(Schema::hasTable('tickets'));
+
+    $this->assertTrue(Schema::hasColumns('tickets', [
+        'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+        'issued_at', 'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_id_code_unique'));
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_id_status_priority_issued_at_index'));
+
+    $entity = DB::table('entities')->insertGetId(['name' => 'E', 'slug' => 'e']);
+    $queue = DB::table('queues')->insertGetId([
+        'entity_id' => $entity,
+        'name' => 'Queue',
+        'slug' => 'queue',
+    ]);
+
+    $id = DB::table('tickets')->insertGetId([
+        'queue_id' => $queue,
+        'code' => 'A001',
+        'issued_at' => now(),
+    ]);
+
+    $ticket = DB::table('tickets')->where('id', $id)->first();
+    expect($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe('virtual')
+        ->and($ticket->status)->toBe('waiting')
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('deleting a queue cascades its tickets and deleting an entity cascades its queues', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $otherQueue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $otherTicket = Ticket::factory()->forQueue($otherQueue)->create();
+
+    $queue->delete();
+
+    expect(Ticket::find($ticket->id))->toBeNull()
+        ->and(Ticket::find($otherTicket->id))->not->toBeNull();
+
+    $entity->forceDelete();
+
+    expect(Queue::find($otherQueue->id))->toBeNull()
+        ->and(Ticket::find($otherTicket->id))->toBeNull();
+});
