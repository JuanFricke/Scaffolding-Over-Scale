@@ -0,0 +1,84 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('ticket factory allocates sequential codes through forQueue', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002');
+});
+
+test('ticket factory keeps an explicitly provided code', function () {
+    $queue = Queue::factory()->create();
+
+    $legacy = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+    $next = Ticket::factory()->forQueue($queue)->create();
+
+    expect($legacy->code)->toBe('A-X')
+        ->and($next->code)->toBe('A001');
+});
+
+test('next code starts at A001 and ignores malformed legacy codes', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'not-a-code']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+});
+
+test('next code follows insertion order, not string order', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('next code keeps growing beyond three digits', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1000');
+});
+
+test('deleting a ticket does not shift or reuse the following numbers', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(); // A001
+    $second = Ticket::factory()->forQueue($queue)->create(); // A002
+    Ticket::factory()->forQueue($queue)->create(); // A003
+
+    $second->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('next code is scoped to a single queue', function () {
+    $firstQueue = Queue::factory()->create();
+    $secondQueue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($firstQueue)->create();
+
+    expect(Ticket::nextCode($secondQueue->id))->toBe('A001')
+        ->and(Ticket::nextCode($firstQueue->id))->toBe('A002');
+});
diff --git a/tests/Feature/Queue/TicketSchemaTest.php b/tests/Feature/Queue/TicketSchemaTest.php
