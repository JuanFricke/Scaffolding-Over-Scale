@@ -0,0 +1,148 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Database\Factories\TicketFactory;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+#[Fillable([
+    'queue_id',
+    'code',
+    'priority',
+    'channel',
+    'status',
+    'issued_at',
+    'called_at',
+    'called_by_user_id',
+])]
+class Ticket extends Model
+{
+    /** @use HasFactory<TicketFactory> */
+    use HasFactory;
+
+    /**
+     * Fields that may still change after the ticket has been issued.
+     *
+     * @var list<string>
+     */
+    private const MUTABLE_AFTER_ISSUANCE = [
+        'status',
+        'called_at',
+        'called_by_user_id',
+        'updated_at',
+    ];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        // Tickets are write-once: after issuance only the call fields (and
+        // timestamp) may change. Direct query-builder updates bypass Eloquent
+        // on purpose; every model save/update is guarded here.
+        static::updating(function (self $ticket): void {
+            $forbidden = array_diff(
+                array_keys($ticket->getDirty()),
+                self::MUTABLE_AFTER_ISSUANCE,
+            );
+
+            if ($forbidden !== []) {
+                throw new LogicException(
+                    'Issued tickets are immutable; cannot change: '.implode(', ', $forbidden).'.',
+                );
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next per-queue display code: A001, A002, ... A999, A1000, ...
+     *
+     * The last valid code is found by insertion order (id), never by string
+     * ordering, and malformed legacy codes are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $lastNumber = 0;
+
+        $codes = static::query()
+            ->where('queue_id', $queueId)
+            ->orderByDesc('id')
+            ->pluck('code');
+
+        foreach ($codes as $code) {
+            if (preg_match('/^A(\d+)$/', (string) $code, $matches) === 1) {
+                $lastNumber = (int) $matches[1];
+                break;
+            }
+        }
+
+        return 'A'.str_pad((string) ($lastNumber + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call this waiting ticket exactly once, recording the calling user.
+     *
+     * @throws AuthorizationException when the user is not a member of the ticket's entity
+     * @throws LogicException when the ticket has already been called
+     */
+    public function call(User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Only waiting tickets can be called.');
+        }
+
+        DB::transaction(function () use ($user): void {
+            /** @var self $ticket */
+            $ticket = static::query()->lockForUpdate()->findOrFail($this->getKey());
+
+            if ($ticket->status !== TicketStatus::Waiting) {
+                throw new LogicException('Only waiting tickets can be called.');
+            }
+
+            $entityId = (int) $ticket->queue()->value('entity_id');
+
+            if ($user->membershipFor($entityId) === null) {
+                throw new AuthorizationException('Only members of the ticket entity may call this ticket.');
+            }
+
+            $ticket->fill([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+            ])->save();
+
+            $this->setRawAttributes($ticket->getAttributes(), true);
+        });
+    }
+}
