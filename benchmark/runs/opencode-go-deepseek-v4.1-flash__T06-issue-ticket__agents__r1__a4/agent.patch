+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('queue factory creates an entity, a unique slug and an active queue', function () {
+    $first = Queue::factory()->create();
+    $second = Queue::factory()->create();
+
+    expect($first->entity)->toBeInstanceOf(Entity::class)
+        ->and($first->slug)->not->toBeEmpty()
+        ->and($first->slug)->not->toBe($second->slug)
+        ->and($first->is_active)->toBeTrue();
+});
+
+test('queue casts labels_i18n to an array and exposes its relations', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create([
+        'name' => 'Retirada',
+        'slug' => 'retirada',
+        'labels_i18n' => ['pt_BR' => 'Retirada', 'en' => 'Pickup'],
+    ]);
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    expect($queue->fresh()->labels_i18n)->toBe(['pt_BR' => 'Retirada', 'en' => 'Pickup'])
+        ->and($queue->entity->is($entity))->toBeTrue()
+        ->and($queue->tickets()->count())->toBe(1)
+        ->and($queue->tickets->first()->is($ticket))->toBeTrue()
+        ->and($entity->queues()->count())->toBe(1)
+        ->and($entity->queues->first()->is($queue))->toBeTrue()
+        ->and($ticket->queue->is($queue))->toBeTrue();
+});
+
+test('inactive queue state is cast to a boolean', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    expect($queue->is_active)->toBeFalse()
+        ->and($queue->fresh()->is_active)->toBeFalse();
+});
+
+test('queue slug is unique within an entity but reusable across entities', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->create(['slug' => 'same']);
+
+    expect(fn () => Queue::factory()->for($entity)->create(['slug' => 'same']))
+        ->toThrow(QueryException::class);
+
+    $other = Queue::factory()->for(Entity::factory())->create(['slug' => 'same']);
+
+    expect($other->slug)->toBe('same');
+});
+
+test('ticket factory defaults to a waiting virtual ticket with priority zero and issued now', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->queue)->toBeInstanceOf(Queue::class)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull()
+        ->and($ticket->code)->toMatch('/^A\d{3,}$/');
+});
+
+test('ticket enum values match the domain contract', function () {
+    expect(TicketStatus::Waiting->value)->toBe('waiting')
+        ->and(TicketStatus::Called->value)->toBe('called')
+        ->and(TicketChannel::Totem->value)->toBe('totem')
+        ->and(TicketChannel::Virtual->value)->toBe('virtual')
+        ->and(TicketChannel::Printed->value)->toBe('printed');
+});
diff --git a/tests/Feature/Queue/TicketCallTest.php b/tests/Feature/Queue/TicketCallTest.php
new file mode 100644
index 0000000..b28f596
--- /dev/null
+++ b/tests/Feature/Queue/TicketCallTest.php
@@ -0,0 +1,159 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function pegafilaQueueWaitingTicketForCallTest(User $member): Ticket
+{
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($member)->employee()->create();
+
+    return Ticket::factory()->forQueue(Queue::factory()->for($entity)->create())->create();
+}
+
+test('a member calls a waiting ticket exactly once and the call is recorded', function () {
+    $member = User::factory()->create();
+    $ticket = pegafilaQueueWaitingTicketForCallTest($member);
+
+    $ticket->call($member);
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->status)->toBe(TicketStatus::Called)
+        ->and($fresh->called_at)->not->toBeNull()
+        ->and($fresh->called_by_user_id)->toBe($member->id)
+        ->and($fresh->calledBy->is($member))->toBeTrue()
+        ->and($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_by_user_id)->toBe($member->id);
+});
+
+test('any role that is a member of the entity may call', function (string $role) {
+    $member = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($member)->state(['role' => $role])->create();
+    $ticket = Ticket::factory()->forQueue(Queue::factory()->for($entity)->create())->create();
+
+    $ticket->call($member);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->fresh()->called_by_user_id)->toBe($member->id);
+})->with(['owner', 'admin', 'employee']);
+
+test('a non-member cannot call and the ticket stays unchanged', function () {
+    $member = User::factory()->create();
+    $stranger = User::factory()->create();
+    $ticket = pegafilaQueueWaitingTicketForCallTest($member);
+    $originalUpdatedAt = $ticket->updated_at;
+
+    expect(fn () => $ticket->call($stranger))
+        ->toThrow(AuthorizationException::class);
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->status)->toBe(TicketStatus::Waiting)
+        ->and($fresh->called_at)->toBeNull()
+        ->and($fresh->called_by_user_id)->toBeNull()
+        ->and($fresh->updated_at->equalTo($originalUpdatedAt))->toBeTrue();
+});
+
+test('a member of another entity cannot call', function () {
+    $member = User::factory()->create();
+    $outsider = User::factory()->create();
+    EntityMembership::factory()->for(Entity::factory())->for($outsider)->owner()->create();
+    $ticket = pegafilaQueueWaitingTicketForCallTest($member);
+
+    expect(fn () => $ticket->call($outsider))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a ticket that is not waiting cannot be called', function () {
+    $member = User::factory()->create();
+    $ticket = pegafilaQueueWaitingTicketForCallTest($member);
+
+    $ticket->update([
+        'status' => TicketStatus::Called,
+        'called_at' => now(),
+        'called_by_user_id' => $member->id,
+    ]);
+
+    expect(fn () => $ticket->call($member))
+        ->toThrow(LogicException::class);
+});
+
+test('calling twice throws and does not change the first call', function () {
+    $firstAttendant = User::factory()->create();
+    $secondAttendant = User::factory()->create();
+    $ticket = pegafilaQueueWaitingTicketForCallTest($firstAttendant);
+    EntityMembership::factory()->for($ticket->queue->entity)->for($secondAttendant)->employee()->create();
+
+    $ticket->call($firstAttendant);
+    $calledAt = $ticket->fresh()->called_at;
+
+    expect(fn () => $ticket->call($secondAttendant))
+        ->toThrow(LogicException::class);
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->called_by_user_id)->toBe($firstAttendant->id)
+        ->and($fresh->called_at->equalTo($calledAt))->toBeTrue();
+});
+
+test('issued ticket fields are immutable through save and update', function () {
+    $ticket = Ticket::factory()->create();
+    $otherQueue = Queue::factory()->create();
+
+    $forbidden = [
+        ['code' => 'A999'],
+        ['priority' => 10],
+        ['channel' => TicketChannel::Totem->value],
+        ['queue_id' => $otherQueue->id],
+        ['issued_at' => now()->subDay()],
+    ];
+
+    foreach ($forbidden as $attributes) {
+        expect(fn () => $ticket->fresh()->update($attributes))
+            ->toThrow(LogicException::class);
+    }
+
+    $ticket->refresh();
+    $ticket->priority = 99;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->code)->not->toBe('A999')
+        ->and($fresh->priority)->toBe(0)
+        ->and($fresh->channel)->toBe(TicketChannel::Virtual)
+        ->and($fresh->queue_id)->not->toBe($otherQueue->id)
+        ->and($fresh->called_by_user_id)->toBeNull();
+});
+
+test('only status and call fields may change after issuance', function () {
+    $ticket = Ticket::factory()->create();
+    $attendant = User::factory()->create();
+    $calledAt = now();
+
+    $ticket->update([
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt,
+        'called_by_user_id' => $attendant->id,
+    ]);
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->status)->toBe(TicketStatus::Called)
+        ->and($fresh->called_at->toDateTimeString())->toBe($calledAt->toDateTimeString())
+        ->and($fresh->called_by_user_id)->toBe($attendant->id);
+});
