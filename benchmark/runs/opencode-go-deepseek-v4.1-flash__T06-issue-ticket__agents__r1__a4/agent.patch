+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Number of attempts used when a concurrent issuance claims the same code.
+     */
+    private const CODE_ATTEMPTS = 5;
+
+    /**
+     * Issue a new waiting ticket into the given queue.
+     *
+     * The queue row is locked and its state read from the database inside the
+     * transaction, so a caller holding a stale active model cannot bypass a
+     * deactivation that happened after the model was loaded.
+     *
+     * @throws InvalidArgumentException when the priority is negative
+     * @throws InactiveQueueException when the queue is inactive
+     */
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority cannot be negative.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel): Ticket {
+                    /** @var Queue $lockedQueue */
+                    $lockedQueue = Queue::query()
+                        ->lockForUpdate()
+                        ->findOrFail($queue->getKey());
+
+                    if (! $lockedQueue->is_active) {
+                        throw new InactiveQueueException('Cannot issue a ticket into an inactive queue.');
+                    }
+
+                    return Ticket::query()->create([
+                        'queue_id' => $lockedQueue->getKey(),
+                        'code' => Ticket::nextCode($lockedQueue->getKey()),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (QueryException $exception) {
+                if ($attempt >= self::CODE_ATTEMPTS || ! $this->isCodeCollision($exception)) {
+                    throw $exception;
+                }
+            }
+        }
+    }
+
+    /**
+     * Detect a unique-constraint violation caused by a concurrent code claim.
+     */
+    private function isCodeCollision(QueryException $exception): bool
+    {
+        $message = strtolower($exception->getMessage());
+
+        return (string) $exception->getCode() === '23000'
+            && (str_contains($message, 'unique') || str_contains($message, 'duplicate'));
+    }
+}
