@@ -0,0 +1,107 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issues a waiting virtual ticket with an allocated code and zero priority', function () {
+    $queue = Queue::factory()->create();
+    $before = now()->subSecond();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->issued_at->gte($before))->toBeTrue()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull()
+        ->and(Ticket::query()->whereKey($ticket->id)->exists())->toBeTrue();
+});
+
+test('issues consecutive codes and accepts a custom priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $first = (new IssueTicket)($queue);
+    $second = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+    $third = (new IssueTicket)($queue, 20, TicketChannel::Printed);
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and($second->priority)->toBe(10)
+        ->and($second->channel)->toBe(TicketChannel::Totem)
+        ->and($third->code)->toBe('A003')
+        ->and($third->priority)->toBe(20)
+        ->and($third->channel)->toBe(TicketChannel::Printed);
+});
+
+test('rejects a negative priority without persisting anything', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('rejects an inactive queue without persisting anything', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('checks queue state from the database instead of the passed model', function () {
+    $queue = Queue::factory()->create();
+    $stale = Queue::query()->findOrFail($queue->id);
+
+    Queue::query()->whereKey($queue->id)->update(['is_active' => false]);
+
+    expect($stale->is_active)->toBeTrue();
+
+    expect(fn () => (new IssueTicket)($stale))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+test('the action can be resolved with no constructor arguments', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = app(IssueTicket::class)($queue);
+
+    expect($ticket)->toBeInstanceOf(Ticket::class)
+        ->and($ticket->code)->toBe('A001');
+});
+
+test('retries when another issuance claims the same code concurrently', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    // Force the first insert attempt to reuse the already-taken code; the
+    // second attempt must allocate A002 and succeed.
+    $forcedCollision = false;
+    Ticket::creating(function (Ticket $ticket) use (&$forcedCollision): void {
+        if (! $forcedCollision) {
+            $forcedCollision = true;
+            $ticket->code = 'A001';
+        }
+    });
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($forcedCollision)->toBeTrue()
+        ->and($ticket->code)->toBe('A002')
+        ->and(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(2);
+});
