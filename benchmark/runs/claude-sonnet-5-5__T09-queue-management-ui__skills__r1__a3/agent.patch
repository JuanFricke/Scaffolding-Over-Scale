+
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('queue.access.granted', Mockery::on(
+        fn ($c) => $c['queue_id'] === $queue->id && $c['actor_id'] === $owner->id
+    ));
+    Log::shouldReceive('info')->once()->with('queue.access.revoked', Mockery::type('array'));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openAccess', $queue->id)
+        ->assertSet('accessQueueId', $queue->id)
+        ->assertSet('managingAccess', true)
+        ->assertSee('Eva Employee')
+        ->assertSee(__('ui.queues_access_manager'))
+        ->assertSeeHtml('grantAccess('.$employeeMembership->id.')')
+        ->assertDontSeeHtml('grantAccess('.$ownerMembership->id.')')
+        ->assertViewHas('accessQueue', fn ($q) => $q->is($queue))
+        ->assertViewHas('accessGrants', fn ($grants) => $grants->count() === 2);
+
+    $component->call('grantAccess', $employeeMembership->id)->assertSeeHtml('revokeAccess('.$employeeMembership->id.')');
+
+    $access = QueueAccess::where('queue_id', $queue->id)->where('entity_membership_id', $employeeMembership->id)->first();
+    expect($access->permissions)->toBe([QueuePermission::Call->value]);
+
+    $component->call('revokeAccess', $employeeMembership->id);
+    expect(QueueAccess::count())->toBe(0);
+
+    $component->call('closeAccess')
+        ->assertSet('accessQueueId', null)
+        ->assertSet('managingAccess', false);
+});
+
+test('foreign ids raise not-found and change nothing', function () {
+    [, $entity] = queuesFixture();
+    $foreignQueue = Queue::factory()->create(['name' => 'Foreign']);
+    $foreignMembership = EntityMembership::factory()->for($foreignQueue->entity)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Mine']);
+    $mine = EntityMembership::factory()->for($entity)->employee()->create();
+
+    $actions = [
+        ['openQueue', [$foreignQueue->id]],
+        ['startRename', [$foreignQueue->id]],
+        ['toggleActive', [$foreignQueue->id]],
+        ['openAccess', [$foreignQueue->id]],
+    ];
+
+    foreach ($actions as [$method, $args]) {
+        expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])->call($method, ...$args))
+            ->toThrow(ModelNotFoundException::class);
+    }
+
+    // Tampered state pointing at a foreign queue.
+    expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('editingQueueId', $foreignQueue->id)->set('renameName', 'Hacked')->call('rename'))
