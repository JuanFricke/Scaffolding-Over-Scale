+
+test('callNext without a call grant is a 403 and changes nothing', function () {
+    [, $entity] = serveFixture('employee');
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertForbidden()
+        ->assertSet('lastCalledTicketId', null);
+
+    expect($ticket->fresh()->status->value)->toBe('waiting');
+});
+
+test('lastCalledTicketId cannot be written by the client', function () {
+    [, $entity] = serveFixture();
+
+    expect(fn () => Livewire::test(Serve::class, ['entity' => $entity])->set('lastCalledTicketId', 1))
+        ->toThrow('Cannot update locked property');
+});
+
+test('successful calls are rate limited per user and entity', function () {
+    [$user, $entity] = serveFixture();
+    $queue = Queue::factory()->for($entity)->create();
+    foreach (range(1, 12) as $i) {
+        Ticket::factory()->forQueue($queue)->create();
+    }
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity]);
+
+    foreach (range(1, 10) as $i) {
+        $component->call('callNext')->assertSet('notice', fn ($n) => $n !== __('ui.serve_rate_limited'));
+    }
+
+    $component->call('callNext')->assertSet('notice', __('ui.serve_rate_limited'));
+
+    expect(Ticket::where('status', 'called')->count())->toBe(10);
+
+    RateLimiter::clear('serve-call:'.$entity->id.':'.$user->id);
+});
