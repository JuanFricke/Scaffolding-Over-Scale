+    EntityMembership::factory()->for($foreignQueue->entity)->employee()->create();
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('accessQueueId', $foreignQueue->id)
+        ->set('managingAccess', true)
+        ->assertViewHas('accessQueue', null)
+        ->assertViewHas('accessGrants', fn ($grants) => $grants->isEmpty())
+        ->assertDontSee('Foreign secret');
+});
+
+test('every component action rejects a manager who was demoted after mount', function () {
+    [$user, $entity, $actor] = queuesFixture();
+    $queue = Queue::factory()->for($entity)->create();
+    $target = EntityMembership::factory()->for($entity)->employee()->create();
+
+    $actions = [
+        fn ($c) => $c->call('create'),
+        fn ($c) => $c->call('openQueue', $queue->id),
+        fn ($c) => $c->call('toggleActive', $queue->id),
+        fn ($c) => $c->call('openAccess', $queue->id),
+        fn ($c) => $c->call('grantAccess', $target->id),
+        fn ($c) => $c->call('revokeAccess', $target->id),
+    ];
+
+    foreach ($actions as $action) {
+        // A failed Livewire request ends the component, so mount a fresh one per action.
+        $actor->update(['role' => 'owner']);
+        $component = Livewire::test(Queues::class, ['entity' => $entity]);
+        $actor->update(['role' => 'employee']);
+
+        $action($component)->assertForbidden();
+    }
+
+    expect($queue->fresh()->is_active)->toBeTrue()
+        ->and(QueueAccess::count())->toBe(0)
+        ->and($entity->queues()->count())->toBe(1);
+});
