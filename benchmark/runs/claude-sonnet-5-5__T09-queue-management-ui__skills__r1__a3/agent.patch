+<?php
+
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function serveFixture(string $role = 'owner'): array
+{
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($user)->{$role}()->create();
+
+    test()->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    return [$user, $entity, $membership];
+}
+
+function grantCall(EntityMembership $membership, Queue $queue): void
+{
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $queue->id,
+        'permissions' => ['call'],
+    ]);
+}
+
+test('the serve route renders for any member and is closed to outsiders', function () {
+    [, $entity] = serveFixture('employee');
+
+    expect(route('entity.serve', $entity->slug, false))->toBe('/e/'.$entity->slug.'/serve');
+    $this->get(route('entity.serve', $entity->slug))->assertOk();
+
+    $outsider = Entity::factory()->create();
+    Livewire::test(Serve::class, ['entity' => $outsider])->assertForbidden();
+});
+
+test('mount selects the first callable queue; managers can call all active queues', function () {
+    [, $entity] = serveFixture();
+    Queue::factory()->for($entity)->create(['name' => 'Inactive', 'is_active' => false]);
+    $first = Queue::factory()->for($entity)->create(['name' => 'Alpha']);
+    Queue::factory()->for($entity)->create(['name' => 'Beta']);
+    Queue::factory()->create(['name' => 'Foreign']);
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $first->id)
+        ->assertSet('mode', 'any')
+        ->assertSet('lastCalledTicketId', null)
+        ->assertSet('notice', null)
+        ->assertSee('Alpha')
+        ->assertSee('Beta')
+        ->assertDontSee('Inactive')
+        ->assertDontSee('Foreign');
+});
+
+test('employees only see queues they hold a call grant for', function () {
+    [, $entity, $membership] = serveFixture('employee');
+    Queue::factory()->for($entity)->create(['name' => 'Ungranted']);
+    $granted = Queue::factory()->for($entity)->create(['name' => 'Granted']);
+    grantCall($membership, $granted);
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $granted->id)
+        ->assertSee('Granted')
+        ->assertDontSee('Ungranted');
+});
+
+test('with nothing callable the selection is null and the empty state shows', function () {
+    [, $entity] = serveFixture('employee');
+    Queue::factory()->for($entity)->create();
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', null)
+        ->assertSee(__('ui.serve_empty'))
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_empty'))
+        ->assertHasNoErrors();
+});
+
+test('the waiting list is in call order, filtered by mode, translated and capped at 30', function () {
+    [, $entity] = serveFixture();
+    $queue = Queue::factory()->for($entity)->create();
+    $normal = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subMinutes(10), 'channel' => 'totem']);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 2, 'issued_at' => now()->subMinutes(1), 'channel' => 'printed']);
+    Ticket::factory()->forQueue($queue)->create(['status' => 'called', 'priority' => 5]);
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSeeInOrder([$priority->code, $normal->code])
+        ->assertSee(__('ui.channel_totem'))
+        ->assertSee(__('ui.channel_printed'));
+
+    $component->set('mode', 'priority_only')->assertSee($priority->code)->assertDontSee($normal->code);
+    $component->set('mode', 'normal_only')->assertSee($normal->code)->assertDontSee($priority->code);
+
+    $big = Queue::factory()->for($entity)->create();
+    foreach (range(1, 35) as $i) {
+        Ticket::factory()->forQueue($big)->create();
+    }
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $big->id)
+        ->assertViewHas('tickets', fn ($tickets) => $tickets->count() === 30);
+});
+
+test('the channel labels are translated in both locales', function () {
