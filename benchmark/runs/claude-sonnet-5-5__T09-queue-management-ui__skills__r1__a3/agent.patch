+test('deactivation goes through a confirmation modal, never wire:confirm', function () {
+    [, $entity] = queuesFixture();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Caixa']);
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
