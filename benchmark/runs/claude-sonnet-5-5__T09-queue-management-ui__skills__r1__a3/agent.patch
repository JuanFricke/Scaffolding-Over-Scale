+
+test('callNext honors the selected mode', function () {
+    [, $entity] = serveFixture();
+    $queue = Queue::factory()->for($entity)->create();
+    $normal = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 1]);
