+
+    expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('viewingQueueId', $foreignQueue->id)->call('confirmToggle'))
+        ->toThrow(ModelNotFoundException::class);
+
+    expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('accessQueueId', $foreignQueue->id)->call('grantAccess', $mine->id))
+        ->toThrow(ModelNotFoundException::class);
+
+    expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('accessQueueId', $queue->id)->call('grantAccess', $foreignMembership->id))
+        ->toThrow(ModelNotFoundException::class);
+
+    expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('accessQueueId', $queue->id)->call('revokeAccess', $foreignMembership->id))
+        ->toThrow(ModelNotFoundException::class);
+
+    expect($foreignQueue->fresh()->name)->toBe('Foreign')
+        ->and($foreignQueue->fresh()->is_active)->toBeTrue()
+        ->and(QueueAccess::count())->toBe(0);
+});
+
+test('a tampered accessQueueId pointing at a foreign queue discloses nothing', function () {
+    [, $entity] = queuesFixture();
