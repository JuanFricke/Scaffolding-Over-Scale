diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
index 6a778a4..afd8b2d 100644
--- a/tests/Feature/DiscordOpsAlertTest.php
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -121,3 +121,46 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends a mention of the configured user on its own last line', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => ' 123456789012345678 ']);
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message', ['a' => 'b']);
+
+    Http::assertSent(fn (Request $r) => str_ends_with($r['content'], "a=b\n<@123456789012345678>"));
+});
+
+test('accepts an integer mention id', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => 123456789012345678]);
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertSent(fn (Request $r) => str_ends_with($r['content'], "\n<@123456789012345678>"));
+});
+
+test('ignores empty or invalid mention ids', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $id]);
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertSent(fn (Request $r) => ! str_contains($r['content'], '<@'));
+})->with([null, '', '@everyone', '@here', 'abc', '123', "123\n@everyone", "123> \n@everyone", "12345678901234567\n@everyone", '123456789012345678901', '１２３４５６７８９０１２３４５６７８']);
+
+test('keeps the mention when a long alert is truncated to 1800 characters', function (?string $id, string $suffix) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $id]);
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Title', str_repeat('x', 5000));
+
+    Http::assertSent(fn (Request $r) => mb_strlen($r['content']) === 1800 && str_ends_with($r['content'], $suffix));
+})->with([
+    'with mention' => ['12345678901234567890', "\n<@12345678901234567890>"],
+    'without mention' => [null, 'x'],
+]);
