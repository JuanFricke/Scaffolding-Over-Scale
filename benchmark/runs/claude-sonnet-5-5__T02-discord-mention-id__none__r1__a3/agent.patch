- * Unconfigured (empty DISCORD_WEBHOOK_URL) is a silent no-op.
+ * Unconfigured (empty DISCORD_WEBHOOK_URL) is a silent no-op. When DISCORD_MENTION_ID
+ * holds a valid Discord user ID, every alert ends with a `<@id>` mention line.
  */
 class DiscordOpsAlert
 {
@@ -23,6 +24,8 @@ class DiscordOpsAlert
 
     private const string SecretKeyPattern = '/password|token|secret|authorization|api[_-]?key|webhook/i';
 
+    private const string SnowflakePattern = '/\A[0-9]{17,20}\z/D';
+
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
 
     /**
@@ -66,7 +69,36 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $mention = $this->mention();
+        $suffix = $mention === null ? '' : "\n".$mention;
+        $limit = self::MaxContentLength - mb_strlen($suffix);
+
+        return mb_substr(implode("\n", $lines), 0, $limit).$suffix;
+    }
+
+    /**
+     * Discord user mention from `services.discord.mention_id`, or null when
+     * unset or not a valid snowflake (17-20 digits). Invalid values are ignored.
+     */
+    private function mention(): ?string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (is_int($id)) {
+            $id = (string) $id;
+        }
+
+        if (! is_string($id)) {
+            return null;
+        }
+
+        $id = trim($id);
+
+        if (preg_match(self::SnowflakePattern, $id) !== 1) {
+            return null;
+        }
+
+        return '<@'.$id.'>';
     }
 
     private function safe(string $key, mixed $value): string
