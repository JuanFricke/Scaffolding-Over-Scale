@@ -12,9 +12,11 @@ ### Added
 - Database schema and Mermaid diagram in [`docs/database-schema.md`](docs/database-schema.md).
 - Business rules documentation in [`docs/business-rules.md`](docs/business-rules.md): MVP queue management, entity/subscription, roles (admin, owner, employee), tickets, priorities, fairness (3-ticket rule), deterministic call panel, and channels (Flutter totem, web TV, attendant).
 - This changelog (Keep a Changelog).
+- Discord ops alerts (`App\Ops\DiscordOpsAlert`, `DISCORD_WEBHOOK_URL`) and an `audit` log channel; logging lanes documented in [`docs/ops/logging.md`](docs/ops/logging.md).
 
 ### Changed
 
+- Default log stack is now `daily` (14-day retention) instead of `single`; `LOG_STACK=daily` is pinned in `phpunit.xml`.
 - Documented architecture: PegaFilaWeb is a single repository for frontend, backend and totem API; Flutter remains only as a separate client.
 - Simplified model: ticket is single-use (one call; write-once except `called_at`/`called_by`) — removed `ticket_calls` table; ticket knows only its queue (no `totem_id`). `tickets.priority` is now an integer (higher = more prioritized).
 - Expanded financial model: `billing_accounts` (1:0..1 with entity) + `subscriptions` + `plans` isolate financial data. New tables: `payment_options` (cycle, method, discount, refund window) and `payments` (individual charges). `billing_accounts` has `cpf_cnpj`. Subscription 1:1 with `billing_account_id` (UK); history in `payments`. Added `tickets.code`, explicit unique constraints, and circular FK note for owner. Removed per-queue user access limit.
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..fd1b3f2
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,120 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Stringable;
+use Throwable;
+
+/**
+ * Sends one human-pageable ops alert to a Discord incoming webhook.
+ *
+ * This is an explicit call, never a Monolog channel (see docs/ops/logging.md).
+ * It is a silent no-op without a configured webhook and never throws.
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const TIMEOUT_SECONDS = 5;
+
+    private const REDACTED = '[redacted]';
+
+    private const SENSITIVE_KEY = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const BEARER = '/\bBearer\s+\S+/i';
+
+    /**
+     * @param  array<string, mixed>  $context  Rendered as `key=value` lines; secrets are redacted.
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (! is_string($url) || $url === '') {
+            return;
+        }
+
+        try {
+            $response = Http::timeout(self::TIMEOUT_SECONDS)
+                ->post($url, ['content' => $this->format($title, $message, $context)]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (Throwable $e) {
+            Log::error('Discord ops alert failed', [
+                'exception' => $e::class,
+                'error' => $this->scrub($e->getMessage(), $url),
+            ]);
+        }
+    }
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    private function format(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->render($this->redact((string) $key, $value));
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH);
+    }
+
+    private function redact(string $key, mixed $value): mixed
+    {
+        if (preg_match(self::SENSITIVE_KEY, $key)) {
+            return self::REDACTED;
+        }
+
+        if (is_array($value)) {
+            $redacted = [];
+
+            foreach ($value as $k => $v) {
+                $redacted[$k] = $this->redact((string) $k, $v);
+            }
+
+            return $redacted;
+        }
+
+        if (is_string($value) && preg_match(self::BEARER, $value)) {
+            return self::REDACTED;
+        }
+
+        if ($value instanceof Stringable) {
+            return $this->redact($key, (string) $value);
+        }
+
+        return $value;
+    }
+
+    private function render(mixed $value): string
+    {
+        return match (true) {
+            is_string($value) => $value,
+            is_bool($value) => $value ? 'true' : 'false',
+            $value === null => 'null',
+            is_scalar($value) => (string) $value,
+            default => (string) json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR),
+        };
+    }
+
+    /** Removes the webhook URL (it embeds the token) from text destined for logs. */
+    private function scrub(string $text, string $url): string
+    {
+        $text = str_replace($url, self::REDACTED, $text);
+
+        // Also catch the path form, e.g. "/api/webhooks/{id}/{token}" in partial URLs.
+        $path = parse_url($url, PHP_URL_PATH);
+
+        if (is_string($path) && strlen($path) > 1) {
+            $text = str_replace($path, self::REDACTED, $text);
+        }
+
+        return $text;
+    }
+}
