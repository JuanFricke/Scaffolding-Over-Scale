@@ -0,0 +1,31 @@
+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('daily is the archive channel', function () {
+    $daily = config('logging.channels.daily');
+
+    expect($daily['driver'])->toBe('daily')
+        ->and($daily['path'])->toEndWith('logs/laravel.log')
+        ->and((int) $daily['days'])->toBe(14);
+});
+
+test('audit is a daily info channel kept for 90 days', function () {
+    $audit = config('logging.channels.audit');
+
+    expect($audit['driver'])->toBe('daily')
+        ->and($audit['path'])->toEndWith('logs/audit.log')
+        ->and((int) $audit['days'])->toBe(90)
+        ->and($audit['level'])->toBe('info');
+});
+
+test('audit channel accepts writes', function () {
+    Log::channel('audit')->info('Subscription status changed', ['from' => 'trial', 'to' => 'active']);
+
+    expect(true)->toBeTrue();
+});
+
+test('the stack uses daily and discord is not a log channel', function () {
+    expect(config('logging.channels.stack.channels'))->toContain('daily')->not->toContain('single')
+        ->and(config('logging.channels'))->not->toHaveKey('discord');
+});
