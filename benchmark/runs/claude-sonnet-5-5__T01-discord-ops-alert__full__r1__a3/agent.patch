diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..ed7e866
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,104 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+const WEBHOOK = 'https://discord.com/api/webhooks/123456/super-secret-token';
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => WEBHOOK]);
+});
+
+function sentContent(): string
+{
+    $content = null;
+    Http::assertSent(function (Request $request) use (&$content) {
+        $content = $request['content'];
+
+        return true;
+    });
+
+    return $content;
+}
+
+test('it is a silent no-op when the webhook is not configured', function (?string $url) {
+    config(['services.discord.webhook_url' => $url]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertNothingSent();
+})->with([null, '']);
+
+test('it posts the json content to the configured url', function () {
+    Http::fake();
+    app(DiscordOpsAlert::class)->send('Job failed', 'Retries exhausted', ['entity_id' => 42, 'queue' => 'asaas-webhooks']);
+
+    Http::assertSent(fn (Request $request) => $request->method() === 'POST'
+        && $request->url() === WEBHOOK
+        && $request->isJson()
+        && $request['content'] === "Job failed\nRetries exhausted\nentity_id=42\nqueue=asaas-webhooks");
+});
+
+test('it truncates the text to 1800 characters, multibyte-safe', function () {
+    Http::fake();
+    (new DiscordOpsAlert)->send('T', str_repeat('ç', 5000));
+
+    $content = sentContent();
+
+    expect(mb_strlen($content))->toBe(1800)
+        ->and(mb_check_encoding($content, 'UTF-8'))->toBeTrue();
+});
+
+test('it redacts sensitive keys, bearer values and nested arrays', function () {
+    Http::fake();
+    (new DiscordOpsAlert)->send('T', 'M', [
+        'Password' => 'hunter2',
+        'api-key' => 'abc',
+        'X_Webhook_Url' => 'https://discord.com/x',
+        'note' => 'sent Authorization: Bearer abc.def.ghi today',
+        'queue' => 'asaas-webhooks',
+        'nested' => ['ok' => 'fine', 'client_secret' => 's3', 'deep' => ['h' => 'Bearer zzz']],
+    ]);
+
+    $content = sentContent();
+
+    expect($content)
+        ->toContain('Password=[redacted]')
+        ->toContain('api-key=[redacted]')
+        ->toContain('X_Webhook_Url=[redacted]')
+        ->toContain('note=[redacted]')
+        ->toContain('queue=asaas-webhooks')
+        ->toContain('nested={"ok":"fine","client_secret":"[redacted]","deep":{"h":"[redacted]"}}')
+        ->not->toContain('hunter2')
+        ->not->toContain('abc.def.ghi')
+        ->not->toContain('s3');
+});
+
+test('it logs an error without the webhook url on a non-2xx response', function () {
+    Http::fake(['*' => Http::response('nope', 500)]);
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function (string $message, array $context = []) {
+        return str_contains($message.json_encode($context), '500')
+            && ! str_contains($message.json_encode($context), 'super-secret-token');
+    });
+});
+
+test('it never throws and scrubs the webhook url when transport fails', function () {
+    Http::fake(fn () => throw new ConnectionException('cURL error 28 for '.WEBHOOK));
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function (string $message, array $context = []) {
+        $all = $message.json_encode($context);
+
+        return ! str_contains($all, 'super-secret-token') && ! str_contains($all, '123456');
+    });
+});
