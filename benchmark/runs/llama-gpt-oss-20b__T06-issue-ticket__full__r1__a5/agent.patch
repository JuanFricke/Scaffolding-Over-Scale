@@ -0,0 +1,104 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use App\Models\User;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Get the attributes that should be cast.
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'int',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    /**
+     * The queue this ticket belongs to.
+     */
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    /**
+     * The user who called this ticket.
+     */
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Compute the next display code for a given queue.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        // Fetch all codes for the queue that match pattern A<digits>
+        $codes = self::where('queue_id', $queueId)
+            ->where('code', 'like', 'A%')
+            ->pluck('code');
+
+        $max = 0;
+        foreach ($codes as $code) {
+            if (preg_match('/^A(\d+)$/', $code, $m)) {
+                $num = (int) $m[1];
+                if ($num > $max) {
+                    $max = $num;
+                }
+            }
+        }
+
+        $next = $max + 1;
+        // Pad to at least 3 digits, but keep original length for larger numbers
+        $len = max(3, strlen((string) $next));
+        return 'A' . str_pad((string) $next, $len, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call the ticket.
+     */
+    public function call(App\Models\User $user): void
+    {
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new \LogicException('Ticket can only be called from waiting status.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->save();
+    }
+
+    /**
+     * Prevent modification of immutable fields after creation.
+     */
+    public function setAttribute($key, $value): void
+    {
+        if ($this->exists) {
+            $allowed = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+            if (!in_array($key, $allowed, true)) {
+                throw new \LogicException("Cannot modify attribute '{$key}' on ticket after issuance.");
+            }
+        }
+        parent::setAttribute($key, $value);
+    }
+}
