+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Exceptions\InactiveQueueException;
+use Illuminate\Support\Facades\DB;
+
+class IssueTicket
+{
+    /**
+     * @param Queue $queue
+     * @param int $priority
+     * @param TicketChannel $channel
+     * @return Ticket
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new \InvalidArgumentException('Priority must be >= 0.');
+        }
+
+        return DB::transaction(function () use ($queue, $priority, $channel) {
+            // Lock the queue row to prevent concurrent state changes
+            $lockedQueue = DB::table('queues')
+                ->where('id', $queue->id)
+                ->lockForUpdate()
+                ->first();
+
+            if ($lockedQueue === null || !$lockedQueue->is_active) {
+                throw new InactiveQueueException('Queue is inactive.');
+            }
+
+            // Compute next code
+            $code = Ticket::nextCode($queue->id);
+
+            // Create ticket
+            return Ticket::create([
+                'queue_id' => $queue->id,
+                'code' => $code,
+                'priority' => $priority,
+                'channel' => $channel,
+                'status' => TicketStatus::Waiting,
+                'issued_at' => now(),
+            ]);
+        }, 3);
+    }
+}
