+    $this->actingAs($membership->user)->post(route('entity.pick', $membership->entity));
+
+    $audit->shouldHaveReceived('info')->with('Entity picked', Mockery::type('array'))->once();
+});
+
+test('a non-member gets 403 and the session is left untouched', function () {
+    $entity = Entity::factory()->create();
+    $ownSession = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($ownSession->user)
+        ->withSession(['current_entity_id' => $ownSession->entity_id])
+        ->post(route('entity.pick', $entity))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $ownSession->entity_id);
+});
+
+test('guests are redirected to log in before picking an entity', function () {
+    $entity = Entity::factory()->create();
+
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+    $this->assertGuest();
+});
+
+test('unverified users cannot pick an entity', function () {
+    $membership = EntityMembership::factory()->owner()->for(User::factory()->unverified())->create();
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $membership->entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the pick route is named and mounted at the slug path', function () {
+    $entity = Entity::factory()->create(['slug' => 'padaria-sol']);
+
+    expect(route('entity.pick', $entity))->toEndWith('/e/padaria-sol/pick');
+});
diff --git a/tests/Feature/Entities/PolicyTest.php b/tests/Feature/Entities/PolicyTest.php
new file mode 100644
index 0000000..445a1a9
--- /dev/null
+++ b/tests/Feature/Entities/PolicyTest.php
@@ -0,0 +1,147 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+dataset('entity roles', [
+    'owner' => [UserRole::Owner],
+    'admin' => [UserRole::Admin],
+    'employee' => [UserRole::Employee],
+]);
+
+test('any authenticated user may create an entity', function () {
+    expect((new EntityPolicy)->create(User::factory()->create()))->toBeTrue();
+});
+
+test('any member may view the entity', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $member = EntityMembership::factory()->state(['role' => $role])->for($entity)->create();
+
+    expect((new EntityPolicy)->view($member->user, $entity))->toBeTrue();
+})->with('entity roles');
+
+test('a non-member may not view the entity', function () {
+    $entity = Entity::factory()->create();
+
+    expect((new EntityPolicy)->view(User::factory()->create(), $entity))->toBeFalse();
+});
+
+test('only the owner and admins may update or delete the entity', function (UserRole $role, bool $allowed) {
+    $entity = Entity::factory()->create();
+    $member = EntityMembership::factory()->state(['role' => $role])->for($entity)->create();
+
+    expect((new EntityPolicy)->update($member->user, $entity))->toBe($allowed)
+        ->and((new EntityPolicy)->delete($member->user, $entity))->toBe($allowed);
+})->with([
+    'owner' => [UserRole::Owner, true],
+    'admin' => [UserRole::Admin, true],
+    'employee' => [UserRole::Employee, false],
+]);
+
+test('a non-member may neither update nor delete the entity', function () {
+    $entity = Entity::factory()->create();
+    $stranger = User::factory()->create();
+
+    expect((new EntityPolicy)->update($stranger, $entity))->toBeFalse()
+        ->and((new EntityPolicy)->delete($stranger, $entity))->toBeFalse();
+});
+
+test('only the owner may manage the entity settings', function (UserRole $role, bool $allowed) {
+    $entity = Entity::factory()->create();
+    $member = EntityMembership::factory()->state(['role' => $role])->for($entity)->create();
+
+    expect((new EntityPolicy)->manageSettings($member->user, $entity))->toBe($allowed);
+})->with([
+    'owner' => [UserRole::Owner, true],
+    'admin' => [UserRole::Admin, false],
+    'employee' => [UserRole::Employee, false],
+]);
+
+test('a member of another entity cannot act on this entity', function () {
+    $entity = Entity::factory()->create();
+    $otherOwner = EntityMembership::factory()->owner()->create()->user;
+
+    expect((new EntityPolicy)->view($otherOwner, $entity))->toBeFalse()
+        ->and((new EntityPolicy)->manageSettings($otherOwner, $entity))->toBeFalse();
+});
+
+test('any member may view the memberships of their entity', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $viewer = EntityMembership::factory()->state(['role' => $role])->for($entity)->create();
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect((new EntityMembershipPolicy)->view($viewer->user, $target))->toBeTrue();
+})->with('entity roles');
+
+test('outsiders may not view memberships of an entity', function () {
+    $target = EntityMembership::factory()->employee()->create();
+
+    expect((new EntityMembershipPolicy)->view(User::factory()->create(), $target))->toBeFalse();
+});
+
+test('owner and admin may assign roles to non-owner members', function (UserRole $actorRole, bool $allowed) {
+    $entity = Entity::factory()->create();
+    $actor = EntityMembership::factory()->state(['role' => $actorRole])->for($entity)->create();
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect((new EntityMembershipPolicy)->assignRole($actor->user, $target))->toBe($allowed);
+})->with([
+    'owner' => [UserRole::Owner, true],
+    'admin' => [UserRole::Admin, true],
+    'employee' => [UserRole::Employee, false],
+]);
+
+test('the owner membership can never be reassigned', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect((new EntityMembershipPolicy)->assignRole($owner->user, $owner))->toBeFalse();
+});
+
+test('a member of another entity may not assign roles here', function () {
+    $target = EntityMembership::factory()->employee()->create();
+    $otherOwner = EntityMembership::factory()->owner()->create()->user;
+
+    expect((new EntityMembershipPolicy)->assignRole($otherOwner, $target))->toBeFalse();
+});
+
+test('the owner membership is never deletable', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect((new EntityMembershipPolicy)->delete($owner->user, $owner))->toBeFalse();
+});
+
+test('owner and admin may remove other members', function (UserRole $actorRole, bool $allowed) {
+    $entity = Entity::factory()->create();
+    $actor = EntityMembership::factory()->state(['role' => $actorRole])->for($entity)->create();
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect((new EntityMembershipPolicy)->delete($actor->user, $target))->toBe($allowed);
+})->with([
+    'owner' => [UserRole::Owner, true],
+    'admin' => [UserRole::Admin, true],
+    'employee' => [UserRole::Employee, false],
+]);
+
+test('any member may remove their own membership', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    $self = EntityMembership::factory()->state(['role' => $role])->for($entity)->create();
+
+    expect((new EntityMembershipPolicy)->delete($self->user, $self))->toBeTrue();
+})->with(['admin' => [UserRole::Admin], 'employee' => [UserRole::Employee]]);
+
+test('a non-member may not remove a membership', function () {
+    $target = EntityMembership::factory()->employee()->create();
+
+    expect((new EntityMembershipPolicy)->delete(User::factory()->create(), $target))->toBeFalse();
+});
diff --git a/tests/Feature/Entities/SettingsTest.php b/tests/Feature/Entities/SettingsTest.php
new file mode 100644
index 0000000..b7cba61
--- /dev/null
+++ b/tests/Feature/Entities/SettingsTest.php
@@ -0,0 +1,224 @@
+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the owner sees the settings form', function () {
+    $owner = EntityMembership::factory()->owner()->for(Entity::factory()->create(['name' => 'Padaria Sol', 'slug' => 'padaria-sol']))->create();
+
+    $this->actingAs($owner->user)
+        ->get(route('entity.settings', $owner->entity))
+        ->assertOk()
+        ->assertSee('Padaria Sol')
+        ->assertSee('Transferir propriedade');
+});
+
+test('admins and employees cannot open the settings', function (UserRole $role) {
+    $membership = EntityMembership::factory()->state(['role' => $role])->create();
+    $this->actingAs($membership->user);
+
+    Livewire::test(Settings::class, ['entity' => $membership->entity])->assertForbidden();
+})->with([
+    'admin' => [UserRole::Admin],
+    'employee' => [UserRole::Employee],
+]);
+
+test('an HTTP request to settings is forbidden for admins', function () {
+    $admin = EntityMembership::factory()->admin()->create();
+
+    $this->actingAs($admin->user)
+        ->get(route('entity.settings', $admin->entity))
+        ->assertForbidden();
+});
+
+test('the owner saves a new name and slug', function () {
+    $owner = EntityMembership::factory()->owner()->for(Entity::factory()->create(['slug' => 'antigo']))->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('name', 'Padaria Nova')
+        ->set('slug', 'padaria-nova')
+        ->call('save')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.settings', ['entity' => 'padaria-nova']));
+
+    expect($owner->entity->fresh())
+        ->name->toBe('Padaria Nova')
+        ->slug->toBe('padaria-nova');
+});
+
+test('keeping the same slug is not a duplicate', function () {
+    $owner = EntityMembership::factory()->owner()->for(Entity::factory()->create(['slug' => 'padaria']))->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('name', 'Outro nome')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    expect($owner->entity->fresh()->slug)->toBe('padaria');
+});
+
+test('a slug already used by another entity is an error on slug', function () {
+    Entity::factory()->create(['slug' => 'ocupado']);
+    $owner = EntityMembership::factory()->owner()->for(Entity::factory()->create(['slug' => 'padaria']))->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('slug', 'ocupado')
+        ->call('save')
+        ->assertHasErrors(['slug' => 'unique']);
+});
+
+test('an invalid slug is rejected', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('slug', 'Padaria Sol!')
+        ->call('save')
+        ->assertHasErrors('slug');
+});
+
+test('an admin cannot save the settings even by calling the action directly', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+    $component = Livewire::test(Settings::class, ['entity' => $owner->entity]);
+
+    $this->actingAs($admin->user);
+
+    $component->set('name', 'Invadido')->call('save')->assertForbidden();
+
+    expect($owner->entity->fresh()->name)->not->toBe('Invadido');
+});
+
+test('the owner deletes the entity, its memberships and clears the session', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+    session(['current_entity_id' => $owner->entity_id]);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->call('delete')
+        ->assertRedirect(route('home'));
+
+    $this->assertSoftDeleted('entities', ['id' => $owner->entity_id]);
+    $this->assertDatabaseMissing('entity_memberships', ['id' => $owner->id]);
+    $this->assertDatabaseMissing('entity_memberships', ['id' => $employee->id]);
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('deleting an entity keeps another picked entity in the session', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $other = EntityMembership::factory()->owner()->create(['user_id' => $owner->user_id]);
+    $this->actingAs($owner->user);
+    session(['current_entity_id' => $other->entity_id]);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])->call('delete');
+
+    expect(session('current_entity_id'))->toBe($other->entity_id);
+});
+
+test('an admin cannot delete the entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+    $this->actingAs($admin->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])->assertForbidden();
+
+    expect(Entity::query()->find($owner->entity_id))->not->toBeNull();
+});
+
+test('only admins are offered as the new owner', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->admin()->for($owner->entity)->for(User::factory()->create(['email' => 'chefe@example.com']))->create();
+    EntityMembership::factory()->employee()->for($owner->entity)->for(User::factory()->create(['email' => 'equipe@example.com']))->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->assertSee('chefe@example.com')
+        ->assertDontSee('equipe@example.com');
+});
+
+test('the owner transfers ownership to an admin and becomes an admin', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('targetMembershipId', $admin->id)
+        ->call('transfer')
+        ->assertRedirect(route('entity.dashboard', $owner->entity));
+
+    expect($admin->fresh()->role)->toBe(UserRole::Owner)
+        ->and($owner->fresh()->role)->toBe(UserRole::Admin)
+        ->and($owner->entity->memberships()->owner()->count())->toBe(1);
+});
+
+test('ownership can only be transferred to an admin of this entity', function (string $case) {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $foreignAdmin = EntityMembership::factory()->admin()->create();
+    $targetId = match ($case) {
+        'employee' => $employee->id,
+        'self' => $owner->id,
+        'foreign' => $foreignAdmin->id,
+        'missing' => null,
+    };
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('targetMembershipId', $targetId)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner)
+        ->and($employee->fresh()->role)->toBe(UserRole::Employee)
+        ->and($foreignAdmin->fresh()->role)->toBe(UserRole::Admin);
+})->with(['employee', 'self', 'foreign', 'missing']);
+
+test('the transfer is refused when the owner row has vanished', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+    $component = Livewire::test(Settings::class, ['entity' => $owner->entity]);
+
+    $owner->delete();
+
+    $component->set('targetMembershipId', $admin->id)->call('transfer')->assertForbidden();
+
+    expect($admin->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('the bound entity cannot be swapped from the client', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $victim = Entity::factory()->create(['name' => 'Alheia']);
+    $this->actingAs($owner->user);
+    $component = Livewire::test(Settings::class, ['entity' => $owner->entity]);
+
+    expect(fn () => $component->set('entity', $victim))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+
+    expect($victim->fresh()->name)->toBe('Alheia');
+});
+
+test('a blank transfer target from the placeholder option is refused', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Settings::class, ['entity' => $owner->entity])
+        ->set('targetMembershipId', '')
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner);
+});
