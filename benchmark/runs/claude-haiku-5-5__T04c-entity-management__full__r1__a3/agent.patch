@@ -0,0 +1,28 @@
+<?php
+
+namespace App\Models;
+
+enum UserRole: string
+{
+    case Owner = 'owner';
+    case Admin = 'admin';
+    case Employee = 'employee';
+
+    /**
+     * The roles an owner or admin may hand out. Ownership only moves by transfer.
+     *
+     * @return list<self>
+     */
+    public static function manageable(): array
+    {
+        return [self::Admin, self::Employee];
+    }
+
+    /**
+     * Whether the role may manage the entity's members (owner and admin).
+     */
+    public function isManager(): bool
+    {
+        return $this === self::Owner || $this === self::Admin;
+    }
+}
