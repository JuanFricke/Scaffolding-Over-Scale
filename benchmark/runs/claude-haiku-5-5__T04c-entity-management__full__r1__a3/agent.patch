@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class AddMember
+{
+    /**
+     * Add an existing user to the entity as an employee. Owner and admin only.
+     *
+     * @throws ValidationException when the user is already a member.
+     */
+    public function __invoke(User $actor, Entity $entity, User $newMember): EntityMembership
+    {
+        Gate::forUser($actor)->authorize('update', $entity);
+
+        $membership = $entity->memberships()->firstOrCreate(
+            ['user_id' => $newMember->id],
+            ['role' => UserRole::Employee],
+        );
+
+        if (! $membership->wasRecentlyCreated) {
+            throw ValidationException::withMessages(['email' => __('ui.member_already_exists')]);
+        }
+
+        Log::channel('audit')->info('Entity member added', [
+            'entity_id' => $entity->id,
+            'actor_id' => $actor->id,
+            'user_id' => $newMember->id,
+        ]);
+
+        return $membership;
+    }
+}
