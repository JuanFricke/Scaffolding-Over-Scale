+
+    expect($foreign->fresh()->role)->toBe(UserRole::Employee)
+        ->and(EntityMembership::query()->find($foreign->id))->not->toBeNull();
+});
+
+test('the owner removes an employee', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $employee->id)
+        ->assertHasNoErrors();
+
+    expect(EntityMembership::query()->find($employee->id))->toBeNull();
+});
+
+test('the owner membership can never be removed', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->admin()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $owner->id)
+        ->assertForbidden();
+
+    expect(EntityMembership::query()->find($owner->id))->not->toBeNull();
+});
+
+test('an employee cannot remove a colleague', function () {
+    $employee = EntityMembership::factory()->employee()->create();
+    $colleague = EntityMembership::factory()->employee()->for($employee->entity)->create();
+    $this->actingAs($employee->user);
+
+    Livewire::test(Members::class, ['entity' => $employee->entity])
+        ->call('removeMember', $colleague->id)
+        ->assertForbidden();
+
+    expect(EntityMembership::query()->find($colleague->id))->not->toBeNull();
+});
+
+test('an employee may remove their own membership and is sent home', function () {
+    $employee = EntityMembership::factory()->employee()->create();
+    $this->actingAs($employee->user);
+    session(['current_entity_id' => $employee->entity_id]);
+
+    Livewire::test(Members::class, ['entity' => $employee->entity])
+        ->call('removeMember', $employee->id)
+        ->assertRedirect(route('home'));
+
+    expect(EntityMembership::query()->find($employee->id))->toBeNull()
+        ->and(session('current_entity_id'))->toBeNull();
+});
+
+test('the last manager of an entity cannot be removed', function () {
+    $entity = Entity::factory()->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+    $this->actingAs($admin->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $admin->id)
+        ->assertForbidden();
+
+    expect(EntityMembership::query()->find($admin->id))->not->toBeNull()
+        ->and(EntityMembership::query()->find($employee->id))->not->toBeNull();
+});
+
+test('removing a member leaves an audit trail', function () {
+    $audit = Mockery::spy();
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])->call('removeMember', $employee->id);
+
+    $audit->shouldHaveReceived('info')->with('Entity member removed', Mockery::type('array'))->once();
+});
