@@ -0,0 +1,42 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class RemoveMember
+{
+    /**
+     * Remove a member from the entity. The owner is never removable and the
+     * last owner/admin of an entity is never removed.
+     *
+     * @throws AuthorizationException when the membership cannot be removed.
+     */
+    public function __invoke(User $actor, EntityMembership $membership): void
+    {
+        Gate::forUser($actor)->authorize('delete', $membership);
+
+        $otherManagers = EntityMembership::query()
+            ->where('entity_id', $membership->entity_id)
+            ->whereKeyNot($membership->getKey())
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->count();
+
+        if ($membership->role->isManager() && $otherManagers === 0) {
+            throw new AuthorizationException(__('ui.last_manager'));
+        }
+
+        $membership->delete();
+
+        Log::channel('audit')->info('Entity member removed', [
+            'entity_id' => $membership->entity_id,
+            'actor_id' => $actor->id,
+            'membership_id' => $membership->id,
+        ]);
+    }
+}
