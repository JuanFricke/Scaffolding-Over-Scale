+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $entityMembership): bool
+    {
+        return $this->roleIn($user, $entityMembership) !== null;
+    }
+
+    /**
+     * Owner and admin may assign roles, but the owner's own role is never reassigned.
+     */
+    public function assignRole(User $user, EntityMembership $entityMembership): bool
+    {
+        return $entityMembership->role !== UserRole::Owner
+            && $this->roleIn($user, $entityMembership)?->isManager() === true;
+    }
+
+    /**
+     * The owner's membership is never deletable. Members may remove themselves;
+     * otherwise owner and admin may remove members.
+     */
+    public function delete(User $user, EntityMembership $entityMembership): bool
+    {
+        if ($entityMembership->role === UserRole::Owner) {
+            return false;
+        }
+
+        $actor = $user->membershipFor($entityMembership->entity_id);
+
+        if ($actor === null) {
+            return false;
+        }
+
+        return $entityMembership->user_id === $user->id || $actor->role->isManager();
+    }
+
+    private function roleIn(User $user, EntityMembership $entityMembership): ?UserRole
+    {
+        return $user->membershipFor($entityMembership->entity_id)?->role;
+    }
+}
