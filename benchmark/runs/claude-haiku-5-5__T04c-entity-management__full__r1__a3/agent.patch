diff --git a/tests/Feature/Entities/DataModelTest.php b/tests/Feature/Entities/DataModelTest.php
new file mode 100644
index 0000000..cab97ae
--- /dev/null
+++ b/tests/Feature/Entities/DataModelTest.php
@@ -0,0 +1,148 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity slugs are unique through a named index', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))->toThrow(QueryException::class);
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique');
+});
+
+test('a user has at most one membership per entity', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->create();
+
+    expect(fn () => EntityMembership::factory()->for($entity)->for($user)->create())->toThrow(QueryException::class);
+    expect(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))->toContain('entity_memberships_entity_user_unique');
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())->toThrow(QueryException::class);
+    expect(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))->toContain('entity_memberships_one_owner');
+});
+
+test('a membership cannot be promoted to owner when the entity already has one', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect(fn () => $admin->update(['role' => UserRole::Owner]))->toThrow(QueryException::class);
+});
+
+test('an entity can have many admins and employees and one owner per entity', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->owner()->for($other)->create();
+    EntityMembership::factory()->admin()->count(2)->for($entity)->create();
+    EntityMembership::factory()->employee()->count(3)->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(6);
+});
+
+test('the role column defaults to employee', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(EntityMembership::query()->where('user_id', $user->id)->first()->role)->toBe(UserRole::Employee);
+});
+
+test('deleting a user or hard-deleting an entity removes its memberships', function () {
+    $membership = EntityMembership::factory()->create();
+    $otherMembership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+    $otherMembership->entity->forceDelete();
+
+    expect(EntityMembership::query()->count())->toBe(0);
+});
+
+test('soft-deleting an entity keeps its memberships and hides the entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->entity->delete();
+
+    expect(Entity::query()->count())->toBe(0)
+        ->and(Entity::withTrashed()->count())->toBe(1)
+        ->and(EntityMembership::query()->count())->toBe(1);
+});
+
+test('entities are routed by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'padaria-sol']);
+
+    expect($entity->getRouteKey())->toBe('padaria-sol')
+        ->and($entity->getRouteKeyName())->toBe('slug')
+        ->and(Entity::query()->where('slug', 'padaria-sol')->firstOrFail()->is($entity))->toBeTrue();
+});
+
+test('the role is cast to the UserRole enum', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('the owner relation returns the owner membership query', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue()
+        ->and($entity->owner()->exists())->toBeTrue()
+        ->and($entity->users()->count())->toBe(2);
+});
+
+test('scopes filter memberships by role', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->count(2)->for($entity)->create();
+
+    expect(EntityMembership::query()->owner()->count())->toBe(1)
+        ->and(EntityMembership::query()->admin()->count())->toBe(1)
+        ->and(EntityMembership::query()->employee()->count())->toBe(2);
+});
+
+test('the user relations expose entities and the membership for a given entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->admin()->for($entity)->for($user)->create();
+
+    expect($user->memberships()->count())->toBe(1)
+        ->and($user->entities()->first()->is($entity))->toBeTrue()
+        ->and($user->membershipFor($entity->id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor(Entity::factory()->create()->id))->toBeNull();
+});
+
+test('the manageable roles are admin and employee', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('the factories create consistent memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->not->toBeNull()
+        ->and($membership->user)->not->toBeNull();
+});
