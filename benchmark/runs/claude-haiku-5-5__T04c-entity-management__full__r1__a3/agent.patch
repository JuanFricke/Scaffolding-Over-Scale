--- /dev/null
+++ b/app/Actions/TransferOwnership.php
@@ -0,0 +1,45 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class TransferOwnership
+{
+    /**
+     * Hand the entity to one of its admins. The current owner is demoted to admin
+     * and the target promoted to owner in one transaction. Owner only.
+     *
+     * @throws AuthorizationException when the target is not an admin of this entity
+     *                                other than the caller, or the owner row is gone.
+     */
+    public function __invoke(User $actor, Entity $entity, ?int $targetMembershipId): void
+    {
+        Gate::forUser($actor)->authorize('manageSettings', $entity);
+
+        DB::transaction(function () use ($actor, $entity, $targetMembershipId) {
+            $owner = $entity->owner()->lockForUpdate()->first();
+            $target = $entity->memberships()->lockForUpdate()->find($targetMembershipId);
+
+            if ($owner === null || $target === null || $target->role !== UserRole::Admin || $target->user_id === $actor->id) {
+                throw new AuthorizationException;
+            }
+
+            // Demote first: the (entity_id, owner_seq) unique index allows one owner at a time.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+
+            Log::channel('audit')->info('Entity ownership transferred', [
+                'entity_id' => $entity->id,
+                'actor_id' => $actor->id,
+                'new_owner_membership_id' => $target->id,
+            ]);
+        });
+    }
+}
