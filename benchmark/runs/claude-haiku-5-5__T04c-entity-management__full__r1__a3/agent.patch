@@ -0,0 +1,36 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class AssignRole
+{
+    /**
+     * Change a member's role to admin or employee. Owner and admin only.
+     *
+     * @throws ValidationException when the role is not assignable (owner is transfer-only).
+     */
+    public function __invoke(User $actor, EntityMembership $membership, UserRole $role): void
+    {
+        Gate::forUser($actor)->authorize('assignRole', $membership);
+
+        if (! in_array($role, UserRole::manageable(), true)) {
+            throw ValidationException::withMessages(['role' => __('validation.in', ['attribute' => 'role'])]);
+        }
+
+        $membership->update(['role' => $role]);
+
+        Log::channel('audit')->info('Entity member role changed', [
+            'entity_id' => $membership->entity_id,
+            'actor_id' => $actor->id,
+            'membership_id' => $membership->id,
+            'role' => $role->value,
+        ]);
+    }
+}
