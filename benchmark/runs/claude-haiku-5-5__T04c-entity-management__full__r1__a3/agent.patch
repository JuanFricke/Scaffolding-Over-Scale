+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the owner sees every member of the entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->for(User::factory()->create(['name' => 'Ana Lima']))->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->assertSee($owner->user->name)
+        ->assertSee('Ana Lima')
+        ->assertSee($employee->user->email);
+});
+
+test('an employee can view the members list', function () {
+    $employee = EntityMembership::factory()->employee()->create();
+    $this->actingAs($employee->user);
+
+    Livewire::test(Members::class, ['entity' => $employee->entity])->assertOk();
+});
+
+test('a non-member cannot open the members page', function () {
+    $entity = Entity::factory()->create();
+    $this->actingAs(EntityMembership::factory()->owner()->create()->user);
+
+    Livewire::test(Members::class, ['entity' => $entity])->assertForbidden();
+});
+
+test('the members page is served over HTTP for members', function () {
+    $admin = EntityMembership::factory()->admin()->create();
+
+    $this->actingAs($admin->user)
+        ->get(route('entity.members', $admin->entity))
+        ->assertOk()
+        ->assertSee('Membros');
+});
+
+test('the owner adds an existing user as an employee', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $newcomer = User::factory()->create(['email' => 'novo@example.com']);
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->set('email', 'novo@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors();
+
+    $membership = EntityMembership::query()->where('user_id', $newcomer->id)->firstOrFail();
+    expect($membership->entity_id)->toBe($owner->entity_id)
+        ->and($membership->role)->toBe(UserRole::Employee);
+});
+
+test('an admin may add members too', function () {
+    $admin = EntityMembership::factory()->admin()->create();
+    User::factory()->create(['email' => 'novo@example.com']);
+    $this->actingAs($admin->user);
+
+    Livewire::test(Members::class, ['entity' => $admin->entity])
+        ->set('email', 'novo@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors();
+
+    expect($admin->entity->memberships()->count())->toBe(2);
+});
+
+test('adding an unknown e-mail is a validation error on email', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->set('email', 'ninguem@example.com')
+        ->call('addMember')
+        ->assertHasErrors(['email' => 'exists']);
+});
+
+test('adding a user who is already a member is an error on email', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->set('email', $employee->user->email)
+        ->call('addMember')
+        ->assertHasErrors('email');
+
+    expect($owner->entity->memberships()->count())->toBe(2);
+});
+
+test('an employee cannot add members', function () {
+    $employee = EntityMembership::factory()->employee()->create();
+    User::factory()->create(['email' => 'novo@example.com']);
+    $this->actingAs($employee->user);
+
+    Livewire::test(Members::class, ['entity' => $employee->entity])
+        ->set('email', 'novo@example.com')
+        ->call('addMember')
+        ->assertForbidden();
+
+    expect($employee->entity->memberships()->count())->toBe(1);
+});
+
+test('the owner promotes an employee to admin and demotes them back', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+
+    $component = Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $employee->id, 'admin')
+        ->assertHasNoErrors();
+
+    expect($employee->fresh()->role)->toBe(UserRole::Admin);
+
+    $component->call('assignRole', $employee->id, 'employee')->assertHasNoErrors();
+
+    expect($employee->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('assigning the owner role is a validation error on role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $employee->id, 'owner')
+        ->assertHasErrors('role');
+
+    expect($employee->fresh()->role)->toBe(UserRole::Employee)
+        ->and($owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('an arbitrary role is a validation error on role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->employee()->for($owner->entity)->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $employee->id, 'superuser')
+        ->assertHasErrors('role');
+});
+
+test('an employee cannot assign roles', function () {
+    $employee = EntityMembership::factory()->employee()->create();
+    $colleague = EntityMembership::factory()->employee()->for($employee->entity)->create();
+    $this->actingAs($employee->user);
+
+    Livewire::test(Members::class, ['entity' => $employee->entity])
+        ->call('assignRole', $colleague->id, 'admin')
+        ->assertForbidden();
+
+    expect($colleague->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner membership cannot be reassigned by an admin', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->for($owner->entity)->create();
+    $this->actingAs($admin->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $owner->id, 'employee')
+        ->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('a tampered membership id from another entity is refused', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $foreign = EntityMembership::factory()->employee()->create();
+    $this->actingAs($owner->user);
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $foreign->id, 'admin')
+        ->assertForbidden();
+
+    Livewire::test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $foreign->id)
