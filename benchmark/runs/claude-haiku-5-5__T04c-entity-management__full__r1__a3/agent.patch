+use App\Models\Entity;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+
+class UpdateEntity
+{
+    /**
+     * Change the entity's name and slug. Owner only.
+     *
+     * @param  array{name: string, slug: string}  $attributes
+     */
+    public function __invoke(User $actor, Entity $entity, array $attributes): Entity
