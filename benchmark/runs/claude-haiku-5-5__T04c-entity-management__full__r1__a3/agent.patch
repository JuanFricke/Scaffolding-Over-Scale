diff --git a/app/Livewire/Entity/Members.php b/app/Livewire/Entity/Members.php
new file mode 100644
index 0000000..0b21def
--- /dev/null
+++ b/app/Livewire/Entity/Members.php
@@ -0,0 +1,102 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\AddMember;
+use App\Actions\AssignRole;
+use App\Actions\RemoveMember;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|email:strict|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        // Owner and admin manage members, which is the entity `update` ability.
+        $this->authorize('update', $this->entity);
+
+        $validated = $this->validate();
+
+        (new AddMember)(auth()->user(), $this->entity, User::query()->where('email', $validated['email'])->firstOrFail());
+
+        $this->reset('email');
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        $membership = $this->membershipOf($membershipId);
+        $this->authorize('assignRole', $membership);
+
+        $validated = Validator::make(['role' => $role], [
+            'role' => ['required', Rule::in(array_column(UserRole::manageable(), 'value'))],
+        ])->validate();
+
+        (new AssignRole)(auth()->user(), $membership, UserRole::from($validated['role']));
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = $this->membershipOf($membershipId);
+        $this->authorize('delete', $membership);
+
+        $leavingSelf = $membership->user_id === auth()->id();
+
+        (new RemoveMember)(auth()->user(), $membership);
+
+        if ($leavingSelf) {
+            if (session('current_entity_id') === $this->entity->id) {
+                session()->forget('current_entity_id');
+            }
+
+            $this->redirectRoute('home');
+        }
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+            'assignableRoles' => UserRole::manageable(),
+        ]);
+    }
+
+    /**
+     * Resolve a membership id from the client, refusing any row outside this entity.
+     *
+     * @throws AuthorizationException
+     */
+    protected function membershipOf(int $membershipId): EntityMembership
+    {
+        $membership = EntityMembership::query()->find($membershipId);
+
+        if ($membership?->entity_id !== $this->entity->id) {
+            throw new AuthorizationException;
+        }
+
+        return $membership;
+    }
+}
diff --git a/app/Livewire/Entity/Settings.php b/app/Livewire/Entity/Settings.php
