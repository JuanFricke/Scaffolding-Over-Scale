diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..b851c9f
--- /dev/null
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -0,0 +1,95 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+const WEBHOOK = 'https://discord.com/api/webhooks/123456/SECRET-WEBHOOK-TOKEN';
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => WEBHOOK]);
+});
+
+test('it is a silent no-op without a webhook url', function (?string $url) {
+    config(['services.discord.webhook_url' => $url]);
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertNothingSent();
+})->with([null, '']);
+
+test('it posts title, message and context lines as json content', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('Job failed', 'Retries exhausted', ['entity_id' => 42, 'queue' => 'asaas-webhooks']);
+
+    Http::assertSent(fn (Request $request) => $request->method() === 'POST'
+        && $request->url() === WEBHOOK
+        && $request->data() === ['content' => "Job failed\nRetries exhausted\nentity_id=42\nqueue=asaas-webhooks"]);
+});
+
+test('it truncates the text to 1800 multibyte characters', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', str_repeat('é', 5000));
+
+    Http::assertSent(fn (Request $request) => mb_strlen($request->data()['content']) === 1800);
+});
+
+test('it redacts sensitive keys, bearer values and nested arrays', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', 'M', [
+        'Password' => 'hunter2',
+        'asaas_access_token' => 'tok',
+        'X-Api-Key' => 'k',
+        'webhook_url' => 'https://discord.com/api/webhooks/1/x',
+        'note' => 'Authorization failed with Bearer abc.def',
+        'queue' => 'asaas-webhooks',
+        'nested' => ['secret' => 's3', 'ok' => 'visible', 'deep' => ['header' => 'bearer zzz']],
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request->data()['content'];
+
+        return str_contains($content, 'Password=[redacted]')
+            && str_contains($content, 'asaas_access_token=[redacted]')
+            && str_contains($content, 'X-Api-Key=[redacted]')
+            && str_contains($content, 'webhook_url=[redacted]')
+            && str_contains($content, 'note=[redacted]')
+            && str_contains($content, 'queue=asaas-webhooks')
+            && str_contains($content, 'nested={"secret":"[redacted]","ok":"visible","deep":{"header":"[redacted]"}}')
+            && ! preg_match('/hunter2|abc\.def|s3|zzz/', $content);
+    });
+});
+
+test('it logs an error without the webhook url on non-2xx and does not throw', function () {
+    Http::fake(['*' => Http::response('nope', 500)]);
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function (string $message, array $context = []) {
+        return $message === 'Discord ops alert failed'
+            && ($context['status'] ?? null) === 500
+            && ! str_contains($message.json_encode($context), 'SECRET-WEBHOOK-TOKEN');
+    });
+});
+
+test('it logs an error with a scrubbed message when the transport throws', function () {
+    Http::fake(fn () => throw new ConnectionException('cURL error 28 for '.WEBHOOK.' timed out'));
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function (string $message, array $context = []) {
+        $logged = $message.json_encode($context);
+
+        return str_contains($logged, 'timed out')
+            && ! str_contains($logged, 'SECRET-WEBHOOK-TOKEN')
+            && ! str_contains($logged, WEBHOOK);
+    });
+});
diff --git a/tests/Feature/LoggingConfigTest.php b/tests/Feature/LoggingConfigTest.php
new file mode 100644
index 0000000..6e89249
--- /dev/null
+++ b/tests/Feature/LoggingConfigTest.php
@@ -0,0 +1,27 @@
+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('daily is the archive channel', function () {
+    expect(config('logging.channels.daily.driver'))->toBe('daily')
+        ->and(config('logging.channels.daily.path'))->toEndWith('logs/laravel.log')
+        ->and((int) config('logging.channels.daily.days'))->toBe(14);
+});
+
+test('audit is a separate daily channel at info level with 90 days retention', function () {
+    expect(config('logging.channels.audit.driver'))->toBe('daily')
+        ->and(config('logging.channels.audit.path'))->toEndWith('logs/audit.log')
+        ->and(config('logging.channels.audit.level'))->toBe('info')
+        ->and((int) config('logging.channels.audit.days'))->toBe(90);
+});
+
+test('audit channel accepts writes', function () {
+    Log::channel('audit')->info('Subscription status changed', ['from' => 'trial', 'to' => 'active']);
+
+    expect(true)->toBeTrue();
+});
+
+test('the stack uses daily and discord is not a log channel', function () {
+    expect(config('logging.channels.stack.channels'))->toContain('daily')->not->toContain('single')
+        ->and(config('logging.channels'))->not->toHaveKey('discord');
+});
