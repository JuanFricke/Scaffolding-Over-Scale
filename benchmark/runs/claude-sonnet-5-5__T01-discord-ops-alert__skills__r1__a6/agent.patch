diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..db1e65c
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,126 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+/**
+ * Sends one human-pageable ops incident to a Discord incoming webhook.
+ *
+ * This is an explicit call, never a Monolog channel (see docs/ops/logging.md).
+ * It is a silent no-op without a configured webhook and never throws.
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const TIMEOUT_SECONDS = 5;
+
+    private const REDACTED = '[redacted]';
+
+    private const SENSITIVE_KEY = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const BEARER_VALUE = '/\bBearer\s+\S+/i';
+
+    /**
+     * Send an alert. Context values are redacted; failures are logged, not thrown.
+     *
+     * @param  array<string, mixed>  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (! is_string($url) || trim($url) === '') {
+            return;
+        }
+
+        try {
+            $response = Http::timeout(self::TIMEOUT_SECONDS)
+                ->post($url, ['content' => $this->format($title, $message, $context)]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (Throwable $e) {
+            Log::error('Discord ops alert failed', [
+                'exception' => $e::class,
+                'message' => $this->scrubUrl($e->getMessage(), $url),
+            ]);
+        }
+    }
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    private function format(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->stringify($this->redact($key, $value));
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH);
+    }
+
+    private function redact(int|string $key, mixed $value): mixed
+    {
+        if (preg_match(self::SENSITIVE_KEY, (string) $key)) {
+            return self::REDACTED;
+        }
+
+        if (is_array($value)) {
+            return array_map(fn ($v) => $v, $this->redactArray($value));
+        }
+
+        if (is_string($value) && preg_match(self::BEARER_VALUE, $value)) {
+            return self::REDACTED;
+        }
+
+        return $value;
+    }
+
+    /**
+     * @param  array<int|string, mixed>  $values
+     * @return array<int|string, mixed>
+     */
+    private function redactArray(array $values): array
+    {
+        $redacted = [];
+
+        foreach ($values as $key => $value) {
+            $redacted[$key] = $this->redact($key, $value);
+        }
+
+        return $redacted;
+    }
+
+    private function stringify(mixed $value): string
+    {
+        return match (true) {
+            is_array($value) => (string) json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_INVALID_UTF8_SUBSTITUTE | JSON_PARTIAL_OUTPUT_ON_ERROR),
+            is_bool($value) => $value ? 'true' : 'false',
+            $value === null => 'null',
+            is_scalar($value) || $value instanceof \Stringable => (string) $value,
+            default => get_debug_type($value),
+        };
+    }
+
+    /**
+     * Remove the webhook URL (and its path, which carries the token) from text.
+     */
+    private function scrubUrl(string $text, string $url): string
+    {
+        $needles = [$url];
+        $path = parse_url($url, PHP_URL_PATH);
+
+        if (is_string($path) && strlen($path) > 1) {
+            $needles[] = $path;
+        }
+
+        return str_replace($needles, self::REDACTED, $text);
+    }
+}
