+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Carbon\CarbonInterface;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->attendant = User::factory()->create();
+    $this->queue = Queue::factory()->create(['is_active' => true]);
+});
+
+function issueWaiting(Queue $queue, int $priority = 0, ?CarbonInterface $issuedAt = null): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'issued_at' => $issuedAt ?? now(),
+    ]);
+}
+
+it('marks the called ticket as called by the attendant', function () {
+    $ticket = issueWaiting($this->queue);
+
+    $called = (new CallNextTicket)($this->queue, $this->attendant);
+
+    expect($called)
+        ->toBeInstanceOf(Ticket::class)
+        ->id->toBe($ticket->id)
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($this->attendant->id)
+        ->called_at->not->toBeNull();
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($this->attendant->id)
+        ->called_at->not->toBeNull();
+});
+
+it('calls higher priority first, then oldest issued_at, and calls each ticket once', function () {
+    $priorityTenOld = issueWaiting($this->queue, 10, now()->subMinutes(5));
+    $highRecent = issueWaiting($this->queue, 20, now()->subMinutes(1));
+    $highOld = issueWaiting($this->queue, 20, now()->subMinutes(3));
+
+    $calls = [];
+    foreach ([1, 2, 3] as $_) {
+        $calls[] = (new CallNextTicket)($this->queue, $this->attendant)->id;
+    }
+
+    expect($calls)->toBe([$highOld->id, $highRecent->id, $priorityTenOld->id]);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('breaks ties on equal priority and issued_at by lowest id', function () {
+    $issuedAt = now()->subMinute();
+    $first = issueWaiting($this->queue, 10, $issuedAt);
+    $second = issueWaiting($this->queue, 10, $issuedAt);
+
+    expect((new CallNextTicket)($this->queue, $this->attendant)->id)->toBe($first->id)
+        ->and((new CallNextTicket)($this->queue, $this->attendant)->id)->toBe($second->id);
+});
+
+it('calls the oldest normal ticket when no priority ticket is waiting', function () {
+    $recent = issueWaiting($this->queue, 0, now()->subMinute());
+    $oldest = issueWaiting($this->queue, 0, now()->subMinutes(5));
+
+    expect((new CallNextTicket)($this->queue, $this->attendant)->id)->toBe($oldest->id)
+        ->and((new CallNextTicket)($this->queue, $this->attendant)->id)->toBe($recent->id);
+});
+
+it('only calls tickets of the given queue', function () {
+    $otherQueue = Queue::factory()->create(['is_active' => true]);
+    $foreign = issueWaiting($otherQueue, 20, now()->subHour());
+    $own = issueWaiting($this->queue);
+
+    expect((new CallNextTicket)($this->queue, $this->attendant)->id)->toBe($own->id)
+        ->and($foreign->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('never calls a ticket that is already called', function () {
+    Ticket::factory()->forQueue($this->queue)->create([
+        'priority' => 20,
+        'issued_at' => now()->subHour(),
+        'status' => TicketStatus::Called,
+        'called_at' => now()->subMinutes(30),
+        'called_by_user_id' => $this->attendant->id,
+    ]);
+    $waiting = issueWaiting($this->queue);
+
+    expect((new CallNextTicket)($this->queue, $this->attendant)->id)->toBe($waiting->id);
+});
+
+it('restricts to normal tickets after three consecutive priority calls', function () {
+    $normal = issueWaiting($this->queue, 0, now()->subMinutes(10));
+    $priority = [
+        issueWaiting($this->queue, 10, now()->subMinutes(6)),
+        issueWaiting($this->queue, 10, now()->subMinutes(5)),
+        issueWaiting($this->queue, 10, now()->subMinutes(4)),
+        issueWaiting($this->queue, 10, now()->subMinutes(3)),
+    ];
+
+    $calls = [];
+    foreach (range(1, 4) as $_) {
+        $calls[] = (new CallNextTicket)($this->queue, $this->attendant)->id;
+    }
+
+    expect($calls)->toBe([$priority[0]->id, $priority[1]->id, $priority[2]->id, $normal->id]);
+});
+
+it('keeps calling priority tickets when no normal ticket is waiting', function () {
+    $priority = [
+        issueWaiting($this->queue, 10, now()->subMinutes(4)),
+        issueWaiting($this->queue, 10, now()->subMinutes(3)),
+        issueWaiting($this->queue, 10, now()->subMinutes(2)),
+        issueWaiting($this->queue, 10, now()->subMinutes(1)),
+    ];
+
+    $calls = [];
+    foreach (range(1, 4) as $_) {
+        $calls[] = (new CallNextTicket)($this->queue, $this->attendant)->id;
+    }
+
+    expect($calls)->toBe(array_map(fn (Ticket $ticket) => $ticket->id, $priority));
+});
+
+it('lets a normal call reset the priority streak', function () {
+    $normalOld = issueWaiting($this->queue, 0, now()->subMinutes(20));
+    $normalLater = issueWaiting($this->queue, 0, now()->subMinutes(19));
+    $priority = [
+        issueWaiting($this->queue, 10, now()->subMinutes(6)),
+        issueWaiting($this->queue, 10, now()->subMinutes(5)),
+        issueWaiting($this->queue, 10, now()->subMinutes(4)),
+        issueWaiting($this->queue, 10, now()->subMinutes(3)),
+        issueWaiting($this->queue, 10, now()->subMinutes(2)),
+        issueWaiting($this->queue, 10, now()->subMinutes(1)),
+    ];
+
+    // called_at has second precision; separate the calls so the streak order is by call time.
+    $calls = [];
+    foreach (range(1, 8) as $_) {
+        $this->travel(1)->seconds();
+        $calls[] = (new CallNextTicket)($this->queue, $this->attendant)->id;
+    }
+
+    expect($calls)->toBe([
+        $priority[0]->id,
+        $priority[1]->id,
+        $priority[2]->id,
+        $normalOld->id,
+        $priority[3]->id,
+        $priority[4]->id,
+        $priority[5]->id,
+        $normalLater->id,
+    ]);
+});
+
+it('counts priority_only calls towards the fairness streak', function () {
+    $normal = issueWaiting($this->queue, 0, now()->subMinutes(10));
+    $priority = [
+        issueWaiting($this->queue, 10, now()->subMinutes(6)),
+        issueWaiting($this->queue, 10, now()->subMinutes(5)),
+        issueWaiting($this->queue, 10, now()->subMinutes(4)),
+    ];
+
+    foreach (range(1, 3) as $_) {
+        (new CallNextTicket)($this->queue, $this->attendant, CallMode::PriorityOnly);
+    }
+
+    expect((new CallNextTicket)($this->queue, $this->attendant)->id)->toBe($normal->id)
+        ->and($priority[2]->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+it('priority_only calls only priority tickets and ignores the fairness rule', function () {
+    $normal = issueWaiting($this->queue, 0, now()->subMinutes(10));
+    $priority = [
+        issueWaiting($this->queue, 10, now()->subMinutes(4)),
+        issueWaiting($this->queue, 10, now()->subMinutes(3)),
+        issueWaiting($this->queue, 10, now()->subMinutes(2)),
+        issueWaiting($this->queue, 10, now()->subMinutes(1)),
+    ];
+
+    $calls = [];
+    foreach (range(1, 4) as $_) {
+        $calls[] = (new CallNextTicket)($this->queue, $this->attendant, CallMode::PriorityOnly)->id;
+    }
+
+    expect($calls)->toBe(array_map(fn (Ticket $ticket) => $ticket->id, $priority))
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('normal_only calls only normal tickets, oldest first', function () {
+    $priority = issueWaiting($this->queue, 10, now()->subHour());
+    $newer = issueWaiting($this->queue, 0, now()->subMinute());
+    $older = issueWaiting($this->queue, 0, now()->subMinutes(5));
+
+    expect((new CallNextTicket)($this->queue, $this->attendant, CallMode::NormalOnly)->id)->toBe($older->id)
+        ->and((new CallNextTicket)($this->queue, $this->attendant, CallMode::NormalOnly)->id)->toBe($newer->id)
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->attendant, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('throws when no ticket is eligible for the requested mode and changes nothing', function (CallMode $mode, ?int $waitingPriority) {
+    if ($waitingPriority !== null) {
+        issueWaiting($this->queue, $waitingPriority);
+    }
+    $waitingBefore = Ticket::query()->where('status', TicketStatus::Waiting)->count();
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->attendant, $mode))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect(Ticket::query()->where('status', TicketStatus::Waiting)->count())->toBe($waitingBefore)
+        ->and(Ticket::query()->where('status', TicketStatus::Called)->count())->toBe(0);
+})->with([
+    'empty queue' => [CallMode::Any, null],
+    'only normal tickets in priority_only' => [CallMode::PriorityOnly, 0],
+    'only priority tickets in normal_only' => [CallMode::NormalOnly, 10],
+]);
+
+it('rejects calling from an inactive queue and changes nothing', function () {
+    $ticket = issueWaiting($this->queue);
+    Queue::query()->whereKey($this->queue->id)->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Waiting)
+        ->called_by_user_id->toBeNull()
+        ->called_at->toBeNull();
+});
+
+it('skips a ticket called concurrently after it was selected', function () {
+    $first = issueWaiting($this->queue, 0, now()->subMinutes(5));
+    $second = issueWaiting($this->queue, 0, now()->subMinutes(4));
+    $raider = User::factory()->create();
+    $raced = false;
+
+    // Simulates another attendant's Ticket::call() committing between the
+    // candidate pick and the row lock of $first. Fires once, on the lock read.
+    DB::beforeExecuting(function (string $sql) use (&$raced, $first, $raider): void {
+        if ($raced || ! str_contains($sql, 'from "tickets"') || ! preg_match('/"id" = \?/', $sql)) {
+            return;
+        }
+
+        $raced = true;
+        DB::table('tickets')->where('id', $first->id)->update([
+            'status' => TicketStatus::Called->value,
+            'called_at' => now(),
+            'called_by_user_id' => $raider->id,
+        ]);
+    });
+
+    $called = (new CallNextTicket)($this->queue, $this->attendant);
+
