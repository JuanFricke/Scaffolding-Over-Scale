+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * A normal ticket may not wait behind more than this many consecutive priority calls.
+     */
+    private const FAIRNESS_STREAK = 3;
+
+    /**
+     * Call the next eligible waiting ticket of the queue, exactly once.
+     *
+     * Ordering: higher priority first, then oldest issued_at, then lowest id.
+     * In CallMode::Any the fairness rule restricts the call to normal tickets
+     * after FAIRNESS_STREAK consecutive priority calls (when one is waiting).
+     *
+     * @throws InactiveQueueException when the queue is inactive (nothing is changed)
+     * @throws NoWaitingTicketsException when no ticket is eligible for $mode
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Queue-row lock serializes calls on the queue and against deactivation.
+            // Ticket::call() does not take this lock, so each candidate is locked and
+            // re-checked before it is marked called.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $skippedIds = [];
+
+            while (($candidate = $this->nextCandidate($lockedQueue->id, $mode, $skippedIds)) !== null) {
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket?->status === TicketStatus::Waiting) {
+                    // Only status and the call fields change; the Ticket model enforces write-once.
+                    $ticket->status = TicketStatus::Called;
+                    $ticket->called_at = now();
+                    $ticket->called_by_user_id = $calledBy->id;
+                    $ticket->save();
+
+                    return $ticket;
+                }
+
+                // Called concurrently after it was selected: a stale snapshot may still list it.
+                $skippedIds[] = $candidate->id;
+            }
+
+            throw new NoWaitingTicketsException('No waiting ticket is eligible for this call.');
+        });
+    }
+
+    /**
+     * Next waiting ticket eligible for $mode, skipping $skippedIds, or null.
+     *
+     * @param  list<int>  $skippedIds
+     */
+    private function nextCandidate(int $queueId, CallMode $mode, array $skippedIds): ?Ticket
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->whereNotIn('id', $skippedIds)
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+
+        if ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0);
+        } elseif ($mode === CallMode::NormalOnly || $this->fairnessRequiresNormal($queueId)) {
+            $query->where('priority', 0);
+        }
+
+        return $query->first();
+    }
+
+    /**
+     * True when the last FAIRNESS_STREAK calls in the queue were all priority tickets
+     * and a normal ticket is waiting. Calls in every mode count towards the streak.
+     */
+    private function fairnessRequiresNormal(int $queueId): bool
+    {
+        $lastCalls = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::FAIRNESS_STREAK)
+            ->get(['priority']);
+
+        if ($lastCalls->count() < self::FAIRNESS_STREAK
+            || ! $lastCalls->every(fn (Ticket $ticket): bool => $ticket->priority > 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
