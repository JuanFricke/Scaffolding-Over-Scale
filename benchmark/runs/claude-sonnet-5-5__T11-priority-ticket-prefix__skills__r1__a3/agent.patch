+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+afterEach(fn () => $this->travelBack());
+
+it('maps default prefixes by exact level and by range', function (int $priority, string $prefix) {
+    expect(Queue::defaultPrefixFor($priority))->toBe($prefix)
+        ->and(Queue::factory()->create()->prefixForPriority($priority))->toBe($prefix);
+})->with([
+    [-5, 'N'], [0, 'N'], [1, 'P'], [5, 'P'], [10, 'P'], [19, 'P'], [20, 'E'], [80, 'E'],
+]);
+
+it('prefers the custom map and falls back to the default', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '10' => 'Y']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y'])
+        ->and($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('E')
+        ->and($queue->prefixForPriority(5))->toBe('P');
+});
+
+it('stores an empty map as null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+
+    $queue->priority_prefix_map = [];
+    $queue->save();
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects invalid maps on save', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+})->with([
+    'non numeric key' => [['foo' => 'X']],
+    'negative key' => [['-1' => 'X']],
+    'non canonical key' => [['010' => 'X']],
+    'multi letter' => [['0' => 'xx']],
+    'lowercase' => [['0' => 'x']],
+    'non string' => [['0' => 1]],
+    'duplicate custom' => [['0' => 'N', '10' => 'N']],
+    'merges normal with 80+' => [['0' => 'E']],
+    'collides with uncovered default' => [['5' => 'P']],
+]);
+
+it('accepts swapping prefixes between levels', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'P', '10' => 'N']]);
+
+    expect($queue->prefixForPriority(0))->toBe('P')
+        ->and($queue->prefixForPriority(10))->toBe('N');
+});
+
+it('keeps the map out of mass assignment', function () {
+    $queue = new Queue(['name' => 'x', 'priority_prefix_map' => ['0' => 'X']]);
+
+    expect($queue->priority_prefix_map)->toBeNull();
+});
+
+it('sequences prefixes independently', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    $codes = [
+        $issue($queue, 0)->code,
+        $issue($queue, 0)->code,
+        $issue($queue, 10)->code,
+        $issue($queue, 20)->code,
+        $issue($queue, 10)->code,
+    ];
+
+    expect($codes)->toBe(['N001', 'N002', 'P001', 'E001', 'P002']);
+});
+
+it('issues with the custom prefixes', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z']]);
+
+    expect((new IssueTicket)($queue, 0)->code)->toBe('X001')
+        ->and((new IssueTicket)($queue, 10)->code)->toBe('Y001')
+        ->and((new IssueTicket)($queue, 20)->code)->toBe('Z001');
+});
+
+it('restarts each prefix every day and stores issue_date from one clock read', function () {
+    $queue = Queue::factory()->create();
+
+    $this->travelTo(now()->startOfDay()->setTime(23, 59, 59));
+    $first = (new IssueTicket)($queue, 10);
+    $second = (new IssueTicket)($queue, 10);
+
+    $this->travelTo(now()->addSecond());
+    $next = (new IssueTicket)($queue, 10);
+
+    expect($first->code)->toBe('P001')
+        ->and($second->code)->toBe('P002')
+        ->and($next->code)->toBe('P001')
+        ->and($next->issue_date->toDateString())->toBe($next->issued_at->toDateString())
+        ->and($next->issue_date->toDateString())->not->toBe($first->issue_date->toDateString())
+        ->and($first->issue_date->toDateString())->toBe($first->issued_at->toDateString());
+});
+
+it('does not count legacy or malformed codes in the sequence', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+    expect(Ticket::nextCode($queue->id))->toBe('N001');
+
+    Ticket::factory()->for($queue)->create(['code' => 'N001']);
+    Ticket::factory()->for($queue)->create(['code' => 'N-X']);
+    expect(Ticket::nextCode($queue->id))->toBe('N002');
+});
+
+it('scopes the factory code to the priority and the issued day', function () {
+    $queue = Queue::factory()->create();
+
+    $today = Ticket::factory()->forQueue($queue)->create();
+    $old = Ticket::factory()->forQueue($queue)->create(['issued_at' => '2026-09-28 10:00:00']);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+    $explicit = Ticket::factory()->forQueue($queue)->create(['code' => 'Q123']);
+
+    expect($today->code)->toBe('N001')
+        ->and($old->code)->toBe('N001')
+        ->and($old->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($priority->code)->toBe('P001')
+        ->and($explicit->code)->toBe('Q123')
+        ->and($today->issue_date->toDateString())->toBe(now()->toDateString());
+});
+
+function prefixOwner(Queue $queue): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for(Entity::query()->findOrFail($queue->entity_id))->for($user)->owner()->create();
+
+    return $user;
+}
+
+it('updates, keeps and clears the map through UpdateQueue', function () {
+    $queue = Queue::factory()->create();
+    $owner = prefixOwner($queue);
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X']);
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+
+    (new UpdateQueue)($queue, $owner, name: 'Renamed');
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: []);
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects an invalid map in UpdateQueue and leaves the queue unchanged', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+    $owner = prefixOwner($queue);
+
+    try {
+        (new UpdateQueue)($queue, $owner, name: 'Renamed', priorityPrefixMap: ['0' => 'N', '10' => 'N']);
+        $this->fail('Expected ValidationException');
+    } catch (ValidationException $e) {
+        expect($e->errors())->toHaveKey('priority_prefix_map');
+    }
+
+    $fresh = $queue->fresh();
+    expect($fresh->priority_prefix_map)->toBe([0 => 'X'])
+        ->and($fresh->name)->toBe($queue->name);
+});
+
+it('does not let a non-member change the map', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new UpdateQueue)($queue, User::factory()->create(), priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
