     /** @use HasFactory<QueueFactory> */
     use HasFactory;
 
+    /**
+     * Default ticket-code letter per priority level (Normal, Priority, 80+).
+     *
+     * @var array<int, string>
+     */
+    public const DEFAULT_PREFIX_MAP = [0 => 'N', 10 => 'P', 20 => 'E'];
+
+    /**
+     * Default letter for a priority: the exact level, else by range
+     * (<= 0 Normal, >= 20 80+, anything in between Priority).
+     */
+    public static function defaultPrefixFor(int $priority): string
+    {
+        return self::DEFAULT_PREFIX_MAP[$priority] ?? match (true) {
+            $priority <= 0 => self::DEFAULT_PREFIX_MAP[0],
+            $priority >= 20 => self::DEFAULT_PREFIX_MAP[20],
+            default => self::DEFAULT_PREFIX_MAP[10],
+        };
+    }
+
+    /**
+     * Validate a priority -> letter map: canonical non-negative integer keys,
+     * single uppercase letter values, and unique effective prefixes (custom
+     * entries plus the default for the uncovered levels 0/10/20).
+     *
+     * @param  array<array-key, mixed>  $map
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function assertValidPrefixMap(array $map): void
+    {
+        foreach ($map as $priority => $letter) {
+            if (! preg_match('/^(0|[1-9]\d*)$/', (string) $priority)) {
+                throw new InvalidArgumentException("Invalid priority key [{$priority}]: use a non-negative integer.");
+            }
+
+            if (! is_string($letter) || ! preg_match('/^[A-Z]$/', $letter)) {
+                throw new InvalidArgumentException("Invalid prefix for priority [{$priority}]: use exactly one letter A-Z.");
+            }
+        }
+
+        $effective = array_values($map);
+
+        foreach (self::DEFAULT_PREFIX_MAP as $level => $letter) {
+            if (! array_key_exists($level, $map)) {
+                $effective[] = $letter;
+            }
+        }
+
+        if (count($effective) !== count(array_unique($effective))) {
+            throw new InvalidArgumentException('Priority prefixes must be unique per queue.');
+        }
+    }
+
+    protected static function booted(): void
+    {
+        static::saving(function (Queue $queue): void {
+            $map = $queue->priority_prefix_map;
+
+            if ($map === null || $map === []) {
+                $queue->priority_prefix_map = null;
+
+                return;
+            }
+
+            if (! is_array($map)) {
+                throw new InvalidArgumentException('Priority prefix map must be an array.');
+            }
+
+            self::assertValidPrefixMap($map);
+        });
+    }
+
+    /**
+     * Ticket-code letter for a priority: this queue's custom entry, else the default.
+     */
+    public function prefixForPriority(int $priority): string
+    {
+        $map = $this->priority_prefix_map;
+
+        return is_array($map) && isset($map[$priority])
+            ? (string) $map[$priority]
+            : self::defaultPrefixFor($priority);
+    }
+
