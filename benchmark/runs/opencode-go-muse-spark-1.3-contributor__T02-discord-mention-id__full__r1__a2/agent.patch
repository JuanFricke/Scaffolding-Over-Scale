+test('appends a user mention on its own line when a valid mention id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n<@123456789012345678>");
+    });
+});
+
+test('omits the mention when mention id is null or empty', function (?string $mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $mentionId]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '', '   ']);
