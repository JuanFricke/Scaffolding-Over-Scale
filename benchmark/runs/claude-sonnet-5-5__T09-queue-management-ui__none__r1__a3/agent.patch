+++ b/tests/Feature/Entity/QueuesPageTest.php
@@ -0,0 +1,185 @@
+<?php
+
+use App\Livewire\Entity\Queues;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function queuesSetup(string $role = 'owner'): array
+{
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($user)->{$role}()->create();
+    test()->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    return [$user, $entity, $membership];
+}
+
+test('employees get 403 on the queues page and component', function () {
+    [, $entity] = queuesSetup('employee');
+
+    $this->get(route('entity.queues', $entity->slug))->assertForbidden();
+    Livewire::test(Queues::class, ['entity' => $entity])->assertForbidden();
+});
+
+test('manager sees the list with only row buttons while no modal is open', function () {
+    [, $entity] = queuesSetup('admin');
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Caixa']);
+
+    $this->get(route('entity.queues', $entity->slug))->assertOk();
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->assertSee('Caixa')
+        ->assertSeeHtml('wire:click="openQueue('.$queue->id.')"')
+        ->assertDontSeeHtml('startRename')
+        ->assertDontSeeHtml('toggleActive')
+        ->assertDontSeeHtml('openAccess');
+});
+
+test('create derives the slug and reports domain errors on name', function () {
+    [, $entity] = queuesSetup();
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openCreate')
+        ->assertSet('creating', true)
+        ->set('name', 'Atendimento Geral')
+        ->call('create')
+        ->assertHasNoErrors()
+        ->assertSet('name', '')
+        ->assertSet('creating', false)
+        ->call('openCreate')
+        ->set('name', 'atendimento geral')
+        ->call('create')
+        ->assertHasErrors('name')
+        ->assertSet('creating', true);
+
+    expect($entity->queues()->pluck('slug')->all())->toBe(['atendimento-geral']);
+});
+
+test('rename re-derives the slug and collisions error on renameName', function () {
+    [, $entity] = queuesSetup();
+    $old = Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old']);
+    Queue::factory()->for($entity)->create(['name' => 'Taken', 'slug' => 'taken']);
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $old->id)
+        ->assertSet('viewingQueueId', $old->id)
+        ->call('startRename', $old->id)
+        ->assertSet('renameName', 'Old')
+        ->set('renameName', 'Taken')
+        ->call('rename')
+        ->assertHasErrors('renameName')
+        ->set('renameName', 'New')
+        ->call('rename')
+        ->assertHasNoErrors();
+
+    expect($old->fresh())->name->toBe('New')->slug->toBe('new');
+});
+
+test('toggling goes through a confirmation modal', function () {
+    [, $entity] = queuesSetup();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Caixa']);
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->assertSee(__('ui.queues_details'))
+        ->call('confirmToggle')
+        ->assertSet('confirmingToggle', true)
+        ->assertSee(__('ui.queues_toggle_title'))
+        ->assertDontSeeHtml('wire:confirm')
+        ->call('cancelToggle')
+        ->assertSet('confirmingToggle', false)
+        ->call('confirmToggle')
+        ->call('toggleActive', $queue->id)
+        ->assertSet('confirmingToggle', false);
+
+    expect($queue->fresh()->is_active)->toBeFalse();
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('toggleActive', $queue->id);
+
+    expect($queue->fresh()->is_active)->toBeTrue();
+});
+
+test('closing the detail modal resets nested state', function () {
+    [, $entity] = queuesSetup();
+    $queue = Queue::factory()->for($entity)->create();
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('startRename', $queue->id)
+        ->call('confirmToggle')
+        ->call('openAccess', $queue->id)
+        ->call('closeQueue')
+        ->assertSet('viewingQueueId', null)
+        ->assertSet('editingQueueId', null)
+        ->assertSet('confirmingToggle', false)
+        ->assertSet('managingAccess', false)
+        ->assertSet('accessQueueId', null);
+});
+
+test('access modal grants and revokes call access with an audit trail', function () {
+    [, $entity, $owner] = queuesSetup();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = EntityMembership::factory()->for($entity)->employee()->create();
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openAccess', $queue->id)
+        ->assertSet('managingAccess', true)
+        ->assertSet('accessQueueId', $queue->id)
+        ->assertSee($employee->user->name)
+        ->call('grantAccess', $employee->id);
+
+    expect(QueueAccess::where('queue_id', $queue->id)->where('entity_membership_id', $employee->id)->exists())->toBeTrue();
+
+    $component->call('revokeAccess', $employee->id);
+
+    expect(QueueAccess::count())->toBe(0);
+});
+
+test('foreign ids are not found and change nothing', function () {
+    [, $entity] = queuesSetup();
+    $foreignQueue = Queue::factory()->create(['name' => 'Foreign']);
+    $foreignMembership = EntityMembership::factory()->for($foreignQueue->entity)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    foreach (['openQueue', 'startRename', 'toggleActive', 'openAccess'] as $method) {
+        expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])->call($method, $foreignQueue->id))
+            ->toThrow(ModelNotFoundException::class);
+    }
+
+    expect(fn () => Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openAccess', $queue->id)
+        ->call('grantAccess', $foreignMembership->id))->toThrow(ModelNotFoundException::class);
+
+    expect($foreignQueue->fresh()->is_active)->toBeTrue()->and(QueueAccess::count())->toBe(0);
+});
+
+test('a tampered accessQueueId discloses nothing', function () {
+    [, $entity] = queuesSetup();
+    $foreignQueue = Queue::factory()->create(['name' => 'Foreign']);
+    EntityMembership::factory()->for($foreignQueue->entity)->employee()->create();
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('accessQueueId', $foreignQueue->id)
+        ->set('managingAccess', true)
+        ->assertViewHas('accessQueue', null)
+        ->assertViewHas('accessGrants', fn ($grants) => $grants->isEmpty())
+        ->assertDontSee('Foreign');
+});
+
+test('queues page renders in english', function () {
+    [, $entity] = queuesSetup();
+    app()->setLocale('en');
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->assertSee('Queues of '.$entity->name)
+        ->assertSee('Create queue');
+});
diff --git a/tests/Feature/Entity/ServePanelTest.php b/tests/Feature/Entity/ServePanelTest.php
new file mode 100644
index 0000000..42dc012
--- /dev/null
+++ b/tests/Feature/Entity/ServePanelTest.php
@@ -0,0 +1,135 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function serveSetup(string $role = 'owner'): array
+{
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($user)->{$role}()->create();
+    test()->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    return [$user, $entity, $membership];
+}
+
+test('non-members cannot open the serve panel', function () {
+    $entity = Entity::factory()->create();
+    $this->actingAs(User::factory()->create());
+
+    Livewire::test(Serve::class, ['entity' => $entity])->assertForbidden();
+});
+
+test('mount defaults to the first callable queue', function () {
+    [, $entity] = serveSetup();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'A']);
+    Queue::factory()->for($entity)->create(['name' => 'B']);
+    Queue::factory()->for($entity)->create(['name' => '0', 'is_active' => false]);
+
+    $this->get(route('entity.serve', $entity->slug))->assertOk();
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $queue->id)
+        ->assertSet('mode', 'any');
+});
+
+test('employees only see queues with a call grant', function () {
+    [, $entity, $membership] = serveSetup('employee');
+    $granted = Queue::factory()->for($entity)->create(['name' => 'Granted']);
+    $other = Queue::factory()->for($entity)->create(['name' => 'Other']);
+    QueueAccess::factory()->create(['entity_membership_id' => $membership->id, 'queue_id' => $granted->id]);
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $granted->id)
+        ->assertViewHas('queues', fn ($queues) => $queues->pluck('id')->all() === [$granted->id])
+        ->set('selectedQueueId', $other->id)
+        ->assertViewHas('tickets', fn ($tickets) => $tickets->isEmpty())
+        ->assertSee(__('ui.serve_empty'))
+        ->call('callNext')
+        ->assertForbidden();
+});
+
+test('waiting list is in call order and honours mode', function () {
+    [, $entity] = serveSetup();
+    $queue = Queue::factory()->for($entity)->create();
+    $normal = Ticket::factory()->forQueue($queue)->create(['issued_at' => now()->subMinutes(5)]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 2]);
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertViewHas('tickets', fn ($t) => $t->pluck('id')->all() === [$priority->id, $normal->id])
+        ->set('mode', 'normal_only')
+        ->assertViewHas('tickets', fn ($t) => $t->pluck('id')->all() === [$normal->id])
+        ->set('mode', 'priority_only')
+        ->assertViewHas('tickets', fn ($t) => $t->pluck('id')->all() === [$priority->id]);
+});
+
+test('callNext calls the next ticket and reports it', function () {
+    [$user, $entity] = serveSetup();
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->call('callNext')
+        ->assertSet('lastCalledTicketId', $ticket->id)
+        ->assertSet('notice', __('ui.serve_last_called', ['code' => $ticket->code]))
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_empty'));
+
+    expect($ticket->fresh())->status->toBe(TicketStatus::Called)->called_by_user_id->toBe($user->id);
+});
+
+test('callNext handles no selection and inactive queues', function () {
+    [, $entity] = serveSetup();
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('notice', __('ui.serve_empty'));
+
+    $queue = Queue::factory()->for($entity)->create();
+    $component = Livewire::test(Serve::class, ['entity' => $entity]);
+    $queue->update(['is_active' => false]);
+    $component->call('callNext')->assertSet('notice', __('ui.serve_inactive'));
+});
+
+test('callNext with a foreign queue is not found and lastCalledTicketId is locked', function () {
+    [, $entity] = serveSetup();
+    $foreign = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($foreign)->create();
+
+    expect(fn () => Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $foreign->id)
+        ->call('callNext'))->toThrow(ModelNotFoundException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+
+    expect(fn () => Livewire::test(Serve::class, ['entity' => $entity])->set('lastCalledTicketId', 5))
+        ->toThrow(Exception::class);
+});
+
+test('successful calls are rate limited per user and entity', function () {
+    [, $entity] = serveSetup();
+    $queue = Queue::factory()->for($entity)->create();
+    foreach (range(1, 11) as $i) {
+        Ticket::factory()->forQueue($queue)->create();
+    }
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity]);
+    foreach (range(1, 10) as $i) {
+        $component->call('callNext');
+    }
+    $component->call('callNext')->assertSet('notice', __('ui.serve_rate_limited'));
+
+    expect(Ticket::where('status', TicketStatus::Waiting)->count())->toBe(1);
+});
