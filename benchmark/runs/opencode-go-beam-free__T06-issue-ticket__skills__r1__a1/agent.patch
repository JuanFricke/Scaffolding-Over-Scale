@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Priority must be greater than or equal to zero.');
+        }
+
+        return DB::transaction(function () use ($queue, $priority, $channel): Ticket {
+            $lockedQueue = Queue::query()->whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Queue is inactive.');
+            }
+
+            $attempts = 0;
+            $maxAttempts = 5;
+
+            while (true) {
+                try {
+                    $code = Ticket::nextCode((int) $lockedQueue->getKey());
+
+                    return Ticket::create([
+                        'queue_id' => $lockedQueue->getKey(),
+                        'code' => $code,
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                } catch (QueryException $exception) {
+                    $attempts++;
+
+                    if ($attempts >= $maxAttempts || ! $this->isUniqueViolation($exception)) {
+                        throw $exception;
+                    }
+                }
+            }
+        });
+    }
+
+    private function isUniqueViolation(QueryException $exception): bool
+    {
+        $sqlState = $exception->errorInfo[0] ?? null;
+
+        return in_array($sqlState, ['23000', '23505'], true);
+    }
+}
