+/**
+ * A user who is an admin of the entity: may manage its queues and call tickets.
+ */
+function managerOf(Entity $entity): User
+{
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->for($entity)->for($user)->admin()->create();
+
+    return $user;
+}
+
+/**
+ * A user who is an employee of the entity, with no queue access grants yet.
+ */
+function employeeOf(Entity $entity): User
+{
+    $user = User::factory()->create();
+
+    EntityMembership::factory()->for($entity)->for($user)->employee()->create();
+
+    return $user;
+}
