+++ b/tests/Feature/Queue/UpdateQueueTest.php
@@ -0,0 +1,164 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('renames a queue and keeps its slug', function () {
+    $queue = Queue::factory()->create(['name' => 'Caixa', 'slug' => 'caixa']);
+
+    $updated = (new UpdateQueue)($queue, managerOf($queue->entity), name: '  Guichê 2  ');
+
+    expect($updated->name)->toBe('Guichê 2')
+        ->and($updated->slug)->toBe('caixa')
+        ->and($queue->fresh()->name)->toBe('Guichê 2');
+});
+
+it('changes the slug, slugified', function () {
+    $queue = Queue::factory()->create(['slug' => 'caixa']);
+
+    $updated = (new UpdateQueue)($queue, managerOf($queue->entity), slug: 'Caixa Rápida');
+
+    expect($updated->slug)->toBe('caixa-rapida')
+        ->and($queue->fresh()->slug)->toBe('caixa-rapida');
+});
+
+it('deactivates and reactivates a queue', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $manager = managerOf($queue->entity);
+
+    (new UpdateQueue)($queue, $manager, isActive: false);
+    expect($queue->fresh()->is_active)->toBeFalse();
+
+    (new UpdateQueue)($queue, $manager, isActive: true);
+    expect($queue->fresh()->is_active)->toBeTrue();
+});
+
+it('leaves everything unchanged when no parameter is given', function () {
+    $queue = Queue::factory()->create(['name' => 'Caixa', 'slug' => 'caixa', 'is_active' => true]);
+
+    (new UpdateQueue)($queue, managerOf($queue->entity));
+
+    expect($queue->fresh())
+        ->name->toBe('Caixa')
+        ->slug->toBe('caixa')
+        ->is_active->toBeTrue();
+});
+
+it('keeps the queue own slug without a conflict', function () {
+    $queue = Queue::factory()->create(['slug' => 'caixa']);
+
+    $updated = (new UpdateQueue)($queue, managerOf($queue->entity), slug: 'caixa');
+
+    expect($updated->slug)->toBe('caixa');
+});
+
+it('rejects taking the slug of another queue in the same entity', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->create(['slug' => 'caixa']);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'guiche']);
+
+    expect(fn () => (new UpdateQueue)($queue, managerOf($entity), slug: 'caixa'))
+        ->toThrow(function (ValidationException $e) {
+            expect($e->errors())->toHaveKey('slug');
+        });
+
+    expect($queue->fresh()->slug)->toBe('guiche');
+});
+
+it('allows taking a slug used by a queue in another entity', function () {
+    $queue = Queue::factory()->create(['slug' => 'guiche']);
+    Queue::factory()->create(['slug' => 'caixa']);
+
+    $updated = (new UpdateQueue)($queue, managerOf($queue->entity), slug: 'caixa');
+
+    expect($updated->slug)->toBe('caixa');
+});
+
+it('turns a slug unique-index race into a ValidationException', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'guiche']);
+    $rival = Queue::factory()->for($entity)->create(['slug' => 'rival']);
+
+    // The rival takes the target slug between the uniqueness check and the UPDATE.
+    $raced = false;
+    Queue::updating(function () use ($rival, &$raced): void {
+        if ($raced) {
+            return;
+        }
+        $raced = true;
+        DB::table('queues')->where('id', $rival->id)->update(['slug' => 'caixa']);
+    });
+
+    try {
+        expect(fn () => (new UpdateQueue)($queue, managerOf($entity), slug: 'caixa'))
+            ->toThrow(function (ValidationException $e) {
+                expect($e->errors())->toHaveKey('slug');
+            });
+    } finally {
+        Queue::flushEventListeners();
+    }
+
+    expect($raced)->toBeTrue();
+});
+
+it('rejects a name that is empty after trimming or longer than 255 characters', function (string $name) {
+    $queue = Queue::factory()->create(['name' => 'Caixa']);
+
+    expect(fn () => (new UpdateQueue)($queue, managerOf($queue->entity), name: $name))
+        ->toThrow(function (ValidationException $e) {
+            expect($e->errors())->toHaveKey('name');
+        });
+
+    expect($queue->fresh()->name)->toBe('Caixa');
+})->with(['', '   ', str_repeat('a', 256)]);
+
+it('keeps tickets and blocks issuing and calling once a queue is deactivated', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $manager = managerOf($queue->entity);
+    $waiting = (new IssueTicket)($queue);
+
+    (new UpdateQueue)($queue, $manager, isActive: false);
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+    expect(fn () => (new CallNextTicket)($queue, $manager))->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->whereKey($waiting->id)->exists())->toBeTrue()
+        ->and($waiting->fresh()->status->value)->toBe('waiting');
+});
+
+it('rejects an employee, an outsider and a manager of another entity without writing', function (string $who) {
+    $queue = Queue::factory()->create(['name' => 'Caixa', 'slug' => 'caixa', 'is_active' => true]);
+    $actor = match ($who) {
+        'employee' => employeeOf($queue->entity),
+        'outsider' => User::factory()->create(),
+        'other manager' => managerOf(Entity::factory()->create()),
+    };
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'Novo', slug: 'novo', isActive: false))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh())
+        ->name->toBe('Caixa')
+        ->slug->toBe('caixa')
+        ->is_active->toBeTrue();
+})->with(['employee', 'outsider', 'other manager']);
+
+it('exposes no delete ability for queues', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Gate::forUser(managerOf($queue->entity))->allows('delete', $queue))->toBeFalse()
+        ->and(class_exists('App\\Actions\\DeleteQueue'))->toBeFalse();
+});
