@@ -0,0 +1,77 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Set the queue permissions of a membership on a queue. A non-empty list grants
+     * (upserts) them; an empty list revokes the grant.
+     *
+     * @param  list<string>  $permissions
+     *
+     * @throws AuthorizationException when the actor is not an owner or admin of the queue's entity
+     * @throws ValidationException when a permission is unknown or the membership is from another entity
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        Validator::make(['permissions' => $permissions], [
+            'permissions' => ['array', 'list'],
+            'permissions.*' => ['string', Rule::enum(QueuePermission::class)],
+        ])->validate();
+
+        if ((int) $targetMembership->entity_id !== (int) $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => __('validation.exists', ['attribute' => 'entity_membership_id']),
+            ]);
+        }
+
+        $permissions = array_values(array_unique($permissions));
+
+        DB::transaction(function () use ($targetMembership, $queue, $actor, $permissions): void {
+            // Serializes grants and revokes on this queue, so the upsert cannot race another one.
+            Queue::query()->whereKey($queue->id)->lockForUpdate()->firstOrFail();
+
+            $grant = [
+                'entity_membership_id' => $targetMembership->id,
+                'queue_id' => $queue->id,
+            ];
+            $context = [
+                'actor_id' => $actor->id,
+                'queue_id' => $queue->id,
+                'entity_membership_id' => $targetMembership->id,
+            ];
+
+            if ($permissions === []) {
+                if (QueueAccess::query()->where($grant)->delete() > 0) {
+                    Log::channel('audit')->info('queue.access.revoked', $context);
+                }
+
+                return;
+            }
+
+            QueueAccess::query()->updateOrCreate($grant, ['permissions' => $permissions]);
+
+            Log::channel('audit')->info('queue.access.granted', $context);
+        });
+    }
+}
