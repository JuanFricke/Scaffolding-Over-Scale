+++ b/tests/Feature/Queue/QueuePolicyTest.php
@@ -0,0 +1,113 @@
+<?php
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+it('lets owners and admins create queues in their entity only', function (string $role, bool $expected) {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->state(['role' => $role])->create();
+
+    expect(Gate::forUser($user)->allows('create', [Queue::class, $entity]))->toBe($expected)
+        ->and(Gate::forUser($user)->allows('create', [Queue::class, Entity::factory()->create()]))->toBeFalse();
+})->with([
+    ['owner', true],
+    ['admin', true],
+    ['employee', false],
+]);
+
+it('denies queue creation to outsiders', function () {
+    $entity = Entity::factory()->create();
+
+    expect(Gate::forUser(User::factory()->create())->allows('create', [Queue::class, $entity]))->toBeFalse();
+});
+
+it('lets managers update and manage access on queues of their entity only', function (string $ability) {
+    $queue = Queue::factory()->create();
+
+    expect(Gate::forUser(managerOf($queue->entity))->allows($ability, $queue))->toBeTrue()
+        ->and(Gate::forUser(managerOf(Entity::factory()->create()))->allows($ability, $queue))->toBeFalse();
+})->with(['update', 'manageAccess']);
+
+it('denies update and manageAccess to employees, even with a call grant', function (string $ability) {
+    $queue = Queue::factory()->create();
+    $employee = employeeOf($queue->entity);
+    QueueAccess::factory()->forMembership(EntityMembership::query()->where('user_id', $employee->id)->first())
+        ->create(['queue_id' => $queue->id]);
+
+    expect(Gate::forUser($employee)->allows($ability, $queue))->toBeFalse();
+})->with(['update', 'manageAccess']);
+
+it('allows managers to call on any queue of their entity without a grant', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Gate::forUser(managerOf($queue->entity))->allows('call', $queue))->toBeTrue();
+});
+
+it('allows an employee to call only with a call grant on that queue', function () {
+    $queue = Queue::factory()->create();
+    $employee = employeeOf($queue->entity);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->first();
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+
+    QueueAccess::factory()->forMembership($membership)->create(['queue_id' => $queue->id]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('call', Queue::factory()->create(['entity_id' => $queue->entity_id])))
+        ->toBeFalse();
+});
+
+it('denies an employee a call grant whose permissions do not include call', function () {
+    $queue = Queue::factory()->create();
+    $employee = employeeOf($queue->entity);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->first();
+    QueueAccess::factory()->forMembership($membership)->create([
+        'queue_id' => $queue->id,
+        'permissions' => [],
+    ]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+});
+
+it('denies an employee whose stored permissions are not an array', function (string $stored) {
+    $queue = Queue::factory()->create();
+    $employee = employeeOf($queue->entity);
+    $membership = EntityMembership::query()->where('user_id', $employee->id)->first();
+    DB::table('queue_access')->insert([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $queue->id,
+        'permissions' => $stored,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+})->with(['"call"', 'null', 'call']);
+
+it('denies call to outsiders and to managers of another entity', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Gate::forUser(User::factory()->create())->allows('call', $queue))->toBeFalse()
+        ->and(Gate::forUser(managerOf(Entity::factory()->create()))->allows('call', $queue))->toBeFalse();
+});
+
+it('defines no delete ability for queues', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Gate::forUser(managerOf($queue->entity))->allows('delete', $queue))->toBeFalse();
+});
+
+it('uses the only permission the enum defines', function () {
+    expect(QueuePermission::cases())->toHaveCount(1)
+        ->and(QueuePermission::Call->value)->toBe('call');
+});
diff --git a/tests/Feature/Queue/SetQueueAccessTest.php b/tests/Feature/Queue/SetQueueAccessTest.php
new file mode 100644
index 0000000..dcae114
--- /dev/null
+++ b/tests/Feature/Queue/SetQueueAccessTest.php
@@ -0,0 +1,142 @@
+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Mockery\MockInterface;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Capture what is written to the audit channel during the test.
+ */
+function auditChannel(): MockInterface
+{
+    $audit = Mockery::spy();
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+
+    return $audit;
+}
+
+it('grants call on a queue and writes the granted audit entry', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue->entity);
+    $target = EntityMembership::factory()->for($queue->entity)->employee()->create();
+    $audit = auditChannel();
+
+    (new SetQueueAccess)($target, $queue, $manager, ['call']);
+
+    expect(QueueAccess::query()->where([
+        'entity_membership_id' => $target->id,
+        'queue_id' => $queue->id,
+    ])->first()->permissions)->toBe(['call']);
+
+    $audit->shouldHaveReceived('info')->with('queue.access.granted', [
+        'actor_id' => $manager->id,
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $target->id,
+    ])->once();
+});
+
+it('updates the existing grant instead of creating a second row', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue->entity);
+    $target = EntityMembership::factory()->for($queue->entity)->employee()->create();
+
+    (new SetQueueAccess)($target, $queue, $manager, ['call']);
+    (new SetQueueAccess)($target, $queue, $manager, ['call', 'call']);
+
+    expect(QueueAccess::query()->where('queue_id', $queue->id)->count())->toBe(1)
+        ->and(QueueAccess::query()->where('queue_id', $queue->id)->first()->permissions)->toBe(['call']);
+});
+
+it('revokes access with an empty list and writes the revoked audit entry', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue->entity);
+    $target = EntityMembership::factory()->for($queue->entity)->employee()->create();
+    (new SetQueueAccess)($target, $queue, $manager, ['call']);
+    $audit = auditChannel();
+
+    (new SetQueueAccess)($target, $queue, $manager, []);
+
+    expect(QueueAccess::query()->where('queue_id', $queue->id)->exists())->toBeFalse();
+    $audit->shouldHaveReceived('info')->with('queue.access.revoked', [
+        'actor_id' => $manager->id,
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $target->id,
+    ])->once();
+});
+
+it('does nothing and writes no audit entry when revoking without a grant', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue->entity);
+    $target = EntityMembership::factory()->for($queue->entity)->employee()->create();
+    $audit = auditChannel();
+
+    (new SetQueueAccess)($target, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+    $audit->shouldNotHaveReceived('info');
+});
+
+it('rejects unknown permissions and stores nothing', function (array $permissions) {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue->entity);
+    $target = EntityMembership::factory()->for($queue->entity)->employee()->create();
+
+    expect(fn () => (new SetQueueAccess)($target, $queue, $manager, $permissions))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with([
+    [['admin']],
+    [['call', 'manage']],
+    [[1]],
+    [[null]],
+    [[['call']]],
+    [['x' => 'call']],
+]);
+
+it('rejects a membership and a queue from different entities', function () {
+    $queue = Queue::factory()->create();
+    $manager = managerOf($queue->entity);
+    $outsider = EntityMembership::factory()->create();
+
+    expect(fn () => (new SetQueueAccess)($outsider, $queue, $manager, ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('rejects a grant from an employee, including granting themselves', function () {
+    $queue = Queue::factory()->create();
+    $employee = employeeOf($queue->entity);
+    $self = EntityMembership::query()->where('user_id', $employee->id)->first();
+    $other = EntityMembership::factory()->for($queue->entity)->employee()->create();
+
+    expect(fn () => (new SetQueueAccess)($self, $queue, $employee, ['call']))
+        ->toThrow(AuthorizationException::class);
+    expect(fn () => (new SetQueueAccess)($other, $queue, $employee, ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('rejects a grant from a user outside the entity or from a manager of another entity', function () {
+    $queue = Queue::factory()->create();
+    $target = EntityMembership::factory()->for($queue->entity)->employee()->create();
+
+    expect(fn () => (new SetQueueAccess)($target, $queue, User::factory()->create(), ['call']))
+        ->toThrow(AuthorizationException::class);
+    expect(fn () => (new SetQueueAccess)($target, $queue, managerOf(Entity::factory()->create()), ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
diff --git a/tests/Feature/Queue/UpdateQueueTest.php b/tests/Feature/Queue/UpdateQueueTest.php
new file mode 100644
