@@ -0,0 +1,74 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use App\Support\DatabaseErrors;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    /**
+     * Rename, re-slug and/or (de)activate a queue. A null argument leaves that
+     * field unchanged. Queues are never deleted: deactivate them instead.
+     *
+     * @throws AuthorizationException when the actor is not an owner or admin of the entity
+     * @throws ValidationException when the name is invalid or the slug is used by another queue in the entity
+     */
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $changes = [];
+
+        if ($name !== null) {
+            $changes['name'] = trim($name);
+        }
+
+        if ($slug !== null) {
+            $changes['slug'] = Str::slug($slug);
+        }
+
+        if ($isActive !== null) {
+            $changes['is_active'] = $isActive;
+        }
+
+        Validator::make($changes, [
+            'name' => ['sometimes', 'required', 'string', 'max:255'],
+            'slug' => [
+                'sometimes',
+                'required',
+                'string',
+                'max:255',
+                Rule::unique('queues')->where('entity_id', $queue->entity_id)->ignore($queue->id),
+            ],
+        ])->validate();
+
+        try {
+            $queue->fill($changes)->save();
+        } catch (QueryException $e) {
+            // Another request took the slug between the check above and the UPDATE.
+            if (! DatabaseErrors::isUniqueViolation($e)) {
+                throw $e;
+            }
+
+            throw ValidationException::withMessages([
+                'slug' => __('validation.unique', ['attribute' => 'slug']),
+            ]);
+        }
+
+        return $queue;
+    }
+}
