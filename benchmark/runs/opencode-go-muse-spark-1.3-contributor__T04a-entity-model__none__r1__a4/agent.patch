@@ -0,0 +1,45 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor((int) $membership->entity_id) !== null;
+    }
+
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        $mine = $user->membershipFor((int) $membership->entity_id);
+
+        return $mine !== null
+            && in_array($mine->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($this->isOwner($membership)) {
+            return false;
+        }
+
+        if ((int) $membership->user_id === (int) $user->getKey()) {
+            return true;
+        }
+
+        $mine = $user->membershipFor((int) $membership->entity_id);
+
+        return $mine !== null
+            && in_array($mine->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    private function isOwner(EntityMembership $membership): bool
+    {
+        return $membership->role === UserRole::Owner
+            || $membership->role === UserRole::Owner->value;
+    }
+}
