+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    public function view(User $user, Entity $entity): bool
+    {
+        return $user->membershipFor((int) $entity->getKey()) !== null;
+    }
+
+    public function update(User $user, Entity $entity): bool
+    {
+        $membership = $user->membershipFor((int) $entity->getKey());
+
+        return $membership !== null
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->update($user, $entity);
+    }
+
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        $membership = $user->membershipFor((int) $entity->getKey());
+
+        return $membership !== null && $membership->role === UserRole::Owner;
+    }
+}
