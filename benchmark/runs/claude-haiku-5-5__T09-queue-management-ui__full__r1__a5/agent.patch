+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Owner (manager) and employee (member) of an entity, plus a foreign queue.
+ */
+function serveScenario(): array
+{
+    $entity = Entity::factory()->create(['name' => 'Clínica Sol']);
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    $employee = User::factory()->create();
+    $employeeMembership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $foreign = Entity::factory()->create();
+    $foreignQueue = Queue::factory()->for($foreign)->create(['name' => 'Foreign queue']);
+
+    return compact('entity', 'owner', 'employee', 'employeeMembership', 'foreignQueue');
+}
+
+function serveAs(User $user, Entity $entity): void
+{
+    test()->actingAs($user)->post(route('entity.pick', $entity->slug));
+}
+
+function waitingTicket(Queue $queue, array $attributes = []): Ticket
+{
+    return Ticket::factory()->for($queue)->create($attributes + ['issued_at' => now()->subMinute()]);
+}
+
+test('any member opens the serve page; a non-member is forbidden', function () {
+    $s = serveScenario();
+    serveAs($s['employee'], $s['entity']);
+
+    $this->get(route('entity.serve', $s['entity']->slug))
+        ->assertOk()
+        ->assertSee(__('ui.serve_title', ['entity' => 'Clínica Sol']));
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])->assertOk();
+
+    $outsider = User::factory()->create();
+    $this->actingAs($outsider);
+    Livewire::test(Serve::class, ['entity' => $s['entity']])->assertForbidden();
+});
+
+test('owner sees every active queue in the selector and defaults to the first one', function () {
+    $s = serveScenario();
+    $alpha = Queue::factory()->for($s['entity'])->create(['name' => 'Alpha']);
+    $zeta = Queue::factory()->for($s['entity'])->create(['name' => 'Zeta']);
+    $inactive = Queue::factory()->for($s['entity'])->create(['name' => 'Inativa', 'is_active' => false]);
+    serveAs($s['owner'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->assertSet('selectedQueueId', $alpha->id)
+        ->assertSee('value="'.$alpha->id.'"', false)
+        ->assertSee('value="'.$zeta->id.'"', false)
+        ->assertDontSee('value="'.$inactive->id.'"', false)
+        ->assertDontSee('Foreign queue');
+});
+
+test('employees only see queues they hold a call grant for', function () {
+    $s = serveScenario();
+    $granted = Queue::factory()->for($s['entity'])->create(['name' => 'Granted']);
+    Queue::factory()->for($s['entity'])->create(['name' => 'Locked']);
+    QueueAccess::factory()->for($granted)->for($s['employeeMembership'], 'membership')->create();
+    serveAs($s['employee'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->assertSet('selectedQueueId', $granted->id)
+        ->assertSee('value="'.$granted->id.'"', false)
+        ->assertDontSeeText('Locked');
+});
+
+test('employee without any call grant has no selection and sees the empty text', function () {
+    $s = serveScenario();
+    Queue::factory()->for($s['entity'])->create(['name' => 'Locked']);
+    serveAs($s['employee'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->assertSet('selectedQueueId', null)
+        ->assertSeeText(__('ui.serve_empty'));
+});
+
+test('waiting list follows call order, filters by mode and lists at most 30 tickets', function () {
+    $s = serveScenario();
+    $queue = Queue::factory()->for($s['entity'])->create(['name' => 'Triagem']);
+    $normalOld = waitingTicket($queue, ['code' => 'A001', 'channel' => TicketChannel::Totem, 'issued_at' => now()->subMinutes(10)]);
+    $normalNew = waitingTicket($queue, ['code' => 'A002', 'channel' => TicketChannel::Printed, 'issued_at' => now()->subMinutes(5)]);
+    $priority = waitingTicket($queue, ['code' => 'A003', 'priority' => 2, 'channel' => TicketChannel::Virtual, 'issued_at' => now()]);
+    waitingTicket($queue, ['code' => 'A004', 'status' => TicketStatus::Called, 'called_at' => now()]);
+    serveAs($s['owner'], $s['entity']);
+
+    $component = Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->assertSeeInOrder(['A003', 'A001', 'A002'])
+        ->assertDontSee('A004')
+        ->assertSeeText(__('ui.channel_totem'))
+        ->assertSeeText(__('ui.channel_printed'))
+        ->assertSeeText(__('ui.channel_virtual'))
+        ->assertSeeText(__('ui.serve_priority', ['level' => 2]));
+
+    $component->set('mode', 'priority_only')
+        ->assertSee('A003')
+        ->assertDontSee('A001');
+
+    $component->set('mode', 'normal_only')
+        ->assertDontSee('A003')
+        ->assertSeeInOrder(['A001', 'A002']);
+
+    foreach (range(5, 40) as $n) {
+        waitingTicket($queue, ['code' => sprintf('B%03d', $n), 'issued_at' => now()->addMinutes($n)]);
+    }
+
+    $component->set('mode', 'any')
+        ->assertSee('B005')
+        ->assertDontSee('B035');
+
+    expect($normalOld->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($normalNew->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('callNext serves the next ticket, stores it as last called and announces it', function () {
+    $s = serveScenario();
+    $queue = Queue::factory()->for($s['entity'])->create(['name' => 'Triagem']);
+    $ticket = waitingTicket($queue, ['code' => 'A001']);
+    serveAs($s['owner'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('lastCalledTicketId', $ticket->id)
+        ->assertSet('notice', __('ui.serve_last_called', ['code' => 'A001']))
+        ->assertSeeText(__('ui.serve_last_called', ['code' => 'A001']));
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($s['owner']->id);
+});
+
+test('callNext with a priority mode serves only tickets of that mode', function () {
+    $s = serveScenario();
+    $queue = Queue::factory()->for($s['entity'])->create(['name' => 'Triagem']);
+    $normal = waitingTicket($queue, ['code' => 'A001']);
+    $priority = waitingTicket($queue, ['code' => 'A002', 'priority' => 1]);
+    serveAs($s['owner'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->set('mode', 'priority_only')
+        ->call('callNext')
+        ->assertSet('lastCalledTicketId', $priority->id);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->set('mode', 'normal_only')
+        ->call('callNext')
+        ->assertSet('lastCalledTicketId', $normal->id);
+});
+
+test('callNext without a selection only shows the empty notice', function () {
+    $s = serveScenario();
+    serveAs($s['employee'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('selectedQueueId', null)
+        ->assertSet('lastCalledTicketId', null)
+        ->assertSet('notice', __('ui.serve_empty'));
+});
+
+test('callNext maps an inactive queue and an empty queue to their notices', function () {
+    $s = serveScenario();
+    $inactive = Queue::factory()->for($s['entity'])->create(['name' => 'Inativa', 'is_active' => false]);
+    waitingTicket($inactive, ['code' => 'A001']);
+    $empty = Queue::factory()->for($s['entity'])->create(['name' => 'Vazia']);
+    serveAs($s['owner'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->set('selectedQueueId', $inactive->id)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_inactive'))
+        ->assertSet('lastCalledTicketId', null);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->set('selectedQueueId', $empty->id)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_empty'))
+        ->assertSet('lastCalledTicketId', null);
+});
+
+test('an invalid mode is a validation error and calls nothing', function () {
+    $s = serveScenario();
+    $queue = Queue::factory()->for($s['entity'])->create(['name' => 'Triagem']);
+    $ticket = waitingTicket($queue, ['code' => 'A001']);
+    serveAs($s['owner'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->set('mode', 'everything')
+        ->call('callNext')
+        ->assertHasErrors(['mode']);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a tampered foreign queue id is not found and changes nothing', function () {
+    $s = serveScenario();
+    $own = Queue::factory()->for($s['entity'])->create(['name' => 'Triagem']);
+    waitingTicket($own, ['code' => 'A001']);
+    $foreignTicket = waitingTicket($s['foreignQueue'], ['code' => 'F001']);
+    serveAs($s['owner'], $s['entity']);
+
+    $component = Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->set('selectedQueueId', $s['foreignQueue']->id);
+
+    expect($component->html())->not->toContain('F001')
+        ->and($component->html())->toContain(__('ui.serve_empty'));
+
+    try {
+        $component->call('callNext');
+        expect(false)->toBeTrue('Expected a not-found exception.');
+    } catch (ModelNotFoundException|NotFoundHttpException) {
+        expect(true)->toBeTrue();
+    }
+
+    expect($foreignTicket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('an employee without a call grant is forbidden and nothing changes', function () {
+    $s = serveScenario();
+    $queue = Queue::factory()->for($s['entity'])->create(['name' => 'Triagem']);
+    $ticket = waitingTicket($queue, ['code' => 'A001']);
+    serveAs($s['owner'], $s['entity']);
+
+    // Tamper: the selection is forced to a queue the employee cannot call.
+    serveAs($s['employee'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertForbidden();
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('lastCalledTicketId cannot be written by the client', function () {
+    $s = serveScenario();
+    serveAs($s['owner'], $s['entity']);
+
+    $component = Livewire::test(Serve::class, ['entity' => $s['entity']]);
+
+    expect(fn () => $component->set('lastCalledTicketId', 999))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
+
+test('successful calls are rate limited per user and entity', function () {
+    $s = serveScenario();
+    $queue = Queue::factory()->for($s['entity'])->create(['name' => 'Triagem']);
+    foreach (range(1, 11) as $n) {
+        waitingTicket($queue, ['code' => sprintf('A%03d', $n)]);
+    }
+    serveAs($s['owner'], $s['entity']);
+
+    $component = Livewire::test(Serve::class, ['entity' => $s['entity']]);
+
+    foreach (range(1, 10) as $_) {
+        $component->call('callNext');
+    }
+
+    $component->assertSet('notice', __('ui.serve_last_called', ['code' => 'A010']));
+
+    $component->call('callNext')
+        ->assertSet('notice', __('ui.serve_rate_limited'));
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->where('status', TicketStatus::Waiting)->count())->toBe(1);
+});
+
+test('call next button carries its label and an aria label', function () {
+    $s = serveScenario();
+    Queue::factory()->for($s['entity'])->create(['name' => 'Triagem']);
+    serveAs($s['owner'], $s['entity']);
+
+    Livewire::test(Serve::class, ['entity' => $s['entity']])
+        ->assertSeeText(__('ui.serve_call_next'))
+        ->assertSee('aria-label="'.__('ui.serve_call_next').'"', false);
+});
