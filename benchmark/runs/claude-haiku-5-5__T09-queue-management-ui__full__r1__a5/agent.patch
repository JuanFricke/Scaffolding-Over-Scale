+    $manager = User::factory()->create();
+    $managerMembership = EntityMembership::factory()->for($s['entity'])->for($manager)->admin()->create();
+    $target = EntityMembership::factory()->for($s['entity'])->for(User::factory()->create())->employee()->create();
+    actAsEntity($manager, $s['entity']);
+
+    // Each component is mounted while still a manager, then the user is demoted:
+    // every action must re-authorize on the server. A 403 breaks the component's
+    // snapshot, so each action gets its own component.
+    $cases = [
+        'openCreate' => [],
+        'startRename' => [$queue->id],
+        'confirmToggle' => [],
+        'toggleActive' => [$queue->id],
+        'openAccess' => [$queue->id],
+        'grantAccess' => [$target->id],
+        'revokeAccess' => [$target->id],
+    ];
+
+    $components = [];
+    foreach ($cases as $action => $args) {
