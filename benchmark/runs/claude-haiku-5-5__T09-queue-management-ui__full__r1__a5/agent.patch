diff --git a/tests/Feature/Entity/MembersTabsTest.php b/tests/Feature/Entity/MembersTabsTest.php
new file mode 100644
index 0000000..9a9573c
--- /dev/null
+++ b/tests/Feature/Entity/MembersTabsTest.php
@@ -0,0 +1,87 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function membersTabsScenario(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    $member = User::factory()->create(['name' => 'Carla Membro']);
+    EntityMembership::factory()->for($entity)->for($member)->employee()->create();
+
+    EntityInvite::factory()->for($entity)->create(['email' => 'pendente@example.com']);
+
+    test()->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    return compact('entity', 'owner');
+}
+
+test('members page renders a tablist with the members tab selected by default', function () {
+    $s = membersTabsScenario();
+
+    Livewire::test(Members::class, ['entity' => $s['entity']])
+        ->assertSet('activeTab', 'members')
+        ->assertSee('role="tablist"', false)
+        ->assertSee('role="tab"', false)
+        ->assertSeeText(__('ui.members_tab_members'))
+        ->assertSeeText(__('ui.members_tab_invites'))
+        ->assertSee('aria-selected="true"', false);
+});
+
+test('the members list is on the first tab and the invite form stays off it', function () {
+    $s = membersTabsScenario();
+
+    Livewire::test(Members::class, ['entity' => $s['entity']])
+        ->assertSeeText('Carla Membro')
+        ->assertDontSee('name="inviteEmail"', false)
+        ->assertDontSeeText(__('ui.members_invite_title'))
+        ->assertDontSeeText('pendente@example.com');
+});
+
+test('switching to the invites tab renders the invite form and pending invites only', function () {
+    $s = membersTabsScenario();
+
+    Livewire::test(Members::class, ['entity' => $s['entity']])
+        ->call('setActiveTab', 'invites')
+        ->assertSet('activeTab', 'invites')
+        ->assertSee('name="inviteEmail"', false)
+        ->assertSeeText(__('ui.members_invite_title'))
+        ->assertSeeText('pendente@example.com')
+        ->assertDontSeeText('Carla Membro');
+});
+
+test('setActiveTab ignores anything other than members or invites', function () {
+    $s = membersTabsScenario();
+
+    Livewire::test(Members::class, ['entity' => $s['entity']])
+        ->call('setActiveTab', 'owner')
+        ->assertSet('activeTab', 'members')
+        ->call('setActiveTab', 'invites')
+        ->call('setActiveTab', '<script>')
+        ->assertSet('activeTab', 'invites')
+        ->call('setActiveTab', 'members')
+        ->assertSet('activeTab', 'members');
+});
+
+test('a demoted manager cannot switch tabs', function () {
+    $s = membersTabsScenario();
+    $manager = User::factory()->create();
+    $managerMembership = EntityMembership::factory()->for($s['entity'])->for($manager)->admin()->create();
+    test()->actingAs($manager)->post(route('entity.pick', $s['entity']->slug));
+
+    $component = Livewire::test(Members::class, ['entity' => $s['entity']]);
+    $managerMembership->update(['role' => UserRole::Employee]);
+
+    $component->call('setActiveTab', 'invites')->assertForbidden();
+});
