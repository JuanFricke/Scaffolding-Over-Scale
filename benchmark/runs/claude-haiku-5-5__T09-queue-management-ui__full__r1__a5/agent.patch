diff --git a/app/Livewire/Entity/Queues.php b/app/Livewire/Entity/Queues.php
new file mode 100644
index 0000000..3911262
--- /dev/null
+++ b/app/Livewire/Entity/Queues.php
@@ -0,0 +1,265 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateQueue;
+use App\Actions\SetQueueAccess;
+use App\Actions\UpdateQueue;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Queues extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    /**
+     * Draft name for the create modal. Only persisted via create().
+     */
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    /**
+     * Whether the create modal is open. Client-writable flag — every action
+     * re-authorizes server-side.
+     */
+    public bool $creating = false;
+
+    /**
+     * Queue shown in the detail modal. Untrusted client state — always
+     * re-resolved scoped to the entity before use.
+     */
+    public ?int $viewingQueueId = null;
+
+    /**
+     * Whether the activate/deactivate confirmation modal is open.
+     */
+    public bool $confirmingToggle = false;
+
+    /**
+     * Queue being renamed. Untrusted client state — re-resolved scoped to the entity.
+     */
+    public ?int $editingQueueId = null;
+
+    /**
+     * Draft name for the rename form. Only persisted via rename().
+     */
+    #[Validate('required|string|max:255')]
+    public string $renameName = '';
+
+    /**
+     * Queue whose access grants are shown. Untrusted client state — re-resolved
+     * scoped to the entity; a foreign id resolves to null.
+     */
+    public ?int $accessQueueId = null;
+
+    /**
+     * Whether the access modal is open.
+     */
+    public bool $managingAccess = false;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('create', [Queue::class, $entity]);
+        $this->entity = $entity;
+    }
+
+    public function openCreate(): void
+    {
+        $this->authorize('create', [Queue::class, $this->entity]);
+
+        $this->creating = true;
+    }
+
+    public function closeCreate(): void
+    {
+        $this->reset('name', 'creating');
+        $this->resetValidation('name');
+    }
+
+    public function create(): void
+    {
+        $this->authorize('create', [Queue::class, $this->entity]);
+
+        $this->validateOnly('name');
+
+        try {
+            app(CreateQueue::class)($this->entity, auth()->user(), $this->name);
+        } catch (ValidationException $e) {
+            $this->addError('name', $this->firstValidationMessage($e));
+
+            return;
+        }
+
+        $this->reset('name', 'creating');
+    }
+
+    public function openQueue($id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+
+        $this->authorize('update', $queue);
+
+        $this->viewingQueueId = $queue->id;
+    }
+
+    public function closeQueue(): void
+    {
+        $this->reset(
+            'viewingQueueId',
+            'confirmingToggle',
+            'editingQueueId',
+            'renameName',
+            'accessQueueId',
+            'managingAccess',
+        );
+        $this->resetValidation('renameName');
+    }
+
+    public function startRename($id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+
+        $this->authorize('update', $queue);
+
+        $this->editingQueueId = $queue->id;
+        $this->renameName = $queue->name;
+        $this->resetValidation('renameName');
+    }
+
+    public function cancelRename(): void
+    {
+        $this->reset('editingQueueId', 'renameName');
+        $this->resetValidation('renameName');
+    }
+
+    public function rename(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->editingQueueId ?? 0);
+
+        $this->authorize('update', $queue);
+
+        $this->validateOnly('renameName');
+
+        try {
+            app(UpdateQueue::class)(
+                $queue,
+                auth()->user(),
+                name: $this->renameName,
+                slug: Str::slug($this->renameName),
+            );
+        } catch (ValidationException $e) {
+            $this->addError('renameName', $this->firstValidationMessage($e));
+
+            return;
+        }
+
+        $this->reset('editingQueueId', 'renameName');
+    }
+
+    public function confirmToggle(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->viewingQueueId ?? 0);
+
+        $this->authorize('update', $queue);
+
+        $this->confirmingToggle = true;
+    }
+
+    public function cancelToggle(): void
+    {
+        $this->confirmingToggle = false;
+    }
+
+    public function toggleActive($id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+
+        $this->authorize('update', $queue);
+
+        app(UpdateQueue::class)($queue, auth()->user(), isActive: ! $queue->is_active);
+
+        $this->confirmingToggle = false;
+    }
+
+    public function openAccess($id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+
+        $this->authorize('manageAccess', $queue);
+
+        $this->accessQueueId = $queue->id;
+        $this->managingAccess = true;
+    }
+
+    public function closeAccess(): void
+    {
+        $this->reset('accessQueueId', 'managingAccess');
+    }
+
+    public function grantAccess($membershipId): void
+    {
+        $this->setAccess($membershipId, [QueuePermission::Call]);
+    }
+
+    public function revokeAccess($membershipId): void
+    {
+        $this->setAccess($membershipId, []);
+    }
+
+    public function render(): View
+    {
+        $viewingQueue = $this->viewingQueueId
+            ? $this->entity->queues()->find($this->viewingQueueId)
+            : null;
+
+        $accessQueue = $this->accessQueueId
+            ? $this->entity->queues()->find($this->accessQueueId)
+            : null;
+
+        return view('livewire.entity.queues', [
+            'queues' => $this->entity->queues()->orderBy('name')->get(),
+            'viewingQueue' => $viewingQueue,
+            'accessQueue' => $accessQueue,
+            'accessGrants' => $accessQueue
+                ? QueueAccess::query()->where('queue_id', $accessQueue->id)->get()->keyBy('entity_membership_id')
+                : collect(),
+            'memberships' => $accessQueue
+                ? $this->entity->memberships()->with('user')->latest('id')->get()
+                : collect(),
+        ]);
+    }
+
+    /**
+     * Grant or revoke queue permissions through SetQueueAccess, which writes the audit trail.
+     *
+     * @param  array<int, QueuePermission>  $permissions
+     */
+    protected function setAccess($membershipId, array $permissions): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->accessQueueId ?? 0);
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('manageAccess', $queue);
+
+        app(SetQueueAccess::class)($membership, $queue, auth()->user(), $permissions);
+    }
+
+    /**
+     * Domain errors name either `name` or the derived `slug`; both belong to the field being edited.
+     */
+    protected function firstValidationMessage(ValidationException $e): string
+    {
+        return (string) collect($e->errors())->flatten()->first();
+    }
+}
diff --git a/app/Livewire/Entity/Serve.php b/app/Livewire/Entity/Serve.php
new file mode 100644
index 0000000..57b1c1a
--- /dev/null
+++ b/app/Livewire/Entity/Serve.php
@@ -0,0 +1,174 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Serve extends Component
+{
+    /**
+     * Successful calls allowed per user and entity within the rate-limit window.
+     */
+    private const CALL_LIMIT = 10;
+
+    /**
+     * Rate-limit window in seconds.
+     */
+    private const CALL_WINDOW = 60;
+
+    /**
+     * Maximum tickets shown in the waiting list.
+     */
+    private const WAITING_LIMIT = 30;
+
+    #[Locked]
+    public Entity $entity;
+
+    /**
+     * Queue being served. Untrusted client state — always re-resolved scoped to the entity.
+     */
+    public ?int $selectedQueueId = null;
+
+    /**
+     * Call mode applied to the waiting list and to callNext().
+     */
+    #[Validate('required|in:any,priority_only,normal_only')]
+    public string $mode = 'any';
+
+    /**
+     * Ticket last called from this panel. Server-only: the client cannot write it.
+     */
+    #[Locked]
+    public ?int $lastCalledTicketId = null;
+
+    /**
+     * Feedback line shown under the controls.
+     */
+    public ?string $notice = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+        $this->selectedQueueId = $this->callableQueues()->first()?->id;
+    }
+
+    public function callNext(): void
+    {
+        $this->notice = null;
+
+        if ($this->selectedQueueId === null) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+
+        $this->authorize('call', $queue);
+        $this->validateOnly('mode');
+
+        $limiterKey = 'serve-call:'.auth()->id().':'.$this->entity->id;
+
+        if (RateLimiter::tooManyAttempts($limiterKey, self::CALL_LIMIT)) {
+            $this->notice = __('ui.serve_rate_limited');
+
+            return;
+        }
+
+        try {
+            $ticket = app(CallNextTicket::class)($queue, auth()->user(), CallMode::from($this->mode));
+        } catch (InactiveQueueException) {
+            $this->notice = __('ui.serve_inactive');
+
+            return;
+        } catch (NoWaitingTicketsException) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        RateLimiter::hit($limiterKey, self::CALL_WINDOW);
+
+        $this->lastCalledTicketId = $ticket->id;
+        $this->notice = __('ui.serve_last_called', ['code' => $ticket->code]);
+    }
+
+    public function render(): View
+    {
+        $queue = $this->servedQueue();
+
+        return view('livewire.entity.serve', [
+            'queues' => $this->callableQueues(),
+            'tickets' => $queue ? $this->waitingTickets($queue) : collect(),
+        ]);
+    }
+
+    /**
+     * Active queues of the entity that the current user may call.
+     *
+     * @return Collection<int, Queue>
+     */
+    protected function callableQueues(): Collection
+    {
+        $user = auth()->user();
+
+        return $this->entity->queues()
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->filter(fn (Queue $queue) => $user->can('call', $queue))
+            ->values();
+    }
+
+    /**
+     * The selected queue when it belongs to the entity and the user may call it; otherwise null.
+     */
+    protected function servedQueue(): ?Queue
+    {
+        if ($this->selectedQueueId === null) {
+            return null;
+        }
+
+        $queue = $this->entity->queues()->find($this->selectedQueueId);
+
+        return $queue && auth()->user()->can('call', $queue) ? $queue : null;
+    }
+
+    /**
+     * Waiting tickets in call order, filtered by the current mode.
+     *
+     * @return Collection<int, Ticket>
+     */
+    protected function waitingTickets(Queue $queue): Collection
+    {
+        $mode = CallMode::tryFrom($this->mode) ?? CallMode::Any;
+
+        return Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->when($mode === CallMode::PriorityOnly, fn ($query) => $query->where('priority', '>', 0))
+            ->when($mode === CallMode::NormalOnly, fn ($query) => $query->where('priority', 0))
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id')
+            ->limit(self::WAITING_LIMIT)
+            ->get();
+    }
+}
