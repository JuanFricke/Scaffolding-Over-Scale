diff --git a/database/factories/TicketFactory.php b/database/factories/TicketFactory.php
new file mode 100644
index 0000000..4b74483
--- /dev/null
+++ b/database/factories/TicketFactory.php
@@ -0,0 +1,69 @@
+<?php
+
+namespace Database\Factories;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<Ticket>
+ */
+class TicketFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * Code is a null sentinel here and is allocated in afterMaking, once
+     * queue_id is resolved to a persisted queue. Explicit codes (e.g.
+     * ['code' => 'A999']) are preserved.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'queue_id' => Queue::factory(),
+            'code' => null,
+            'priority' => 0,
+            'channel' => TicketChannel::Virtual,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+            'called_at' => null,
+            'called_by_user_id' => null,
+        ];
+    }
+
+    public function configure(): static
+    {
+        return $this->afterMaking(function (Ticket $ticket): void {
+            if ($ticket->code !== null) {
+                return;
+            }
+
+            $queueId = $ticket->queue_id ?? $ticket->queue?->getKey();
+
+            if ($queueId === null) {
+                $ticket->code = 'A001';
+
+                return;
+            }
+
+            $ticket->code = Ticket::nextCode((int) $queueId);
+        });
+    }
+
+    /**
+     * Attach a persisted queue and let afterMaking() allocate the code at
+     * creation time, so two factories built upfront still get distinct
+     * sequential codes when each is created.
+     */
+    public function forQueue(Queue $queue): static
+    {
+        return $this->for($queue)->state(fn (): array => [
+            'code' => null,
+        ]);
+    }
+}
