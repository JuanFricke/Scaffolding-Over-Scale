@@ -0,0 +1,74 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Priority must be zero or greater.');
+        }
+
+        // Queue-row lock serializes issuance + deactivation on MariaDB.
+        // lockForUpdate() is a no-op on SQLite (tests), so retry the
+        // transaction on unique(queue_id, code) collision as a safety net.
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel): Ticket {
+                    // Lock the queue row before checking state and allocating a number so
+                    // concurrent issuances and queue deactivation are serialized.
+                    $lockedQueue = Queue::query()
+                        ->whereKey($queue->id)
+                        ->lockForUpdate()
+                        ->firstOrFail();
+
+                    if (! $lockedQueue->is_active) {
+                        throw new InactiveQueueException('Cannot issue a ticket into an inactive queue.');
+                    }
+
+                    $code = Ticket::nextCode($lockedQueue->id);
+
+                    // System-set fields (code/status/issued_at) are not fillable by
+                    // design, so bypass mass-assignment here with trusted data.
+                    return Ticket::query()->forceCreate([
+                        'queue_id' => $lockedQueue->id,
+                        'code' => $code,
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (QueryException $e) {
+                if ($attempt >= 3 || ! self::isUniqueViolation($e)) {
+                    throw $e;
+                }
+            }
+        }
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
