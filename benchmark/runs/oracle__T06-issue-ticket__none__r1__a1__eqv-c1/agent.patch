@@ -0,0 +1,146 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Database\Factories\TicketFactory;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+#[Fillable([
+    'queue_id',
+    'priority',
+    'channel',
+])]
+class Ticket extends Model
+{
+    /** @use HasFactory<TicketFactory> */
+    use HasFactory;
+
+    /**
+     * Next display code for a queue (monotonic max+1, gap-tolerant).
+     *
+     * Ordered by id (insertion order), not by code string, so A999 -> A1000
+     * keeps working where lexicographic ordering would return A999 again.
+     * Skips malformed legacy codes (outside A<number>) by scanning for the
+     * most recent valid code, so A001 then A-X yields A002 instead of a
+     * duplicate A001 colliding on unique(queue_id, code).
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = self::query()
+            ->where('queue_id', $queueId)
+            ->orderByDesc('id')
+            ->pluck('code');
+
+        foreach ($codes as $code) {
+            if (preg_match('/^A(\d+)$/', (string) $code, $m)) {
+                return 'A'.str_pad((string) ((int) $m[1] + 1), 3, '0', STR_PAD_LEFT);
+            }
+        }
+
+        return 'A001';
+    }
+
+    /**
+     * Fields mutable after issuance (call path).
+     *
+     * @var list<string>
+     */
+    private const MUTABLE_AFTER_CREATE = [
+        'status',
+        'called_at',
+        'called_by_user_id',
+        'updated_at',
+    ];
+
+    protected static function booted(): void
+    {
+        static::updating(function (Ticket $ticket): void {
+            $immutableDirty = array_diff(
+                array_keys($ticket->getDirty()),
+                self::MUTABLE_AFTER_CREATE,
+            );
+
+            if ($immutableDirty !== []) {
+                throw new LogicException(
+                    'Ticket fields are write-once after issuance except status, called_at and called_by_user_id.'
+                );
+            }
+        });
+    }
+
+    /**
+     * Mark the ticket as called exactly once.
+     *
+     * Caller must be a member of the ticket's entity; membership is
+     * enforced here so the domain action is safe without an HTTP layer.
+     */
+    public function call(User $user): void
+    {
+        DB::transaction(function () use ($user): void {
+            $ticket = self::query()
+                ->whereKey($this->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if ($ticket->status !== TicketStatus::Waiting) {
+                throw new LogicException('Only waiting tickets can be called.');
+            }
+
+            $entityId = Queue::query()->whereKey($ticket->queue_id)->value('entity_id');
+
+            $isMember = EntityMembership::query()
+                ->where('entity_id', $entityId)
+                ->where('user_id', $user->id)
+                ->exists();
+
+            if (! $isMember) {
+                throw new AuthorizationException('Only entity members can call tickets.');
+            }
+
+            $ticket->status = TicketStatus::Called;
+            $ticket->called_at = now();
+            $ticket->called_by_user_id = $user->id;
+            $ticket->save();
+
+            $this->refresh();
+        });
+    }
+
+    /**
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    /**
+     * @return BelongsTo<Queue, $this>
+     */
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    /**
+     * @return BelongsTo<User, $this>
+     */
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+}
