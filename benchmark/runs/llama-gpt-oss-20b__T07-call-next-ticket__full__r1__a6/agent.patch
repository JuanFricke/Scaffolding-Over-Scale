+++ b/app/Actions/CallNextTicket.php
@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Enums\TicketStatus;
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Domain action to call the next ticket from a queue based on mode.
+ */
+final class CallNextTicket
+{
+    /**
+     * @param Queue $queue Queue instance (may be stale).
+     * @param User $calledBy User who is calling the ticket.
+     * @param CallMode $mode Call mode.
+     * @return Ticket The called ticket.
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Reload and lock queue row
+            $queueRow = Queue::whereKey($queue->id)->lockForUpdate()->firstOrFail();
+
+            if (! $queueRow->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket in an inactive queue.');
+            }
+
+            // Determine if fairness rule applies (only for any mode)
+            $effectiveMode = $mode;
+            if ($mode === CallMode::Any) {
+                $lastThree = Ticket::where('queue_id', $queueRow->id)
+                    ->where('status', TicketStatus::Called)
+                    ->orderByDesc('called_at')
+                    ->orderByDesc('id')
+                    ->limit(3)
+                    ->get();
+
+                $allPriority = $lastThree->count() === 3 && $lastThree->every(fn (Ticket $t) => $t->priority > 0);
+
+                if ($allPriority) {
+                    // At least one normal waiting ticket? If so, restrict to normal.
+                    $normalExists = Ticket::where('queue_id', $queueRow->id)
+                        ->where('status', TicketStatus::Waiting)
+                        ->where('priority', 0)
+                        ->exists();
+                    if ($normalExists) {
+                        $effectiveMode = CallMode::NormalOnly;
+                    }
+                }
+            }
+
+            // Build base query for waiting tickets
+            $query = Ticket::where('queue_id', $queueRow->id)
+                ->where('status', TicketStatus::Waiting);
+
+            // Apply mode-specific ordering
+            switch ($effectiveMode) {
+                case CallMode::PriorityOnly:
+                    $query->where('priority', '>', 0)
+                        ->orderByDesc('priority')
+                        ->orderBy('issued_at')
+                        ->orderBy('id');
+                    break;
+                case CallMode::NormalOnly:
+                    $query->where('priority', 0)
+                        ->orderBy('issued_at')
+                        ->orderBy('id');
+                    break;
+                case CallMode::Any:
+                default:
+                    $query->orderByDesc('priority')
+                        ->orderBy('issued_at')
+                        ->orderBy('id');
+                    break;
+            }
+
+            // Attempt to lock and select the next ticket, handling concurrency.
+            while (true) {
+                $ticket = $query->lockForUpdate()->first();
+                if (! $ticket) {
+                    // No candidate found
+                    throw new NoWaitingTicketsException();
+                }
+
+                // Double-check status in case of race.
+                if ($ticket->status !== TicketStatus::Waiting) {
+                    // Skip this ticket and continue loop.
+                    continue;
+                }
+
+                // Mark as called
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+        });
+    }
+}
