+<?php
+
+namespace App\Exceptions;
+
+use RuntimeException;
+
+/**
+ * Thrown when no waiting tickets exist for the requested mode.
+ */
+class NoWaitingTicketsException extends RuntimeException
+{
+    public function __construct(string $message = 'No waiting tickets available.')
+    {
+        parent::__construct($message);
+    }
+}
