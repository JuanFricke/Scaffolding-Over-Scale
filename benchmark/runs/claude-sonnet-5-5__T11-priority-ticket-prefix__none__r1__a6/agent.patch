+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+afterEach(fn () => $this->travelBack());
+
+it('resolves default prefixes with range fallback', function (int $priority, string $prefix) {
+    expect(Queue::factory()->create()->prefixForPriority($priority))->toBe($prefix)
+        ->and(Queue::defaultPrefixFor($priority))->toBe($prefix);
+})->with([
+    [0, 'N'], [-3, 'N'], [1, 'P'], [10, 'P'], [19, 'P'], [20, 'E'], [99, 'E'],
+]);
+
+it('prefers the custom map and falls back to the default', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => [0 => 'X', 20 => 'Z']]);
+
+    expect($queue->fresh())
+        ->prefixForPriority(0)->toBe('X')
+        ->prefixForPriority(20)->toBe('Z')
+        ->prefixForPriority(10)->toBe('P')
+        ->prefixForPriority(5)->toBe('P');
+});
+
+it('stores an empty map as null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects invalid maps on save', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+})->with([
+    'bad key' => [['foo' => 'X']],
+    'negative key' => [['-1' => 'X']],
+    'padded key' => [['010' => 'X']],
+    'long value' => [['0' => 'xx']],
+    'lowercase' => [['0' => 'x']],
+    'duplicate' => [['0' => 'N', '10' => 'N']],
+    'merges normal with 80+' => [['0' => 'E']],
+    'collides with default' => [['5' => 'P']],
+]);
+
+it('accepts a full custom map', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe(['0' => 'X', '10' => 'Y', '20' => 'Z']);
+});
+
+it('sequences prefixes independently', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    $codes = [$issue($queue, 0)->code, $issue($queue, 0)->code, $issue($queue, 10)->code, $issue($queue, 10)->code, $issue($queue, 20)->code];
+
+    expect($codes)->toBe(['N001', 'N002', 'P001', 'P002', 'E001']);
+});
+
+it('restarts the sequence every day', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    $this->travelTo(now()->setTime(23, 59));
+    $issue($queue);
+    $second = $issue($queue);
+
+    $this->travelTo(now()->addDay()->setTime(0, 1));
+    $next = $issue($queue);
+
+    expect($second->code)->toBe('N002')
+        ->and($next->code)->toBe('N001')
+        ->and($next->issue_date->toDateString())->toBe(now()->toDateString())
+        ->and($next->issued_at->toDateString())->toBe($next->issue_date->toDateString());
+});
+
+it('ignores legacy and malformed codes', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+    expect(Ticket::nextCode($queue->id, 'N'))->toBe('N001');
+
+    Ticket::factory()->for($queue)->create(['code' => 'N001']);
+    Ticket::factory()->for($queue)->create(['code' => 'N-X']);
+    expect(Ticket::nextCode($queue->id, 'N'))->toBe('N002');
+});
+
+it('aligns factory issue_date and code day with issued_at', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $old = Ticket::factory()->forQueue($queue)->create(['issued_at' => '2026-09-28 10:00:00']);
+    $oldNext = Ticket::factory()->forQueue($queue)->create(['issued_at' => '2026-09-28 11:00:00']);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+    $explicit = Ticket::factory()->forQueue($queue)->create(['code' => 'Z9']);
+
+    expect($old->code)->toBe('N001')
+        ->and($old->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($oldNext->code)->toBe('N002')
+        ->and($priority->code)->toBe('P001')
+        ->and($explicit->code)->toBe('Z9');
+});
+
+it('updates the map through UpdateQueue', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $update = new UpdateQueue;
+
+    $update($queue, $owner, priorityPrefixMap: ['0' => 'X']);
+    expect($queue->fresh()->priority_prefix_map)->toBe(['0' => 'X']);
+
+    $update($queue, $owner, name: 'Renamed');
+    expect($queue->fresh()->priority_prefix_map)->toBe(['0' => 'X']);
+
+    expect(fn () => $update($queue, $owner, name: 'Other', priorityPrefixMap: ['0' => 'E']))
+        ->toThrow(ValidationException::class);
+    expect($queue->fresh())->name->toBe('Renamed')->priority_prefix_map->toBe(['0' => 'X']);
+
+    $update($queue, $owner, priorityPrefixMap: []);
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
