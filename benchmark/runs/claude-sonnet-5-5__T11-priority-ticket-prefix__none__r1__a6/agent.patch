     /** @use HasFactory<QueueFactory> */
     use HasFactory;
 
+    /**
+     * Default display-code letter per priority level (Normal / Priority / 80+).
+     *
+     * @var array<int, string>
+     */
+    public const DEFAULT_PREFIX_MAP = [0 => 'N', 10 => 'P', 20 => 'E'];
+
+    /**
+     * Default letter for a priority value: exact level, else by range
+     * (<= 0 Normal, >= 20 80+, anything in between Priority).
+     */
+    public static function defaultPrefixFor(int $priority): string
+    {
+        return self::DEFAULT_PREFIX_MAP[$priority] ?? match (true) {
+            $priority <= 0 => self::DEFAULT_PREFIX_MAP[0],
+            $priority >= 20 => self::DEFAULT_PREFIX_MAP[20],
+            default => self::DEFAULT_PREFIX_MAP[10],
+        };
+    }
+
+    /**
+     * Display-code letter for a priority: the queue's custom entry, else the default.
+     */
+    public function prefixForPriority(int $priority): string
+    {
+        $map = $this->priority_prefix_map;
+
+        if (is_array($map) && is_string($map[$priority] ?? null)) {
+            return $map[$priority];
+        }
+
+        return self::defaultPrefixFor($priority);
+    }
+
+    /**
+     * Validate a priority -> letter map.
+     *
+     * @param  array<array-key, mixed>  $map
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function assertValidPriorityPrefixMap(array $map): void
+    {
+        $letters = [];
+
+        foreach ($map as $key => $letter) {
+            if (! preg_match('/^(0|[1-9][0-9]*)$/', (string) $key)) {
+                throw new InvalidArgumentException("Priority prefix map key [{$key}] must be a non-negative integer.");
+            }
+
+            if (! is_string($letter) || ! preg_match('/^[A-Z]$/', $letter)) {
+                throw new InvalidArgumentException("Priority prefix for [{$key}] must be a single uppercase letter A-Z.");
+            }
+
+            $letters[(string) $key] = $letter;
+        }
+
+        // Uncovered default levels keep their default letter, which must stay distinct too.
+        foreach (self::DEFAULT_PREFIX_MAP as $level => $default) {
+            $letters[(string) $level] ??= $default;
+        }
+
+        if (count($letters) !== count(array_unique($letters))) {
+            throw new InvalidArgumentException('Priority prefixes must be unique per queue.');
+        }
+    }
+
+    protected static function booted(): void
+    {
+        static::saving(function (Queue $queue): void {
+            $map = $queue->priority_prefix_map;
+
+            if ($map === null || $map === []) {
+                $queue->priority_prefix_map = null;
+
+                return;
+            }
+
+            if (! is_array($map)) {
+                throw new InvalidArgumentException('Priority prefix map must be an array.');
+            }
+
+            self::assertValidPriorityPrefixMap($map);
+        });
+    }
