@@ -0,0 +1,51 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use App\Http\Controllers\Controller;
+use App\Support\TotemToken;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    public function __invoke(Request $request, PairTotem $pairTotem): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || ! preg_match('/\A\d{6}\z/', $code)) {
+            $this->auditFailure($request, 'invalid_code_format');
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        try {
+            $paired = $pairTotem($code);
+        } catch (InvalidPairingCodeException $e) {
+            $this->auditFailure($request, $e->reason);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        $entity = $paired['preset']->entity;
+
+        return response()->json([
+            'token' => $paired['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => TotemToken::ttl(),
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+        ]);
+    }
+
+    // The submitted code is deliberately never logged.
+    private function auditFailure(Request $request, string $reason): void
+    {
+        Log::channel('audit')->warning('Totem pairing failed', [
+            'reason' => $reason,
+            'ip' => $request->ip(),
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemQueueController.php b/app/Http/Controllers/Api/TotemQueueController.php
new file mode 100644
index 0000000..0555e37
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemQueueController.php
@@ -0,0 +1,150 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\TotemApiException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Totem data endpoints. Runs behind `totem.auth`; the entity comes from the
+ * token, path slugs are only checked against it, never trusted on their own.
+ */
+class TotemQueueController extends Controller
+{
+    private const DEFAULT_QUEUE_COLOR = '#0055FF';
+
+    private const DEFAULT_QUEUE_ICON = 'ticket';
+
+    public function index(Request $request, string $entity): JsonResponse
+    {
+        $tokenEntity = $this->tokenEntity($request, $entity);
+        $preset = $request->attributes->get('totem_preset');
+
+        $queues = Queue::query()
+            ->where('entity_id', $tokenEntity->id)
+            ->whereIn('id', $request->attributes->get('totem_queue_ids'))
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->values()
+            ->map(function (Queue $queue, int $position) use ($preset): array {
+                $look = $this->appearance($preset, $queue);
+
+                return [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => $look['description'] ?? null,
+                    'visual' => [
+                        'color' => $look['color'] ?? self::DEFAULT_QUEUE_COLOR,
+                        'icon' => $look['icon'] ?? self::DEFAULT_QUEUE_ICON,
+                        'order' => $position + 1,
+                    ],
+                    'is_active' => true,
+                ];
+            });
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug, 'name' => $tokenEntity->name],
+            'queues' => $queues,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $tokenEntity = $this->tokenEntity($request, $entity);
+        $queue = $this->issuableQueue($request, $tokenEntity, $queue);
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug],
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priorities' => collect(TicketPriority::cases())->map(fn (TicketPriority $priority, int $position) => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+                'visual' => $priority->visual() + ['order' => $position + 1],
+            ])->values(),
+        ]);
+    }
+
+    public function ticket(Request $request, string $entity, string $queue, IssueTicket $issueTicket): JsonResponse
+    {
+        $tokenEntity = $this->tokenEntity($request, $entity);
+        $queue = $this->issuableQueue($request, $tokenEntity, $queue);
+
+        $value = filter_var($request->input('priority'), FILTER_VALIDATE_INT);
+        $priority = $value === false || is_bool($request->input('priority'))
+            ? null
+            : TicketPriority::tryFrom($value);
+
+        if (! $priority) {
+            throw new TotemApiException('invalid_priority', 422);
+        }
+
+        try {
+            $ticket = $issueTicket($queue, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            throw new TotemApiException('inactive_queue', 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priority' => ['value' => $priority->value, 'label' => $priority->label()],
+            'issued_at' => $ticket->issued_at->utc()->toIso8601ZuluString(),
+        ], 201);
+    }
+
+    private function tokenEntity(Request $request, string $slug): Entity
+    {
+        $entity = $request->attributes->get('totem_entity');
+
+        if ($entity->slug !== $slug) {
+            throw new TotemApiException('forbidden', 403);
+        }
+
+        return $entity;
+    }
+
+    /**
+     * Resolve the queue within the token's entity only, enforce the effective
+     * preset scope and require it to be active.
+     */
+    private function issuableQueue(Request $request, Entity $entity, string $slug): Queue
+    {
+        $queue = Queue::query()->where('entity_id', $entity->id)->where('slug', $slug)->first();
+
+        if (! $queue) {
+            throw new TotemApiException('queue_not_found', 404);
+        }
+
+        if (! in_array($queue->id, $request->attributes->get('totem_queue_ids'), true)) {
+            throw new TotemApiException('forbidden', 403);
+        }
+
+        if (! $queue->is_active) {
+            throw new TotemApiException('inactive_queue', 422);
+        }
+
+        return $queue;
+    }
+
+    /**
+     * Optional per-queue presentation override: appearance.queues.<slug>.{color,icon,description}.
+     *
+     * @return array<string, mixed>
+     */
+    private function appearance(TotemPreset $preset, Queue $queue): array
+    {
+        $override = $preset->appearance['queues'][$queue->slug] ?? [];
+
+        return is_array($override) ? $override : [];
+    }
+}
diff --git a/app/Http/Middleware/AuthenticateTotem.php b/app/Http/Middleware/AuthenticateTotem.php
new file mode 100644
index 0000000..1aebd77
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Exceptions\TotemApiException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemToken;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Validates the totem JWT on every call and re-checks server-side state
+ * (totem/preset active, entity consistency) so revocation is immediate.
+ *
+ * Exposes on the request: `totem`, `totem_preset`, `totem_entity` and
+ * `totem_queue_ids` (JWT queues claim ∩ the preset's current queue join).
+ */
+class AuthenticateTotem
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+        $claims = $token ? TotemToken::decode($token) : null;
+
+        if (! $claims) {
+            throw self::invalidToken();
+        }
+
+        $totem = Totem::query()->find($claims['totem_id']);
+        $preset = TotemPreset::query()->with('entity')->find($claims['preset_id']);
+
+        if (
+            ! $totem || ! $totem->is_active
+            || ! $preset || ! $preset->is_active
+            || ! $preset->entity
+            || $totem->entity_id !== $claims['entity_id']
+            || $preset->entity_id !== $claims['entity_id']
+        ) {
+            throw self::invalidToken();
+        }
+
+        $totem->timestamps = false;
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $currentQueueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $preset->entity);
+        $request->attributes->set('totem_queue_ids', array_values(array_intersect($claims['queues'], $currentQueueIds)));
+
+        return $next($request);
+    }
+
+    private static function invalidToken(): TotemApiException
+    {
+        return new TotemApiException('invalid_token', 401);
+    }
+}
