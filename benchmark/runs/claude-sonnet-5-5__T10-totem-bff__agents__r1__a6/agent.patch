+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned priority levels: the single source for the totem priorities
+ * endpoint and for issuance validation. Higher value = more prioritized.
+ */
+enum TicketPriority: int
+{
+    case Normal = 0;
+    case Priority = 10;
+    case Priority80 = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Priority => 'Prioritário',
+            self::Priority80 => 'Prioridade 80+',
+        };
+    }
+
+    /**
+     * @return array{color: string, icon: string}
+     */
+    public function visual(): array
+    {
+        return match ($this) {
+            self::Normal => ['color' => '#2E7D32', 'icon' => 'person'],
+            self::Priority => ['color' => '#C62828', 'icon' => 'priority'],
+            self::Priority80 => ['color' => '#6A1B9A', 'icon' => 'elderly'],
+        };
+    }
+}
