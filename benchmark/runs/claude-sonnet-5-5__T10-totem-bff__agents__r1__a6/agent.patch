+<?php
+
+namespace App\Exceptions;
+
+use Illuminate\Http\JsonResponse;
+use RuntimeException;
+
+/**
+ * Explicit totem API failure rendered as {"code": "..."} with its HTTP status.
+ */
+class TotemApiException extends RuntimeException
+{
+    public function __construct(public readonly string $errorCode, public readonly int $status)
+    {
+        parent::__construct($errorCode);
+    }
+
+    public function render(): JsonResponse
+    {
+        return response()->json(['code' => $this->errorCode], $this->status);
+    }
+}
