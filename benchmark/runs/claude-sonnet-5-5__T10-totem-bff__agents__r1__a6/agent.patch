+++ b/tests/Feature/Api/TotemTokenTest.php
@@ -0,0 +1,49 @@
+<?php
+
+use App\Support\TotemToken;
+
+function b64u(string $s): string
+{
+    return rtrim(strtr(base64_encode($s), '+/', '-_'), '=');
+}
+
+function forgedToken(array $header, array $claims, ?string $secret = null): string
+{
+    $input = b64u(json_encode($header)).'.'.b64u(json_encode($claims));
+
+    return $input.'.'.b64u(hash_hmac('sha256', $input, $secret ?? config('services.totem.jwt_secret'), true));
+}
+
+function validClaims(array $override = []): array
+{
+    return $override + ['totem_id' => 1, 'entity_id' => 2, 'preset_id' => 3, 'queues' => [4], 'iat' => time(), 'exp' => time() + 60, 'jti' => 'x'];
+}
+
+it('round-trips claims', function () {
+    $token = TotemToken::issue(1, 2, 3, [4, 5]);
+
+    expect(TotemToken::decode($token))->toBe(['totem_id' => 1, 'entity_id' => 2, 'preset_id' => 3, 'queues' => [4, 5]]);
+});
+
+it('accepts a correctly signed HS256 token', function () {
+    expect(TotemToken::decode(forgedToken(['alg' => 'HS256'], validClaims())))->not->toBeNull();
+});
+
+it('rejects invalid tokens', function (Closure $make) {
+    expect(TotemToken::decode($make()))->toBeNull();
+})->with([
+    'garbage' => fn () => 'nope',
+    'wrong secret' => fn () => forgedToken(['alg' => 'HS256'], validClaims(), str_repeat('x', 40)),
+    'alg none' => fn () => b64u('{"alg":"none"}').'.'.b64u(json_encode(validClaims())).'.',
+    'alg none with signature' => fn () => forgedToken(['alg' => 'none'], validClaims()),
+    'alg HS512' => fn () => forgedToken(['alg' => 'HS512'], validClaims()),
+    'expired' => fn () => forgedToken(['alg' => 'HS256'], validClaims(['exp' => time() - 1])),
