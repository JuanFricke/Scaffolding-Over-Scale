@@ -0,0 +1,123 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemToken;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\RateLimiter;
+
+uses(RefreshDatabase::class);
+
+function jwtClaims(string $jwt): array
+{
+    return json_decode(base64_decode(strtr(explode('.', $jwt)[1], '-_', '+/')), true);
+}
+
+it('pairs with a valid code and returns a signed JWT plus the entity', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '123456']);
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+
+    $response->assertJson([
+        'token_type' => 'Bearer',
+        'expires_in' => 3600,
+        'entity' => ['slug' => $preset->entity->slug, 'name' => $preset->entity->name],
+    ]);
+
+    $totem = Totem::query()->sole();
+    expect($totem)
+        ->entity_id->toBe($preset->entity_id)
+        ->is_active->toBeTrue()
+        ->last_seen_at->not->toBeNull();
+
+    $claims = jwtClaims($response->json('token'));
+    expect($claims)
+        ->toMatchArray(['totem_id' => $totem->id, 'entity_id' => $preset->entity_id, 'preset_id' => $preset->id, 'queues' => [$queue->id]])
+        ->and($claims['exp'] - $claims['iat'])->toBe(3600)
+        ->and($claims['jti'])->not->toBeEmpty();
+
+    expect($preset->fresh()->login_code_consumed_at)->not->toBeNull();
+});
+
+it('rejects a second use of the same code', function () {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => '123456'])
+        ->assertStatus(401)->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1);
+});
+
+it('rejects a malformed code with 400', function (mixed $code) {
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)->assertExactJson(['code' => 'invalid_code_format']);
+})->with(['empty' => '', 'short' => '12345', 'long' => '1234567', 'letters' => '12345a', 'int' => 123456, 'null' => null, 'array' => [['1']]]);
+
+it('rejects a missing code with 400', function () {
+    $this->postJson('/api/totem/auth')->assertStatus(400)->assertExactJson(['code' => 'invalid_code_format']);
+});
+
+it('answers every unusable code with the same 401', function (string $case) {
+    $state = match ($case) {
+        'expired' => ['login_code_expires_at' => now()->subSecond()],
+        'consumed' => ['login_code_consumed_at' => now()->subMinute()],
+        'inactive preset' => ['is_active' => false],
+    };
+    TotemPreset::factory()->create(['login_code' => '654321'] + $state);
+
+    $this->postJson('/api/totem/auth', ['code' => '654321'])
+        ->assertStatus(401)->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+})->with(['expired', 'consumed', 'inactive preset']);
+
+it('answers an unknown code with 401', function () {
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(401)->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('audits success and failure without logging the full code', function () {
+    $audit = Log::spy();
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => '999999'])->assertStatus(401);
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk();
+
+    $audit->shouldHaveReceived('warning')->once()->with('Totem pairing failed', Mockery::on(
+        fn ($ctx) => ! str_contains(json_encode($ctx), '999999')
+    ));
+    $audit->shouldHaveReceived('info')->once()->with('Totem pairing succeeded', Mockery::on(
+        fn ($ctx) => ! str_contains(json_encode($ctx), '123456')
+    ));
+});
+
+it('throttles pairing attempts to 10 per minute with a JSON 429', function () {
+    RateLimiter::clear('totem-auth');
+
+    foreach (range(1, 10) as $i) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(429)->assertExactJson(['code' => 'rate_limited']);
+});
+
+it('fails closed when the JWT secret is too short', function () {
+    config(['services.totem.jwt_secret' => 'short']);
+
+    expect(fn () => TotemToken::issue(1, 1, 1, []))->toThrow(RuntimeException::class);
+    expect(fn () => TotemToken::decode('a.b.c'))->toThrow(RuntimeException::class);
+});
+
+it('signs tokens from config TTL', function () {
+    config(['services.totem.jwt_ttl' => 60]);
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    $this->postJson('/api/totem/auth', ['code' => '123456'])->assertOk()->assertJson(['expires_in' => 60]);
+});
