+<?php
+
+use App\Actions\OpenTotemPairing;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+it('opens a pairing window and prints the code', function () {
+    $preset = TotemPreset::factory()->create([
+        'login_code' => '111111',
+        'login_code_expires_at' => now()->subHour(),
+        'login_code_consumed_at' => now()->subHour(),
+    ]);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful()->expectsOutputToContain('Pairing code');
+
+    $fresh = $preset->fresh();
+    expect($fresh->login_code)->toMatch('/\A\d{6}\z/')
+        ->and($fresh->login_code_consumed_at)->toBeNull()
+        ->and($fresh->login_code_expires_at->diffInSeconds(now()->addMinutes(10), true))->toBeLessThan(3);
+});
+
+it('prints the generated code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $exit = Artisan::call('totem:pairing-code', ['preset' => $preset->id]);
+    $output = Artisan::output();
+
+    expect($exit)->toBe(0);
+
+    expect($output)->toContain($preset->fresh()->login_code);
+});
+
+it('generates a 6-digit code that can pair', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => null, 'login_code_expires_at' => null]);
+
+    $code = (new OpenTotemPairing)($preset);
+
+    expect($code)->toMatch('/\A\d{6}\z/');
+    $this->postJson('/api/totem/auth', ['code' => $code])->assertOk();
+});
+
+it('replaces the previous code', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '111111']);
+    $opener = new OpenTotemPairing;
+
+    // Retry until the new code differs (1-in-a-million collision otherwise).
+    $new = $opener($preset);
+    while ($new === '111111') {
+        $new = $opener($preset);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '111111'])->assertStatus(401);
+    $this->postJson('/api/totem/auth', ['code' => $new])->assertOk();
+});
+
+it('never hands out a code held by another preset', function () {
+    TotemPreset::factory()->create(['login_code' => '000000']);
+    $preset = TotemPreset::factory()->create();
+
+    foreach (range(1, 20) as $i) {
+        expect((new OpenTotemPairing)($preset))->not->toBe('000000');
+    }
+});
+
+it('fails for an unknown preset', function (string $id) {
+    $this->artisan('totem:pairing-code', ['preset' => $id])
+        ->expectsOutputToContain('not found')
+        ->assertFailed();
+})->with(['999', 'abc']);
+
+it('audits the window without logging the code', function () {
+    $audit = Log::spy();
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+    $preset = TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    $audit->shouldHaveReceived('info')->once()->with('Totem pairing window opened', Mockery::on(
+        fn ($ctx) => $ctx['preset_id'] === $preset->id && ! str_contains(json_encode($ctx), $preset->fresh()->login_code)
+    ));
+});
