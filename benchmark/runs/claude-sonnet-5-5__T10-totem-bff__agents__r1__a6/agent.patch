+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+it('builds a ready-to-use preset with a unique code', function () {
+    $presets = TotemPreset::factory()->count(5)->create();
+
+    expect($presets->pluck('login_code')->unique())->toHaveCount(5);
+
+    $preset = $presets->first();
+    expect($preset->login_code)->toMatch('/\A\d{6}\z/')
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->is_active)->toBeTrue()
+        ->and($preset->login_code_expires_at->diffInSeconds(now()->addMinutes(10), true))->toBeLessThan(3)
+        ->and($preset->entity)->not->toBeNull();
+});
+
+it('enforces unique login codes', function () {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+
+    expect(fn () => TotemPreset::factory()->create(['login_code' => '123456']))->toThrow(QueryException::class);
+});
+
+it('relates entities, presets, totems and queues', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $totem = Totem::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue);
+
+    expect($preset->queues->pluck('id')->all())->toBe([$queue->id])
+        ->and($preset->entity->totemPresets->pluck('id')->all())->toBe([$preset->id])
+        ->and($preset->entity->totems->pluck('id')->all())->toBe([$totem->id])
+        ->and($totem->is_active)->toBeTrue();
+
+    $preset->queues()->detach($queue);
+    expect($preset->queues()->count())->toBe(0);
+});
+
+it('does not allow attaching the same queue twice', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue);
+
+    expect(fn () => $preset->queues()->attach($queue))->toThrow(QueryException::class);
+});
+
+it('cascades deletes from the entity', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue);
+    Totem::factory()->for($preset->entity)->create();
+
+    $preset->entity->forceDelete();
+
+    expect(TotemPreset::query()->count())->toBe(0)->and(Totem::query()->count())->toBe(0);
+    expect(DB::table('totem_preset_queue')->count())->toBe(0);
+});
