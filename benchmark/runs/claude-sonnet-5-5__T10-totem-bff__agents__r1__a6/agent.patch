@@ -0,0 +1,48 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Opens a pairing window: a fresh single-use code for the preset, valid 10 minutes.
+ *
+ * Invoked from the operator console (`totem:pairing-code`); there is no HTTP
+ * actor to authorize, and the code is never returned by any public API.
+ */
+class OpenTotemPairing
+{
+    public const TTL_MINUTES = 10;
+
+    public function __invoke(TotemPreset $preset): string
+    {
+        $code = $this->uniqueCode($preset);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(self::TTL_MINUTES),
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        Log::channel('audit')->info('Totem pairing window opened', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $preset->login_code_expires_at->toIso8601String(),
+        ]);
+
+        return $code;
+    }
+
+    /**
+     * login_code is unique across presets, so skip codes held by any other one.
+     */
+    private function uniqueCode(TotemPreset $preset): string
+    {
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while (TotemPreset::query()->where('login_code', $code)->whereKeyNot($preset->id)->exists());
+
+        return $code;
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
new file mode 100644
index 0000000..b0475e6
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemToken;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Exchanges a pairing code for a totem device row + JWT.
+ *
+ * The pairing code is the credential (unauthenticated endpoint); every
+ * failure reason collapses to one client response upstream (no oracle).
+ */
+class PairTotem
+{
+    /**
+     * @return array{totem: Totem, preset: TotemPreset, token: string}
+     *
+     * @throws InvalidPairingCodeException
+     */
+    public function __invoke(string $code): array
+    {
+        $result = DB::transaction(function () use ($code): array {
+            // The row lock makes "consume exactly once" hold under concurrent attempts.
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (! $preset) {
+                throw new InvalidPairingCodeException('unknown_code');
+            }
+
+            if ($preset->login_code_consumed_at !== null) {
+                throw new InvalidPairingCodeException('consumed');
+            }
+
+            if ($preset->login_code_expires_at === null || $preset->login_code_expires_at->lte(now())) {
+                throw new InvalidPairingCodeException('expired');
+            }
+
+            if (! $preset->is_active) {
+                throw new InvalidPairingCodeException('inactive_preset');
+            }
+
+            if (! $preset->entity) {
+                throw new InvalidPairingCodeException('entity_missing');
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+
+            return [
+                'totem' => $totem,
+                'preset' => $preset,
+                'token' => TotemToken::issue($totem->id, $preset->entity_id, $preset->id, $queueIds),
+            ];
+        });
+
+        Log::channel('audit')->info('Totem pairing succeeded', [
+            'preset_id' => $result['preset']->id,
+            'entity_id' => $result['preset']->entity_id,
+            'totem_id' => $result['totem']->id,
+        ]);
+
+        return $result;
+    }
+}
