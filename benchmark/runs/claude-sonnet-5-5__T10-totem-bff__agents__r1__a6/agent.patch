new file mode 100644
index 0000000..332919a
--- /dev/null
+++ b/app/Support/TotemToken.php
@@ -0,0 +1,138 @@
+<?php
+
+namespace App\Support;
+
+use RuntimeException;
+
+/**
+ * Minimal HS256 JWT codec for totem credentials.
+ *
+ * Verification is strict: only `alg: HS256` is accepted (never `none`), the
+ * signature is compared in constant time, and `exp`/claim types are checked.
+ */
+class TotemToken
+{
+    private const MIN_SECRET_BYTES = 32;
+
+    /**
+     * @param  list<int>  $queueIds
+     */
+    public static function issue(int $totemId, int $entityId, int $presetId, array $queueIds): string
+    {
+        $now = now()->getTimestamp();
+
+        return self::encode([
+            'totem_id' => $totemId,
+            'entity_id' => $entityId,
+            'preset_id' => $presetId,
+            'queues' => array_values($queueIds),
+            'iat' => $now,
+            'exp' => $now + self::ttl(),
+            'jti' => bin2hex(random_bytes(16)),
+        ]);
+    }
+
+    public static function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl', 3600);
+    }
+
+    /**
+     * @return array{totem_id: int, entity_id: int, preset_id: int, queues: list<int>}|null null when invalid or expired
+     */
+    public static function decode(string $token): ?array
+    {
+        $parts = explode('.', $token);
+
+        if (count($parts) !== 3) {
+            return null;
+        }
+
+        [$header, $payload, $signature] = $parts;
+
+        $given = self::base64UrlDecode($signature);
+        $expected = hash_hmac('sha256', $header.'.'.$payload, self::secret(), true);
+
+        if ($given === null || ! hash_equals($expected, $given)) {
+            return null;
+        }
+
+        $head = self::decodeJson($header);
+        $claims = self::decodeJson($payload);
+
+        if (($head['alg'] ?? null) !== 'HS256' || $claims === null) {
+            return null;
+        }
+
+        $exp = $claims['exp'] ?? null;
+
+        if (! is_int($exp) || $exp <= now()->getTimestamp()) {
+            return null;
+        }
+
+        foreach (['totem_id', 'entity_id', 'preset_id'] as $key) {
+            if (! is_int($claims[$key] ?? null)) {
+                return null;
+            }
+        }
+
+        $queues = $claims['queues'] ?? null;
+
+        if (! is_array($queues) || array_filter($queues, fn ($id) => ! is_int($id)) !== []) {
+            return null;
+        }
+
+        return [
+            'totem_id' => $claims['totem_id'],
+            'entity_id' => $claims['entity_id'],
+            'preset_id' => $claims['preset_id'],
+            'queues' => array_values($queues),
+        ];
+    }
+
+    /**
+     * @param  array<string, mixed>  $claims
+     */
+    private static function encode(array $claims): string
+    {
+        $signingInput = self::base64UrlEncode(json_encode(['typ' => 'JWT', 'alg' => 'HS256'], JSON_THROW_ON_ERROR))
+            .'.'.self::base64UrlEncode(json_encode($claims, JSON_THROW_ON_ERROR));
+
+        return $signingInput.'.'.self::base64UrlEncode(hash_hmac('sha256', $signingInput, self::secret(), true));
+    }
+
+    private static function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        // Fail closed: an unset/weak secret must never sign or verify tokens.
+        if (strlen($secret) < self::MIN_SECRET_BYTES) {
+            throw new RuntimeException('TOTEM_JWT_SECRET must be set to at least 32 characters.');
+        }
+
+        return $secret;
+    }
+
+    /**
+     * @return array<string, mixed>|null
+     */
+    private static function decodeJson(string $segment): ?array
+    {
+        $json = self::base64UrlDecode($segment);
+        $data = $json === null ? null : json_decode($json, true);
+
+        return is_array($data) ? $data : null;
+    }
+
+    private static function base64UrlEncode(string $data): string
+    {
+        return rtrim(strtr(base64_encode($data), '+/', '-_'), '=');
+    }
+
+    private static function base64UrlDecode(string $data): ?string
+    {
+        $decoded = base64_decode(strtr($data, '-_', '+/'), true);
+
+        return $decoded === false ? null : $decoded;
+    }
+}
