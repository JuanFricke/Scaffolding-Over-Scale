@@ -0,0 +1,33 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Actions\OpenTotemPairing;
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+
+#[Signature('totem:pairing-code {preset : Totem preset id}')]
+#[Description('Open a pairing window: generate a single-use 6-digit code (valid 10 minutes) for a totem preset')]
+class PairingCode extends Command
+{
+    public function handle(OpenTotemPairing $openPairing): int
+    {
+        $id = (string) $this->argument('preset');
+        $preset = ctype_digit($id) ? TotemPreset::query()->find((int) $id) : null;
+
+        if (! $preset) {
+            $this->error("Totem preset [{$id}] not found.");
+
+            return self::FAILURE;
+        }
+
+        $code = $openPairing($preset);
+
+        $this->info("Pairing code for preset [{$preset->name}]: {$code}");
+        $this->line('Valid for '.OpenTotemPairing::TTL_MINUTES.' minutes, single use.');
+
+        return self::SUCCESS;
+    }
+}
