@@ -0,0 +1,39 @@
+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('answers the preflight for loopback origins', function (string $origin) {
+    $this->call('OPTIONS', '/api/totem/auth', server: [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+        'HTTP_ACCESS_CONTROL_REQUEST_HEADERS' => 'content-type,authorization',
+    ])
+        ->assertNoContent()
+        ->assertHeader('Access-Control-Allow-Origin', $origin)
+        ->assertHeaderMissing('Access-Control-Allow-Credentials');
+})->with(['http://localhost:8081', 'https://localhost', 'http://127.0.0.1:5000']);
+
+it('sends CORS headers on actual responses', function () {
+    $this->postJson('/api/totem/auth', ['code' => 'x'], ['Origin' => 'http://localhost:8081'])
+        ->assertStatus(400)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+});
+
+it('sends no allow-origin header to other origins', function (string $origin) {
+    $this->call('OPTIONS', '/api/totem/auth', server: [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ])->assertHeaderMissing('Access-Control-Allow-Origin');
+
+    $this->postJson('/api/totem/auth', ['code' => 'x'], ['Origin' => $origin])
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+})->with(['https://evil.example', 'http://localhost.evil.example', 'http://evil.example/localhost', 'http://localhostx:80', 'ftp://localhost']);
+
+it('allows the optional TOTEM_WEB_ORIGIN', function () {
+    config(['cors.allowed_origins' => ['https://totem.example.com']]);
+
+    $this->postJson('/api/totem/auth', ['code' => 'x'], ['Origin' => 'https://totem.example.com'])
+        ->assertHeader('Access-Control-Allow-Origin', 'https://totem.example.com');
+});
diff --git a/tests/Feature/Api/TotemEndpointsTest.php b/tests/Feature/Api/TotemEndpointsTest.php
new file mode 100644
index 0000000..d28ea1a
--- /dev/null
+++ b/tests/Feature/Api/TotemEndpointsTest.php
@@ -0,0 +1,255 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemToken;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\RateLimiter;
+
+uses(RefreshDatabase::class);
+
+/**
+ * A paired totem: preset with the given queues, totem row and a valid token.
+ *
+ * @return array{preset: TotemPreset, totem: Totem, entity: Entity, token: string, queues: list<Queue>, headers: array<string, string>}
+ */
+function pairedTotem(int $queueCount = 1, array $queueState = []): array
+{
+    $preset = TotemPreset::factory()->create();
+    $entity = $preset->entity;
+    $queues = [];
+
+    foreach (range(1, $queueCount) as $i) {
+        $queues[] = Queue::factory()->for($entity)->create($queueState);
+    }
+
+    $preset->queues()->attach(collect($queues)->pluck('id'));
+    $totem = Totem::factory()->for($entity)->create();
+    $token = TotemToken::issue($totem->id, $entity->id, $preset->id, collect($queues)->pluck('id')->all());
+
+    return compact('preset', 'totem', 'entity', 'token', 'queues') + ['headers' => ['Authorization' => "Bearer {$token}"]];
+}
+
+// --- middleware -----------------------------------------------------------
+
+it('rejects calls without a valid token', function (?string $header) {
+    $t = pairedTotem();
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $header === null ? [] : ['Authorization' => $header])
+        ->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+})->with([
+    'missing' => null,
+    'garbage' => 'Bearer abc',
+    'wrong scheme' => 'Basic abc',
+]);
+
+it('rejects an expired token', function () {
+    $t = pairedTotem();
+    $this->travel(3601)->seconds();
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])
+        ->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects a revoked totem, inactive preset, missing rows and entity mismatch', function (string $case) {
+    $t = pairedTotem();
+    match ($case) {
+        'totem inactive' => $t['totem']->update(['is_active' => false]),
+        'totem deleted' => $t['totem']->delete(),
+        'preset inactive' => $t['preset']->update(['is_active' => false]),
+        'preset deleted' => $t['preset']->delete(),
+        'totem of another entity' => $t['totem']->update(['entity_id' => Entity::factory()->create()->id]),
+        'preset of another entity' => $t['preset']->update(['entity_id' => Entity::factory()->create()->id]),
+        'entity soft-deleted' => $t['entity']->delete(),
+    };
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])
+        ->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+})->with(['totem inactive', 'totem deleted', 'preset inactive', 'preset deleted', 'totem of another entity', 'preset of another entity', 'entity soft-deleted']);
+
+it('quietly updates last_seen_at', function () {
+    $t = pairedTotem();
+    $this->travelTo(now()->addMinutes(5));
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])->assertOk();
+
+    expect($t['totem']->fresh()->last_seen_at->toDateTimeString())->toBe(now()->toDateTimeString());
+});
+
+// --- queues ---------------------------------------------------------------
+
+it('lists only active preset queues of the entity ordered by name', function () {
+    $t = pairedTotem(0);
+    $entity = $t['entity'];
+    $b = Queue::factory()->for($entity)->create(['name' => 'Beta']);
+    $a = Queue::factory()->for($entity)->create(['name' => 'Alpha']);
+    $inactive = Queue::factory()->for($entity)->create(['name' => 'Gamma', 'is_active' => false]);
+    $outside = Queue::factory()->for($entity)->create(['name' => 'Delta']);
+    $foreign = Queue::factory()->create(['name' => 'Foreign']);
+    $t['preset']->queues()->attach([$a->id, $b->id, $inactive->id, $foreign->id]);
+    $token = TotemToken::issue($t['totem']->id, $entity->id, $t['preset']->id, [$a->id, $b->id, $inactive->id, $outside->id, $foreign->id]);
+
+    $response = $this->getJson("/api/{$entity->slug}/queues", ['Authorization' => "Bearer {$token}"])->assertOk();
+
+    $response->assertJsonPath('entity', ['slug' => $entity->slug, 'name' => $entity->name]);
+    expect($response->json('queues'))->toBe([
+        ['slug' => $a->slug, 'label' => 'Alpha', 'description' => null, 'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => 1], 'is_active' => true],
+        ['slug' => $b->slug, 'label' => 'Beta', 'description' => null, 'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => 2], 'is_active' => true],
+    ]);
+});
+
+it('applies per-queue appearance overrides from the preset', function () {
+    $t = pairedTotem();
+    $slug = $t['queues'][0]->slug;
+    $t['preset']->update(['appearance' => ['queues' => [$slug => ['color' => '#112233', 'icon' => 'star', 'description' => 'Atendimento geral']]]]);
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])
+        ->assertOk()
+        ->assertJsonPath('queues.0.description', 'Atendimento geral')
+        ->assertJsonPath('queues.0.visual.color', '#112233')
+        ->assertJsonPath('queues.0.visual.icon', 'star');
+});
+
+it('applies queue removal from the preset immediately to existing tokens', function () {
+    $t = pairedTotem(2);
+    $t['preset']->queues()->detach($t['queues'][0]->id);
+    $gone = $t['queues'][0];
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])
+        ->assertOk()->assertJsonCount(1, 'queues')->assertJsonPath('queues.0.slug', $t['queues'][1]->slug);
+
+    $this->getJson("/api/{$t['entity']->slug}/{$gone->slug}/priorities", $t['headers'])
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+});
+
+it('does not grant queues added to the preset after pairing', function () {
+    $t = pairedTotem();
+    $late = Queue::factory()->for($t['entity'])->create();
+    $t['preset']->queues()->attach($late);
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])->assertJsonCount(1, 'queues');
+    $this->getJson("/api/{$t['entity']->slug}/{$late->slug}/priorities", $t['headers'])->assertStatus(403);
+});
+
+it('forbids a path entity different from the token entity', function (string $method, string $suffix) {
+    $t = pairedTotem();
+    $other = Entity::factory()->create();
+
+    $this->json($method, "/api/{$other->slug}/{$suffix}", ['priority' => 0], $t['headers'])
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+    $this->json($method, "/api/unknown-entity/{$suffix}", ['priority' => 0], $t['headers'])
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+})->with([
+    ['GET', 'queues'],
+    ['GET', 'whatever/priorities'],
+    ['POST', 'whatever/ticket'],
+]);
+
+// --- priorities -----------------------------------------------------------
+
+it('serves the backend-owned priorities', function () {
+    $t = pairedTotem();
+    $queue = $t['queues'][0];
+
+    $response = $this->getJson("/api/{$t['entity']->slug}/{$queue->slug}/priorities", $t['headers'])->assertOk();
+
+    $response->assertJsonPath('entity', ['slug' => $t['entity']->slug])
+        ->assertJsonPath('queue', ['slug' => $queue->slug, 'label' => $queue->name]);
+    expect(collect($response->json('priorities'))->map(fn ($p) => [$p['value'], $p['label'], $p['visual']['order']])->all())
+        ->toBe([[0, 'Normal', 1], [10, 'Prioritário', 2], [20, 'Prioridade 80+', 3]]);
+    expect($response->json('priorities.0.visual'))->toHaveKeys(['color', 'icon', 'order']);
+});
+
+it('returns 404 for unknown queues, including other entities slugs', function (string $method) {
+    $t = pairedTotem();
+    $foreign = Queue::factory()->create();
+
+    foreach (['nope', $foreign->slug] as $slug) {
+        $this->json($method, "/api/{$t['entity']->slug}/{$slug}/".($method === 'GET' ? 'priorities' : 'ticket'), ['priority' => 0], $t['headers'])
+            ->assertStatus(404)->assertExactJson(['code' => 'queue_not_found']);
+    }
+})->with(['GET', 'POST']);
+
+it('returns 403 for a queue of the entity outside the preset scope', function () {
+    $t = pairedTotem();
+    $outside = Queue::factory()->for($t['entity'])->create();
+
+    $this->getJson("/api/{$t['entity']->slug}/{$outside->slug}/priorities", $t['headers'])
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+    $this->postJson("/api/{$t['entity']->slug}/{$outside->slug}/ticket", ['priority' => 0], $t['headers'])
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('returns 422 for an inactive queue', function () {
+    $t = pairedTotem(1, ['is_active' => false]);
+    $slug = $t['queues'][0]->slug;
+
+    $this->getJson("/api/{$t['entity']->slug}/{$slug}/priorities", $t['headers'])
+        ->assertStatus(422)->assertExactJson(['code' => 'inactive_queue']);
+    $this->postJson("/api/{$t['entity']->slug}/{$slug}/ticket", ['priority' => 0], $t['headers'])
+        ->assertStatus(422)->assertExactJson(['code' => 'inactive_queue']);
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+// --- ticket ---------------------------------------------------------------
+
+it('issues sequential totem tickets', function () {
+    $t = pairedTotem();
+    $queue = $t['queues'][0];
+    $url = "/api/{$t['entity']->slug}/{$queue->slug}/ticket";
+
+    $first = $this->postJson($url, ['priority' => 10], $t['headers'])->assertCreated();
+    $second = $this->postJson($url, ['priority' => 0], $t['headers'])->assertCreated();
+
+    $first->assertJsonPath('slug', 'A001')
+        ->assertJsonPath('queue', ['slug' => $queue->slug, 'label' => $queue->name])
+        ->assertJsonPath('priority', ['value' => 10, 'label' => 'Prioritário']);
+    $second->assertJsonPath('slug', 'A002')->assertJsonPath('priority', ['value' => 0, 'label' => 'Normal']);
+    expect(Carbon\Carbon::parse($first->json('issued_at'))->diffInSeconds(now(), true))->toBeLessThan(5);
+
+    $ticket = Ticket::query()->where('code', 'A001')->sole();
+    expect($ticket)->queue_id->toBe($queue->id)->priority->toBe(10)->channel->toBe(TicketChannel::Totem);
+});
+
+it('accepts the 80+ priority and integer strings', function () {
+    $t = pairedTotem();
+    $url = "/api/{$t['entity']->slug}/{$t['queues'][0]->slug}/ticket";
+
+    $this->postJson($url, ['priority' => 20], $t['headers'])->assertCreated()->assertJsonPath('priority.label', 'Prioridade 80+');
+    $this->postJson($url, ['priority' => '10'], $t['headers'])->assertCreated()->assertJsonPath('priority.value', 10);
+});
+
+it('rejects invalid priorities and creates nothing', function (mixed $payload) {
+    $t = pairedTotem();
+
+    $this->postJson("/api/{$t['entity']->slug}/{$t['queues'][0]->slug}/ticket", $payload, $t['headers'])
+        ->assertStatus(422)->assertExactJson(['code' => 'invalid_priority']);
+    expect(Ticket::query()->count())->toBe(0);
+})->with([
+    'unknown value' => [['priority' => 5]],
+    'negative' => [['priority' => -1]],
+    'missing' => [[]],
+    'string' => [['priority' => 'high']],
+    'float' => [['priority' => 10.5]],
+    'bool' => [['priority' => true]],
+    'null' => [['priority' => null]],
+    'array' => [['priority' => [10]]],
+]);
+
+it('throttles issuance to 30 per minute', function () {
+    RateLimiter::clear('totem-ticket');
+    $t = pairedTotem();
+    $url = "/api/{$t['entity']->slug}/{$t['queues'][0]->slug}/ticket";
+
+    foreach (range(1, 30) as $i) {
+        $this->postJson($url, ['priority' => 0], $t['headers'])->assertCreated();
+    }
+
+    $this->postJson($url, ['priority' => 0], $t['headers'])
+        ->assertStatus(429)->assertExactJson(['code' => 'rate_limited']);
+});
