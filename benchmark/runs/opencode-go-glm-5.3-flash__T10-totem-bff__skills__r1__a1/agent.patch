--- /dev/null
+++ b/tests/Feature/TotemQueuesTest.php
@@ -0,0 +1,175 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Pair a preset through the real pairing endpoint and return both halves.
+ */
+function totemPairFor(TotemPreset $preset): string
+{
+    return test()->postJson('/api/totem/auth', ['code' => $preset->fresh()->login_code])
+        ->assertOk()
+        ->json('token');
+}
+
+it('lists only the active queues of the preset scope ordered by name', function () {
+    $entity = Entity::factory()->create();
+    $inQueue = Queue::factory()->for($entity)->create(['name' => 'Banca', 'is_active' => true]);
+    $zQueue = Queue::factory()->for($entity)->create(['name' => 'Caixa', 'is_active' => true]);
+    $inactive = Queue::factory()->for($entity)->create(['name' => 'Adesão', 'is_active' => false]);
+    $outside = Queue::factory()->for($entity)->create(['name' => 'out-of-scope', 'is_active' => true]);
+
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach([$inQueue->id, $zQueue->id, $inactive->id]);
+
+    $token = totemPairFor($preset);
+
+    $response = $this->withHeader('Authorization', "Bearer {$token}")
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertOk()
+        ->assertJsonStructure([
+            'entity' => ['slug', 'name'],
+            'queues' => [['slug', 'label', 'description', 'visual' => ['color', 'icon', 'order'], 'is_active']],
+        ]);
+
+    $queues = $response->json('queues');
+
+    expect($response->json('entity.slug'))->toBe($entity->slug)
+        ->and(array_column($queues, 'label'))->toBe(['Banca', 'Caixa'])
+        ->and(collect($queues)->pluck('visual.order')->values()->all())->toBe([1, 2])
+        ->and(collect($queues)->every(fn ($q) => $q['is_active'] === true))->toBeTrue();
+});
+
+it('answers 403 forbidden for an entity slug other than the token one', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    $token = totemPairFor($preset);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->getJson("/api/{$other->slug}/queues")
+        ->assertForbidden()
+        ->assertJson(['code' => 'forbidden']);
+});
+
+it('answers 403 forbidden for an unknown entity slug', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    $token = totemPairFor($preset);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->getJson('/api/no-such-entity/queues')
+        ->assertForbidden()
+        ->assertJson(['code' => 'forbidden']);
+});
+
+it('answers 404 queue_not_found for a queue slug outside the entity', function () {
+    $entity = Entity::factory()->create();
+    $other = Entity::factory()->create();
+    Queue::factory()->for($other)->create(['slug' => 'stranger-queue']);
+
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    $token = totemPairFor($preset);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->getJson("/api/{$entity->slug}/stranger-queue/priorities")
+        ->assertNotFound()
+        ->assertJson(['code' => 'queue_not_found']);
+});
+
+it('answers 403 forbidden for a queue outside the effective scope', function () {
+    $entity = Entity::factory()->create();
+    $scoped = Queue::factory()->for($entity)->create();
+    $outside = Queue::factory()->for($entity)->create();
+
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($scoped);
+
+    $token = totemPairFor($preset);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->getJson("/api/{$entity->slug}/{$outside->slug}/priorities")
+        ->assertForbidden()
+        ->assertJson(['code' => 'forbidden']);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->postJson("/api/{$entity->slug}/{$outside->slug}/ticket", ['priority' => 0])
+        ->assertForbidden()
+        ->assertJson(['code' => 'forbidden']);
+});
+
+it('applies preset changes to tokens issued before the change', function () {
+    $entity = Entity::factory()->create();
+    $kept = Queue::factory()->for($entity)->create(['name' => 'Keep']);
+    $removed = Queue::factory()->for($entity)->create(['name' => 'Drop']);
+
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach([$kept->id, $removed->id]);
+
+    $token = totemPairFor($preset);
+
+    $preset->queues()->detach($removed->id);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->postJson("/api/{$entity->slug}/{$removed->slug}/ticket", ['priority' => 0])
+        ->assertForbidden()
+        ->assertJson(['code' => 'forbidden']);
+
+    $slugs = $this->withHeader('Authorization', "Bearer {$token}")
+        ->getJson("/api/{$entity->slug}/queues")
+        ->assertOk()
+        ->json('queues');
+
+    expect(array_column($slugs, 'label'))->toBe(['Keep']);
+});
+
+it('lists the backend owned priorities for a scoped queue', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $token = totemPairFor($preset);
+
+    $response = $this->withHeader('Authorization', "Bearer {$token}")
+        ->getJson("/api/{$entity->slug}/{$queue->slug}/priorities")
+        ->assertOk()
+        ->assertJsonStructure([
+            'entity' => ['slug'],
+            'queue' => ['slug', 'label'],
+            'priorities' => [['value', 'label', 'visual' => ['color', 'icon', 'order']]],
+        ]);
+
+    expect($response->json('entity.slug'))->toBe($entity->slug)
+        ->and($response->json('queue.slug'))->toBe($queue->slug)
+        ->and($response->json('queue.label'))->toBe($queue->name)
+        ->and(array_column($response->json('priorities'), 'value'))->toBe([0, 10, 20])
+        ->and(array_column($response->json('priorities'), 'label'))->toBe(['Normal', 'Prioritário', 'Prioridade 80+'])
+        ->and(collect($response->json('priorities'))->pluck('visual.order')->values()->all())->toBe([1, 2, 3]);
+});
+
+it('answers 422 inactive_queue for priorities on an inactive queue', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => false]);
+
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $token = totemPairFor($preset);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->getJson("/api/{$entity->slug}/{$queue->slug}/priorities")
+        ->assertStatus(422)
+        ->assertJson(['code' => 'inactive_queue']);
+});
diff --git a/tests/Feature/TotemTicketTest.php b/tests/Feature/TotemTicketTest.php
new file mode 100644
