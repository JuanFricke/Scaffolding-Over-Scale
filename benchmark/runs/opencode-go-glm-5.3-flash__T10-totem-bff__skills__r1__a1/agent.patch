--- /dev/null
+++ b/tests/Feature/TotemTicketTest.php
@@ -0,0 +1,137 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function totemPairFor(TotemPreset $preset): string
+{
+    return test()->postJson('/api/totem/auth', ['code' => $preset->fresh()->login_code])
+        ->assertOk()
+        ->json('token');
+}
+
+it('issues a totem ticket with the contract payload and 201', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $token = totemPairFor($preset);
+
+    $response = $this->withHeader('Authorization', "Bearer {$token}")
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 10])
+        ->assertCreated()
+        ->assertJsonStructure(['slug', 'queue' => ['slug', 'label'], 'priority' => ['value', 'label'], 'issued_at']);
+
+    $ticket = \App\Models\Ticket::query()->sole();
+
+    expect($response->json('slug'))->toBe($ticket->code)
+        ->and($response->json('queue.slug'))->toBe($queue->slug)
+        ->and($response->json('queue.label'))->toBe($queue->name)
+        ->and($response->json('priority'))->toBe(['value' => 10, 'label' => 'Prioritário'])
+        ->and($response->json('issued_at'))->toBe($ticket->issued_at->toIso8601String());
+
+    expect($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->priority)->toBe(10);
+});
+
+it('keeps codes sequential per queue across issuances', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $token = totemPairFor($preset);
+    $auth = ["Authorization" => "Bearer {$token}"];
+
+    $first = $this->withHeader('Authorization', $auth['Authorization'])
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0])->assertCreated();
+    $second = $this->withHeader('Authorization', $auth['Authorization'])
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 20])->assertCreated();
+
+    expect($first->json('slug'))->toBe('A001')
+        ->and($second->json('slug'))->toBe('A002');
+});
+
+it('rejects priority values outside the backend owned set without creating a ticket', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $token = totemPairFor($preset);
+    $auth = ["Authorization" => "Bearer {$token}"];
+
+    foreach ([5, -1, '10', 10.5, null, 'high'] as $priority) {
+        $this->withHeader('Authorization', $auth['Authorization'])
+            ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => $priority])
+            ->assertStatus(422)
+            ->assertJson(['code' => 'invalid_priority']);
+    }
+
+    expect(\App\Models\Ticket::query()->count())->toBe(0);
+});
+
+it('rejects a missing priority', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $token = totemPairFor($preset);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket")
+        ->assertStatus(422)
+        ->assertJson(['code' => 'invalid_priority']);
+
+    expect(\App\Models\Ticket::query()->count())->toBe(0);
+});
+
+it('rejects issuance into an inactive queue without creating a ticket', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => false]);
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $token = totemPairFor($preset);
+
+    $this->withHeader('Authorization', "Bearer {$token}")
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(422)
+        ->assertJson(['code' => 'inactive_queue']);
+
+    expect(\App\Models\Ticket::query()->count())->toBe(0);
+});
+
+it('throttles issuance at 30 per minute', function () {
+    $this->withServerParameters(['REMOTE_ADDR' => '198.51.100.88']);
+
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queue);
+
+    $token = totemPairFor($preset);
+    $auth = "Bearer {$token}";
+
+    foreach (range(1, 30) as $i) {
+        $this->withHeader('Authorization', $auth)
+            ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+            ->assertCreated();
+    }
+
+    $this->withHeader('Authorization', $auth)
+        ->postJson("/api/{$entity->slug}/{$queue->slug}/ticket", ['priority' => 0])
+        ->assertStatus(429)
+        ->assertJson(['code' => 'rate_limited']);
+});
diff --git a/tests/Unit/TotemJwtTest.php b/tests/Unit/TotemJwtTest.php
new file mode 100644
index 0000000..4c158a5
--- /dev/null
+++ b/tests/Unit/TotemJwtTest.php
@@ -0,0 +1,69 @@
+<?php
+
+use App\Support\TotemJwt;
+
+it('round-trips claims through sign and parse', function () {
+    $claims = [
+        'totem_id' => 7,
+        'entity_id' => 3,
+        'preset_id' => 5,
+        'queues' => [1, 2, 3],
+    ];
+
+    $token = TotemJwt::sign($claims);
+    $parsed = TotemJwt::parse($token);
+
+    expect($token)->toBeString()
+        ->and(substr_count($token, '.'))->toBe(2)
+        ->and($parsed['totem_id'])->toBe(7)
+        ->and($parsed['entity_id'])->toBe(3)
+        ->and($parsed['preset_id'])->toBe(5)
+        ->and($parsed['queues'])->toBe([1, 2, 3])
+        ->and($parsed['iat'])->toBeInt()
+        ->and($parsed['exp'])->toBeInt()
+        ->and($parsed['jti'])->not->toBeEmpty()
+        ->and($parsed['exp'])
+            ->toBe($parsed['iat'] + (int) config('services.totem.jwt_ttl'));
+});
+
+it('rejects a tampered signature', function () {
+    $token = TotemJwt::sign(['totem_id' => 1, 'entity_id' => 1, 'preset_id' => 1]);
+
+    [$head, $payload, $signature] = explode('.', $token);
+
+    expect(TotemJwt::parse("{$head}.{$payload}.{$signature}"))->toBeArray()
+        ->and(TotemJwt::parse("{$head}.{$payload}.{$signature}aaa"))->toBeNull();
+});
+
+it('rejects a tampered payload', function () {
+    $token = TotemJwt::sign(['totem_id' => 1, 'entity_id' => 1, 'preset_id' => 1]);
+    [$head, , $signature] = explode('.', $token);
+    $forged = str_replace(['+', '/', '='], ['-'], base64_encode(json_encode(['totem_id' => 999, 'entity_id' => 1, 'preset_id' => 1])));
+
+    expect(TotemJwt::parse("{$head}.{$forged}.{$signature}"))->toBeNull();
+});
+
+it('rejects a missing signature part', function () {
+    $token = TotemJwt::sign(['totem_id' => 1, 'entity_id' => 1, 'preset_id' => 1]);
+
+    expect(TotemJwt::parse($token.'.'))->toBeNull();
+});
+
+it('rejects a tampered expired token', function () {
+    $token = TotemJwt::sign([
+        'totem_id' => 1,
+        'entity_id' => 1,
+        'preset_id' => 1,
+        'iat' => now()->subHours(2)->getTimestamp(),
+        'exp' => now()->subHour()->getTimestamp(),
+        'jti' => 'expired',
+    ]);
+
+    expect(TotemJwt::parse($token))->toBeNull();
+});
+
+it('rejects a token signed with another secret', function () {
+    $other = TotemJwt::sign(['totem_id' => 1, 'entity_id' => 1, 'preset_id' => 1], 'a-very-different-secret-aaaaaaaa');
+
+    expect(TotemJwt::parse($other))->toBeNull();
+});
