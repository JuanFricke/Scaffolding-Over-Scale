@@ -0,0 +1,76 @@
+<?php
+
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+
+uses(RefreshDatabase::class);
+
+it('opens a 10 minute pairing window with a fresh 6 digit code', function () {
+    $preset = TotemPreset::factory()->create()->fresh();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])
+        ->expectsOutputToContain($preset->fresh()->login_code)
+        ->assertExitCode(0);
+
+    $fresh = $preset->fresh();
+
+    expect($fresh->login_code)->toMatch('/^\d{6}$/')
+        ->and($fresh->login_code_expires_at->greaterThan(now()->addMinutes(9)))->toBeTrue()
+        ->and($fresh->login_code_expires_at->lessThanOrEqualTo(now()->addMinutes(10)))->toBeTrue()
+        ->and($fresh->login_code_consumed_at)->toBeNull();
+});
+
+it('replaces a previous code and reopens the window', function () {
+    $preset = TotemPreset::factory()->create();
+    $first = $preset->fresh()->login_code;
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertExitCode(0);
+
+    $fresh = $preset->fresh();
+
+    expect($fresh->login_code)->not->toBe($first)
+        ->and($fresh->login_code_consumed_at)->toBeNull()
+        ->and($fresh->login_code_expires_at->greaterThan(now()))->toBeTrue();
+});
+
+it('keep codes unique across presets', function () {
+    $first = TotemPreset::factory()->create();
+    $second = TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => $first->id])->assertExitCode(0);
+    $this->artisan('totem:pairing-code', ['preset' => $second->id])->assertExitCode(0);
+
+    expect(TotemPreset::query()->distinct('login_code')->count('login_code'))->toBe(2);
+});
+
+it('fails for an unknown or malformed preset id', function () {
+    TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => 999999])
+        ->assertExitCode(1);
+
+    $this->artisan('totem:pairing-code', ['preset' => 'not-a-number'])
+        ->assertExitCode(1);
+});
+
+it('audits the pairing window without exposing the code', function () {
+    Event::fake([MessageLogged::class]);
+
+    $preset = TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertExitCode(0);
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use ($preset) {
+        return str_contains($log->message, 'totem')
+            && ($log->context['preset_id'] ?? null) === $preset->id;
+    });
+
+    $code = $preset->fresh()->login_code;
+
+    Event::assertNotDispatched(MessageLogged::class, function (MessageLogged $log) use ($code) {
+        return str_contains($log->message, $code)
+            || in_array($code, array_values($log->context), true);
+    });
+});
diff --git a/tests/Feature/TotemQueuesTest.php b/tests/Feature/TotemQueuesTest.php
new file mode 100644
