diff --git a/tests/Feature/TotemAuthMiddlewareTest.php b/tests/Feature/TotemAuthMiddlewareTest.php
new file mode 100644
index 0000000..27eca84
--- /dev/null
+++ b/tests/Feature/TotemAuthMiddlewareTest.php
@@ -0,0 +1,140 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function totemWorld(): array
+{
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create();
+
+    return [$entity, $preset];
+}
+
+function totemSign(Totem $totem, TotemPreset $preset, array $overrides = []): string
+{
+    return TotemJwt::sign(array_merge([
+        'totem_id' => $totem->id,
+        'entity_id' => $totem->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [],
+        'jti' => bin2hex(random_bytes(16)),
+    ], $overrides));
+}
+
+it('answers 401 invalid_token without a bearer token', function () {
+    [$entity] = totemWorld();
+
+    $this->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()
+        ->assertJson(['code' => 'invalid_token']);
+});
+
+it('answers 401 invalid_token for a malformed token', function () {
+    [$entity] = totemWorld();
+
+    $this->withHeader('Authorization', 'Bearer garbage')->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_token']);
+});
+
+it('answers 401 invalid_token for an expired token', function () {
+    [$entity, $preset] = totemWorld();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = totemSign($totem, $preset, [
+        'iat' => now()->subHours(2)->getTimestamp(),
+        'exp' => now()->subHour()->getTimestamp(),
+    ]);
+
+    $this->withHeader('Authorization', "Bearer {$token}")->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_token']);
+});
+
+it('answers 401 invalid_token when the totem no longer exists', function () {
+    [$entity, $preset] = totemWorld();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = totemSign($totem, $preset);
+
+    $totem->delete();
+
+    $this->withHeader('Authorization', "Bearer {$token}")->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_token']);
+});
+
+it('answers 401 invalid_token when the totem was deactivated', function () {
+    [$entity, $preset] = totemWorld();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = totemSign($totem, $preset);
+
+    Totem::query()->whereKey($totem->id)->update(['is_active' => false]);
+
+    $this->withHeader('Authorization', "Bearer {$token}")->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_token']);
+});
+
+it('answers 401 invalid_token when the preset no longer exists', function () {
+    [$entity, $preset] = totemWorld();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = totemSign($totem, $preset);
+
+    $preset->delete();
+
+    $this->withHeader('Authorization', "Bearer {$token}")->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_token']);
+});
+
+it('answers 401 invalid_token when the preset was deactivated', function () {
+    [$entity, $preset] = totemWorld();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = totemSign($totem, $preset);
+
+    TotemPreset::query()->whereKey($preset->id)->update(['is_active' => false]);
+
+    $this->withHeader('Authorization', "Bearer {$token}")->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_token']);
+});
+
+it('answers 401 invalid_token when the claim entity does not match the totem row', function () {
+    $other = Entity::factory()->create();
+    [$entity, $preset] = totemWorld();
+    $totem = Totem::factory()->for($entity)->create();
+
+    $token = totemSign($totem, $preset, ['entity_id' => $other->id]);
+
+    $this->withHeader('Authorization', "Bearer {$token}")->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_token']);
+});
+
+it('answers 401 invalid_token when the preset belongs to another entity', function () {
+    $other = Entity::factory()->create();
+    [$entity, $preset] = totemWorld();
+    $totem = Totem::factory()->for($entity)->create();
+    $stranded = TotemPreset::factory()->for($other)->create();
+
+    $token = totemSign($totem, $stranded);
+
+    $this->withHeader('Authorization', "Bearer {$token}")->getJson("/api/{$entity->slug}/queues")
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_token']);
+});
+
+it('refreshes last_seen_at on every authenticated request', function () {
+    [$entity, $preset] = totemWorld();
+    $totem = Totem::factory()->for($entity)->create(['last_seen_at' => now()->subMinutes(5)]);
+    $before = $totem->last_seen_at;
+
+    $this->withHeader('Authorization', 'Bearer '.totemSign($totem, $preset))
+        ->getJson("/api/{$entity->slug}/queues")->assertOk();
+
+    $totem->refresh();
+
+    expect($totem->last_seen_at->greaterThan($before))->toBeTrue();
+});
diff --git a/tests/Feature/TotemAuthTest.php b/tests/Feature/TotemAuthTest.php
new file mode 100644
index 0000000..594dc5b
--- /dev/null
+++ b/tests/Feature/TotemAuthTest.php
@@ -0,0 +1,159 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+
+uses(RefreshDatabase::class);
+
+it('answers 200 with a Bearer JWT for a valid pairing code', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create()->fresh();
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonStructure([
+            'token',
+            'token_type',
+            'expires_in',
+            'entity' => ['slug', 'name'],
+        ])
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('entity.name', $entity->name);
+
+    $claims = TotemJwt::parse($response->json('token'));
+
+    $totem = Totem::query()->sole();
+
+    expect($claims['totem_id'])->toBe($totem->id)
+        ->and($claims['entity_id'])->toBe($entity->id)
+        ->and($claims['preset_id'])->toBe($preset->id)
+        ->and($claims['queues'])->toBe([])
+        ->and($totem->entity_id)->toBe($entity->id)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull();
+});
+
+it('consumes the code atomically so it only pairs once', function () {
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create()->fresh();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+    $replay = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $replay->assertUnauthorized()->assertJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(1)
+        ->and($preset->fresh()->login_code_consumed_at)->not->toBeNull();
+});
+
+it('answers 400 invalid_code_format when the code is not exactly 6 digits', function () {
+    foreach (['', '12345', '1234567', '12345a', 'a123456', '12 456', null, 123456] as $code) {
+        $this->postJson('/api/totem/auth', ['code' => $code])
+            ->assertStatus(400)
+            ->assertJson(['code' => 'invalid_code_format']);
+    }
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('answers the same 401 for unknown, expired, consumed and inactive presets', function () {
+    $entity = Entity::factory()->create();
+
+    $unknown = $this->postJson('/api/totem/auth', ['code' => '119999']);
+
+    $preset = TotemPreset::factory()->for($entity)->state(['login_code' => '220002'])->create()
+        ->fresh();
+    $expired = $this->postJson('/api/totem/auth', ['code' => '220002']);
+
+    TotemPreset::query()->whereKey($preset->id)->update(['login_code_consumed_at' => now()]);
+    $consumed = $this->postJson('/api/totem/auth', ['code' => '220002']);
+
+    TotemPreset::query()->whereKey($preset->id)->update([
+        'login_code_consumed_at' => null,
+        'is_active' => false,
+    ]);
+    $inactive = $this->postJson('/api/totem/auth', ['code' => '220002']);
+
+    foreach ([$unknown, $expired, $consumed, $inactive] as $response) {
+        $response->assertUnauthorized()->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('answers 401 when the preset became inactive before a valid code is used', function () {
+    $entity = Entity::factory()->create();
+    TotemPreset::factory()
+        ->for($entity)
+        ->inactive()
+        ->create(['login_code' => '333333'])
+        ->fresh();
+
+    $this->postJson('/api/totem/auth', ['code' => '333333'])
+        ->assertUnauthorized()->assertJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::query()->count())->toBe(0);
+});
+
+it('answers 429 rate_limited past 10 attempts per minute', function () {
+    $this->withServerParameters(['REMOTE_ADDR' => '198.51.100.77']);
+
+    $entity = Entity::factory()->create();
+    TotemPreset::factory()->for($entity)->create(['login_code' => '444444'])->fresh();
+
+    foreach (range(1, 10) as $i) {
+        $this->postJson('/api/totem/auth', ['code' => '99999'.($i % 10)]);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '555555'])
+        ->assertStatus(429)
+        ->assertJson(['code' => 'rate_limited']);
+});
+
+it('audits pairing success and failure without logging the code', function () {
+    Event::fake([MessageLogged::class]);
+
+    $entity = Entity::factory()->create();
+    $preset = TotemPreset::factory()->for($entity)->create(['login_code' => '666666'])->fresh();
+
+    $this->postJson('/api/totem/auth', ['code' => '000001']);
+    $this->postJson('/api/totem/auth', ['code' => '666666']);
+
+    $success = false;
+    $failure = false;
+
+    Event::assertDispatched(MessageLogged::class, function (MessageLogged $log) use (&$success, &$failure, $preset) {
+        if (! str_contains($log->message, 'totem')) {
+            return false;
+        }
+
+        $outcome = $log->context['outcome'] ?? null;
+
+        if ($outcome === 'paired' && ($log->context['preset_id'] ?? null) === $preset->id) {
+            $success = true;
+        }
+
+        if ($outcome === 'rejected') {
+            $failure = true;
+        }
+
+        return true;
+    });
+
+    expect($success)->toBeTrue()->and($failure)->toBeTrue();
+
+    foreach (['666666', '000001'] as $code) {
+        Event::assertNotDispatched(MessageLogged::class, function (MessageLogged $log) use ($code) {
+            return str_contains($log->message, $code)
+                || in_array($code, array_values($log->context), true);
+        });
+    }
+});
