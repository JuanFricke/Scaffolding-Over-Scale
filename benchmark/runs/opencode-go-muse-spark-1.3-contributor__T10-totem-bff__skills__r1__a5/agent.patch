@@ -0,0 +1,48 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+#[Signature('totem:pairing-code {preset}')]
+#[Description('Open a 10-minute pairing window for a totem preset (generates its 6-digit code)')]
+class TotemPairingCode extends Command
+{
+    /**
+     * Execute the console command.
+     */
+    public function handle(): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if (! $preset) {
+            $this->error('Totem preset not found.');
+
+            return self::FAILURE;
+        }
+
+        do {
+            $code = sprintf('%06d', random_int(0, 999999));
+        } while (TotemPreset::query()->where('login_code', $code)->exists());
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        Log::channel('audit')->info('Totem pairing window opened', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $preset->login_code_expires_at?->toIso8601String(),
+        ]);
+
+        $this->line($code);
+
+        return self::SUCCESS;
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemAuthController.php b/app/Http/Controllers/Api/TotemAuthController.php
new file mode 100644
index 0000000..0d9d023
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemAuthController.php
@@ -0,0 +1,136 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+
+/**
+ * Totem pairing login: exchanges a single-use 6-digit preset code for a
+ * short-lived HS256 device JWT.
+ */
+class TotemAuthController extends Controller
+{
+    public function store(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) && ! is_int($code)) {
+            return $this->invalidFormat();
+        }
+
+        $code = (string) $code;
+
+        if (! preg_match('/^\d{6}$/', $code)) {
+            return $this->invalidFormat();
+        }
+
+        $outcome = DB::transaction(function () use ($code): array {
+            /** @var TotemPreset|null $preset */
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (! $this->isUsable($preset)) {
+                return [
+                    'ok' => false,
+                    'preset_id' => $preset?->id,
+                    'entity_id' => $preset?->entity_id,
+                ];
+            }
+
+            $preset->forceFill(['login_code_consumed_at' => now()])->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => 'Totem '.$preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+            $now = time();
+            $ttl = (int) config('services.totem.jwt_ttl', 3600);
+
+            $token = TotemJwt::encode([
+                'totem_id' => $totem->id,
+                'entity_id' => (int) $preset->entity_id,
+                'preset_id' => $preset->id,
+                'queues' => $queueIds,
+                'iat' => $now,
+                'exp' => $now + $ttl,
+                'jti' => (string) Str::uuid(),
+            ], (string) config('services.totem.jwt_secret'));
+
+            $entity = $preset->entity;
+
+            return [
+                'ok' => true,
+                'totem_id' => $totem->id,
+                'preset_id' => $preset->id,
+                'entity_id' => $preset->entity_id,
+                'entity_slug' => $entity?->slug,
+                'entity_name' => $entity?->name,
+                'token' => $token,
+                'ttl' => $ttl,
+            ];
+        });
+
+        if (! $outcome['ok']) {
+            // Never log the full pairing code.
+            Log::channel('audit')->info('Totem pairing failed', [
+                'reason' => 'invalid_pairing_code',
+                'preset_id' => $outcome['preset_id'],
+                'entity_id' => $outcome['entity_id'],
+            ]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        Log::channel('audit')->info('Totem pairing succeeded', [
+            'preset_id' => $outcome['preset_id'],
+            'totem_id' => $outcome['totem_id'],
+            'entity_id' => $outcome['entity_id'],
+        ]);
+
+        return response()->json([
+            'token' => $outcome['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => $outcome['ttl'],
+            'entity' => [
+                'slug' => $outcome['entity_slug'],
+                'name' => $outcome['entity_name'],
+            ],
+        ]);
+    }
+
+    private function invalidFormat(): JsonResponse
+    {
+        Log::channel('audit')->info('Totem pairing failed', ['reason' => 'invalid_format']);
+
+        return response()->json(['code' => 'invalid_code_format'], 400);
+    }
+
+    private function isUsable(?TotemPreset $preset): bool
+    {
+        if (! $preset || ! $preset->is_active) {
+            return false;
+        }
+
+        if ($preset->login_code_consumed_at !== null) {
+            return false;
+        }
+
+        $expiresAt = $preset->login_code_expires_at;
+
+        return $expiresAt !== null && $expiresAt->isFuture();
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemController.php b/app/Http/Controllers/Api/TotemController.php
new file mode 100644
index 0000000..d3cd60e
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemController.php
@@ -0,0 +1,163 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Support\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Authenticated totem endpoints (guarded by `totem.auth`).
+ *
+ * `{entity}` must equal the token's entity (else 403); `{queue}` is resolved
+ * within that entity only (404 when unknown, 403 when outside the effective
+ * preset scope).
+ */
+class TotemController extends Controller
+{
+    public function queues(Request $request, string $entity): JsonResponse
+    {
+        $tokenEntity = $this->tokenEntity($request);
+
+        if (! $tokenEntity || $tokenEntity->slug !== $entity) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $scopeIds = $this->scopeIds($request);
+
+        $queues = Queue::query()
+            ->where('entity_id', $tokenEntity->id)
+            ->where('is_active', true)
+            ->whereIn('id', $scopeIds)
+            ->orderBy('name')
+            ->get();
+
+        $payload = $queues->values()->map(fn (Queue $queue, int $index) => $this->queuePayload($queue, $index + 1));
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug, 'name' => $tokenEntity->name],
+            'queues' => $payload,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        [$tokenEntity, $queueModel] = $resolved;
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => TotemPriorities::all(),
+        ]);
+    }
+
+    public function ticket(Request $request, string $entity, string $queue, IssueTicket $issue): JsonResponse
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        [, $queueModel] = $resolved;
+
+        $priority = $request->input('priority');
+
+        if (is_string($priority) && ctype_digit($priority)) {
+            $priority = (int) $priority;
+        }
+
+        if (! is_int($priority) || TotemPriorities::find($priority) === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = $issue($queueModel, $priority, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $level = TotemPriorities::find($priority);
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => ['value' => $priority, 'label' => $level['label']],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+
+    private function tokenEntity(Request $request): ?Entity
+    {
+        return Entity::query()->find($request->attributes->get('totem_entity_id'));
+    }
+
+    /**
+     * @return list<int>
+     */
+    private function scopeIds(Request $request): array
+    {
+        $ids = $request->attributes->get('totem_queue_ids', []);
+
+        return is_array($ids) ? array_map(intval(...), $ids) : [];
+    }
+
+    /**
+     * @return array{0: Entity, 1: Queue}|JsonResponse
+     */
+    private function resolveQueue(Request $request, string $entity, string $queue): array|JsonResponse
+    {
+        $tokenEntity = $this->tokenEntity($request);
+
+        if (! $tokenEntity || $tokenEntity->slug !== $entity) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $queueModel = Queue::query()
+            ->where('entity_id', $tokenEntity->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $queueModel) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! in_array((int) $queueModel->id, $this->scopeIds($request), true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return [$tokenEntity, $queueModel];
+    }
+
+    /**
+     * @return array{slug: string, label: string, description: string|null, visual: array{color: string, icon: string, order: int}, is_active: bool}
+     */
+    private function queuePayload(Queue $queue, int $order): array
+    {
+        $labels = $queue->labels_i18n;
+
+        return [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => is_array($labels) ? ($labels['description'] ?? null) : null,
+            'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => $order],
+            'is_active' => true,
+        ];
+    }
+}
diff --git a/app/Http/Middleware/TotemAuth.php b/app/Http/Middleware/TotemAuth.php
