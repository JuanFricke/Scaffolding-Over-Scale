+    [$response, $token] = pairPreset($preset);
+    $response->assertOk();
+
+    $preset->queues()->detach($queue->id);
+
+    $this->getJson("/api/{$preset->entity->slug}/queues", ['Authorization' => "Bearer {$token}"])
+        ->assertOk()
+        ->assertJsonCount(0, 'queues');
+
+    $this->getJson("/api/{$preset->entity->slug}/{$queue->slug}/priorities", ['Authorization' => "Bearer {$token}"])
+        ->assertStatus(403);
+});
