+it('serves backend-owned priorities and rejects inactive or unknown queues', function () {
+    $preset = TotemPreset::factory()->create();
+    $entity = $preset->entity;
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'geral']);
+    $inactive = Queue::factory()->for($entity)->create(['slug' => 'fechada', 'is_active' => false]);
+    $outside = Queue::factory()->for($entity)->create(['slug' => 'fora']);
+    $foreign = Queue::factory()->create(['slug' => 'outra-entidade']);
+    $preset->queues()->attach([$queue->id, $inactive->id]);
+
+    [$response, $token] = pairPreset($preset);
+    $response->assertOk();
+    $headers = ['Authorization' => "Bearer {$token}"];
+
+    $this->getJson("/api/{$entity->slug}/{$queue->slug}/priorities", $headers)
+        ->assertOk()
+        ->assertJsonPath('entity.slug', $entity->slug)
+        ->assertJsonPath('queue.slug', 'geral')
+        ->assertJsonPath('queue.label', $queue->name)
+        ->assertJsonCount(3, 'priorities')
+        ->assertJsonPath('priorities.0.value', 0)
+        ->assertJsonPath('priorities.0.label', 'Normal')
+        ->assertJsonPath('priorities.1.value', 10)
+        ->assertJsonPath('priorities.2.value', 20)
+        ->assertJsonPath('priorities.2.label', 'Prioridade 80+');
+
+    $this->getJson("/api/{$entity->slug}/{$inactive->slug}/priorities", $headers)
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+
+    $this->getJson("/api/{$entity->slug}/nope/priorities", $headers)
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    // Another entity's slug resolved within this entity: not found.
+    $this->getJson("/api/{$entity->slug}/{$foreign->slug}/priorities", $headers)
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    // Known queue outside the preset scope: forbidden.
+    $this->getJson("/api/{$entity->slug}/{$outside->slug}/priorities", $headers)
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+});
