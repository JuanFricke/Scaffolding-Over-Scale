+it('answers CORS for local origins and none otherwise', function () {
+    // Preflight from the totem web build.
+    $this->call('OPTIONS', '/api/totem/auth', [], [], [], ['HTTP_ORIGIN' => 'http://localhost:8081'])
+        ->assertStatus(204);
+    expect($this->call('OPTIONS', '/api/totem/auth', [], [], [], ['HTTP_ORIGIN' => 'http://localhost:8081'])->headers->get('Access-Control-Allow-Origin'))
+        ->toBe('http://localhost:8081');
+
+    // Simple request from 127.0.0.1 echoes back.
+    $res = $this->postJson('/api/totem/auth', ['code' => 'x'], ['Origin' => 'https://127.0.0.1:3000']);
+    expect($res->headers->get('Access-Control-Allow-Origin'))->toBe('https://127.0.0.1:3000');
+
+    // Real browser preflight (with Access-Control-Request-Method).
+    $preflight = $this->options('/api/totem/auth', [], [
+        'Origin' => 'http://localhost:8081',
+        'Access-Control-Request-Method' => 'POST',
+        'Access-Control-Request-Headers' => 'authorization, content-type',
+    ]);
+    $preflight->assertStatus(204);
+    expect($preflight->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+
+    // Untrusted origins get no header, including on preflight.
+    $evilPreflight = $this->options('/api/totem/auth', [], [
+        'Origin' => 'https://evil.example.com',
+        'Access-Control-Request-Method' => 'POST',
+    ]);
+    expect($evilPreflight->headers->has('Access-Control-Allow-Origin'))->toBeFalse();
+
+    // Untrusted origins get no header.
+    $res = $this->postJson('/api/totem/auth', ['code' => 'x'], ['Origin' => 'https://evil.example.com']);
+    expect($res->headers->has('Access-Control-Allow-Origin'))->toBeFalse();
+});
