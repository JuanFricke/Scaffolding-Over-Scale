+<?php
+
+namespace App\Support;
+
+/**
+ * Backend-owned priority levels for totem issuance.
+ *
+ * Single source used by both the priorities endpoint and issuance
+ * validation: numeric value (higher = more prioritized), display label and
+ * presentation-only visual specs.
+ */
+class TotemPriorities
+{
+    /**
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function all(): array
+    {
+        return [
+            [
+                'value' => 0,
+                'label' => 'Normal',
+                'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            ],
+            [
+                'value' => 10,
+                'label' => 'Prioritário',
+                'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            ],
+            [
+                'value' => 20,
+                'label' => 'Prioridade 80+',
+                'visual' => ['color' => '#6A1B9A', 'icon' => 'star', 'order' => 3],
+            ],
+        ];
+    }
+
+    /**
+     * @return list<int>
+     */
+    public static function values(): array
+    {
+        return [0, 10, 20];
+    }
+
+    /**
+     * @return array{value: int, label: string, visual: array{color: string, icon: string, order: int}}|null
+     */
+    public static function find(int $value): ?array
+    {
+        foreach (self::all() as $priority) {
+            if ($priority['value'] === $value) {
+                return $priority;
+            }
+        }
+
+        return null;
+    }
+}
