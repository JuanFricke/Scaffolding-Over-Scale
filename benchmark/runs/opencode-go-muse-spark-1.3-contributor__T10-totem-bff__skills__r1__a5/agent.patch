@@ -0,0 +1,110 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use App\Support\TotemJwtException;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Validates the totem device JWT on every authenticated totem call.
+ *
+ * Missing/invalid/expired token, unknown or deactivated totem, unknown or
+ * deactivated preset, or an entity mismatch between claims, totem and preset
+ * all answer `401 {"code":"invalid_token"}`. On success the resolved rows and
+ * the effective queue scope (JWT `queues` claim intersected with the preset's
+ * current join) are attached to the request for controllers.
+ */
+class TotemAuth
+{
+    public const INVALID_TOKEN = ['code' => 'invalid_token'];
+
+    /**
+     * @param  Closure(Request): (Response)  $next
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $context = $this->resolve($request);
+
+        if ($context === null) {
+            return response()->json(self::INVALID_TOKEN, 401);
+        }
+
+        [$totem, $preset, $queueIds] = $context;
+
+        // Quietly record the device heartbeat.
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity_id', $totem->entity_id);
+        $request->attributes->set('totem_queue_ids', $queueIds);
+
+        return $next($request);
+    }
+
+    /**
+     * @return array{0: Totem, 1: TotemPreset, 2: list<int>}|null
+     */
+    private function resolve(Request $request): ?array
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            return null;
+        }
+
+        try {
+            $claims = TotemJwt::decode($token, (string) config('services.totem.jwt_secret'));
+        } catch (TotemJwtException) {
+            return null;
+        }
+
+        $expiry = $claims['exp'] ?? null;
+
+        if (! is_int($expiry) && ! is_float($expiry)) {
+            return null;
+        }
+
+        if ((int) $expiry < time()) {
+            return null;
+        }
+
+        $totemId = $claims['totem_id'] ?? null;
+        $entityId = $claims['entity_id'] ?? null;
+        $presetId = $claims['preset_id'] ?? null;
+
+        if (! is_int($totemId) || ! is_int($entityId) || ! is_int($presetId)) {
+            return null;
+        }
+
+        $totem = Totem::query()->find($totemId);
+
+        if (! $totem || ! $totem->is_active) {
+            return null;
+        }
+
+        $preset = TotemPreset::query()->find($presetId);
+
+        if (! $preset || ! $preset->is_active) {
+            return null;
+        }
+
+        if ((int) $totem->entity_id !== $entityId || (int) $preset->entity_id !== $entityId) {
+            return null;
+        }
+
+        $claimQueues = $claims['queues'] ?? [];
+        $claimQueues = is_array($claimQueues) ? array_map(intval(...), $claimQueues) : [];
+
+        $currentQueues = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+
+        $queueIds = array_values(array_intersect($claimQueues, $currentQueues));
+
+        return [$totem, $preset, $queueIds];
+    }
+}
