+    $tickets = Ticket::query()->orderBy('id')->get();
+    expect($tickets)->toHaveCount(2)
+        ->and($tickets->pluck('channel')->all())->each->toBe(TicketChannel::Totem)
+        ->and($tickets->pluck('priority')->all())->toBe([10, 0]);
+});
