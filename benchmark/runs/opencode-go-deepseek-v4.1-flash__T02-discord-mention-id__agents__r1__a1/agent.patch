+test('appends a mention on its own line when a valid mention id is configured', function (mixed $configured, string $expectedId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $configured,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues', ['entity_id' => 42]);
+
+    Http::assertSent(function (Request $request) use ($expectedId) {
+        $content = $request['content'] ?? '';
+
+        expect($content)->toEndWith('<@'.$expectedId.'>')
+            ->and(explode("\n", $content)[count(explode("\n", $content)) - 1])->toBe('<@'.$expectedId.'>')
+            ->and($content)->toContain('entity_id=42');
+
+        return true;
+    });
+})->with([
+    'string id' => ['123456789012345678', '123456789012345678'],
