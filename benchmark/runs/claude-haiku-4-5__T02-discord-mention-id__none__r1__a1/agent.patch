diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
index 6a778a4..9817ffb 100644
--- a/tests/Feature/DiscordOpsAlertTest.php
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -121,3 +121,137 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('mentions a discord user when mention_id is configured with a valid snowflake', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '123456789012345678',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something happened');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, '<@123456789012345678>');
+    });
+});
+
+test('does not mention when mention_id is null or empty', function (?string $mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something happened');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+})->with([null, '']);
+
+test('ignores invalid mention_id values silently', function (string|int $invalidId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $invalidId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something happened');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+})->with([
+    '123',
+    '12345',
+    'abc',
+    '@everyone',
+    '@here',
+    '123\n@everyone',
+    '123> @everyone',
+    '123 456',
+]);
+
+test('trims whitespace from mention_id before validation', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '  123456789012345678  ',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Something happened');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, '<@123456789012345678>');
+    });
+});
+
+test('reserves space for mention when truncating', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '123456789012345678',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        expect($content)->toEndWith('<@123456789012345678>')
+            ->and(mb_strlen($content))->toBeLessThanOrEqual(1800);
+
+        return true;
+    });
+});
+
+test('mention survives truncation', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    $longMessage = str_repeat('y', 1850);
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '123456789012345678',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert title', $longMessage);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, '<@123456789012345678>')
+            && mb_strlen($content) === 1800;
+    });
+});
