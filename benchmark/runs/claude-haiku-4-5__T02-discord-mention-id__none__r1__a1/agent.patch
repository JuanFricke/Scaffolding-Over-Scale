diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..350a6da 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -25,6 +25,13 @@ class DiscordOpsAlert
 
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
 
+    private const string DiscordSnowflakePattern = '/^\d{17,20}$/';
+
+    /**
+     * @var string|null Cached mention text, false if validation failed.
+     */
+    private string|false|null $cachedMention = null;
+
     /**
      * @param  array<string, mixed>  $context
      */
@@ -55,6 +62,30 @@ public function send(string $title, string $message, array $context = []): void
         }
     }
 
+    private function getMention(): string|null
+    {
+        if ($this->cachedMention !== null) {
+            return $this->cachedMention === false ? null : $this->cachedMention;
+        }
+
+        $mentionId = config('services.discord.mention_id');
+
+        if (! is_string($mentionId) || $mentionId === '') {
+            $this->cachedMention = false;
+            return null;
+        }
+
+        $trimmed = trim($mentionId);
+
+        if (! preg_match(self::DiscordSnowflakePattern, $trimmed)) {
+            $this->cachedMention = false;
+            return null;
+        }
+
+        $this->cachedMention = "<@{$trimmed}>";
+        return $this->cachedMention;
+    }
+
     /**
      * @param  array<string, mixed>  $context
      */
@@ -66,7 +97,20 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $mention = $this->getMention();
+        $maxBodyLength = self::MaxContentLength;
+
+        if ($mention !== null) {
+            $maxBodyLength -= (mb_strlen($mention) + 1);
+        }
+
+        $body = mb_substr(implode("\n", $lines), 0, $maxBodyLength);
+
+        if ($mention !== null) {
+            $body .= "\n".$mention;
+        }
+
+        return $body;
     }
 
     private function safe(string $key, mixed $value): string
