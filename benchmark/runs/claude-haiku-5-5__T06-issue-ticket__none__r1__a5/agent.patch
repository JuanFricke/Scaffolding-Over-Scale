+<?php
+
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('tickets table has required columns, unique code per queue and the queue index', function () {
+    expect(Schema::hasColumns('tickets', [
+        'id', 'queue_id', 'code', 'priority', 'channel', 'status', 'issued_at',
+        'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+    ]))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_code_unique', 'unique'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_status_priority_issued_index'))->toBeTrue();
