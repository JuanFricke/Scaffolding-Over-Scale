+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has required columns and a slug unique per entity', function () {
+    expect(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+    ]))->toBeTrue()
+        ->and(Schema::hasIndex('queues', 'queues_entity_slug_unique'))->toBeTrue();
+});
+
+test('the same slug is allowed in different entities but not in the same one', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->create(['slug' => 'caixa']);
+
+    expect(fn () => Queue::factory()->for($entity)->create(['slug' => 'caixa']))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    Queue::factory()->for(Entity::factory())->create(['slug' => 'caixa']);
+
+    expect(Queue::query()->where('slug', 'caixa')->count())->toBe(2);
+});
+
+test('queue is active by default and labels are cast to array', function () {
+    $queue = Queue::factory()->create(['labels_i18n' => ['pt_BR' => 'Caixa']]);
+
+    $queue->refresh();
+
+    expect($queue->is_active)->toBeTrue()
+        ->and($queue->labels_i18n)->toBe(['pt_BR' => 'Caixa']);
+});
+
+test('deleting an entity cascades to its queues', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->count(2)->create();
+
+    $entity->forceDelete();
+
+    expect(Queue::query()->count())->toBe(0)
+        ->and($entity->queues()->count())->toBe(0);
+});
diff --git a/tests/Feature/Queue/TicketCallTest.php b/tests/Feature/Queue/TicketCallTest.php
new file mode 100644
index 0000000..d9ecb22
--- /dev/null
+++ b/tests/Feature/Queue/TicketCallTest.php
@@ -0,0 +1,81 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('an entity member calls a waiting ticket once', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->employee()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $ticket->call($user);
+
+    $stored = $ticket->refresh();
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($stored->status)->toBe(TicketStatus::Called)
+        ->and($stored->called_by_user_id)->toBe($user->id)
+        ->and($stored->called_at)->not->toBeNull()
+        ->and($stored->calledBy->is($user))->toBeTrue();
+});
+
+test('a user from another entity cannot call the ticket', function () {
+    $queue = Queue::factory()->create();
+    $outsider = User::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class);
+
+    $stored = $ticket->refresh();
+
+    expect($stored->status)->toBe(TicketStatus::Waiting)
+        ->and($stored->called_at)->toBeNull()
+        ->and($stored->called_by_user_id)->toBeNull();
+});
+
+test('a member of another entity cannot call the ticket', function () {
+    $queue = Queue::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for(Entity::factory())->for($user)->owner()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    expect(fn () => $ticket->call($user))->toThrow(AuthorizationException::class)
+        ->and($ticket->refresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a ticket cannot be called twice', function () {
+    $queue = Queue::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($user)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $ticket->call($user);
+    $calledAt = $ticket->refresh()->called_at;
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class)
+        ->and($ticket->refresh()->called_at->equalTo($calledAt))->toBeTrue();
+});
+
+test('a stale instance still cannot call a ticket already called elsewhere', function () {
+    $queue = Queue::factory()->create();
+    $first = User::factory()->create();
+    $second = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($first)->create();
+    EntityMembership::factory()->for($queue->entity)->for($second)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $stale = Ticket::query()->find($ticket->id);
+
+    $ticket->call($first);
+
+    expect(fn () => $stale->call($second))->toThrow(LogicException::class)
+        ->and($ticket->refresh()->called_by_user_id)->toBe($first->id);
+});
diff --git a/tests/Feature/Queue/TicketCodeTest.php b/tests/Feature/Queue/TicketCodeTest.php
new file mode 100644
index 0000000..6af950e
--- /dev/null
+++ b/tests/Feature/Queue/TicketCodeTest.php
@@ -0,0 +1,77 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the first code of a queue is A001', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+});
+
+test('codes are sequential and zero padded per queue', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($other)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002')
+        ->and(Ticket::nextCode($queue->id))->toBe('A003')
+        ->and(Ticket::nextCode($other->id))->toBe('A002');
+});
+
+test('codes grow beyond three digits without string ordering', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1000');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('deleting a ticket does not reuse its number', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    $deleted = Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $deleted->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('malformed legacy codes are skipped', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+});
+
+test('the factory keeps an explicit code', function () {
+    $ticket = Ticket::factory()->create(['code' => 'A-X']);
+
+    expect($ticket->refresh()->code)->toBe('A-X');
+});
+
+test('the same code cannot be used twice in a queue', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    expect(fn () => Ticket::factory()->forQueue($queue)->create(['code' => 'A001']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
