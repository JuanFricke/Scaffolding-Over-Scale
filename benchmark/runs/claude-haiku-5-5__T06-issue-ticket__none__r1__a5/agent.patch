+++ b/tests/Feature/Queue/TicketWriteOnceTest.php
@@ -0,0 +1,55 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issuance fields cannot change after issuance', function (string $field, mixed $value) {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->{$field} = $value;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class)
+        ->and($ticket->refresh()->getRawOriginal($field))->not->toBe($value);
+})->with([
+    'code' => ['code', 'A999'],
+    'priority' => ['priority', 20],
+    'channel' => ['channel', 'totem'],
+    'queue_id' => ['queue_id', fn () => Queue::factory()->create()->id],
+    'issued_at' => ['issued_at', now()->subYear()],
+]);
+
+test('a write that mixes an immutable field with a call field is rejected whole', function () {
+    $ticket = Ticket::factory()->create(['priority' => 1]);
+
+    $ticket->priority = 5;
+    $ticket->status = TicketStatus::Called;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class)
+        ->and($ticket->refresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('status, called_at and called_by_user_id can be updated after issuance', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+
+    $ticket->status = TicketStatus::Called;
+    $ticket->called_at = now();
+    $ticket->called_by_user_id = $user->id;
+    $ticket->save();
+
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_by_user_id)->toBe($user->id);
+});
+
+test('tickets can be deleted', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->delete();
+
+    expect(Ticket::query()->count())->toBe(0);
+});
