+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Total attempts when a concurrent issuance takes the same display code.
+     */
+    private const MAX_ATTEMPTS = 3;
+
+    /**
+     * Issue a waiting ticket in the queue.
+     *
+     * @throws InvalidArgumentException when the priority is negative.
+     * @throws InactiveQueueException when the queue is inactive (checked against the database).
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException("Ticket priority must be zero or greater, [{$priority}] given.");
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(fn () => $this->issue((int) $queue->getKey(), $priority, $channel));
+            } catch (UniqueConstraintViolationException $exception) {
+                if ($attempt >= self::MAX_ATTEMPTS) {
+                    throw $exception;
+                }
+            }
+        }
+    }
+
+    private function issue(int $queueId, int $priority, TicketChannel $channel): Ticket
+    {
+        // Locking the row serializes issuance per queue and reads the state the database holds now.
+        $locked = Queue::query()->whereKey($queueId)->lockForUpdate()->firstOrFail();
+
+        if (! $locked->is_active) {
+            throw new InactiveQueueException("Queue [{$locked->getKey()}] is not active.");
+        }
+
+        return Ticket::query()->create([
+            'queue_id' => $locked->getKey(),
+            'code' => Ticket::nextCode($queueId),
+            'priority' => $priority,
+            'channel' => $channel,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ]);
+    }
+}
