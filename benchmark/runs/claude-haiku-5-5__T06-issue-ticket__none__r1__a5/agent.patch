diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..dccd071
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,130 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields that may still change after issuance (the call).
+     */
+    private const MUTABLE_AFTER_ISSUANCE = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        // Factories and direct creates without a code get the next one, allocated at insert time.
+        static::creating(function (self $ticket) {
+            $ticket->code ??= static::nextCode((int) $ticket->queue_id);
+        });
+
+        // Write-once: only the call fields may change after the ticket is issued.
+        static::updating(function (self $ticket) {
+            $immutable = array_diff(array_keys($ticket->getDirty()), self::MUTABLE_AFTER_ISSUANCE);
+
+            if ($immutable !== []) {
+                throw new LogicException('Ticket fields are write-once after issuance: '.implode(', ', $immutable).'.');
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for the queue: "last valid code + 1" by insertion order.
+     *
+     * Codes not matching `A<digits>` are skipped. Without any valid code the sequence starts at A001.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = static::query()
+            ->select('code')
+            ->where('queue_id', $queueId)
+            ->orderByDesc('id')
+            ->cursor();
+
+        foreach ($codes as $ticket) {
+            if (preg_match('/^A(\d+)$/', $ticket->code, $matches) === 1) {
+                return self::formatCode((int) $matches[1] + 1);
+            }
+        }
+
+        return self::formatCode(1);
+    }
+
+    /**
+     * Mark the ticket as called by the user. Only waiting tickets can be called, once.
+     *
+     * @throws AuthorizationException when the user is not a member of the ticket's entity.
+     * @throws LogicException when the ticket is not waiting.
+     */
+    public function call(User $user): void
+    {
+        if (! $user->membershipFor($this->queue->entity_id)) {
+            throw new AuthorizationException('Only members of the entity can call tickets.');
+        }
+
+        $calledAt = now();
+
+        // Conditional update: a concurrent call that already won finds no waiting row and affects nothing.
+        $affected = static::query()
+            ->whereKey($this->getKey())
+            ->where('status', TicketStatus::Waiting->value)
+            ->update([
+                'status' => TicketStatus::Called->value,
+                'called_at' => $calledAt,
+                'called_by_user_id' => $user->getKey(),
+                'updated_at' => $calledAt,
+            ]);
+
+        if ($affected !== 1) {
+            throw new LogicException('Only waiting tickets can be called.');
+        }
+
+        $this->forceFill([
+            'status' => TicketStatus::Called,
+            'called_at' => $calledAt,
+            'called_by_user_id' => $user->getKey(),
+            'updated_at' => $calledAt,
+        ])->syncOriginalAttributes(['status', 'called_at', 'called_by_user_id', 'updated_at']);
+    }
+
+    private static function formatCode(int $sequence): string
+    {
+        return 'A'.str_pad((string) $sequence, 3, '0', STR_PAD_LEFT);
+    }
+}
