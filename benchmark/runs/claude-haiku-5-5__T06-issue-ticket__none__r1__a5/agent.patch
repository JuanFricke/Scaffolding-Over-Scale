+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issuing creates a waiting virtual ticket with priority 0 and the next code', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at->isSameSecond(now()))->toBeTrue()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('issuing keeps the given priority and channel and numbers sequentially', function () {
+    $queue = Queue::factory()->create();
+
+    (new IssueTicket)($queue);
+    $ticket = (new IssueTicket)($queue, 10, TicketChannel::Printed);
+
+    expect($ticket->code)->toBe('A002')
+        ->and($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Printed)
+        ->and(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(2);
+});
+
+test('a negative priority is rejected without persisting anything', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))
+        ->toThrow(InvalidArgumentException::class)
+        ->and(Ticket::query()->count())->toBe(0);
+});
+
+test('an inactive queue is rejected even when the caller holds a stale active instance', function () {
+    $queue = Queue::factory()->create();
+    Queue::query()->whereKey($queue->id)->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class)
+        ->and(Ticket::query()->count())->toBe(0);
+});
+
+test('an inactive queue loaded as inactive is rejected', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+});
+
+test('a reactivated queue issues again from a stale inactive instance', function () {
+    $queue = Queue::factory()->inactive()->create();
+    Queue::query()->whereKey($queue->id)->update(['is_active' => true]);
+
+    expect((new IssueTicket)($queue)->code)->toBe('A001');
+});
+
+test('a unique code collision is retried and then succeeds', function () {
+    $queue = Queue::factory()->create();
+    $rivalInserted = false;
+
+    // Simulate a concurrent issuer taking the code between nextCode() and the insert.
+    Ticket::creating(function (Ticket $ticket) use (&$rivalInserted) {
+        if ($rivalInserted) {
+            return;
+        }
+
+        $rivalInserted = true;
+        Ticket::withoutEvents(fn () => Ticket::factory()->create([
+            'queue_id' => $ticket->queue_id,
+            'code' => $ticket->code,
+        ]));
+    });
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($rivalInserted)->toBeTrue()
+        ->and($ticket->code)->toBe('A001')
+        ->and(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(1);
+});
+
+test('a collision on every attempt gives up with the database error', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::creating(function (Ticket $ticket) {
+        Ticket::withoutEvents(fn () => Ticket::factory()->create([
+            'queue_id' => $ticket->queue_id,
+            'code' => $ticket->code,
+        ]));
+    });
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(UniqueConstraintViolationException::class)
+        ->and(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(0);
+});
