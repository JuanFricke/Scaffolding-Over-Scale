+
+test('silently ignores invalid mention_id formats', function (mixed $invalidId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $invalidId,
