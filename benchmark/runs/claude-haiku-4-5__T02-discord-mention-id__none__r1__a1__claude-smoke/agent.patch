diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..555b014 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -25,6 +25,8 @@ class DiscordOpsAlert
 
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
 
+    private const string SnowflakePattern = '/^\d{17,20}$/';
+
     /**
      * @param  array<string, mixed>  $context
      */
@@ -55,18 +57,43 @@ public function send(string $title, string $message, array $context = []): void
         }
     }
 
+    private function getMentionId(): ?string
+    {
+        $id = config('services.discord.mention_id');
+
+        if ($id === null || $id === '') {
+            return null;
+        }
+
+        $trimmed = trim((string) $id);
+
+        if (preg_match(self::SnowflakePattern, $trimmed)) {
+            return $trimmed;
+        }
+
+        return null;
+    }
+
     /**
      * @param  array<string, mixed>  $context
      */
     private function formatContent(string $title, string $message, array $context): string
     {
+        $mentionId = $this->getMentionId();
+        $mention = $mentionId ? "\n<@{$mentionId}>" : '';
+        $mentionLength = mb_strlen($mention);
+
+        $availableLength = self::MaxContentLength - $mentionLength;
+
         $lines = [$title, $message];
 
         foreach ($context as $key => $value) {
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $content = mb_substr(implode("\n", $lines), 0, $availableLength);
+
+        return $content.$mention;
     }
 
     private function safe(string $key, mixed $value): string
