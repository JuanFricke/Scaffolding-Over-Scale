+test('reserves space for mention and truncates content to 1800 characters total', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    $mentionId = '12345678901234567';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) use ($mentionId) {
+        $content = $request['content'] ?? '';
+
+        $totalLength = mb_strlen($content);
+        $mentionLength = mb_strlen("\n<@{$mentionId}>");
+
+        return $totalLength === 1800
+            && str_ends_with($content, "<@{$mentionId}>")
+            && $totalLength - $mentionLength === 1800 - $mentionLength;
+    });
+});
