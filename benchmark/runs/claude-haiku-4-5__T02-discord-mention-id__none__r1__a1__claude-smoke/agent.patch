             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends valid discord user mention when mention_id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    $mentionId = '12345678901234567'; // 17 digits
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Http::assertSent(function (Request $request) use ($mentionId) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n<@{$mentionId}>");
+    });
+});
+
+test('accepts valid discord snowflakes with 17-20 digits', function (string $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Http::assertSent(function (Request $request) use ($id) {
+        $content = $request['content'] ?? '';
+
+        return str_contains($content, "<@{$id}>");
+    });
+})->with([
+    '12345678901234567',     // 17 digits (minimum)
+    '123456789012345678',    // 18 digits
+    '1234567890123456789',   // 19 digits
+    '12345678901234567890',  // 20 digits (maximum)
+]);
+
+test('trims whitespace from mention_id before validation', function () {
