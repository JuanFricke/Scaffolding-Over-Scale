+++ b/app/Actions/CreateQueue.php
@@ -0,0 +1,58 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Illuminate\Database\QueryException;
+
+class CreateQueue
+{
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        // Authorization
+        Gate::authorize('create', [Queue::class, $entity]);
+
+        $name = trim($name);
+        if ($name === '' || mb_strlen($name) > 255) {
+            throw ValidationException::withMessages([ 'name' => ['The name must be between 1 and 255 characters.'] ]);
+        }
+
+        $slug = $slug ? Str::slug($slug) : Str::slug($name);
+
+        // Uniqueness check
+        if ($entity->queues()->where('slug', $slug)->exists()) {
+            throw ValidationException::withMessages([ 'slug' => ['The slug has already been taken.'] ]);
+        }
+
+        return DB::transaction(function () use ($entity, $name, $slug) {
+            try {
+                return $entity->queues()->create([
+                    'name' => $name,
+                    'slug' => $slug,
+                    'is_active' => true,
+                    'labels_i18n' => null,
+                ]);
+            } catch (QueryException $e) {
+                if ($this->isUniqueViolation($e)) {
+                    throw ValidationException::withMessages([ 'slug' => ['The slug has already been taken.'] ]);
+                }
+                throw $e;
+            }
+        });
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+        if ($sqlState === '23000') {
+            return true;
+        }
+        return str_contains($e->getMessage(), 'UNIQUE') || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
