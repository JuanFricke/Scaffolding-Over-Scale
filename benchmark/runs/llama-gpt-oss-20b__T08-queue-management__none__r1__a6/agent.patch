+<?php
+
+namespace App\Policies;
+
+use App\Models\Queue;
+use App\Models\User;
+use App\Models\Entity;
+use App\Models\UserRole;
+use App\Models\EntityMembership;
+use App\Models\QueueAccess;
+use App\Enums\QueuePermission;
+use App\Policies\EntityMembershipPolicy;
+
+class QueuePolicy
+{
+    public function create(User $user, App\Models\Entity $entity): bool
+    {
+        // $entity is an instance of App\Models\Entity
+        return (new EntityMembershipPolicy())->isManagerOf($user, $entity->id);
+    }
+
+    public function update(User $user, Queue $queue): bool
+    {
+        return (new EntityMembershipPolicy())->isManagerOf($user, $queue->entity_id);
+    }
+
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->update($user, $queue);
+    }
+
+    public function call(User $user, Queue $queue): bool
+    {
+        // Manager always allowed
+        if ((new EntityMembershipPolicy())->isManagerOf($user, $queue->entity_id)) {
+            return true;
+        }
+
+        // Employee: check queue_access permissions
+        $membership = $user->membershipFor($queue->entity_id);
+        if (!$membership) {
+            return false;
+        }
+
+        $access = QueueAccess::where('queue_id', $queue->id)
+            ->where('entity_membership_id', $membership->id)
+            ->first();
+
+        if (!$access) {
+            return false;
+        }
+
+        $permissions = $access->permissions ?? [];
+        if (!is_array($permissions)) {
+            return false;
+        }
+
+        return in_array(QueuePermission::Call->value, $permissions, true);
+    }
+}
