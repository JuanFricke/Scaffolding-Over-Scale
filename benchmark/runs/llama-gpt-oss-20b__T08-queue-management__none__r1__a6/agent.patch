new file mode 100644
index 0000000..1bf94ce
--- /dev/null
+++ b/app/Actions/SetQueueAccess.php
@@ -0,0 +1,77 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use App\Models\QueueAccess;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    public function __invoke(EntityMembership $targetMembership, Queue $queue, User $actor, array $permissions): void
+    {
+        // Ensure membership and queue belong to same entity
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([ 'entity_membership_id' => ['Membership does not belong to the queue entity.'] ]);
+        }
+
+        // Authorization
+        Gate::authorize('manageAccess', $queue);
+
+        // Validate permissions
+        if (!is_array($permissions)) {
+            throw ValidationException::withMessages([ 'permissions' => ['Permissions must be an array of strings.'] ]);
+        }
+
+        $validated = [];
+        $validPerms = array_map(fn($c) => $c->value, QueuePermission::cases());
+        foreach ($permissions as $perm) {
+            if (!is_string($perm)) {
+                throw ValidationException::withMessages(['permissions' => ['All permissions must be strings.']]);
+            }
+            $perm = strtolower($perm);
+            if (!in_array($perm, $validPerms, true)) {
+                throw ValidationException::withMessages(['permissions' => ["Invalid permission: {$perm}"]]);
+            }
+            $validated[] = $perm;
+        }
+
+        if (empty($validated)) {
+            // revoke: delete row if exists, log revocation
+            $access = QueueAccess::where('queue_id', $queue->id)
+                ->where('entity_membership_id', $targetMembership->id)
+                ->first();
+            if ($access) {
+                $access->delete();
+                Log::channel('audit')->info('queue.access.revoked', [
+                    'actor_id' => $actor->id,
+                    'queue_id' => $queue->id,
+                    'entity_membership_id' => $targetMembership->id,
+                ]);
+            }
+            return;
+        }
+
+        // grant: upsert permissions
+        QueueAccess::updateOrCreate(
+            [
+                'queue_id' => $queue->id,
+                'entity_membership_id' => $targetMembership->id,
+            ],
+            [
+                'permissions' => $validated,
+            ]
+        );
+
+        Log::channel('audit')->info('queue.access.granted', [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+        ]);
+    }
+}
