+        ->set('targetMembershipId', $strangerMem->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($strangerMem->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('transfer aborts gracefully when owner row is missing instead of crashing', function () {
+    $owner = User::factory()->create();
+    $newOwner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $adminMem = EntityMembership::factory()->for($entity)->for($newOwner)->admin()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $adminMem->id);
+
+    // Simulate corrupt data: owner row disappears after mount.
+    EntityMembership::where('entity_id', $entity->id)->where('role', UserRole::Owner->value)->delete();
+
+    $component->call('transfer')->assertForbidden();
+
+    expect($adminMem->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('settings shows the transfer section only to the owner', function () {
