+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Auth;
+use Livewire\Component;
+use Illuminate\Validation\Rules\Exists;
+
+class Members extends Component
+{
+    public Entity $entity;
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+    }
+
+    public function addMember(): void
+    {
+        $this->validate([
+            'email' => ['required', 'email', new Exists('users', 'email')],
+        ]);
+
+        $user = User::where('email', $this->email)->firstOrFail();
+        if ($user->membershipFor($this->entity->id)) {
+            $this->addError('email', __('ui.member_exists'));
+            return;
+        }
+
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee->value,
+        ]);
+        $this->email = '';
+        session()->flash('success', __('ui.member_added'));
+    }
+
+    public function assignRole(EntityMembership $membership, string $role): void
+    {
+        $this->authorize('assignRole', $membership);
+        if (!in_array($role, UserRole::manageable())) {
+            $this->addError('role', __('ui.invalid_role'));
+            return;
+        }
+        $membership->update(['role' => $role]);
+    }
+
+    public function removeMember(EntityMembership $membership): void
+    {
+        $this->authorize('delete', $membership);
+        // Prevent owner removal and last manager removal
+        $entity = $this->entity;
+        if ($membership->role === UserRole::Owner->value) {
+            abort(403);
+        }
+        $admins = $entity->memberships()->where('role', UserRole::Admin->value)->count();
+        if ($membership->role === UserRole::Admin->value && $admins <= 1) {
+            abort(403);
+        }
+        $membership->delete();
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.members');
+    }
+}
