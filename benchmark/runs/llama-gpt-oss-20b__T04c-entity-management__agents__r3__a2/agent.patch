+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\DB;
+use Livewire\Component;
+use Illuminate\Validation\Rule;
+
+class Settings extends Component
+{
+    public Entity $entity;
+    public string $name = '';
+    public string $slug = '';
+    public ?int $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => ['required', 'alpha_dash', 'max:255', Rule::unique('entities', 'slug')->ignore($this->entity->id)],
+        ]);
+        $this->entity->update(['name' => $this->name, 'slug' => $this->slug]);
+        session()->flash('success', __('ui.settings_saved'));
+    }
+
+    public function delete(): void
+    {
+        // Only owner can delete, already authorized in mount
+        $this->entity->delete(); // Soft delete
+        $this->entity->memberships()->delete();
+        if (session('current_entity_id') === $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+        return redirect()->route('entity.dashboard', $this->entity->slug)->with('status', __('ui.entity_deleted'));
+    }
+
+    public function transfer(): void
+    {
+        $this->validate([
+            'targetMembershipId' => ['required', 'integer', 'exists:entity_memberships,id'],
+        ]);
+        $target = EntityMembership::findOrFail($this->targetMembershipId);
+        if ($target->entity_id !== $this->entity->id) {
+            abort(403);
+        }
+        if ($target->role !== UserRole::Admin->value) {
+            abort(403);
+        }
+        if ($target->user_id === Auth::id()) {
+            abort(403);
+        }
+        DB::transaction(function () use ($target) {
+            $currentOwner = $this->entity->memberships()->where('role', UserRole::Owner->value)->first();
+            if (!$currentOwner) {
+                abort(403);
+            }
+            $currentOwner->update(['role' => UserRole::Admin->value]);
+            $target->update(['role' => UserRole::Owner->value]);
+        });
+        session()->flash('success', __('ui.ownership_transferred'));
+        return redirect()->route('entity.dashboard', $this->entity->slug);
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.settings');
+    }
+}
