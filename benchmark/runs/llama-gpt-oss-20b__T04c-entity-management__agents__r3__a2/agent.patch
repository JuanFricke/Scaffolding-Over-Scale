@@ -0,0 +1,35 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('member visiting dashboard sees the entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Acme', 'slug' => 'acme']);
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertOk()
+        ->assertSee('Acme');
+});
+
+test('cross entity access is forbidden even with a valid session', function () {
+    $user = User::factory()->create();
+    $mine = Entity::factory()->create(['slug' => 'mine']);
+    $stranger = Entity::factory()->create(['slug' => 'stranger']);
+    EntityMembership::factory()->for($mine)->for($user)->owner()->create();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $mine->slug));
+
+    // Session tenant is "mine", but requested entity "stranger" is not theirs.
+    $this->get(route('entity.dashboard', $stranger->slug))
+        ->assertForbidden();
+});
