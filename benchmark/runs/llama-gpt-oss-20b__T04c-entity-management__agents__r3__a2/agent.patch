+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Livewire\Component;
+use Illuminate\Auth\Auth;
+
+class Dashboard extends Component
+{
+    public Entity $entity;
+    public ?string $ownerNotice = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $membership = Auth::user()->membershipFor($entity->id);
+        if ($membership && $membership->role === UserRole::Owner->value) {
+            $this->ownerNotice = __('ui.owner_notice');
+        }
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.dashboard');
+    }
+}
