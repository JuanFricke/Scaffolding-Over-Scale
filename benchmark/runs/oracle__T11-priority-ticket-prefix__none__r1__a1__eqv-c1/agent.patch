+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+return new class extends Migration
+{
+    /**
+     * Run the migrations.
+     *
+     * Adds the issuance day so ticket codes restart at 001 per queue +
+     * prefix + day (parent issue #45 daily reset, sub-issue #46 per-prefix
+     * sequencing). The unique window widens from (queue_id, code) to
+     * (queue_id, code, issue_date), so N001 and P001 coexist on the same
+     * day and N001 repeats across days.
+     */
+    public function up(): void
+    {
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->date('issue_date')->nullable();
+        });
+
+        DB::table('tickets')
+            ->whereNull('issue_date')
+            ->update(['issue_date' => DB::raw('DATE(issued_at)')]);
+
+        // NOT NULL after the backfill: on MySQL/MariaDB, NULLs are distinct
+        // in unique indexes, so a nullable column would let duplicate
+        // (queue_id, code) rows sneak past the new unique below.
+        // change() is native since Laravel 11 (no doctrine/dbal needed) and
+        // was verified with migrate --force against MariaDB in the dev stack.
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->date('issue_date')->nullable(false)->change();
+        });
+
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropUnique(['queue_id', 'code']);
+            $table->unique(['queue_id', 'code', 'issue_date']);
+        });
+    }
+
+    /**
+     * Reverse the migrations.
+     *
+     * Only safe while no (queue_id, code) pair repeats across days: rolling
+     * back after two days issued the same code fails re-adding the narrower
+     * unique. Roll forward (re-migrate) instead of rolling back in that case.
+     */
+    public function down(): void
+    {
+        Schema::table('tickets', function (Blueprint $table) {
+            $table->dropUnique(['queue_id', 'code', 'issue_date']);
+            $table->unique(['queue_id', 'code']);
+            $table->dropColumn('issue_date');
+        });
+    }
+};
