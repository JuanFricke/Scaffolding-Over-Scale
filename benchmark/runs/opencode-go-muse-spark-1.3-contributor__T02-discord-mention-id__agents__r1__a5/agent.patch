diff --git a/CHANGELOG.md b/CHANGELOG.md
index 9806b52..2e7ec93 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -21,6 +21,8 @@ ### Added
 
 ### Changed
 
+- Discord ops alerts ping the on-call person: optional `DISCORD_MENTION_ID` (`config('services.discord.mention_id')`) appends `<@ID>` on its own line to every alert. Only a 17–20 digit snowflake is accepted; anything else is ignored. The 1800-character cap covers the whole content, so long alerts truncate the body and keep the mention.
+
 - Documented architecture: PegaFilaWeb is a single repository for frontend, backend and totem API; Flutter remains only as a separate client.
 - Simplified model: ticket is single-use (one call; write-once except `called_at`/`called_by`) — removed `ticket_calls` table; ticket knows only its queue (no `totem_id`). `tickets.priority` is now an integer (higher = more prioritized).
 - Expanded financial model: `billing_accounts` (1:0..1 with entity) + `subscriptions` + `plans` isolate financial data. New tables: `payment_options` (cycle, method, discount, refund window) and `payments` (individual charges). `billing_accounts` has `cpf_cnpj`. Subscription 1:1 with `billing_account_id` (UK); history in `payments`. Added `tickets.code`, explicit unique constraints, and circular FK note for owner. Removed per-queue user access limit.
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..7af409a 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,56 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $body = implode("\n", $lines);
+
+        $mention = $this->mentionSuffix();
+
+        if ($mention === '') {
+            return mb_substr($body, 0, self::MaxContentLength);
+        }
+
+        $room = self::MaxContentLength - mb_strlen($mention);
+
+        return mb_substr($body, 0, $room).$mention;
+    }
+
+    /**
+     * Validated "<@USER_ID>" suffix (including its leading newline), or ''.
+     *
+     * Only a Discord snowflake (17-20 ASCII digits, surrounding whitespace
+     * trimmed, integer accepted) produces a mention. Anything else is ignored
+     * silently so values like "@everyone" can never become a mass ping.
+     */
+    private function mentionSuffix(): string
+    {
+        $id = $this->mentionId();
+
+        if ($id === null) {
+            return '';
+        }
+
+        return "\n<@{$id}>";
+    }
+
+    private function mentionId(): ?string
+    {
+        $raw = config('services.discord.mention_id');
+
+        if (is_int($raw)) {
+            $raw = (string) $raw;
+        }
+
+        if (! is_string($raw)) {
+            return null;
+        }
+
+        $candidate = trim($raw);
+
+        if (! preg_match('/\A[0-9]{17,20}\z/', $candidate)) {
+            return null;
+        }
+
+        return $candidate;
     }
 
     private function safe(string $key, mixed $value): string
