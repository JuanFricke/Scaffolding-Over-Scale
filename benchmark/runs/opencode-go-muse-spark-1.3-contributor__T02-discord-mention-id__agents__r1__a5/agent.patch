@@ -121,3 +121,87 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends a mention on its own line when mention id is valid', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => '12345678901234567']);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n<@12345678901234567>");
+    });
+});
+
+test('adds no mention when mention id is null or empty', function ($mention) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $mention]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '', '   ']);
+
+test('ignores invalid mention ids silently', function ($mention) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $mention]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([
+    '@everyone',
+    '@here',
+    'abc',
+    '123',
+    '1234567890123456',
+    '123456789012345678901',
+    "123\n@everyone",
+    "123> \n@everyone",
+    '<@12345678901234567>',
+    '12345678901234567!',
+    '  abc  ',
+]);
+
+test('trims surrounding whitespace and accepts integers as mention ids', function ($mention, string $expected) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $mention]);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@{$expected}>"));
+})->with([
+    ['  12345678901234567  ', '12345678901234567'],
+    [12345678901234567, '12345678901234567'],
+]);
+
+test('keeps the mention when a long alert is truncated', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => '12345678901234567']);
+
+    Http::fake([$url => Http::response('', 204)]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return mb_strlen($content) === 1800
+            && str_ends_with($content, "\n<@12345678901234567>");
+    });
+});
