diff --git a/app/Actions/Concerns/ValidatesQueueAttributes.php b/app/Actions/Concerns/ValidatesQueueAttributes.php
new file mode 100644
index 0000000..070b671
--- /dev/null
+++ b/app/Actions/Concerns/ValidatesQueueAttributes.php
@@ -0,0 +1,74 @@
+<?php
+
+namespace App\Actions\Concerns;
+
+use App\Models\Queue;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+trait ValidatesQueueAttributes
+{
+    private function normalizeName(string $name): string
+    {
+        $name = trim($name);
+
+        if ($name === '' || mb_strlen($name) > 255) {
+            throw ValidationException::withMessages([
+                'name' => __('validation.between.string', [
+                    'attribute' => 'name',
+                    'min' => 1,
+                    'max' => 255,
+                ]),
+            ]);
+        }
+
+        return $name;
+    }
+
+    private function normalizeSlug(string $slug): string
+    {
+        $slug = Str::slug($slug);
+
+        if ($slug === '' || mb_strlen($slug) > 255) {
+            throw ValidationException::withMessages([
+                'slug' => __('validation.between.string', [
+                    'attribute' => 'slug',
+                    'min' => 1,
+                    'max' => 255,
+                ]),
+            ]);
+        }
+
+        return $slug;
+    }
+
+    private function assertSlugAvailable(int $entityId, string $slug, ?int $exceptQueueId = null): void
+    {
+        $taken = Queue::query()
+            ->where('entity_id', $entityId)
+            ->where('slug', $slug)
+            ->when($exceptQueueId !== null, fn ($query) => $query->whereKeyNot($exceptQueueId))
+            ->exists();
+
+        if ($taken) {
+            throw $this->slugTaken();
+        }
+    }
+
+    private function slugTaken(): ValidationException
+    {
+        return ValidationException::withMessages([
+            'slug' => __('validation.unique', ['attribute' => 'slug']),
+        ]);
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        return $sqlState === '23000'
+            || str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
