@@ -0,0 +1,69 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\ValidatesQueueAttributes;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+/**
+ * Queues are never deleted: deactivation (`isActive: false`) retires them.
+ */
+class UpdateQueue
+{
+    use ValidatesQueueAttributes;
+
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $name = $name === null ? null : $this->normalizeName($name);
+        $slug = $slug === null ? null : $this->normalizeSlug($slug);
+
+        try {
+            $updated = DB::transaction(function () use ($queue, $name, $slug, $isActive): Queue {
+                // Same queue-row lock as IssueTicket/CallNextTicket so a
+                // deactivation is serialized with issuance and calls.
+                $locked = Queue::query()
+                    ->whereKey($queue->id)
+                    ->lockForUpdate()
+                    ->firstOrFail();
+
+                if ($slug !== null) {
+                    $this->assertSlugAvailable($locked->entity_id, $slug, $locked->id);
+                }
+
+                $locked->fill(array_filter(
+                    ['name' => $name, 'slug' => $slug],
+                    fn ($value) => $value !== null,
+                ));
+
+                if ($isActive !== null) {
+                    $locked->is_active = $isActive;
+                }
+
+                $locked->save();
+
+                return $locked;
+            });
+        } catch (QueryException $e) {
+            if ($this->isUniqueViolation($e)) {
+                throw $this->slugTaken();
+            }
+
+            throw $e;
+        }
+
+        $queue->setRawAttributes($updated->getAttributes(), true);
+
+        return $updated;
+    }
+}
