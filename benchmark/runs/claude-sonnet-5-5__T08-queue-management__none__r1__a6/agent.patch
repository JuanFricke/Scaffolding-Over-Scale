@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\ValidatesQueueAttributes;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Str;
+
+class CreateQueue
+{
+    use ValidatesQueueAttributes;
+
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $name = $this->normalizeName($name);
+        $slug = $slug === null || trim($slug) === ''
+            ? $this->normalizeSlug(Str::slug($name))
+            : $this->normalizeSlug($slug);
+
+        $this->assertSlugAvailable($entity->id, $slug);
+
+        try {
+            return Queue::query()->create([
+                'entity_id' => $entity->id,
+                'name' => $name,
+                'slug' => $slug,
+                'is_active' => true,
+            ]);
+        } catch (QueryException $e) {
+            if ($this->isUniqueViolation($e)) {
+                throw $this->slugTaken();
+            }
+
+            throw $e;
+        }
+    }
+}
diff --git a/app/Actions/SetQueueAccess.php b/app/Actions/SetQueueAccess.php
new file mode 100644
index 0000000..6ec64f9
--- /dev/null
+++ b/app/Actions/SetQueueAccess.php
@@ -0,0 +1,119 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Set the permissions of a membership on a queue. A non-empty list upserts
+     * the grant; an empty list revokes it.
+     *
+     * @param  array<int|string, mixed>  $permissions
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        $permissions = $this->validated($permissions);
+
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'membership' => 'The membership and the queue must belong to the same entity.',
+            ]);
+        }
+
+        if ($permissions === []) {
+            $deleted = QueueAccess::query()
+                ->where('entity_membership_id', $targetMembership->id)
+                ->where('queue_id', $queue->id)
+                ->delete();
+
+            if ($deleted > 0) {
+                $this->audit('queue.access.revoked', $actor, $queue, $targetMembership, []);
+            }
+
+            return;
+        }
+
+        $this->upsert($targetMembership, $queue, $permissions);
+
+        $this->audit('queue.access.granted', $actor, $queue, $targetMembership, $permissions);
+    }
+
+    /**
+     * @param  array<int|string, mixed>  $permissions
+     * @return list<string>
+     */
+    private function validated(array $permissions): array
+    {
+        $allowed = array_column(QueuePermission::cases(), 'value');
+
+        foreach ($permissions as $permission) {
+            if (! is_string($permission) || ! in_array($permission, $allowed, true)) {
+                throw ValidationException::withMessages([
+                    'permissions' => 'Unknown queue permission.',
+                ]);
+            }
+        }
+
+        return array_values(array_unique($permissions));
+    }
+
+    /**
+     * @param  list<string>  $permissions
+     */
+    private function upsert(EntityMembership $membership, Queue $queue, array $permissions): void
+    {
+        $keys = ['entity_membership_id' => $membership->id, 'queue_id' => $queue->id];
+
+        try {
+            DB::transaction(fn () => QueueAccess::query()->updateOrCreate($keys, ['permissions' => $permissions]));
+        } catch (QueryException $e) {
+            // Concurrent first grant lost the race on the unique index: the
+            // row exists now, so update it.
+            if (! $this->isUniqueViolation($e)) {
+                throw $e;
+            }
+
+            QueueAccess::query()->where($keys)->update(['permissions' => json_encode($permissions)]);
+        }
+    }
+
+    /**
+     * @param  list<string>  $permissions
+     */
+    private function audit(string $message, User $actor, Queue $queue, EntityMembership $membership, array $permissions): void
+    {
+        Log::channel('audit')->info($message, [
+            'actor_id' => $actor->id,
+            'entity_id' => $queue->entity_id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $membership->id,
+            'permissions' => $permissions,
+        ]);
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        return $sqlState === '23000'
+            || str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
