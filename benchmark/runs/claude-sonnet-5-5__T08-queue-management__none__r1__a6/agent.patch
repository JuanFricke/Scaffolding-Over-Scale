+<?php
+
+namespace Database\Factories;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+use Illuminate\Database\Eloquent\Model;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * Membership and queue always end up in the same entity: whichever one is
+     * given explicitly decides the entity of the one that is generated. The
+     * key order matters (queue_id is expanded before entity_membership_id).
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'queue_id' => function (array $attributes): int {
+                $membership = $attributes['entity_membership_id'] ?? null;
+
+                if ($membership instanceof Model) {
+                    $membership = $membership->getKey();
+                }
+
+                if (is_int($membership) || is_string($membership)) {
+                    $entityId = EntityMembership::query()->whereKey($membership)->value('entity_id');
+
+                    return Queue::factory()->create(['entity_id' => $entityId])->getKey();
+                }
+
+                return Queue::factory()->create()->getKey();
+            },
+            'entity_membership_id' => function (array $attributes): int {
+                $entityId = Queue::query()->whereKey($attributes['queue_id'])->value('entity_id');
+
+                return EntityMembership::factory()->employee()->create(['entity_id' => $entityId])->getKey();
+            },
+            'permissions' => [QueuePermission::Call->value],
+        ];
+    }
+}
