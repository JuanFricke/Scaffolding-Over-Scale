new file mode 100644
index 0000000..0430d89
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,137 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Code prefix; the sequence is per queue.
+     */
+    public const CODE_PREFIX = 'A';
+
+    /**
+     * Minimum number of digits in the code sequence (zero padded).
+     */
+    public const CODE_MIN_DIGITS = 3;
+
+    /**
+     * Fields that may change after issuance; everything else is write-once.
+     *
+     * @var list<string>
+     */
+    private const MUTABLE_AFTER_ISSUANCE = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    protected static function booted(): void
+    {
+        static::updating(function (Ticket $ticket) {
+            $frozen = array_values(array_diff(array_keys($ticket->getDirty()), self::MUTABLE_AFTER_ISSUANCE));
+
+            if ($frozen !== []) {
+                throw new LogicException(
+                    'Ticket fields are immutable after issuance: '.implode(', ', $frozen).'.'
+                );
+            }
+        });
+    }
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: the last well-formed code (by insertion
+     * order, not string order) plus one. Malformed codes are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $beforeId = null;
+        $last = 0;
+
+        do {
+            $rows = static::query()
+                ->where('queue_id', $queueId)
+                ->when($beforeId !== null, fn ($query) => $query->where('id', '<', $beforeId))
+                ->orderByDesc('id')
+                ->limit(100)
+                ->get(['id', 'code']);
+
+            foreach ($rows as $row) {
+                if (preg_match('/^'.self::CODE_PREFIX.'(\d{1,18})\z/', $row->code, $matches) === 1) {
+                    $last = (int) $matches[1];
+                    break 2;
+                }
+            }
+
+            $beforeId = $rows->last()?->id;
+        } while ($rows->count() === 100);
+
+        return self::CODE_PREFIX.str_pad((string) ($last + 1), self::CODE_MIN_DIGITS, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call this ticket. Allowed once, and only for members of the ticket's entity.
+     *
+     * @throws AuthorizationException when the user is not a member of the entity
+     * @throws LogicException when the ticket was already called
+     */
+    public function call(User $user): void
+    {
+        DB::transaction(function () use ($user) {
+            $entityId = Queue::query()->whereKey($this->queue_id)->value('entity_id');
+
+            if ($entityId === null || $user->membershipFor((int) $entityId) === null) {
+                throw new AuthorizationException('Only members of the ticket\'s entity may call it.');
+            }
+
+            // Re-read under a row lock: the instance may be stale and two
+            // attendants may race for the same ticket.
+            $fresh = static::query()->whereKey($this->getKey())->lockForUpdate()->first();
+
+            if ($fresh === null || $fresh->status !== TicketStatus::Waiting) {
+                throw new LogicException('Only a waiting ticket can be called.');
+            }
+
+            $this->setRawAttributes($fresh->getAttributes(), true);
+            $this->forceFill([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+            ])->save();
+        });
+    }
+}
