@@ -0,0 +1,61 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * How many times to try when concurrent issuance collides on (queue_id, code).
+     */
+    private const MAX_ATTEMPTS = 5;
+
+    /**
+     * @throws InvalidArgumentException when the priority is negative
+     * @throws InactiveQueueException when the queue is inactive (or gone)
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be greater than or equal to 0.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(fn () => $this->issue($queue, $priority, $channel));
+            } catch (UniqueConstraintViolationException $e) {
+                if ($attempt >= self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+    }
+
+    private function issue(Queue $queue, int $priority, TicketChannel $channel): Ticket
+    {
+        // Authoritative state comes from the database under a row lock, not
+        // from the (possibly stale) model instance the caller holds.
+        $current = Queue::query()->whereKey($queue->getKey())->lockForUpdate()->first();
+
+        if ($current === null || ! $current->is_active) {
+            throw new InactiveQueueException('Cannot issue a ticket in an inactive queue.');
+        }
+
+        return Ticket::create([
+            'queue_id' => $current->id,
+            'code' => Ticket::nextCode($current->id),
+            'priority' => $priority,
+            'channel' => $channel,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ]);
+    }
+}
