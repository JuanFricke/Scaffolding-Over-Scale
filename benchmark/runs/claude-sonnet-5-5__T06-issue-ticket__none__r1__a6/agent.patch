+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issuing creates a waiting virtual ticket with the first code', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->queue_id)->toBe($queue->id);
+});
+
+test('codes are sequential per queue', function () {
+    $a = Queue::factory()->create();
+    $b = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    expect($issue($a)->code)->toBe('A001')
+        ->and($issue($a, 10, TicketChannel::Totem)->code)->toBe('A002')
+        ->and($issue($b)->code)->toBe('A001');
+});
+
+test('inactive queue is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+    expect(Ticket::count())->toBe(0);
+});
+
+test('stale active model of a queue deactivated meanwhile is rejected', function () {
+    $queue = Queue::factory()->create();
+    Queue::whereKey($queue->id)->update(['is_active' => false]);
+
+    expect($queue->is_active)->toBeTrue();
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+    expect(Ticket::count())->toBe(0);
+});
+
+test('negative priority is rejected', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))->toThrow(InvalidArgumentException::class);
+    expect(Ticket::count())->toBe(0);
+});
+
+test('code sequence follows insertion order, not string order', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('deleting a middle ticket does not reuse numbers', function () {
+    $queue = Queue::factory()->create();
+    $tickets = Ticket::factory()->forQueue($queue)->count(3)->create();
+    expect($tickets->pluck('code')->all())->toBe(['A001', 'A002', 'A003']);
+
+    $tickets[1]->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('malformed legacy codes are skipped', function () {
+    $only = Queue::factory()->create();
+    Ticket::factory()->forQueue($only)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($only->id))->toBe('A001');
+
+    $mixed = Queue::factory()->create();
+    Ticket::factory()->forQueue($mixed)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($mixed)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($mixed->id))->toBe('A002');
+});
+
+test('factory forQueue allocates consecutive codes', function () {
+    $queue = Queue::factory()->create();
+
+    $one = Ticket::factory()->forQueue($queue)->create();
+    $two = Ticket::factory()->forQueue($queue)->create();
+
+    expect($one->code)->toBe('A001')->and($two->code)->toBe('A002');
+});
+
+test('codes are unique per queue', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    expect(fn () => Ticket::factory()->forQueue($queue)->create(['code' => 'A001']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('immutable fields cannot change after issuance', function () {
+    $ticket = (new IssueTicket)(Queue::factory()->create());
+
+    expect(fn () => $ticket->update(['code' => 'A999']))->toThrow(LogicException::class);
+    expect(fn () => $ticket->update(['priority' => 5]))->toThrow(LogicException::class);
+
+    $ticket->refresh();
+    expect($ticket->code)->toBe('A001')->and($ticket->priority)->toBe(0);
+});
+
+test('a member can call a waiting ticket once', function () {
+    $ticket = (new IssueTicket)(Queue::factory()->create());
+    $user = User::factory()->create();
+    EntityMembership::factory()->create([
+        'entity_id' => $ticket->queue->entity_id,
+        'user_id' => $user->id,
+    ]);
+
+    $ticket->call($user);
+
+    $ticket->refresh();
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($user->id)
+        ->and($ticket->calledBy->is($user))->toBeTrue();
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+});
+
+test('a stale instance cannot call an already called ticket', function () {
+    $ticket = (new IssueTicket)(Queue::factory()->create());
+    $user = User::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $ticket->queue->entity_id, 'user_id' => $user->id]);
+
+    $stale = Ticket::find($ticket->id);
+    $ticket->call($user);
+
+    expect(fn () => $stale->call($user))->toThrow(LogicException::class);
+});
+
+test('non-members cannot call a ticket', function () {
+    $ticket = (new IssueTicket)(Queue::factory()->create());
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class);
+
+    $ticket->refresh();
+    expect($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('deleting a queue or its entity cascades to tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->count(2)->create();
+
+    $queue->entity->forceDelete();
+
+    expect(Queue::count())->toBe(0)->and(Ticket::count())->toBe(0);
+});
