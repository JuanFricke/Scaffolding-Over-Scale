@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Set the permissions a membership holds on a queue (owner/admin only):
+     * a non-empty list upserts the grant, an empty list revokes it.
+     *
+     * @param  array<int, mixed>  $permissions  QueuePermission values
+     *
+     * @throws AuthorizationException
+     * @throws ValidationException
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        foreach ($permissions as $permission) {
+            if (! is_string($permission) || QueuePermission::tryFrom($permission) === null) {
+                throw ValidationException::withMessages([
+                    'permissions' => trans('validation.in', ['attribute' => 'permissions']),
+                ]);
+            }
+        }
+
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'membership' => trans('validation.exists', ['attribute' => 'membership']),
+            ]);
+        }
+
+        $permissions = array_values(array_unique($permissions));
+        $keys = [
+            'entity_membership_id' => $targetMembership->id,
+            'queue_id' => $queue->id,
+        ];
+
+        $revoked = DB::transaction(function () use ($keys, $permissions, $queue): bool {
+            // Serialize concurrent grants for the same queue (the unique index
+            // is the backstop on engines where the row lock is a no-op).
+            Queue::query()->whereKey($queue->id)->lockForUpdate()->firstOrFail();
+
+            if ($permissions === []) {
+                return QueueAccess::query()->where($keys)->delete() > 0;
+            }
+
+            QueueAccess::query()->updateOrCreate($keys, ['permissions' => $permissions]);
+
+            return false;
+        });
+
+        if ($permissions === [] && ! $revoked) {
+            return;
+        }
+
+        Log::channel('audit')->info($permissions === [] ? 'queue.access.revoked' : 'queue.access.granted', [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+            'permissions' => $permissions,
+        ]);
+    }
+}
