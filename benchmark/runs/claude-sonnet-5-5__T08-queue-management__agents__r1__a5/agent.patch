+/**
+ * A user holding the given role (owner|admin|employee) in the entity.
+ */
+function memberWithRole(Entity $entity, string $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->state(['role' => $role])->create();
+
+    return $user;
+}
