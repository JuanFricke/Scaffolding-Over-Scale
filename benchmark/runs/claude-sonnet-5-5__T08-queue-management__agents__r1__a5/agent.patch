+it('lets owners and admins create an active queue with a derived slug', function (string $role) {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, $role);
+
+    $queue = (new CreateQueue)($entity, $actor, 'Atendimento Geral');
+
+    expect($queue->exists)->toBeTrue()
+        ->and($queue->entity_id)->toBe($entity->id)
+        ->and($queue->name)->toBe('Atendimento Geral')
+        ->and($queue->slug)->toBe('atendimento-geral')
+        ->and($queue->is_active)->toBeTrue()
+        ->and(Queue::query()->count())->toBe(1);
+})->with(['owner', 'admin']);
+
+it('trims the name and slugifies an explicit slug', function () {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'owner');
+
+    $queue = (new CreateQueue)($entity, $actor, '  Caixa  ', 'Caixa Rápido 1');
+
+    expect($queue->name)->toBe('Caixa')
+        ->and($queue->slug)->toBe('caixa-rapido-1');
+});
+
+it('rejects invalid names', function (string $name) {
