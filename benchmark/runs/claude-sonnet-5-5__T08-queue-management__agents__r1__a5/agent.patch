+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('renames, re-slugs and deactivates in any combination', function () {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'admin');
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old']);
+
+    $updated = (new UpdateQueue)($queue, $actor, name: '  New name ');
+    expect($updated->name)->toBe('New name')
+        ->and($updated->slug)->toBe('old')
+        ->and($updated->is_active)->toBeTrue();
+
+    $updated = (new UpdateQueue)($queue, $actor, slug: 'Novo Slug');
+    expect($updated->slug)->toBe('novo-slug')
+        ->and($updated->name)->toBe('New name');
+
+    $updated = (new UpdateQueue)($queue, $actor, isActive: false);
+    expect($updated->is_active)->toBeFalse()
+        ->and($queue->fresh())->is_active->toBeFalse()->slug->toBe('novo-slug');
+
+    $updated = (new UpdateQueue)($queue, $actor, name: 'Back', slug: 'back', isActive: true);
+    expect($queue->fresh())->name->toBe('Back')->slug->toBe('back')->is_active->toBeTrue();
+});
+
+it('treats all-null arguments as a no-op', function () {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'owner');
+    $queue = Queue::factory()->for($entity)->create(['is_active' => false]);
+
+    $updated = (new UpdateQueue)($queue, $actor);
+
+    expect($updated->name)->toBe($queue->name)->and($updated->is_active)->toBeFalse();
+});
+
+it('allows keeping the own slug and rejects taking another queue slug', function () {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'owner');
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'mine']);
+    Queue::factory()->for($entity)->create(['slug' => 'taken']);
+
+    expect((new UpdateQueue)($queue, $actor, slug: 'mine')->slug)->toBe('mine');
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'X', slug: 'Taken'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh())->slug->toBe('mine')->name->not->toBe('X');
+});
+
+it('allows a slug used by a queue of another entity', function () {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'owner');
+    $queue = Queue::factory()->for($entity)->create();
+    Queue::factory()->create(['slug' => 'shared']);
+
+    expect((new UpdateQueue)($queue, $actor, slug: 'shared')->slug)->toBe('shared');
+});
+
+it('turns a unique index violation from a race into a validation error', function () {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'owner');
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'mine']);
+
+    Queue::updating(function (Queue $q): void {
+        DB::table('queues')->insert([
+            'entity_id' => $q->entity_id,
+            'name' => 'Racer',
+            'slug' => $q->slug,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    });
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, slug: 'racy'))
+        ->toThrow(ValidationException::class);
+
+    Queue::flushEventListeners();
+});
+
+it('rejects invalid names and slugs', function (array $args) {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'owner');
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Keep', 'slug' => 'keep']);
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, ...$args))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh())->name->toBe('Keep')->slug->toBe('keep');
+})->with([
+    'blank name' => [['name' => '  ']],
+    'long name' => [['name' => str_repeat('a', 256)]],
+    'empty slug' => [['slug' => '!!!']],
+]);
+
+it('denies non-managers and writes nothing', function (string $who) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Keep', 'slug' => 'keep']);
+    $actor = match ($who) {
+        'employee' => memberWithRole($entity, 'employee'),
+        'foreign owner' => memberWithRole(Entity::factory()->create(), 'owner'),
+        'stranger' => User::factory()->create(),
+    };
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'X', slug: 'x', isActive: false))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh())->name->toBe('Keep')->slug->toBe('keep')->is_active->toBeTrue();
+})->with(['employee', 'foreign owner', 'stranger']);
+
+it('keeps tickets when deactivating and then blocks issuing', function () {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'owner');
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = (new IssueTicket)($queue);
+
+    (new UpdateQueue)($queue, $actor, isActive: false);
+
+    expect(Ticket::query()->count())->toBe(1)
+        ->and($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+    expect(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class);
+});
