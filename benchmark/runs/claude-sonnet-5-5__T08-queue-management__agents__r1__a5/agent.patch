+    $actor = memberWithRole($entity, 'owner');
+
+    $queue = (new CreateQueue)($entity, $actor, str_repeat('a', 255));
+
+    expect($queue->name)->toHaveLength(255);
+});
+
+it('rejects a slug that slugifies to nothing', function () {
+    $entity = Entity::factory()->create();
+    $actor = memberWithRole($entity, 'owner');
+
+    expect(fn () => (new CreateQueue)($entity, $actor, '!!!'))
+        ->toThrow(ValidationException::class);
+    expect(fn () => (new CreateQueue)($entity, $actor, 'Ok', '???'))
+        ->toThrow(ValidationException::class);
