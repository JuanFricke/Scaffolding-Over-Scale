+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function accessScenario(): array
+{
+    $entity = Entity::factory()->create();
+    $manager = memberWithRole($entity, 'owner');
+    $employee = memberWithRole($entity, 'employee');
+    $queue = Queue::factory()->for($entity)->create();
+
+    return [$entity, $manager, $employee->membershipFor($entity->id), $queue];
+}
+
+it('grants and upserts call access and audits the grant', function () {
+    [, $manager, $membership, $queue] = accessScenario();
+    $audit = Mockery::mock();
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+    $audit->shouldReceive('info')->twice()->with('queue.access.granted', Mockery::on(
+        fn (array $ctx) => $ctx['actor_id'] === $manager->id
+            && $ctx['queue_id'] === $queue->id
+            && $ctx['entity_membership_id'] === $membership->id
+    ));
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call', 'call']);
+
+    $rows = QueueAccess::query()->get();
+    expect($rows)->toHaveCount(1)
+        ->and($rows->first()->permissions)->toBe(['call']);
+});
+
+it('revokes with an empty list and audits only when a row existed', function () {
+    [, $manager, $membership, $queue] = accessScenario();
+    QueueAccess::factory()->create(['entity_membership_id' => $membership->id, 'queue_id' => $queue->id]);
+    $audit = Mockery::mock();
+    Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+    $audit->shouldReceive('info')->once()->with('queue.access.revoked', Mockery::on(
+        fn (array $ctx) => $ctx['actor_id'] === $manager->id
+            && $ctx['queue_id'] === $queue->id
+            && $ctx['entity_membership_id'] === $membership->id
+    ));
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('lets an employee call exactly after a grant and not after a revoke', function () {
+    [, $manager, $membership, $queue] = accessScenario();
+    $employee = $membership->user;
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeTrue();
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+});
+
+it('rejects unknown or non-string permissions and stores nothing', function (array $permissions) {
+    [, $manager, $membership, $queue] = accessScenario();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, $permissions))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with([
+    'unknown' => [['call', 'admin']],
+    'int' => [[1]],
+    'bool' => [[true]],
+    'null' => [[null]],
+    'nested' => [[['call']]],
+    'case' => [['CALL']],
+]);
+
+it('does not touch an existing grant when the new list is invalid', function () {
+    [, $manager, $membership, $queue] = accessScenario();
+    QueueAccess::factory()->create(['entity_membership_id' => $membership->id, 'queue_id' => $queue->id]);
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, ['nope']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(1);
+});
+
+it('rejects a membership and queue from different entities', function () {
+    [, $manager, $membership] = accessScenario();
+    $foreignQueue = Queue::factory()->create();
+    $foreignManager = memberWithRole($foreignQueue->entity, 'owner');
+
+    // Manager of the queue's entity, membership from another entity.
+    expect(fn () => (new SetQueueAccess)($membership, $foreignQueue, $foreignManager, ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('denies non-managers, including self-granting, and writes nothing', function (string $who) {
+    [$entity, , $membership, $queue] = accessScenario();
+    $actor = match ($who) {
+        'self' => $membership->user,
+        'admin of other entity' => memberWithRole(Entity::factory()->create(), 'admin'),
+        'stranger' => User::factory()->create(),
+    };
+    Log::shouldReceive('channel')->never();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $actor, ['call']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with(['self', 'admin of other entity', 'stranger']);
+
+it('denies a non-manager revoking an existing grant', function () {
+    [, , $membership, $queue] = accessScenario();
+    QueueAccess::factory()->create(['entity_membership_id' => $membership->id, 'queue_id' => $queue->id]);
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $membership->user, []))
+        ->toThrow(AuthorizationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(1);
+});
+
+it('cascades grants when the membership or queue is deleted', function () {
+    [, , $membership, $queue] = accessScenario();
+    $other = Queue::factory()->for($queue->entity)->create();
+    QueueAccess::factory()->create(['entity_membership_id' => $membership->id, 'queue_id' => $queue->id]);
+    QueueAccess::factory()->create(['entity_membership_id' => $membership->id, 'queue_id' => $other->id]);
+
+    $queue->delete();
+    expect(QueueAccess::query()->count())->toBe(1);
+
+    $membership->delete();
+    expect(QueueAccess::query()->count())->toBe(0);
+});
