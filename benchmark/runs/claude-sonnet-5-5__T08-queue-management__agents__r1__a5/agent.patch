+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function gateAllows(User $user, string $ability, mixed $argument): bool
+{
+    return Gate::forUser($user)->allows($ability, $argument);
+}
+
+it('lets owner and admin create, update and manage access', function (string $role) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $manager = memberWithRole($entity, $role);
+
+    expect(gateAllows($manager, 'create', [Queue::class, $entity]))->toBeTrue()
+        ->and(gateAllows($manager, 'update', $queue))->toBeTrue()
+        ->and(gateAllows($manager, 'manageAccess', $queue))->toBeTrue()
+        ->and(gateAllows($manager, 'call', $queue))->toBeTrue();
+})->with(['owner', 'admin']);
+
+it('denies employees, other-entity members and non-members every management ability', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberWithRole($entity, 'employee');
+    $foreignOwner = memberWithRole(Entity::factory()->create(), 'owner');
+    $stranger = User::factory()->create();
+
+    foreach ([$employee, $foreignOwner, $stranger] as $user) {
+        expect(gateAllows($user, 'create', [Queue::class, $entity]))->toBeFalse()
+            ->and(gateAllows($user, 'update', $queue))->toBeFalse()
+            ->and(gateAllows($user, 'manageAccess', $queue))->toBeFalse();
+    }
+});
+
+it('lets an employee call only with a call grant on that queue', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $other = Queue::factory()->for($entity)->create();
+    $employee = memberWithRole($entity, 'employee');
+    $membership = $employee->membershipFor($entity->id);
+
+    expect(gateAllows($employee, 'call', $queue))->toBeFalse();
+
+    QueueAccess::factory()->create(['entity_membership_id' => $membership->id, 'queue_id' => $queue->id]);
+
+    expect(gateAllows($employee, 'call', $queue))->toBeTrue()
+        ->and(gateAllows($employee, 'call', $other))->toBeFalse();
+});
+
+it('denies an employee whose grant row lacks the call permission', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberWithRole($entity, 'employee');
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $employee->membershipFor($entity->id)->id,
+        'queue_id' => $queue->id,
+        'permissions' => [],
+    ]);
+
+    expect(gateAllows($employee, 'call', $queue))->toBeFalse();
+});
+
+it('denies when the stored permissions value is corrupted', function (string $raw) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = memberWithRole($entity, 'employee');
+    $access = QueueAccess::factory()->create([
+        'entity_membership_id' => $employee->membershipFor($entity->id)->id,
+        'queue_id' => $queue->id,
+    ]);
+
+    DB::table('queue_access')->where('id', $access->id)->update(['permissions' => $raw]);
+
+    expect(gateAllows($employee, 'call', $queue))->toBeFalse();
+})->with(['"call"', '"not json', 'null', '42', '{"a":"call"}x']);
+
+it('does not honor a grant held in another entity', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $foreignQueue = Queue::factory()->create();
+    $user = User::factory()->create();
+    $foreignMembership = EntityMembership::factory()->for($foreignQueue->entity)->for($user)->employee()->create();
+    QueueAccess::factory()->create(['entity_membership_id' => $foreignMembership->id, 'queue_id' => $foreignQueue->id]);
+
+    expect(gateAllows($user, 'call', $queue))->toBeFalse();
+});
+
+it('builds a factory grant whose membership and queue share an entity', function () {
+    $access = QueueAccess::factory()->create();
+
+    expect($access->membership->entity_id)->toBe($access->queue->entity_id)
+        ->and($access->permissions)->toBe(['call']);
+});
