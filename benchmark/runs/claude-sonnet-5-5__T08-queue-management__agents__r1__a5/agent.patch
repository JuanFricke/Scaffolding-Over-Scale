+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    /**
+     * Rename, re-slug and/or (de)activate a queue (owner/admin only).
+     * `null` leaves a field unchanged. Queues are never deleted: deactivating
+     * keeps the tickets and makes issuing/calling fail.
+     *
+     * @throws AuthorizationException
+     * @throws ValidationException
+     */
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $rules = [
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => [
+                'required', 'string', 'max:255',
+                Rule::unique('queues', 'slug')
+                    ->where('entity_id', $queue->entity_id)
+                    ->ignore($queue->id),
+            ],
+        ];
+
+        $input = array_filter([
+            'name' => $name === null ? null : trim($name),
+            'slug' => $slug === null ? null : Str::slug($slug),
+        ], fn ($value) => $value !== null);
+
+        $changes = Validator::make($input, array_intersect_key($rules, $input))->validate();
+
+        if ($isActive !== null) {
+            $changes['is_active'] = $isActive;
+        }
+
+        try {
+            // Same queue-row lock as IssueTicket/CallNextTicket, so a
+            // deactivation is serialized against in-flight issuing/calling.
+            DB::transaction(function () use ($queue, $changes): void {
+                Queue::query()
+                    ->whereKey($queue->id)
+                    ->lockForUpdate()
+                    ->firstOrFail()
+                    ->update($changes);
+            });
+        } catch (UniqueConstraintViolationException) {
+            // Lost a race against another writer between the check and the update.
+            throw ValidationException::withMessages([
+                'slug' => trans('validation.unique', ['attribute' => 'slug']),
+            ]);
+        }
+
+        return $queue->refresh();
+    }
+}
