+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function callNextSetup(): array
+{
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    return [$queue, $attendant];
+}
+
+it('calls the highest priority then oldest then lowest id in any mode', function () {
+    [$queue, $attendant] = callNextSetup();
+
+    $oldNormal = Ticket::factory()->forQueue($queue)->create([
+        'priority' => 0, 'issued_at' => now()->subMinutes(30),
+    ]);
+    $priority = Ticket::factory()->forQueue($queue)->create([
+        'priority' => 10, 'issued_at' => now()->subMinutes(5),
+    ]);
+    Ticket::factory()->forQueue($queue)->create([
+        'priority' => 0, 'issued_at' => now()->subMinutes(10),
+    ]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($priority->id)
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_by_user_id)->toBe($attendant->id)
+        ->and($called->called_at)->not->toBeNull();
+
+    // Oldest within same priority wins next.
+    $next = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+    expect($next->id)->toBe($oldNormal->id);
+});
+
+it('breaks issued_at ties by lowest id', function () {
+    [$queue, $attendant] = callNextSetup();
+    $moment = now()->subMinutes(10);
+
+    $first = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => $moment]);
+    $second = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => $moment]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe(min($first->id, $second->id));
+});
+
+it('only considers waiting tickets of the given queue', function () {
+    [$queue, $attendant] = callNextSetup();
+    $other = Queue::factory()->create(['is_active' => true]);
+
+    $mine = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+    $foreign = Ticket::factory()->forQueue($other)->create(['priority' => 99]);
+    $alreadyCalled = Ticket::factory()->forQueue($queue)->create([
+        'priority' => 99,
+        'status' => TicketStatus::Called,
+        'called_at' => now(),
+        'called_by_user_id' => $attendant->id,
+    ]);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($mine->id)
+        ->and($foreign->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($alreadyCalled->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+it('calls only priority tickets in priority_only mode', function () {
+    [$queue, $attendant] = callNextSetup();
+
+    Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subHour()]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 5]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->id)->toBe($priority->id);
+});
+
+it('calls only normal tickets oldest first in normal_only mode', function () {
+    [$queue, $attendant] = callNextSetup();
+
+    Ticket::factory()->forQueue($queue)->create(['priority' => 99]);
+    $oldNormal = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()->subHour()]);
+    Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly);
+
+    expect($called->id)->toBe($oldNormal->id);
+});
+
+it('enforces fairness after three consecutive priority calls', function () {
+    [$queue, $attendant] = callNextSetup();
+
+    // Three consecutive priority calls, most recent first.
+    foreach ([30, 20, 10] as $minutesAgo) {
+        Ticket::factory()->forQueue($queue)->create([
+            'priority' => 10,
+            'status' => TicketStatus::Called,
+            'issued_at' => now()->subHours(2),
+            'called_at' => now()->subMinutes($minutesAgo),
+            'called_by_user_id' => $attendant->id,
+        ]);
+    }
+
+    $normal = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+    Ticket::factory()->forQueue($queue)->create(['priority' => 50]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($called->id)->toBe($normal->id);
+});
+
+it('keeps calling priority when fairness trips but no normal is waiting', function () {
+    [$queue, $attendant] = callNextSetup();
+
+    foreach ([30, 20, 10] as $minutesAgo) {
+        Ticket::factory()->forQueue($queue)->create([
+            'priority' => 10,
+            'status' => TicketStatus::Called,
+            'issued_at' => now()->subHours(2),
+            'called_at' => now()->subMinutes($minutesAgo),
+            'called_by_user_id' => $attendant->id,
+        ]);
+    }
+
+    $top = Ticket::factory()->forQueue($queue)->create(['priority' => 50]);
+    Ticket::factory()->forQueue($queue)->create(['priority' => 5]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($called->id)->toBe($top->id);
+});
+
+it('resets the fairness streak after a normal call', function () {
+    [$queue, $attendant] = callNextSetup();
+
+    Ticket::factory()->forQueue($queue)->create([
+        'priority' => 10, 'status' => TicketStatus::Called,
+        'issued_at' => now()->subHours(3), 'called_at' => now()->subMinutes(40),
+        'called_by_user_id' => $attendant->id,
+    ]);
+    Ticket::factory()->forQueue($queue)->create([
+        'priority' => 10, 'status' => TicketStatus::Called,
+        'issued_at' => now()->subHours(3), 'called_at' => now()->subMinutes(30),
+        'called_by_user_id' => $attendant->id,
+    ]);
+    Ticket::factory()->forQueue($queue)->create([
+        'priority' => 0, 'status' => TicketStatus::Called,
+        'issued_at' => now()->subHours(3), 'called_at' => now()->subMinutes(20),
+        'called_by_user_id' => $attendant->id,
+    ]);
+    Ticket::factory()->forQueue($queue)->create([
+        'priority' => 10, 'status' => TicketStatus::Called,
+        'issued_at' => now()->subHours(3), 'called_at' => now()->subMinutes(10),
+        'called_by_user_id' => $attendant->id,
+    ]);
+
+    $normal = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+    $top = Ticket::factory()->forQueue($queue)->create(['priority' => 50]);
+
+    // Last three are P, N, P — not three consecutive priorities.
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::Any);
+
+    expect($called->id)->toBe($top->id)
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('ignores fairness in priority_only and normal_only modes', function () {
+    [$queue, $attendant] = callNextSetup();
+
+    foreach ([30, 20, 10] as $minutesAgo) {
+        Ticket::factory()->forQueue($queue)->create([
+            'priority' => 10,
+            'status' => TicketStatus::Called,
+            'issued_at' => now()->subHours(2),
+            'called_at' => now()->subMinutes($minutesAgo),
+            'called_by_user_id' => $attendant->id,
+        ]);
+    }
+
+    Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+    $top = Ticket::factory()->forQueue($queue)->create(['priority' => 50]);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->id)->toBe($top->id);
+});
+
+it('rejects calling from an inactive queue without changing anything', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $ticket = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('rejects calling with a stale active instance after deactivation', function () {
+    [$queue, $attendant] = callNextSetup();
+    $stale = Queue::query()->findOrFail($queue->id);
+    $ticket = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('throws when no ticket is eligible for the requested mode', function () {
+    [$queue, $attendant] = callNextSetup();
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('throws in priority_only when only normals wait', function () {
+    [$queue, $attendant] = callNextSetup();
+    Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly))
