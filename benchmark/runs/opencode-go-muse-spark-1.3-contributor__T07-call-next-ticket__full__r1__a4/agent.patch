+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read queue state from the database under a row lock; the
+            // passed instance may be stale (e.g. deactivated concurrently).
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $restrictToNormal = $mode === CallMode::Any && $this->fairnessTripped($lockedQueue->id);
+
+            $candidateIds = $this->candidateIds($lockedQueue->id, $mode, $restrictToNormal);
+
+            if ($candidateIds->isEmpty()) {
+                throw new NoWaitingTicketsException('No waiting tickets eligible for the requested mode.');
+            }
+
+            // Exactly-once: Ticket::call() locks only the ticket row, so a
+            // concurrent single-ticket call can flip a candidate after the
+            // list above was built. Lock each candidate and re-check status,
+            // skipping losers instead of failing or double-calling.
+            foreach ($candidateIds as $candidateId) {
+                $ticket = Ticket::query()
+                    ->whereKey($candidateId)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket->refresh();
+            }
+
+            throw new NoWaitingTicketsException('No waiting tickets eligible for the requested mode.');
+        });
+    }
+
+    /**
+     * Fairness (any mode only): after 3 consecutive priority calls, the next
+     * call is restricted to normal tickets while at least one normal waits.
+     * History is the last 3 called tickets of this queue (most recent first
+     * by called_at, then by id); calls from every mode count, and a normal
+     * call anywhere in the window breaks the streak.
+     */
+    private function fairnessTripped(int $queueId): bool
+    {
+        $lastThree = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->get();
+
+        if ($lastThree->count() !== 3 || ! $lastThree->every(fn (Ticket $ticket): bool => $ticket->priority > 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+
+    /**
+     * @return Collection<int, int>
+     */
+    private function candidateIds(int $queueId, CallMode $mode, bool $restrictToNormal): Collection
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting);
+
+        if ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0);
+        } elseif ($mode === CallMode::NormalOnly || $restrictToNormal) {
+            $query->where('priority', 0);
+        }
+
+        if ($mode === CallMode::NormalOnly || $restrictToNormal) {
+            // All candidates share priority 0: oldest first.
+            $query->orderBy('issued_at')->orderBy('id');
+        } else {
+            $query->orderByDesc('priority')->orderBy('issued_at')->orderBy('id');
+        }
+
+        return $query->pluck('id');
+    }
+}
