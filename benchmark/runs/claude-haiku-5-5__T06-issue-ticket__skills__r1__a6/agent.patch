+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('tickets table has required columns', function () {
+    expect(Schema::hasTable('tickets'))->toBeTrue()
+        ->and(Schema::hasColumns('tickets', [
+            'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+            'issued_at', 'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+        ]))->toBeTrue();
+});
+
+test('tickets have a code unique per queue and an index for the waiting list', function () {
+    expect(Schema::hasIndex('tickets', ['queue_id', 'code'], 'unique'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', ['queue_id', 'status', 'priority', 'issued_at']))->toBeTrue();
+});
+
+test('ticket defaults are waiting, virtual and priority zero', function () {
+    $queue = Queue::factory()->create();
+
+    $id = DB::table('tickets')->insertGetId([
+        'queue_id' => $queue->id,
+        'code' => 'A001',
+        'issued_at' => now(),
+    ]);
+
+    $row = DB::table('tickets')->where('id', $id)->first();
+
+    expect($row->status)->toBe('waiting')
+        ->and($row->channel)->toBe('virtual')
+        ->and((int) $row->priority)->toBe(0);
+});
+
+test('deleting an entity cascades to its queues and their tickets', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $entity->forceDelete();
+
+    expect(Queue::count())->toBe(0)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('deleting a queue cascades to its tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $queue->delete();
+
+    expect(Ticket::count())->toBe(0);
+});
diff --git a/tests/Feature/Queue/TicketWriteOnceTest.php b/tests/Feature/Queue/TicketWriteOnceTest.php
