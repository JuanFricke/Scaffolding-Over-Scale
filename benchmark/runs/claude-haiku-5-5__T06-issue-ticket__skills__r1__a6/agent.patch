diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..f90161f
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,130 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields that may change after issuance; every other field is write-once.
+     */
+    private const CALL_FIELDS = ['status', 'called_at', 'called_by_user_id'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        static::creating(function (self $ticket) {
+            $ticket->code ??= static::nextCode($ticket->queue_id);
+        });
+
+        static::updating(function (self $ticket) {
+            $immutable = array_diff(array_keys($ticket->getDirty()), [...self::CALL_FIELDS, 'updated_at']);
+
+            if ($immutable !== []) {
+                throw new LogicException('Ticket fields are write-once after issuance: '.implode(', ', $immutable).'.');
+            }
+
+            $calling = $ticket->getOriginal('status') === TicketStatus::Waiting
+                && $ticket->status === TicketStatus::Called;
+
+            if (! $calling && $ticket->isDirty(self::CALL_FIELDS)) {
+                throw new LogicException('Status and call fields only change when a waiting ticket is called.');
+            }
+
+            if ($calling && (! $ticket->called_at || ! $ticket->called_by_user_id)) {
+                throw new LogicException('A called ticket must record called_at and called_by_user_id.');
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: the last well-formed code by insertion order plus one,
+     * zero-padded to three digits ("A001", ..., "A999", "A1000"). Malformed codes are skipped.
+     * Deleting a ticket that is not the latest leaves the sequence intact (A001, A003 -> A004).
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = static::query()
+            ->where('queue_id', $queueId)
+            ->orderByDesc('id')
+            ->select('code')
+            ->cursor();
+
+        foreach ($codes as $ticket) {
+            if (preg_match('/^A([0-9]+)$/D', $ticket->code, $matches)) {
+                return self::formatCode((int) $matches[1] + 1);
+            }
+        }
+
+        return self::formatCode(1);
+    }
+
+    /**
+     * Mark this waiting ticket as called by the given user. Only members of the ticket's
+     * entity may call it, and a ticket can be called exactly once.
+     *
+     * @throws AuthorizationException when the user is not a member of the entity.
+     * @throws LogicException when the ticket is not waiting.
+     */
+    public function call(User $user): void
+    {
+        Gate::forUser($user)->authorize('call', $this);
+
+        DB::transaction(function () use ($user) {
+            // Re-read under lock: this instance may be stale if another attendant called it.
+            $current = static::query()->lockForUpdate()->findOrFail($this->getKey());
+
+            if ($current->status !== TicketStatus::Waiting) {
+                throw new LogicException('Ticket has already been called.');
+            }
+
+            $this->status = TicketStatus::Called;
+            $this->called_at = now();
+            $this->called_by_user_id = $user->getKey();
+            $this->save();
+        });
+    }
+
+    private static function formatCode(int $number): string
+    {
+        return 'A'.str_pad((string) $number, 3, '0', STR_PAD_LEFT);
+    }
+}
