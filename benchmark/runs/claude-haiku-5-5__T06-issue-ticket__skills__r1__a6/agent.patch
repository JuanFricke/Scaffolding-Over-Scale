+
+    expect($ticket)->toBeInstanceOf(Ticket::class)
+        ->and($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull()
+        ->and($ticket->issued_at->diffInSeconds(now()))->toBeLessThan(5);
+});
+
+test('issuing a ticket records the given priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and(Ticket::find($ticket->id)->channel)->toBe(TicketChannel::Totem);
+});
+
+test('consecutive issuances get consecutive codes', function () {
+    $queue = Queue::factory()->create();
+
+    $first = (new IssueTicket)($queue);
+    $second = (new IssueTicket)($queue);
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002');
+});
+
+test('a negative priority is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('an inactive queue rejects issuance and nothing is persisted', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('a queue deactivated after the caller loaded it is still rejected', function () {
+    $queue = Queue::factory()->create();
+    expect($queue->is_active)->toBeTrue();
+
+    DB::table('queues')->where('id', $queue->id)->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('issuance retries when the code was taken by a concurrent issuance', function () {
+    $queue = Queue::factory()->create();
+
+    // Boot the model first so its own creating hook (code allocation) runs before the race below.
+    new Ticket;
+
+    $raced = false;
+    Ticket::creating(function (Ticket $ticket) use (&$raced) {
+        if ($raced) {
+            return;
+        }
+
+        // Another request takes the code we just computed, before our insert lands. The
+        // row lives in our first attempt's transaction, so it rolls back with that attempt.
+        $raced = true;
+        DB::table('tickets')->insert([
+            'queue_id' => $ticket->queue_id,
+            'code' => $ticket->code,
+            'priority' => 0,
+            'channel' => 'virtual',
+            'status' => 'waiting',
+            'issued_at' => now(),
+        ]);
+    });
+
+    $ticket = (new IssueTicket)($queue);
+
+    // The collision on the first attempt was retried: the second attempt succeeded.
+    expect($raced)->toBeTrue()
+        ->and($ticket->exists)->toBeTrue()
+        ->and(Ticket::count())->toBe(1);
+});
