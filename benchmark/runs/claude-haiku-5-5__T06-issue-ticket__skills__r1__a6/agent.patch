+++ b/tests/Feature/Queue/TicketWriteOnceTest.php
@@ -0,0 +1,77 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('changing the code of an issued ticket throws', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['code' => 'Z999']))
+        ->toThrow(LogicException::class);
+
+    expect(Ticket::find($ticket->id)->code)->toBe('A001');
+});
+
+test('changing the priority of an issued ticket throws', function () {
+    $ticket = Ticket::factory()->create(['priority' => 5]);
+
+    $ticket->priority = 20;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+    expect(Ticket::find($ticket->id)->priority)->toBe(5);
+});
+
+test('channel, queue and issued_at are immutable after issuance', function () {
+    $ticket = Ticket::factory()->create();
+    $other = Queue::factory()->create();
+
+    expect(fn () => $ticket->update(['channel' => TicketChannel::Printed]))->toThrow(LogicException::class)
+        ->and(fn () => $ticket->update(['queue_id' => $other->id]))->toThrow(LogicException::class)
+        ->and(fn () => $ticket->update(['issued_at' => now()->subDay()]))->toThrow(LogicException::class);
+});
+
+test('a ticket cannot go back to waiting', function () {
+    $ticket = Ticket::factory()->create();
+    $attendant = User::factory()->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($attendant)->create();
+    $ticket->call($attendant);
+
+    $ticket->status = TicketStatus::Waiting;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+});
+
+test('status cannot be set to called without recording who and when', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->status = TicketStatus::Called;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+    expect(Ticket::find($ticket->id)->status)->toBe(TicketStatus::Waiting);
+});
+
+test('call fields cannot be rewritten once the ticket is called', function () {
+    $ticket = Ticket::factory()->create();
+    $attendant = User::factory()->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($attendant)->create();
+    $ticket->call($attendant);
+
+    $ticket->called_at = now()->addMinute();
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+});
+
+test('an issued ticket can be deleted', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->delete();
+
+    expect(Ticket::count())->toBe(0);
+});
