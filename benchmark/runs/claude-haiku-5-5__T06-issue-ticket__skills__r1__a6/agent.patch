+<?php
+
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has required columns and a slug unique per entity', function () {
+    expect(Schema::hasTable('queues'))->toBeTrue()
+        ->and(Schema::hasColumns('queues', [
+            'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('queues', ['entity_id', 'slug'], 'unique'))->toBeTrue();
+});
+
+test('queue is active by default', function () {
+    $entity = DB::table('entities')->insertGetId(['name' => 'e', 'slug' => 'e1']);
+
+    $id = DB::table('queues')->insertGetId([
+        'entity_id' => $entity,
+        'name' => 'Caixa',
+        'slug' => 'caixa',
+    ]);
+
+    expect((bool) DB::table('queues')->where('id', $id)->value('is_active'))->toBeTrue();
+});
+
+test('the same slug is allowed in different entities but not twice in one entity', function () {
+    $e1 = DB::table('entities')->insertGetId(['name' => 'e1', 'slug' => 'e1']);
+    $e2 = DB::table('entities')->insertGetId(['name' => 'e2', 'slug' => 'e2']);
+
+    DB::table('queues')->insert(['entity_id' => $e1, 'name' => 'Caixa', 'slug' => 'caixa']);
+    DB::table('queues')->insert(['entity_id' => $e2, 'name' => 'Caixa', 'slug' => 'caixa']);
+
+    expect(fn () => DB::table('queues')->insert(['entity_id' => $e1, 'name' => 'Outra', 'slug' => 'caixa']))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
diff --git a/tests/Feature/Queue/TicketCallTest.php b/tests/Feature/Queue/TicketCallTest.php
new file mode 100644
index 0000000..7596f64
--- /dev/null
+++ b/tests/Feature/Queue/TicketCallTest.php
@@ -0,0 +1,104 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Entity $entity, string $role = 'employee'): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->state(['role' => $role])->create();
+
+    return $user;
+}
+
+test('a member of the entity can call a waiting ticket', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $attendant = memberOf($queue->entity);
+
+    $ticket->call($attendant);
+
+    $fresh = Ticket::find($ticket->id);
+
+    expect($fresh->status)->toBe(TicketStatus::Called)
+        ->and($fresh->called_at)->not->toBeNull()
+        ->and($fresh->called_by_user_id)->toBe($attendant->id)
+        ->and($ticket->status)->toBe(TicketStatus::Called);
+});
+
+test('admins and owners of the entity may also call tickets', function () {
+    $queue = Queue::factory()->create();
+    $admin = memberOf($queue->entity, 'admin');
+    $owner = memberOf($queue->entity, 'owner');
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    $first->call($admin);
+    $second->call($owner);
+
+    expect(Ticket::find($first->id)->called_by_user_id)->toBe($admin->id)
+        ->and(Ticket::find($second->id)->called_by_user_id)->toBe($owner->id);
+});
+
+test('a user outside the entity cannot call and the ticket is unchanged', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $stranger = User::factory()->create();
+
+    expect(fn () => $ticket->call($stranger))
+        ->toThrow(AuthorizationException::class);
+
+    $fresh = Ticket::find($ticket->id);
+
+    expect($fresh->status)->toBe(TicketStatus::Waiting)
+        ->and($fresh->called_at)->toBeNull()
+        ->and($fresh->called_by_user_id)->toBeNull();
+});
+
+test('a member of another entity cannot call this entity ticket', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $otherEntityMember = memberOf(Entity::factory()->create());
+
+    expect(fn () => $ticket->call($otherEntityMember))
+        ->toThrow(AuthorizationException::class);
+
+    expect(Ticket::find($ticket->id)->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a ticket can be called only once', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $first = memberOf($queue->entity);
+    $second = memberOf($queue->entity);
+
+    $ticket->call($first);
+
+    expect(fn () => $ticket->call($second))
+        ->toThrow(LogicException::class);
+
+    $fresh = Ticket::find($ticket->id);
+
+    expect($fresh->called_by_user_id)->toBe($first->id);
+});
+
+test('calling through a stale instance is rejected by the database state', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $stale = Ticket::find($ticket->id);
+    $attendant = memberOf($queue->entity);
+
+    $ticket->call($attendant);
+
+    expect(fn () => $stale->call($attendant))
+        ->toThrow(LogicException::class);
+});
