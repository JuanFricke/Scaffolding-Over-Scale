+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the first ticket of a queue gets A001', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+});
+
+test('the factory allocates consecutive codes for the same queue', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002');
+});
+
+test('the factory keeps an explicit code', function () {
+    $ticket = Ticket::factory()->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X');
+});
+
+test('codes grow past 999 without padding changes', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('next code follows insertion order, not string order', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1000');
+});
+
+test('deleting a ticket does not reuse its number', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    $deleted = Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $deleted->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('malformed legacy codes are skipped', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    $other = Queue::factory()->create();
+    Ticket::factory()->forQueue($other)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($other)->create(['code' => 'A-X']);
+
+    expect(Ticket::nextCode($other->id))->toBe('A002');
+});
+
+test('sequences are independent per queue', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create();
+    Ticket::factory()->forQueue($other)->create(['code' => 'A009']);
+    Ticket::factory()->forQueue($queue)->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A002')
+        ->and(Ticket::nextCode($other->id))->toBe('A010');
+});
