diff --git a/app/Notifications/ResetPasswordNotification.php b/app/Notifications/ResetPasswordNotification.php
new file mode 100644
index 0000000..74859da
--- /dev/null
+++ b/app/Notifications/ResetPasswordNotification.php
@@ -0,0 +1,24 @@
+<?php
+namespace App\Notifications;
+
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Support\Facades\Lang;
+
+class ResetPasswordNotification extends ResetPassword
+{
+    /**
+     * Override subject to use custom translation.
+     */
+    public function subject(): string
+    {
+        return Lang::get('reset_password_subject');
+    }
+
+    /**
+     * Override toMail to apply custom subject.
+     */
+    public function toMail($notifiable)
+    {
+        return parent::toMail($notifiable)->subject($this->subject());
+    }
+}
