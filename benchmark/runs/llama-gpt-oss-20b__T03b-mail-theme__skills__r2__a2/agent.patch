@@ -0,0 +1,78 @@
+<?php
+namespace App\Http\Controllers;
+
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Facades\Redirect;
+use Illuminate\Support\Facades\Session;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Route;
+use Illuminate\Support\Facades\View;
+use Illuminate\Support\Facades\Lang;
+use Illuminate\Support\Facades\Str;
+use App\Models\User;
+use Illuminate\Http\Request;
+
+class PasswordResetController
+{
+    /**
+     * Display the form to request a password reset link.
+     */
+    public function showLinkRequestForm()
+    {
+        return view('auth.forgot-password');
+    }
+
+    /**
+     * Handle sending reset link.
+     */
+    public function sendResetLinkEmail(Request $request)
+    {
+        $request->validate(['email' => 'required|email']);
+        $user = User::where('email', $request->email)->first();
+        if ($user) {
+            $token = Password::broker()->createToken($user);
+            $user->sendPasswordResetNotification($token);
+        }
+        Session::flash('status', trans('passwords.sent'));
+        return redirect()->back();
+    }
+
+    /**
+     * Display the password reset form.
+     */
+    public function showResetForm(Request $request, $token)
+    {
+        return view('auth.reset-password', [
+            'token' => $token,
+            'email' => $request->email,
+        ]);
+    }
+
+    /**
+     * Handle password reset.
+     */
+    public function reset(Request $request)
+    {
+        $request->validate([
+            'token' => 'required',
+            'email' => 'required|email',
+            'password' => ['required','string','min:8','confirmed', 'regex:/[a-z]/', 'regex:/[A-Z]/', 'regex:/[0-9]/'],
+        ]);
+
+        $user = User::where('email', $request->email)->first();
+        if (!$user || !Password::broker()->validateToken($user, $request->token)) {
+            return redirect()->route('password.request')->withErrors(['email' => Lang::get('passwords.token')]);
+        }
+
+        $user->forceFill([
+            'password' => Hash::make($request->password),
+            'remember_token' => Str::random(60),
+        ])->save();
+
+        event(new \Illuminate\Auth\Events\PasswordReset($user));
+        Auth::login($user);
+        Session::flash('status', Lang::get('passwords.reset'));
+        return redirect('/');
+    }
+}
