+<?php
+
+use App\Models\Queue;
+use App\Models\Entity;
+use App\Models\Ticket;
+
+describe('Queue', function () {
+    it('belongs to entity', function () {
+        $queue = Queue::factory()->create();
+
+        expect($queue->entity)->toBeInstanceOf(Entity::class);
+        expect($queue->entity->id)->toBe($queue->entity_id);
+    });
+
+    it('has many tickets', function () {
+        $queue = Queue::factory()->create();
+        Ticket::factory()->count(3)->forQueue($queue)->create();
+
+        expect($queue->tickets)->toHaveCount(3);
+    });
+
+    it('enforces unique slug per entity', function () {
+        $entity = Entity::factory()->create();
+        Queue::factory()->create(['entity_id' => $entity->id, 'slug' => 'queue-1']);
+
+        Queue::factory()->create(['entity_id' => $entity->id, 'slug' => 'queue-1']);
+    })->throws(\Illuminate\Database\QueryException::class);
+
+    it('allows same slug in different entities', function () {
+        $entity1 = Entity::factory()->create();
+        $entity2 = Entity::factory()->create();
+
+        $queue1 = Queue::factory()->create(['entity_id' => $entity1->id, 'slug' => 'queue-1']);
+        $queue2 = Queue::factory()->create(['entity_id' => $entity2->id, 'slug' => 'queue-1']);
+
+        expect($queue1->slug)->toBe($queue2->slug);
+        expect($queue1->entity_id)->not->toBe($queue2->entity_id);
+    });
+
+    it('casts is_active to boolean', function () {
+        $queue = Queue::factory()->create(['is_active' => true]);
+
+        expect($queue->is_active)->toBeTrue();
+
+        $queue->update(['is_active' => false]);
+        expect($queue->fresh()->is_active)->toBeFalse();
+    });
+
+    it('casts labels_i18n to array', function () {
+        $labels = ['en' => 'English', 'pt' => 'Português'];
+        $queue = Queue::factory()->create(['labels_i18n' => $labels]);
+
+        expect($queue->labels_i18n)->toBe($labels);
+        expect($queue->labels_i18n)->toBeArray();
+    });
+
+    it('handles null labels_i18n', function () {
+        $queue = Queue::factory()->create(['labels_i18n' => null]);
+
+        expect($queue->labels_i18n)->toBeNull();
+    });
+});
