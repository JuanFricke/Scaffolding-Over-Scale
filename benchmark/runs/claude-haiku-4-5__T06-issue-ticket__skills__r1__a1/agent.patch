+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use App\Models\EntityMembership;
+use App\Enums\UserRole;
+
+describe('Ticket', function () {
+    describe('call()', function () {
+        it('marks ticket as called', function () {
+            $queue = Queue::factory()->create();
+            $ticket = Ticket::factory()->forQueue($queue)->create();
+            $entity = $queue->entity;
+            $user = User::factory()->create();
+            EntityMembership::factory()->create([
+                'user_id' => $user->id,
+                'entity_id' => $entity->id,
+                'role' => UserRole::Admin->value,
+            ]);
+
+            $ticket->call($user);
+
+            expect($ticket->fresh())
+                ->status->toBe(TicketStatus::Called)
+                ->called_by_user_id->toBe($user->id)
+                ->called_at->not->toBeNull();
+        });
+
+        it('rejects call from non-member', function () {
+            $queue = Queue::factory()->create();
+            $ticket = Ticket::factory()->forQueue($queue)->create();
+            $user = User::factory()->create();
+
+            $ticket->call($user);
+        })->throws(\Illuminate\Auth\Access\AuthorizationException::class);
+
+        it('rejects calling a non-waiting ticket', function () {
+            $queue = Queue::factory()->create();
+            $ticket = Ticket::factory()->forQueue($queue)->create(['status' => TicketStatus::Called]);
+            $entity = $queue->entity;
+            $user = User::factory()->create();
+            EntityMembership::factory()->create([
+                'user_id' => $user->id,
+                'entity_id' => $entity->id,
+                'role' => UserRole::Admin->value,
+            ]);
+
+            $ticket->call($user);
+        })->throws(\LogicException::class, 'Ticket is not in waiting status');
+    });
+
+    describe('immutability', function () {
+        it('prevents modification of code after creation', function () {
+            $ticket = Ticket::factory()->create();
+            $originalCode = $ticket->code;
+
+            $ticket->code = 'A999';
+            $ticket->save();
+        })->throws(\LogicException::class, 'Cannot modify immutable field: code');
+
+        it('prevents modification of priority after creation', function () {
+            $ticket = Ticket::factory()->create();
+
+            $ticket->priority = 10;
+            $ticket->save();
+        })->throws(\LogicException::class, 'Cannot modify immutable field: priority');
+
+        it('prevents modification of channel after creation', function () {
+            $ticket = Ticket::factory()->create();
+
+            $ticket->channel = 'totem';
+            $ticket->save();
+        })->throws(\LogicException::class, 'Cannot modify immutable field: channel');
+
+        it('prevents modification of issued_at after creation', function () {
+            $ticket = Ticket::factory()->create();
+
+            $ticket->issued_at = now()->addDay();
+            $ticket->save();
+        })->throws(\LogicException::class, 'Cannot modify immutable field: issued_at');
+
+        it('allows modification of status', function () {
+            $ticket = Ticket::factory()->create();
+
+            $ticket->status = TicketStatus::Called;
+            $ticket->save();
+
+            expect($ticket->fresh()->status)->toBe(TicketStatus::Called);
+        });
+
+        it('allows modification of called_at', function () {
+            $ticket = Ticket::factory()->create();
+            $callTime = now();
+
+            $ticket->called_at = $callTime;
+            $ticket->save();
+
+            expect($ticket->fresh()->called_at)->toEqual($callTime);
+        });
+
+        it('allows modification of called_by_user_id', function () {
+            $ticket = Ticket::factory()->create();
+            $user = User::factory()->create();
+
+            $ticket->called_by_user_id = $user->id;
+            $ticket->save();
+
+            expect($ticket->fresh()->called_by_user_id)->toBe($user->id);
+        });
+    });
+
+    describe('nextCode()', function () {
+        it('returns A001 for empty queue', function () {
+            $queue = Queue::factory()->create();
+
+            $code = Ticket::nextCode($queue->id);
+
+            expect($code)->toBe('A001');
+        });
+
+        it('returns correct next code in sequence', function () {
+            $queue = Queue::factory()->create();
+            Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+            Ticket::factory()->forQueue($queue)->create(['code' => 'A002']);
+
+            $code = Ticket::nextCode($queue->id);
+
+            expect($code)->toBe('A003');
+        });
+
+        it('does not reuse deleted ticket numbers', function () {
+            $queue = Queue::factory()->create();
+            $ticket1 = Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+            Ticket::factory()->forQueue($queue)->create(['code' => 'A002']);
+            Ticket::factory()->forQueue($queue)->create(['code' => 'A003']);
+
+            // Delete A001
+            $ticket1->delete();
+
+            $code = Ticket::nextCode($queue->id);
+
+            // Even though A001 is deleted, we use A004 (max+1), not A001 (gap filling)
+            expect($code)->toBe('A004');
+        });
+
+        it('uses max code + 1 regardless of gaps', function () {
+            $queue = Queue::factory()->create();
+            Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+            Ticket::factory()->forQueue($queue)->create(['code' => 'A005']);
+            Ticket::factory()->forQueue($queue)->create(['code' => 'A003']);
+
+            $code = Ticket::nextCode($queue->id);
+
+            // Uses max (5) + 1, not gap filling
+            expect($code)->toBe('A006');
+        });
+
+        it('pads numbers with zeros', function () {
+            $queue = Queue::factory()->create();
+
+            $code = Ticket::nextCode($queue->id);
+
+            expect($code)->toMatch('/^A0+1$/');
+            expect(strlen($code))->toBe(4); // A + 3 digits
+        });
+
+        it('handles large numbers without padding', function () {
+            $queue = Queue::factory()->create();
+
+            for ($i = 1; $i <= 1001; $i++) {
+                Ticket::factory()->forQueue($queue)->create(['code' => sprintf('A%04d', $i)]);
+            }
+
+            $code = Ticket::nextCode($queue->id);
+
+            expect($code)->toBe('A1002');
+        });
+    });
+
+    describe('relationships', function () {
+        it('belongs to queue', function () {
+            $ticket = Ticket::factory()->create();
+
+            expect($ticket->queue)->toBeInstanceOf(Queue::class);
+            expect($ticket->queue->id)->toBe($ticket->queue_id);
+        });
+
+        it('belongs to calling user', function () {
+            $user = User::factory()->create();
+            $ticket = Ticket::factory()->create(['called_by_user_id' => $user->id]);
+
+            expect($ticket->calledBy)->toBeInstanceOf(User::class);
+            expect($ticket->calledBy->id)->toBe($user->id);
+        });
+
+        it('handles null called_by relationship', function () {
+            $ticket = Ticket::factory()->create(['called_by_user_id' => null]);
+
+            expect($ticket->calledBy)->toBeNull();
+        });
+    });
+});
