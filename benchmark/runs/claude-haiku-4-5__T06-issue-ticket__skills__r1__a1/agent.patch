@@ -0,0 +1,67 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+
+class IssueTicket
+{
+    private const MAX_RETRIES = 5;
+
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new \InvalidArgumentException('Priority cannot be negative');
+        }
+
+        return $this->issueWithRetry($queue, $priority, $channel, 0);
+    }
+
+    private function issueWithRetry(Queue $queue, int $priority, TicketChannel $channel, int $attempt): Ticket
+    {
+        if ($attempt >= self::MAX_RETRIES) {
+            throw new \RuntimeException('Failed to issue ticket after maximum retries');
+        }
+
+        return DB::transaction(function () use ($queue, $priority, $channel, $attempt) {
+            $queue = Queue::lockForUpdate()->find($queue->id);
+
+            if (! $queue->is_active) {
+                throw new InactiveQueueException('Queue is not active');
+            }
+
+            $code = Ticket::nextCode($queue->id);
+
+            try {
+                return Ticket::create([
+                    'queue_id' => $queue->id,
+                    'code' => $code,
+                    'priority' => $priority,
+                    'channel' => $channel,
+                    'status' => TicketStatus::Waiting,
+                    'issued_at' => now(),
+                ]);
+            } catch (QueryException $e) {
+                if ($this->isUniqueConstraintError($e)) {
+                    return $this->issueWithRetry($queue, $priority, $channel, $attempt + 1);
+                }
+                throw;
+            }
+        });
+    }
+
+    private function isUniqueConstraintError(\Illuminate\Database\QueryException $e): bool
+    {
+        $code = $e->getCode();
+        return in_array($code, ['23000', '1062'], true); // MySQL/MariaDB unique constraint error
+    }
+}
