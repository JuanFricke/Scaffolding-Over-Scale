+<?php
+
+namespace Database\Factories;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+class TicketFactory extends Factory
+{
+    protected $model = Ticket::class;
+
+    private ?Queue $queueForFactory = null;
+
+    public function definition(): array
+    {
+        $queue = $this->queueForFactory ?? Queue::factory()->create();
+
+        $code = isset($this->attributes['code']) ? $this->attributes['code'] : Ticket::nextCode($queue->id);
+
+        return [
+            'queue_id' => $queue->id,
+            'code' => $code,
+            'priority' => 0,
+            'channel' => TicketChannel::Virtual,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ];
+    }
+
+    /**
+     * Create multiple tickets for the same queue with sequential codes.
+     */
+    public function forQueue(Queue $queue): self
+    {
+        $this->queueForFactory = $queue;
+        return $this;
+    }
+}
