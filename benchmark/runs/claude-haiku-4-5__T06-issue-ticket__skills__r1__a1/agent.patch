diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..acc4e0b
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,106 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Generate the next code for a queue.
+     * Sequence: A001, A002, ..., A999, A1000, A1001, ...
+     * Malformed codes (not matching A<digits>) are skipped.
+     * Deleted codes are not reused (uses max+1, not gap filling).
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $codes = self::where('queue_id', $queueId)->pluck('code')->toArray();
+
+        $maxNumber = 0;
+        foreach ($codes as $code) {
+            if (! preg_match('/^A(\d+)$/', $code, $matches)) {
+                continue;
+            }
+            $number = (int) $matches[1];
+            $maxNumber = max($maxNumber, $number);
+        }
+
+        $nextNumber = $maxNumber + 1;
+        return 'A' . str_pad($nextNumber, max(3, strlen((string) $nextNumber)), '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call this ticket (mark as called).
+     * Only members of the ticket's entity may call the ticket.
+     * A ticket can only be called once and only when in waiting status.
+     */
+    public function call(User $user): void
+    {
+        // Verify the ticket is waiting
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new \LogicException('Ticket is not in waiting status');
+        }
+
+        // Verify the user is a member of the ticket's entity
+        $this->authorize('call', $user);
+
+        // Update ticket to called status
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->saveQuietly();
+    }
+
+    /**
+     * Authorize user to call ticket.
+     */
+    private function authorize(string $action, User $user): void
+    {
+        $membership = $user->membershipFor($this->queue->entity_id);
+        if (! $membership) {
+            throw new \Illuminate\Auth\Access\AuthorizationException();
+        }
+    }
+
+    /**
+     * Prevent mutation of immutable fields after issuance.
+     */
+    public function setAttribute($key, $value)
+    {
+        $immutableFields = ['code', 'priority', 'channel', 'issued_at'];
+        if ($this->exists && in_array($key, $immutableFields) && $this->getAttribute($key) !== $value) {
+            throw new \LogicException("Cannot modify immutable field: {$key}");
+        }
+
+        return parent::setAttribute($key, $value);
+    }
+}
