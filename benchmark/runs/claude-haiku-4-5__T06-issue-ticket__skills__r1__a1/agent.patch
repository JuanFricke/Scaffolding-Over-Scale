diff --git a/tests/Feature/IssueTicketTest.php b/tests/Feature/IssueTicketTest.php
new file mode 100644
index 0000000..e60ca5b
--- /dev/null
+++ b/tests/Feature/IssueTicketTest.php
@@ -0,0 +1,156 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+
+describe('IssueTicket', function () {
+    it('issues a ticket with default parameters', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket();
+
+        $ticket = $action($queue);
+
+        expect($ticket)
+            ->queue_id->toBe($queue->id)
+            ->status->toBe(TicketStatus::Waiting)
+            ->channel->toBe(TicketChannel::Virtual)
+            ->priority->toBe(0)
+            ->issued_at->not->toBeNull()
+            ->called_at->toBeNull()
+            ->called_by_user_id->toBeNull()
+            ->code->toMatch('/^A\d+$/');
+    });
+
+    it('issues a ticket with custom priority and channel', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket();
+
+        $ticket = $action($queue, priority: 10, channel: TicketChannel::Totem);
+
+        expect($ticket)
+            ->priority->toBe(10)
+            ->channel->toBe(TicketChannel::Totem);
+    });
+
+    it('rejects negative priority', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket();
+
+        $action($queue, priority: -1);
+    })->throws(\InvalidArgumentException::class, 'Priority cannot be negative');
+
+    it('rejects inactive queue', function () {
+        $queue = Queue::factory()->create(['is_active' => false]);
+        $action = new IssueTicket();
+
+        $action($queue);
+    })->throws(InactiveQueueException::class);
+
+    it('generates sequential codes per queue', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket();
+
+        $ticket1 = $action($queue);
+        $ticket2 = $action($queue);
+        $ticket3 = $action($queue);
+
+        expect($ticket1->code)->toBe('A001');
+        expect($ticket2->code)->toBe('A002');
+        expect($ticket3->code)->toBe('A003');
+    });
+
+    it('handles code overflow beyond 999', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket();
+
+        for ($i = 0; $i < 1000; $i++) {
+            $ticket = $action($queue);
+        }
+
+        $lastTicket = $action($queue);
+        expect($lastTicket->code)->toBe('A1001');
+    });
+
+    it('skips malformed legacy codes when generating next code', function () {
+        $queue = Queue::factory()->create();
+
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+        Ticket::factory()->forQueue($queue)->create(['code' => 'INVALID']);
+
+        $nextCode = Ticket::nextCode($queue->id);
+
+        // Only valid codes are considered; max is 0, so next is A001
+        expect($nextCode)->toBe('A001');
+    });
+
+    it('generates correct next code with mixed malformed and valid codes', function () {
+        $queue = Queue::factory()->create();
+
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']); // malformed, ignored
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A002']);
+
+        $nextCode = Ticket::nextCode($queue->id);
+
+        // Valid codes: A001, A002. Max is 2, so next is A003.
+        expect($nextCode)->toBe('A003');
+    });
+
+    it('handles concurrent issuance with retries', function () {
+        $queue = Queue::factory()->create();
+        $action = new IssueTicket();
+
+        $tickets = [];
+        for ($i = 0; $i < 10; $i++) {
+            $tickets[] = $action($queue);
+        }
+
+        expect(count(array_unique(array_map(fn ($t) => $t->code, $tickets))))->toBe(10);
+    });
+
+    it('does not persist anything on rejection for inactive queue', function () {
+        $queue = Queue::factory()->create(['is_active' => false]);
+        $action = new IssueTicket();
+        $initialCount = Ticket::count();
+
+        try {
+            $action($queue);
+        } catch (InactiveQueueException) {
+            // Expected
+        }
+
+        expect(Ticket::count())->toBe($initialCount);
+    });
+
+    it('checks queue is_active from database inside transaction', function () {
+        $queue = Queue::factory()->create(['is_active' => true]);
+        $action = new IssueTicket();
+
+        \DB::transaction(function () use ($queue, $action) {
+            // Deactivate the queue in the DB
+            $queue->update(['is_active' => false]);
+
+            // The action should still reject because it locks and reads from DB
+            $action($queue);
+        });
+    })->throws(InactiveQueueException::class);
+
+    it('unique constraint (queue_id, code) per queue', function () {
+        $queue = Queue::factory()->create();
+
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+        // Should be unique per queue - different queues can have same code
+        $otherQueue = Queue::factory()->create();
+        $ticket = Ticket::factory()->forQueue($otherQueue)->create(['code' => 'A001']);
+
+        expect($ticket->code)->toBe('A001');
+        expect($ticket->queue_id)->not->toBe($queue->id);
+    });
+});
