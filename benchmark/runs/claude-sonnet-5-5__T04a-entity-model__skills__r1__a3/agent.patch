@@ -0,0 +1,44 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the same entity may view a membership.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Owner and admin of the entity may assign roles.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->isOwnerOrAdmin($user, $membership);
+    }
+
+    /**
+     * The owner's membership is never deletable; members may remove themselves;
+     * otherwise only the entity's owner/admin may remove a member.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        return $membership->user_id === $user->id || $this->isOwnerOrAdmin($user, $membership);
+    }
+
+    private function isOwnerOrAdmin(User $user, EntityMembership $membership): bool
+    {
+        return in_array($user->membershipFor($membership->entity_id)?->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
