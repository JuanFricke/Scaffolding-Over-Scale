+++ b/tests/Feature/Models/EntityTest.php
@@ -0,0 +1,148 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity factory builds a named entity with a unique slug', function () {
+    $a = Entity::factory()->create();
+    $b = Entity::factory()->create();
+
+    expect($a->name)->not->toBeEmpty()
+        ->and($a->slug)->not->toBe($b->slug);
+});
+
+test('entity is routed by slug and soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->getRouteKeyName())->toBe('slug');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('entity slug is unique', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+
+    Entity::factory()->create(['slug' => 'acme']);
+})->throws(UniqueConstraintViolationException::class);
+
+test('entity exposes memberships, users and owner', function () {
+    $entity = Entity::factory()->create();
+    expect($entity->owner()->first())->toBeNull();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->create();
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users->pluck('id')->all())
+        ->toEqualCanonicalizing([$owner->user_id, $admin->user_id])
+        ->and($entity->owner()->first()->is($owner))->toBeTrue();
+});
+
+test('membership factory creates entity and user with employee role by default', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+});
+
+test('membership role scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->count(2)->create();
+
+    expect(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(2);
+});
+
+test('user relates to entities through memberships', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->admin()->for($user)->create();
+    EntityMembership::factory()->create();
+
+    expect($user->memberships)->toHaveCount(1)
+        ->and($user->entities->pluck('id')->all())->toBe([$membership->entity_id])
+        ->and($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor(999999))->toBeNull();
+});
+
+test('user role enum lists manageable roles', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee])
+        ->and(UserRole::Owner->value)->toBe('owner');
+});
+
+test('a user can be a member of an entity only once', function () {
+    $membership = EntityMembership::factory()->create();
+
+    EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]);
+})->throws(UniqueConstraintViolationException::class);
+
+test('the database rejects a second owner in the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+})->throws(UniqueConstraintViolationException::class);
+
+test('the database rejects promoting a second member to owner', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    $employee->update(['role' => UserRole::Owner]);
+})->throws(UniqueConstraintViolationException::class);
+
+test('different entities may each have an owner and any number of non-owners', function () {
+    EntityMembership::factory()->owner()->count(2)->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->count(2)->create();
+    EntityMembership::factory()->employee()->for($entity)->count(3)->create();
+
+    expect(EntityMembership::owner()->count())->toBe(2)
+        ->and(EntityMembership::count())->toBe(7);
+});
+
+test('owner_seq is a generated column', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $employee = EntityMembership::factory()->create();
+
+    expect(Schema::hasColumn('entity_memberships', 'owner_seq'))->toBeTrue()
+        ->and((int) $owner->fresh()->owner_seq)->toBe(1)
+        ->and($employee->fresh()->owner_seq)->toBeNull();
+});
+
+test('deleting a user or entity cascades to memberships', function () {
+    $membership = EntityMembership::factory()->create();
+    $membership->user->delete();
+    expect(EntityMembership::count())->toBe(0);
+
+    $membership = EntityMembership::factory()->create();
+    $membership->entity->forceDelete();
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('role defaults to employee at the database level', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    $id = DB::table('entity_memberships')->insertGetId(['entity_id' => $entity->id, 'user_id' => $user->id]);
+
+    expect(EntityMembership::find($id)->role)->toBe(UserRole::Employee);
+});
diff --git a/tests/Feature/Policies/EntityMembershipPolicyTest.php b/tests/Feature/Policies/EntityMembershipPolicyTest.php
new file mode 100644
index 0000000..a10a997
--- /dev/null
+++ b/tests/Feature/Policies/EntityMembershipPolicyTest.php
@@ -0,0 +1,69 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('membership abilities by actor role', function (string $role, bool $view, bool $assign, bool $deleteOther) {
+    $entity = Entity::factory()->create();
+    $actor = EntityMembership::factory()->{$role}()->for($entity)->create()->user;
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($actor, $target))->toBe($view)
+        ->and($policy->assignRole($actor, $target))->toBe($assign)
+        ->and($policy->delete($actor, $target))->toBe($deleteOther);
+})->with([
+    'owner' => ['owner', true, true, true],
+    'admin' => ['admin', true, true, true],
+    'employee' => ['employee', true, false, false],
+]);
+
+test('the owner membership can never be deleted', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($owner->user, $owner))->toBeFalse()
+        ->and($policy->delete($admin->user, $owner))->toBeFalse();
+});
+
+test('members may remove themselves', function (string $role) {
+    $membership = EntityMembership::factory()->{$role}()->create();
+
+    expect((new EntityMembershipPolicy)->delete($membership->user, $membership))->toBeTrue();
+})->with(['admin', 'employee']);
+
+test('an employee cannot remove another employee', function () {
+    $entity = Entity::factory()->create();
+    $a = EntityMembership::factory()->employee()->for($entity)->create();
+    $b = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect((new EntityMembershipPolicy)->delete($a->user, $b))->toBeFalse();
+});
+
+test('users outside the entity get nothing, even owners of other entities', function () {
+    $target = EntityMembership::factory()->employee()->create();
+    $outsider = User::factory()->create();
+    $otherOwner = EntityMembership::factory()->owner()->create()->user;
+    $policy = new EntityMembershipPolicy;
+
+    foreach ([$outsider, $otherOwner] as $user) {
+        expect($policy->view($user, $target))->toBeFalse()
+            ->and($policy->assignRole($user, $target))->toBeFalse()
+            ->and($policy->delete($user, $target))->toBeFalse();
+    }
+});
+
+test('the policy is auto-discovered by the gate', function () {
+    $entity = Entity::factory()->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create()->user;
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($admin->can('assignRole', $target))->toBeTrue();
+});
diff --git a/tests/Feature/Policies/EntityPolicyTest.php b/tests/Feature/Policies/EntityPolicyTest.php
new file mode 100644
index 0000000..d32f38f
--- /dev/null
+++ b/tests/Feature/Policies/EntityPolicyTest.php
@@ -0,0 +1,60 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Entity $entity, string $role): User
+{
+    return EntityMembership::factory()->{$role}()->for($entity)->create()->user;
+}
+
+test('anyone authenticated may create an entity', function () {
+    expect((new EntityPolicy)->create(User::factory()->create()))->toBeTrue();
+});
+
+test('entity abilities by role', function (string $role, bool $view, bool $update, bool $delete, bool $settings) {
+    $entity = Entity::factory()->create();
+    $user = memberOf($entity, $role);
+    $policy = new EntityPolicy;
+
+    expect($policy->view($user, $entity))->toBe($view)
+        ->and($policy->update($user, $entity))->toBe($update)
+        ->and($policy->delete($user, $entity))->toBe($delete)
+        ->and($policy->manageSettings($user, $entity))->toBe($settings);
+})->with([
+    'owner' => ['owner', true, true, true, true],
+    'admin' => ['admin', true, true, true, false],
+    'employee' => ['employee', true, false, false, false],
+]);
+
+test('non-members get nothing', function () {
+    $entity = Entity::factory()->create();
+    $outsider = User::factory()->create();
+    memberOf(Entity::factory()->create(), 'owner');
+    $policy = new EntityPolicy;
+
+    expect($policy->view($outsider, $entity))->toBeFalse()
+        ->and($policy->update($outsider, $entity))->toBeFalse()
+        ->and($policy->delete($outsider, $entity))->toBeFalse()
+        ->and($policy->manageSettings($outsider, $entity))->toBeFalse();
+});
+
+test('an owner of another entity has no rights here', function () {
+    $entity = Entity::factory()->create();
+    $otherOwner = memberOf(Entity::factory()->create(), 'owner');
+
+    expect($otherOwner->can('manageSettings', $entity))->toBeFalse()
+        ->and($otherOwner->can('view', $entity))->toBeFalse();
+});
+
+test('the policy is auto-discovered by the gate', function () {
+    $entity = Entity::factory()->create();
+
+    expect(memberOf($entity, 'admin')->can('update', $entity))->toBeTrue()
+        ->and(User::factory()->create()->can('create', Entity::class))->toBeTrue();
+});
