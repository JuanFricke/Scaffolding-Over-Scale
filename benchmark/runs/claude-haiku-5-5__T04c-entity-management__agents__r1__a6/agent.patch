+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('a member sees the members of the entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $colleague = EntityMembership::factory()->employee()->create(['entity_id' => $owner->entity_id]);
+
+    $this->actingAs($owner->user)
+        ->get(route('entity.members', $owner->entity))
+        ->assertOk()
+        ->assertSee($owner->user->name)
+        ->assertSee($colleague->user->email);
+});
+
+test('a non-member gets 403 on the members page', function () {
+    $entity = Entity::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.members', $entity))
+        ->assertForbidden();
+});
+
+test('an employee can view the members page', function () {
+    $employee = EntityMembership::factory()->employee()->create();
+
+    $this->actingAs($employee->user)
+        ->get(route('entity.members', $employee->entity))
+        ->assertOk();
+});
+
+test('the owner adds an existing user as an employee', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $newcomer = User::factory()->create();
+
+    Livewire::actingAs($owner->user)
+        ->test(Members::class, ['entity' => $owner->entity])
