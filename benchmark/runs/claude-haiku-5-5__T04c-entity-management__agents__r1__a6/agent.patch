diff --git a/tests/Feature/Entity/EntityDataModelTest.php b/tests/Feature/Entity/EntityDataModelTest.php
new file mode 100644
index 0000000..8bbf9e6
--- /dev/null
+++ b/tests/Feature/Entity/EntityDataModelTest.php
@@ -0,0 +1,218 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+function indexNamed(string $table, string $name): ?array
+{
+    foreach (Schema::getIndexes($table) as $index) {
+        if ($index['name'] === $name) {
+            return $index;
+        }
+    }
+
+    return null;
+}
+
+test('entities have a unique slug index with a fixed name', function () {
+    $index = indexNamed('entities', 'entities_slug_unique');
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['slug']);
+});
+
+test('a second entity with the same slug is rejected by the database', function () {
+    Entity::factory()->create(['slug' => 'padaria']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'padaria']))
+        ->toThrow(QueryException::class);
+});
+
+test('memberships are unique per entity and user', function () {
+    $index = indexNamed('entity_memberships', 'entity_memberships_entity_user_unique');
+    $membership = EntityMembership::factory()->create();
+
+    expect($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['entity_id', 'user_id'])
+        ->and(fn () => EntityMembership::factory()->create([
+            'entity_id' => $membership->entity_id,
+            'user_id' => $membership->user_id,
+        ]))->toThrow(QueryException::class);
+});
+
+test('owner_seq is a stored generated column that is 1 only for the owner', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $owner->entity_id]);
+
+    $seqs = DB::table('entity_memberships')
+        ->whereIn('id', [$owner->id, $admin->id])
+        ->pluck('owner_seq', 'id');
+
+    expect($seqs[$owner->id])->toBe(1)
+        ->and($seqs[$admin->id])->toBeNull();
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $owner->entity_id]))
+        ->toThrow(QueryException::class);
+
+    $index = indexNamed('entity_memberships', 'entity_memberships_one_owner');
+
+    expect($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['entity_id', 'owner_seq']);
+});
+
+test('an entity can have many members who are not owners', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->count(2)->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(2)->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->count())->toBe(5);
+});
+
+test('each entity may have its own owner', function () {
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect(EntityMembership::owner()->count())->toBe(2);
+});
+
+test('a membership role defaults to employee in the database', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    $membership = EntityMembership::query()->where('user_id', $user->id)->sole();
+
+    expect($membership->role)->toBe(UserRole::Employee);
+});
+
+test('membership rows are removed when their entity is force deleted', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('membership rows are removed when their user is deleted', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('entities are soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect(Entity::count())->toBe(0)
+        ->and(Entity::withTrashed()->count())->toBe(1)
+        ->and(Entity::withTrashed()->first()->deleted_at)->not->toBeNull();
+});
+
+test('entities are routed by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'padaria-central']);
+
+    expect($entity->getRouteKey())->toBe('padaria-central')
+        ->and($entity->getRouteKeyName())->toBe('slug');
+});
+
+test('entity factory generates a name and a unique slug', function () {
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    expect($first->name)->not->toBeEmpty()
+        ->and($first->slug)->not->toBeEmpty()
+        ->and($first->slug)->not->toBe($second->slug);
+});
+
+test('entity exposes its memberships, users and owner membership', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users)->toHaveCount(2)
+        ->and($entity->owner->is($owner))->toBeTrue()
+        ->and($entity->owner->is($employee))->toBeFalse();
+});
+
+test('an entity without an owner exposes no owner membership', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+
+    expect($entity->owner)->toBeNull();
+});
+
+test('membership relations point at the entity and the user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+});
+
+test('membership role is cast to UserRole', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(3)->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->owner()->count())->toBe(1)
+        ->and($entity->memberships()->admin()->count())->toBe(1)
+        ->and($entity->memberships()->employee()->count())->toBe(3);
+});
+
+test('manageable roles are admin and employee', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee])
+        ->and(UserRole::Owner->value)->toBe('owner');
+});
+
+test('user exposes memberships and entities, without soft deleted entities', function () {
+    $user = User::factory()->create();
+    $active = EntityMembership::factory()->admin()->create(['user_id' => $user->id]);
+    $trashed = EntityMembership::factory()->employee()->create(['user_id' => $user->id]);
+    $trashed->entity->delete();
+
+    expect($user->memberships)->toHaveCount(2)
+        ->and($user->entities)->toHaveCount(1)
+        ->and($user->entities->first()->is($active->entity))->toBeTrue();
+});
+
+test('membershipFor returns the membership in that entity or null', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $user = $membership->user;
+    $other = Entity::factory()->create();
+
+    expect($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor($other->id))->toBeNull();
+});
