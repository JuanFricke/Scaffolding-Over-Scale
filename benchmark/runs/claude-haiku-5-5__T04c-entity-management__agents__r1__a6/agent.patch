+test('admins, employees and non-members get 403 on the settings page', function (?string $role) {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    if ($role !== null) {
+        EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+        EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $user->id, 'role' => $role]);
+    }
+
+    $this->actingAs($user)
+        ->get(route('entity.settings', $entity))
+        ->assertForbidden();
+})->with([
+    'admin' => ['admin'],
+    'employee' => ['employee'],
+    'non-member' => [null],
