+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Validation\ValidationException;
+
+class AddMember
+{
+    /**
+     * Add an existing user to the entity as an employee.
+     */
+    public function handle(User $actor, Entity $entity, User $user): EntityMembership
+    {
+        Gate::forUser($actor)->authorize('create', [EntityMembership::class, $entity]);
+
+        if ($entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw ValidationException::withMessages(['email' => __('ui.member_already_exists')]);
+        }
+
+        return $entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+    }
+}
