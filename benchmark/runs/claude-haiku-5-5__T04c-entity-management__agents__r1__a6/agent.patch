+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('entity screens have their text in both locales', function (string $key, string $en, string $ptBR) {
+    expect(__("ui.{$key}", [], 'en'))->toBe($en)
+        ->and(__("ui.{$key}", [], 'pt_BR'))->toBe($ptBR);
+})->with([
+    'members nav' => ['nav_members', 'Members', 'Membros'],
+    'settings nav' => ['nav_settings', 'Settings', 'Configurações'],
+    'owner notice' => ['entity_owner_notice', 'You are the owner of this entity.', 'Você é o proprietário desta entidade.'],
+    'transfer ownership' => ['transfer_ownership_title', 'Transfer ownership', 'Transferir propriedade'],
+]);
+
+test('every entity screen key exists in both locale files', function () {
+    $en = require lang_path('en/ui.php');
+    $ptBR = require lang_path('pt_BR/ui.php');
+
+    $entityKeys = [
+        'nav_members', 'nav_settings', 'entity_welcome', 'entity_owner_notice',
+        'members_title', 'add_member', 'member_added', 'member_already_exists', 'too_many_add_attempts', 'member_role',
+        'role_owner', 'role_admin', 'role_employee', 'remove_member', 'confirm_remove_member',
+        'settings_title', 'settings_saved', 'slug', 'save', 'delete_entity', 'confirm_delete_entity',
+        'transfer_ownership_title', 'transfer_ownership_help', 'no_transfer_targets', 'new_owner',
+        'confirm_transfer_ownership',
+    ];
+
+    foreach ($entityKeys as $key) {
