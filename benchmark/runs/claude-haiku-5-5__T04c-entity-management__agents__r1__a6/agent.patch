diff --git a/tests/Feature/Entity/EntityPoliciesTest.php b/tests/Feature/Entity/EntityPoliciesTest.php
new file mode 100644
index 0000000..e4fd33d
--- /dev/null
+++ b/tests/Feature/Entity/EntityPoliciesTest.php
@@ -0,0 +1,168 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+// Datasets carry role strings: enum cases inside Pest datasets break collection.
+function roleFrom(?string $role): ?UserRole
+{
+    return $role === null ? null : UserRole::from($role);
+}
+
+test('policies are constructed without arguments', function () {
+    expect(new EntityPolicy)->toBeInstanceOf(EntityPolicy::class)
+        ->and(new EntityMembershipPolicy)->toBeInstanceOf(EntityMembershipPolicy::class);
+});
+
+test('policies are discovered for the models', function () {
+    expect(Gate::getPolicyFor(Entity::class))->toBeInstanceOf(EntityPolicy::class)
+        ->and(Gate::getPolicyFor(EntityMembership::class))->toBeInstanceOf(EntityMembershipPolicy::class);
+});
+
+test('any authenticated user may create an entity', function () {
+    expect(Gate::forUser(User::factory()->create())->allows('create', Entity::class))->toBeTrue();
+});
+
+test('entity abilities follow the caller role in that entity', function (?string $role, bool $view, bool $update, bool $delete, bool $settings) {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    if ($role !== null) {
+        EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $user->id, 'role' => roleFrom($role)]);
+    }
+
+    $gate = Gate::forUser($user);
+
+    expect($gate->allows('view', $entity))->toBe($view)
+        ->and($gate->allows('update', $entity))->toBe($update)
+        ->and($gate->allows('delete', $entity))->toBe($delete)
+        ->and($gate->allows('manageSettings', $entity))->toBe($settings);
+})->with([
+    'non-member' => [null, false, false, false, false],
+    'employee' => ['employee', true, false, false, false],
+    'admin' => ['admin', true, true, true, false],
+    'owner' => ['owner', true, true, true, true],
+]);
+
+test('membership in another entity grants nothing on this entity', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->owner()->create(['user_id' => $user->id]);
+
+    $gate = Gate::forUser($user);
+
+    expect($gate->allows('view', $entity))->toBeFalse()
+        ->and($gate->allows('update', $entity))->toBeFalse()
+        ->and($gate->allows('manageSettings', $entity))->toBeFalse();
+});
+
+test('membership view is open to any member of that entity', function (?string $role, bool $expected) {
+    $entity = Entity::factory()->create();
+    $caller = User::factory()->create();
+    $target = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    if ($role !== null) {
+        EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $caller->id, 'role' => roleFrom($role)]);
+    }
+
+    expect(Gate::forUser($caller)->allows('view', $target))->toBe($expected);
+})->with([
+    'owner' => ['owner', true],
+    'admin' => ['admin', true],
+    'employee' => ['employee', true],
+    'non-member' => [null, false],
+]);
+
+test('creating a membership is limited to owner and admin of that entity', function (?string $role, bool $expected) {
+    $entity = Entity::factory()->create();
+    $caller = User::factory()->create();
+
+    if ($role !== null) {
+        EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $caller->id, 'role' => roleFrom($role)]);
+    }
+
+    expect(Gate::forUser($caller)->allows('create', [EntityMembership::class, $entity]))->toBe($expected);
+})->with([
+    'owner' => ['owner', true],
+    'admin' => ['admin', true],
+    'employee' => ['employee', false],
+    'non-member' => [null, false],
+]);
+
+test('owner and admin may assign roles to non-owner members', function (string $callerRole, string $targetRole, bool $expected) {
+    $entity = Entity::factory()->create();
+    $caller = User::factory()->create();
+    $callerMembership = EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $caller->id, 'role' => roleFrom($callerRole)]);
+
+    $target = match (true) {
+        $targetRole === 'owner' && $callerRole === 'owner' => $callerMembership,
+        $targetRole === 'owner' => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]),
+        default => EntityMembership::factory()->create(['entity_id' => $entity->id, 'role' => roleFrom($targetRole)]),
+    };
+
+    expect(Gate::forUser($caller)->allows('assignRole', $target))->toBe($expected);
+})->with([
+    'owner assigns admin' => ['owner', 'admin', true],
+    'owner assigns employee' => ['owner', 'employee', true],
+    'owner cannot change own role' => ['owner', 'owner', false],
+    'admin assigns employee' => ['admin', 'employee', true],
+    'admin cannot change the owner' => ['admin', 'owner', false],
+    'employee assigns nothing' => ['employee', 'employee', false],
+]);
+
+test('non-member cannot assign roles', function () {
+    $target = EntityMembership::factory()->employee()->create();
+
+    expect(Gate::forUser(User::factory()->create())->allows('assignRole', $target))->toBeFalse();
+});
+
+test('the owner membership is never deletable, not even by the owner', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    expect(Gate::forUser($owner->user)->allows('delete', $owner))->toBeFalse();
+});
+
+test('the owner membership is never deletable by an admin either', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create(['entity_id' => $owner->entity_id, 'user_id' => $admin->id]);
+
+    expect(Gate::forUser($admin)->allows('delete', $owner))->toBeFalse();
+});
+
+test('a user may always remove their own non-owner membership', function (string $role) {
+    $membership = EntityMembership::factory()->owner()->create();
+    $own = EntityMembership::factory()->create(['entity_id' => $membership->entity_id, 'role' => roleFrom($role)]);
+
+    expect(Gate::forUser($own->user)->allows('delete', $own))->toBeTrue();
+})->with([
+    'employee' => ['employee'],
+    'admin' => ['admin'],
+]);
+
+test('owner and admin may delete other non-owner members, employees may not', function (string $callerRole, bool $expected) {
+    $entity = Entity::factory()->create();
+    $caller = User::factory()->create();
+    EntityMembership::factory()->create(['entity_id' => $entity->id, 'user_id' => $caller->id, 'role' => roleFrom($callerRole)]);
+    $target = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect(Gate::forUser($caller)->allows('delete', $target))->toBe($expected);
+})->with([
+    'owner' => ['owner', true],
+    'admin' => ['admin', true],
+    'employee' => ['employee', false],
+]);
+
+test('a non-member cannot delete a membership of the entity', function () {
+    $target = EntityMembership::factory()->employee()->create();
+
+    expect(Gate::forUser(User::factory()->create())->allows('delete', $target))->toBeFalse();
+});
diff --git a/tests/Feature/Entity/MembersTest.php b/tests/Feature/Entity/MembersTest.php
