@@ -0,0 +1,37 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use InvalidArgumentException;
+
+class AssignRole
+{
+    /**
+     * Change a non-owner membership to admin or employee.
+     */
+    public function handle(User $actor, EntityMembership $membership, UserRole $role): EntityMembership
+    {
+        Gate::forUser($actor)->authorize('assignRole', $membership);
+
+        // Owners are created by onboarding and moved only by a transfer, never by assignment.
+        if (! in_array($role, UserRole::manageable(), true)) {
+            throw new InvalidArgumentException("Role [{$role->value}] cannot be assigned.");
+        }
+
+        $membership->update(['role' => $role]);
+
+        Log::channel('audit')->info('Entity membership role changed', [
+            'entity_id' => $membership->entity_id,
+            'membership_id' => $membership->id,
+            'user_id' => $membership->user_id,
+            'role' => $role->value,
+        ]);
+
+        return $membership;
+    }
+}
