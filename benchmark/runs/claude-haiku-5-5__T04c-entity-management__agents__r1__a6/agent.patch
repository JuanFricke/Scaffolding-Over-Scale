+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,59 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Owner and admin may add members to the entity.
+     */
+    public function create(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity->id);
+    }
+
+    /**
+     * Owner and admin may assign roles, but the owner's own role is never reassigned here.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $membership->role !== UserRole::Owner && $this->isManager($user, $membership->entity_id);
+    }
+
+    /**
+     * The owner membership is never deletable. Anyone may remove their own membership,
+     * and owner and admin may remove the others.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->isManager($user, $membership->entity_id);
+    }
+
+    private function isManager(User $user, int $entityId): bool
+    {
+        $role = $user->membershipFor($entityId)?->role;
+
+        return in_array($role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
