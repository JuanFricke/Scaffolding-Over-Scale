diff --git a/tests/Feature/Entity/PickEntityTest.php b/tests/Feature/Entity/PickEntityTest.php
new file mode 100644
index 0000000..8a163b6
--- /dev/null
+++ b/tests/Feature/Entity/PickEntityTest.php
@@ -0,0 +1,78 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+test('a member picks an entity: it is stored in the session and audited', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $entity = $membership->entity;
+
+    $audit = Mockery::mock();
+    $audit->shouldReceive('info')
+        ->once()
+        ->with('Entity selected', ['user_id' => $membership->user_id, 'entity_id' => $entity->id]);
+    Log::shouldReceive('channel')->once()->with('audit')->andReturn($audit);
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('picking an entity replaces the one already in the session', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $other = EntityMembership::factory()->owner()->create(['user_id' => $membership->user_id]);
+
+    $this->actingAs($membership->user)
+        ->withSession(['current_entity_id' => $other->entity_id])
+        ->post(route('entity.pick', $membership->entity))
+        ->assertSessionHas('current_entity_id', $membership->entity_id);
+});
+
+test('a non-member gets 403 and the session is left untouched', function () {
+    $user = User::factory()->create();
+    $mine = EntityMembership::factory()->owner()->create(['user_id' => $user->id]);
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->post(route('entity.pick', $theirs))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->entity_id);
+});
+
+test('a non-member gets 403 and no session value is written', function () {
+    $user = User::factory()->create();
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $theirs))
+        ->assertForbidden()
+        ->assertSessionMissing('current_entity_id');
+});
+
+test('an unknown entity slug returns 404', function () {
+    $this->actingAs(User::factory()->create())
+        ->post('/e/nao-existe/pick')
+        ->assertNotFound();
+});
+
+test('a guest is sent to log in', function () {
+    $entity = Entity::factory()->create();
+
+    $this->post(route('entity.pick', $entity))
+        ->assertRedirect(route('login'));
+});
+
+test('an unverified member is sent to email verification', function () {
+    $membership = EntityMembership::factory()->owner()->for(User::factory()->unverified(), 'user')->create();
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $membership->entity))
+        ->assertRedirect(route('verification.notice'));
+});
