@@ -0,0 +1,30 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class DeleteEntity
+{
+    /**
+     * Soft-delete the entity and drop its memberships. Restoring is out of scope.
+     */
+    public function handle(User $actor, Entity $entity): void
+    {
+        Gate::forUser($actor)->authorize('delete', $entity);
+
+        DB::transaction(function () use ($entity) {
+            $entity->memberships()->delete();
+            $entity->delete();
+        });
+
+        Log::channel('audit')->info('Entity deleted', [
+            'entity_id' => $entity->id,
+            'user_id' => $actor->id,
+        ]);
+    }
+}
diff --git a/app/Actions/RemoveMember.php b/app/Actions/RemoveMember.php
new file mode 100644
index 0000000..e0cbcf9
--- /dev/null
+++ b/app/Actions/RemoveMember.php
@@ -0,0 +1,42 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class RemoveMember
+{
+    /**
+     * Remove a membership. The owner and the last manager (owner or admin) are never removed.
+     */
+    public function handle(User $actor, EntityMembership $membership): void
+    {
+        Gate::forUser($actor)->authorize('delete', $membership);
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true) && ! $this->hasOtherManager($membership)) {
+            throw new AuthorizationException;
+        }
+
+        $membership->delete();
+
+        Log::channel('audit')->info('Entity membership removed', [
+            'entity_id' => $membership->entity_id,
+            'membership_id' => $membership->id,
+            'user_id' => $membership->user_id,
+        ]);
+    }
+
+    private function hasOtherManager(EntityMembership $membership): bool
+    {
+        return EntityMembership::query()
+            ->where('entity_id', $membership->entity_id)
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->whereKeyNot($membership->getKey())
+            ->exists();
+    }
+}
diff --git a/app/Actions/TransferOwnership.php b/app/Actions/TransferOwnership.php
new file mode 100644
index 0000000..1b01583
--- /dev/null
+++ b/app/Actions/TransferOwnership.php
@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class TransferOwnership
+{
+    /**
+     * Move ownership from the acting owner to an admin of the same entity, atomically.
+     */
+    public function handle(User $actor, Entity $entity, ?int $targetMembershipId): void
+    {
+        Gate::forUser($actor)->authorize('manageSettings', $entity);
+
+        $newOwner = DB::transaction(function () use ($actor, $entity, $targetMembershipId) {
+            $owner = $entity->memberships()->owner()->lockForUpdate()->first();
+            $target = $entity->memberships()->admin()->whereKey($targetMembershipId)->lockForUpdate()->first();
+
+            if ($owner?->user_id !== $actor->id || $target === null || $target->user_id === $actor->id) {
+                throw new AuthorizationException;
+            }
+
+            // Demote before promoting: the (entity_id, owner_seq) index allows one owner at a time.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+
+            return $target;
+        });
+
+        Log::channel('audit')->info('Entity ownership transferred', [
+            'entity_id' => $entity->id,
+            'from_user_id' => $actor->id,
+            'to_user_id' => $newOwner->user_id,
+        ]);
+    }
+}
