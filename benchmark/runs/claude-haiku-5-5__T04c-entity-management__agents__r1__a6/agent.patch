+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('a member sees the entity name and a welcome', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $entity = $membership->entity;
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee($entity->name)
+        ->assertSee(__('ui.entity_welcome', ['name' => $entity->name]));
+});
+
+test('the owner sees the owner notice and links to members and settings', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+    $entity = $membership->entity;
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(__('ui.entity_owner_notice'))
+        ->assertSee(route('entity.members', $entity))
+        ->assertSee(route('entity.settings', $entity));
+});
+
+test('an admin links to members but never to settings', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+    $entity = $membership->entity;
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(route('entity.members', $entity))
+        ->assertDontSee(route('entity.settings', $entity))
+        ->assertDontSee(__('ui.entity_owner_notice'));
+});
+
+test('an employee links to members but never to settings', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $entity = $membership->entity;
+
+    $this->actingAs($membership->user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(route('entity.members', $entity))
+        ->assertDontSee(route('entity.settings', $entity));
+});
+
+test('a non-member gets 403', function () {
+    $entity = Entity::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.dashboard', $entity))
+        ->assertForbidden();
+});
+
+test('a member gets 403 on another entity even when the session points at their own', function () {
+    $mine = EntityMembership::factory()->owner()->create();
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($mine->user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->get(route('entity.dashboard', $theirs))
+        ->assertForbidden();
+});
+
+test('a guest is sent to log in', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.dashboard', $entity))
