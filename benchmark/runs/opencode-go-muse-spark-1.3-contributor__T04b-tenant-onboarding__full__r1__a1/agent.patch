+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Create a new policy instance.
+     */
+    public function __construct()
+    {
+        //
+    }
+
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        $actor = $user->membershipFor($membership->entity_id);
+
+        return $actor !== null
+            && in_array($actor->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        $actor = $user->membershipFor($membership->entity_id);
+
+        return $actor !== null
+            && in_array($actor->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
