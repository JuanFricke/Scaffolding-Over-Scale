@@ -0,0 +1,99 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $validated = $this->validate();
+
+        $this->authorize('create', Entity::class);
+
+        $entity = null;
+        $attempts = 0;
+
+        while ($entity === null) {
+            $attempts++;
+            $slug = $this->uniqueSlug($validated['name']);
+
+            try {
+                $entity = DB::transaction(function () use ($validated, $slug) {
+                    $created = Entity::create([
+                        'name' => $validated['name'],
+                        'slug' => $slug,
+                    ]);
+
+                    $created->memberships()->create([
+                        'user_id' => auth()->id(),
+                        'role' => UserRole::Owner->value,
+                    ]);
+
+                    return $created;
+                });
+            } catch (QueryException $e) {
+                if ($attempts >= 5 || ! $this->isUniqueViolation($e)) {
+                    throw $e;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => auth()->id(),
+        ]);
+
+        session()->put('current_entity_id', $entity->id);
+
+        $this->redirectRoute('entity.dashboard', $entity);
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name);
+
+        if ($base === '') {
+            $base = 'entity';
+        }
+
+        $slug = $base;
+        $counter = 2;
+
+        while (Entity::withTrashed()->where('slug', $slug)->exists()) {
+            $slug = $base.'-'.$counter;
+            $counter++;
+        }
+
+        return $slug;
+    }
+
+    protected function isUniqueViolation(QueryException $e): bool
+    {
+        $message = strtolower($e->getMessage());
+
+        return $e->getCode() === '23000'
+            || ($e->errorInfo[0] ?? null) === '23000'
+            || str_contains($message, 'unique')
+            || str_contains($message, 'duplicate');
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->title(__('ui.create_entity_title'));
+    }
+}
