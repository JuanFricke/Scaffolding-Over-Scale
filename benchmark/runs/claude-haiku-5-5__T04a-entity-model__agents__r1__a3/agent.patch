+    $this->entity = Entity::factory()->create();
+    $this->ownerMembership = EntityMembership::factory()->owner()->for($this->entity)->create();
+    $this->adminMembership = EntityMembership::factory()->admin()->for($this->entity)->create();
+    $this->employeeMembership = EntityMembership::factory()->employee()->for($this->entity)->create();
+    $this->employeeMembership2 = EntityMembership::factory()->employee()->for($this->entity)->create();
+    $this->owner = $this->ownerMembership->user;
+    $this->admin = $this->adminMembership->user;
+    $this->employee = $this->employeeMembership->user;
+    $this->outsider = User::factory()->create();
+});
+
+test('members of the same entity may view its memberships', function () {
+    expect($this->policy->view($this->owner, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->view($this->admin, $this->ownerMembership))->toBeTrue()
+        ->and($this->policy->view($this->employee, $this->adminMembership))->toBeTrue();
+});
+
+test('non-members and members of other entities may not view memberships', function () {
+    $otherMembership = EntityMembership::factory()->employee()->create();
+
+    expect($this->policy->view($this->outsider, $this->employeeMembership))->toBeFalse()
+        ->and($this->policy->view($otherMembership->user, $this->employeeMembership))->toBeFalse();
+});
+
+test('owner and admin may assign roles to other memberships', function () {
+    expect($this->policy->assignRole($this->owner, $this->adminMembership))->toBeTrue()
+        ->and($this->policy->assignRole($this->owner, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->assignRole($this->admin, $this->employeeMembership))->toBeTrue();
+});
+
+test('employees and non-members may not assign roles', function () {
+    $otherMembership = EntityMembership::factory()->admin()->create();
+
+    expect($this->policy->assignRole($this->employee, $this->employeeMembership2))->toBeFalse()
+        ->and($this->policy->assignRole($this->outsider, $this->employeeMembership))->toBeFalse()
+        ->and($this->policy->assignRole($otherMembership->user, $this->employeeMembership))->toBeFalse();
+});
+
+test('the owner membership role is never reassigned', function () {
+    expect($this->policy->assignRole($this->owner, $this->ownerMembership))->toBeFalse()
+        ->and($this->policy->assignRole($this->admin, $this->ownerMembership))->toBeFalse();
+});
+
+test('the owner membership is never deleted', function () {
+    expect($this->policy->delete($this->owner, $this->ownerMembership))->toBeFalse()
+        ->and($this->policy->delete($this->admin, $this->ownerMembership))->toBeFalse();
+});
+
+test('any member may remove their own membership', function () {
+    expect($this->policy->delete($this->employee, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->delete($this->admin, $this->adminMembership))->toBeTrue();
+});
+
+test('owner and admin may delete other memberships of their entity', function () {
+    expect($this->policy->delete($this->owner, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->delete($this->owner, $this->adminMembership))->toBeTrue()
+        ->and($this->policy->delete($this->admin, $this->employeeMembership))->toBeTrue()
+        ->and($this->policy->delete($this->admin, $this->adminMembership))->toBeTrue();
+});
+
+test('employees may not delete other memberships', function () {
+    expect($this->policy->delete($this->employee, $this->employeeMembership2))->toBeFalse()
+        ->and($this->policy->delete($this->employee, $this->adminMembership))->toBeFalse();
+});
+
+test('non-members and admins of other entities may not delete memberships', function () {
+    $otherAdmin = EntityMembership::factory()->admin()->create()->user;
+
+    expect($this->policy->delete($this->outsider, $this->employeeMembership))->toBeFalse()
+        ->and($this->policy->delete($otherAdmin, $this->employeeMembership))->toBeFalse();
+});
diff --git a/tests/Feature/EntityMembershipSchemaTest.php b/tests/Feature/EntityMembershipSchemaTest.php
new file mode 100644
index 0000000..36d3386
--- /dev/null
+++ b/tests/Feature/EntityMembershipSchemaTest.php
@@ -0,0 +1,143 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Returns the named index from the table, or null if it does not exist.
+ */
+function indexNamed(string $table, string $name): ?array
+{
+    return collect(Schema::getIndexes($table))->firstWhere('name', $name);
+}
+
+/**
+ * Inserts a membership row directly, bypassing Eloquent, so the database constraints are what is tested.
+ */
+function insertMembership(int $entityId, int $userId, ?string $role = null): void
+{
+    $row = ['entity_id' => $entityId, 'user_id' => $userId, 'created_at' => now(), 'updated_at' => now()];
+
+    if ($role !== null) {
+        $row['role'] = $role;
+    }
+
+    DB::table('entity_memberships')->insert($row);
+}
+
+test('entities slug has a unique index with the expected name', function () {
+    $index = indexNamed('entities', 'entities_slug_unique');
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['slug']);
+});
+
+test('the database rejects a duplicate entity slug', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))
+        ->toThrow(QueryException::class);
+});
+
+test('entity_memberships has a unique index on entity and user', function () {
+    $index = indexNamed('entity_memberships', 'entity_memberships_entity_user_unique');
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['entity_id', 'user_id']);
+});
+
+test('the database rejects a user joining the same entity twice', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    insertMembership($entity->id, $user->id, 'admin');
+
+    expect(fn () => insertMembership($entity->id, $user->id, 'employee'))
+        ->toThrow(QueryException::class);
+});
+
+test('membership role defaults to employee', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    insertMembership($entity->id, $user->id);
+
+    expect(DB::table('entity_memberships')->where('user_id', $user->id)->value('role'))
+        ->toBe('employee');
+});
+
+test('owner_seq is 1 for owners and null for every other role', function () {
+    $entity = Entity::factory()->create();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    $seqs = DB::table('entity_memberships')
+        ->whereIn('id', [$owner->id, $admin->id, $employee->id])
+        ->pluck('owner_seq', 'id');
+
+    expect($seqs[$owner->id])->toBe(1)
+        ->and($seqs[$admin->id])->toBeNull()
+        ->and($seqs[$employee->id])->toBeNull();
+});
+
+test('entity_memberships has a unique owner index on entity and owner_seq', function () {
+    $index = indexNamed('entity_memberships', 'entity_memberships_one_owner');
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['entity_id', 'owner_seq']);
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('different entities may each have their own owner', function () {
+    $first = EntityMembership::factory()->owner()->create();
+    $second = EntityMembership::factory()->owner()->create();
+
+    expect($first->entity_id)->not->toBe($second->entity_id)
+        ->and(EntityMembership::query()->owner()->count())->toBe(2);
+});
+
+test('an entity may have any number of non-owner memberships', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->count(2)->for($entity)->create();
+    EntityMembership::factory()->employee()->count(3)->for($entity)->create();
+
+    expect(EntityMembership::query()->where('entity_id', $entity->id)->count())->toBe(6);
+});
+
+test('deleting a user removes their memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::query()->whereKey($membership->id)->exists())->toBeFalse();
+});
+
+test('force deleting an entity removes its memberships', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::query()->whereKey($membership->id)->exists())->toBeFalse();
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..f45dc5a
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,135 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('entities are routed by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect((new Entity)->getRouteKeyName())->toBe('slug')
+        ->and((new Entity)->resolveRouteBinding('acme')->is($entity))->toBeTrue();
+});
+
+test('entity factory creates a non-empty name and unique slugs', function () {
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    expect($first->name)->not->toBeEmpty()
+        ->and($first->slug)->not->toBeEmpty()
+        ->and($first->slug)->not->toBe($second->slug);
+});
+
+test('deleting an entity soft deletes it', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect($entity->trashed())->toBeTrue()
+        ->and(Entity::query()->count())->toBe(0)
+        ->and(Entity::withTrashed()->count())->toBe(1);
+});
+
+test('entity exposes its memberships', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->create();
+
+    expect($entity->memberships)->toHaveCount(1)
+        ->and($entity->memberships->first()->is($membership))->toBeTrue();
+});
+
+test('entity owner returns the owner membership query', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue();
+});
+
+test('entity owner is null when the entity has no owner membership', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect($entity->owner()->first())->toBeNull();
+});
+
+test('entity exposes its users through memberships with the role pivot', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->for($user)->create();
+
+    $member = $entity->users->first();
+
+    expect($entity->users)->toHaveCount(1)
+        ->and($member->is($user))->toBeTrue()
+        ->and($member->pivot->role)->toBe(UserRole::Admin->value);
+});
+
+test('soft deleted entities are not listed as user entities', function () {
+    $membership = EntityMembership::factory()->create();
+    $user = $membership->user;
+
+    $membership->entity->delete();
+
+    expect($user->entities()->count())->toBe(0);
+});
+
+test('membership role is cast to the user role enum', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('membership role defaults to employee in the factory', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee);
+});
+
+test('membership factory creates its entity and user when none are given', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class);
+});
+
+test('membership role scopes filter by role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect(EntityMembership::query()->owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::query()->admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::query()->employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('membership belongs to an entity and a user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->entity->is(Entity::find($membership->entity_id)))->toBeTrue()
+        ->and($membership->user->is(User::find($membership->user_id)))->toBeTrue();
+});
+
+test('user exposes memberships and entities', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+    $user = $membership->user;
+
+    expect($user->memberships)->toHaveCount(1)
+        ->and($user->entities->first()->is($membership->entity))->toBeTrue()
+        ->and($user->entities->first()->pivot->role)->toBe(UserRole::Admin->value);
+});
+
+test('user membership for an entity is returned or null', function () {
+    $membership = EntityMembership::factory()->create();
+    $other = Entity::factory()->create();
+    $user = $membership->user;
+
+    expect($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor($other->id))->toBeNull();
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
