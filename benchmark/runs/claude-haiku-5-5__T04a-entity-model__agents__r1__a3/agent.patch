+<?php
+
+namespace Database\Factories;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<EntityMembership>
+ */
+class EntityMembershipFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'entity_id' => Entity::factory(),
+            'user_id' => User::factory(),
+            'role' => UserRole::Employee,
+        ];
+    }
+
+    /**
+     * Make the membership the entity owner.
+     */
+    public function owner(): static
+    {
+        return $this->state(fn (array $attributes) => [
+            'role' => UserRole::Owner,
+        ]);
+    }
+
+    /**
+     * Make the membership an admin.
+     */
+    public function admin(): static
+    {
+        return $this->state(fn (array $attributes) => [
+            'role' => UserRole::Admin,
+        ]);
+    }
+
+    /**
+     * Make the membership an employee.
+     */
+    public function employee(): static
+    {
+        return $this->state(fn (array $attributes) => [
+            'role' => UserRole::Employee,
+        ]);
+    }
+}
