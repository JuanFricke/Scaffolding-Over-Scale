+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,69 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->policy = new EntityPolicy;
+    $this->entity = Entity::factory()->create();
+    $this->owner = EntityMembership::factory()->owner()->for($this->entity)->create()->user;
+    $this->admin = EntityMembership::factory()->admin()->for($this->entity)->create()->user;
+    $this->employee = EntityMembership::factory()->employee()->for($this->entity)->create()->user;
+    $this->outsider = User::factory()->create();
+});
+
+test('any authenticated user may create an entity', function () {
+    expect($this->policy->create($this->outsider))->toBeTrue()
+        ->and($this->policy->create($this->employee))->toBeTrue();
+});
+
+test('any member of the entity may view it', function () {
+    expect($this->policy->view($this->owner, $this->entity))->toBeTrue()
+        ->and($this->policy->view($this->admin, $this->entity))->toBeTrue()
+        ->and($this->policy->view($this->employee, $this->entity))->toBeTrue();
+});
+
+test('non-members may not view the entity', function () {
+    expect($this->policy->view($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('owner and admin may update the entity', function () {
+    expect($this->policy->update($this->owner, $this->entity))->toBeTrue()
+        ->and($this->policy->update($this->admin, $this->entity))->toBeTrue();
+});
+
+test('employees and non-members may not update the entity', function () {
+    expect($this->policy->update($this->employee, $this->entity))->toBeFalse()
+        ->and($this->policy->update($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('owner and admin may delete the entity', function () {
+    expect($this->policy->delete($this->owner, $this->entity))->toBeTrue()
+        ->and($this->policy->delete($this->admin, $this->entity))->toBeTrue();
+});
+
+test('employees and non-members may not delete the entity', function () {
+    expect($this->policy->delete($this->employee, $this->entity))->toBeFalse()
+        ->and($this->policy->delete($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('only the owner may manage entity settings', function () {
+    expect($this->policy->manageSettings($this->owner, $this->entity))->toBeTrue()
+        ->and($this->policy->manageSettings($this->admin, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($this->employee, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('an admin of another entity may not manage this entity', function () {
+    $otherAdmin = EntityMembership::factory()->admin()->create()->user;
+
+    expect($this->policy->view($otherAdmin, $this->entity))->toBeFalse()
+        ->and($this->policy->update($otherAdmin, $this->entity))->toBeFalse()
+        ->and($this->policy->delete($otherAdmin, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($otherAdmin, $this->entity))->toBeFalse();
+});
