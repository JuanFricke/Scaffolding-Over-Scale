diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..9e806cd
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,129 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Contracts\Auth\MustVerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user, ?int $id = null, ?string $hash = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $id ?? $user->getKey(),
+        'hash' => $hash ?? sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('user model requires e-mail verification', function () {
+    expect(new User)->toBeInstanceOf(MustVerifyEmail::class);
+});
+
+test('notice page renders for unverified users', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee('action="'.route('verification.send').'"', false);
+
+});
+
+test('notice redirects guests to login and verified users home', function () {
+    $this->get(route('verification.notice'))->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->create())->get(route('verification.notice'))->assertRedirect(route('home'));
+});
+
+test('signed link verifies the logged-in user', function () {
+    Event::fake([Verified::class]);
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($user))->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+    Event::assertDispatched(Verified::class);
+});
+
+test('link with a tampered id is forbidden and verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $victim = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($victim))->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($victim->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('link with a wrong hash is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($user, hash: sha1('other@example.com')))->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('unsigned link is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->id, 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+});
+
+test('guests following the link are sent to login', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->get(verificationUrl($user))->assertRedirect(route('login'));
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('verification link is throttled', function () {
+    $user = User::factory()->unverified()->create();
+    $bad = verificationUrl($user, hash: 'bad');
+
+    foreach (range(1, 6) as $_) {
+        $this->actingAs($user)->get($bad)->assertForbidden();
+    }
+
+    $this->actingAs($user)->get($bad)->assertStatus(429);
+});
+
+test('resend sends the notification and flashes status', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->post(route('verification.send'))
+        ->assertRedirect(route('verification.notice'))
+        ->assertSessionHas('status');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('resend does nothing for verified users', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->post(route('verification.send'))->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('resend requires auth and is throttled', function () {
+    $this->post(route('verification.send'))->assertRedirect(route('login'));
+
+    $user = User::factory()->unverified()->create();
+    foreach (range(1, 6) as $_) {
+        $this->actingAs($user)->post(route('verification.send'))->assertSessionHas('status');
+    }
+    $this->actingAs($user)->post(route('verification.send'))->assertStatus(429);
+});
+
+test('the notice page shows the sent status translated', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->post(route('verification.send'));
+    $this->actingAs($user)->get(route('verification.notice'))
+        ->assertSee('Um novo link de verificação foi enviado');
+});
