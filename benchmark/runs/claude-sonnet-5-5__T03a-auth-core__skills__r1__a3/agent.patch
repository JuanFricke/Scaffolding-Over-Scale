+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('forgot password page renders for guests only', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('action="'.route('password.email').'"', false)
+        ->assertSee('for="email"', false);
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('password.request'))
+        ->assertRedirect(route('home'));
+});
+
+test('reset link is sent to existing users', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('unknown e-mails get the same answer and nothing is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('forgot password is throttled at 6 per minute', function () {
+    foreach (range(1, 6) as $_) {
+        $this->post(route('password.email'), ['email' => 'ghost@example.com'])->assertSessionHas('status');
+    }
+
+    $this->post(route('password.email'), ['email' => 'ghost@example.com'])->assertStatus(429);
+});
+
+test('forgot password validates the e-mail', function () {
+    $this->post(route('password.email'), ['email' => 'nope'])->assertSessionHasErrors('email');
+});
+
+test('reset form asks for the e-mail exactly once', function () {
+    $html = $this->get(route('password.reset', ['token' => 'abc', 'email' => 'a@example.com']))
+        ->assertOk()
+        ->assertSee('value="abc"', false)
+        ->assertSee('value="a@example.com"', false)
+        ->getContent();
+
+    expect(substr_count($html, 'name="email"'))->toBe(1);
+});
+
+test('password can be reset with a valid token', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old-token']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertRedirect(route('login'))->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NewSecret123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token')
+        ->and($user->remember_token)->not->toBeEmpty();
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('reset fails with an invalid token', function () {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => 'bad',
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect(Hash::check('password', $user->fresh()->password))->toBeTrue();
+});
+
+test('reset enforces the default password rule and confirmation', function () {
+    $user = User::factory()->create();
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token, 'email' => $user->email,
+        'password' => 'weak', 'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+
+    $this->post(route('password.update'), [
+        'token' => $token, 'email' => $user->email,
+        'password' => 'NewSecret123', 'password_confirmation' => 'Other123abc',
+    ])->assertSessionHasErrors('password');
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..61236a9
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,110 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function registerAs(string $email = 'ana@example.com', string $password = 'Secret123')
+{
+    return Livewire::test(Register::class)
+        ->set('name', 'Ana')
+        ->set('email', $email)
+        ->set('password', $password)
+        ->set('password_confirmation', $password);
+}
+
+test('register page renders for guests only', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSeeLivewire(Register::class)
+        ->assertSee('for="password_confirmation"', false);
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
+
+test('users can register, are logged in unverified and get the verification mail', function () {
+    Notification::fake();
+    Event::fake([Registered::class]);
+
+    registerAs()->call('submit')->assertHasNoErrors()->assertRedirect(route('home'));
+
+    $user = User::firstWhere('email', 'ana@example.com');
+    expect($user)->not->toBeNull()
+        ->and($user->email_verified_at)->toBeNull()
+        ->and(Hash::check('Secret123', $user->password))->toBeTrue();
+    $this->assertAuthenticatedAs($user);
+    Event::assertDispatched(Registered::class);
+});
+
+test('registration sends the verification notification', function () {
+    Notification::fake();
+
+    registerAs()->call('submit');
+
+    Notification::assertSentTo(User::firstWhere('email', 'ana@example.com'), VerifyEmail::class);
+});
+
+test('registration regenerates the session', function () {
+    $this->get(route('register'));
+    $before = session()->getId();
+
+    registerAs()->call('submit');
+
+    expect(session()->getId())->not->toBe($before);
+});
+
+test('e-mail is stored lowercase', function () {
+    registerAs('Ana@Example.com')->call('submit')->assertHasNoErrors();
+
+    expect(User::first()->email)->toBe('ana@example.com');
+});
+
+test('e-mail must be valid and unique', function () {
+    User::factory()->create(['email' => 'taken@example.com']);
+
+    registerAs('taken@example.com')->call('submit')->assertHasErrors(['email' => 'unique']);
+    registerAs('not-an-email')->call('submit')->assertHasErrors(['email']);
+    expect(User::count())->toBe(1);
+});
+
+test('name is required', function () {
+    registerAs()->set('name', '')->call('submit')->assertHasErrors(['name' => 'required']);
+});
+
+test('password follows the app-wide default rule', function (string $password) {
+    registerAs(password: $password)->call('submit')->assertHasErrors(['password']);
+    expect(User::count())->toBe(0);
+})->with([
+    'too short' => ['Ab1'],
+    'no uppercase' => ['secret123'],
+    'no lowercase' => ['SECRET123'],
+    'no number' => ['SecretSecret'],
+    'no letters' => ['12345678'],
+]);
+
+test('password confirmation must match', function () {
+    registerAs()->set('password_confirmation', 'Different123')->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+});
+
+test('registration is rate limited by ip', function () {
+    foreach (range(1, 5) as $i) {
+        Livewire::test(Register::class)->set('email', 'bad')->call('submit');
+    }
+
+    expect(RateLimiter::tooManyAttempts(str()->transliterate('register|127.0.0.1'), 5))->toBeTrue();
+
+    registerAs('late@example.com')->call('submit')->assertHasErrors(['email']);
+    expect(User::count())->toBe(0);
+});
