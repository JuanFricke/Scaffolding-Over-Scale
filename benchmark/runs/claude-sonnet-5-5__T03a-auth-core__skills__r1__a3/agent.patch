diff --git a/tests/Feature/Auth/LoginTest.php b/tests/Feature/Auth/LoginTest.php
new file mode 100644
index 0000000..2a0b1a9
--- /dev/null
+++ b/tests/Feature/Auth/LoginTest.php
@@ -0,0 +1,166 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Str;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('login page renders in pt_BR with accessible labels', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeLivewire(Login::class)
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?')
+        ->assertSee('for="email"', false)
+        ->assertSee('for="password"', false);
+});
+
+test('login page renders in english without portuguese', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertSee('Forgot your password?')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha');
+});
+
+test('authenticated users are redirected away from login', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('users can log in and the session is regenerated', function () {
+    $user = User::factory()->create();
+    $this->get(route('login'));
+    $before = session()->getId();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+    expect(session()->getId())->not->toBe($before);
+});
+
+test('login redirects to the intended url', function () {
+    $user = User::factory()->create();
+    session(['url.intended' => route('verification.notice')]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('remember me sets the recaller cookie', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->set('remember', true)
+        ->call('submit');
+
+    expect(Auth::getRecallerName())->not->toBeNull();
+    expect($user->fresh()->remember_token)->not->toBeNull();
+});
+
+test('wrong credentials fail with the translated message', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee(__('auth.failed'))
+        ->assertSet('password', '');
+
+    $this->assertGuest();
+    expect(__('auth.failed'))->toStartWith('Essas credenciais não correspondem');
+});
+
+test('invalid e-mail and empty password are validated', function (string $email, string $password, string $field) {
+    Livewire::test(Login::class)
+        ->set('email', $email)
+        ->set('password', $password)
+        ->call('submit')
+        ->assertHasErrors([$field]);
+})->with([
+    'not an email' => ['nope', 'secret', 'email'],
+    'empty email' => ['', 'secret', 'email'],
+    'no tld' => ['a@b', 'secret', 'email'],
+    'empty password' => ['a@example.com', '', 'password'],
+]);
+
+test('failed attempts are throttled per lowercase e-mail and ip', function () {
+    $user = User::factory()->create();
+
+    foreach (range(1, 5) as $_) {
+        Livewire::test(Login::class)
+            ->set('email', strtoupper($user->email))
+            ->set('password', 'wrong')
+            ->call('submit')
+            ->assertHasErrors(['email']);
+    }
+
+    expect(RateLimiter::tooManyAttempts(Str::transliterate(Str::lower($user->email).'|127.0.0.1'), 5))->toBeTrue();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee('Muitas tentativas de login');
+
+    $this->assertGuest();
+});
+
+test('throttling one e-mail does not lock another', function () {
+    $locked = User::factory()->create();
+    $other = User::factory()->create();
+
+    foreach (range(1, 5) as $_) {
+        Livewire::test(Login::class)->set('email', $locked->email)->set('password', 'x')->call('submit');
+    }
+
+    Livewire::test(Login::class)
+        ->set('email', $other->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+});
+
+test('a successful login clears the throttle counter', function () {
+    $user = User::factory()->create();
+    $key = Str::transliterate(Str::lower($user->email).'|127.0.0.1');
+
+    Livewire::test(Login::class)->set('email', $user->email)->set('password', 'x')->call('submit');
+    expect(RateLimiter::attempts($key))->toBe(1);
+
+    Livewire::test(Login::class)->set('email', $user->email)->set('password', 'password')->call('submit');
+    expect(RateLimiter::attempts($key))->toBe(0);
+});
+
+test('login ignores tampered locked state and cannot skip validation', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'x@example.com')
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email']);
+
+    $this->assertGuest();
+});
