diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..d43807f 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -25,6 +25,8 @@ class DiscordOpsAlert
 
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
 
+    private const string DiscordSnowflakePattern = '/^\d{17,20}$/D';
+
     /**
      * @param  array<string, mixed>  $context
      */
@@ -60,13 +62,44 @@ public function send(string $title, string $message, array $context = []): void
      */
     private function formatContent(string $title, string $message, array $context): string
     {
+        $mentionId = $this->getValidMentionId();
+        $mentionText = $mentionId ? "\n<@{$mentionId}>" : '';
+        $mentionLength = mb_strlen($mentionText);
+
         $lines = [$title, $message];
 
         foreach ($context as $key => $value) {
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $content = implode("\n", $lines);
+
+        if ($mentionText) {
+            $availableLength = self::MaxContentLength - $mentionLength;
+            $content = mb_substr($content, 0, $availableLength) . $mentionText;
+        } else {
+            $content = mb_substr($content, 0, self::MaxContentLength);
+        }
+
+        return $content;
+    }
+
+    private function getValidMentionId(): ?string
+    {
+        $mentionId = config('services.discord.mention_id');
+
+        if (! is_string($mentionId) && ! is_int($mentionId)) {
+            return null;
+        }
+
+        $mentionId = (string) $mentionId;
+        $mentionId = trim($mentionId, " \t");
+
+        if ($mentionId === '' || ! preg_match(self::DiscordSnowflakePattern, $mentionId)) {
+            return null;
+        }
+
+        return $mentionId;
     }
 
     private function safe(string $key, mixed $value): string
