diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
index 6a778a4..ac9e559 100644
--- a/tests/Feature/DiscordOpsAlertTest.php
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -121,3 +121,138 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends user mention when mention_id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    $mentionId = '12345678901234567';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Http::assertSent(function (Request $request) use ($mentionId) {
+        $content = $request['content'] ?? '';
+
+        return str_contains($content, "Alert\nMessage\n<@{$mentionId}>");
+    });
+});
+
+test('does not add mention when mention_id is not configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => null,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+});
+
+test('does not add mention when mention_id is empty string', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+});
+
+test('validates mention_id is 17-20 digits', function (?string $id, ?string $expected) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Http::assertSent(function (Request $request) use ($expected) {
+        $content = $request['content'] ?? '';
+
+        if ($expected !== null) {
+            return str_contains($content, "<@{$expected}>");
+        }
+
+        return ! str_contains($content, '<@');
+    });
+})->with([
+    '123456789012345678' => ['123456789012345678', '123456789012345678'],
+    '12345678901234567890' => ['12345678901234567890', '12345678901234567890'],
+    '12345678901234567' => ['12345678901234567', '12345678901234567'],
+    'too short' => ['123456789012', null],
+    'too long' => ['123456789012345678901', null],
+    'with spaces' => ['  12345678901234567  ', '12345678901234567'],
+    'non-digits' => ['1234567890123456ab', null],
+    '@everyone' => ['@everyone', null],
+    'with newline' => ["123456789012345678\n", null],
+]);
+
+test('reserves room for mention in 1800 character limit when configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    $mentionId = '12345678901234567';
+    $mentionText = "\n<@{$mentionId}>";
+
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $mentionId,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) use ($mentionText) {
+        $content = $request['content'] ?? '';
+
+        return mb_strlen($content) === 1800
+            && str_ends_with($content, $mentionText);
+    });
+});
+
+test('does not truncate mention even when alert is long without configured mention', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => null,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(fn (Request $request) => mb_strlen($request['content'] ?? '') === 1800);
+});
