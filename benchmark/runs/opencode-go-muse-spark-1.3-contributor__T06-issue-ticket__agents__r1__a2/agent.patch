diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..a51c51b
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,133 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use LogicException;
+
+class Ticket extends Model
+{
+    use HasFactory;
+
+    protected $fillable = [
+        'queue_id',
+        'code',
+        'priority',
+        'channel',
+        'status',
+        'issued_at',
+        'called_at',
+        'called_by_user_id',
+    ];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        // Tickets are write-once: after issuance only the call fields
+        // (plus the timestamp) may change; anything else is a bug.
+        static::saving(function (self $ticket) {
+            if (! $ticket->exists) {
+                return;
+            }
+
+            $disallowed = array_diff(
+                array_keys($ticket->getDirty()),
+                ['status', 'called_at', 'called_by_user_id', 'updated_at']
+            );
+
+            if ($disallowed !== []) {
+                throw new LogicException(
+                    'Tickets are immutable after issuance except for the call fields: '.implode(', ', $disallowed)
+                );
+            }
+        });
+
+        // Factory and direct creates may omit the code; allocate the next
+        // one for the queue. An explicit code (e.g. legacy 'A-X') is kept.
+        static::creating(function (self $ticket) {
+            if (empty($ticket->code)) {
+                $ticket->code = static::nextCode($ticket->queue_id);
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: last valid code (A<digits>) by
+     * insertion order + 1, zero-padded to at least 3 digits (A001...A1000).
+     * Malformed legacy codes are skipped; an empty queue starts at A001.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = static::query()
+            ->where('queue_id', $queueId)
+            ->orderBy('id')
+            ->pluck('code')
+            ->reduce(function (?int $carry, string $code) {
+                if (preg_match('/\AA(\d+)\z/', $code, $matches) === 1) {
+                    return (int) $matches[1];
+                }
+
+                return $carry;
+            });
+
+        return 'A'.str_pad((string) (($last ?? 0) + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Mark the ticket as called by a member of the ticket's entity.
+     * A ticket can be called exactly once.
+     *
+     * @throws AuthorizationException when the user is not an entity member
+     * @throws LogicException when the ticket is not waiting
+     */
+    public function call(User $user): void
+    {
+        $entityId = $this->queue()->firstOrFail()->entity_id;
+
+        if (! EntityMembership::query()
+            ->where('entity_id', $entityId)
+            ->where('user_id', $user->id)
+            ->exists()) {
+            throw new AuthorizationException('Only members of the entity may call tickets.');
+        }
+
+        if ($this->status !== TicketStatus::Waiting) {
+            throw new LogicException('Only waiting tickets can be called.');
+        }
+
+        $this->status = TicketStatus::Called;
+        $this->called_at = now();
+        $this->called_by_user_id = $user->id;
+        $this->save();
+    }
+}
