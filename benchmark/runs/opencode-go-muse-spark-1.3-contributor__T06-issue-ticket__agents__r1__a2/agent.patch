+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has required columns, per-entity unique slug and active default', function () {
+    expect(Schema::hasTable('queues'))->toBeTrue();
+    expect(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->create(['slug' => 'same']);
+    $other = Entity::factory()->create();
+    // Same slug is fine on another entity, rejected on the same one.
