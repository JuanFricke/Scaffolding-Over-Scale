+test('issuance retries when the computed code collides', function () {
+    $queue = Queue::factory()->create();
+    $sabotaged = false;
+    Ticket::creating(function (Ticket $pending) use ($queue, &$sabotaged) {
+        if (! $sabotaged && $pending->queue_id === $queue->id && ! empty($pending->code)) {
+            $sabotaged = true;
+            // Steal the code the action just computed so its insert collides.
+            Ticket::query()->forceCreate([
+                'queue_id' => $pending->queue_id,
+                'code' => $pending->code,
+                'priority' => 0,
+                'channel' => TicketChannel::Virtual,
+                'status' => TicketStatus::Waiting,
+                'issued_at' => now(),
+            ]);
+        }
+    });
+
+    // Without a retry the stolen A001 would bubble up as a unique violation.
+    $ticket = (new IssueTicket)($queue);
+
+    expect($sabotaged)->toBeTrue()
+        ->and(Ticket::where('queue_id', $queue->id)->count())->toBe(1)
+        ->and($ticket->code)->toBe('A001');
+});
+
