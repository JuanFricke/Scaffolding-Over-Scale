+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+use RuntimeException;
+
+class IssueTicket
+{
+    /**
+     * Issue a ticket into the given queue with the next display code.
+     *
+     * @throws InvalidArgumentException on negative priority
+     * @throws InactiveQueueException when the queue is inactive
+     */
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        $attempts = 5;
+
+        for ($attempt = 1; $attempt <= $attempts; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    // Re-read the row inside the transaction: the passed
+                    // instance may be stale (deactivated after loading).
+                    $fresh = Queue::query()->whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+                    if (! $fresh->is_active) {
+                        throw new InactiveQueueException('Cannot issue tickets into an inactive queue.');
+                    }
+
+                    return Ticket::query()->create([
+                        'queue_id' => $fresh->id,
+                        'code' => Ticket::nextCode($fresh->id),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (UniqueConstraintViolationException $e) {
+                if ($attempt >= $attempts) {
+                    throw $e;
+                }
+            } catch (QueryException $e) {
+                // Drivers that do not map to UniqueConstraintViolationException.
+                if (! $this->isUniqueViolation($e) || $attempt >= $attempts) {
+                    throw $e;
+                }
+            }
+        }
+
+        // Unreachable: the loop either returns or throws.
+        throw new RuntimeException('Could not allocate a unique ticket code.');
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains(strtolower($e->getMessage()), 'unique');
+    }
+}
