+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function validRegistration(object $component, string $email = 'maria@example.com'): object
+{
+    return $component
+        ->set('name', 'Maria Souza')
+        ->set('email', $email)
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Senha1234');
+}
+
+test('the register page is rendered in portuguese by default', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSeeText('Criar conta');
+});
+
+test('guests can register, get a verification mail and are sent home', function () {
+    Notification::fake();
+
+    validRegistration(Livewire::test(Register::class))
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'maria@example.com')->sole();
+
+    expect($user->email_verified_at)->toBeNull();
+    $this->assertAuthenticatedAs($user);
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('registration fires the Registered event', function () {
+    Event::fake([Registered::class]);
+
+    validRegistration(Livewire::test(Register::class))->call('submit')->assertHasNoErrors();
+
+    Event::assertDispatched(Registered::class);
+});
+
+test('the password must be confirmed', function () {
+    Livewire::test(Register::class)
+        ->set('name', 'Maria Souza')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Senha1234')
+        ->set('password_confirmation', 'Outra12345')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('the password follows the default password rule', function () {
+    validRegistration(Livewire::test(Register::class))
+        ->set('password', 'senhafraca')
+        ->set('password_confirmation', 'senhafraca')
+        ->call('submit')
+        ->assertHasErrors('password');
+
+    expect(User::count())->toBe(0);
+});
+
+test('the e-mail must be a valid address', function () {
+    validRegistration(Livewire::test(Register::class), 'not-an-email')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+});
+
+test('the e-mail must be unique', function () {
+    User::factory()->create(['email' => 'maria@example.com']);
+
+    validRegistration(Livewire::test(Register::class))
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique']);
+});
+
+test('registration attempts are counted per ip under the register key', function () {
+    validRegistration(Livewire::test(Register::class))->call('submit');
+
+    expect(RateLimiter::attempts(str()->transliterate('register|127.0.0.1')))->toBe(1);
+});
+
+test('registration is rate limited to five attempts per ip', function () {
+    $component = Livewire::test(Register::class);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component->set('name', '')->call('submit');
+    }
+
+    validRegistration($component)->call('submit')->assertHasErrors('email');
+
+    $seconds = RateLimiter::availableIn(str()->transliterate('register|127.0.0.1'));
+
+    expect($component->errors()->first('email'))->toBe(__('auth.throttle', ['seconds' => $seconds]))
+        ->and(User::count())->toBe(0);
+});
+
+test('authenticated users visiting the register page are redirected home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
+
+test('an authenticated user cannot register another account through the component', function () {
+    $current = User::factory()->create();
+    $this->actingAs($current);
+
+    validRegistration(Livewire::test(Register::class))
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect(User::where('email', 'maria@example.com')->exists())->toBeFalse();
+    $this->assertAuthenticatedAs($current);
+});
