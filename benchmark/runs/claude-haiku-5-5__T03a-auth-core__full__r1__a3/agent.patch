+<?php
+
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rules\Password;
+
+test('the default password rule needs 8+ characters with letters, mixed case and numbers', function () {
+    $rules = ['password' => [Password::defaults()]];
+
+    expect(Validator::make(['password' => 'Senha123'], $rules)->passes())->toBeTrue()
+        ->and(Validator::make(['password' => 'Senh123'], $rules)->fails())->toBeTrue()
+        ->and(Validator::make(['password' => 'senha1234'], $rules)->fails())->toBeTrue()
+        ->and(Validator::make(['password' => 'SenhaForte'], $rules)->fails())->toBeTrue()
+        ->and(Validator::make(['password' => '12345678'], $rules)->fails())->toBeTrue();
+});
