diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..81e681b
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,138 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Contracts\Auth\MustVerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user, ?int $id = null, ?string $hash = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $id ?? $user->getKey(),
+        'hash' => $hash ?? sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('the user model must verify its e-mail', function () {
+    expect(new User)->toBeInstanceOf(MustVerifyEmail::class);
+});
+
+test('the verification notice page is shown to unverified users', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee(__('ui.verify.resend'));
+});
+
+test('verified users are sent home from the verification notice page', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('home'));
+});
+
+test('a signed link verifies the logged in user and redirects home', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user))
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link with a tampered id returns 403 and verifies nobody', function () {
+    $user = User::factory()->unverified()->create();
+    $victim = User::factory()->unverified()->create();
+
+    // Signed for the victim (valid signature) but opened by another user.
+    $this->actingAs($user)
+        ->get(verificationUrl($victim))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($victim->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link whose id was edited after signing returns 403', function () {
+    $user = User::factory()->unverified()->create();
+    $signed = verificationUrl($user);
+    $tampered = str_replace(
+        '/email/verify/'.$user->getKey().'/',
+        '/email/verify/'.($user->getKey() + 1).'/',
+        $signed,
+    );
+
+    $this->actingAs($user)->get($tampered)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned link returns 403', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->getEmailForVerification())]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a signed link with a wrong hash returns 403', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(verificationUrl($user, hash: sha1('outro@example.com')))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('guests cannot verify through a link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->get(verificationUrl($user))->assertRedirect(route('login'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('resending sends the verification mail and flashes the status', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('verification.notice'))
+        ->assertSessionHas('status');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('resending for an already verified user sends nothing and redirects home', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('resending the verification mail is throttled to six requests per minute', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->actingAs($user)->post(route('verification.send'))->assertRedirect(route('verification.notice'));
+    }
+
+    $this->actingAs($user)->post(route('verification.send'))->assertStatus(429);
+});
+
+test('guests cannot resend the verification mail', function () {
+    $this->post(route('verification.send'))->assertRedirect(route('login'));
+});
