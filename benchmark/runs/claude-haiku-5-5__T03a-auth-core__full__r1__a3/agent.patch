diff --git a/tests/Feature/Auth/LoginTest.php b/tests/Feature/Auth/LoginTest.php
new file mode 100644
index 0000000..f3a7434
--- /dev/null
+++ b/tests/Feature/Auth/LoginTest.php
@@ -0,0 +1,138 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Cookie;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the login page is rendered in portuguese by default', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeText('Entrar')
+        ->assertSeeText('Senha')
+        ->assertSeeText('Esqueceu a senha?');
+});
+
+test('the login page is rendered in english when the locale is en', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeText('Log in')
+        ->assertDontSeeText('Entrar')
+        ->assertDontSeeText('Senha');
+});
+
+test('authenticated users visiting the login page are redirected home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('guests can log in with valid credentials', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com', 'password' => 'Senha1234']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('login redirects to the intended page', function () {
+    User::factory()->create(['email' => 'staff@example.com', 'password' => 'Senha1234']);
+    session()->put('url.intended', route('verification.notice'));
+
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('remember me queues the remember cookie', function () {
+    User::factory()->create(['email' => 'staff@example.com', 'password' => 'Senha1234']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'Senha1234')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertHasNoErrors();
+
+    expect(Cookie::queued(auth()->guard()->getRecallerName()))->not->toBeNull();
+});
+
+test('wrong credentials show the auth.failed message on email and clear the password', function () {
+    User::factory()->create(['email' => 'staff@example.com', 'password' => 'Senha1234']);
+
+    $component = Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    expect($component->errors()->first('email'))->toBe(__('auth.failed'))
+        ->and($component->get('password'))->toBe('');
+    $this->assertGuest();
+});
+
+test('login validates the e-mail format strictly', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+});
+
+test('login requires a password', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'staff@example.com')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'required']);
+});
+
+test('five failed attempts lock the e-mail and ip pair', function () {
+    User::factory()->create(['email' => 'staff@example.com', 'password' => 'Senha1234']);
+    $component = Livewire::test(Login::class);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        $component
+            ->set('email', 'staff@example.com')
+            ->set('password', 'wrong-password')
+            ->call('submit');
+
+        expect($component->errors()->first('email'))->toBe(__('auth.failed'));
+    }
+
+    $component
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    $seconds = RateLimiter::availableIn('staff@example.com|127.0.0.1');
+
+    expect($component->errors()->first('email'))->toBe(__('auth.throttle', ['seconds' => $seconds]));
+    $this->assertGuest();
+});
+
+test('an authenticated user cannot switch accounts through the login component', function () {
+    $current = User::factory()->create();
+    User::factory()->create(['email' => 'other@example.com', 'password' => 'Senha1234']);
+    $this->actingAs($current);
+
+    Livewire::test(Login::class)
+        ->set('email', 'other@example.com')
+        ->set('password', 'Senha1234')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($current);
+});
