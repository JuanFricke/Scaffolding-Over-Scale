@@ -0,0 +1,27 @@
+<?php
+
+use Illuminate\Support\Facades\File;
+
+/**
+ * @return list<string> relative paths of files under $dir whose contents match $pattern
+ */
+function filesMatching(string $dir, string $pattern): array
+{
+    return collect(File::allFiles($dir))
+        ->filter(fn ($file) => preg_match($pattern, $file->getContents()))
+        ->map(fn ($file) => $file->getPathname())
+        ->values()
+        ->all();
+}
+
+test('views never hardcode internal href or action paths', function () {
+    expect(filesMatching(resource_path('views'), '/(href|action)=["\']\//'))->toBe([]);
+});
+
+test('controllers and livewire auth classes redirect with named routes', function () {
+    $dirs = [app_path('Http/Controllers'), app_path('Livewire/Auth')];
+
+    foreach ($dirs as $dir) {
+        expect(filesMatching($dir, '/redirect\(\s*[\'"]\//'))->toBe([]);
+    }
+});
