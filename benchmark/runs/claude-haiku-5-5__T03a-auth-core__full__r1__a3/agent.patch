new file mode 100644
index 0000000..b789954
--- /dev/null
+++ b/tests/Feature/Auth/ResetPasswordTest.php
@@ -0,0 +1,78 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+function resetPayload(string $token, array $overrides = []): array
+{
+    return array_merge([
+        'token' => $token,
+        'email' => 'staff@example.com',
+        'password' => 'Nova12345',
+        'password_confirmation' => 'Nova12345',
+    ], $overrides);
+}
+
+test('the reset form asks for the e-mail exactly once', function () {
+    $html = $this->get(route('password.reset', ['token' => 'abc', 'email' => 'staff@example.com']))
+        ->assertOk()
+        ->getContent();
+
+    expect(substr_count($html, 'name="email"'))->toBe(1);
+});
+
+test('a valid token resets the password, rotates the remember token and redirects to login', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['email' => 'staff@example.com', 'password' => 'Antiga1234']);
+    $rememberBefore = $user->remember_token;
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), resetPayload($token))
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('Nova12345', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe($rememberBefore);
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token is rejected on the e-mail field', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com', 'password' => 'Antiga1234']);
+
+    $this->post(route('password.update'), resetPayload('token-invalido'))
+        ->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect(Hash::check('Antiga1234', $user->fresh()->password))->toBeTrue();
+});
+
+test('the new password must follow the default password rule', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), resetPayload($token, [
+        'password' => 'fraca',
+        'password_confirmation' => 'fraca',
+    ]))->assertSessionHasErrors('password');
+});
+
+test('the new password must be confirmed', function () {
+    $user = User::factory()->create(['email' => 'staff@example.com']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post(route('password.update'), resetPayload($token, [
+        'password_confirmation' => 'Outra12345',
+    ]))->assertSessionHasErrors(['password' => __('validation.confirmed', ['attribute' => 'password'])]);
+});
+
+test('the e-mail is required to reset the password', function () {
+    $this->post(route('password.update'), resetPayload('abc', ['email' => '']))
+        ->assertSessionHasErrors('email');
+});
