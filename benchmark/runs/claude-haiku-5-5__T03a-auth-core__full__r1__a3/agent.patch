+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password page renders the request form', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee(__('ui.forgot.submit'))
+        ->assertSee('name="email"', false);
+});
+
+test('a reset link is sent to an existing user with the sent status', function () {
+    Notification::fake();
+    $user = User::factory()->create(['email' => 'staff@example.com']);
+
+    $this->post(route('password.email'), ['email' => 'staff@example.com'])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown e-mail gets the same status and no mail is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('the forgot password request requires a valid e-mail', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+});
+
+test('forgot password is throttled to six requests per minute', function () {
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+            ->assertRedirect(route('password.request'));
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertStatus(429);
+});
