new file mode 100644
index 0000000..34868e0
--- /dev/null
+++ b/app/Livewire/Auth/Register.php
@@ -0,0 +1,81 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\Rules\Password as PasswordRule;
+use Illuminate\View\View;
+use Livewire\Attributes\Layout;
+use Livewire\Component;
+
+#[Layout('components.layouts.app')]
+class Register extends Component
+{
+    public string $name = '';
+
+    public string $email = '';
+
+    public string $password = '';
+
+    public string $password_confirmation = '';
+
+    /**
+     * Create an unverified account, log it in and send the verification mail.
+     */
+    public function submit(): void
+    {
+        if (Auth::check()) {
+            $this->redirectRoute('home');
+
+            return;
+        }
+
+        $key = str()->transliterate('register|'.request()->ip());
+
+        if (RateLimiter::tooManyAttempts($key, 5)) {
+            $this->resetErrorBag();
+            $this->addError('email', __('auth.throttle', ['seconds' => RateLimiter::availableIn($key)]));
+
+            return;
+        }
+
+        // Every submit counts, valid or not, so the unique-e-mail error cannot be used to probe accounts.
+        RateLimiter::hit($key, 60);
+
+        $this->validate();
+
+        $user = User::create([
+            'name' => $this->name,
+            'email' => $this->email,
+            'password' => $this->password,
+        ]);
+
+        event(new Registered($user));
+
+        Auth::login($user);
+        session()->regenerate();
+
+        $this->redirectRoute('home');
+    }
+
+    public function render(): View
+    {
+        return view('livewire.auth.register')->title(__('ui.register.title'));
+    }
+
+    /**
+     * @return array<string, array<int, mixed>>
+     */
+    protected function rules(): array
+    {
+        return [
+            'name' => ['required', 'string', 'max:255'],
+            'email' => ['required', 'string', 'email:rfc,strict', 'max:255', Rule::unique(User::class)],
+            'password' => ['required', 'confirmed', PasswordRule::defaults()],
+        ];
+    }
+}
