diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..7ef8c34
--- /dev/null
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -0,0 +1,94 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+test('notifier is resolvable with no constructor arguments', function () {
+    expect(new DiscordOpsAlert)->toBeInstanceOf(DiscordOpsAlert::class);
+    expect(app(DiscordOpsAlert::class))->toBeInstanceOf(DiscordOpsAlert::class);
+});
+
+test('no-op when webhook is not configured', function () {
+    Http::fake();
+    config()->set('services.discord.webhook_url', null);
+
+    (new DiscordOpsAlert)->send('Title', 'Message', ['entity_id' => 42]);
+
+    Http::assertNothingSent();
+
+    config()->set('services.discord.webhook_url', '');
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertNothingSent();
+});
+
+test('posts formatted content to the configured webhook', function () {
+    Http::fake();
+    config()->set('services.discord.webhook_url', 'https://discord.example/webhook');
+
+    (new DiscordOpsAlert)->send('Title', 'Message', ['entity_id' => 42, 'queue' => 'asaas-webhooks']);
+
+    Http::assertSent(function ($request) {
+        return $request->url() === 'https://discord.example/webhook'
+            && $request['content'] === "Title\nMessage\nentity_id=42\nqueue=asaas-webhooks";
+    });
+});
+
+test('truncates content to 1800 characters', function () {
+    Http::fake();
+    config()->set('services.discord.webhook_url', 'https://discord.example/webhook');
+
+    (new DiscordOpsAlert)->send('Title', str_repeat('a', 5000));
+
+    Http::assertSent(function ($request) {
+        return mb_strlen($request['content']) === 1800;
+    });
+});
+
+test('redacts sensitive context', function () {
+    Http::fake();
+    config()->set('services.discord.webhook_url', 'https://discord.example/webhook');
+
+    (new DiscordOpsAlert)->send('T', 'M', [
+        'password' => 'hunter2',
+        'api_key' => 'abc',
+        'queue' => 'asaas-webhooks',
+        'note' => 'call Bearer abc123 ok',
+        'details' => ['token' => 'xyz', 'id' => 1],
+    ]);
+
+    Http::assertSent(function ($request) {
+        $content = $request['content'];
+
+        return str_contains($content, 'password=[redacted]')
+            && str_contains($content, 'api_key=[redacted]')
+            && str_contains($content, 'queue=asaas-webhooks')
+            && str_contains($content, 'note=[redacted]')
+            && str_contains($content, '"token":"[redacted]"')
+            && ! str_contains($content, 'hunter2')
+            && ! str_contains($content, 'Bearer abc123');
+    });
+});
+
+test('logs error on non-2xx without leaking webhook url', function () {
+    Http::fake(['*' => Http::response('nope', 500)]);
+    Log::spy();
+    $url = 'https://discord.example/super-secret-token';
+    config()->set('services.discord.webhook_url', $url);
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function ($message, $context) use ($url) {
+        return is_string($message)
+            && ! str_contains($message, $url)
+            && ! str_contains(json_encode($context), $url);
+    });
+});
+
+test('audit channel accepts writes', function () {
+    Log::channel('audit')->info('Subscription status changed', ['from' => 'a', 'to' => 'b']);
+
+    expect(true)->toBeTrue();
+});
