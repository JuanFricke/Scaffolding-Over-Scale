diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..629040e
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,154 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+class DiscordOpsAlert
+{
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhookUrl = config('services.discord.webhook_url');
+
+        if (! is_string($webhookUrl) || $webhookUrl === '') {
+            return;
+        }
+
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->formatValue($key, $value);
+        }
+
+        $text = mb_substr(implode("\n", $lines), 0, 1800);
+
+        try {
+            $response = Http::timeout(5)->post($webhookUrl, [
+                'content' => $text,
+            ]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (Throwable $e) {
+            Log::error('Discord ops alert failed', [
+                'exception' => get_class($e),
+                'message' => $this->scrub($e->getMessage(), $webhookUrl),
+            ]);
+        }
+    }
+
+    private function formatValue(int|string $key, mixed $value): string
+    {
+        if ($this->isSensitiveKey($key)) {
+            return '[redacted]';
+        }
+
+        if (is_array($value)) {
+            $encoded = json_encode(
+                $this->redactArray($value),
+                JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE
+            );
+
+            return is_string($encoded) ? $encoded : '[redacted]';
+        }
+
+        if (is_string($value) && $this->containsBearerCredential($value)) {
+            return '[redacted]';
+        }
+
+        if (is_string($value)) {
+            return $value;
+        }
+
+        if (is_int($value) || is_float($value)) {
+            return (string) $value;
+        }
+
+        if (is_bool($value)) {
+            return $value ? 'true' : 'false';
+        }
+
+        if (is_null($value)) {
+            return 'null';
+        }
+
+        if (is_object($value) && method_exists($value, '__toString')) {
+            $string = (string) $value;
+
+            return $this->containsBearerCredential($string) ? '[redacted]' : $string;
+        }
+
+        $encoded = json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
+
+        return is_string($encoded) ? $encoded : '[redacted]';
+    }
+
+    /**
+     * @return array<array-key, mixed>
+     */
+    private function redactArray(array $data): array
+    {
+        $redacted = [];
+
+        foreach ($data as $key => $value) {
+            if ($this->isSensitiveKey($key)) {
+                $redacted[$key] = '[redacted]';
+
+                continue;
+            }
+
+            if (is_array($value)) {
+                $redacted[$key] = $this->redactArray($value);
+
+                continue;
+            }
+
+            if (is_string($value) && $this->containsBearerCredential($value)) {
+                $redacted[$key] = '[redacted]';
+
+                continue;
+            }
+
+            $redacted[$key] = $value;
+        }
+
+        return $redacted;
+    }
+
+    private function isSensitiveKey(int|string $key): bool
+    {
+        $lower = strtolower((string) $key);
+        $normalized = str_replace(['_', '-', ' '], '', $lower);
+
+        if (str_contains($normalized, 'apikey')) {
+            return true;
+        }
+
+        foreach (['password', 'token', 'secret', 'authorization', 'webhook'] as $needle) {
+            if (str_contains($lower, $needle)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function containsBearerCredential(string $value): bool
+    {
+        return (bool) preg_match('/Bearer\s+\S+/i', $value);
+    }
+
+    private function scrub(string $value, string $webhookUrl): string
+    {
+        if ($webhookUrl !== '') {
+            $value = str_replace($webhookUrl, '[redacted]', $value);
+        }
+
+        return $value;
+    }
+}
