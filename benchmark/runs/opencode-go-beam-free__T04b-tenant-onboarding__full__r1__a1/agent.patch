@@ -0,0 +1,106 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::card-page')]
+class CreateEntity extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->validate();
+
+        $user = Auth::user();
+        $name = $this->name;
+
+        $entity = null;
+        $attempts = 0;
+
+        while (true) {
+            try {
+                DB::transaction(function () use (&$entity, $name, $user): void {
+                    $slug = $this->uniqueSlug($name);
+
+                    $entity = Entity::create([
+                        'name' => $name,
+                        'slug' => $slug,
+                    ]);
+
+                    EntityMembership::create([
+                        'entity_id' => $entity->id,
+                        'user_id' => $user->id,
+                        'role' => UserRole::Owner,
+                    ]);
+                });
+
+                break;
+            } catch (QueryException $exception) {
+                if ($this->isSlugCollision($exception) && $attempts < 5) {
+                    $attempts++;
+
+                    continue;
+                }
+
+                throw $exception;
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirect(route('entity.dashboard', $entity));
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name);
+
+        if ($base === '') {
+            $base = 'entity';
+        }
+
+        $slug = $base;
+        $counter = 2;
+
+        while (Entity::where('slug', $slug)->exists()) {
+            $slug = $base.'-'.$counter;
+            $counter++;
+        }
+
+        return $slug;
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')
+            ->layout('layouts::card-page', ['title' => __('ui.create_entity_title')]);
+    }
+
+    protected function isSlugCollision(QueryException $exception): bool
+    {
+        $message = strtolower($exception->getMessage());
+
+        return str_contains($message, 'entities_slug_unique')
+            || str_contains($message, 'unique constraint')
+            || str_contains($message, 'duplicate entry');
+    }
+}
