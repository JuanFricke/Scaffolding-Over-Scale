diff --git a/tests/Feature/EntityDataModelTest.php b/tests/Feature/EntityDataModelTest.php
new file mode 100644
index 0000000..fe31c3c
--- /dev/null
+++ b/tests/Feature/EntityDataModelTest.php
@@ -0,0 +1,120 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity slugs are unique and routes bind by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect($entity->getRouteKey())->toBe('acme')
+        ->and(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique')
+        ->and(fn () => Entity::factory()->create(['slug' => 'acme']))->toThrow(QueryException::class);
+});
+
+test('a user can be a member of an entity only once', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_entity_user_unique')
+        ->and(fn () => EntityMembership::factory()->create([
+            'entity_id' => $membership->entity_id,
+            'user_id' => $membership->user_id,
+        ]))->toThrow(QueryException::class);
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]))
+        ->toThrow(QueryException::class);
+});
+
+test('the database still allows many admins and employees next to the owner', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->count(2)->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(2)->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->count())->toBe(5);
+});
+
+test('owner_seq is 1 only for the owner row, so ownership can move between rows', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+
+    expect(DB::table('entity_memberships')->where('id', $admin->id)->value('owner_seq'))->toBeNull()
+        ->and(DB::table('entity_memberships')->where('id', $owner->id)->value('owner_seq'))->toBe(1);
+
+    $owner->update(['role' => UserRole::Admin]);
+    $admin->update(['role' => UserRole::Owner]);
+
+    expect($entity->owner()->first()->is($admin))->toBeTrue();
+});
+
+test('deleting a user or an entity cascades to its memberships', function () {
+    $membership = EntityMembership::factory()->create();
+    $other = EntityMembership::factory()->create(['entity_id' => $membership->entity_id]);
+
+    $membership->user->delete();
+    expect(EntityMembership::query()->whereKey($membership->id)->exists())->toBeFalse()
+        ->and(EntityMembership::query()->whereKey($other->id)->exists())->toBeTrue();
+
+    $membership->entity->forceDelete();
+    expect(EntityMembership::query()->whereKey($other->id)->exists())->toBeFalse();
+});
+
+test('membership role is cast to the UserRole enum and defaults to employee', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->role)->toBe(UserRole::Employee)
+        ->and(EntityMembership::query()->owner()->count())->toBe(0)
+        ->and(EntityMembership::query()->employee()->count())->toBe(1);
+});
+
+test('role scopes filter memberships by role', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->owner()->count())->toBe(1)
+        ->and($entity->memberships()->admin()->count())->toBe(1)
+        ->and($entity->memberships()->employee()->count())->toBe(0);
+});
+
+test('entity exposes its owner membership and its users', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue()
+        ->and($entity->users)->toHaveCount(2)
+        ->and($entity->users->pluck('id'))->toContain($owner->user_id, $employee->user_id);
+});
+
+test('user resolves its memberships and entities, skipping soft-deleted entities', function () {
+    $user = User::factory()->create();
+    $kept = EntityMembership::factory()->create(['user_id' => $user->id]);
+    $gone = EntityMembership::factory()->create(['user_id' => $user->id]);
+    $gone->entity->delete();
+
+    expect($user->memberships()->count())->toBe(2)
+        ->and($user->entities->pluck('id')->all())->toBe([$kept->entity_id])
+        ->and($user->membershipFor($kept->entity_id)->is($kept))->toBeTrue()
+        ->and($user->membershipFor($gone->entity_id)->is($gone))->toBeTrue()
+        ->and(User::factory()->create()->membershipFor($kept->entity_id))->toBeNull();
+});
+
+test('manageable roles are admin and employee only', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee])
+        ->and(UserRole::Owner->value)->toBe('owner');
+});
diff --git a/tests/Feature/EntityMembersTest.php b/tests/Feature/EntityMembersTest.php
new file mode 100644
index 0000000..170b4e3
--- /dev/null
+++ b/tests/Feature/EntityMembersTest.php
@@ -0,0 +1,177 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->owner = EntityMembership::factory()->owner()->create();
+    $this->entity = $this->owner->entity;
+    $this->admin = EntityMembership::factory()->admin()->create(['entity_id' => $this->entity->id]);
+    $this->employee = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+});
+
+function membersPage(User $actor, Entity $entity)
+{
+    return Livewire::actingAs($actor)->test(Members::class, ['entity' => $entity]);
+}
+
+test('an owner or admin adds an existing user as an employee', function () {
+    $newcomer = User::factory()->create(['email' => 'ana@example.com']);
+
+    membersPage($this->admin->user, $this->entity)
+        ->set('email', 'ana@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors()
+        ->assertSet('email', '');
+
+    $membership = $this->entity->memberships()->where('user_id', $newcomer->id)->first();
+
+    expect($membership)->not->toBeNull()
+        ->and($membership->role)->toBe(UserRole::Employee);
+});
+
+test('adding an unknown e-mail is a validation error on email', function () {
+    membersPage($this->owner->user, $this->entity)
+        ->set('email', 'nobody@example.com')
+        ->call('addMember')
+        ->assertHasErrors(['email' => 'exists']);
+});
+
+test('adding an existing member again is an error on email', function () {
+    membersPage($this->owner->user, $this->entity)
+        ->set('email', $this->employee->user->email)
+        ->call('addMember')
+        ->assertHasErrors(['email']);
+
+    expect($this->entity->memberships()->count())->toBe(3);
+});
+
+test('an employee cannot add members', function () {
+    $newcomer = User::factory()->create();
+
+    membersPage($this->employee->user, $this->entity)
+        ->set('email', $newcomer->email)
+        ->call('addMember')
+        ->assertForbidden();
+
+    expect($this->entity->memberships()->where('user_id', $newcomer->id)->exists())->toBeFalse();
+});
+
+test('the owner can promote an employee to admin and back', function () {
+    membersPage($this->owner->user, $this->entity)
+        ->call('assignRole', $this->employee->id, 'admin')
+        ->assertHasNoErrors();
+
+    expect($this->employee->fresh()->role)->toBe(UserRole::Admin);
+
+    membersPage($this->owner->user, $this->entity)
+        ->call('assignRole', $this->employee->id, 'employee');
+
+    expect($this->employee->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('assigning the owner role is a validation error on role', function () {
+    membersPage($this->owner->user, $this->entity)
+        ->call('assignRole', $this->employee->id, 'owner')
+        ->assertHasErrors(['role']);
+
+    expect($this->employee->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('an unknown role is a validation error on role', function () {
+    membersPage($this->admin->user, $this->entity)
+        ->call('assignRole', $this->employee->id, 'superuser')
+        ->assertHasErrors(['role']);
+});
+
+test('the owner role cannot be changed through a role assignment', function () {
+    membersPage($this->admin->user, $this->entity)
+        ->call('assignRole', $this->owner->id, 'admin')
+        ->assertForbidden();
+
+    expect($this->owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('an employee cannot assign roles', function () {
+    membersPage($this->employee->user, $this->entity)
+        ->call('assignRole', $this->admin->id, 'employee')
+        ->assertForbidden();
+
+    expect($this->admin->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('memberships from another entity cannot be changed from this page', function () {
+    $foreign = EntityMembership::factory()->employee()->create();
+
+    expect(fn () => membersPage($this->owner->user, $this->entity)->call('assignRole', $foreign->id, 'admin'))
+        ->toThrow(ModelNotFoundException::class);
+
+    expect($foreign->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner can remove an employee and an admin', function () {
+    membersPage($this->owner->user, $this->entity)
+        ->call('removeMember', $this->employee->id)
+        ->assertHasNoErrors();
+
+    membersPage($this->owner->user, $this->entity)
+        ->call('removeMember', $this->admin->id);
+
+    expect(EntityMembership::query()->whereKey([$this->employee->id, $this->admin->id])->count())->toBe(0);
+});
+
+test('the owner membership is never removed', function () {
+    membersPage($this->admin->user, $this->entity)
+        ->call('removeMember', $this->owner->id)
+        ->assertForbidden();
+
+    membersPage($this->owner->user, $this->entity)
+        ->call('removeMember', $this->owner->id)
+        ->assertForbidden();
+
+    expect($this->owner->fresh())->not->toBeNull();
+});
+
+test('the last manager is never removed', function () {
+    $this->owner->delete();
+
+    membersPage($this->employee->user, $this->entity)
+        ->call('removeMember', $this->admin->id)
+        ->assertForbidden();
+
+    expect($this->admin->fresh())->not->toBeNull();
+});
+
+test('an employee cannot remove other members but can remove themselves', function () {
+    $other = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+
+    membersPage($this->employee->user, $this->entity)
+        ->call('removeMember', $other->id)
+        ->assertForbidden();
+
+    expect($other->fresh())->not->toBeNull();
+
+    membersPage($this->employee->user, $this->entity)
+        ->call('removeMember', $this->employee->id)
+        ->assertRedirect(route('home'));
+
+    expect($this->employee->fresh())->toBeNull();
+});
+
+test('a member who removes themselves stops having that entity selected', function () {
+    session(['current_entity_id' => $this->entity->id]);
+
+    Livewire::actingAs($this->employee->user)
+        ->test(Members::class, ['entity' => $this->entity])
+        ->call('removeMember', $this->employee->id);
+
+    expect(session('current_entity_id'))->toBeNull();
+});
diff --git a/tests/Feature/EntityPagesTest.php b/tests/Feature/EntityPagesTest.php
new file mode 100644
index 0000000..5127bdf
--- /dev/null
+++ b/tests/Feature/EntityPagesTest.php
@@ -0,0 +1,100 @@
+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Livewire\Entity\Members;
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->owner = EntityMembership::factory()->owner()->create(['entity_id' => Entity::factory()->create(['name' => 'Acme'])->id]);
+    $this->entity = $this->owner->entity;
+    $this->admin = EntityMembership::factory()->admin()->create(['entity_id' => $this->entity->id]);
+    $this->employee = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+});
+
+test('the dashboard shows the entity, a welcome and the owner notice to the owner', function () {
+    $this->actingAs($this->owner->user)
+        ->get(route('entity.dashboard', $this->entity))
+        ->assertOk()
+        ->assertSee('Acme')
+        ->assertSee('Bem-vindo(a) a Acme')
+        ->assertSee('Você é o proprietário desta entidade.')
+        ->assertSee(route('entity.settings', $this->entity), false)
+        ->assertSee(route('entity.members', $this->entity), false);
+});
+
+test('the dashboard hides the owner notice and the settings link from non-owners', function () {
+    foreach ([$this->admin, $this->employee] as $membership) {
+        $this->actingAs($membership->user)
+            ->get(route('entity.dashboard', $this->entity))
+            ->assertOk()
+            ->assertDontSee('Você é o proprietário desta entidade.')
+            ->assertDontSee(route('entity.settings', $this->entity), false)
+            ->assertSee(route('entity.members', $this->entity), false);
+    }
+});
+
+test('dashboard, members and settings are forbidden to non-members', function () {
+    $outsider = User::factory()->create();
+
+    $this->actingAs($outsider)->get(route('entity.dashboard', $this->entity))->assertForbidden();
+    $this->actingAs($outsider)->get(route('entity.members', $this->entity))->assertForbidden();
+    $this->actingAs($outsider)->get(route('entity.settings', $this->entity))->assertForbidden();
+});
+
+test('members can see the members page while only the owner can mount settings', function () {
+    $this->actingAs($this->employee->user)
+        ->get(route('entity.members', $this->entity))
+        ->assertOk();
+
+    $this->actingAs($this->admin->user)
+        ->get(route('entity.settings', $this->entity))
+        ->assertForbidden();
+
+    $this->actingAs($this->employee->user)
+        ->get(route('entity.settings', $this->entity))
+        ->assertForbidden();
+});
+
+test('the entity route binds by slug and does not resolve soft-deleted entities', function () {
+    $this->actingAs($this->owner->user)
+        ->get('/e/'.$this->entity->slug)
+        ->assertOk();
+
+    $this->entity->delete();
+
+    $this->actingAs($this->owner->user)
+        ->get('/e/'.$this->entity->slug)
+        ->assertNotFound();
+});
+
+test('pages mount with the entity passed as a parameter', function () {
+    Livewire::actingAs($this->owner->user)
+        ->test(Dashboard::class, ['entity' => $this->entity])
+        ->assertSet('entity.id', $this->entity->id)
+        ->assertSee('Acme');
+
+    Livewire::actingAs($this->employee->user)
+        ->test(Members::class, ['entity' => $this->entity])
+        ->assertSet('entity.id', $this->entity->id);
+});
+
+test('mounting settings for a non-owner throws an authorization error', function () {
+    Livewire::actingAs($this->admin->user)
+        ->test(Settings::class, ['entity' => $this->entity])
+        ->assertForbidden();
+});
+
+test('the en and pt_BR screen texts define the same keys', function () {
+    $en = array_keys(require base_path('lang/en/ui.php'));
+    $ptBr = array_keys(require base_path('lang/pt_BR/ui.php'));
+
+    expect($ptBr)->toEqualCanonicalizing($en)
+        ->and($en)->toContain('nav_members', 'nav_settings', 'entity_owner_notice', 'transfer_title');
+});
diff --git a/tests/Feature/EntityPickTest.php b/tests/Feature/EntityPickTest.php
new file mode 100644
