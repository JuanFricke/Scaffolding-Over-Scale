+
+test('the owner transfers ownership to an admin atomically and lands on the dashboard', function () {
+    settingsPage($this->owner->user, $this->entity)
+        ->set('targetMembershipId', $this->admin->id)
+        ->call('transfer')
+        ->assertRedirect(route('entity.dashboard', $this->entity));
+
+    expect($this->owner->fresh()->role)->toBe(UserRole::Admin)
+        ->and($this->admin->fresh()->role)->toBe(UserRole::Owner)
+        ->and($this->entity->fresh()->owner()->first()->is($this->admin))->toBeTrue();
+});
+
+test('ownership can only be transferred to an admin of this entity', function () {
+    $otherEntity = EntityMembership::factory()->admin()->create();
+
+    settingsPage($this->owner->user, $this->entity)
+        ->set('targetMembershipId', $this->employee->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    settingsPage($this->owner->user, $this->entity)
+        ->set('targetMembershipId', $otherEntity->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    settingsPage($this->owner->user, $this->entity)
+        ->set('targetMembershipId', null)
+        ->call('transfer')
+        ->assertForbidden();
+
+    settingsPage($this->owner->user, $this->entity)
+        ->set('targetMembershipId', $this->owner->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($this->owner->fresh()->role)->toBe(UserRole::Owner)
+        ->and($this->employee->fresh()->role)->toBe(UserRole::Employee)
+        ->and($otherEntity->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('ownership transfer is forbidden when the owner row is gone', function () {
