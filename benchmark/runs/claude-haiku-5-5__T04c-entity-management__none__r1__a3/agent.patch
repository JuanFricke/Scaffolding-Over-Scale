+<?php
+
+namespace App\Models;
+
+enum UserRole: string
+{
+    case Owner = 'owner';
+    case Admin = 'admin';
+    case Employee = 'employee';
+
+    /**
+     * Roles an owner or admin may assign to a membership. Ownership only moves through transfer.
+     *
+     * @return list<self>
+     */
+    public static function manageable(): array
+    {
+        return [self::Admin, self::Employee];
+    }
+}
