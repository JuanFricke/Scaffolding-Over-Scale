+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->owner = EntityMembership::factory()->owner()->create();
+    $this->entity = $this->owner->entity;
+    $this->admin = EntityMembership::factory()->admin()->create(['entity_id' => $this->entity->id]);
+    $this->employee = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+});
+
+function settingsPage($actor, Entity $entity)
+{
+    return Livewire::actingAs($actor)->test(Settings::class, ['entity' => $entity]);
+}
+
+test('the owner sees the current name and slug', function () {
+    settingsPage($this->owner->user, $this->entity)
+        ->assertSet('name', $this->entity->name)
+        ->assertSet('slug', $this->entity->slug);
+});
+
+test('admins and employees cannot open the settings page', function () {
+    settingsPage($this->admin->user, $this->entity)->assertForbidden();
+    settingsPage($this->employee->user, $this->entity)->assertForbidden();
+});
+
+test('the owner saves the name and slug and lands on the new settings address', function () {
+    settingsPage($this->owner->user, $this->entity)
+        ->set('name', 'Clínica Nova')
+        ->set('slug', 'clinica-nova')
+        ->call('save')
+        ->assertRedirect(route('entity.settings', ['entity' => 'clinica-nova']));
+
+    expect($this->entity->fresh())
+        ->name->toBe('Clínica Nova')
+        ->slug->toBe('clinica-nova');
+});
+
+test('the slug may stay the same when saving', function () {
+    settingsPage($this->owner->user, $this->entity)
+        ->set('name', 'Renamed')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    expect($this->entity->fresh()->name)->toBe('Renamed');
+});
+
+test('a slug taken by another entity is a validation error on slug', function () {
+    $taken = Entity::factory()->create(['slug' => 'taken-slug']);
+
+    settingsPage($this->owner->user, $this->entity)
+        ->set('slug', 'taken-slug')
+        ->call('save')
+        ->assertHasErrors(['slug' => 'unique']);
+
+    expect($this->entity->fresh()->slug)->not->toBe('taken-slug')
+        ->and($taken->fresh()->slug)->toBe('taken-slug');
+});
+
+test('a slug with invalid characters is a validation error on slug', function () {
+    settingsPage($this->owner->user, $this->entity)
+        ->set('slug', 'Not A Slug!')
+        ->call('save')
+        ->assertHasErrors(['slug']);
+});
+
+test('the entity cannot be swapped from the client', function () {
+    $other = Entity::factory()->create();
+
+    expect(fn () => settingsPage($this->owner->user, $this->entity)->set('entity', $other))
+        ->toThrow(Exception::class, 'Cannot update locked property');
+});
+
+test('a demoted owner cannot save through an already-mounted page', function () {
+    $page = settingsPage($this->owner->user, $this->entity);
+
+    $this->owner->update(['role' => UserRole::Employee]);
+
+    $page->set('name', 'Hijacked')
+        ->call('save')
+        ->assertForbidden();
+
+    expect($this->entity->fresh()->name)->not->toBe('Hijacked');
+});
+
+test('deleting the entity soft-deletes it, removes its memberships and clears the session', function () {
+    session(['current_entity_id' => $this->entity->id]);
+
+    settingsPage($this->owner->user, $this->entity)
+        ->call('delete')
+        ->assertRedirect(route('home'));
+
+    expect(Entity::withTrashed()->whereKey($this->entity->id)->first()->trashed())->toBeTrue()
+        ->and(EntityMembership::query()->where('entity_id', $this->entity->id)->count())->toBe(0)
+        ->and(session('current_entity_id'))->toBeNull();
+});
+
+test('deleting an entity leaves the selection alone when it was another entity', function () {
+    $otherEntity = Entity::factory()->create();
+    session(['current_entity_id' => $otherEntity->id]);
+
+    settingsPage($this->owner->user, $this->entity)->call('delete');
+
+    expect(session('current_entity_id'))->toBe($otherEntity->id);
+});
+
+test('an admin cannot delete the entity through the settings actions', function () {
+    $page = settingsPage($this->owner->user, $this->entity);
+
+    $this->owner->update(['role' => UserRole::Admin]);
+
+    $page->call('delete')
+        ->assertForbidden();
+
+    expect($this->entity->fresh())->not->toBeNull();
