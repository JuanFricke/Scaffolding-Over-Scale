diff --git a/app/Livewire/Entity/Members.php b/app/Livewire/Entity/Members.php
new file mode 100644
index 0000000..cb5a4b0
--- /dev/null
+++ b/app/Livewire/Entity/Members.php
@@ -0,0 +1,133 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $email = '';
+
+    public ?string $status = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        // Managing members is the owner/admin right the entity `update` rule already grants.
+        $this->authorize('update', $this->entity);
+
+        $validated = $this->validate([
+            'email' => ['required', 'email', 'exists:users,email'],
+        ]);
+
+        $user = User::query()->where('email', $validated['email'])->firstOrFail();
+
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw ValidationException::withMessages(['email' => __('ui.member_already_exists')]);
+        }
+
+        $membership = $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        Log::channel('audit')->info('Entity member added', [
+            'entity_id' => $this->entity->id,
+            'membership_id' => $membership->id,
+            'by_user_id' => auth()->id(),
+        ]);
+
+        $this->reset('email');
+        $this->status = __('ui.member_added');
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        $membership = $this->membershipOf($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        $validated = validator(['role' => $role], [
+            'role' => ['required', Rule::enum(UserRole::class)->only(UserRole::manageable())],
+        ])->validate();
+
+        $previous = $membership->role;
+        $membership->update(['role' => $validated['role']]);
+
+        Log::channel('audit')->info('Entity member role changed', [
+            'entity_id' => $this->entity->id,
+            'membership_id' => $membership->id,
+            'from' => $previous->value,
+            'to' => $membership->role->value,
+            'by_user_id' => auth()->id(),
+        ]);
+
+        $this->status = __('ui.member_role_updated');
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = $this->membershipOf($membershipId);
+
+        $this->authorize('delete', $membership);
+
+        $isSelf = $membership->user_id === auth()->id();
+
+        $membership->delete();
+
+        Log::channel('audit')->info('Entity member removed', [
+            'entity_id' => $this->entity->id,
+            'membership_id' => $membership->id,
+            'by_user_id' => auth()->id(),
+        ]);
+
+        if ($isSelf) {
+            // The caller no longer belongs to this entity, so it must not stay selected.
+            if ((int) session('current_entity_id') === $this->entity->id) {
+                session()->forget('current_entity_id');
+            }
+
+            $this->redirectRoute('home');
+
+            return;
+        }
+
+        $this->status = __('ui.member_removed');
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+            'roles' => UserRole::manageable(),
+        ]);
+    }
+
+    /**
+     * Memberships are looked up through the locked entity, so an id from another entity is not found.
+     */
+    private function membershipOf(int $membershipId): EntityMembership
+    {
+        return $this->entity->memberships()->findOrFail($membershipId);
+    }
+}
