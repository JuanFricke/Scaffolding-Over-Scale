--- /dev/null
+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,62 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * The owner's role only changes through an ownership transfer, never through a role assignment.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $membership->role !== UserRole::Owner
+            && $this->isManager($user, $membership->entity_id);
+    }
+
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($this->isLastManager($membership)) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->id) {
+            return true;
+        }
+
+        return $this->isManager($user, $membership->entity_id);
+    }
+
+    private function isManager(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership !== null && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    private function isLastManager(EntityMembership $membership): bool
+    {
+        if (! in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            return false;
+        }
+
+        $managers = EntityMembership::query()
+            ->where('entity_id', $membership->entity_id)
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->count();
+
+        return $managers <= 1;
+    }
+}
