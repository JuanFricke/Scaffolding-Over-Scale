+++ b/tests/Feature/EntityPickTest.php
@@ -0,0 +1,68 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+test('a member can pick an entity, which is stored in the session and audited', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $entity = $membership->entity;
+
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->withArgs(
+        fn (string $message, array $context) => $context['entity_id'] === $entity->id
+            && $context['user_id'] === $membership->user_id
+    );
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('picking an entity the user does not belong to is forbidden and leaves the session untouched', function () {
+    $mine = EntityMembership::factory()->owner()->create();
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($mine->user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->post(route('entity.pick', $theirs))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->entity_id);
+});
+
+test('guests and unverified users cannot pick an entity', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $this->post(route('entity.pick', $membership->entity))
+        ->assertRedirect(route('login'));
+
+    $unverified = EntityMembership::factory()->owner()->create(['user_id' => User::factory()->unverified()->create()->id]);
+
+    $this->actingAs($unverified->user)
+        ->post(route('entity.pick', $unverified->entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('a stale session pointing at another entity does not grant access to the pages', function () {
+    $member = EntityMembership::factory()->employee()->create();
+    $other = EntityMembership::factory()->owner()->create();
+
+    $this->actingAs($member->user)
+        ->withSession(['current_entity_id' => $other->entity_id])
+        ->get(route('entity.dashboard', $member->entity))
+        ->assertOk();
+
+    $this->actingAs($member->user)
+        ->withSession(['current_entity_id' => $other->entity_id])
+        ->get(route('entity.settings', $member->entity))
+        ->assertForbidden();
+});
+
+test('pick does not grant anything by itself to a user without membership', function () {
+    expect(User::factory()->create()->membershipFor(Entity::factory()->create()->id))->toBeNull();
+});
diff --git a/tests/Feature/EntityPoliciesTest.php b/tests/Feature/EntityPoliciesTest.php
new file mode 100644
index 0000000..12fc96f
--- /dev/null
+++ b/tests/Feature/EntityPoliciesTest.php
@@ -0,0 +1,111 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = EntityMembership::factory()->owner()->create(['entity_id' => $this->entity->id]);
+    $this->admin = EntityMembership::factory()->admin()->create(['entity_id' => $this->entity->id]);
+    $this->employee = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+    $this->outsider = User::factory()->create();
+});
+
+test('any authenticated user may create an entity', function () {
+    expect((new EntityPolicy)->create(User::factory()->create()))->toBeTrue();
+});
+
+test('entity view is open to every member and closed to outsiders', function () {
+    $policy = new EntityPolicy;
+
+    expect($policy->view($this->owner->user, $this->entity))->toBeTrue()
+        ->and($policy->view($this->admin->user, $this->entity))->toBeTrue()
+        ->and($policy->view($this->employee->user, $this->entity))->toBeTrue()
+        ->and($policy->view($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('owner and admin may update and delete the entity, employees and outsiders may not', function () {
+    $policy = new EntityPolicy;
+
+    foreach (['update', 'delete'] as $ability) {
+        expect($policy->{$ability}($this->owner->user, $this->entity))->toBeTrue()
+            ->and($policy->{$ability}($this->admin->user, $this->entity))->toBeTrue()
+            ->and($policy->{$ability}($this->employee->user, $this->entity))->toBeFalse()
+            ->and($policy->{$ability}($this->outsider, $this->entity))->toBeFalse();
+    }
+});
+
+test('only the owner may manage entity settings', function () {
+    $policy = new EntityPolicy;
+
+    expect($policy->manageSettings($this->owner->user, $this->entity))->toBeTrue()
+        ->and($policy->manageSettings($this->admin->user, $this->entity))->toBeFalse()
+        ->and($policy->manageSettings($this->employee->user, $this->entity))->toBeFalse()
+        ->and($policy->manageSettings($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('membership view is open to members of that entity only', function () {
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($this->employee->user, $this->admin))->toBeTrue()
+        ->and($policy->view($this->outsider, $this->admin))->toBeFalse();
+});
+
+test('owner and admin may assign roles, except to the owner row', function () {
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->assignRole($this->owner->user, $this->employee))->toBeTrue()
+        ->and($policy->assignRole($this->admin->user, $this->employee))->toBeTrue()
+        ->and($policy->assignRole($this->employee->user, $this->employee))->toBeFalse()
+        ->and($policy->assignRole($this->outsider, $this->employee))->toBeFalse()
+        ->and($policy->assignRole($this->owner->user, $this->owner))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($this->owner->user, $this->owner))->toBeFalse();
+});
+
+test('any member may remove their own membership', function () {
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($this->employee->user, $this->employee))->toBeTrue()
+        ->and($policy->delete($this->admin->user, $this->admin))->toBeTrue();
+});
+
+test('otherwise only owner and admin may delete memberships', function () {
+    $policy = new EntityMembershipPolicy;
+
+    $other = EntityMembership::factory()->employee()->create(['entity_id' => $this->entity->id]);
+
+    expect($policy->delete($this->owner->user, $other))->toBeTrue()
+        ->and($policy->delete($this->admin->user, $other))->toBeTrue()
+        ->and($policy->delete($this->employee->user, $this->admin))->toBeFalse()
+        ->and($policy->delete($this->outsider, $other))->toBeFalse();
+});
+
+test('the last manager cannot be deleted', function () {
+    $policy = new EntityMembershipPolicy;
+
+    // Without an owner row the admin is the only manager left.
+    $this->owner->delete();
+
+    expect($policy->delete($this->owner->user, $this->admin))->toBeFalse()
+        ->and($policy->delete($this->admin->user, $this->admin))->toBeFalse();
+});
+
+test('memberships of other entities do not grant access', function () {
+    $otherEntity = Entity::factory()->create();
+    $otherAdmin = EntityMembership::factory()->admin()->create(['entity_id' => $otherEntity->id]);
+
+    expect((new EntityMembershipPolicy)->assignRole($otherAdmin->user, $this->employee))->toBeFalse()
+        ->and((new EntityMembershipPolicy)->delete($otherAdmin->user, $this->employee))->toBeFalse()
+        ->and((new EntityPolicy)->update($otherAdmin->user, $this->entity))->toBeFalse();
+});
diff --git a/tests/Feature/EntitySettingsTest.php b/tests/Feature/EntitySettingsTest.php
new file mode 100644
index 0000000..5a58368
