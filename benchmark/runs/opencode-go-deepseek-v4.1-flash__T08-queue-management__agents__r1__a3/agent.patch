diff --git a/tests/Feature/Queue/CreateQueueTest.php b/tests/Feature/Queue/CreateQueueTest.php
new file mode 100644
index 0000000..a47bc81
--- /dev/null
+++ b/tests/Feature/Queue/CreateQueueTest.php
@@ -0,0 +1,117 @@
+<?php
+
+use App\Actions\CreateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = User::factory()->create();
+    $this->admin = User::factory()->create();
+    $this->employee = User::factory()->create();
+    $this->stranger = User::factory()->create();
+
+    EntityMembership::factory()->for($this->entity)->for($this->owner)->owner()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->admin)->admin()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->employee)->employee()->create();
+});
+
+it('creates an active queue for an owner or admin', function () {
+    $byOwner = (new CreateQueue)($this->entity, $this->owner, 'Atendimento Geral');
+    $byAdmin = (new CreateQueue)($this->entity, $this->admin, 'Retirada');
+
+    expect($byOwner)
+        ->entity_id->toBe($this->entity->id)
+        ->name->toBe('Atendimento Geral')
+        ->slug->toBe('atendimento-geral')
+        ->is_active->toBeTrue()
+        ->and($byAdmin->slug)->toBe('retirada');
+});
+
+it('trims the name and slugifies an explicit slug', function () {
+    $queue = (new CreateQueue)($this->entity, $this->owner, '  Atendimento Geral  ', '  Fila_Rápida!  ');
+
+    expect($queue->name)->toBe('Atendimento Geral')
+        ->and($queue->slug)->toBe('fila-rapida');
+});
+
+it('rejects an empty or too long name', function () {
+    expect(fn () => (new CreateQueue)($this->entity, $this->owner, '   '))
+        ->toThrow(ValidationException::class);
+
+    expect(fn () => (new CreateQueue)($this->entity, $this->owner, str_repeat('a', 256)))
+        ->toThrow(ValidationException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+});
+
+it('rejects a duplicate slug inside the same entity', function () {
+    (new CreateQueue)($this->entity, $this->owner, 'Atendimento Geral');
+
+    expect(fn () => (new CreateQueue)($this->entity, $this->owner, 'Outro nome', 'atendimento-geral'))
+        ->toThrow(ValidationException::class);
+
+    expect(Queue::query()->count())->toBe(1);
+});
+
+it('allows the same slug in another entity', function () {
+    $otherEntity = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($otherOwner)->owner()->create();
+
+    (new CreateQueue)($this->entity, $this->owner, 'Atendimento Geral');
+    $other = (new CreateQueue)($otherEntity, $otherOwner, 'Atendimento Geral');
+
+    expect($other->slug)->toBe('atendimento-geral');
+});
+
+it('converts a database unique violation into a validation exception', function () {
+    (new CreateQueue)($this->entity, $this->owner, 'Primeira');
+
+    $creating = function (Queue $queue): void {
+        if ($queue->slug !== 'corrida') {
+            return;
+        }
+
+        DB::table('queues')->insert([
+            'entity_id' => $queue->entity_id,
+            'name' => 'Concorrente',
+            'slug' => 'corrida',
+            'is_active' => true,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    };
+
+    Queue::creating($creating);
+
+    try {
+        expect(fn () => (new CreateQueue)($this->entity, $this->owner, 'Corrida'))
+            ->toThrow(ValidationException::class);
+    } finally {
+        Queue::getEventDispatcher()->forget('eloquent.creating: '.Queue::class);
+    }
+
+    expect(Queue::query()->where('slug', 'corrida')->count())->toBe(1);
+});
+
+it('denies employees, strangers and managers of another entity', function () {
+    $otherEntity = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($otherOwner)->owner()->create();
+
+    foreach ([$this->employee, $this->stranger, $otherOwner] as $actor) {
+        expect(fn () => (new CreateQueue)($this->entity, $actor, 'Bloqueada'))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect(Queue::query()->count())->toBe(0);
+});
