+<?php
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+it('creates the queue_access table with the required columns', function () {
+    expect(Schema::hasColumns('queue_access', [
+        'id',
+        'entity_membership_id',
+        'queue_id',
+        'permissions',
+        'created_at',
+        'updated_at',
+    ]))->toBeTrue();
+});
+
+it('casts permissions to an array and exposes membership and queue relations', function () {
+    $access = QueueAccess::factory()->create();
+
+    expect($access->permissions)->toBe([QueuePermission::Call->value])
+        ->and($access->membership)->toBeInstanceOf(EntityMembership::class)
+        ->and($access->queue)->toBeInstanceOf(Queue::class);
+});
+
+it('creates a membership and queue in the same entity by default', function () {
+    $access = QueueAccess::factory()->create();
+
+    expect($access->membership->entity_id)->toBe($access->queue->entity_id)
+        ->and($access->membership->entity_id)->not->toBeNull();
+});
+
+it('keeps explicit membership and queue pairs intact', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    $access = QueueAccess::factory()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $queue->id,
+    ]);
+
+    expect($access->entity_membership_id)->toBe($membership->id)
+        ->and($access->queue_id)->toBe($queue->id)
+        ->and($access->permissions)->toBe(['call']);
+});
