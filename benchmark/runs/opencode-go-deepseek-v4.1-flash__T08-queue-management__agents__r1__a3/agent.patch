+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $attributes = [];
+
+        if ($name !== null) {
+            $name = trim($name);
+            $attributes['name'] = $name;
+
+            Validator::make(
+                ['name' => $name],
+                ['name' => ['required', 'string', 'max:255']],
+            )->validate();
+        }
+
+        if ($slug !== null) {
+            $slug = Str::slug($slug);
+            $attributes['slug'] = $slug;
+
+            Validator::make(
+                ['slug' => $slug],
+                ['slug' => ['required', 'string', 'max:255']],
+            )->validate();
+
+            $this->ensureSlugIsAvailable($queue, $slug);
+        }
+
+        if ($isActive !== null) {
+            $attributes['is_active'] = $isActive;
+        }
+
+        if ($attributes === []) {
+            return $queue;
+        }
+
+        try {
+            $queue->fill($attributes)->save();
+        } catch (QueryException $e) {
+            $this->rethrowUniqueViolation($e);
+
+            throw $e;
+        }
+
+        return $queue->refresh();
+    }
+
+    private function ensureSlugIsAvailable(Queue $queue, string $slug): void
+    {
+        $exists = Queue::query()
+            ->where('entity_id', $queue->entity_id)
+            ->where('slug', $slug)
+            ->whereKeyNot($queue->getKey())
+            ->exists();
+
+        if ($exists) {
+            throw ValidationException::withMessages([
+                'slug' => 'The slug has already been taken.',
+            ]);
+        }
+    }
+
+    private function rethrowUniqueViolation(QueryException $e): void
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        $isUnique = $sqlState === '23000'
+            || str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+
+        if (! $isUnique) {
+            return;
+        }
+
+        throw ValidationException::withMessages([
+            'slug' => 'The slug has already been taken.',
+        ]);
+    }
+}
