+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = User::factory()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->owner)->owner()->create();
+
+    $this->employeeUser = User::factory()->create();
+    $this->employee = EntityMembership::factory()
+        ->for($this->entity)
+        ->for($this->employeeUser)
+        ->employee()
+        ->create();
+
+    $this->stranger = User::factory()->create();
+    $this->queue = Queue::factory()->for($this->entity)->create(['is_active' => true]);
+});
+
+it('lets a manager call through CallNextTicket', function () {
+    $ticket = (new IssueTicket)($this->queue);
+
+    $called = (new CallNextTicket)($this->queue, $this->owner, CallMode::Any);
+
+    expect($called->id)->toBe($ticket->id);
+});
+
+it('lets a granted employee call through CallNextTicket', function () {
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $this->employee->id,
+        'queue_id' => $this->queue->id,
+    ]);
+    $ticket = (new IssueTicket)($this->queue);
+
+    $called = (new CallNextTicket)($this->queue, $this->employeeUser, CallMode::Any);
+
+    expect($called->id)->toBe($ticket->id);
+});
+
+it('rejects unauthorized callers in every call mode without changing tickets', function (string $actorKey, CallMode $mode) {
+    $ticket = (new IssueTicket)($this->queue, 0);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->{$actorKey}, $mode))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+})->with([
+    'employee without grant' => ['employeeUser', CallMode::Any],
+    'stranger' => ['stranger', CallMode::Any],
+    'priority only' => ['stranger', CallMode::PriorityOnly],
+    'normal only' => ['stranger', CallMode::NormalOnly],
+]);
+
+it('checks the inactive queue before authorization', function () {
+    $this->queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->stranger))
+        ->toThrow(InactiveQueueException::class);
+});
+
+it('lets a granted employee call a single ticket', function () {
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $this->employee->id,
+        'queue_id' => $this->queue->id,
+    ]);
+    $ticket = (new IssueTicket)($this->queue);
+
+    $ticket->call($this->employeeUser);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->fresh()->called_by_user_id)->toBe($this->employeeUser->id);
+});
+
+it('rejects an unauthorized employee on Ticket::call without changing the ticket', function () {
+    $ticket = (new IssueTicket)($this->queue);
+
+    expect(fn () => $ticket->call($this->employeeUser))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('rejects a called ticket from an inactive queue before authorization', function () {
+    $ticket = (new IssueTicket)($this->queue);
+    $ticket->call($this->owner);
+    $this->queue->update(['is_active' => false]);
+
+    expect(fn () => $ticket->fresh()->call($this->stranger))
+        ->toThrow(InactiveQueueException::class);
+});
+
+it('rejects an unauthorized caller even when the ticket was already called', function () {
+    $ticket = (new IssueTicket)($this->queue);
+    $ticket->call($this->owner);
+
+    expect(fn () => $ticket->fresh()->call($this->employeeUser))
+        ->toThrow(AuthorizationException::class);
+});
+
+it('raises the logic error for an authorized caller on an already called ticket', function () {
+    $ticket = (new IssueTicket)($this->queue);
+    $ticket->call($this->owner);
+
+    expect(fn () => $ticket->fresh()->call($this->owner))
+        ->toThrow(LogicException::class);
+});
+
+it('keeps a ticket waiting when a non-member tries to call it', function () {
+    $ticket = Ticket::factory()->forQueue($this->queue)->create();
+
+    expect(fn () => $ticket->call($this->stranger))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
diff --git a/tests/Feature/Queue/QueuePolicyTest.php b/tests/Feature/Queue/QueuePolicyTest.php
