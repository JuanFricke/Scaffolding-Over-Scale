+<?php
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = User::factory()->create();
+    $this->admin = User::factory()->create();
+    $this->employeeUser = User::factory()->create();
+    $this->stranger = User::factory()->create();
+
+    EntityMembership::factory()->for($this->entity)->for($this->owner)->owner()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->admin)->admin()->create();
+    $this->employee = EntityMembership::factory()
+        ->for($this->entity)
+        ->for($this->employeeUser)
+        ->employee()
+        ->create();
+
+    $this->queue = Queue::factory()->for($this->entity)->create();
+});
+
+it('allows only owners and admins of the entity to create queues', function () {
+    expect(Gate::forUser($this->owner)->allows('create', [Queue::class, $this->entity]))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows('create', [Queue::class, $this->entity]))->toBeTrue()
+        ->and(Gate::forUser($this->employeeUser)->allows('create', [Queue::class, $this->entity]))->toBeFalse()
+        ->and(Gate::forUser($this->stranger)->allows('create', [Queue::class, $this->entity]))->toBeFalse();
+
+    $otherEntity = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($otherOwner)->owner()->create();
+
+    expect(Gate::forUser($otherOwner)->allows('create', [Queue::class, $this->entity]))->toBeFalse();
+});
+
+it('allows only owners and admins to update a queue or manage its access', function () {
+    foreach (['update', 'manageAccess'] as $ability) {
+        expect(Gate::forUser($this->owner)->allows($ability, $this->queue))->toBeTrue()
+            ->and(Gate::forUser($this->admin)->allows($ability, $this->queue))->toBeTrue()
+            ->and(Gate::forUser($this->employeeUser)->allows($ability, $this->queue))->toBeFalse()
+            ->and(Gate::forUser($this->stranger)->allows($ability, $this->queue))->toBeFalse();
+    }
+});
+
+it('always lets owners and admins call on their queues', function () {
+    expect(Gate::forUser($this->owner)->allows('call', $this->queue))->toBeTrue()
+        ->and(Gate::forUser($this->admin)->allows('call', $this->queue))->toBeTrue();
+});
+
+it('lets an employee call only with a call grant for that queue', function () {
+    expect(Gate::forUser($this->employeeUser)->allows('call', $this->queue))->toBeFalse();
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $this->employee->id,
+        'queue_id' => $this->queue->id,
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+
+    expect(Gate::forUser($this->employeeUser)->allows('call', $this->queue))->toBeTrue();
+
+    $otherQueue = Queue::factory()->for($this->entity)->create();
+    expect(Gate::forUser($this->employeeUser)->allows('call', $otherQueue))->toBeFalse();
+});
+
+it('denies an employee whose grant lacks call or is corrupted', function (callable $corrupt) {
+    $access = QueueAccess::factory()->create([
+        'entity_membership_id' => $this->employee->id,
+        'queue_id' => $this->queue->id,
+        'permissions' => ['call'],
+    ]);
+
+    $corrupt($access);
+
+    expect(Gate::forUser($this->employeeUser)->allows('call', $this->queue))->toBeFalse();
+})->with([
+    'other permission' => [fn (QueueAccess $access) => $access->update(['permissions' => ['manage']])],
+    'string value' => [fn (QueueAccess $access) => DB::table('queue_access')
+        ->where('id', $access->id)
+        ->update(['permissions' => json_encode('call')])],
+    'object value' => [fn (QueueAccess $access) => DB::table('queue_access')
+        ->where('id', $access->id)
+        ->update(['permissions' => json_encode(['permission' => 'call'])])],
+]);
+
+it('denies a member of another entity even with a forged grant row', function () {
+    $otherEntity = Entity::factory()->create();
+    $otherUser = User::factory()->create();
+    $otherMembership = EntityMembership::factory()
+        ->for($otherEntity)
+        ->for($otherUser)
+        ->employee()
+        ->create();
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $otherMembership->id,
+        'queue_id' => $this->queue->id,
+    ]);
+
+    expect(Gate::forUser($otherUser)->allows('call', $this->queue))->toBeFalse();
+});
diff --git a/tests/Feature/Queue/SetQueueAccessTest.php b/tests/Feature/Queue/SetQueueAccessTest.php
new file mode 100644
index 0000000..6e77798
--- /dev/null
+++ b/tests/Feature/Queue/SetQueueAccessTest.php
@@ -0,0 +1,148 @@
+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Mockery\Matcher\Closure as ClosureMatcher;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = User::factory()->create();
+    $this->admin = User::factory()->create();
+    $this->employeeUser = User::factory()->create();
+    $this->stranger = User::factory()->create();
+
+    EntityMembership::factory()->for($this->entity)->for($this->owner)->owner()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->admin)->admin()->create();
+    $this->employee = EntityMembership::factory()
+        ->for($this->entity)
+        ->for($this->employeeUser)
+        ->employee()
+        ->create();
+
+    $this->queue = Queue::factory()->for($this->entity)->create();
+});
+
+function pfQueueAuditGrantExpectation(int $actorId, int $queueId, int $membershipId): void
+{
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->with(
+        'queue.access.granted',
+        new ClosureMatcher(fn (array $context): bool => $context['actor_id'] === $actorId
+            && $context['queue_id'] === $queueId
+            && $context['entity_membership_id'] === $membershipId),
+    );
+}
+
+function pfQueueAuditRevokeExpectation(int $actorId, int $queueId, int $membershipId): void
+{
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->with(
+        'queue.access.revoked',
+        new ClosureMatcher(fn (array $context): bool => $context['actor_id'] === $actorId
+            && $context['queue_id'] === $queueId
+            && $context['entity_membership_id'] === $membershipId),
+    );
+}
+
+it('grants the call permission to an employee and audits it', function () {
+    pfQueueAuditGrantExpectation($this->owner->id, $this->queue->id, $this->employee->id);
+
+    (new SetQueueAccess)($this->employee, $this->queue, $this->owner, [QueuePermission::Call->value]);
+
+    $access = QueueAccess::query()
+        ->where('entity_membership_id', $this->employee->id)
+        ->where('queue_id', $this->queue->id)
+        ->firstOrFail();
+
+    expect($access->permissions)->toBe(['call']);
+});
+
+it('upserts the permissions of an existing grant', function () {
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $this->employee->id,
+        'queue_id' => $this->queue->id,
+        'permissions' => [],
+    ]);
+
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('queue.access.granted', Mockery::type('array'));
+
+    (new SetQueueAccess)($this->employee, $this->queue, $this->admin, ['call']);
+
+    expect(QueueAccess::query()->count())->toBe(1)
+        ->and(QueueAccess::query()->first()->permissions)->toBe(['call']);
+});
+
+it('revokes an existing grant with an empty list and audits it', function () {
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $this->employee->id,
+        'queue_id' => $this->queue->id,
+    ]);
+
+    pfQueueAuditRevokeExpectation($this->owner->id, $this->queue->id, $this->employee->id);
+
+    (new SetQueueAccess)($this->employee, $this->queue, $this->owner, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('does not audit a revoke when there was no grant', function () {
+    Log::shouldReceive('channel')->never();
+
+    (new SetQueueAccess)($this->employee, $this->queue, $this->owner, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('rejects unknown or non-string permissions without storing anything', function (array $permissions) {
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $this->employee->id,
+        'queue_id' => $this->queue->id,
+        'permissions' => ['call'],
+    ]);
+
+    expect(fn () => (new SetQueueAccess)($this->employee, $this->queue, $this->owner, $permissions))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->first()->permissions)->toBe(['call']);
+})->with([
+    'unknown string' => [['manage']],
+    'integer' => [[123]],
+    'null' => [[null]],
+    'mixed valid and invalid' => [['call', 'nope']],
+]);
+
+it('rejects a membership and queue from different entities', function () {
+    $otherEntity = Entity::factory()->create();
+    $otherUser = User::factory()->create();
+    $otherMembership = EntityMembership::factory()
+        ->for($otherEntity)
+        ->for($otherUser)
+        ->employee()
+        ->create();
+
+    expect(fn () => (new SetQueueAccess)($otherMembership, $this->queue, $this->owner, ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('denies non-managers, including an employee granting themselves', function () {
+    foreach ([$this->employeeUser, $this->stranger] as $actor) {
+        expect(fn () => (new SetQueueAccess)($this->employee, $this->queue, $actor, ['call']))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
diff --git a/tests/Feature/Queue/UpdateQueueTest.php b/tests/Feature/Queue/UpdateQueueTest.php
new file mode 100644
index 0000000..d7538f8
--- /dev/null
+++ b/tests/Feature/Queue/UpdateQueueTest.php
@@ -0,0 +1,134 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = User::factory()->create();
+    $this->admin = User::factory()->create();
+    $this->employee = User::factory()->create();
+    $this->stranger = User::factory()->create();
+
+    EntityMembership::factory()->for($this->entity)->for($this->owner)->owner()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->admin)->admin()->create();
+    EntityMembership::factory()->for($this->entity)->for($this->employee)->employee()->create();
+
+    $this->queue = Queue::factory()->for($this->entity)->create([
+        'name' => 'Original',
+        'slug' => 'original',
+    ]);
+});
+
+it('updates name, slug and active flag together', function () {
+    $updated = (new UpdateQueue)(
+        $this->queue,
+        $this->admin,
+        name: '  Novo Nome  ',
+        slug: 'Novo Slug!',
+        isActive: false,
+    );
+
+    expect($updated->name)->toBe('Novo Nome')
+        ->and($updated->slug)->toBe('novo-slug')
+        ->and($updated->is_active)->toBeFalse()
+        ->and($updated->fresh()->is_active)->toBeFalse();
+});
+
+it('leaves null parameters unchanged', function () {
+    $updated = (new UpdateQueue)($this->queue, $this->owner);
+
+    expect($updated->name)->toBe('Original')
+        ->and($updated->slug)->toBe('original')
+        ->and($updated->is_active)->toBeTrue();
+});
+
+it('allows keeping the queue own slug', function () {
+    $updated = (new UpdateQueue)($this->queue, $this->owner, name: 'Renomeada', slug: 'original');
+
+    expect($updated->name)->toBe('Renomeada')
+        ->and($updated->slug)->toBe('original');
+});
+
+it('rejects the slug of another queue in the same entity', function () {
+    $other = Queue::factory()->for($this->entity)->create(['slug' => 'ocupado']);
+
+    expect(fn () => (new UpdateQueue)($this->queue, $this->owner, slug: 'ocupado'))
+        ->toThrow(ValidationException::class);
+
+    expect($this->queue->fresh()->slug)->toBe('original')
+        ->and($other->fresh()->slug)->toBe('ocupado');
+});
+
+it('allows a slug used by another entity', function () {
+    $otherEntity = Entity::factory()->create();
+    Queue::factory()->for($otherEntity)->create(['slug' => 'compartilhado']);
+
+    $updated = (new UpdateQueue)($this->queue, $this->owner, slug: 'compartilhado');
+
+    expect($updated->slug)->toBe('compartilhado');
+});
+
+it('rejects an empty name and converts a database race to validation', function () {
+    expect(fn () => (new UpdateQueue)($this->queue, $this->owner, name: '  '))
+        ->toThrow(ValidationException::class);
+
+    Queue::factory()->for($this->entity)->create(['slug' => 'corrida']);
+
+    Queue::updating(function (Queue $queue): void {
+        if ($queue->slug !== 'corrida') {
+            return;
+        }
+
+        DB::table('queues')->insert([
+            'entity_id' => $queue->entity_id,
+            'name' => 'Concorrente',
+            'slug' => 'corrida',
+            'is_active' => true,
+            'created_at' => now(),
+            'updated_at' => now(),
+        ]);
+    });
+
+    try {
+        expect(fn () => (new UpdateQueue)($this->queue, $this->owner, slug: 'corrida'))
+            ->toThrow(ValidationException::class);
+    } finally {
+        Queue::getEventDispatcher()->forget('eloquent.updating: '.Queue::class);
+    }
+});
+
+it('deactivates instead of deleting and preserves tickets', function () {
+    $ticket = (new IssueTicket)($this->queue);
+
+    (new UpdateQueue)($this->queue, $this->owner, isActive: false);
+
+    expect(Queue::query()->whereKey($this->queue->id)->exists())->toBeTrue()
+        ->and($ticket->fresh())->not->toBeNull()
+        ->and(fn () => (new IssueTicket)($this->queue->fresh()))
+        ->toThrow(InactiveQueueException::class);
+});
+
+it('denies employees, strangers and managers of another entity', function () {
+    $otherEntity = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($otherOwner)->owner()->create();
+
+    foreach ([$this->employee, $this->stranger, $otherOwner] as $actor) {
+        expect(fn () => (new UpdateQueue)($this->queue, $actor, name: 'Hackeada'))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect($this->queue->fresh()->name)->toBe('Original');
+});
