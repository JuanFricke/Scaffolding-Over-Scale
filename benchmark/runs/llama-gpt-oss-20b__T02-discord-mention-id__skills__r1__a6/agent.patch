diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..3a692d0 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -38,6 +38,18 @@ public function send(string $title, string $message, array $context = []): void
 
         $content = $this->formatContent($title, $message, $context);
 
+        // Handle optional mention of a Discord user
+        $mention = $this->buildMention();
+        if ($mention !== null) {
+            $mentionLine = "\n" . $mention;
+            if (mb_strlen($content) + mb_strlen($mentionLine) > self::MaxContentLength) {
+                // Truncate the content to leave room for the mention
+                $content = mb_substr($content, 0, self::MaxContentLength - mb_strlen($mentionLine));
+            }
+            $content .= $mentionLine;
+        }
+
+
         try {
             $response = Http::timeout(3)
                 ->asJson()
@@ -55,6 +67,24 @@ public function send(string $title, string $message, array $context = []): void
         }
     }
 
+    /**
+     * Build a Discord user mention if configured.
+     *
+     * @return string|null The mention string like "<@12345678901234567>" or null if no valid mention.
+     */
+    private function buildMention(): ?string
+    {
+        $id = config('services.discord.mention_id');
+        if (!is_string($id) || trim($id) === '') {
+            return null;
+        }
+        $trimmed = trim($id);
+        if (preg_match('/^\d{17,20}$/', $trimmed)) {
+            return "<@" . $trimmed . ">";
+        }
+        return null;
+    }
+
     /**
      * @param  array<string, mixed>  $context
      */
