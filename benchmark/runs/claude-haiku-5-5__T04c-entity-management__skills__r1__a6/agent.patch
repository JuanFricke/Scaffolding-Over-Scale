diff --git a/app/Livewire/Entity/Members.php b/app/Livewire/Entity/Members.php
new file mode 100644
index 0000000..d69b640
--- /dev/null
+++ b/app/Livewire/Entity/Members.php
@@ -0,0 +1,103 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\AddEntityMember;
+use App\Actions\RemoveEntityMember;
+use App\Actions\SetEntityMemberRole;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|email:strict|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $this->authorize('update', $this->entity);
+
+        // Adding by e-mail doubles as an account lookup, so each attempt counts against a limit.
+        $throttleKey = 'entity-add-member:'.auth()->id();
+
+        if (RateLimiter::tooManyAttempts($throttleKey, 10)) {
+            throw ValidationException::withMessages(['email' => __('auth.throttle', ['seconds' => RateLimiter::availableIn($throttleKey)])]);
+        }
+
+        RateLimiter::hit($throttleKey, 60);
+
+        $validated = $this->validate();
+
+        app(AddEntityMember::class)->handle(
+            auth()->user(),
+            $this->entity,
+            User::query()->where('email', $validated['email'])->firstOrFail(),
+        );
+
+        $this->reset('email');
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        $membership = $this->membershipOf($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        Validator::validate(['role' => $role], [
+            'role' => ['required', Rule::in(array_map(fn (UserRole $case) => $case->value, UserRole::manageable()))],
+        ]);
+
+        app(SetEntityMemberRole::class)->handle(auth()->user(), $membership, UserRole::from($role));
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = $this->membershipOf($membershipId);
+
+        $this->authorize('delete', $membership);
+
+        app(RemoveEntityMember::class)->handle(auth()->user(), $membership);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->get(),
+            'roles' => UserRole::manageable(),
+        ]);
+    }
+
+    /**
+     * Resolves a membership of this entity only. Ids from other entities are forbidden.
+     */
+    protected function membershipOf(int $membershipId): EntityMembership
+    {
+        $membership = $this->entity->memberships()->find($membershipId);
+
+        abort_if($membership === null, 403);
+
+        return $membership;
+    }
+}
