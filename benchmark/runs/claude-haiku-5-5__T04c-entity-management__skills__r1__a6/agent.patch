diff --git a/tests/Feature/EntityDashboardTest.php b/tests/Feature/EntityDashboardTest.php
new file mode 100644
index 0000000..da4a8d0
--- /dev/null
+++ b/tests/Feature/EntityDashboardTest.php
@@ -0,0 +1,92 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the dashboard shows the entity name and links to members', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Padaria Centro']);
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Padaria Centro')
+        ->assertSee(route('entity.members', $entity), false)
+        ->assertSee('Membros');
+});
+
+test('the owner sees the owner notice and the settings link', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Você é o proprietário desta entidade.')
+        ->assertSee(route('entity.settings', $entity), false);
+});
+
+test('admins and employees never see the settings link or the owner notice', function (string $role) {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->state(['role' => $role])->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertDontSee(route('entity.settings', $entity), false)
+        ->assertDontSee('Você é o proprietário desta entidade.');
+})->with(['admin', 'employee']);
+
+test('the dashboard is forbidden to users who are not members', function () {
+    $entity = Entity::factory()->create();
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.dashboard', $entity))
+        ->assertForbidden();
+});
+
+test('a session pointing at another entity does not grant access to this one', function () {
+    $user = User::factory()->create();
+    $mine = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($mine)->for($user)->create();
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.dashboard', $theirs))
+        ->assertForbidden();
+});
+
+test('guests are sent to log in', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+});
+
+test('unverified users are sent to the verification notice', function () {
+    $user = User::factory()->unverified()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the dashboard is not reachable through a soft-deleted entity slug', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->for($user)->create();
+    $entity->delete();
+
+    $this->actingAs($user)
+        ->get('/e/'.$entity->slug)
+        ->assertNotFound();
+});
diff --git a/tests/Feature/EntityMembersTest.php b/tests/Feature/EntityMembersTest.php
new file mode 100644
index 0000000..3cb0ae1
--- /dev/null
+++ b/tests/Feature/EntityMembersTest.php
@@ -0,0 +1,333 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Creates an entity with an owner and returns the entity and the owner's user.
+ *
+ * @return array{0: Entity, 1: User}
+ */
+function membersEntityWithOwner(): array
+{
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->for($owner)->create();
+
+    return [$entity, $owner];
+}
+
+/**
+ * Adds a member with the given role to the entity and returns the user.
+ */
+function membersAddMember(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->state(['role' => $role])->for($entity)->for($user)->create();
+
+    return $user;
+}
+
+test('members page lists the members of the entity', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $colleague = membersAddMember($entity, UserRole::Employee);
+
+    $this->actingAs($owner)
+        ->get(route('entity.members', $entity))
+        ->assertOk()
+        ->assertSee($owner->email)
+        ->assertSee($colleague->email);
+});
+
+test('employees may view the members page', function () {
+    [$entity] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+
+    $this->actingAs($employee)
+        ->get(route('entity.members', $entity))
+        ->assertOk();
+});
+
+test('the members page is forbidden to users who are not members', function () {
+    [$entity] = membersEntityWithOwner();
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.members', $entity))
+        ->assertForbidden();
+});
+
+test('an owner adds an existing user by e-mail as an employee', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $newcomer = User::factory()->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', 'ana@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors();
+
+    expect(EntityMembership::query()
+        ->where('entity_id', $entity->id)
+        ->where('user_id', $newcomer->id)
+        ->value('role'))->toBe(UserRole::Employee);
+});
+
+test('adding a member requires an e-mail of an existing user', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', 'ninguem@example.com')
+        ->call('addMember')
+        ->assertHasErrors(['email']);
+
+    expect(EntityMembership::count())->toBe(1);
+});
+
+test('adding someone who is already a member is an error on the e-mail field', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $colleague = membersAddMember($entity, UserRole::Employee);
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', $colleague->email)
+        ->call('addMember')
+        ->assertHasErrors(['email']);
+
+    expect(EntityMembership::count())->toBe(2);
+});
+
+test('employees cannot add members', function () {
+    [$entity] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $outsider = User::factory()->create();
+
+    Livewire::actingAs($employee)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', $outsider->email)
+        ->call('addMember')->assertForbidden();
+
+    expect(EntityMembership::where('user_id', $outsider->id)->exists())->toBeFalse();
+});
+
+test('an admin assigns the admin role to an employee', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $admin = membersAddMember($entity, UserRole::Admin);
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $employeeMembership = EntityMembership::where('user_id', $employee->id)->sole();
+
+    Livewire::actingAs($admin)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $employeeMembership->id, 'admin')
+        ->assertHasNoErrors();
+
+    expect($employeeMembership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('an owner demotes an admin back to employee', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $admin = membersAddMember($entity, UserRole::Admin);
+    $adminMembership = EntityMembership::where('user_id', $admin->id)->sole();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $adminMembership->id, 'employee')
+        ->assertHasNoErrors();
+
+    expect($adminMembership->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('assigning the owner role is a validation error on role', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $membership = EntityMembership::where('user_id', $employee->id)->sole();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $membership->id, 'owner')
+        ->assertHasErrors(['role']);
+
+    expect($membership->fresh()->role)->toBe(UserRole::Employee)
+        ->and($entity->owner()->sole()->user_id)->toBe($owner->id);
+});
+
+test('the owner membership role cannot be changed through assignRole', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $ownerMembership = $entity->owner()->sole();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $ownerMembership->id, 'admin')->assertForbidden();
+
+    expect($ownerMembership->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('employees cannot assign roles', function () {
+    [$entity] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $colleague = membersAddMember($entity, UserRole::Employee);
+    $membership = EntityMembership::where('user_id', $colleague->id)->sole();
+
+    Livewire::actingAs($employee)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $membership->id, 'admin')->assertForbidden();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('a membership from another entity cannot be re-roled from this page', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    [, $otherOwner] = membersEntityWithOwner();
+    $foreign = EntityMembership::where('user_id', $otherOwner->id)->sole();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $foreign->id, 'admin')->assertForbidden();
+
+    expect($foreign->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('the owner removes an employee', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $membership = EntityMembership::where('user_id', $employee->id)->sole();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $membership->id);
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('nobody removes the owner membership', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $admin = membersAddMember($entity, UserRole::Admin);
+    $ownerMembership = $entity->owner()->sole();
+
+    Livewire::actingAs($admin)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $ownerMembership->id)->assertForbidden();
+
+    expect(EntityMembership::find($ownerMembership->id))->not->toBeNull();
+});
+
+test('the last manager of an entity cannot be removed', function () {
+    // Owner-less entity (only possible if the owner row is gone): the sole admin
+    // must not be removable, even by itself.
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->admin()->for($entity)->for($admin)->create();
+
+    Livewire::actingAs($admin)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $membership->id)->assertForbidden();
+
+    expect(EntityMembership::find($membership->id))->not->toBeNull();
+});
+
+test('an employee may leave the entity by removing their own membership', function () {
+    [$entity] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $membership = EntityMembership::where('user_id', $employee->id)->sole();
+
+    Livewire::actingAs($employee)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $membership->id);
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('employees cannot remove other members', function () {
+    [$entity] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $colleague = membersAddMember($entity, UserRole::Employee);
+    $membership = EntityMembership::where('user_id', $colleague->id)->sole();
+
+    Livewire::actingAs($employee)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $membership->id)->assertForbidden();
+
+    expect(EntityMembership::find($membership->id))->not->toBeNull();
+});
+
+test('a manager cannot remove a membership that belongs to another entity', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    [$otherEntity] = membersEntityWithOwner();
+    $foreign = EntityMembership::factory()->employee()->for($otherEntity)->create();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $foreign->id)->assertForbidden();
+
+    expect(EntityMembership::find($foreign->id))->not->toBeNull();
+});
+
+test('the entity bound to the page cannot be swapped from the client', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    [$otherEntity] = membersEntityWithOwner();
+
+    expect(fn () => Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('entity', $otherEntity))->toThrow(CannotUpdateLockedPropertyException::class);
+});
+
+test('adding a member validates the e-mail as an address', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', 'não é um e-mail')
+        ->call('addMember')
+        ->assertHasErrors(['email']);
+});
+
+test('employees see roles as text and can only remove themselves', function () {
+    [$entity] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $colleague = membersAddMember($entity, UserRole::Employee);
+
+    $this->actingAs($employee)
+        ->get(route('entity.members', $entity))
+        ->assertOk()
+        ->assertSee($colleague->email)
+        ->assertDontSee('wire:change', false)
+        ->assertDontSee('wire:click="removeMember('.EntityMembership::where('user_id', $colleague->id)->value('id').')"', false)
+        ->assertDontSee('name="email"', false);
+});
+
+test('owners get role controls for members but never for the owner row', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $employee = membersAddMember($entity, UserRole::Employee);
+    $ownerMembership = $entity->owner()->sole();
+
+    $this->actingAs($owner)
+        ->get(route('entity.members', $entity))
+        ->assertOk()
+        ->assertSee('wire:change="assignRole('.EntityMembership::where('user_id', $employee->id)->value('id').', $event.target.value)"', false)
+        ->assertDontSee('wire:click="removeMember('.$ownerMembership->id.')"', false)
+        ->assertSee('wire:click="removeMember('.EntityMembership::where('user_id', $employee->id)->value('id').')"', false);
+});
+
+test('adding members is rate limited per user', function () {
+    [$entity, $owner] = membersEntityWithOwner();
+    $newcomer = User::factory()->create();
+    $component = Livewire::actingAs($owner)->test(Members::class, ['entity' => $entity]);
+
+    for ($attempt = 0; $attempt < 10; $attempt++) {
+        $component->set('email', "ninguem{$attempt}@example.com")->call('addMember');
+    }
+
+    $component->set('email', $newcomer->email)
+        ->call('addMember')
+        ->assertHasErrors(['email']);
+
+    expect(EntityMembership::where('user_id', $newcomer->id)->exists())->toBeFalse();
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..cee6d26
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,156 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities are routed by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'padaria-centro']);
+
+    expect((new Entity)->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('padaria-centro');
+});
+
+test('the database rejects a duplicate entity slug', function () {
+    Entity::factory()->create(['slug' => 'clinica']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'clinica']))
+        ->toThrow(QueryException::class);
+});
+
+test('the schema names the indexes the spec requires', function () {
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique')
+        ->and(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))->toContain('entity_memberships_entity_user_unique')
+        ->and(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))->toContain('entity_memberships_one_owner');
+});
+
+test('entities are soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect(Entity::count())->toBe(0)
+        ->and(Entity::withTrashed()->count())->toBe(1);
+});
+
+test('the database rejects a second membership for the same user and entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(QueryException::class);
+});
+
+test('the database defaults a membership role to employee', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(EntityMembership::query()->sole()->role)->toBe(UserRole::Employee);
+});
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(QueryException::class);
+});
+
+test('an entity can hold any number of admins and employees next to its owner', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->count(2)->for($entity)->create();
+    EntityMembership::factory()->employee()->count(3)->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(6);
+});
+
+test('owner_seq is set only on the owner row', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect(DB::table('entity_memberships')->where('id', $owner->id)->value('owner_seq'))->toBe(1)
+        ->and(DB::table('entity_memberships')->where('id', $admin->id)->value('owner_seq'))->toBeNull();
+});
+
+test('an entity exposes its owner membership', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->admin()->for($entity)->create();
+
+    expect($entity->owner()->sole()->is($owner))->toBeTrue();
+});
+
+test('users reach their entities through memberships', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->for($user)->create();
+
+    expect($user->memberships()->count())->toBe(1)
+        ->and($user->entities()->pluck('entities.id')->all())->toBe([$entity->id])
+        ->and($entity->users()->pluck('users.id')->all())->toBe([$user->id]);
+});
+
+test('a user looks up their membership for one entity', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    expect($user->membershipFor($entity->id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor(Entity::factory()->create()->id))->toBeNull();
+});
+
+test('membership role scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(EntityMembership::query()->owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::query()->admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::query()->employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('the role cast returns the UserRole enum', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('only admin and employee are manageable roles', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('deleting an entity permanently removes its memberships', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    $entity->forceDelete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('deleting a user removes their memberships', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
diff --git a/tests/Feature/EntityPickTest.php b/tests/Feature/EntityPickTest.php
new file mode 100644
index 0000000..e7b4ab5
--- /dev/null
+++ b/tests/Feature/EntityPickTest.php
@@ -0,0 +1,65 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Monolog\Handler\TestHandler;
+
+uses(RefreshDatabase::class);
+
+test('picking an entity stores it in the session and redirects to its dashboard', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['slug' => 'padaria-centro']);
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('picking an entity you do not belong to is forbidden and leaves the session alone', function () {
+    $user = User::factory()->create();
+    $mine = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($mine)->for($user)->create();
+    $theirs = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $mine->id])
+        ->post(route('entity.pick', $theirs))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->id);
+});
+
+test('picking an entity writes an audit line on the audit channel', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->for($user)->create();
+
+    // Route the audit channel to an in-memory handler and inspect what it received.
+    config(['logging.channels.audit' => ['driver' => 'monolog', 'handler' => TestHandler::class]]);
+    Log::forgetChannel('audit');
+
+    $this->actingAs($user)->post(route('entity.pick', $entity));
+
+    $handler = Log::channel('audit')->getLogger()->getHandlers()[0];
+    expect($handler->hasInfoThatContains('Entity picked'))->toBeTrue();
+});
+
+test('guests are sent to log in before picking an entity', function () {
+    $entity = Entity::factory()->create();
+
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+});
+
+test('an unverified user cannot pick an entity', function () {
+    $user = User::factory()->unverified()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->employee()->for($entity)->for($user)->create();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..1ea7333
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,174 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * A user who holds the given role in a fresh entity, plus that entity.
+ *
+ * @return array{0: User, 1: Entity}
+ */
+function policyMemberWith(UserRole $role): array
+{
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->state(['role' => $role])->for($entity)->for($user)->create();
+
+    return [$user, $entity];
+}
+
+test('any authenticated user may create an entity', function () {
+    expect(User::factory()->create()->can('create', Entity::class))->toBeTrue();
+});
+
+test('every member may view their entity, and outsiders may not', function (UserRole $role) {
+    [$user, $entity] = policyMemberWith($role);
+
+    expect($user->can('view', $entity))->toBeTrue()
+        ->and(User::factory()->create()->can('view', $entity))->toBeFalse();
+})->with([UserRole::Owner, UserRole::Admin, UserRole::Employee]);
+
+test('owner and admin may update and delete the entity', function (UserRole $role) {
+    [$user, $entity] = policyMemberWith($role);
+
+    expect($user->can('update', $entity))->toBeTrue()
+        ->and($user->can('delete', $entity))->toBeTrue();
+})->with([UserRole::Owner, UserRole::Admin]);
+
+test('employees and outsiders may not update or delete the entity', function (UserRole $role) {
+    [$user, $entity] = policyMemberWith($role);
+
+    expect($user->can('update', $entity))->toBeFalse()
+        ->and($user->can('delete', $entity))->toBeFalse()
+        ->and(User::factory()->create()->can('update', $entity))->toBeFalse()
+        ->and(User::factory()->create()->can('delete', $entity))->toBeFalse();
+})->with([UserRole::Employee]);
+
+test('only the owner may manage the entity settings', function () {
+    [$owner, $entity] = policyMemberWith(UserRole::Owner);
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->for($entity)->for($admin)->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->employee()->for($entity)->for($employee)->create();
+
+    expect($owner->can('manageSettings', $entity))->toBeTrue()
+        ->and($admin->can('manageSettings', $entity))->toBeFalse()
+        ->and($employee->can('manageSettings', $entity))->toBeFalse()
+        ->and(User::factory()->create()->can('manageSettings', $entity))->toBeFalse();
+});
+
+test('a manager of another entity has no rights on this one', function () {
+    [$user] = policyMemberWith(UserRole::Owner);
+    [, $entity] = policyMemberWith(UserRole::Owner);
+
+    expect($user->can('update', $entity))->toBeFalse()
+        ->and($user->can('manageSettings', $entity))->toBeFalse();
+});
+
+test('any member may view the memberships of their entity', function (UserRole $role) {
+    [$user, $entity] = policyMemberWith($role);
+    $membership = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($user->can('view', $membership))->toBeTrue();
+})->with([UserRole::Owner, UserRole::Admin, UserRole::Employee]);
+
+test('outsiders and members of other entities may not view a membership', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+
+    expect(User::factory()->create()->can('view', $membership))->toBeFalse();
+
+    [$other] = policyMemberWith(UserRole::Owner);
+
+    expect($other->can('view', $membership))->toBeFalse();
+});
+
+test('owner and admin may assign roles to other members', function (UserRole $role) {
+    [$user, $entity] = policyMemberWith($role);
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($user->can('assignRole', $employee))->toBeTrue();
+})->with([UserRole::Owner, UserRole::Admin]);
+
+test('employees may not assign roles', function () {
+    [$user, $entity] = policyMemberWith(UserRole::Employee);
+    $other = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($user->can('assignRole', $other))->toBeFalse();
+});
+
+test('nobody assigns roles to the owner membership, not even the owner', function () {
+    [$owner, $entity] = policyMemberWith(UserRole::Owner);
+    $ownerMembership = $entity->owner()->sole();
+
+    expect($owner->can('assignRole', $ownerMembership))->toBeFalse();
+});
+
+test('a manager of another entity may not assign roles here', function () {
+    [$user] = policyMemberWith(UserRole::Admin);
+    $membership = EntityMembership::factory()->employee()->create();
+
+    expect($user->can('assignRole', $membership))->toBeFalse();
+});
+
+test('the owner membership can never be removed', function () {
+    [$owner, $entity] = policyMemberWith(UserRole::Owner);
+    $ownerMembership = $entity->owner()->sole();
+
+    expect($owner->can('delete', $ownerMembership))->toBeFalse();
+});
+
+test('owner and admin may remove other members', function () {
+    [$owner, $entity] = policyMemberWith(UserRole::Owner);
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($owner->can('delete', $employee))->toBeTrue()
+        ->and($owner->can('delete', $admin))->toBeTrue();
+});
+
+test('an admin may remove an employee', function () {
+    [$admin, $entity] = policyMemberWith(UserRole::Admin);
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($admin->can('delete', $employee))->toBeTrue();
+});
+
+test('employees may not remove other members', function () {
+    [$employee, $entity] = policyMemberWith(UserRole::Employee);
+    $other = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($employee->can('delete', $other))->toBeFalse();
+});
+
+test('any member may remove their own membership, except the owner', function (UserRole $role) {
+    [$user, $entity] = policyMemberWith($role);
+    if ($role !== UserRole::Owner) {
+        // Leaving must not strip the entity of its owner.
+        EntityMembership::factory()->owner()->for($entity)->create();
+    }
+    $own = $user->membershipFor($entity->id);
+
+    expect($user->can('delete', $own))->toBe($role !== UserRole::Owner);
+})->with([UserRole::Owner, UserRole::Admin, UserRole::Employee]);
+
+test('the last manager of an entity may not be removed, even by itself', function () {
+    // Owner-less entity: the policy must still refuse to drop the last manager.
+    $admin = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->admin()->for($entity)->for($admin)->create();
+
+    expect($admin->can('delete', $membership))->toBeFalse();
+});
+
+test('a manager of another entity may not remove members here', function () {
+    [$admin] = policyMemberWith(UserRole::Admin);
+    $membership = EntityMembership::factory()->employee()->create();
+
+    expect($admin->can('delete', $membership))->toBeFalse();
+});
diff --git a/tests/Feature/EntitySettingsTest.php b/tests/Feature/EntitySettingsTest.php
new file mode 100644
index 0000000..dd798b9
--- /dev/null
+++ b/tests/Feature/EntitySettingsTest.php
@@ -0,0 +1,269 @@
+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Creates an entity with an owner and returns the entity and the owner's user.
+ *
+ * @return array{0: Entity, 1: User}
+ */
+function settingsEntityWithOwner(): array
+{
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Padaria Centro']);
+    EntityMembership::factory()->owner()->for($entity)->for($owner)->create();
+
+    return [$entity, $owner];
+}
+
+/**
+ * Adds a member with the given role to the entity and returns the user.
+ */
+function settingsAddMember(Entity $entity, UserRole $role): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->state(['role' => $role])->for($entity)->for($user)->create();
+
+    return $user;
+}
+
+test('the owner sees the settings page with the transfer section', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+
+    $this->actingAs($owner)
+        ->get(route('entity.settings', $entity))
+        ->assertOk()
+        ->assertSee('Padaria Centro')
+        ->assertSee('Transferir propriedade');
+});
+
+test('admins, employees and outsiders get 403 on the settings page', function (string $who) {
+    [$entity] = settingsEntityWithOwner();
+    $user = match ($who) {
+        'admin' => settingsAddMember($entity, UserRole::Admin),
+        'employee' => settingsAddMember($entity, UserRole::Employee),
+        'outsider' => User::factory()->create(),
+    };
+
+    $this->actingAs($user)
+        ->get(route('entity.settings', $entity))
+        ->assertForbidden();
+})->with(['admin', 'employee', 'outsider']);
+
+test('the owner saves the name and the slug', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('name', 'Padaria Norte')
+        ->set('slug', 'padaria-norte')
+        ->call('save')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.settings', ['entity' => 'padaria-norte']));
+
+    expect($entity->fresh())
+        ->name->toBe('Padaria Norte')
+        ->slug->toBe('padaria-norte');
+});
+
+test('the owner may keep the slug the entity already has', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('name', 'Padaria Sul')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    expect($entity->fresh()->name)->toBe('Padaria Sul');
+});
+
+test('saving a slug another entity already uses is an error on the slug', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    Entity::factory()->create(['slug' => 'taken']);
+    $slug = $entity->slug;
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('slug', 'taken')
+        ->call('save')
+        ->assertHasErrors(['slug']);
+
+    expect($entity->fresh()->slug)->toBe($slug);
+});
+
+test('the slug must be lowercase letters, digits and dashes', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('slug', 'Não Vale!')
+        ->call('save')
+        ->assertHasErrors(['slug']);
+});
+
+test('the name is required', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('name', '')
+        ->call('save')
+        ->assertHasErrors(['name']);
+});
+
+test('an admin cannot save even if the owner page is already open', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    $admin = settingsAddMember($entity, UserRole::Admin);
+    $component = Livewire::actingAs($owner)->test(Settings::class, ['entity' => $entity]);
+
+    $this->actingAs($admin);
+
+    $component->set('name', 'Invadido')->call('save')->assertForbidden();
+
+    expect($entity->fresh()->name)->toBe('Padaria Centro');
+});
+
+test('the bound entity cannot be swapped from the client', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    [$otherEntity] = settingsEntityWithOwner();
+
+    expect(fn () => Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('entity', $otherEntity))->toThrow(CannotUpdateLockedPropertyException::class);
+});
+
+test('the owner deletes the entity, its memberships, and the current session entity', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    settingsAddMember($entity, UserRole::Employee);
+    session()->put('current_entity_id', $entity->id);
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->call('delete')
+        ->assertRedirect(route('home'));
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull()
+        ->and(EntityMembership::where('entity_id', $entity->id)->count())->toBe(0)
+        ->and(session()->has('current_entity_id'))->toBeFalse();
+});
+
+test('deleting an entity keeps a session that points at another entity', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    [$other] = settingsEntityWithOwner();
+    session()->put('current_entity_id', $other->id);
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->call('delete');
+
+    expect(session('current_entity_id'))->toBe($other->id);
+});
+
+test('an admin cannot delete the entity', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    $admin = settingsAddMember($entity, UserRole::Admin);
+    $component = Livewire::actingAs($owner)->test(Settings::class, ['entity' => $entity]);
+
+    $this->actingAs($admin);
+
+    $component->call('delete')->assertForbidden();
+
+    expect(Entity::find($entity->id))->not->toBeNull();
+});
+
+test('the owner transfers ownership to an admin, atomically', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    $admin = settingsAddMember($entity, UserRole::Admin);
+    $target = EntityMembership::where('user_id', $admin->id)->sole();
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $target->id)
+        ->call('transfer')
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    expect($target->fresh()->role)->toBe(UserRole::Owner)
+        ->and($entity->owner()->sole()->user_id)->toBe($admin->id)
+        ->and(EntityMembership::where('entity_id', $entity->id)->where('user_id', $owner->id)->sole()->role)
+        ->toBe(UserRole::Admin);
+});
+
+test('ownership may only move to an admin of the entity', function (string $target) {
+    [$entity, $owner] = settingsEntityWithOwner();
+    $membership = match ($target) {
+        'employee' => EntityMembership::where('user_id', settingsAddMember($entity, UserRole::Employee)->id)->sole(),
+        'self' => $entity->owner()->sole(),
+        'foreign admin' => EntityMembership::where('user_id', settingsAddMember(
+            Entity::factory()->create(), UserRole::Admin
+        )->id)->sole(),
+    };
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $membership->id)
+        ->call('transfer')->assertForbidden();
+
+    expect($entity->owner()->sole()->user_id)->toBe($owner->id);
+})->with(['employee', 'self', 'foreign admin']);
+
+test('a transfer needs a target membership', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->call('transfer')
+        ->assertHasErrors(['targetMembershipId']);
+});
+
+test('a transfer is forbidden once the caller is no longer the owner', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    $admin = settingsAddMember($entity, UserRole::Admin);
+    $target = EntityMembership::where('user_id', $admin->id)->sole();
+    $component = Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $target->id);
+
+    // The owner row vanishes between mount and the transfer.
+    EntityMembership::where('user_id', $owner->id)->delete();
+
+    $component->call('transfer')->assertForbidden();
+
+    expect($target->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('an admin cannot transfer ownership', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    $admin = settingsAddMember($entity, UserRole::Admin);
+    $other = settingsAddMember($entity, UserRole::Admin);
+    $target = EntityMembership::where('user_id', $other->id)->sole();
+    $component = Livewire::actingAs($owner)->test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $target->id);
+
+    $this->actingAs($admin);
+
+    $component->call('transfer')->assertForbidden();
+    expect($entity->owner()->sole()->user_id)->toBe($owner->id);
+});
+
+test('the settings page offers the entity admins as transfer targets', function () {
+    [$entity, $owner] = settingsEntityWithOwner();
+    $admin = settingsAddMember($entity, UserRole::Admin);
+    settingsAddMember($entity, UserRole::Employee);
+
+    $this->actingAs($owner)
+        ->get(route('entity.settings', $entity))
+        ->assertOk()
+        ->assertSee($admin->email)
+        ->assertDontSee('Não há administradores para receber a propriedade.');
+});
