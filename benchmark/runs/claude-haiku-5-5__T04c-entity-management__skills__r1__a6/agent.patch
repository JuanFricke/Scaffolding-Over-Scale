+<?php
+
+test('every ui key exists in both pt_BR and en', function () {
+    $en = array_keys(require lang_path('en/ui.php'));
+    $ptBr = array_keys(require lang_path('pt_BR/ui.php'));
+
+    expect(array_diff($en, $ptBr))->toBeEmpty()
+        ->and(array_diff($ptBr, $en))->toBeEmpty();
+});
+
+test('the entity navigation labels are translated', function () {
+    app()->setLocale('en');
+
+    expect(__('ui.nav_members'))->toBe('Members')
+        ->and(__('ui.nav_settings'))->toBe('Settings');
+
+    app()->setLocale('pt_BR');
+
+    expect(__('ui.nav_members'))->toBe('Membros')
+        ->and(__('ui.nav_settings'))->toBe('Configurações');
+});
