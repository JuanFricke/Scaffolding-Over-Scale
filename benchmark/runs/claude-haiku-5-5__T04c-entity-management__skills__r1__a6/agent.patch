+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class AddEntityMember
+{
+    /**
+     * Adds an existing user to the entity as an employee.
+     *
+     * @throws AuthorizationException when the actor cannot manage the entity's members
+     * @throws ValidationException when the user is already a member
+     */
+    public function handle(User $actor, Entity $entity, User $user): EntityMembership
+    {
+        Gate::forUser($actor)->authorize('update', $entity);
+
+        if ($entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw ValidationException::withMessages(['email' => __('ui.member_already_exists')]);
+        }
+
+        $membership = $entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        Log::channel('audit')->info('Entity member added', [
+            'entity_id' => $entity->id,
+            'membership_id' => $membership->id,
+            'actor_id' => $actor->id,
+        ]);
+
+        return $membership;
+    }
+}
