new file mode 100644
index 0000000..7287d31
--- /dev/null
+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the membership's entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id) !== null;
+    }
+
+    /**
+     * Owner and admin may assign roles. The owner's own role never changes here;
+     * ownership moves only through a transfer.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $membership->role !== UserRole::Owner && $this->isManager($user, $membership);
+    }
+
+    /**
+     * The owner membership can never be removed. The last manager cannot be removed
+     * either. Otherwise a member may remove themselves, and owner or admin may remove others.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->role->isManager() && $this->managerCount($membership->entity_id) <= 1) {
+            return false;
+        }
+
+        return $membership->user_id === $user->id || $this->isManager($user, $membership);
+    }
+
+    /**
+     * Whether the user is owner or admin of the membership's entity.
+     */
+    private function isManager(User $user, EntityMembership $membership): bool
+    {
+        return $user->membershipFor($membership->entity_id)?->role->isManager() ?? false;
+    }
+
+    /**
+     * How many owner and admin memberships the entity has.
+     */
+    private function managerCount(int $entityId): int
+    {
+        return EntityMembership::query()
+            ->where('entity_id', $entityId)
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->count();
+    }
+}
