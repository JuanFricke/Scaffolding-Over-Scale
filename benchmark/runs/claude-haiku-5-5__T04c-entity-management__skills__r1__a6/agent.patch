+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetEntityMemberRole
+{
+    /**
+     * Changes a member's role to admin or employee.
+     *
+     * @throws AuthorizationException when the actor cannot assign roles here
+     * @throws ValidationException when the role is not assignable (e.g. owner)
+     */
+    public function handle(User $actor, EntityMembership $membership, UserRole $role): EntityMembership
+    {
+        Gate::forUser($actor)->authorize('assignRole', $membership);
+
+        if (! in_array($role, UserRole::manageable(), true)) {
+            throw ValidationException::withMessages(['role' => __('ui.role_not_assignable')]);
+        }
+
+        $from = $membership->role;
+        $membership->update(['role' => $role]);
+
+        Log::channel('audit')->info('Entity member role changed', [
+            'entity_id' => $membership->entity_id,
+            'membership_id' => $membership->id,
+            'actor_id' => $actor->id,
+            'from' => $from->value,
+            'to' => $role->value,
+        ]);
+
+        return $membership;
+    }
+}
diff --git a/app/Actions/TransferEntityOwnership.php b/app/Actions/TransferEntityOwnership.php
new file mode 100644
index 0000000..1f47b5f
--- /dev/null
+++ b/app/Actions/TransferEntityOwnership.php
@@ -0,0 +1,51 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class TransferEntityOwnership
+{
+    /**
+     * Makes another admin of the entity its owner. The current owner becomes an admin.
+     *
+     * @throws AuthorizationException when the actor is not the owner, the target is not
+     *                                another admin of this entity, or the owner row is gone
+     */
+    public function handle(User $actor, Entity $entity, int $targetMembershipId): void
+    {
+        Gate::forUser($actor)->authorize('manageSettings', $entity);
+
+        DB::transaction(function () use ($actor, $entity, $targetMembershipId) {
+            $owner = $entity->owner()->lockForUpdate()->first();
+            $target = $entity->memberships()->whereKey($targetMembershipId)->lockForUpdate()->first();
+
+            if (
+                $owner === null
+                || $owner->user_id !== $actor->id
+                || $target === null
+                || $target->role !== UserRole::Admin
+                || $target->user_id === $actor->id
+            ) {
+                throw new AuthorizationException;
+            }
+
+            // Demote first so the (entity_id, owner_seq) unique index never sees two owners.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+
+            Log::channel('audit')->info('Entity ownership transferred', [
+                'entity_id' => $entity->id,
+                'from_membership_id' => $owner->id,
+                'to_membership_id' => $target->id,
+                'actor_id' => $actor->id,
+            ]);
+        });
+    }
+}
