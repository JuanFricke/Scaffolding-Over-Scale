@@ -0,0 +1,28 @@
+<?php
+
+namespace App\Models;
+
+enum UserRole: string
+{
+    case Owner = 'owner';
+    case Admin = 'admin';
+    case Employee = 'employee';
+
+    /**
+     * Roles an owner or admin may assign. Ownership only moves through a transfer.
+     *
+     * @return list<self>
+     */
+    public static function manageable(): array
+    {
+        return [self::Admin, self::Employee];
+    }
+
+    /**
+     * Whether this role can manage the entity's members (owner and admin).
+     */
+    public function isManager(): bool
+    {
+        return $this === self::Owner || $this === self::Admin;
+    }
+}
