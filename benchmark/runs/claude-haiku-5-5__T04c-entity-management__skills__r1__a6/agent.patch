+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+
+class UpdateEntity
+{
+    /**
+     * Renames the entity and changes its slug. Settings are owner-only.
+     *
+     * @throws AuthorizationException when the actor is not the owner
+     */
+    public function handle(User $actor, Entity $entity, string $name, string $slug): Entity
+    {
+        Gate::forUser($actor)->authorize('manageSettings', $entity);
+
+        $entity->update(['name' => $name, 'slug' => $slug]);
+
+        return $entity;
+    }
+}
