diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..6e6812b
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,97 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+const DISCORD_TEST_URL = 'https://discord.com/api/webhooks/123/SECRET-TOKEN';
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => DISCORD_TEST_URL]);
+});
+
+it('does nothing when the webhook is not configured', function (?string $url) {
+    Http::fake();
+    config(['services.discord.webhook_url' => $url]);
+
+    (new DiscordOpsAlert)->send('Title', 'Message');
+
+    Http::assertNothingSent();
+})->with([null, '']);
+
+it('posts the title, message and context to the webhook', function () {
+    Http::fake();
+
+    app(DiscordOpsAlert::class)->send('Job failed', 'Retries exhausted', ['entity_id' => 42, 'queue' => 'asaas-webhooks']);
+
+    Http::assertSent(function (Request $request) {
+        return $request->method() === 'POST'
+            && $request->url() === DISCORD_TEST_URL
+            && $request->data()['content'] === "Job failed\nRetries exhausted\nentity_id=42\nqueue=asaas-webhooks";
+    });
+});
+
+it('truncates the text to 1800 characters, multibyte-safe', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', str_repeat('é', 5000));
+
+    Http::assertSent(fn (Request $request) => mb_strlen($request->data()['content']) === 1800);
+});
+
+it('redacts sensitive keys, bearer credentials and nested values', function () {
+    Http::fake();
+
+    (new DiscordOpsAlert)->send('T', 'M', [
+        'Password' => 'hunter2',
+        'asaas_access_token' => 'abc',
+        'X-Api-Key' => 'k',
+        'apikey' => 'k',
+        'webhook_url' => 'https://x',
+        'note' => 'sent Bearer abc.def.ghi to gateway',
+        'nested' => ['secret' => 's3', 'ok' => 'visible', 'hdr' => 'bearer zzz'],
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request->data()['content'];
+
+        foreach (['hunter2', 'abc', 's3', 'zzz', 'https://x', '=k'] as $leak) {
+            if (str_contains($content, $leak)) {
+                return false;
+            }
+        }
+
+        return str_contains($content, "Password=[redacted]\n")
+            && str_contains($content, "note=[redacted]\n")
+            && str_contains($content, 'nested={"secret":"[redacted]","ok":"visible","hdr":"[redacted]"}')
+            && str_contains($content, 'queue=asaas-webhooks');
+    });
+});
+
+it('logs an error without the webhook url when discord answers non-2xx', function () {
+    Http::fake(['*' => Http::response('nope', 500)]);
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function ($message, $context = []) {
+        return str_contains($message, 'Discord ops alert failed')
+            && ! str_contains($message.json_encode($context), 'SECRET-TOKEN')
+            && ($context['status'] ?? null) === 500;
+    });
+});
+
+it('soft-fails and scrubs the webhook url when the transport throws', function () {
+    Http::fake(fn () => throw new ConnectionException('cURL error 28 for '.DISCORD_TEST_URL));
+    Log::spy();
+
+    (new DiscordOpsAlert)->send('T', 'M');
+
+    Log::shouldHaveReceived('error')->once()->withArgs(function ($message, $context = []) {
+        return str_contains($message, 'Discord ops alert failed')
+            && ! str_contains($message.json_encode($context), 'SECRET-TOKEN');
+    });
+});
diff --git a/tests/Feature/Ops/LoggingConfigTest.php b/tests/Feature/Ops/LoggingConfigTest.php
