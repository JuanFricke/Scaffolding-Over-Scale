+name: Tests
+
+on:
+  push:
+    branches: [main, master]
+  pull_request:
+  workflow_call:
+
+jobs:
+  pest:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Start local stack
+        run: ./bin/pf up
+
+      - name: Run Pest
+        run: ./bin/pf shell php artisan test
+
+      - name: Stop local stack
+        if: always()
+        run: ./bin/pf down
