+name: Deploy Dev
+
+on:
+  push:
+    branches: [main, master]
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: Git ref to deploy
+        required: false
+      skip_tests:
+        description: Skip the Pest gate
+        type: boolean
+        default: false
+  workflow_call:
+    inputs:
+      ref:
+        description: Git ref to deploy
+        required: false
+        type: string
+    secrets:
+      HOSTINGER_API:
+        required: true
+
+jobs:
+  tests:
+    if: ${{ !inputs.skip_tests }}
+    uses: ./.github/workflows/tests.yml
+
+  deploy:
+    needs: [tests]
+    if: ${{ always() && (needs.tests.result == 'success' || inputs.skip_tests) }}
+    runs-on: ubuntu-latest
+    env:
+      HOSTINGER_API: ${{ secrets.HOSTINGER_API }}
+      PF_GIT_TOKEN: ${{ secrets.PF_GIT_TOKEN }}
+      PF_GIT_REF: ${{ inputs.ref || github.ref_name }}
+      APP_KEY: ${{ secrets.APP_KEY }}
+      DB_PASSWORD: ${{ secrets.DB_PASSWORD }}
+    steps:
+      - name: Checkout
+        uses: actions/checkout@v4
+
+      - name: Deploy to the dev VPS
+        run: ./bin/pf deploy
+
+      - name: Smoke test
+        run: ./bin/pf smoke
