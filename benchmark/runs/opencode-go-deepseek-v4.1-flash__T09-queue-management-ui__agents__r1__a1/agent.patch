+<?php
+
+use App\Enums\QueuePermission;
+use App\Livewire\Entity\Queues;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
+
+uses(RefreshDatabase::class);
+
+function pfQueueUiOwner(Entity $entity): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+test('managers can open the queues page while employees are forbidden', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    Queue::factory()->for($entity)->create(['name' => 'Recepção']);
+
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+    $this->get(route('entity.queues', $entity->slug))
+        ->assertOk()
+        ->assertSeeText('Recepção');
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+    $this->get(route('entity.queues', $entity->slug))->assertForbidden();
+
+    Livewire::actingAs($employee)
+        ->test(Queues::class, ['entity' => $entity])
+        ->assertForbidden();
+});
+
+test('the queue list exposes no row actions until a modal is open', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+
+    $html = Livewire::test(Queues::class, ['entity' => $entity])
+        ->assertSeeText('Geral')
+        ->assertSee('wire:click="openQueue('.$queue->id.')"', false)
+        ->html();
+
+    expect($html)->not->toContain('startRename')
+        ->and($html)->not->toContain('toggleActive')
+        ->and($html)->not->toContain('openAccess');
+});
+
+test('creating a queue derives its slug and surfaces duplicate slug errors on the name', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old']);
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openCreate')
+        ->assertSet('creating', true)
+        ->set('name', 'Atendimento Geral')
+        ->call('create')
+        ->assertHasNoErrors()
+        ->assertSet('name', '')
+        ->assertSet('creating', false);
+
+    expect(Queue::where('entity_id', $entity->id)->where('name', 'Atendimento Geral')->first()?->slug)
+        ->toBe('atendimento-geral');
+
+    $component->call('openCreate')
+        ->set('name', 'Old')
+        ->call('create')
+        ->assertHasErrors('name');
+
+    expect(Queue::where('entity_id', $entity->id)->count())->toBe(2);
+});
+
+test('the detail modal title and actions render and close resets every nested state', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->assertSet('viewingQueueId', $queue->id)
+        ->assertSee(__('ui.queues_details'))
+        ->assertSee(__('ui.queues_rename'))
+        ->assertSee(__('ui.queues_deactivate'))
+        ->assertSee(__('ui.queues_access_button'))
+        ->call('startRename', $queue->id)
+        ->assertSet('editingQueueId', $queue->id)
+        ->assertSet('renameName', 'Geral')
+        ->call('confirmToggle')
+        ->assertSet('confirmingToggle', true)
+        ->call('closeQueue')
+        ->assertSet('viewingQueueId', null)
+        ->assertSet('editingQueueId', null)
+        ->assertSet('renameName', '')
+        ->assertSet('confirmingToggle', false)
+        ->assertSet('accessQueueId', null)
+        ->assertSet('managingAccess', false);
+});
+
+test('renaming updates the name and re-derives the slug and reports collisions on renameName', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old']);
+    Queue::factory()->for($entity)->create(['name' => 'Taken', 'slug' => 'taken']);
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('startRename', $queue->id)
+        ->set('renameName', 'New')
+        ->call('rename')
+        ->assertHasNoErrors()
+        ->assertSet('editingQueueId', null)
+        ->assertSet('renameName', '');
+
+    expect($queue->fresh()->name)->toBe('New')
+        ->and($queue->fresh()->slug)->toBe('new');
+
+    $component->call('startRename', $queue->id)
+        ->set('renameName', 'Taken')
+        ->call('rename')
+        ->assertHasErrors('renameName');
+
+    expect($queue->fresh()->name)->toBe('New')
+        ->and($queue->fresh()->slug)->toBe('new');
+});
+
+test('deactivation requires the in-page confirmation modal and flips the queue', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'is_active' => true]);
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('confirmToggle')
+        ->assertSet('confirmingToggle', true)
+        ->assertSee(__('ui.queues_toggle_title'))
+        ->assertSee(__('ui.queues_toggle_message', ['queue' => 'Geral']));
+
+    $html = $component->html();
+    expect($html)->not->toContain('wire:confirm');
+
+    $component->call('cancelToggle')->assertSet('confirmingToggle', false);
+    expect($queue->fresh()->is_active)->toBeTrue();
+
+    $component->call('confirmToggle')
+        ->call('toggleActive', $queue->id)
+        ->assertSet('confirmingToggle', false);
+
+    expect($queue->fresh()->is_active)->toBeFalse();
+
+    $component->call('confirmToggle')
+        ->call('toggleActive', $queue->id);
+
+    expect($queue->fresh()->is_active)->toBeTrue();
+});
+
+test('queue access can be granted and revoked with an audit write', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openAccess', $queue->id)
+        ->assertSet('accessQueueId', $queue->id)
+        ->assertSet('managingAccess', true)
+        ->assertSeeText($employee->email)
+        ->call('grantAccess', $membership->id)
+        ->assertHasNoErrors();
+
+    $access = QueueAccess::query()
+        ->where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->first();
+
+    expect($access)->not->toBeNull()
+        ->and($access->permissions)->toBe([QueuePermission::Call->value]);
+
+    $component->call('revokeAccess', $membership->id);
+
+    expect(QueueAccess::query()
+        ->where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->exists())->toBeFalse();
+
+    $component->call('closeAccess')
+        ->assertSet('accessQueueId', null)
+        ->assertSet('managingAccess', false);
+});
+
+test('the navbar exposes queues to managers and serve to every member', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertOk()
+        ->assertSee(route('entity.queues', $entity->slug), false)
+        ->assertSee(route('entity.serve', $entity->slug), false)
+        ->assertSeeText(__('ui.nav_queues'))
+        ->assertSeeText(__('ui.nav_serve'));
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertOk()
+        ->assertDontSee(route('entity.queues', $entity->slug), false)
+        ->assertSee(route('entity.serve', $entity->slug), false)
+        ->assertDontSeeText(__('ui.nav_queues'))
+        ->assertSeeText(__('ui.nav_serve'));
+});
+
+test('foreign queue and membership ids never change anything', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfQueueUiOwner($entity);
+    $foreignEntity = Entity::factory()->create();
+    $foreignQueue = Queue::factory()->for($foreignEntity)->create();
+    $foreignMembership = EntityMembership::factory()->for($foreignEntity)->create();
+    $ownQueue = Queue::factory()->for($entity)->create();
+    $ownMembership = EntityMembership::factory()->for($entity)->create();
+
+    $this->actingAs($manager)->post(route('entity.pick', $entity->slug));
+
+    foreach (['openQueue', 'startRename', 'toggleActive', 'openAccess'] as $method) {
+        try {
+            Livewire::test(Queues::class, ['entity' => $entity])->call($method, $foreignQueue->id);
+            $this->fail("{$method} should not resolve a foreign queue.");
+        } catch (NotFoundHttpException|ModelNotFoundException) {
+            expect(true)->toBeTrue();
+        }
+    }
+
+    $foreignQueue->refresh();
+    expect($foreignQueue->name)->not->toBe('hacked')
+        ->and($foreignQueue->is_active)->toBeTrue();
+
+    try {
+        Livewire::test(Queues::class, ['entity' => $entity])
+            ->call('openAccess', $ownQueue->id)
+            ->call('grantAccess', $foreignMembership->id);
+        $this->fail('Granting access to a foreign membership should fail.');
+    } catch (NotFoundHttpException|ModelNotFoundException) {
+        expect(true)->toBeTrue();
+    }
+
+    expect(QueueAccess::query()->count())->toBe(0);
+
+    // A tampered accessQueueId discloses neither the foreign queue nor grants.
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('accessQueueId', $foreignQueue->id)
+        ->set('managingAccess', true)
+        ->assertViewHas('accessQueue', null)
+        ->assertViewHas('accessGrants', fn ($grants) => $grants->isEmpty());
+
+    expect($component->html())->not->toContain($foreignQueue->name);
+
+    // Own membership + tampered foreign queue id must still fail.
+    try {
+        $component->call('grantAccess', $ownMembership->id);
+        $this->fail('Granting access on a foreign queue should fail.');
+    } catch (NotFoundHttpException|ModelNotFoundException) {
+        expect(true)->toBeTrue();
+    }
+});
