+<?php
+
+use App\Enums\QueuePermission;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
+
+uses(RefreshDatabase::class);
+
+function pfServeUiOwner(Entity $entity): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+test('any member can open the serve panel and the first callable queue is selected', function () {
+    $entity = Entity::factory()->create();
+    $owner = pfServeUiOwner($entity);
+    Queue::factory()->for($entity)->create(['name' => 'Inactive', 'is_active' => false]);
+    $active = Queue::factory()->for($entity)->create(['name' => 'Active', 'is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.serve', $entity->slug))
+        ->assertOk()
+        ->assertSeeText(__('ui.serve_call_next'))
+        ->assertSeeText('Active')
+        ->assertDontSeeText('Inactive');
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $active->id)
+        ->assertSet('mode', 'any')
+        ->assertSet('lastCalledTicketId', null);
+});
+
+test('employees only see queues they may call', function () {
+    $entity = Entity::factory()->create();
+    $manager = pfServeUiOwner($entity);
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $granted = Queue::factory()->for($entity)->create(['name' => 'Granted', 'is_active' => true]);
+    Queue::factory()->for($entity)->create(['name' => 'Ungranted', 'is_active' => true]);
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $granted->id,
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $granted->id)
+        ->assertSeeText('Granted')
+        ->assertDontSeeText('Ungranted');
+});
+
+test('the waiting list is ordered, mode-filtered and translated', function () {
+    $entity = Entity::factory()->create();
+    $owner = pfServeUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $normal = Ticket::factory()->forQueue($queue)->create([
+        'code' => 'A001',
+        'priority' => 0,
+        'issued_at' => now()->subMinutes(10),
+        'channel' => TicketChannel::Virtual,
+    ]);
+    $priority = Ticket::factory()->forQueue($queue)->create([
+        'code' => 'A002',
+        'priority' => 10,
+        'issued_at' => now(),
+        'channel' => TicketChannel::Printed,
+    ]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSeeText('A001')
+        ->assertSeeText(__('ui.channel_virtual'))
+        ->assertSeeText(__('ui.channel_printed'));
+
+    $tickets = $component->viewData('tickets');
+    expect($tickets->pluck('id')->all())->toBe([$priority->id, $normal->id]);
+
+    $component->set('mode', 'priority_only')->assertDontSeeText('A001');
+    expect($component->viewData('tickets')->pluck('id')->all())->toBe([$priority->id]);
+
+    $component->set('mode', 'normal_only')->assertDontSeeText('A002');
+    expect($component->viewData('tickets')->pluck('id')->all())->toBe([$normal->id]);
+});
+
+test('the waiting list is capped at thirty tickets', function () {
+    $entity = Entity::factory()->create();
+    $owner = pfServeUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    foreach (range(1, 31) as $index) {
+        Ticket::factory()->forQueue($queue)->create([
+            'code' => 'A'.str_pad((string) $index, 3, '0', STR_PAD_LEFT),
+            'priority' => 0,
+            'issued_at' => now()->addSeconds($index),
+        ]);
+    }
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    expect(Livewire::test(Serve::class, ['entity' => $entity])
+        ->viewData('tickets')->count())->toBe(30);
+});
+
+test('calling the next ticket stores the last called ticket and shows its code', function () {
+    $entity = Entity::factory()->create();
+    $owner = pfServeUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ticket = Ticket::factory()->forQueue($queue)->create(['code' => 'A001', 'priority' => 0]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertSet('lastCalledTicketId', $ticket->id)
+        ->assertSet('notice', __('ui.serve_last_called', ['code' => 'A001']))
+        ->assertSeeText(__('ui.serve_last_called', ['code' => 'A001']));
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->fresh()->called_by_user_id)->toBe($owner->id);
+});
+
+test('no selection and an empty queue both show the empty notice without errors', function () {
+    $entity = Entity::factory()->create();
+    $owner = pfServeUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', null)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_empty'))
+        ->assertHasNoErrors();
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_empty'))
+        ->assertHasNoErrors();
+});
+
+test('inactive queues report the inactive notice and keep the ticket waiting', function () {
+    $entity = Entity::factory()->create();
+    $owner = pfServeUiOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => false]);
+    $ticket = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_inactive'));
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('an employee without a call grant gets a forbidden response and no ticket changes', function () {
+    $entity = Entity::factory()->create();
+    pfServeUiOwner($entity);
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
