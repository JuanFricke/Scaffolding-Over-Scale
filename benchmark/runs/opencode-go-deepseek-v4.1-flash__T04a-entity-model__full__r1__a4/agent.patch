+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities table has the documented columns', function () {
+    expect(Schema::hasColumns('entities', [
+        'id',
+        'name',
+        'slug',
+        'created_at',
+        'updated_at',
+        'deleted_at',
+    ]))->toBeTrue();
+});
+
+test('entity memberships table has the documented columns', function () {
+    expect(Schema::hasColumns('entity_memberships', [
+        'id',
+        'entity_id',
+        'user_id',
+        'role',
+        'owner_seq',
+        'created_at',
+        'updated_at',
+    ]))->toBeTrue();
+});
+
+test('the documented unique indexes exist', function () {
+    $indexes = fn (string $table) => collect(
+        DB::select("PRAGMA index_list('{$table}')")
+    )->pluck('name');
+
+    expect($indexes('entities'))->toContain('entities_slug_unique')
+        ->and($indexes('entity_memberships'))
+        ->toContain('entity_memberships_entity_user_unique')
+        ->toContain('entity_memberships_one_owner');
+});
+
+test('entity factory creates entities with a non-empty name and unique slug', function () {
+    $entities = Entity::factory()->count(5)->create();
+
+    expect($entities->pluck('slug')->unique())->toHaveCount(5);
+
+    $entities->each(function (Entity $entity) {
+        expect($entity->name)->toBeString()->not->toBeEmpty()
+            ->and($entity->slug)->toBeString()->not->toBeEmpty();
+    });
+});
+
+test('the database rejects duplicate entity slugs', function () {
+    Entity::factory()->create(['slug' => 'same-slug']);
+    Entity::factory()->create(['slug' => 'same-slug']);
+})->throws(QueryException::class);
+
+test('entities are soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect(Entity::count())->toBe(0)
+        ->and(Entity::withTrashed()->count())->toBe(1)
+        ->and(Entity::withTrashed()->first()->deleted_at)->not->toBeNull();
+});
+
+test('entities are bound in routes by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme');
+});
+
+test('membership factory creates its entity and user as an employee', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->role)->toBe(UserRole::Employee)
+        ->and($membership->entity_id)->toBe($membership->entity->id)
+        ->and($membership->user_id)->toBe($membership->user->id);
+});
+
+test('membership factory states set the role', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('the database defaults a membership role to employee', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(EntityMembership::where('user_id', $user->id)->first()->role)
+        ->toBe(UserRole::Employee);
+});
+
+test('membership scopes filter by role', function () {
+    EntityMembership::factory()->admin()->create();
+    EntityMembership::factory()->employee()->create();
+    EntityMembership::factory()->employee()->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(2);
+});
+
+test('a user can hold only one membership per entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]);
+})->throws(QueryException::class);
+
+test('the database rejects a second owner in the same entity', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+})->throws(QueryException::class);
+
+test('the database rejects promoting a second owner', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+
+    $admin->update(['role' => UserRole::Owner]);
+})->throws(QueryException::class);
+
+test('different entities may each have their own owner', function () {
+    $first = EntityMembership::factory()->owner()->create();
+    $second = EntityMembership::factory()->owner()->create();
+
+    expect($first->entity_id)->not->toBe($second->entity_id)
+        ->and(EntityMembership::owner()->count())->toBe(2);
+});
+
+test('an entity may have any number of non-owners', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->count(3)->employee()->for($entity)->create();
+    EntityMembership::factory()->count(2)->admin()->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(5);
+});
+
+test('an entity exposes its memberships, users and owner', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users->modelKeys())->toEqualCanonicalizing([$owner->user_id, $employee->user_id])
+        ->and($entity->owner()->first()->is($owner))->toBeTrue();
+});
+
+test('an entity without an owner returns null from the owner relation', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect($entity->owner()->first())->toBeNull();
+});
+
+test('a user exposes memberships, entities and membership lookup', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->owner()->for($user)->create();
+
+    expect($user->memberships->first()->is($membership))->toBeTrue()
+        ->and($user->entities->first()->is($membership->entity))->toBeTrue()
+        ->and($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor(999999))->toBeNull();
+});
+
+test('deleting a user cascades to their memberships', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->for($user)->create();
+
+    $user->delete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('force deleting an entity cascades to its memberships', function () {
+    $entity = Entity::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->create();
+
+    $entity->forceDelete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('user role enum exposes its values and manageable roles', function () {
+    expect(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee')
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
diff --git a/tests/Feature/EntityMembershipPolicyTest.php b/tests/Feature/EntityMembershipPolicyTest.php
new file mode 100644
index 0000000..d98e0cc
--- /dev/null
+++ b/tests/Feature/EntityMembershipPolicyTest.php
@@ -0,0 +1,103 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('any member of the same entity may view a membership', function () {
+    $entity = Entity::factory()->create();
+    $viewer = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id])->user;
+    $membership = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+
+    expect((new EntityMembershipPolicy)->view($viewer, $membership))->toBeTrue();
+});
+
+test('members of another entity may not view a membership', function () {
+    $membership = EntityMembership::factory()->create();
+    $outsider = EntityMembership::factory()->create()->user;
+
+    expect((new EntityMembershipPolicy)->view($outsider, $membership))->toBeFalse();
+});
+
+test('non-members may not view a membership', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect((new EntityMembershipPolicy)->view(User::factory()->create(), $membership))->toBeFalse();
+});
+
+test('owners and admins may assign roles', function (string $state) {
+    $entity = Entity::factory()->create();
+    $manager = EntityMembership::factory()->{$state}()->create(['entity_id' => $entity->id])->user;
+    $membership = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect((new EntityMembershipPolicy)->assignRole($manager, $membership))->toBeTrue();
+})->with(['owner', 'admin']);
+
+test('employees and non-members may not assign roles', function () {
+    $membership = EntityMembership::factory()->create();
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $membership->entity_id])->user;
+    $outsider = User::factory()->create();
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->assignRole($employee, $membership))->toBeFalse()
+        ->and($policy->assignRole($outsider, $membership))->toBeFalse();
+});
+
+test('nobody may delete the owner membership', function () {
+    $entity = Entity::factory()->create();
+    $ownerMembership = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id])->user;
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($ownerMembership->user, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($admin, $ownerMembership))->toBeFalse();
+});
+
+test('a member may remove their own membership', function (string $state) {
+    $membership = EntityMembership::factory()->{$state}()->create();
+
+    expect((new EntityMembershipPolicy)->delete($membership->user, $membership))->toBeTrue();
+})->with(['admin', 'employee']);
+
+test('owners and admins may delete another member membership', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id])->user;
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id])->user;
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($owner, $employee))->toBeTrue()
+        ->and($policy->delete($admin, $employee))->toBeTrue();
+});
+
+test('employees and non-members may not delete another membership', function () {
+    $membership = EntityMembership::factory()->create();
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $membership->entity_id])->user;
+    $outsider = User::factory()->create();
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($employee, $membership))->toBeFalse()
+        ->and($policy->delete($outsider, $membership))->toBeFalse();
+});
+
+test('the gate discovers and applies the membership policy', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id])->user;
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect($owner->can('assignRole', $employee))->toBeTrue()
+        ->and($employee->user->can('assignRole', $employee))->toBeFalse()
+        ->and($employee->user->can('view', $employee))->toBeTrue();
+});
+
+test('the policy is constructed without arguments', function () {
+    expect(new EntityMembershipPolicy)->toBeInstanceOf(EntityMembershipPolicy::class);
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..0fd9e8e
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,91 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('any authenticated user may create an entity', function () {
+    expect((new EntityPolicy)->create(User::factory()->create()))->toBeTrue();
+});
+
+test('any member may view the entity', function () {
+    $entity = Entity::factory()->create();
+    $user = EntityMembership::factory()->create(['entity_id' => $entity->id])->user;
+
+    expect((new EntityPolicy)->view($user, $entity))->toBeTrue();
+});
+
+test('non-members may not view the entity', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    expect((new EntityPolicy)->view($user, $entity))->toBeFalse();
+});
+
+test('owners and admins may update and delete the entity', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $user = EntityMembership::factory()->create([
+        'entity_id' => $entity->id,
+        'role' => $role,
+    ])->user;
+
+    $policy = new EntityPolicy;
+
+    expect($policy->update($user, $entity))->toBeTrue()
+        ->and($policy->delete($user, $entity))->toBeTrue();
+})->with([UserRole::Owner, UserRole::Admin]);
+
+test('employees may not update or delete the entity', function () {
+    $entity = Entity::factory()->create();
+    $user = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id])->user;
+
+    $policy = new EntityPolicy;
+
+    expect($policy->update($user, $entity))->toBeFalse()
+        ->and($policy->delete($user, $entity))->toBeFalse();
+});
+
+test('non-members may not update or delete the entity', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    $policy = new EntityPolicy;
+
+    expect($policy->update($user, $entity))->toBeFalse()
+        ->and($policy->delete($user, $entity))->toBeFalse();
+});
+
+test('only the owner may manage settings', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id])->user;
+    $admin = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id])->user;
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id])->user;
+    $outsider = User::factory()->create();
+
+    $policy = new EntityPolicy;
+
+    expect($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse()
+        ->and($policy->manageSettings($employee, $entity))->toBeFalse()
+        ->and($policy->manageSettings($outsider, $entity))->toBeFalse();
+});
+
+test('the gate discovers and applies the entity policy', function () {
+    $entity = Entity::factory()->create();
+    $member = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id])->user;
+    $outsider = User::factory()->create();
+
+    expect($member->can('view', $entity))->toBeTrue()
+        ->and($member->can('update', $entity))->toBeFalse()
+        ->and($member->cannot('manageSettings', $entity))->toBeTrue()
+        ->and($outsider->can('view', $entity))->toBeFalse();
+});
+
+test('the policy is constructed without arguments', function () {
+    expect(new EntityPolicy)->toBeInstanceOf(EntityPolicy::class);
+});
