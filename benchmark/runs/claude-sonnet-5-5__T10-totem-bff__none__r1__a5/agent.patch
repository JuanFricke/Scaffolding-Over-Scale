new file mode 100644
index 0000000..aeca084
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemAuthController.php
@@ -0,0 +1,116 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    public function __invoke(Request $request, TotemJwt $jwt): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || ! preg_match('/^[0-9]{6}\z/', $code)) {
+            $this->audit('Totem pairing rejected', $request, ['reason' => 'invalid_code_format']);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $result = DB::transaction(function () use ($code, $jwt): array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if (! $preset) {
+                return ['reason' => 'unknown_code'];
+            }
+
+            $entity = $preset->entity;
+
+            if (! $preset->is_active || ! $entity) {
+                return ['reason' => 'inactive_preset', 'preset' => $preset];
+            }
+
+            if ($preset->login_code_consumed_at !== null) {
+                return ['reason' => 'consumed_code', 'preset' => $preset];
+            }
+
+            if ($preset->login_code_expires_at === null || $preset->login_code_expires_at->lte(now())) {
+                return ['reason' => 'expired_code', 'preset' => $preset];
+            }
+
+            // Conditional update keeps consumption single-use even where row locks are a no-op.
+            $consumed = TotemPreset::query()
+                ->whereKey($preset->id)
+                ->whereNull('login_code_consumed_at')
+                ->update(['login_code_consumed_at' => now()]);
+
+            if ($consumed !== 1) {
+                return ['reason' => 'consumed_code', 'preset' => $preset];
+            }
+
+            $totem = Totem::query()->create([
+                'entity_id' => $entity->id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()
+                ->where('queues.entity_id', $entity->id)
+                ->pluck('queues.id')
+                ->map(fn ($id) => (int) $id)
+                ->all();
+
+            return [
+                'preset' => $preset,
+                'totem' => $totem,
+                'entity' => $entity,
+                'token' => $jwt->issue($totem, $preset, $queueIds),
+            ];
+        });
+
+        if (! isset($result['token'])) {
+            $this->audit('Totem pairing failed', $request, [
+                'reason' => $result['reason'],
+                'preset_id' => isset($result['preset']) ? $result['preset']->id : null,
+            ]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        $this->audit('Totem pairing succeeded', $request, [
+            'preset_id' => $result['preset']->id,
+            'entity_id' => $result['entity']->id,
+            'totem_id' => $result['totem']->id,
+        ]);
+
+        return response()->json([
+            'token' => $result['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => $jwt->ttl(),
+            'entity' => [
+                'slug' => $result['entity']->slug,
+                'name' => $result['entity']->name,
+            ],
+        ]);
+    }
+
+    /**
+     * Audit trail; the pairing code itself is never logged.
+     *
+     * @param  array<string, mixed>  $context
+     */
+    private function audit(string $message, Request $request, array $context): void
+    {
+        Log::channel('audit')->info($message, $context + ['ip' => $request->ip()]);
+    }
+}
