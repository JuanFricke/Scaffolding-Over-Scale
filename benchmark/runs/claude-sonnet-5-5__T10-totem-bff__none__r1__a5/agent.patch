@@ -0,0 +1,69 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Validates the totem JWT and the live state behind it, then exposes the
+ * resolved totem, preset and effective queue scope as request attributes.
+ */
+class AuthenticateTotem
+{
+    public function __construct(private readonly TotemJwt $jwt) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+        $claims = $token ? $this->jwt->claims($token) : null;
+
+        if ($claims === null
+            || ! is_int($claims['totem_id'] ?? null)
+            || ! is_int($claims['entity_id'] ?? null)
+            || ! is_int($claims['preset_id'] ?? null)
+            || ! is_array($claims['queues'] ?? null)) {
+            return $this->unauthorized();
+        }
+
+        $totem = Totem::query()->find($claims['totem_id']);
+        $preset = TotemPreset::query()->find($claims['preset_id']);
+        $entity = $totem?->entity;
+
+        if (! $totem || ! $totem->is_active
+            || ! $preset || ! $preset->is_active
+            || ! $entity
+            || $totem->entity_id !== $claims['entity_id']
+            || $preset->entity_id !== $claims['entity_id']) {
+            return $this->unauthorized();
+        }
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        // Intersection of what the token was granted and what the preset allows now.
+        $currentIds = $preset->queues()
+            ->where('queues.entity_id', $entity->id)
+            ->pluck('queues.id')
+            ->map(fn ($id) => (int) $id)
+            ->all();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_queue_ids', array_values(array_intersect(
+            array_filter($claims['queues'], 'is_int'),
+            $currentIds,
+        )));
+
+        return $next($request);
+    }
+
+    private function unauthorized(): Response
+    {
+        return response()->json(['code' => 'invalid_token'], 401);
+    }
+}
