+<?php
+
+use App\Http\Controllers\Api\TotemApiController;
+use App\Http\Controllers\Api\TotemAuthController;
+use Illuminate\Support\Facades\Route;
+
+// Totem BFF (see docs/api/totem.md). Mounted under /api by bootstrap/app.php.
+Route::post('totem/auth', TotemAuthController::class)->middleware('throttle:10,1');
+
+Route::middleware(['totem.auth', 'totem.entity'])->group(function () {
+    Route::get('{entity}/queues', [TotemApiController::class, 'queues']);
+    Route::get('{entity}/{queue}/priorities', [TotemApiController::class, 'priorities']);
+    Route::post('{entity}/{queue}/ticket', [TotemApiController::class, 'ticket'])
+        ->middleware('throttle:totem-ticket');
