+it('returns 404 for unknown or foreign queues and 403 for out-of-scope ones', function () {
+    [$preset, , $token] = setupTotem();
+    $slug = $preset->entity->slug;
+    $foreign = Queue::factory()->create(['slug' => 'alheia']);
+    Queue::factory()->for($preset->entity)->create(['slug' => 'fora']);
+
+    $this->getJson("/api/{$slug}/nada/priorities", bearer($token))->assertStatus(404)->assertExactJson(['code' => 'queue_not_found']);
+    $this->getJson("/api/{$slug}/alheia/priorities", bearer($token))->assertStatus(404);
+    $this->postJson("/api/{$slug}/alheia/ticket", ['priority' => 0], bearer($token))->assertStatus(404);
