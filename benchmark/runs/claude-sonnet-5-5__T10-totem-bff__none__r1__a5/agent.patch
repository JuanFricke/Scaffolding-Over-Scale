+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned ticket priority levels (higher value = more prioritized).
+ *
+ * Single source for the totem priorities endpoint and for validating the
+ * priority a client asks to issue with.
+ */
+enum TicketPriority: int
+{
+    case Normal = 0;
+    case Priority = 10;
+    case Priority80Plus = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Priority => 'Prioritário',
+            self::Priority80Plus => 'Prioridade 80+',
+        };
+    }
+
+    /**
+     * Presentation-only specs; ordering is always by the numeric value.
+     *
+     * @return array{color: string, icon: string, order: int}
+     */
+    public function visual(): array
+    {
+        return match ($this) {
+            self::Normal => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            self::Priority => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            self::Priority80Plus => ['color' => '#6A1B9A', 'icon' => 'elderly', 'order' => 3],
+        };
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemApiController.php b/app/Http/Controllers/Api/TotemApiController.php
new file mode 100644
index 0000000..8f7fcff
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemApiController.php
@@ -0,0 +1,144 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemApiController extends Controller
+{
+    private const DEFAULT_QUEUE_COLOR = '#0055FF';
+
+    private const DEFAULT_QUEUE_ICON = 'ticket';
+
+    public function queues(Request $request): JsonResponse
+    {
+        /** @var Entity $entity */
+        $entity = $request->attributes->get('totem_entity');
+        /** @var TotemPreset $preset */
+        $preset = $request->attributes->get('totem_preset');
+
+        $queues = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->whereIn('id', $request->attributes->get('totem_queue_ids'))
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->orderBy('id')
+            ->get()
+            ->values()
+            ->map(function (Queue $queue, int $index) use ($preset): array {
+                // Optional per-queue presentation overrides from the preset appearance.
+                $custom = $preset->appearance['queues'][$queue->slug] ?? [];
+
+                return [
+                    'slug' => $queue->slug,
+                    'label' => $queue->name,
+                    'description' => $custom['description'] ?? null,
+                    'visual' => [
+                        'color' => $custom['color'] ?? self::DEFAULT_QUEUE_COLOR,
+                        'icon' => $custom['icon'] ?? self::DEFAULT_QUEUE_ICON,
+                        'order' => $index + 1,
+                    ],
+                    'is_active' => true,
+                ];
+            });
+
+        return response()->json([
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+            'queues' => $queues,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $queue = $this->resolveQueue($request, $queue);
+
+        if ($queue instanceof JsonResponse) {
+            return $queue;
+        }
+
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $request->attributes->get('totem_entity')->slug],
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priorities' => array_map(fn (TicketPriority $priority): array => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+                'visual' => $priority->visual(),
+            ], TicketPriority::cases()),
+        ]);
+    }
+
+    public function ticket(Request $request, string $entity, string $queue, IssueTicket $issueTicket): JsonResponse
+    {
+        $queue = $this->resolveQueue($request, $queue);
+
+        if ($queue instanceof JsonResponse) {
+            return $queue;
+        }
+
+        $priority = $this->parsePriority($request->input('priority'));
+
+        if ($priority === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        if (! $queue->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        try {
+            $ticket = $issueTicket($queue, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queue->slug, 'label' => $queue->name],
+            'priority' => ['value' => $priority->value, 'label' => $priority->label()],
+            'issued_at' => $ticket->issued_at->utc()->toIso8601ZuluString(),
+        ], 201);
+    }
+
+    /**
+     * Queue of the token's entity by slug: 404 when unknown, 403 when out of scope.
+     */
+    private function resolveQueue(Request $request, string $slug): Queue|JsonResponse
+    {
+        $queue = Queue::query()
+            ->where('entity_id', $request->attributes->get('totem_entity')->id)
+            ->where('slug', $slug)
+            ->first();
+
+        if (! $queue) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! in_array($queue->id, $request->attributes->get('totem_queue_ids'), true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return $queue;
+    }
+
+    private function parsePriority(mixed $value): ?TicketPriority
+    {
+        if (is_string($value) && preg_match('/^[0-9]+\z/', $value)) {
+            $value = (int) $value;
+        }
+
+        return is_int($value) ? TicketPriority::tryFrom($value) : null;
+    }
+}
