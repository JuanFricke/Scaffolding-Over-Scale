+<?php
+
+namespace App\Support;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use Illuminate\Support\Str;
+use RuntimeException;
+use Throwable;
+
+/**
+ * HS256 credential for a paired totem.
+ */
+class TotemJwt
+{
+    private const ALGORITHM = 'HS256';
+
+    public function ttl(): int
+    {
+        return max(1, (int) config('services.totem.jwt_ttl', 3600));
+    }
+
+    /**
+     * @param  list<int>  $queueIds
+     */
+    public function issue(Totem $totem, TotemPreset $preset, array $queueIds): string
+    {
+        $now = time();
+
+        return JWT::encode([
+            'totem_id' => $totem->id,
+            'entity_id' => $totem->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => array_values($queueIds),
+            'iat' => $now,
+            'exp' => $now + $this->ttl(),
+            'jti' => (string) Str::uuid(),
+        ], $this->secret(), self::ALGORITHM);
+    }
+
+    /**
+     * Verified claims, or null when the token is malformed, forged or expired.
+     *
+     * @return array<string, mixed>|null
+     */
+    public function claims(string $token): ?array
+    {
+        $key = new Key($this->secret(), self::ALGORITHM);
+
+        try {
+            $claims = (array) JWT::decode($token, $key);
+        } catch (Throwable) {
+            return null;
+        }
+
+        return $claims;
+    }
+
+    private function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if (strlen($secret) < 32) {
+            throw new RuntimeException('services.totem.jwt_secret (TOTEM_JWT_SECRET) must be at least 32 characters.');
+        }
+
+        return $secret;
+    }
+}
