+it('issues sequential totem tickets', function () {
+    [$preset, $queue, $token] = setupTotem();
+    $url = "/api/{$preset->entity->slug}/geral/ticket";
+
+    $first = $this->postJson($url, ['priority' => 10], bearer($token))
+        ->assertCreated()
+        ->assertJsonPath('slug', 'A001')
+        ->assertJsonPath('queue', ['slug' => 'geral', 'label' => 'Geral'])
+        ->assertJsonPath('priority', ['value' => 10, 'label' => 'Prioritário']);
+
+    expect(Carbon\Carbon::parse($first->json('issued_at')))->toBeInstanceOf(Carbon\Carbon::class);
+
+    $this->postJson($url, ['priority' => 0], bearer($token))->assertCreated()->assertJsonPath('slug', 'A002');
+
+    $ticket = Ticket::query()->where('code', 'A001')->firstOrFail();
+    expect($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and($ticket->priority)->toBe(10)
+        ->and($ticket->queue_id)->toBe($queue->id);
+});
