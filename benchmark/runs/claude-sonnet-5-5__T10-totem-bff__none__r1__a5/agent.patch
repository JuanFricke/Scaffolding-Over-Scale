@@ -0,0 +1,60 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+class TotemPairingCode extends Command
+{
+    protected $signature = 'totem:pairing-code {preset : Totem preset id}';
+
+    protected $description = 'Open a 10 minute pairing window for a totem preset and print its login code';
+
+    public function handle(): int
+    {
+        $preset = ctype_digit((string) $this->argument('preset'))
+            ? TotemPreset::query()->find((int) $this->argument('preset'))
+            : null;
+
+        if (! $preset) {
+            $this->error('Totem preset not found.');
+
+            return self::FAILURE;
+        }
+
+        if (! $preset->is_active) {
+            $this->warn('Preset is inactive: the code will not pair until it is reactivated.');
+        }
+
+        $code = $this->generateUniqueCode();
+        $expiresAt = now()->addMinutes(10);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => $expiresAt,
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        Log::channel('audit')->info('Totem pairing window opened', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $expiresAt->toIso8601String(),
+        ]);
+
+        $this->line("Pairing code: {$code}");
+        $this->line("Expires at: {$expiresAt->toDateTimeString()} (10 minutes)");
+
+        return self::SUCCESS;
+    }
+
+    private function generateUniqueCode(): string
+    {
+        do {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+        } while (TotemPreset::query()->where('login_code', $code)->exists());
+
+        return $code;
+    }
+}
