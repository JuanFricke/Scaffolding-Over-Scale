+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    public function view(User $user, EntityMembership $entityMembership): bool
+    {
+        return $user->membershipFor($entityMembership->entity_id) !== null;
+    }
+
+    public function assignRole(User $user, EntityMembership $entityMembership): bool
+    {
+        $actor = $user->membershipFor($entityMembership->entity_id);
+
+        if ($actor === null) {
+            return false;
+        }
+
+        return in_array($actor->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    public function delete(User $user, EntityMembership $entityMembership): bool
+    {
+        if ($this->roleOf($entityMembership) === UserRole::Owner) {
+            return false;
+        }
+
+        if ($user->id === $entityMembership->user_id) {
+            return true;
+        }
+
+        $actor = $user->membershipFor($entityMembership->entity_id);
+
+        if ($actor === null) {
+            return false;
+        }
+
+        return in_array($actor->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    private function roleOf(EntityMembership $entityMembership): ?UserRole
+    {
+        $role = $entityMembership->role;
+
+        if ($role instanceof UserRole) {
+            return $role;
+        }
+
+        return UserRole::tryFrom((string) $role);
+    }
+}
