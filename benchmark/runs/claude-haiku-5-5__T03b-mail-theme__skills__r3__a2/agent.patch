diff --git a/tests/Feature/Auth/ForgotPasswordTest.php b/tests/Feature/Auth/ForgotPasswordTest.php
new file mode 100644
index 0000000..a598976
--- /dev/null
+++ b/tests/Feature/Auth/ForgotPasswordTest.php
@@ -0,0 +1,62 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+
+uses(RefreshDatabase::class);
+
+test('guests see the forgot password form', function () {
+    $this->get('/forgot-password')
+        ->assertOk()
+        ->assertSee('for="email"', false)
+        ->assertSee('type="email"', false)
+        ->assertSee('Enviar link de redefinição de senha');
+});
+
+test('signed in users are redirected away from the forgot password form', function () {
+    $this->actingAs(User::factory()->create())
+        ->get('/forgot-password')
+        ->assertRedirect('/');
+});
+
+test('a registered address receives the reset notification and the generic confirmation', function () {
+    Notification::fake();
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    $this->post('/forgot-password', ['email' => 'ana@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', 'Enviamos um link para redefinição de senha para o seu e-mail.');
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown address gets the same confirmation and nothing is sent', function () {
+    Notification::fake();
+
+    $this->post('/forgot-password', ['email' => 'nobody@example.com'])
+        ->assertRedirect()
+        ->assertSessionHas('status', 'Enviamos um link para redefinição de senha para o seu e-mail.');
+
+    Notification::assertNothingSent();
+});
+
+test('the email is required and must be an address', function () {
+    $this->post('/forgot-password', ['email' => ''])
+        ->assertSessionHasErrors('email');
+
+    $this->post('/forgot-password', ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+});
+
+test('the reset request is throttled to six attempts per minute', function () {
+    Notification::fake();
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post('/forgot-password', ['email' => 'nobody@example.com'])->assertRedirect();
+    }
+
+    $this->post('/forgot-password', ['email' => 'nobody@example.com'])
+        ->assertStatus(429);
+});
diff --git a/tests/Feature/Auth/ResetPasswordTest.php b/tests/Feature/Auth/ResetPasswordTest.php
new file mode 100644
index 0000000..b5e3dfc
--- /dev/null
+++ b/tests/Feature/Auth/ResetPasswordTest.php
@@ -0,0 +1,95 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+function resetPayload(string $token, string $password, ?string $confirmation = null): array
+{
+    return [
+        'token' => $token,
+        'email' => 'ana@example.com',
+        'password' => $password,
+        'password_confirmation' => $confirmation ?? $password,
+    ];
+}
+
+test('guests see the reset form with the token and a single email input', function () {
+    $response = $this->get('/reset-password/abc123?email=ana@example.com')
+        ->assertOk()
+        ->assertSee('value="abc123"', false)
+        ->assertSee('value="ana@example.com"', false)
+        ->assertSee('name="password"', false)
+        ->assertSee('name="password_confirmation"', false);
+
+    expect(substr_count($response->getContent(), 'name="email"'))->toBe(1);
+});
+
+test('signed in users are redirected away from the reset form', function () {
+    $this->actingAs(User::factory()->create())
+        ->get('/reset-password/abc123?email=ana@example.com')
+        ->assertRedirect('/');
+});
+
+test('a valid token sets the new password, rotates the remember token and redirects home', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['email' => 'ana@example.com', 'remember_token' => 'old-token']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post('/reset-password', resetPayload($token, 'NovaSenha123'))
+        ->assertRedirect('/')
+        ->assertSessionHas('status', 'Sua senha foi redefinida.');
+
+    $user->refresh();
+    expect(Hash::check('NovaSenha123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-token');
+    Event::assertDispatched(PasswordReset::class, fn (PasswordReset $event) => $event->user->is($user));
+});
+
+test('a reset token can only be used once', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post('/reset-password', resetPayload($token, 'NovaSenha123'))->assertRedirect('/');
+
+    $this->post('/reset-password', resetPayload($token, 'OutraSenha456'))
+        ->assertSessionHasErrors(['email' => 'O token de redefinição de senha é inválido.']);
+
+    expect(Hash::check('NovaSenha123', $user->fresh()->password))->toBeTrue();
+});
+
+test('an invalid token is rejected and the password is left unchanged', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com', 'password' => 'SenhaAntiga123']);
+
+    $this->post('/reset-password', resetPayload('token-inventado', 'NovaSenha123'))
+        ->assertSessionHasErrors(['email' => 'O token de redefinição de senha é inválido.']);
+
+    expect(Hash::check('SenhaAntiga123', $user->fresh()->password))->toBeTrue();
+});
+
+test('weak or unconfirmed passwords are rejected', function (string $password, ?string $confirmation) {
+    $user = User::factory()->create(['email' => 'ana@example.com', 'password' => 'SenhaAntiga123']);
+    $token = Password::broker()->createToken($user);
+
+    $this->post('/reset-password', resetPayload($token, $password, $confirmation))
+        ->assertSessionHasErrors('password');
+
+    expect(Hash::check('SenhaAntiga123', $user->fresh()->password))->toBeTrue();
+})->with([
+    'too short' => ['Ab1cdEf', null],
+    'no uppercase letter' => ['senhasenha123', null],
+    'no lowercase letter' => ['SENHASENHA123', null],
+    'no number' => ['SenhaSemNumero', null],
+    'no letter' => ['12345678901', null],
+    'confirmation does not match' => ['NovaSenha123', 'OutraSenha123'],
+]);
+
+test('the reset form requires the token, email and password fields', function () {
+    $this->post('/reset-password', [])
+        ->assertSessionHasErrors(['token', 'email', 'password']);
+});
diff --git a/tests/Feature/Auth/VerifyEmailTest.php b/tests/Feature/Auth/VerifyEmailTest.php
new file mode 100644
index 0000000..c446868
--- /dev/null
+++ b/tests/Feature/Auth/VerifyEmailTest.php
@@ -0,0 +1,76 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function signedVerificationUrl(User $user, ?string $hash = null, ?int $id = null): string
+{
+    return URL::temporarySignedRoute(
+        'verification.verify',
+        now()->addMinutes(60),
+        [
+            'id' => $id ?? $user->getKey(),
+            'hash' => $hash ?? sha1($user->getEmailForVerification()),
+        ],
+    );
+}
+
+test('a signed in user verifies their own address through the link and is redirected home', function () {
+    Event::fake([Verified::class]);
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user))
+        ->assertRedirect('/');
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+    Event::assertDispatched(Verified::class);
+});
+
+test('a link whose hash does not match the user is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user, hash: sha1('outro@example.com')))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link naming another user id is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($other, id: $other->getKey()))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned verification link is rejected', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->getKey(), 'hash' => sha1($user->email)]))
+        ->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('the verification link is throttled to six attempts per minute', function () {
+    $user = User::factory()->unverified()->create();
+    $url = signedVerificationUrl($user);
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->actingAs($user)->get($url)->assertRedirect('/');
+    }
+
+    $this->actingAs($user)->get($url)->assertStatus(429);
+});
