+++ b/tests/Feature/Mail/AccountEmailsTest.php
@@ -0,0 +1,54 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+
+test('the markdown mail theme is pegafila and its stylesheet exists', function () {
+    expect(config('mail.markdown.theme'))->toBe('pegafila')
+        ->and(resource_path('views/vendor/mail/html/themes/pegafila.css'))->toBeFile();
+});
+
+test('the reset password mail is translated and branded with PegaFila', function () {
+    $user = User::factory()->make(['email' => 'ana@example.com']);
+
+    $message = (new ResetPassword('token-123'))->toMail($user);
+    $html = (string) $message->render();
+
+    expect($message->subject)->toBe('Redefina sua senha')
+        ->and($message->actionUrl)->toContain('/reset-password/token-123')
+        ->and($html)->toContain('PegaFila')
+        ->toContain('Olá!')
+        ->toContain('Redefinir senha')
+        ->toContain('Você recebeu esse e-mail')
+        ->toContain('Se você estiver tendo problemas para clicar no botão')
+        ->not->toContain('having trouble clicking')
+        ->not->toContain('Reset your password');
+});
+
+test('the reset password button carries the brand primary color after inlining', function () {
+    $user = User::factory()->make(['email' => 'ana@example.com']);
+
+    $html = (string) (new ResetPassword('token-123'))->toMail($user)->render();
+
+    expect($html)->toMatch('/<a [^>]*class="button button-primary"[^>]*>/');
+    preg_match('/<a [^>]*class="button button-primary"[^>]*>/', $html, $button);
+    expect($button[0])->toContain('#0f7490');
+});
+
+test('the verification mail is translated and links to the signed verification route', function () {
+    $user = User::factory()->make(['id' => 7, 'email' => 'ana@example.com']);
+
+    $message = (new VerifyEmail)->toMail($user);
+    $html = (string) $message->render();
+
+    expect($message->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($message->actionUrl)->toContain('/email/verify/7/'.sha1('ana@example.com'))
+        ->and($message->actionUrl)->toContain('signature=')
+        ->and($html)->toContain('PegaFila')
+        ->toContain('Olá!')
+        ->toContain('Verifique o endereço de e-mail')
+        ->toContain('Se você estiver tendo problemas para clicar no botão')
+        ->not->toContain('having trouble clicking')
+        ->not->toContain('Verify your email address');
+});
