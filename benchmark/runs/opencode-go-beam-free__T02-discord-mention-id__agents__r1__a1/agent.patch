 ### Changed
 
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..770aa36 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,41 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $base = implode("\n", $lines);
+
+        $mentionId = $this->validMentionId();
+        $suffix = $mentionId === null ? '' : "\n<@".$mentionId.'>';
+
+        if ($suffix === '') {
+            return mb_substr($base, 0, self::MaxContentLength);
+        }
+
+        $maxBase = self::MaxContentLength - mb_strlen($suffix);
+
+        if ($maxBase < 0) {
+            $maxBase = 0;
+        }
+
+        return mb_substr($base, 0, $maxBase).$suffix;
+    }
+
+    private function validMentionId(): ?string
+    {
+        $value = config('services.discord.mention_id');
+
+        if (is_int($value) && ! is_bool($value)) {
+            $value = (string) $value;
+        } elseif (is_string($value)) {
+            $value = trim($value);
+        } else {
+            return null;
+        }
+
+        if (! is_string($value) || preg_match('/^[0-9]{17,20}$/', $value) !== 1) {
+            return null;
+        }
+
+        return $value;
     }
 
     private function safe(string $key, mixed $value): string
