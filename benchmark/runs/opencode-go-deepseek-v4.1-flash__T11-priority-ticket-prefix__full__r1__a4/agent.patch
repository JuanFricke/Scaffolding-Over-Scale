diff --git a/tests/Feature/QueuePrefixMapTest.php b/tests/Feature/QueuePrefixMapTest.php
new file mode 100644
index 0000000..e491690
--- /dev/null
+++ b/tests/Feature/QueuePrefixMapTest.php
@@ -0,0 +1,148 @@
+<?php
+
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function prefixMapOwner(Entity $entity): User
+{
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    return $owner;
+}
+
+it('resolves the default prefix by named level and range', function () {
+    $queue = Queue::factory()->make();
+
+    expect(Queue::DEFAULT_PREFIX_MAP)->toBe([0 => 'N', 10 => 'P', 20 => 'E'])
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(10))->toBe('P')
+        ->and($queue->prefixForPriority(20))->toBe('E')
+        ->and($queue->prefixForPriority(-1))->toBe('N')
+        ->and($queue->prefixForPriority(5))->toBe('P')
+        ->and($queue->prefixForPriority(15))->toBe('P')
+        ->and($queue->prefixForPriority(25))->toBe('E')
+        ->and(Queue::defaultPrefixFor(30))->toBe('E');
+});
+
+it('prefers custom map entries and falls back to defaults for the rest', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => ['0' => 'X', '10' => 'Y'],
+    ]);
+
+    expect($queue->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y'])
+        ->and($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('E')
+        ->and($queue->prefixForPriority(5))->toBe('P');
+});
+
+it('normalizes an empty map to null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('does not mass-assign the priority prefix map', function () {
+    $queue = Queue::factory()->make();
+    $queue->fill(['priority_prefix_map' => ['0' => 'X']]);
+
+    expect($queue->priority_prefix_map)->toBeNull();
+});
+
+it('accepts custom entries for levels outside the default map', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => ['5' => 'A', '10' => 'B'],
+    ]);
+
+    expect($queue->prefixForPriority(5))->toBe('A')
+        ->and($queue->prefixForPriority(10))->toBe('B')
+        ->and($queue->prefixForPriority(0))->toBe('N');
+});
+
+it('rejects invalid priority prefix maps', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+})->with([
+    'non numeric key' => [['foo' => 'X']],
+    'negative key' => [['-1' => 'X']],
+    'non canonical key' => [['010' => 'X']],
+    'key with trailing newline' => [["0\n" => 'X']],
+    'multi letter value' => [['0' => 'XX']],
+    'lowercase value' => [['0' => 'x']],
+    'value with trailing newline' => [['0' => "X\n"]],
+    'non string value' => [['0' => 1]],
+    'duplicate custom prefixes' => [['0' => 'N', '10' => 'N']],
+    'custom merged with normal default' => [['10' => 'N']],
+    'custom merged with 80+ default' => [['0' => 'E']],
+    'custom merged with priority default' => [['0' => 'P']],
+]);
+
+it('validates the map on every model save', function () {
+    $queue = Queue::factory()->create();
+
+    $queue->priority_prefix_map = ['0' => 'xx'];
+
+    expect(fn () => $queue->save())->toThrow(InvalidArgumentException::class)
+        ->and($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('updates, leaves unchanged and clears the map through UpdateQueue', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixMapOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    $updated = (new UpdateQueue)($queue, $owner, priorityPrefixMap: [
+        '0' => 'X',
+        '10' => 'Y',
+        '20' => 'Z',
+    ]);
+
+    expect($updated->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z']);
+
+    $unchanged = (new UpdateQueue)($updated->fresh(), $owner, name: 'Renamed');
+
+    expect($unchanged->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z']);
+
+    $cleared = (new UpdateQueue)($updated->fresh(), $owner, priorityPrefixMap: []);
+
+    expect($cleared->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('raises a validation error and leaves the queue unchanged for an invalid map', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixMapOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    try {
+        (new UpdateQueue)($queue, $owner, name: 'Changed', priorityPrefixMap: ['0' => 'N', '10' => 'N']);
+        $this->fail('Expected a ValidationException.');
+    } catch (ValidationException $e) {
+        expect(array_keys($e->errors()))->toBe(['priority_prefix_map']);
+    }
+
+    expect($queue->fresh()->name)->toBe('Geral')
+        ->and($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('denies map changes to employees without changing the map', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixMapOwner($entity);
+    $queue = (new UpdateQueue)(Queue::factory()->for($entity)->create(), $owner, priorityPrefixMap: ['0' => 'X']);
+
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    expect(fn () => (new UpdateQueue)($queue, $employee, priorityPrefixMap: ['0' => 'Y']))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+});
