+it('scopes ticket codes uniquely by queue, code and issue date', function () {
+    expect(Schema::hasIndex('tickets', 'tickets_queue_id_code_issue_date_unique'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_code_unique'))->toBeFalse();
+
+    $queue = Queue::factory()->create();
