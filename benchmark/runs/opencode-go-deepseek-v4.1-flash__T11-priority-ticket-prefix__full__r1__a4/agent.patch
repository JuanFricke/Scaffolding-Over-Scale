+        ->and(Schema::hasColumn('tickets', 'issue_date'))->toBeTrue();
+
+    $queueColumns = collect(Schema::getColumns('queues'))->keyBy('name');
+    $ticketColumns = collect(Schema::getColumns('tickets'))->keyBy('name');
+
+    expect($queueColumns['priority_prefix_map']['nullable'])->toBeTrue()
+        ->and($ticketColumns['issue_date']['nullable'])->toBeFalse()
+        ->and($ticketColumns['issue_date']['type'])->toBe('date');
+});
