+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('allocates a normal code and today issue date by default', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->code)->toBe('N001')
+        ->and($ticket->issue_date->toDateString())->toBe(now()->toDateString())
+        ->and($ticket->issued_at->toDateString())->toBe(now()->toDateString());
+});
+
+it('allocates the code from the ticket priority', function () {
+    $queue = Queue::factory()->create();
+
+    $normal = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+    $expanded = Ticket::factory()->forQueue($queue)->create(['priority' => 20]);
+
+    expect($normal->code)->toBe('N001')
+        ->and($priority->code)->toBe('P001')
+        ->and($expanded->code)->toBe('E001');
+});
+
+it('uses a custom queue prefix map', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+
+    $ticket = Ticket::factory()->forQueue($queue)->create(['priority' => 0]);
+
+    expect($ticket->code)->toBe('X001');
+});
+
+it('allocates the historical day code even when the same code exists today', function () {
+    $queue = Queue::factory()->create();
+    $historicalDate = now()->subDay()->toDateString();
+
+    $today = Ticket::factory()->forQueue($queue)->create();
+    $historical = Ticket::factory()->forQueue($queue)->create([
+        'issued_at' => $historicalDate.' 12:00:00',
+    ]);
+
+    expect($today->code)->toBe('N001')
+        ->and($historical->code)->toBe('N001')
+        ->and($historical->issue_date->toDateString())->toBe($historicalDate)
+        ->and($historical->issued_at->toDateString())->toBe($historicalDate);
+});
+
+it('keeps explicit codes and aligns issue_date with issued_at', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->forQueue($queue)->create([
+        'code' => 'P777',
+        'priority' => 10,
+        'issued_at' => '2026-09-28 14:30:00',
+    ]);
+
+    expect($ticket->code)->toBe('P777')
+        ->and($ticket->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($ticket->issued_at->toDateString())->toBe('2026-09-28');
+});
+
+it('derives issued_at from an explicitly supplied issue_date', function () {
+    $ticket = Ticket::factory()->create(['issue_date' => '2026-09-28']);
+
+    expect($ticket->code)->toBe('N001')
+        ->and($ticket->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($ticket->issued_at->toDateString())->toBe('2026-09-28');
+});
