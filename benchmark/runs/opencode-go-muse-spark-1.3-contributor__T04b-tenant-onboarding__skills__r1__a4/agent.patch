@@ -0,0 +1,103 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+class CreateEntity extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->validate();
+
+        $this->authorize('create', Entity::class);
+
+        $user = auth()->user();
+
+        $entity = null;
+        $attempts = 0;
+
+        while (true) {
+            $attempts++;
+            $slug = $this->uniqueSlug($this->name);
+
+            try {
+                $entity = DB::transaction(function () use ($slug, $user) {
+                    $created = Entity::create([
+                        'name' => $this->name,
+                        'slug' => $slug,
+                    ]);
+
+                    EntityMembership::create([
+                        'entity_id' => $created->id,
+                        'user_id' => $user->id,
+                        'role' => UserRole::Owner,
+                    ]);
+
+                    return $created;
+                });
+
+                break;
+            } catch (QueryException $e) {
+                if ($attempts >= 5 || ! $this->isDuplicateSlugError($e)) {
+                    throw $e;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirectRoute('entity.dashboard', ['entity' => $entity->slug]);
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name);
+
+        if ($base === '') {
+            $base = 'entity';
+        }
+
+        $slug = $base;
+        $suffix = 2;
+
+        while (Entity::withTrashed()->where('slug', $slug)->exists()) {
+            $slug = $base.'-'.$suffix;
+            $suffix++;
+        }
+
+        return $slug;
+    }
+
+    protected function isDuplicateSlugError(QueryException $e): bool
+    {
+        $message = strtolower($e->getMessage());
+
+        return str_contains($message, 'entities_slug_unique')
+            || str_contains($message, 'entities.slug')
+            || (str_contains($message, 'unique') && str_contains($message, 'slug'));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')
+            ->layout('layouts::default-page', ['title' => __('ui.create_entity_title')]);
+    }
+}
