diff --git a/tests/Feature/QueuePriorityPrefixTest.php b/tests/Feature/QueuePriorityPrefixTest.php
new file mode 100644
index 0000000..135782e
--- /dev/null
+++ b/tests/Feature/QueuePriorityPrefixTest.php
@@ -0,0 +1,210 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+afterEach(fn () => Carbon::setTestNow());
+
+function prefixOwner(Queue $queue): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+it('resolves default prefixes with range fallback', function (int $priority, string $prefix) {
+    expect(Queue::defaultPrefixFor($priority))->toBe($prefix)
+        ->and(Queue::factory()->create()->prefixForPriority($priority))->toBe($prefix);
+})->with([
+    [0, 'N'], [10, 'P'], [20, 'E'],
+    [-5, 'N'], [5, 'P'], [15, 'P'], [19, 'P'], [21, 'E'], [80, 'E'],
+]);
+
+it('prefers the custom map and falls back to the default', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => [0 => 'X', 10 => 'Y']]);
+
+    expect($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('E')
+        ->and($queue->fresh()->prefixForPriority(10))->toBe('Y');
+});
+
+it('stores an empty map as null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->priority_prefix_map)->toBeNull()
+        ->and($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('accepts a JSON-style map', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z']]);
+
+    expect($queue->fresh()->prefixForPriority(20))->toBe('Z');
+});
+
+it('rejects invalid maps on save', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+})->with([
+    'non numeric key' => [['foo' => 'A']],
+    'negative key' => [['-1' => 'A']],
+    'leading zero key' => [['010' => 'A']],
+    'multi letter' => [['0' => 'xx']],
+    'lowercase' => [['0' => 'a']],
+    'non string' => [['0' => 1]],
+    'duplicate custom' => [['0' => 'N', '10' => 'N']],
+    'merges normal with 80+' => [['0' => 'E']],
+    'collides with default' => [['5' => 'P']],
+]);
+
+it('does not allow mass-assigning the map', function () {
+    $queue = Queue::factory()->create();
+    $queue->fill(['priority_prefix_map' => ['0' => 'X']])->save();
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects an invalid map when updating an existing queue', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+    $queue->priority_prefix_map = ['0' => 'N', '10' => 'N'];
+
+    expect(fn () => $queue->save())->toThrow(InvalidArgumentException::class);
+});
+
+it('issues codes by priority prefix with independent sequences', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    expect($issue($queue, 0)->code)->toBe('N001')
+        ->and($issue($queue, 0)->code)->toBe('N002')
+        ->and($issue($queue, 10)->code)->toBe('P001')
+        ->and($issue($queue, 10)->code)->toBe('P002')
+        ->and($issue($queue, 20)->code)->toBe('E001')
+        ->and($issue($queue, 0)->code)->toBe('N003');
+});
+
+it('uses the queue custom map when issuing', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '10' => 'Y']]);
+
+    expect((new IssueTicket)($queue, 0)->code)->toBe('X001')
+        ->and((new IssueTicket)($queue, 10)->code)->toBe('Y001')
+        ->and((new IssueTicket)($queue, 20)->code)->toBe('E001');
+});
+
+it('restarts each prefix at 001 on the next day', function () {
+    $queue = Queue::factory()->create();
+
+    Carbon::setTestNow('2026-09-28 10:00:00');
+    (new IssueTicket)($queue, 0);
+    (new IssueTicket)($queue, 0);
+    (new IssueTicket)($queue, 10);
+
+    Carbon::setTestNow('2026-09-29 08:00:00');
+    $normal = (new IssueTicket)($queue, 0);
+    $priority = (new IssueTicket)($queue, 10);
+
+    expect($normal->code)->toBe('N001')
+        ->and($normal->issue_date->toDateString())->toBe('2026-09-29')
+        ->and($priority->code)->toBe('P001');
+});
+
+it('uses a single clock read for code day, issued_at and issue_date', function () {
+    $queue = Queue::factory()->create();
+    Carbon::setTestNow('2026-09-28 23:59:59');
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($ticket->issued_at->toDateString())->toBe('2026-09-28')
+        ->and($ticket->fresh()->getRawOriginal('issue_date'))->toBe('2026-09-28');
+});
+
+it('keeps legacy A codes out of the N sequence', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+
+    expect((new IssueTicket)($queue)->code)->toBe('N001');
+});
+
+it('skips malformed codes and counts only the same day', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->for($queue)->create(['code' => 'N-X']);
+    expect(Ticket::nextCode($queue->id, 'N', today()))->toBe('N001');
+
+    Ticket::factory()->for($queue)->create(['code' => 'N001']);
+    Ticket::factory()->for($queue)->create(['code' => 'N-X']);
+    expect(Ticket::nextCode($queue->id, 'N', today()))->toBe('N002')
+        ->and(Ticket::nextCode($queue->id, 'N', today()->subDay()))->toBe('N001');
+});
+
+it('lets the factory allocate by priority and issued_at day', function () {
+    $queue = Queue::factory()->create();
+
+    $today = Ticket::factory()->forQueue($queue)->create();
+    $old = Ticket::factory()->forQueue($queue)->create(['issued_at' => '2026-09-28 09:00:00']);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+
+    expect($today->code)->toBe('N001')
+        ->and($today->issue_date->toDateString())->toBe(today()->toDateString())
+        ->and($old->code)->toBe('N001')
+        ->and($old->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($priority->code)->toBe('P001');
+});
+
+it('keeps explicit factory codes', function () {
+    $ticket = Ticket::factory()->create(['code' => 'Z042']);
+
+    expect($ticket->code)->toBe('Z042');
+});
+
+it('updates the map through UpdateQueue and clears it with an empty array', function () {
+    $queue = Queue::factory()->create();
+    $owner = prefixOwner($queue);
+
+    $updated = (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X']);
+    expect($updated->fresh()->prefixForPriority(0))->toBe('X');
+
+    (new UpdateQueue)($queue, $owner, name: 'Renamed');
+    expect($queue->fresh()->prefixForPriority(0))->toBe('X');
+
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: []);
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('raises a validation error and leaves the queue unchanged on an invalid map', function () {
+    $queue = Queue::factory()->create(['name' => 'Original', 'priority_prefix_map' => ['0' => 'X']]);
+    $owner = prefixOwner($queue);
+
+    try {
+        (new UpdateQueue)($queue, $owner, name: 'Changed', priorityPrefixMap: ['0' => 'N', '10' => 'N']);
+        $this->fail('Expected ValidationException');
+    } catch (ValidationException $e) {
+        expect($e->errors())->toHaveKey('priority_prefix_map');
+    }
+
+    expect($queue->fresh())
+        ->name->toBe('Original')
+        ->priority_prefix_map->toBe([0 => 'X']);
+});
+
+it('keeps UpdateQueue authorization for the map', function () {
+    $queue = Queue::factory()->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($employee)->employee()->create();
+
+    expect(fn () => (new UpdateQueue)($queue, $employee, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
