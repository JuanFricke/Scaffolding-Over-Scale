+<?php
+
+namespace Tests\Feature\Totem;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwtService;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class TotemQueuesTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function createValidJwt(Totem $totem, TotemPreset $preset, array $queueIds = []): string
+    {
+        $jwtService = app(TotemJwtService::class);
+
+        return $jwtService->sign([
+            'totem_id' => $totem->id,
+            'entity_id' => $totem->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => $queueIds,
+        ]);
+    }
+
+    public function test_get_queues_requires_valid_token(): void
+    {
+        $response = $this->getJson('/api/entity-slug/queues');
+
+        $response->assertStatus(401);
+        $response->assertJson(['code' => 'invalid_token']);
+    }
+
+    public function test_get_queues_forbidden_for_different_entity(): void
+    {
+        $entity1 = Entity::factory()->create();
+        $entity2 = Entity::factory()->create();
+
+        $totem = Totem::factory()->for($entity1)->create();
+        $preset = TotemPreset::factory()->for($entity1)->create();
+
+        $token = $this->createValidJwt($totem, $preset);
+
+        $response = $this->getJson(
+            "/api/{$entity2->slug}/queues",
+            ['Authorization' => "Bearer $token"]
+        );
+
+        $response->assertStatus(403);
+        $response->assertJson(['code' => 'forbidden']);
+    }
+
+    public function test_get_queues_returns_active_queues_only(): void
+    {
