index 0000000..06c1f8d
--- /dev/null
+++ b/tests/Feature/Totem/TotemAuthTest.php
@@ -0,0 +1,125 @@
+<?php
+
+namespace Tests\Feature\Totem;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\TotemPreset;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class TotemAuthTest extends TestCase
+{
+    use RefreshDatabase;
+
+    public function test_auth_with_invalid_code_format(): void
+    {
+        $response = $this->postJson('/api/totem/auth', ['code' => '12345']);
+
+        $response->assertStatus(400);
+        $response->assertJson(['code' => 'invalid_code_format']);
+    }
+
+    public function test_auth_with_invalid_pairing_code(): void
+    {
+        $response = $this->postJson('/api/totem/auth', ['code' => '999999']);
+
+        $response->assertStatus(401);
+        $response->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    public function test_auth_with_expired_code(): void
+    {
+        $preset = TotemPreset::factory()
+            ->state(['login_code_expires_at' => now()->subMinutes(1)])
+            ->create();
+
+        $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+        $response->assertStatus(401);
+        $response->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    public function test_auth_with_already_consumed_code(): void
+    {
+        $preset = TotemPreset::factory()
+            ->state(['login_code_consumed_at' => now()->subMinutes(1)])
+            ->create();
+
+        $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+        $response->assertStatus(401);
+        $response->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    public function test_auth_with_inactive_preset(): void
+    {
+        $preset = TotemPreset::factory()
+            ->state(['is_active' => false])
+            ->create();
+
+        $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+        $response->assertStatus(401);
+        $response->assertJson(['code' => 'invalid_pairing_code']);
+    }
+
+    public function test_successful_auth(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+        $preset = TotemPreset::factory()
+            ->for($entity)
+            ->create();
+
+        $preset->queues()->attach($queue);
+
+        $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+        $response->assertStatus(200);
+        $response->assertJsonStructure([
+            'token',
+            'token_type',
+            'expires_in',
+        ]);
+
+        $this->assertEquals('Bearer', $response->json('token_type'));
+        $this->assertEquals(3600, $response->json('expires_in'));
+
+        $preset->refresh();
+        $this->assertNotNull($preset->login_code_consumed_at);
+    }
+
+    public function test_pairing_creates_totem_row(): void
+    {
+        $entity = Entity::factory()->create();
+        $preset = TotemPreset::factory()
+            ->for($entity)
+            ->create();
+
+        $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+        $response->assertStatus(200);
+
+        $this->assertDatabaseHas('totems', [
+            'entity_id' => $entity->id,
+            'is_active' => true,
+        ]);
+    }
+
+    public function test_auth_rate_limiting(): void
+    {
+        // Make 10 successful requests, 11th should be rate limited
+        for ($i = 0; $i < 11; $i++) {
+            $preset = TotemPreset::factory()->create();
+            $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+            if ($i < 10) {
+                $response->assertStatus(200);
+            } else {
+                $response->assertStatus(429);
+                $response->assertJson(['code' => 'rate_limited']);
+            }
+        }
+    }
+}
