@@ -0,0 +1,91 @@
+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwtService;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+class AuthController extends Controller
+{
+    public function login(Request $request, TotemJwtService $jwtService): JsonResponse
+    {
+        $code = $request->input('code', '');
+
+        if (!preg_match('/^\d{6}$/', $code)) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $preset = TotemPreset::query()
+            ->where('login_code', $code)
+            ->first();
+
+        if (!$preset || !$this->isCodeValid($preset)) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        return DB::transaction(function () use ($preset, $jwtService) {
+            $lockedPreset = TotemPreset::query()
+                ->whereKey($preset->id)
+                ->lockForUpdate()
+                ->first();
+
+            if (!$this->isCodeValid($lockedPreset)) {
+                return response()->json(['code' => 'invalid_pairing_code'], 401);
+            }
+
+            $queueIds = $lockedPreset->queues()
+                ->where('is_active', true)
+                ->pluck('queue_id')
+                ->toArray();
+
+            $totem = Totem::query()->updateOrCreate(
+                ['entity_id' => $lockedPreset->entity_id, 'name' => $lockedPreset->name],
+                ['is_active' => true, 'last_seen_at' => now()],
+            );
+
+            $lockedPreset->update(['login_code_consumed_at' => now()]);
+
+            $token = $jwtService->sign([
+                'totem_id' => $totem->id,
+                'entity_id' => $totem->entity_id,
+                'preset_id' => $lockedPreset->id,
+                'queues' => $queueIds,
+            ]);
+
+            Log::info('Totem pairing successful', [
+                'entity_id' => $totem->entity_id,
+                'preset_id' => $lockedPreset->id,
+                'code_suffix' => substr($lockedPreset->login_code, -2),
+            ]);
+
+            return response()->json([
+                'token' => $token,
+                'token_type' => 'Bearer',
+                'expires_in' => 3600,
+            ], 200);
+        });
+    }
+
+    private function isCodeValid(TotemPreset $preset): bool
+    {
+        if (!$preset->is_active) {
+            return false;
+        }
+
+        if ($preset->login_code_consumed_at !== null) {
+            return false;
+        }
+
+        if ($preset->login_code_expires_at && $preset->login_code_expires_at < now()) {
+            return false;
+        }
+
+        return true;
+    }
+}
