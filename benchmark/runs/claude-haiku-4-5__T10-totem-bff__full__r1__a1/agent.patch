+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TicketController extends Controller
+{
+    private const PRIORITIES = [
+        0 => 'Normal',
+        10 => 'Prioritário',
+        20 => 'Prioridade 80+',
+    ];
+
+    public function store(
+        Request $request,
+        string $entity,
+        string $queue,
+        IssueTicket $issueTicket,
+    ): JsonResponse {
+        $totem = $request->attributes->get('totem');
+        $claims = $request->attributes->get('totem_claims');
+
+        $entityModel = Entity::where('slug', $entity)->first();
+
+        if (!$entityModel || $entityModel->id !== $totem->entity_id) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $allowedQueueIds = $claims['queues'] ?? [];
+
+        $queueModel = Queue::where('slug', $queue)
+            ->where('entity_id', $entityModel->id)
+            ->whereIn('id', $allowedQueueIds)
+            ->first();
+
+        if (!$queueModel) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (!$queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        $priority = $request->input('priority', 0);
+
+        if (!array_key_exists($priority, self::PRIORITIES)) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = $issueTicket($queueModel, (int) $priority, TicketChannel::Totem);
+        } catch (\Exception $e) {
+            Log::error('Failed to issue totem ticket', [
+                'queue_id' => $queueModel->id,
+                'priority' => $priority,
+                'error' => $e->getMessage(),
+            ]);
+
+            return response()->json(['code' => 'internal_error'], 500);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => [
+                'value' => $ticket->priority,
+                'label' => self::PRIORITIES[$ticket->priority],
+            ],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+}
