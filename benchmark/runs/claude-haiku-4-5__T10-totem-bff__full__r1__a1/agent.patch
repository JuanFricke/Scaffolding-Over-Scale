+<?php
+
+namespace Tests\Feature\Totem;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Services\TotemJwtService;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Tests\TestCase;
+
+class TotemTicketTest extends TestCase
+{
+    use RefreshDatabase;
+
+    protected function createValidJwt(Totem $totem, TotemPreset $preset, array $queueIds = []): string
+    {
+        $jwtService = app(TotemJwtService::class);
+
+        return $jwtService->sign([
+            'totem_id' => $totem->id,
+            'entity_id' => $totem->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => $queueIds,
+        ]);
+    }
+
+    public function test_issue_ticket_requires_valid_token(): void
+    {
+        $response = $this->postJson('/api/entity-slug/queue-slug/ticket', ['priority' => 0]);
+
+        $response->assertStatus(401);
+        $response->assertJson(['code' => 'invalid_token']);
+    }
+
+    public function test_issue_ticket_with_invalid_priority(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+
+        $totem = Totem::factory()->for($entity)->create();
+        $preset = TotemPreset::factory()->for($entity)->create();
+
+        $preset->queues()->attach($queue->id);
+
+        $token = $this->createValidJwt($totem, $preset, [$queue->id]);
+
+        $response = $this->postJson(
+            "/api/{$entity->slug}/{$queue->slug}/ticket",
+            ['priority' => 999],
+            ['Authorization' => "Bearer $token"]
+        );
+
+        $response->assertStatus(422);
+        $response->assertJson(['code' => 'invalid_priority']);
+    }
+
+    public function test_issue_ticket_success(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+
+        $totem = Totem::factory()->for($entity)->create();
+        $preset = TotemPreset::factory()->for($entity)->create();
+
+        $preset->queues()->attach($queue->id);
+
+        $token = $this->createValidJwt($totem, $preset, [$queue->id]);
+
+        $response = $this->postJson(
+            "/api/{$entity->slug}/{$queue->slug}/ticket",
+            ['priority' => 10],
+            ['Authorization' => "Bearer $token"]
+        );
+
+        $response->assertStatus(201);
+        $response->assertJsonStructure([
+            'slug',
+            'queue' => ['slug', 'label'],
+            'priority' => ['value', 'label'],
+            'issued_at',
+        ]);
+
+        $this->assertEquals(10, $response->json('priority.value'));
+        $this->assertEquals('Prioritário', $response->json('priority.label'));
+
+        $this->assertDatabaseHas('tickets', [
+            'queue_id' => $queue->id,
+            'priority' => 10,
+            'channel' => 'totem',
+        ]);
+    }
+
+    public function test_issue_ticket_inactive_queue(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->state(['is_active' => false])->create();
+
+        $totem = Totem::factory()->for($entity)->create();
+        $preset = TotemPreset::factory()->for($entity)->create();
+
+        $preset->queues()->attach($queue->id);
+
+        $token = $this->createValidJwt($totem, $preset, [$queue->id]);
+
+        $response = $this->postJson(
+            "/api/{$entity->slug}/{$queue->slug}/ticket",
+            ['priority' => 0],
+            ['Authorization' => "Bearer $token"]
+        );
+
+        $response->assertStatus(422);
+        $response->assertJson(['code' => 'inactive_queue']);
+    }
+
+    public function test_issue_ticket_rate_limiting(): void
+    {
+        $entity = Entity::factory()->create();
+        $queue = Queue::factory()->for($entity)->create();
+
+        $totem = Totem::factory()->for($entity)->create();
+        $preset = TotemPreset::factory()->for($entity)->create();
+
+        $preset->queues()->attach($queue->id);
+
+        $token = $this->createValidJwt($totem, $preset, [$queue->id]);
+
+        // Make 30 successful requests, 31st should be rate limited
+        for ($i = 0; $i < 31; $i++) {
+            $response = $this->postJson(
+                "/api/{$entity->slug}/{$queue->slug}/ticket",
+                ['priority' => 0],
+                ['Authorization' => "Bearer $token"]
+            );
+
+            if ($i < 30) {
+                $response->assertStatus(201);
+            } else {
+                $response->assertStatus(429);
+                $response->assertJson(['code' => 'rate_limited']);
+            }
+        }
+    }
+}
