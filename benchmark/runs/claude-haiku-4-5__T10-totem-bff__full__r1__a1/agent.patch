+<?php
+
+namespace App\Http\Controllers\Api\Totem;
+
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class QueueController extends Controller
+{
+    private const PRIORITIES = [
+        ['value' => 0, 'label' => 'Normal', 'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1]],
+        ['value' => 10, 'label' => 'Prioritário', 'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2]],
+        ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => ['color' => '#1565C0', 'icon' => 'elderly', 'order' => 3]],
+    ];
+
+    public function index(Request $request, string $entity): JsonResponse
+    {
+        $totem = $request->attributes->get('totem');
+        $preset = $request->attributes->get('totem_preset');
+        $claims = $request->attributes->get('totem_claims');
+
+        $entityModel = Entity::where('slug', $entity)->first();
+
+        if (!$entityModel || $entityModel->id !== $totem->entity_id) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $allowedQueueIds = $claims['queues'] ?? [];
+
+        $queues = $preset->queues()
+            ->where('is_active', true)
+            ->whereIn('queues.id', $allowedQueueIds)
+            ->orderBy('name')
+            ->get()
+            ->map(fn (Queue $q) => [
+                'slug' => $q->slug,
+                'label' => $q->name,
+                'description' => $q->name,
+                'visual' => [
+                    'color' => '#0055FF',
+                    'icon' => 'ticket',
+                    'order' => $q->id, // Simple ordering by id; adjust as needed
+                ],
+                'is_active' => true,
+            ])
+            ->values();
+
+        return response()->json([
+            'entity' => ['slug' => $entityModel->slug, 'name' => $entityModel->name],
+            'queues' => $queues,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $totem = $request->attributes->get('totem');
+        $claims = $request->attributes->get('totem_claims');
+
+        $entityModel = Entity::where('slug', $entity)->first();
+
+        if (!$entityModel || $entityModel->id !== $totem->entity_id) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $allowedQueueIds = $claims['queues'] ?? [];
+
+        $queueModel = Queue::where('slug', $queue)
+            ->where('entity_id', $entityModel->id)
+            ->whereIn('id', $allowedQueueIds)
+            ->first();
+
+        if (!$queueModel) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (!$queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $entityModel->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => self::PRIORITIES,
+        ]);
+    }
+}
