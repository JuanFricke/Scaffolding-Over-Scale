+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+#[Signature('totem:pairing-code {preset : The preset ID}')]
+#[Description('Generate a pairing code for a totem preset')]
+class TotemPairingCodeCommand extends Command
+{
+    public function handle(): int
+    {
+        $presetId = $this->argument('preset');
+
+        $preset = TotemPreset::find($presetId);
+
+        if (!$preset) {
+            $this->error("Preset with ID {$presetId} not found.");
+
+            return 1;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->update([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ]);
+
+        Log::info('Totem pairing code generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'code_suffix' => substr($code, -2),
+        ]);
+
+        $this->info("Pairing code for {$preset->name}: $code");
+        $this->info('Code expires in 10 minutes.');
+
+        return 0;
+    }
+}
