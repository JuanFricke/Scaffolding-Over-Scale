+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function managedQueue(array $queueAttributes = []): array
+{
+    $actor = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($actor)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create($queueAttributes);
+
+    return [$queue, $actor, $entity];
+}
+
+it('updates name, slug and active flag', function () {
+    [$queue, $actor] = managedQueue(['name' => 'Geral', 'slug' => 'geral']);
+
+    $updated = (new UpdateQueue)($queue, $actor, name: 'VIP', slug: 'fila-vip', isActive: false);
+
+    expect($updated->name)->toBe('VIP')
+        ->and($updated->slug)->toBe('fila-vip')
+        ->and($updated->is_active)->toBeFalse();
+});
+
+it('leaves unspecified fields unchanged', function () {
+    [$queue, $actor] = managedQueue(['name' => 'Geral', 'slug' => 'geral', 'is_active' => true]);
+
+    $updated = (new UpdateQueue)($queue, $actor, isActive: false);
+
+    expect($updated->name)->toBe('Geral')
+        ->and($updated->slug)->toBe('geral')
+        ->and($updated->is_active)->toBeFalse();
+});
+
+it('keeps its own slug without error', function () {
+    [$queue, $actor] = managedQueue(['name' => 'Geral', 'slug' => 'geral']);
+
+    $updated = (new UpdateQueue)($queue, $actor, slug: 'geral');
+
+    expect($updated->slug)->toBe('geral');
+});
+
+it('rejects taking another queue slug in the same entity', function () {
+    [$queue, $actor, $entity] = managedQueue(['slug' => 'geral']);
+    Queue::factory()->for($entity)->create(['slug' => 'vip']);
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, slug: 'vip'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->slug)->toBe('geral');
+});
+
+it('allows the same slug as a queue in another entity', function () {
+    [$queue, $actor] = managedQueue(['slug' => 'geral']);
+    $other = Entity::factory()->create();
+    Queue::factory()->for($other)->create(['slug' => 'vip']);
+
+    $updated = (new UpdateQueue)($queue, $actor, slug: 'vip');
+
+    expect($updated->slug)->toBe('vip');
+});
+
+it('rejects blank and overlong names and slugs', function () {
+    [$queue, $actor] = managedQueue(['name' => 'Geral', 'slug' => 'geral']);
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: '  '))
+        ->toThrow(ValidationException::class);
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: str_repeat('a', 256)))
+        ->toThrow(ValidationException::class);
+    expect(fn () => (new UpdateQueue)($queue, $actor, slug: '!!!'))
+        ->toThrow(ValidationException::class);
+
+    expect($queue->fresh()->name)->toBe('Geral')
+        ->and($queue->fresh()->slug)->toBe('geral');
+});
+
+it('retires a queue via deactivation while preserving tickets', function () {
+    [$queue, $actor] = managedQueue(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue);
+
+    $updated = (new UpdateQueue)($queue, $actor, isActive: false);
+
+    expect($updated->is_active)->toBeFalse()
+        ->and($ticket->fresh()->exists)->toBeTrue();
+});
+
+it('rejects updates by employees, outsiders and non-members', function () {
+    [$queue, $owner, $entity] = managedQueue(['name' => 'Geral']);
+
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $stranger = User::factory()->create();
+
+    foreach ([$employee, $stranger] as $actor) {
+        expect(fn () => (new UpdateQueue)($queue, $actor, name: 'Hacked'))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect($queue->fresh()->name)->toBe('Geral');
+    expect($owner->id)->not->toBeNull();
+});
