diff --git a/tests/Feature/Queue/CreateQueueTest.php b/tests/Feature/Queue/CreateQueueTest.php
new file mode 100644
index 0000000..41884d8
--- /dev/null
+++ b/tests/Feature/Queue/CreateQueueTest.php
@@ -0,0 +1,107 @@
+<?php
+
+use App\Actions\CreateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function managedEntity(string $role = 'owner'): array
+{
+    $actor = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($actor)->create(['role' => $role]);
+
+    return [$entity, $actor];
+}
+
+it('creates an active queue with a slugified name', function () {
+    [$entity, $actor] = managedEntity();
+
+    $queue = (new CreateQueue)($entity, $actor, 'Atendimento Geral');
+
+    expect($queue)
+        ->toBeInstanceOf(Queue::class)
+        ->entity_id->toBe($entity->id)
+        ->name->toBe('Atendimento Geral')
+        ->slug->toBe('atendimento-geral')
+        ->is_active->toBeTrue();
+});
+
+it('trims the name and slugifies an explicit slug', function () {
+    [$entity, $actor] = managedEntity('admin');
+
+    $queue = (new CreateQueue)($entity, $actor, '  Prioridade  ', ' Fila VIP ');
+
+    expect($queue->name)->toBe('Prioridade')
+        ->and($queue->slug)->toBe('fila-vip');
+});
+
+it('allows an admin to create queues', function () {
+    [$entity, $actor] = managedEntity('admin');
+
+    $queue = (new CreateQueue)($entity, $actor, 'Geral');
+
+    expect($queue->exists)->toBeTrue();
+});
+
+it('rejects blank and overlong names', function () {
+    [$entity, $actor] = managedEntity();
+
+    expect(fn () => (new CreateQueue)($entity, $actor, '   '))
+        ->toThrow(ValidationException::class);
+    expect(fn () => (new CreateQueue)($entity, $actor, str_repeat('a', 256)))
+        ->toThrow(ValidationException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+});
+
+it('rejects duplicate slugs within the same entity', function () {
+    [$entity, $actor] = managedEntity();
+
+    (new CreateQueue)($entity, $actor, 'Atendimento Geral');
+
+    expect(fn () => (new CreateQueue)($entity, $actor, 'atendimento-geral'))
+        ->toThrow(ValidationException::class);
+
+    expect(Queue::query()->count())->toBe(1);
+});
+
+it('allows the same slug in another entity', function () {
+    [$entity, $actor] = managedEntity();
+    $other = Entity::factory()->create();
+
+    $first = (new CreateQueue)($entity, $actor, 'Geral');
+
+    EntityMembership::factory()->for($other)->for($actor)->owner()->create();
+    $second = (new CreateQueue)($other, $actor, 'Geral');
+
+    expect($second->slug)->toBe($first->slug)
+        ->and($second->entity_id)->toBe($other->id);
+});
+
+it('rejects creation by employees, outsiders and non-members', function () {
+    [$entity, $owner] = managedEntity();
+
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $outsider = User::factory()->create();
+    $other = Entity::factory()->create();
+    EntityMembership::factory()->for($other)->for($outsider)->owner()->create();
+
+    $stranger = User::factory()->create();
+
+    foreach ([$employee, $outsider, $stranger] as $actor) {
+        expect(fn () => (new CreateQueue)($entity, $actor, 'Geral'))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect(Queue::query()->count())->toBe(0);
+    expect($owner->id)->not->toBeNull();
+});
diff --git a/tests/Feature/Queue/QueuePolicyTest.php b/tests/Feature/Queue/QueuePolicyTest.php
new file mode 100644
index 0000000..1d7970b
--- /dev/null
+++ b/tests/Feature/Queue/QueuePolicyTest.php
@@ -0,0 +1,164 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Actions\SetQueueAccess;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function policySetup(string $managerRole = 'owner'): array
+{
+    $manager = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($manager)->create(['role' => $managerRole]);
+
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    return [$entity, $queue, $manager, $employee, $membership];
+}
+
+it('lets owners and admins manage queues and access', function () {
+    foreach (['owner', 'admin'] as $role) {
+        [$entity, $queue, $manager] = policySetup($role);
+
+        expect(Gate::forUser($manager)->allows('create', [Queue::class, $entity]))->toBeTrue()
+            ->and(Gate::forUser($manager)->allows('update', $queue))->toBeTrue()
+            ->and(Gate::forUser($manager)->allows('manageAccess', $queue))->toBeTrue()
+            ->and(Gate::forUser($manager)->allows('call', $queue))->toBeTrue();
+    }
+});
+
+it('denies employees without a grant on every ability except nothing', function () {
+    [$entity, $queue, $manager, $employee] = policySetup();
+
+    expect(Gate::forUser($employee)->allows('create', [Queue::class, $entity]))->toBeFalse()
+        ->and(Gate::forUser($employee)->allows('update', $queue))->toBeFalse()
+        ->and(Gate::forUser($employee)->allows('manageAccess', $queue))->toBeFalse()
+        ->and(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+    expect($manager->id)->not->toBeNull();
+});
+
+it('lets an employee call only the granted queue', function () {
+    [$entity, $queue, $manager, $employee, $membership] = policySetup();
+    $other = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('call', $other))->toBeFalse();
+});
+
+it('denies callers from other entities and non-members', function () {
+    [$entity, $queue] = policySetup();
+
+    $outsider = User::factory()->create();
+    EntityMembership::factory()->for(Entity::factory()->create())->for($outsider)->owner()->create();
+    $stranger = User::factory()->create();
+
+    expect(Gate::forUser($outsider)->allows('call', $queue))->toBeFalse()
+        ->and(Gate::forUser($stranger)->allows('call', $queue))->toBeFalse();
+    expect($entity->id)->not->toBeNull();
+});
+
+it('denies call on corrupted non-array permissions', function () {
+    [$entity, $queue, $manager, $employee, $membership] = policySetup();
+
+    QueueAccess::query()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $queue->id,
+        'permissions' => 'call',
+    ]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+    expect($manager->id)->not->toBeNull();
+    expect($entity->id)->not->toBeNull();
+});
+
+it('creates the factory grant in a shared entity by default', function () {
+    $access = QueueAccess::factory()->create();
+
+    expect($access->permissions)->toBe(['call'])
+        ->and($access->membership->entity_id)->toBe($access->queue->entity_id);
+});
+
+it('authorizes employees with a grant through CallNextTicket', function () {
+    [$entity, $queue, $manager, $employee, $membership] = policySetup();
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new IssueTicket)($queue, 0);
+
+    $called = (new CallNextTicket)($queue, $employee, CallMode::Any);
+
+    expect($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_by_user_id)->toBe($employee->id);
+    expect($entity->id)->not->toBeNull();
+});
+
+it('rejects unauthorized CallNextTicket callers in every mode without touching tickets', function () {
+    foreach ([CallMode::Any, CallMode::PriorityOnly, CallMode::NormalOnly] as $mode) {
+        [$entity, $queue, $manager, $employee] = policySetup();
+
+        (new IssueTicket)($queue, $mode === CallMode::NormalOnly ? 0 : 10);
+
+        expect(fn () => (new CallNextTicket)($queue, $employee, $mode))
+            ->toThrow(AuthorizationException::class);
+
+        expect($queue->tickets()->where('status', TicketStatus::Waiting)->count())->toBe(1);
+        expect($entity->id)->not->toBeNull();
+        expect($manager->id)->not->toBeNull();
+    }
+});
+
+it('rejects Ticket::call on inactive queues before authorizing', function () {
+    [$entity, $queue, $manager, $employee, $membership] = policySetup();
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    $ticket = (new IssueTicket)($queue, 0);
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => $ticket->call($employee))
+        ->toThrow(InactiveQueueException::class);
+    expect($entity->id)->not->toBeNull();
+});
+
+it('rejects unauthorized Ticket::call even when the ticket was already called', function () {
+    [$entity, $queue, $manager] = policySetup();
+
+    $ticket = (new IssueTicket)($queue, 0);
+    $ticket->call($manager);
+
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called);
+    expect($entity->id)->not->toBeNull();
+});
+
+it('rejects unauthorized Ticket::call on a waiting ticket', function () {
+    [$entity, $queue] = policySetup();
+
+    $ticket = (new IssueTicket)($queue, 0);
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+    expect($entity->id)->not->toBeNull();
+});
diff --git a/tests/Feature/Queue/SetQueueAccessTest.php b/tests/Feature/Queue/SetQueueAccessTest.php
new file mode 100644
