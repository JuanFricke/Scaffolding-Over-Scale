@@ -0,0 +1,63 @@
+<?php
+
+namespace Database\Factories;
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    /**
+     * Default state is a `call` grant. Foreign keys are left null here and
+     * resolved in configure(): both sides default to freshly created rows in
+     * one shared entity, while an explicitly passed membership or queue
+     * pulls the other side into its entity — so the pair always belongs to
+     * the same entity.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'permissions' => [QueuePermission::Call->value],
+        ];
+    }
+
+    public function configure(): static
+    {
+        return $this->afterMaking(function (QueueAccess $access): void {
+            if ($access->entity_membership_id !== null && $access->queue_id !== null) {
+                return;
+            }
+
+            if ($access->entity_membership_id === null && $access->queue_id === null) {
+                $entity = Entity::factory()->create();
+                $access->membership()->associate(EntityMembership::factory()->for($entity)->create());
+                $access->queue()->associate(Queue::factory()->for($entity)->create());
+
+                return;
+            }
+
+            if ($access->entity_membership_id === null) {
+                $queue = $access->queue ?? Queue::query()->findOrFail($access->queue_id);
+                $access->membership()->associate(
+                    EntityMembership::factory()->for($queue->entity)->create()
+                );
+
+                return;
+            }
+
+            $membership = $access->membership ?? EntityMembership::query()->findOrFail($access->entity_membership_id);
+            $access->queue()->associate(
+                Queue::factory()->for($membership->entity)->create()
+            );
+        });
+    }
+}
