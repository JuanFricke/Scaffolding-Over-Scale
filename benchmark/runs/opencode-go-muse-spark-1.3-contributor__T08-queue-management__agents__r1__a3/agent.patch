+++ b/app/Policies/QueuePolicy.php
@@ -0,0 +1,78 @@
+<?php
+
+namespace App\Policies;
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+
+class QueuePolicy
+{
+    /**
+     * Determine whether the user can create a queue in the entity (admin + owner).
+     */
+    public function create(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity->id);
+    }
+
+    /**
+     * Determine whether the user can update the queue (admin + owner of its entity).
+     */
+    public function update(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, (int) $queue->entity_id);
+    }
+
+    /**
+     * Determine whether the user can manage per-queue access grants
+     * (admin + owner of the queue's entity).
+     */
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, (int) $queue->entity_id);
+    }
+
+    /**
+     * Determine whether the user can call tickets on the queue: admin + owner
+     * always; an employee only with a `queue_access` row for that queue whose
+     * permissions contain `call`. A corrupted non-array value denies.
+     */
+    public function call(User $user, Queue $queue): bool
+    {
+        $membership = $user->membershipFor((int) $queue->entity_id);
+
+        if ($membership === null) {
+            return false;
+        }
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            return true;
+        }
+
+        $access = QueueAccess::query()
+            ->where('entity_membership_id', $membership->id)
+            ->where('queue_id', $queue->id)
+            ->first();
+
+        if ($access === null) {
+            return false;
+        }
+
+        $permissions = $access->permissions;
+
+        return is_array($permissions)
+            && in_array(QueuePermission::Call->value, $permissions, true);
+    }
+
+    protected function isManager(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
diff --git a/database/factories/QueueAccessFactory.php b/database/factories/QueueAccessFactory.php
