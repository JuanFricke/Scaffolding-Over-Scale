+++ b/tests/Feature/Queue/SetQueueAccessTest.php
@@ -0,0 +1,122 @@
+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function accessSetup(): array
+{
+    $manager = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($manager)->owner()->create();
+
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    return [$membership, $queue, $manager, $entity];
+}
+
+it('grants call access and audits the grant', function () {
+    [$membership, $queue, $manager] = accessSetup();
+
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('queue.access.granted', [
+        'actor_id' => $manager->id,
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $membership->id,
+    ]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    $row = QueueAccess::query()
+        ->where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->firstOrFail();
+
+    expect($row->permissions)->toBe(['call']);
+});
+
+it('upserts permissions on repeat grants', function () {
+    [$membership, $queue, $manager] = accessSetup();
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    expect(QueueAccess::query()->count())->toBe(1)
+        ->and(QueueAccess::query()->firstOrFail()->permissions)->toBe(['call']);
+});
+
+it('revokes access on an empty list and audits the revoke', function () {
+    [$membership, $queue, $manager] = accessSetup();
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('queue.access.revoked', [
+        'actor_id' => $manager->id,
+        'queue_id' => $queue->id,
+        'entity_membership_id' => $membership->id,
+    ]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('does not log when revoking a grant that does not exist', function () {
+    [$membership, $queue, $manager] = accessSetup();
+
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->never();
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+});
+
+it('rejects unknown or non-string permissions without storing', function () {
+    [$membership, $queue, $manager] = accessSetup();
+
+    foreach ([['admin'], ['CALL'], [123], [null], [['call']]] as $permissions) {
+        expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, $permissions))
+            ->toThrow(ValidationException::class);
+    }
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('rejects cross-entity membership and queue pairs', function () {
+    [$membership, $queue, $manager] = accessSetup();
+    $other = Entity::factory()->create();
+    $foreignQueue = Queue::factory()->for($other)->create();
+
+    expect(fn () => (new SetQueueAccess)($membership, $foreignQueue, $manager, ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+    expect($queue->id)->not->toBeNull();
+});
+
+it('rejects grants by non-managers including self-grants', function () {
+    [$membership, $queue, $manager, $entity] = accessSetup();
+
+    $employee = $membership->user;
+    $stranger = User::factory()->create();
+
+    foreach ([$employee, $stranger] as $actor) {
+        expect(fn () => (new SetQueueAccess)($membership, $queue, $actor, ['call']))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect(QueueAccess::query()->count())->toBe(0);
+    expect($manager->id)->not->toBeNull();
+    expect($entity->id)->not->toBeNull();
+});
