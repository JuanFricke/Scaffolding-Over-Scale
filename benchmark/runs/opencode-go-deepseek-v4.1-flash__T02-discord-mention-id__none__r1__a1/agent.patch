diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..f2753b4 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,37 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $content = implode("\n", $lines);
+        $mentionId = $this->mentionId();
+
+        if ($mentionId === null) {
+            return mb_substr($content, 0, self::MaxContentLength);
+        }
+
+        $mention = '<@'.$mentionId.'>';
+
+        // Reserve room for the mention (and its leading newline) so truncation
+        // never drops the ping.
+        $limit = self::MaxContentLength - mb_strlen($mention) - 1;
+
+        return mb_substr($content, 0, max(0, $limit))."\n".$mention;
+    }
+
+    /**
+     * Accept only a Discord snowflake: 17-20 ASCII digits after trimming.
+     * Everything else (mentions, malformed values, embedded newlines) is ignored.
+     */
+    private function mentionId(): ?string
+    {
+        $value = config('services.discord.mention_id');
+
+        if (! is_string($value) && ! is_int($value)) {
+            return null;
+        }
+
+        $value = trim((string) $value);
+
+        return preg_match('/^\d{17,20}$/', $value) === 1 ? $value : null;
     }
 
     private function safe(string $key, mixed $value): string
