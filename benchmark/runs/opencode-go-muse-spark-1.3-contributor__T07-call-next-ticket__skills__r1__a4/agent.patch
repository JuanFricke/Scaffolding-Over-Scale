+<?php
+
+use App\Actions\CallNextTicket;
+use App\Actions\IssueTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function callNextQueue(array $queueAttrs = []): array
+{
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true, ...$queueAttrs]);
+
+    return [$queue, $attendant];
+}
+
+function waitingTicket(Queue $queue, int $priority = 0, ?string $issuedAt = null, ?string $code = null): Ticket
+{
+    $attrs = ['priority' => $priority, 'status' => TicketStatus::Waiting, 'called_at' => null, 'called_by_user_id' => null];
+    if ($issuedAt !== null) {
+        $attrs['issued_at'] = $issuedAt;
+    }
+    if ($code !== null) {
+        $attrs['code'] = $code;
+    }
+
+    return Ticket::factory()->forQueue($queue)->create($attrs);
+}
+
+function calledTicket(Queue $queue, int $priority = 0, ?string $calledAt = null, ?User $calledBy = null): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt ?? now(),
+        'called_by_user_id' => ($calledBy ?? User::factory()->create())->id,
+    ]);
+}
+
+it('calls the highest priority ticket first in any mode', function () {
+    [$queue, $attendant] = callNextQueue();
+    $normal = waitingTicket($queue, 0, '2026-01-01 10:00:00');
+    $priority = waitingTicket($queue, 10, '2026-01-01 11:00:00');
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($priority->id)
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('breaks priority ties by oldest issued_at then lowest id', function () {
+    [$queue, $attendant] = callNextQueue();
+    $older = waitingTicket($queue, 5, '2026-01-01 10:00:00');
+    $newer = waitingTicket($queue, 5, '2026-01-01 11:00:00');
+    $sameTimeA = Ticket::factory()->forQueue($queue)->create([
+        'priority' => 5, 'status' => TicketStatus::Waiting, 'issued_at' => '2026-01-01 12:00:00',
+    ]);
+    $sameTimeB = Ticket::factory()->forQueue($queue)->create([
+        'priority' => 5, 'status' => TicketStatus::Waiting, 'issued_at' => '2026-01-01 12:00:00',
+    ]);
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($older->id);
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($newer->id);
+    expect($sameTimeA->id)->toBeLessThan($sameTimeB->id);
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($sameTimeA->id);
+});
+
+it('only selects waiting tickets of the given queue and never re-calls', function () {
+    [$queue, $attendant] = callNextQueue();
+    $other = Queue::factory()->create(['is_active' => true]);
+    $otherTicket = waitingTicket($other, 99, '2026-01-01 09:00:00');
+    $mine = waitingTicket($queue, 0, '2026-01-01 10:00:00');
+    $alreadyCalled = calledTicket($queue, 99, '2026-01-01 09:30:00');
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($mine->id)
+        ->and($otherTicket->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($alreadyCalled->fresh()->status)->toBe(TicketStatus::Called);
+
+    // The just-called ticket is never called again: next call throws.
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('priority_only calls only priority tickets in full ordering', function () {
+    [$queue, $attendant] = callNextQueue();
+    $normal = waitingTicket($queue, 0, '2026-01-01 09:00:00');
+    $low = waitingTicket($queue, 5, '2026-01-01 11:00:00');
+    $high = waitingTicket($queue, 20, '2026-01-01 12:00:00');
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->id)->toBe($high->id)
+        ->and($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+    expect((new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly)->id)->toBe($low->id);
+});
+
+it('priority_only throws when only normals wait', function () {
+    [$queue, $attendant] = callNextQueue();
+    waitingTicket($queue, 0);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('normal_only calls the oldest normal ticket', function () {
+    [$queue, $attendant] = callNextQueue();
+    $priority = waitingTicket($queue, 50, '2026-01-01 09:00:00');
+    $olderNormal = waitingTicket($queue, 0, '2026-01-01 10:00:00');
+    $newerNormal = waitingTicket($queue, 0, '2026-01-01 11:00:00');
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly);
+
+    expect($called->id)->toBe($olderNormal->id)
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($newerNormal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('normal_only throws when only priority tickets wait', function () {
+    [$queue, $attendant] = callNextQueue();
+    waitingTicket($queue, 10);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('throws when the queue is empty', function () {
+    [$queue, $attendant] = callNextQueue();
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('enforces fairness after 3 consecutive priority calls', function () {
+    [$queue, $attendant] = callNextQueue();
+    calledTicket($queue, 10, '2026-01-01 10:00:00');
+    calledTicket($queue, 10, '2026-01-01 10:01:00');
+    calledTicket($queue, 10, '2026-01-01 10:02:00');
+    $normal = waitingTicket($queue, 0, '2026-01-01 10:03:00');
+    $priority = waitingTicket($queue, 10, '2026-01-01 10:04:00');
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($normal->id);
+    expect($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('resets the fairness streak after a normal call', function () {
+    [$queue, $attendant] = callNextQueue();
+    calledTicket($queue, 10, '2026-01-01 10:00:00');
+    calledTicket($queue, 10, '2026-01-01 10:01:00');
+    calledTicket($queue, 10, '2026-01-01 10:02:00');
+    $normal = waitingTicket($queue, 0, '2026-01-01 10:03:00');
+    $priority = waitingTicket($queue, 10, '2026-01-01 10:04:00');
+    $priority2 = waitingTicket($queue, 10, '2026-01-01 10:05:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($normal->id);
+    // Streak broken by the normal call: priority wins again.
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($priority->id);
+    expect($priority2->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('counts priority_only and normal_only calls in fairness history', function () {
+    [$queue, $attendant] = callNextQueue();
+    // Three priority calls made via priority_only mode.
+    foreach (['2026-01-01 10:00:00', '2026-01-01 10:01:00', '2026-01-01 10:02:00'] as $at) {
+        $t = waitingTicket($queue, 10, $at);
+        (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+        expect($t->fresh()->status)->toBe(TicketStatus::Called);
+    }
+    $normal = waitingTicket($queue, 0, '2026-01-01 10:03:00');
+    $priority = waitingTicket($queue, 10, '2026-01-01 10:04:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($normal->id);
+    expect($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('ignores fairness in priority_only and normal_only modes', function () {
+    [$queue, $attendant] = callNextQueue();
+    calledTicket($queue, 10, '2026-01-01 10:00:00');
+    calledTicket($queue, 10, '2026-01-01 10:01:00');
+    calledTicket($queue, 10, '2026-01-01 10:02:00');
+    $normal = waitingTicket($queue, 0, '2026-01-01 10:03:00');
+    $priority = waitingTicket($queue, 10, '2026-01-01 10:04:00');
+
+    expect((new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly)->id)->toBe($priority->id);
+    expect((new CallNextTicket)($queue, $attendant, CallMode::NormalOnly)->id)->toBe($normal->id);
+});
+
+it('keeps calling priority when no normal is waiting despite the streak', function () {
+    [$queue, $attendant] = callNextQueue();
+    calledTicket($queue, 10, '2026-01-01 10:00:00');
+    calledTicket($queue, 10, '2026-01-01 10:01:00');
+    calledTicket($queue, 10, '2026-01-01 10:02:00');
+    $priority = waitingTicket($queue, 10, '2026-01-01 10:03:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($priority->id);
+});
+
+it('does not trigger fairness with fewer than 3 called tickets', function () {
+    [$queue, $attendant] = callNextQueue();
+    calledTicket($queue, 10, '2026-01-01 10:00:00');
+    calledTicket($queue, 10, '2026-01-01 10:01:00');
+    $normal = waitingTicket($queue, 0, '2026-01-01 10:03:00');
+    $priority = waitingTicket($queue, 10, '2026-01-01 10:04:00');
+
+    expect((new CallNextTicket)($queue, $attendant)->id)->toBe($priority->id);
+    expect($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('rejects calling from an inactive queue and changes nothing', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => false]);
+    waitingTicket($queue, 0);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->where('status', TicketStatus::Waiting)->count())->toBe(1);
+});
+
+it('rejects a stale active instance after deactivation', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+    $ticket = waitingTicket($queue, 0);
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('marks the winner called with caller and timestamp and returns it updated', function () {
+    [$queue, $attendant] = callNextQueue();
+    $ticket = (new IssueTicket)($queue, 3);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->id)->toBe($ticket->id)
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_by_user_id)->toBe($attendant->id)
+        ->and($called->called_at)->not->toBeNull()
+        ->and($called->queue_id)->toBe($queue->id)
+        ->and($called->priority)->toBe(3);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Called)
+        ->and($fresh->called_by_user_id)->toBe($attendant->id)
+        ->and($fresh->called_at)->not->toBeNull();
+});
