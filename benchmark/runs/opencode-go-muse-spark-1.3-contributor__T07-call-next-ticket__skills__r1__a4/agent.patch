+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read the queue state from the database (the passed instance may
+            // be stale) and serialize concurrent callers/issuers on the row.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $restrictToNormal = false;
+
+            if ($mode === CallMode::Any && $this->priorityStreakReached($lockedQueue->id)) {
+                $restrictToNormal = Ticket::query()
+                    ->where('queue_id', $lockedQueue->id)
+                    ->where('status', TicketStatus::Waiting)
+                    ->where('priority', 0)
+                    ->exists();
+            }
+
+            $candidateIds = $this->orderedCandidateIds($lockedQueue->id, $mode, $restrictToNormal);
+
+            // Exactly-once: the queue lock does not stop Ticket::call(), which
+            // locks only the ticket row, so re-check each candidate under its
+            // own row lock and skip it if it was called concurrently.
+            foreach ($candidateIds as $candidateId) {
+                $ticket = Ticket::query()
+                    ->whereKey($candidateId)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null) {
+                    continue;
+                }
+
+                if ($ticket->status !== TicketStatus::Waiting) {
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket->refresh();
+            }
+
+            throw new NoWaitingTicketsException('No waiting tickets are eligible for the requested mode.');
+        });
+    }
+
+    /**
+     * Whether the last 3 called tickets in the queue are all priority ones.
+     *
+     * Calls made in any mode count: a normal call inside the last 3 breaks
+     * the streak. History is ordered most-recent-first by called_at, then id.
+     */
+    private function priorityStreakReached(int $queueId): bool
+    {
+        $lastThree = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->get();
+
+        if ($lastThree->count() !== 3) {
+            return false;
+        }
+
+        return $lastThree->every(fn (Ticket $ticket): bool => $ticket->priority > 0);
+    }
+
+    /**
+     * @return Collection<int, int>
+     */
+    private function orderedCandidateIds(int $queueId, CallMode $mode, bool $restrictToNormal): Collection
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting);
+
+        if ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0);
+        } elseif ($mode === CallMode::NormalOnly || $restrictToNormal) {
+            $query->where('priority', 0);
+        }
+
+        if ($mode === CallMode::NormalOnly || $restrictToNormal) {
+            // All candidates share priority 0; oldest first.
+            $query->orderBy('issued_at')->orderBy('id');
+        } else {
+            $query->orderByDesc('priority')->orderBy('issued_at')->orderBy('id');
+        }
+
+        return $query->pluck('id');
+    }
+}
