+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Route;
+use Symfony\Component\HttpFoundation\Response;
+
+class CurrentEntity
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $entityId = session('current_entity_id');
+        if (!$entityId) {
+            // No session: redirect to onboarding or switcher
+            $user = Auth::user();
+            if (!$user) {
+                return redirect()->route('login');
+            }
+            $count = $user->memberships()->count();
+            if ($count === 0) {
+                return redirect()->route('onboarding');
+            }
+            if ($count === 1) {
+                $membership = $user->memberships()->first();
+                session(['current_entity_id' => $membership->entity_id]);
+            } else {
+                return redirect()->route('entity.switcher');
+            }
+        }
+        // Validate membership for the requested entity
+        $entity = Route::current()->parameter('entity');
+        if ($entity && $entity->id !== session('current_entity_id')) {
+            abort(403);
+        }
+        return $next($request);
+    }
+}
