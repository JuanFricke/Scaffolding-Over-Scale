+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Illuminate\Support\Facades\DB;
+use Livewire\Component;
+use Livewire\WithValidation;
+
+class CreateEntity extends Component
+{
+    use WithValidation;
+
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->validate(['name' => 'required|string']);
+
+        $slug = $this->uniqueSlug($this->name);
+
+        DB::transaction(function () use ($slug) {
+            $entity = Entity::create(['name' => $this->name, 'slug' => $slug]);
+            EntityMembership::create([
+                'entity_id' => $entity->id,
+                'user_id' => auth()->id(),
+                'role' => UserRole::Owner->value,
+            ]);
+
+            Log::channel('audit')->info('Entity created', ['entity_id' => $entity->id, 'actor_id' => auth()->id()]);
+
+            session(['current_entity_id' => $entity->id]);
+        });
+
+        return redirect()->route('entity.dashboard', $slug);
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        $slug = Str::slug($name);
+        $original = $slug;
+        $count = 2;
+        while (Entity::where('slug', $slug)->exists()) {
+            $slug = $original . '-' . $count++;
+        }
+        return $slug;
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.create-entity');
+    }
+}
