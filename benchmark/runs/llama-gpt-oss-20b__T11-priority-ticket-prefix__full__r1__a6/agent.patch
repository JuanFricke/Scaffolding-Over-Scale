+    public static function nextCodeWithPriorityAndDate(int $queueId, int $priority, string $issueDate): string
+    {
+        $queue = Queue::findOrFail($queueId);
+        $prefix = $queue->prefixForPriority($priority);
+        $codes = self::query()
+            ->where('queue_id', $queueId)
+            ->where('issue_date', $issueDate)
+            ->where('code', 'like', $prefix . '%')
+            ->orderByDesc('id')
+            ->pluck('code');
+        foreach ($codes as $code) {
+            if (preg_match('/^' . preg_quote($prefix, '/') . '(\\d+)$/', $code, $m)) {
+                return $prefix . str_pad((string)((int)$m[1] + 1), 3, '0', STR_PAD_LEFT);
+            }
+        }
+        return $prefix . '001';
+    }
+
