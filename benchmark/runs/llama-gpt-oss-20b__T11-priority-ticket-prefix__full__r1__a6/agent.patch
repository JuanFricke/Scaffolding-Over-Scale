     }
 
+    public const DEFAULT_PREFIX_MAP = [0 => 'N', 10 => 'P', 20 => 'E'];
+
+    public function prefixForPriority(int $priority): string
+    {
+        // Custom map wins
+        $custom = $this->priority_prefix_map ?? [];
+        if (array_key_exists((string) $priority, $custom)) {
+            return $custom[(string) $priority];
+        }
+
+        // Default fallback logic
+        if ($priority <= 0) {
+            return 'N';
+        }
+        if ($priority >= 20) {
+            return 'E';
+        }
+        return 'P';
+    }
