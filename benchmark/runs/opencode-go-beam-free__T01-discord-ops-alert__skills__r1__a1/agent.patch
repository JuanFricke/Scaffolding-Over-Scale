diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..3928ba0
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,113 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+class DiscordOpsAlert
+{
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (empty($url)) {
+            return;
+        }
+
+        $text = $this->buildText($title, $message, $context);
+        $text = mb_substr($text, 0, 1800, 'UTF-8');
+
+        try {
+            $response = Http::timeout(3)->post($url, ['content' => $text]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (\Throwable $e) {
+            $scrubbed = str_replace($url, '[redacted]', $e->getMessage());
+
+            Log::error('Discord ops alert failed', ['exception' => $scrubbed]);
+        }
+    }
+
+    private function buildText(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->formatValue($key, $value);
+        }
+
+        return implode("\n", $lines);
+    }
+
+    private function formatValue(mixed $key, mixed $value): string
+    {
+        if ($this->isSensitiveKey((string) $key)) {
+            return '[redacted]';
+        }
+
+        if (is_string($value) && preg_match('/Bearer\s+\S+/i', $value)) {
+            return '[redacted]';
+        }
+
+        if (is_array($value)) {
+            $redacted = $this->redactArray($value);
+
+            return (string) json_encode($redacted);
+        }
+
+        if (is_bool($value)) {
+            return $value ? 'true' : 'false';
+        }
+
+        if (is_null($value)) {
+            return '';
+        }
+
+        return (string) $value;
+    }
+
+    private function isSensitiveKey(string $key): bool
+    {
+        $normalized = strtolower(str_replace(['-', ' '], '_', $key));
+
+        foreach (['password', 'token', 'secret', 'authorization', 'api_key', 'apikey', 'webhook'] as $needle) {
+            if (str_contains($normalized, $needle)) {
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function redactArray(array $array): array
+    {
+        $result = [];
+
+        foreach ($array as $key => $value) {
+            if ($this->isSensitiveKey((string) $key)) {
+                $result[$key] = '[redacted]';
+
+                continue;
+            }
+
+            if (is_string($value) && preg_match('/Bearer\s+\S+/i', $value)) {
+                $result[$key] = '[redacted]';
+
+                continue;
+            }
+
+            if (is_array($value)) {
+                $result[$key] = $this->redactArray($value);
+
+                continue;
+            }
+
+            $result[$key] = $value;
+        }
+
+        return $result;
+    }
+}
