+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function memberQueue(User $user): Queue
+{
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return Queue::factory()->for($entity)->create(['is_active' => true]);
+}
+
+function waitingTicket(Queue $queue, int $priority = 0, ?DateTimeInterface $issuedAt = null): Ticket
+{
+    return Ticket::factory()->for($queue)->create([
+        'priority' => $priority,
+        'issued_at' => $issuedAt ?? now()->subMinutes(10),
+    ]);
+}
+
+function calledTicket(Queue $queue, User $by, int $priority, DateTimeInterface $calledAt): Ticket
+{
+    return Ticket::factory()->for($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'issued_at' => now()->subHour(),
+        'called_at' => $calledAt,
+        'called_by_user_id' => $by->id,
+    ]);
+}
+
+it('calls the highest priority first', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $normal = waitingTicket($queue, 0, now()->subMinutes(30));
+    $priority = waitingTicket($queue, 10, now()->subMinutes(5));
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($priority))->toBeTrue();
+    expect($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls the oldest issued ticket among equal priorities', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $newer = waitingTicket($queue, 10, now()->subMinutes(2));
+    $older = waitingTicket($queue, 10, now()->subMinutes(8));
+
+    expect((new CallNextTicket)($queue, $user)->is($older))->toBeTrue();
+    expect((new CallNextTicket)($queue, $user)->is($newer))->toBeTrue();
+});
+
+it('breaks issued_at ties by lowest id', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $issuedAt = now()->subMinutes(5);
+
+    $first = waitingTicket($queue, 0, $issuedAt);
+    $second = waitingTicket($queue, 0, $issuedAt);
+
+    expect($first->id)->toBeLessThan($second->id);
+    expect((new CallNextTicket)($queue, $user)->is($first))->toBeTrue();
+});
+
+it('marks the called ticket and returns its updated state', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = waitingTicket($queue, 10);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called)
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($user->id)
+        ->called_at->not->toBeNull()
+        ->code->toBe($ticket->code)
+        ->priority->toBe(10);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($user->id)
+        ->called_at->not->toBeNull()
+        ->issued_at->toEqual($ticket->issued_at);
+});
+
+it('never calls tickets of another queue', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $other = Queue::factory()->create(['is_active' => true]);
+    $otherTicket = waitingTicket($other, 20, now()->subDay());
+    $ownTicket = waitingTicket($queue, 0);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($ownTicket))->toBeTrue();
+    expect($otherTicket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('never calls an already called ticket again', function () {
+    $user = User::factory()->create();
+    $queue = memberQueue($user);
+    $ticket = waitingTicket($queue, 10);
+    $ticket->call($user);
+    $next = waitingTicket($queue, 0);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($next))->toBeTrue();
+    expect($ticket->fresh()->called_at)->not->toBeNull();
+});
+
+it('rejects an empty queue without changing anything', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    expect(fn () => (new CallNextTicket)($queue, $user))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('calls only priority tickets in priority_only mode', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicket($queue, 0, now()->subHour());
+    $priority = waitingTicket($queue, 10, now()->subMinutes(5));
+
+    $called = (new CallNextTicket)($queue, $user, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('rejects priority_only when only normal tickets wait', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $normal = waitingTicket($queue, 0);
+
+    expect(fn () => (new CallNextTicket)($queue, $user, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls only normal tickets, oldest first, in normal_only mode', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicket($queue, 20, now()->subHour());
+    $newerNormal = waitingTicket($queue, 0, now()->subMinutes(2));
+    $olderNormal = waitingTicket($queue, 0, now()->subMinutes(9));
+
+    expect((new CallNextTicket)($queue, $user, CallMode::NormalOnly)->is($olderNormal))->toBeTrue();
+    expect((new CallNextTicket)($queue, $user, CallMode::NormalOnly)->is($newerNormal))->toBeTrue();
+});
+
+it('rejects normal_only when only priority tickets wait', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $priority = waitingTicket($queue, 10);
+
+    expect(fn () => (new CallNextTicket)($queue, $user, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('forces a waiting normal ticket after three consecutive priority calls', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicket($queue, $user, 10, now()->subMinutes(3));
+    calledTicket($queue, $user, 10, now()->subMinutes(2));
+    calledTicket($queue, $user, 10, now()->subMinutes(1));
+    $priority = waitingTicket($queue, 10, now()->subMinutes(20));
+    $normal = waitingTicket($queue, 0, now()->subMinutes(15));
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($normal))->toBeTrue();
+    expect($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('keeps calling priority tickets when no normal ticket waits', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicket($queue, $user, 10, now()->subMinutes(3));
+    calledTicket($queue, $user, 10, now()->subMinutes(2));
+    calledTicket($queue, $user, 10, now()->subMinutes(1));
+    $priority = waitingTicket($queue, 10);
+
+    expect((new CallNextTicket)($queue, $user)->is($priority))->toBeTrue();
+});
+
+it('does not force a normal ticket when a normal call is among the last three', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicket($queue, $user, 10, now()->subMinutes(3));
+    calledTicket($queue, $user, 0, now()->subMinutes(2));
+    calledTicket($queue, $user, 10, now()->subMinutes(1));
+    $priority = waitingTicket($queue, 10);
+    waitingTicket($queue, 0, now()->subMinutes(30));
+
+    expect((new CallNextTicket)($queue, $user)->is($priority))->toBeTrue();
+});
+
+it('does not apply fairness with fewer than three calls in history', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicket($queue, $user, 10, now()->subMinutes(2));
+    calledTicket($queue, $user, 10, now()->subMinutes(1));
+    $priority = waitingTicket($queue, 10);
+    waitingTicket($queue, 0, now()->subMinutes(30));
+
+    expect((new CallNextTicket)($queue, $user)->is($priority))->toBeTrue();
+});
+
+it('resets the priority streak after a normal call', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $normal = waitingTicket($queue, 0, now()->subMinutes(30));
+    $priority = waitingTicket($queue, 10, now()->subMinutes(20));
+
+    // Three priority calls, then a normal call; the streak starts over.
+    calledTicket($queue, $user, 10, now()->subMinutes(5));
+    calledTicket($queue, $user, 10, now()->subMinutes(4));
+    calledTicket($queue, $user, 0, now()->subMinutes(3));
+    calledTicket($queue, $user, 10, now()->subMinutes(2));
+
+    expect((new CallNextTicket)($queue, $user)->is($priority))->toBeTrue();
+    expect($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('counts priority_only calls in the fairness history', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicket($queue, 10, now()->subMinutes(40));
+    waitingTicket($queue, 10, now()->subMinutes(30));
+    waitingTicket($queue, 10, now()->subMinutes(20));
+    $normal = waitingTicket($queue, 0, now()->subMinutes(60));
+
+    foreach (range(1, 3) as $_) {
+        (new CallNextTicket)($queue, $user, CallMode::PriorityOnly);
+    }
+
+    expect((new CallNextTicket)($queue, $user)->is($normal))->toBeTrue();
+});
+
+it('ignores fairness in priority_only mode', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicket($queue, $user, 10, now()->subMinutes(3));
+    calledTicket($queue, $user, 10, now()->subMinutes(2));
+    calledTicket($queue, $user, 10, now()->subMinutes(1));
+    $priority = waitingTicket($queue, 10);
+    waitingTicket($queue, 0, now()->subMinutes(30));
+
+    expect((new CallNextTicket)($queue, $user, CallMode::PriorityOnly)->is($priority))->toBeTrue();
+});
+
+it('rejects a call into an inactive queue and changes nothing', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $ticket = waitingTicket($queue, 10);
+
+    expect(fn () => (new CallNextTicket)($queue, $user))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+    expect($ticket->fresh()->called_by_user_id)->toBeNull();
+});
+
+it('reads queue state from the database rather than the passed instance', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+    waitingTicket($queue, 10);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $user))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->where('status', TicketStatus::Called)->count())->toBe(0);
+});
+
+it('skips tickets already called elsewhere and calls the next eligible one', function () {
+    $user = User::factory()->create();
+    $queue = memberQueue($user);
+    $first = waitingTicket($queue, 10, now()->subMinutes(30));
