+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * A normal ticket may not wait behind more than this many consecutive
+     * priority calls.
+     */
+    private const MAX_CONSECUTIVE_PRIORITY_CALLS = 3;
+
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Queue-row lock serializes calls on this queue. Read is_active from the
+            // locked row: the passed instance may be stale.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $normalOnly = $mode === CallMode::Any && $this->fairnessApplies($lockedQueue->id);
+            $skippedIds = [];
+
+            while (true) {
+                $candidate = $this->nextCandidate($lockedQueue->id, $mode, $normalOnly, $skippedIds);
+
+                if ($candidate === null) {
+                    if ($normalOnly) {
+                        // Concurrent calls drained the waiting normals, so the fairness
+                        // rule no longer applies. Retry with the full ordering.
+                        $normalOnly = false;
+
+                        continue;
+                    }
+
+                    throw new NoWaitingTicketsException(sprintf(
+                        'No waiting ticket is eligible in mode [%s] for queue [%d].',
+                        $mode->value,
+                        $lockedQueue->id,
+                    ));
+                }
+
+                // ticket::call() does not take the queue lock, so re-check the candidate
+                // under its own row lock. If it was called meanwhile, skip it.
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    $skippedIds[] = $candidate->id;
+
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+        });
+    }
+
+    /**
+     * @param  list<int>  $skippedIds
+     */
+    private function nextCandidate(int $queueId, CallMode $mode, bool $normalOnly, array $skippedIds): ?Ticket
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->whereNotIn('id', $skippedIds)
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+
+        if ($normalOnly || $mode === CallMode::NormalOnly) {
+            $query->where('priority', 0);
+        } elseif ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0);
+        }
+
+        return $query->first();
+    }
+
+    /**
+     * Fairness: the last N called tickets are all priority and a normal ticket is waiting.
+     *
+     * History is every called ticket in the queue, whatever mode made the call.
+     */
+    private function fairnessApplies(int $queueId): bool
+    {
+        $recentCalls = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::MAX_CONSECUTIVE_PRIORITY_CALLS)
+            ->get(['priority']);
+
+        if ($recentCalls->count() < self::MAX_CONSECUTIVE_PRIORITY_CALLS) {
+            return false;
+        }
+
+        if (! $recentCalls->every(fn (Ticket $ticket): bool => $ticket->priority > 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
