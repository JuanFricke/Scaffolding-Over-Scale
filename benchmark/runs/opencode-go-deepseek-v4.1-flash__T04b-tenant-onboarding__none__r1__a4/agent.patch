+test('picking an entity sets session, logs and redirects; non members get 403', function () {
+    Log::shouldReceive('channel')->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once();
+
+    $user = User::factory()->create();
+    $own = EntityMembership::factory()->owner()->create(['user_id' => $user->id])->entity;
+    $other = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $other->id])
+        ->post(route('entity.pick', $own))
+        ->assertSessionHas('current_entity_id', $own->id)
+        ->assertRedirect(route('entity.dashboard', $own));
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $own->id])
+        ->post(route('entity.pick', $other))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $own->id);
+});
