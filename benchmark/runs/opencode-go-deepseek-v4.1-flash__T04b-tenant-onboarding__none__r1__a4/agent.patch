@@ -0,0 +1,64 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Tenancy\TenantContext;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class CurrentEntity
+{
+    /**
+     * Resolve the entity stored in the session into the request tenant context.
+     */
+    public function handle(Request $request, Closure $next): Response
+    {
+        $context = app(TenantContext::class);
+        $context->forget();
+        $request->attributes->remove('current_entity');
+        $request->attributes->remove('tenant');
+
+        $user = $request->user();
+
+        if (! $user) {
+            return redirect()->route('login');
+        }
+
+        $memberships = $user->memberships()->get();
+        $entityId = $request->session()->get('current_entity_id');
+
+        if ($entityId === null || $entityId === '') {
+            if ($memberships->isEmpty()) {
+                return redirect()->route('onboarding');
+            }
+
+            if ($memberships->count() === 1) {
+                $entityId = $memberships->first()->entity_id;
+                $request->session()->put('current_entity_id', $entityId);
+            } else {
+                return redirect()->route('entity.switcher');
+            }
+        }
+
+        $membership = $memberships->first(
+            fn ($membership) => (int) $membership->entity_id === (int) $entityId,
+        );
+
+        if (! $membership) {
+            abort(403);
+        }
+
+        $entity = $membership->entity;
+
+        if (! $entity) {
+            abort(404);
+        }
+
+        $context->set($entity);
+        $request->attributes->set('current_entity', $entity);
+        $request->attributes->set('tenant', $entity);
+
+        return $next($request);
+    }
+}
diff --git a/app/Livewire/Entity/CreateEntity.php b/app/Livewire/Entity/CreateEntity.php
new file mode 100644
index 0000000..8dae372
--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,106 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+class CreateEntity extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $validated = $this->validate();
+        $user = auth()->user();
+
+        abort_unless($user, 403);
+
+        $entity = null;
+        $attempt = 0;
+
+        while ($entity === null) {
+            $attempt++;
+
+            // Keep this inside the loop: a concurrent insert may claim the slug
+            // after our check but before the insert below.
+            $slug = $this->uniqueSlug($validated['name']);
+
+            try {
+                $entity = DB::transaction(function () use ($validated, $slug, $user) {
+                    $entity = Entity::create([
+                        'name' => $validated['name'],
+                        'slug' => $slug,
+                    ]);
+
+                    $entity->memberships()->create([
+                        'user_id' => $user->id,
+                        'role' => UserRole::Owner,
+                    ]);
+
+                    return $entity;
+                });
+            } catch (QueryException $exception) {
+                if (! $this->isSlugCollision($exception) || $attempt >= 10) {
+                    throw $exception;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirect(route('entity.dashboard', ['entity' => $entity]));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')
+            ->layout('layouts::default-page', [
+                'title' => __('ui.onboarding_title'),
+            ]);
+    }
+
+    /**
+     * Build the next available slug for the given name.
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name) ?: 'entity';
+        $slug = $base;
+        $suffix = 2;
+
+        while (Entity::withTrashed()->where('slug', $slug)->exists()) {
+            $slug = $base.'-'.$suffix;
+            $suffix++;
+        }
+
+        return $slug;
+    }
+
+    private function isSlugCollision(QueryException $exception): bool
+    {
+        $message = strtolower($exception->getMessage());
+        $sqlState = (string) ($exception->errorInfo[0] ?? '');
+
+        return in_array($sqlState, ['23000', '23505'], true)
+            || ($exception->errorInfo[1] ?? null) === 1062
+            || str_contains($message, 'unique')
+            || str_contains($message, 'duplicate')
+            || str_contains($message, 'integrity constraint')
+            || str_contains($message, 'entities.slug')
+            || str_contains($message, 'entities_slug_unique');
+    }
+}
