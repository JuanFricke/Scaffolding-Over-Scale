+test('navbar switcher link only appears for multiple memberships', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->owner()->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $membership->entity_id])
+        ->get(route('entity.dashboard', $membership->entity))
+        ->assertDontSee(route('entity.switcher'));
+
+    EntityMembership::factory()->employee()->create(['user_id' => $user->id]);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $membership->entity_id])
+        ->get(route('entity.dashboard', $membership->entity))
+        ->assertSee(route('entity.switcher'));
+});
