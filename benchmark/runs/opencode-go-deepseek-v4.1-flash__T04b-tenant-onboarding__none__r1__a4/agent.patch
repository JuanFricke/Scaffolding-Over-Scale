+<?php
+
+namespace App\Tenancy;
+
+use App\Models\Entity;
+
+/**
+ * Per-request tenant resolved by the current_entity middleware.
+ *
+ * Only HTTP middleware writes to it; the rest of the request (policies,
+ * queries, views) can read the active entity without touching the session.
+ */
+class TenantContext
+{
+    private ?Entity $entity = null;
+
+    public function set(?Entity $entity): void
+    {
+        $this->entity = $entity;
+    }
+
+    public function get(): ?Entity
+    {
+        return $this->entity;
+    }
+
+    public function entity(): ?Entity
+    {
+        return $this->entity;
+    }
+
+    public function id(): ?int
+    {
+        return $this->entity?->id;
+    }
+
+    public function has(): bool
+    {
+        return $this->entity !== null;
+    }
+
+    public function forget(): void
+    {
+        $this->entity = null;
+    }
+}
