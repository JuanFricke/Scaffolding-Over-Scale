+
+test('mentions the configured discord user on its own line at the end', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '12345678901234567',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Plan limit', 'Entity hit max queues', ['entity_id' => 42]);
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_ends_with($content, "\n<@12345678901234567>")
+            && str_contains($content, 'entity_id=42');
+    });
+});
+
+test('trims surrounding whitespace around a configured mention id', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => "  12345678901234567\t",
