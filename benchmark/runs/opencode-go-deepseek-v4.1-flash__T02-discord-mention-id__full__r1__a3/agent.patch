+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke');
+
+    Http::assertSent(fn (Request $request) => str_ends_with($request['content'] ?? '', "\n<@12345678901234567>"));
+});
+
+test('accepts an integer mention id', function () {
