diff --git a/tests/Feature/DiscordOpsAlertTest.php b/tests/Feature/DiscordOpsAlertTest.php
index 6a778a4..1fee6f1 100644
--- a/tests/Feature/DiscordOpsAlertTest.php
+++ b/tests/Feature/DiscordOpsAlertTest.php
@@ -121,3 +121,66 @@
             && ! str_contains(json_encode($log->context), $url);
     });
 });
+
+test('appends a mention of the configured discord user on its own line', function (string|int $id, string $expected) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $id]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke', ['queue' => 'default']);
+
+    Http::assertSent(fn (Request $request) => ($request['content'] ?? '') === "Ops alert\nSomething broke\nqueue=default\n<@{$expected}>");
+})->with([
+    'string' => ['123456789012345678', '123456789012345678'],
+    'trimmed' => ["  12345678901234567 \n", '12345678901234567'],
+    'twenty digits' => ['12345678901234567890', '12345678901234567890'],
+    'integer' => [123456789012345678, '123456789012345678'],
+]);
+
+test('omits the mention when the configured id is missing or invalid', function (mixed $id) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => $id]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Ops alert', 'Something broke');
+
+    Http::assertSent(fn (Request $request) => ($request['content'] ?? '') === "Ops alert\nSomething broke");
+})->with([
+    'null' => [null],
+    'empty' => [''],
+    'everyone' => ['@everyone'],
+    'here' => ['@here'],
+    'letters' => ['abc'],
+    'too short' => ['123'],
+    'too long' => ['123456789012345678901'],
+    'embedded newline' => ["123\n@everyone"],
+    'snowflake with newline injection' => ["123456789012345678\n@everyone"],
+    'closing bracket injection' => ["123> \n@everyone"],
+    'already wrapped' => ['<@123456789012345678>'],
+    'array' => [['123456789012345678']],
+]);
+
+test('keeps the mention when truncating long content to 1800 characters', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url, 'services.discord.mention_id' => '123456789012345678']);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('T', str_repeat('x', 2000));
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return mb_strlen($content) === 1800
+            && str_ends_with($content, "\n<@123456789012345678>")
+            && substr_count($content, '<@') === 1;
+    });
+});
