diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..0484c42 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -16,6 +16,8 @@
  *     ]);
  *
  * Unconfigured (empty DISCORD_WEBHOOK_URL) is a silent no-op.
+ * When DISCORD_MENTION_ID holds a valid Discord user ID (snowflake), every alert
+ * ends with a `<@id>` mention on its own line; invalid values are ignored.
  */
 class DiscordOpsAlert
 {
@@ -25,6 +27,8 @@ class DiscordOpsAlert
 
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
 
+    private const string SnowflakePattern = '/^[0-9]{17,20}$/D';
+
     /**
      * @param  array<string, mixed>  $context
      */
@@ -66,7 +70,34 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $mention = $this->mention();
+        $suffix = $mention === null ? '' : "\n".$mention;
+
+        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength - mb_strlen($suffix)).$suffix;
+    }
+
+    /**
+     * Discord mention for the configured on-call user, or null when unset/invalid.
+     */
+    private function mention(): ?string
+    {
+        $id = config('services.discord.mention_id');
+
+        if (is_int($id)) {
+            $id = (string) $id;
+        }
+
+        if (! is_string($id)) {
+            return null;
+        }
+
+        $id = trim($id);
+
+        if (! preg_match(self::SnowflakePattern, $id)) {
+            return null;
+        }
+
+        return '<@'.$id.'>';
     }
 
     private function safe(string $key, mixed $value): string
