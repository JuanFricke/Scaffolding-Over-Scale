+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read queue state from the database (it may be stale on the passed instance).
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $restrictToNormal = false;
+
+            if ($mode === CallMode::Any && $this->hasPriorityStreak($lockedQueue->id)) {
+                $restrictToNormal = Ticket::query()
+                    ->where('queue_id', $lockedQueue->id)
+                    ->where('status', TicketStatus::Waiting)
+                    ->where('priority', 0)
+                    ->exists();
+            }
+
+            /** @var list<int> $skipped */
+            $skipped = [];
+
+            while (true) {
+                $candidate = $this->nextCandidate($lockedQueue->id, $mode, $restrictToNormal, $skipped);
+
+                if ($candidate === null) {
+                    throw new NoWaitingTicketsException('No waiting tickets eligible for the requested mode.');
+                }
+
+                // Lock the candidate row and re-check it is still waiting: it may
+                // have been called concurrently through Ticket::call(), which does
+                // not lock the queue row.
+                $locked = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->firstOrFail();
+
+                if ($locked->status !== TicketStatus::Waiting
+                    || (int) $locked->queue_id !== (int) $lockedQueue->id
+                    || ! $this->matchesMode($locked, $mode, $restrictToNormal)
+                ) {
+                    $skipped[] = $candidate->id;
+
+                    continue;
+                }
+
+                $locked->status = TicketStatus::Called;
+                $locked->called_at = now();
+                $locked->called_by_user_id = $calledBy->id;
+                $locked->save();
+
+                return $locked->refresh();
+            }
+        });
+    }
+
+    private function hasPriorityStreak(int $queueId): bool
+    {
+        $lastThree = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->get();
+
+        if ($lastThree->count() !== 3) {
+            return false;
+        }
+
+        // History includes calls made in any mode; a normal call resets the streak.
+        return $lastThree->every(fn (Ticket $ticket): bool => $ticket->priority > 0);
+    }
+
+    /**
+     * @param  list<int>  $skipped
+     */
+    private function nextCandidate(int $queueId, CallMode $mode, bool $restrictToNormal, array $skipped): ?Ticket
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting);
+
+        if ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0);
+        } elseif ($mode === CallMode::NormalOnly || $restrictToNormal) {
+            $query->where('priority', 0);
+        }
+
+        if ($skipped !== []) {
+            $query->whereNotIn('id', $skipped);
+        }
+
+        if ($mode === CallMode::NormalOnly || $restrictToNormal) {
+            // All candidates share priority 0; oldest first.
+            $query->orderBy('issued_at')->orderBy('id');
+        } else {
+            $query->orderByDesc('priority')->orderBy('issued_at')->orderBy('id');
+        }
+
+        return $query->first();
+    }
+
+    private function matchesMode(Ticket $ticket, CallMode $mode, bool $restrictToNormal): bool
+    {
+        if ($mode === CallMode::PriorityOnly) {
+            return $ticket->priority > 0;
+        }
+
+        if ($mode === CallMode::NormalOnly || $restrictToNormal) {
+            return $ticket->priority === 0;
+        }
+
+        return true;
+    }
+}
