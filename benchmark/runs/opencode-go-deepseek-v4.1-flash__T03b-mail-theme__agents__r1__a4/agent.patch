+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the application uses the PegaFila brand and pt-BR locale for mail', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en')
+        ->and(config('mail.markdown.theme'))->toBe('pegafila');
+
+    $theme = resource_path('views/vendor/mail/html/themes/pegafila.css');
+
+    expect($theme)->toBeFile()
+        ->and(file_get_contents($theme))->toContain('#0f7490');
+});
+
+test('the password reset e-mail is translated and uses the PegaFila theme', function () {
+    $user = User::factory()->create();
+
+    $mail = (new ResetPassword('reset-token'))->toMail($user);
+
+    expect($mail->subject)->toBe('Redefina sua senha')
+        ->and($mail->actionText)->toBe('Redefinir senha')
+        ->and($mail->introLines[0])->toContain('Você recebeu esse e-mail');
+
+    $html = (string) $mail->render();
+
+    expect($html)->toContain('PegaFila')
+        ->and($html)->toContain('Olá!')
+        ->and($html)->toContain('Redefinir senha')
+        ->and($html)->toContain('Você recebeu esse e-mail')
+        ->and($html)->toContain('copie e cole a URL abaixo')
+        ->and($html)->not->toContain("If you're having trouble")
+        ->and($html)->toContain('#0f7490');
+});
+
+test('the e-mail verification message is translated and uses the PegaFila theme', function () {
+    $user = User::factory()->unverified()->create();
+
+    $mail = (new VerifyEmail)->toMail($user);
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($mail->actionText)->toBe('Verifique o endereço de e-mail');
+
+    $html = (string) $mail->render();
+
+    expect($html)->toContain('PegaFila')
+        ->and($html)->toContain('Olá!')
+        ->and($html)->toContain('Verifique o endereço de e-mail')
+        ->and($html)->toContain('#0f7490');
+});
