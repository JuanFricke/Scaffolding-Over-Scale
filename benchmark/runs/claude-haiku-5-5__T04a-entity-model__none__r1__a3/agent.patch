+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+function indexNamed(string $table, string $name): ?array
+{
+    foreach (Schema::getIndexes($table) as $index) {
+        if ($index['name'] === $name) {
+            return $index;
+        }
+    }
+
+    return null;
+}
+
+test('entity slugs are unique and the index has the agreed name', function () {
+    $index = indexNamed('entities', 'entities_slug_unique');
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['slug']);
+});
+
+test('a membership is unique per entity and user', function () {
+    $index = indexNamed('entity_memberships', 'entity_memberships_entity_user_unique');
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['entity_id', 'user_id']);
+
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(QueryException::class, 'entity_memberships.user_id');
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->create([
+        'entity_id' => $owner->entity_id,
+    ]))->toThrow(QueryException::class, 'entity_memberships.owner_seq');
+});
+
+test('the one-owner index is on entity and the generated owner_seq column', function () {
+    $index = indexNamed('entity_memberships', 'entity_memberships_one_owner');
+
+    expect($index)->not->toBeNull()
+        ->and($index['unique'])->toBeTrue()
+        ->and($index['columns'])->toBe(['entity_id', 'owner_seq']);
+});
+
+test('owner_seq is 1 for owners and null for every other role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+    $employee = EntityMembership::factory()->employee()->create();
+
+    expect(DB::table('entity_memberships')->whereIn('id', [$owner->id, $admin->id, $employee->id])
+        ->pluck('owner_seq', 'role')->all())
+        ->toBe(['owner' => 1, 'admin' => null, 'employee' => null]);
+});
+
+test('different entities may each have their own owner', function () {
+    EntityMembership::factory()->owner()->count(3)->create();
+
+    expect(EntityMembership::query()->owner()->count())->toBe(3);
+});
+
+test('any number of non-owner memberships may share an entity', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->count(2)->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(3)->create(['entity_id' => $entity->id]);
+
+    expect($entity->memberships()->count())->toBe(6);
+});
+
+test('memberships default to the employee role', function () {
+    $id = DB::table('entity_memberships')->insertGetId([
+        'entity_id' => Entity::factory()->create()->id,
+        'user_id' => User::factory()->create()->id,
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    expect(DB::table('entity_memberships')->where('id', $id)->value('role'))->toBe('employee');
+});
+
+test('deleting an entity permanently removes its memberships', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->count(2)->create(['entity_id' => $entity->id]);
+
+    $entity->forceDelete();
+
+    expect(EntityMembership::query()->where('entity_id', $entity->id)->count())->toBe(0);
+});
+
+test('deleting a user removes their memberships', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->forceDelete();
+
+    expect(EntityMembership::query()->find($membership->id))->toBeNull();
+});
+
+test('entities are soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    $entity->delete();
+
+    expect(Entity::query()->find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('entities are routed by slug', function () {
+    $entity = Entity::factory()->create(['slug' => 'padaria-central']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('padaria-central');
+});
+
+test('entity factory creates a named entity with a unique slug', function () {
+    $first = Entity::factory()->create();
+    $second = Entity::factory()->create();
+
+    expect($first->name)->not->toBeEmpty()
+        ->and($first->slug)->not->toBeEmpty()
+        ->and($second->slug)->not->toBe($first->slug);
+});
+
+test('membership factory creates its entity and user with the employee role by default', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->role)->toBe(UserRole::Employee);
+});
+
+test('membership factory states set the role', function () {
+    expect(EntityMembership::factory()->owner()->make()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->make()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->make()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner relation returns the owner membership or null', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->owner()->first())->toBeNull();
+
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+
+    expect($entity->owner()->first()->is($owner))->toBeTrue();
+});
+
+test('entity users are linked through memberships with their role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $employee = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    $users = $entity->users()->get();
+
+    expect($users)->toHaveCount(2)
+        ->and($users->firstWhere('id', $owner->user_id)->pivot->role)->toBe('owner')
+        ->and($users->firstWhere('id', $employee->user_id)->pivot->role)->toBe('employee');
+});
+
+test('user entities exclude soft deleted entities', function () {
+    $membership = EntityMembership::factory()->create();
+    $membership->entity->delete();
+
+    expect($membership->user->entities()->count())->toBe(0)
+        ->and($membership->user->memberships()->count())->toBe(1);
+});
+
+test('membershipFor finds the membership in an entity or returns null', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+    $user = $membership->user;
+
+    expect($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor(Entity::factory()->create()->id))->toBeNull();
+});
+
+test('membership relations resolve their entity and user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity->is(Entity::query()->find($membership->entity_id)))->toBeTrue()
+        ->and($membership->user->is(User::query()->find($membership->user_id)))->toBeTrue();
+});
+
+test('membership role scopes filter by role', function () {
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->admin()->count(2)->create();
+    EntityMembership::factory()->employee()->count(3)->create();
+
+    expect(EntityMembership::query()->owner()->count())->toBe(1)
+        ->and(EntityMembership::query()->admin()->count())->toBe(2)
+        ->and(EntityMembership::query()->employee()->count())->toBe(3);
+});
+
+test('the membership role is cast to the UserRole enum', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    expect($membership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('manageable roles are admin and employee only', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
