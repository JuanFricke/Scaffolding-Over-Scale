+<?php
+
+namespace App\Models;
+
+enum UserRole: string
+{
+    case Owner = 'owner';
+    case Admin = 'admin';
+    case Employee = 'employee';
+
+    /**
+     * Roles an owner or admin may assign. The owner is never manageable: it is only
+     * changed through an ownership transfer.
+     *
+     * @return array<int, self>
+     */
+    public static function manageable(): array
+    {
+        return [self::Admin, self::Employee];
+    }
+}
diff --git a/app/Policies/EntityMembershipPolicy.php b/app/Policies/EntityMembershipPolicy.php
new file mode 100644
index 0000000..753bed5
--- /dev/null
+++ b/app/Policies/EntityMembershipPolicy.php
@@ -0,0 +1,55 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $this->roleIn($user, $membership) !== null;
+    }
+
+    /**
+     * Owners and admins may assign roles, but never to the owner's membership: the owner
+     * role only changes through an ownership transfer.
+     */
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->isOwnerOrAdmin($user, $membership)
+            && in_array($membership->role, UserRole::manageable(), true);
+    }
+
+    /**
+     * The owner's membership is never deleted. Users may always remove their own
+     * membership, and owners and admins may remove other memberships.
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ($membership->user_id === $user->getKey()) {
+            return true;
+        }
+
+        return $this->isOwnerOrAdmin($user, $membership);
+    }
+
+    private function isOwnerOrAdmin(User $user, EntityMembership $membership): bool
+    {
+        return in_array($this->roleIn($user, $membership), [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    private function roleIn(User $user, EntityMembership $membership): ?UserRole
+    {
+        return $user->membershipFor($membership->entity_id)?->role;
+    }
+}
