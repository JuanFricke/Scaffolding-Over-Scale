+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array{entity: Entity, owner: User, admin: User, employee: User, outsider: User, ownerMembership: EntityMembership, adminMembership: EntityMembership, employeeMembership: EntityMembership}
+ */
+function entityWithStaff(): array
+{
+    $entity = Entity::factory()->create();
+
+    $ownerMembership = EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    $adminMembership = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    $employeeMembership = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    return [
+        'entity' => $entity,
+        'owner' => $ownerMembership->user,
+        'admin' => $adminMembership->user,
+        'employee' => $employeeMembership->user,
+        'outsider' => User::factory()->create(),
+        'ownerMembership' => $ownerMembership,
+        'adminMembership' => $adminMembership,
+        'employeeMembership' => $employeeMembership,
+    ];
+}
+
+describe('EntityPolicy', function () {
+    test('any authenticated user may create an entity', function () {
+        expect((new EntityPolicy)->create(User::factory()->create()))->toBeTrue();
+    });
+
+    test('any member may view the entity and non-members may not', function () {
+        ['entity' => $entity, 'owner' => $owner, 'admin' => $admin, 'employee' => $employee, 'outsider' => $outsider] = entityWithStaff();
+        $policy = new EntityPolicy;
+
+        expect($policy->view($owner, $entity))->toBeTrue()
+            ->and($policy->view($admin, $entity))->toBeTrue()
+            ->and($policy->view($employee, $entity))->toBeTrue()
+            ->and($policy->view($outsider, $entity))->toBeFalse();
+    });
+
+    test('owners and admins may update and delete the entity', function () {
+        ['entity' => $entity, 'owner' => $owner, 'admin' => $admin] = entityWithStaff();
+        $policy = new EntityPolicy;
+
+        expect($policy->update($owner, $entity))->toBeTrue()
+            ->and($policy->update($admin, $entity))->toBeTrue()
+            ->and($policy->delete($owner, $entity))->toBeTrue()
+            ->and($policy->delete($admin, $entity))->toBeTrue();
+    });
+
+    test('employees and non-members may not update or delete the entity', function () {
+        ['entity' => $entity, 'employee' => $employee, 'outsider' => $outsider] = entityWithStaff();
+        $policy = new EntityPolicy;
+
+        expect($policy->update($employee, $entity))->toBeFalse()
+            ->and($policy->delete($employee, $entity))->toBeFalse()
+            ->and($policy->update($outsider, $entity))->toBeFalse()
+            ->and($policy->delete($outsider, $entity))->toBeFalse();
+    });
+
+    test('only the owner may manage the entity settings', function () {
+        ['entity' => $entity, 'owner' => $owner, 'admin' => $admin, 'employee' => $employee, 'outsider' => $outsider] = entityWithStaff();
+        $policy = new EntityPolicy;
+
+        expect($policy->manageSettings($owner, $entity))->toBeTrue()
+            ->and($policy->manageSettings($admin, $entity))->toBeFalse()
+            ->and($policy->manageSettings($employee, $entity))->toBeFalse()
+            ->and($policy->manageSettings($outsider, $entity))->toBeFalse();
+    });
+
+    test('a user is only authorized through a membership of this entity', function () {
+        ['entity' => $entity, 'owner' => $owner] = entityWithStaff();
+        $otherEntity = Entity::factory()->create();
+        $policy = new EntityPolicy;
+
+        expect($policy->view($owner, $otherEntity))->toBeFalse()
+            ->and($policy->update($owner, $otherEntity))->toBeFalse()
+            ->and($policy->manageSettings($owner, $otherEntity))->toBeFalse();
+    });
+});
+
+test('policies are discovered for the entity models without registration', function () {
+    ['entity' => $entity, 'owner' => $owner, 'employee' => $employee, 'ownerMembership' => $ownerMembership, 'employeeMembership' => $employeeMembership] = entityWithStaff();
+
+    expect($owner->can('manageSettings', $entity))->toBeTrue()
+        ->and($employee->can('view', $entity))->toBeTrue()
+        ->and($employee->can('update', $entity))->toBeFalse()
+        ->and($employee->can('delete', $employeeMembership))->toBeTrue()
+        ->and($employee->can('delete', $ownerMembership))->toBeFalse();
+});
+
+describe('EntityMembershipPolicy', function () {
+    test('any member of the entity may view its memberships', function () {
+        ['ownerMembership' => $membership, 'employee' => $employee, 'outsider' => $outsider] = entityWithStaff();
+        $policy = new EntityMembershipPolicy;
+
+        expect($policy->view($employee, $membership))->toBeTrue()
+            ->and($policy->view($outsider, $membership))->toBeFalse();
+    });
+
+    test('owners and admins may assign roles to non-owner memberships', function () {
+        ['owner' => $owner, 'admin' => $admin, 'employeeMembership' => $employeeMembership, 'adminMembership' => $adminMembership] = entityWithStaff();
+        $policy = new EntityMembershipPolicy;
+
+        expect($policy->assignRole($owner, $employeeMembership))->toBeTrue()
+            ->and($policy->assignRole($admin, $employeeMembership))->toBeTrue()
+            ->and($policy->assignRole($owner, $adminMembership))->toBeTrue();
+    });
+
+    test('nobody may assign a role to the owner membership', function () {
+        ['owner' => $owner, 'admin' => $admin, 'ownerMembership' => $ownerMembership] = entityWithStaff();
+        $policy = new EntityMembershipPolicy;
+
+        expect($policy->assignRole($owner, $ownerMembership))->toBeFalse()
+            ->and($policy->assignRole($admin, $ownerMembership))->toBeFalse();
+    });
+
+    test('employees and outsiders may not assign roles', function () {
+        ['employee' => $employee, 'outsider' => $outsider, 'employeeMembership' => $employeeMembership] = entityWithStaff();
+        $policy = new EntityMembershipPolicy;
+
+        expect($policy->assignRole($employee, $employeeMembership))->toBeFalse()
+            ->and($policy->assignRole($outsider, $employeeMembership))->toBeFalse();
+    });
+
+    test('the owner membership is never deletable, not even by the owner', function () {
+        ['owner' => $owner, 'admin' => $admin, 'ownerMembership' => $ownerMembership] = entityWithStaff();
+        $policy = new EntityMembershipPolicy;
+
+        expect($policy->delete($owner, $ownerMembership))->toBeFalse()
+            ->and($policy->delete($admin, $ownerMembership))->toBeFalse();
+    });
+
+    test('any member may remove their own membership', function () {
+        ['admin' => $admin, 'employee' => $employee, 'adminMembership' => $adminMembership, 'employeeMembership' => $employeeMembership] = entityWithStaff();
+        $policy = new EntityMembershipPolicy;
+
+        expect($policy->delete($employee, $employeeMembership))->toBeTrue()
+            ->and($policy->delete($admin, $adminMembership))->toBeTrue();
+    });
+
+    test('owners and admins may remove other non-owner memberships', function () {
+        ['owner' => $owner, 'admin' => $admin, 'employeeMembership' => $employeeMembership, 'adminMembership' => $adminMembership] = entityWithStaff();
+        $policy = new EntityMembershipPolicy;
+
+        expect($policy->delete($owner, $employeeMembership))->toBeTrue()
+            ->and($policy->delete($admin, $employeeMembership))->toBeTrue()
+            ->and($policy->delete($owner, $adminMembership))->toBeTrue();
+    });
+
+    test('employees and outsiders may not remove other memberships', function () {
+        ['employee' => $employee, 'outsider' => $outsider, 'adminMembership' => $adminMembership] = entityWithStaff();
+        $policy = new EntityMembershipPolicy;
+
+        expect($policy->delete($employee, $adminMembership))->toBeFalse()
+            ->and($policy->delete($outsider, $adminMembership))->toBeFalse();
+    });
+
+    test('a manager of another entity may not remove this entity\'s memberships', function () {
+        ['employeeMembership' => $employeeMembership] = entityWithStaff();
+        $otherOwner = EntityMembership::factory()->owner()->create()->user;
+
+        expect((new EntityMembershipPolicy)->delete($otherOwner, $employeeMembership))->toBeFalse();
+    });
+});
diff --git a/tests/Feature/EntitySchemaTest.php b/tests/Feature/EntitySchemaTest.php
