+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityPolicy
+{
+    /**
+     * Any authenticated user may create an entity.
+     */
+    public function create(User $user): bool
+    {
+        return true;
+    }
+
+    /**
+     * Any member of the entity may view it.
+     */
+    public function view(User $user, Entity $entity): bool
+    {
+        return $this->roleIn($user, $entity) !== null;
+    }
+
+    /**
+     * Owners and admins may update the entity.
+     */
+    public function update(User $user, Entity $entity): bool
+    {
+        return $this->isOwnerOrAdmin($user, $entity);
+    }
+
+    /**
+     * Owners and admins may delete the entity.
+     */
+    public function delete(User $user, Entity $entity): bool
+    {
+        return $this->isOwnerOrAdmin($user, $entity);
+    }
+
+    /**
+     * Only the owner manages the entity's settings.
+     */
+    public function manageSettings(User $user, Entity $entity): bool
+    {
+        return $this->roleIn($user, $entity) === UserRole::Owner;
+    }
+
+    private function isOwnerOrAdmin(User $user, Entity $entity): bool
+    {
+        return in_array($this->roleIn($user, $entity), [UserRole::Owner, UserRole::Admin], true);
+    }
+
+    private function roleIn(User $user, Entity $entity): ?UserRole
+    {
+        return $user->membershipFor($entity->getKey())?->role;
+    }
+}
