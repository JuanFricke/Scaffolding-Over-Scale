+
+function accessFixture(): array
+{
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $manager = userWithRole($entity, UserRole::Admin);
+    $employee = userWithRole($entity, UserRole::Employee);
+
+    return [$entity, $queue, $manager, $employee, $employee->membershipFor($entity->id)];
+}
+
+it('grants call and lets the employee call tickets', function () {
+    [, $queue, $manager, $employee, $membership] = accessFixture();
+    (new IssueTicket)($queue);
+
+    expect(fn () => (new CallNextTicket)($queue, $employee))->toThrow(AuthorizationException::class);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+
+    $row = QueueAccess::query()->sole();
+    expect($row->permissions)->toBe(['call'])
+        ->and($row->entity_membership_id)->toBe($membership->id)
+        ->and($row->queue_id)->toBe($queue->id)
+        ->and((new CallNextTicket)($queue, $employee)->called_by_user_id)->toBe($employee->id);
+});
+
+it('upserts instead of duplicating and de-duplicates permissions', function () {
+    [, $queue, $manager, , $membership] = accessFixture();
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new SetQueueAccess)($membership, $queue, $manager, ['call', 'call']);
+
+    expect(QueueAccess::query()->count())->toBe(1)
+        ->and(QueueAccess::query()->sole()->permissions)->toBe(['call']);
