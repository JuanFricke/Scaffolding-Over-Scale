index 0000000..eb3b82c
--- /dev/null
+++ b/app/Actions/Concerns/NormalizesQueueFields.php
@@ -0,0 +1,58 @@
+<?php
+
+namespace App\Actions\Concerns;
+
+use App\Models\Queue;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+trait NormalizesQueueFields
+{
+    /**
+     * Trimmed name, 1-255 characters.
+     */
+    private function normalizeName(string $name): string
+    {
+        $name = trim($name);
+
+        if ($name === '' || mb_strlen($name) > 255) {
+            throw ValidationException::withMessages([
+                'name' => 'The name must be between 1 and 255 characters.',
+            ]);
+        }
+
+        return $name;
+    }
+
+    /**
+     * Slugified, non-empty slug of at most 255 characters.
+     */
+    private function normalizeSlug(string $slug): string
+    {
+        $slug = Str::slug($slug);
+
+        if ($slug === '' || strlen($slug) > 255) {
+            throw ValidationException::withMessages([
+                'slug' => 'The slug must be between 1 and 255 characters.',
+            ]);
+        }
+
+        return $slug;
+    }
+
+    private function slugTaken(int $entityId, string $slug, ?int $exceptQueueId = null): bool
+    {
+        return Queue::query()
+            ->where('entity_id', $entityId)
+            ->where('slug', $slug)
+            ->when($exceptQueueId !== null, fn ($query) => $query->whereKeyNot($exceptQueueId))
+            ->exists();
+    }
+
+    private function duplicateSlug(): ValidationException
+    {
+        return ValidationException::withMessages([
+            'slug' => 'The slug is already used by another queue in this entity.',
+        ]);
+    }
+}
