@@ -0,0 +1,92 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Set the permissions of a membership on a queue: a non-empty list
+     * upserts the grant, an empty list revokes it.
+     *
+     * @param  array<int|string, mixed>  $permissions
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        DB::transaction(function () use ($targetMembership, $queue, $actor, $permissions): void {
+            // Serializes concurrent grants on the same queue (no-op on SQLite).
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            Gate::forUser($actor)->authorize('manageAccess', $lockedQueue);
+
+            $permissions = $this->normalize($permissions);
+
+            $membership = EntityMembership::query()->findOrFail($targetMembership->id);
+
+            if ($membership->entity_id !== $lockedQueue->entity_id) {
+                throw ValidationException::withMessages([
+                    'membership' => 'The membership and the queue belong to different entities.',
+                ]);
+            }
+
+            $context = [
+                'actor_id' => $actor->id,
+                'queue_id' => $lockedQueue->id,
+                'entity_membership_id' => $membership->id,
+            ];
+
+            if ($permissions === []) {
+                $deleted = QueueAccess::query()
+                    ->where('entity_membership_id', $membership->id)
+                    ->where('queue_id', $lockedQueue->id)
+                    ->delete();
+
+                if ($deleted > 0) {
+                    Log::channel('audit')->info('queue.access.revoked', $context);
+                }
+
+                return;
+            }
+
+            QueueAccess::query()->updateOrCreate(
+                ['entity_membership_id' => $membership->id, 'queue_id' => $lockedQueue->id],
+                ['permissions' => $permissions],
+            );
+
+            Log::channel('audit')->info('queue.access.granted', $context + ['permissions' => $permissions]);
+        });
+    }
+
+    /**
+     * @param  array<int|string, mixed>  $permissions
+     * @return list<string>
+     */
+    private function normalize(array $permissions): array
+    {
+        foreach ($permissions as $permission) {
+            if (! is_string($permission) || QueuePermission::tryFrom($permission) === null) {
+                throw ValidationException::withMessages([
+                    'permissions' => 'Permissions must be a list of known permission names.',
+                ]);
+            }
+        }
+
+        return array_values(array_unique($permissions));
+    }
+}
