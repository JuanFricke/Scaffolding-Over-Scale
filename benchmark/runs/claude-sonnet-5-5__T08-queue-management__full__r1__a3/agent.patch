+++ b/tests/Feature/QueuePolicyTest.php
@@ -0,0 +1,87 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+it('lets only owners and admins create queues, update them and manage access', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $other = Entity::factory()->create();
+
+    foreach ([UserRole::Owner, UserRole::Admin] as $role) {
+        $user = userWithRole($entity, $role);
+
+        expect(Gate::forUser($user)->allows('create', [Queue::class, $entity]))->toBeTrue()
+            ->and(Gate::forUser($user)->allows('update', $queue))->toBeTrue()
+            ->and(Gate::forUser($user)->allows('manageAccess', $queue))->toBeTrue()
+            ->and(Gate::forUser($user)->allows('create', [Queue::class, $other]))->toBeFalse();
+    }
+
+    foreach ([userWithRole($entity, UserRole::Employee), userWithRole($other, UserRole::Owner), User::factory()->create()] as $user) {
+        expect(Gate::forUser($user)->allows('create', [Queue::class, $entity]))->toBeFalse()
+            ->and(Gate::forUser($user)->allows('update', $queue))->toBeFalse()
+            ->and(Gate::forUser($user)->allows('manageAccess', $queue))->toBeFalse();
+    }
+});
+
+it('lets managers call without a grant row', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(Gate::forUser(userWithRole($entity, UserRole::Owner))->allows('call', $queue))->toBeTrue()
+        ->and(Gate::forUser(userWithRole($entity, UserRole::Admin))->allows('call', $queue))->toBeTrue();
+});
+
+it('lets an employee call only on queues where they hold a call grant', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $otherQueue = Queue::factory()->for($entity)->create();
+    $employee = userWithRole($entity, UserRole::Employee);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+
+    QueueAccess::factory()->for($queue)->create([
+        'entity_membership_id' => $employee->membershipFor($entity->id)->id,
+    ]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('call', $otherQueue))->toBeFalse();
+});
+
+it('denies an employee whose grant has no call permission or a corrupted value', function (string $json) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    $employee = userWithRole($entity, UserRole::Employee);
+    $access = QueueAccess::factory()->for($queue)->create([
+        'entity_membership_id' => $employee->membershipFor($entity->id)->id,
+    ]);
+
+    DB::table('queue_access')->where('id', $access->id)->update(['permissions' => $json]);
+
+    expect(Gate::forUser($employee)->allows('call', $queue))->toBeFalse();
+})->with(['empty list' => '[]', 'other' => '["other"]', 'string' => '"call"', 'number' => '5', 'null' => 'null']);
+
+it('denies members and non-members of other entities calling', function () {
+    $queue = Queue::factory()->create();
+    $foreignOwner = userWithRole(Entity::factory()->create(), UserRole::Owner);
+
+    expect(Gate::forUser($foreignOwner)->allows('call', $queue))->toBeFalse()
+        ->and(Gate::forUser(User::factory()->create())->allows('call', $queue))->toBeFalse();
+});
+
+it('does not let a grant on one entity leak to a foreign membership', function () {
+    $queue = Queue::factory()->create();
+    $access = QueueAccess::factory()->for($queue)->create();
+    $foreign = userWithRole(Entity::factory()->create(), UserRole::Employee);
+
+    expect($access->membership->entity_id)->toBe($queue->entity_id)
+        ->and(Gate::forUser($foreign)->allows('call', $queue))->toBeFalse();
+});
