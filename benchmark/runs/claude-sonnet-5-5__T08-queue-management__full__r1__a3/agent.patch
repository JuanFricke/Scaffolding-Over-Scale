+<?php
+
+use App\Actions\CreateQueue;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('creates an active queue with a slug derived from the trimmed name', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+
+    $queue = (new CreateQueue)($entity, userWithRole($entity, $role), '  Atendimento Geral  ');
+
+    expect($queue)->toBeInstanceOf(Queue::class)
+        ->name->toBe('Atendimento Geral')
+        ->slug->toBe('atendimento-geral')
+        ->is_active->toBeTrue()
+        ->entity_id->toBe($entity->id)
+        ->and(Queue::query()->count())->toBe(1);
+})->with([UserRole::Owner, UserRole::Admin]);
+
+it('slugifies an explicit slug', function () {
+    $entity = Entity::factory()->create();
+
+    $queue = (new CreateQueue)($entity, userWithRole($entity, UserRole::Owner), 'Caixa', 'Caixa Rápido 1');
+
+    expect($queue->slug)->toBe('caixa-rapido-1');
+});
+
+it('rejects empty and overlong names or unusable slugs', function (string $name, ?string $slug) {
+    $entity = Entity::factory()->create();
+
+    expect(fn () => (new CreateQueue)($entity, userWithRole($entity, UserRole::Owner), $name, $slug))
+        ->toThrow(ValidationException::class);
+    expect(Queue::query()->count())->toBe(0);
+})->with([
+    'empty' => ['', null],
+    'blank' => ['   ', null],
+    'too long' => [str_repeat('a', 256), 'ok'],
+    'name without slug chars' => ['!!!', null],
+    'unusable explicit slug' => ['Ok', '???'],
+]);
+
+it('accepts a 255 character name', function () {
+    $entity = Entity::factory()->create();
+
+    $queue = (new CreateQueue)($entity, userWithRole($entity, UserRole::Owner), str_repeat('a', 255));
+
+    expect($queue->name)->toHaveLength(255);
+});
+
+it('rejects a duplicate slug within the entity but allows it in another', function () {
+    $entity = Entity::factory()->create();
+    $owner = userWithRole($entity, UserRole::Owner);
+    (new CreateQueue)($entity, $owner, 'Geral');
+
+    expect(fn () => (new CreateQueue)($entity, $owner, 'Outra', 'geral'))
+        ->toThrow(ValidationException::class);
+
+    $other = Entity::factory()->create();
+    $queue = (new CreateQueue)($other, userWithRole($other, UserRole::Owner), 'Geral');
+
+    expect($queue->slug)->toBe('geral')
+        ->and(Queue::query()->count())->toBe(2);
+});
+
+it('turns a unique index violation from a race into a ValidationException', function () {
+    $entity = Entity::factory()->create();
+    $owner = userWithRole($entity, UserRole::Owner);
+
+    // Simulate the race: the pre-check passes, then another writer inserts the slug.
+    Queue::creating(function (Queue $queue) use ($entity) {
+        static $once = true;
+        if ($once) {
+            $once = false;
+            Queue::query()->forceCreate(['entity_id' => $entity->id, 'name' => 'X', 'slug' => $queue->slug]);
+        }
+    });
+
+    expect(fn () => (new CreateQueue)($entity, $owner, 'Geral'))
+        ->toThrow(ValidationException::class);
+});
+
+it('rejects employees, foreign members and non-members and writes nothing', function () {
+    $entity = Entity::factory()->create();
+    $actors = [
+        userWithRole($entity, UserRole::Employee),
+        userWithRole(Entity::factory()->create(), UserRole::Owner),
+        User::factory()->create(),
+    ];
+
+    foreach ($actors as $actor) {
+        expect(fn () => (new CreateQueue)($entity, $actor, 'Geral'))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect(Queue::query()->count())->toBe(0);
+});
