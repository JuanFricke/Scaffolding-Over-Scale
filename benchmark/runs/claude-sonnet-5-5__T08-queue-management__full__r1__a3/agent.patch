@@ -0,0 +1,70 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\NormalizesQueueFields;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+class UpdateQueue
+{
+    use NormalizesQueueFields;
+
+    /**
+     * Rename, re-slug and/or (de)activate a queue; `null` leaves a field unchanged.
+     * Queues are never deleted — deactivation retires them and keeps their tickets.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        try {
+            $updated = DB::transaction(function () use ($queue, $actor, $name, $slug, $isActive): Queue {
+                // Same lock as IssueTicket/CallNextTicket so deactivation is serialized with them.
+                $locked = Queue::query()
+                    ->whereKey($queue->id)
+                    ->lockForUpdate()
+                    ->firstOrFail();
+
+                Gate::forUser($actor)->authorize('update', $locked);
+
+                if ($name !== null) {
+                    $locked->name = $this->normalizeName($name);
+                }
+
+                if ($slug !== null) {
+                    $slug = $this->normalizeSlug($slug);
+
+                    if ($this->slugTaken($locked->entity_id, $slug, $locked->id)) {
+                        throw $this->duplicateSlug();
+                    }
+
+                    $locked->slug = $slug;
+                }
+
+                if ($isActive !== null) {
+                    $locked->is_active = $isActive;
+                }
+
+                $locked->save();
+
+                return $locked;
+            });
+        } catch (QueryException $e) {
+            // Lost a race against another writer of the same slug.
+            if ($slug !== null && $this->slugTaken($queue->entity_id, $this->normalizeSlug($slug), $queue->id)) {
+                throw $this->duplicateSlug();
+            }
+
+            throw $e;
+        }
+
+        return $queue->setRawAttributes($updated->getAttributes(), true);
+    }
+}
