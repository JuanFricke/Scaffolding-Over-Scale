+
+it('rejects a membership and queue of different entities', function (array $permissions) {
+    [, $queue, $manager] = accessFixture();
+    $foreign = userWithRole(Entity::factory()->create(), UserRole::Employee);
+
+    expect(fn () => (new SetQueueAccess)(EntityMembership::query()->where('user_id', $foreign->id)->first(), $queue, $manager, $permissions))
+        ->toThrow(ValidationException::class);
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with([[['call']], [[]]]);
+
+it('rejects non-managers, including an employee granting themselves', function () {
+    [$entity, $queue, , $employee, $membership] = accessFixture();
+    $actors = [
+        $employee,
+        userWithRole(Entity::factory()->create(), UserRole::Owner),
+        User::factory()->create(),
