diff --git a/tests/Feature/UpdateQueueTest.php b/tests/Feature/UpdateQueueTest.php
new file mode 100644
index 0000000..61c0656
--- /dev/null
+++ b/tests/Feature/UpdateQueueTest.php
@@ -0,0 +1,103 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('renames a queue leaving the other fields unchanged', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old']);
+
+    $updated = (new UpdateQueue)($queue, userWithRole($entity, $role), name: '  New name ');
+
+    expect($updated)->name->toBe('New name')->slug->toBe('old')->is_active->toBeTrue()
+        ->and($queue->fresh())->name->toBe('New name')
+        ->and($queue->name)->toBe('New name');
+})->with([UserRole::Owner, UserRole::Admin]);
+
+it('changes the slug (slugified) and allows keeping its own slug', function () {
+    $entity = Entity::factory()->create();
+    $owner = userWithRole($entity, UserRole::Owner);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'old']);
+
+    expect((new UpdateQueue)($queue, $owner, slug: 'old')->slug)->toBe('old')
+        ->and((new UpdateQueue)($queue, $owner, slug: 'Novo Slug')->slug)->toBe('novo-slug');
+});
+
+it('rejects taking another queue slug in the entity but not across entities', function () {
+    $entity = Entity::factory()->create();
+    $owner = userWithRole($entity, UserRole::Owner);
+    $queue = Queue::factory()->for($entity)->create(['slug' => 'a']);
+    Queue::factory()->for($entity)->create(['slug' => 'b']);
+    Queue::factory()->create(['slug' => 'c']);
+
+    expect(fn () => (new UpdateQueue)($queue, $owner, slug: 'b'))->toThrow(ValidationException::class)
+        ->and($queue->fresh()->slug)->toBe('a')
+        ->and((new UpdateQueue)($queue, $owner, slug: 'c')->slug)->toBe('c');
+});
+
+it('rejects invalid names and slugs without changing anything', function (array $args) {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Keep', 'slug' => 'keep']);
+
+    expect(fn () => (new UpdateQueue)($queue, userWithRole($entity, UserRole::Owner), ...$args))
+        ->toThrow(ValidationException::class);
+    expect($queue->fresh())->name->toBe('Keep')->slug->toBe('keep');
+})->with([
+    'blank name' => [['name' => '  ']],
+    'long name' => [['name' => str_repeat('a', 256)]],
+    'empty slug' => [['slug' => '']],
+    'valid name invalid slug' => [['name' => 'Changed', 'isActive' => false, 'slug' => '!!!']],
+]);
+
+it('deactivates and reactivates preserving tickets and blocking issue and call', function () {
+    $entity = Entity::factory()->create();
+    $owner = userWithRole($entity, UserRole::Owner);
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = (new IssueTicket)($queue);
+
+    $updated = (new UpdateQueue)($queue, $owner, isActive: false);
+
+    expect($updated->is_active)->toBeFalse()
+        ->and($ticket->fresh()->status)->toBe(TicketStatus::Waiting)
+        ->and(fn () => (new IssueTicket)($queue))->toThrow(InactiveQueueException::class)
+        ->and(fn () => $ticket->call($owner))->toThrow(InactiveQueueException::class);
+
+    expect((new UpdateQueue)($queue, $owner, isActive: true)->is_active)->toBeTrue();
+});
+
+it('rejects employees, foreign members and non-members and writes nothing', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Keep', 'is_active' => true]);
+    $actors = [
+        userWithRole($entity, UserRole::Employee),
+        userWithRole(Entity::factory()->create(), UserRole::Owner),
+        User::factory()->create(),
+    ];
+
+    foreach ($actors as $actor) {
+        expect(fn () => (new UpdateQueue)($queue, $actor, name: 'Hacked', isActive: false))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect($queue->fresh())->name->toBe('Keep')->is_active->toBeTrue();
+});
+
+it('offers no way to delete a queue', function () {
+    $deleters = array_filter(
+        array_merge(glob(app_path('Actions/*.php')), glob(app_path('Actions/*/*.php'))),
+        fn ($path) => preg_match('/(Delete|Remove|Destroy)/i', basename($path)),
+    );
+
+    expect($deleters)->toBeEmpty();
+});
