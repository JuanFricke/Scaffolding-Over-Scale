@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Actions;
+
+use App\Actions\Concerns\NormalizesQueueFields;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+
+class CreateQueue
+{
+    use NormalizesQueueFields;
+
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $name = $this->normalizeName($name);
+        $slug = $this->normalizeSlug($slug ?? $name);
+
+        if ($this->slugTaken($entity->id, $slug)) {
+            throw $this->duplicateSlug();
+        }
+
+        try {
+            return Queue::query()->forceCreate([
+                'entity_id' => $entity->id,
+                'name' => $name,
+                'slug' => $slug,
+                'is_active' => true,
+            ])->refresh();
+        } catch (QueryException $e) {
+            // Lost a race against another writer of the same slug.
+            if ($this->slugTaken($entity->id, $slug)) {
+                throw $this->duplicateSlug();
+            }
+
+            throw $e;
+        }
+    }
+}
