+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('rejects unknown or non-string permissions and stores nothing', function (array $permissions) {
+    [, $queue, $manager, , $membership] = accessFixture();
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, $permissions))
+        ->toThrow(ValidationException::class);
+    expect(QueueAccess::query()->count())->toBe(0);
+})->with([
+    'unknown' => [['fly']],
+    'mixed' => [['call', 'fly']],
+    'integer' => [[1]],
+    'null' => [[null]],
+    'nested' => [[['call']]],
+    'case' => [['Call']],
+]);
+
+it('keeps the existing grant when an invalid update is rejected', function () {
+    [, $queue, $manager, , $membership] = accessFixture();
+    QueueAccess::factory()->for($queue)->create(['entity_membership_id' => $membership->id]);
+
+    expect(fn () => (new SetQueueAccess)($membership, $queue, $manager, ['fly']))
