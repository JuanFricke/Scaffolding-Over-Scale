+it('writes audit entries for grant and revoke only when something changed', function () {
+    [, $queue, $manager, , $membership] = accessFixture();
+    $audit = [];
+    Event::listen(MessageLogged::class, function (MessageLogged $log) use (&$audit) {
+        $audit[] = [$log->message, $log->context];
+    });
+
+    (new SetQueueAccess)($membership, $queue, $manager, []);
+    expect($audit)->toBe([]);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+    (new SetQueueAccess)($membership, $queue, $manager, []);
