+    $channel = Mockery::mock();
+    $channel->shouldReceive('info')->once()->with('queue.access.granted', Mockery::on(fn ($c) => $c['actor_id'] === $manager->id));
+    Log::shouldReceive('channel')->once()->with('audit')->andReturn($channel);
+
+    (new SetQueueAccess)($membership, $queue, $manager, ['call']);
+});
+
+it('cascades grants when the queue or membership is deleted', function () {
