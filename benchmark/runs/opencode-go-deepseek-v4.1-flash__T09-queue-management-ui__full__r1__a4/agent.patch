diff --git a/tests/Feature/Entity/QueuesTest.php b/tests/Feature/Entity/QueuesTest.php
new file mode 100644
index 0000000..dd9fee4
--- /dev/null
+++ b/tests/Feature/Entity/QueuesTest.php
@@ -0,0 +1,306 @@
+<?php
+
+use App\Enums\QueuePermission;
+use App\Livewire\Entity\Queues;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
+
+uses(RefreshDatabase::class);
+
+function makeQueueOwner(Entity $entity, ?User $user = null): User
+{
+    $user ??= User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->owner()->create();
+
+    return $user;
+}
+
+function actingQueueManager(User $user, Entity $entity): void
+{
+    test()->actingAs($user)->post(route('entity.pick', $entity->slug));
+}
+
+test('employees cannot open the queues page or mount the component', function () {
+    $entity = Entity::factory()->create();
+    makeQueueOwner($entity);
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    actingQueueManager($employee, $entity);
+
+    $this->get(route('entity.queues', $entity->slug))->assertForbidden();
+    Livewire::test(Queues::class, ['entity' => $entity])->assertForbidden();
+});
+
+test('managers can open the queues page in both languages', function () {
+    $entity = Entity::factory()->create(['name' => 'Acme']);
+    $owner = makeQueueOwner($entity);
+
+    actingQueueManager($owner, $entity);
+
+    $this->withHeaders(['Accept-Language' => 'pt-BR'])
+        ->get(route('entity.queues', $entity->slug))
+        ->assertOk()
+        ->assertSee('Filas de Acme', false)
+        ->assertSee('Criar fila', false)
+        ->assertDontSee('Queues of Acme', false);
+
+    $this->withHeaders(['Accept-Language' => 'en'])
+        ->get(route('entity.queues', $entity->slug))
+        ->assertOk()
+        ->assertSee('Queues of Acme', false)
+        ->assertSee('Create queue', false);
+});
+
+test('navigation shows queues to managers and serve to every member', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    actingQueueManager($owner, $entity);
+
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertOk()
+        ->assertSeeText(__('ui.nav_queues'))
+        ->assertSeeText(__('ui.nav_serve'));
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.dashboard', $entity->slug))
+        ->assertOk()
+        ->assertSeeText(__('ui.nav_serve'))
+        ->assertDontSeeText(__('ui.nav_queues'));
+});
+
+test('managers see queue rows and no per-row actions until a modal opens', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    actingQueueManager($owner, $entity);
+
+    $html = Livewire::test(Queues::class, ['entity' => $entity])->html();
+
+    expect($html)->toContain('wire:click="openQueue('.$queue->id.')"', false)
+        ->and($html)->toContain('Geral')
+        ->and($html)->not->toContain('startRename')
+        ->and($html)->not->toContain('toggleActive')
+        ->and($html)->not->toContain('openAccess');
+});
+
+test('creating a queue derives the slug and resets the create modal', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+
+    actingQueueManager($owner, $entity);
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openCreate')
+        ->assertSet('creating', true)
+        ->set('name', 'Atendimento Geral')
+        ->call('create')
+        ->assertHasNoErrors()
+        ->assertSet('name', '')
+        ->assertSet('creating', false);
+
+    $queue = Queue::where('entity_id', $entity->id)->sole();
+
+    expect($queue->name)->toBe('Atendimento Geral')
+        ->and($queue->slug)->toBe('atendimento-geral');
+});
+
+test('domain duplicate slug errors surface on the name field', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    Queue::factory()->for($entity)->create(['name' => 'Geral', 'slug' => 'geral']);
+
+    actingQueueManager($owner, $entity);
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openCreate')
+        ->set('name', 'Geral')
+        ->call('create')
+        ->assertHasErrors('name');
+
+    expect(Queue::where('entity_id', $entity->id)->count())->toBe(1);
+});
+
+test('opening a queue shows its detail modal and closing it resets nested state', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    actingQueueManager($owner, $entity);
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->assertSet('viewingQueueId', $queue->id)
+        ->call('startRename', $queue->id)
+        ->call('openAccess', $queue->id)
+        ->set('confirmingToggle', true)
+        ->call('closeQueue')
+        ->assertSet('viewingQueueId', null)
+        ->assertSet('confirmingToggle', false)
+        ->assertSet('editingQueueId', null)
+        ->assertSet('renameName', '')
+        ->assertSet('accessQueueId', null)
+        ->assertSet('managingAccess', false);
+});
+
+test('renaming updates the queue and re-derives its slug', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Old', 'slug' => 'old']);
+
+    actingQueueManager($owner, $entity);
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('startRename', $queue->id)
+        ->assertSet('renameName', 'Old')
+        ->set('renameName', 'New')
+        ->call('rename')
+        ->assertHasNoErrors();
+
+    expect($queue->fresh()->name)->toBe('New')
+        ->and($queue->fresh()->slug)->toBe('new');
+});
+
+test('renaming to a colliding slug reports the error on the rename field', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $first = Queue::factory()->for($entity)->create(['name' => 'Alpha', 'slug' => 'alpha']);
+    Queue::factory()->for($entity)->create(['name' => 'Beta', 'slug' => 'beta']);
+
+    actingQueueManager($owner, $entity);
+
+    Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $first->id)
+        ->call('startRename', $first->id)
+        ->set('renameName', 'Beta')
+        ->call('rename')
+        ->assertHasErrors('renameName');
+
+    expect($first->fresh()->name)->toBe('Alpha');
+});
+
+test('deactivation goes through a confirmation modal and toggles through the action', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral', 'is_active' => true]);
+
+    actingQueueManager($owner, $entity);
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('confirmToggle')
+        ->assertSet('confirmingToggle', true);
+
+    $html = $component->html();
+    expect($html)->not->toContain('wire:confirm')
+        ->and($html)->toContain(__('ui.queues_toggle_title'))
+        ->and($html)->toContain(__('ui.queues_toggle_message', ['queue' => 'Geral']));
+
+    $component->call('cancelToggle')->assertSet('confirmingToggle', false);
+    expect($queue->fresh()->is_active)->toBeTrue();
+
+    $component->call('confirmToggle')
+        ->call('toggleActive', $queue->id)
+        ->assertSet('confirmingToggle', false);
+
+    expect($queue->fresh()->is_active)->toBeFalse();
+
+    $component->call('toggleActive', $queue->id);
+    expect($queue->fresh()->is_active)->toBeTrue();
+});
+
+test('access modal grants and revokes call permission for entity memberships', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    actingQueueManager($owner, $entity);
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openQueue', $queue->id)
+        ->call('openAccess', $queue->id)
+        ->assertSet('accessQueueId', $queue->id)
+        ->assertSet('managingAccess', true)
+        ->assertSee($employee->name);
+
+    $component->call('grantAccess', $membership->id);
+
+    $access = QueueAccess::where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->sole();
+
+    expect($access->permissions)->toBe([QueuePermission::Call->value]);
+
+    $component->call('revokeAccess', $membership->id);
+
+    expect(QueueAccess::where('entity_membership_id', $membership->id)
+        ->where('queue_id', $queue->id)
+        ->exists())->toBeFalse();
+});
+
+test('foreign queue and membership ids are rejected without granting access', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+
+    $other = Entity::factory()->create();
+    $foreignQueue = Queue::factory()->for($other)->create();
+    $foreignMembership = EntityMembership::factory()->for($other)->create();
+
+    actingQueueManager($owner, $entity);
+
+    foreach ([
+        fn () => Livewire::test(Queues::class, ['entity' => $entity])->call('openQueue', $foreignQueue->id),
+        fn () => Livewire::test(Queues::class, ['entity' => $entity])->call('openAccess', $foreignQueue->id),
+    ] as $attempt) {
+        try {
+            $attempt();
+            $this->fail('A foreign queue id should not resolve.');
+        } catch (NotFoundHttpException|ModelNotFoundException) {
+            expect(true)->toBeTrue();
+        }
+    }
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->call('openAccess', $queue->id);
+
+    try {
+        $component->call('grantAccess', $foreignMembership->id);
+        $this->fail('A foreign membership id should not resolve.');
+    } catch (NotFoundHttpException|ModelNotFoundException) {
+        expect(QueueAccess::query()->count())->toBe(0);
+    }
+});
+
+test('a tampered access queue id discloses no queue or grants', function () {
+    $entity = Entity::factory()->create();
+    $owner = makeQueueOwner($entity);
+    $foreign = Queue::factory()->for(Entity::factory()->create())->create(['name' => 'Foreign secret']);
+
+    actingQueueManager($owner, $entity);
+
+    $component = Livewire::test(Queues::class, ['entity' => $entity])
+        ->set('accessQueueId', $foreign->id)
+        ->set('managingAccess', true);
+
+    $html = $component->html();
+
+    expect($html)->not->toContain('Foreign secret')
+        ->and($component->viewData('accessQueue'))->toBeNull()
+        ->and($component->viewData('accessGrants'))->toBeEmpty();
+});
