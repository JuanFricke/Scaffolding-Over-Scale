diff --git a/app/Livewire/Entity/Queues.php b/app/Livewire/Entity/Queues.php
new file mode 100644
index 0000000..338a8e8
--- /dev/null
+++ b/app/Livewire/Entity/Queues.php
@@ -0,0 +1,256 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateQueue;
+use App\Actions\SetQueueAccess;
+use App\Actions\UpdateQueue;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Queues extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    /**
+     * Whether the create-queue modal is open. Client-writable UI state.
+     */
+    public bool $creating = false;
+
+    /**
+     * Queue shown in the detail modal. Untrusted client state — always
+     * re-resolved scoped to the entity before use.
+     */
+    public ?int $viewingQueueId = null;
+
+    /**
+     * Whether the (de)activation confirmation modal is open.
+     */
+    public bool $confirmingToggle = false;
+
+    /**
+     * Queue currently being renamed in the detail modal.
+     */
+    public ?int $editingQueueId = null;
+
+    #[Validate('required|string|max:255')]
+    public string $renameName = '';
+
+    /**
+     * Queue whose access modal is open. Untrusted client state.
+     */
+    public ?int $accessQueueId = null;
+
+    /**
+     * Whether the access modal is open.
+     */
+    public bool $managingAccess = false;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('create', [Queue::class, $entity]);
+        $this->entity = $entity;
+    }
+
+    public function openCreate(): void
+    {
+        $this->resetValidation('name');
+        $this->creating = true;
+    }
+
+    public function closeCreate(): void
+    {
+        $this->reset('name', 'creating');
+        $this->resetValidation('name');
+    }
+
+    public function create(): void
+    {
+        $this->validateOnly('name');
+
+        try {
+            (new CreateQueue)($this->entity, auth()->user(), $this->name);
+        } catch (ValidationException $exception) {
+            $this->addErrorsTo('name', $exception);
+
+            return;
+        }
+
+        $this->reset('name', 'creating');
+        $this->resetValidation('name');
+    }
+
+    public function openQueue(int $queueId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($queueId);
+
+        $this->authorize('update', $queue);
+
+        $this->resetNestedState();
+        $this->viewingQueueId = $queue->id;
+    }
+
+    public function closeQueue(): void
+    {
+        $this->reset('viewingQueueId');
+        $this->resetNestedState();
+    }
+
+    public function startRename(int $queueId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($queueId);
+
+        $this->authorize('update', $queue);
+
+        $this->editingQueueId = $queue->id;
+        $this->renameName = $queue->name;
+        $this->resetValidation('renameName');
+    }
+
+    public function cancelRename(): void
+    {
+        $this->reset('editingQueueId', 'renameName');
+        $this->resetValidation('renameName');
+    }
+
+    public function rename(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->editingQueueId ?? $this->viewingQueueId ?? 0);
+
+        $this->authorize('update', $queue);
+
+        $this->validateOnly('renameName');
+
+        try {
+            (new UpdateQueue)(
+                $queue,
+                auth()->user(),
+                name: $this->renameName,
+                slug: Str::slug($this->renameName),
+            );
+        } catch (ValidationException $exception) {
+            $this->addErrorsTo('renameName', $exception);
+
+            return;
+        }
+
+        $this->reset('editingQueueId', 'renameName');
+        $this->resetValidation('renameName');
+    }
+
+    public function confirmToggle(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->viewingQueueId ?? 0);
+
+        $this->authorize('update', $queue);
+
+        $this->confirmingToggle = true;
+    }
+
+    public function cancelToggle(): void
+    {
+        $this->confirmingToggle = false;
+    }
+
+    public function toggleActive(int $queueId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($queueId);
+
+        $this->authorize('update', $queue);
+
+        (new UpdateQueue)($queue, auth()->user(), isActive: ! $queue->is_active);
+
+        $this->confirmingToggle = false;
+    }
+
+    public function openAccess(int $queueId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($queueId);
+
+        $this->authorize('manageAccess', $queue);
+
+        $this->accessQueueId = $queue->id;
+        $this->managingAccess = true;
+    }
+
+    public function closeAccess(): void
+    {
+        $this->reset('accessQueueId', 'managingAccess');
+    }
+
+    public function grantAccess(int $membershipId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->accessQueueId ?? 0);
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('manageAccess', $queue);
+
+        (new SetQueueAccess)($membership, $queue, auth()->user(), [QueuePermission::Call]);
+    }
+
+    public function revokeAccess(int $membershipId): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->accessQueueId ?? 0);
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        $this->authorize('manageAccess', $queue);
+
+        (new SetQueueAccess)($membership, $queue, auth()->user(), []);
+    }
+
+    public function render(): View
+    {
+        $accessQueue = $this->accessQueueId === null
+            ? null
+            : $this->entity->queues()->find($this->accessQueueId);
+
+        return view('livewire.entity.queues', [
+            'queues' => $this->entity->queues()->latest('id')->get(),
+            'viewingQueue' => $this->viewingQueueId === null
+                ? null
+                : $this->entity->queues()->find($this->viewingQueueId),
+            'accessQueue' => $accessQueue,
+            'accessGrants' => $accessQueue === null
+                ? collect()
+                : QueueAccess::query()
+                    ->where('queue_id', $accessQueue->id)
+                    ->with('membership.user')
+                    ->get(),
+            'memberships' => $this->entity->memberships()->with('user')->latest('id')->get(),
+        ]);
+    }
+
+    /**
+     * Reset every modal nested inside the queue detail modal.
+     */
+    protected function resetNestedState(): void
+    {
+        $this->reset('confirmingToggle', 'editingQueueId', 'renameName', 'accessQueueId', 'managingAccess');
+        $this->resetValidation();
+    }
+
+    /**
+     * The domain actions report queue validation under `slug`; this page has a
+     * single name field, so surface every domain message on that field.
+     */
+    protected function addErrorsTo(string $field, ValidationException $exception): void
+    {
+        foreach (collect($exception->errors())->flatten() as $message) {
+            $this->addError($field, $message);
+        }
+    }
+}
diff --git a/app/Livewire/Entity/Serve.php b/app/Livewire/Entity/Serve.php
new file mode 100644
index 0000000..896b31d
--- /dev/null
+++ b/app/Livewire/Entity/Serve.php
@@ -0,0 +1,158 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Serve extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    /**
+     * Queue selected in the serve panel. Untrusted client state — resolved
+     * scoped to the entity before it is used.
+     */
+    public ?int $selectedQueueId = null;
+
+    #[Validate('required|in:any,priority_only,normal_only')]
+    public string $mode = 'any';
+
+    /**
+     * Ticket id from the last successful call. Server-owned state.
+     */
+    #[Locked]
+    public ?int $lastCalledTicketId = null;
+
+    public ?string $notice = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+        $this->selectedQueueId = $this->callableQueues()->first()?->id;
+    }
+
+    public function callNext(): void
+    {
+        if ($this->selectedQueueId === null) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        // Foreign/tampered ids must not silently fall back to another queue.
+        $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+        $user = auth()->user();
+
+        $limiterKey = 'serve-call:'.$this->entity->id.':'.$user->id;
+
+        if (RateLimiter::tooManyAttempts($limiterKey, 10)) {
+            $this->notice = __('ui.serve_rate_limited');
+
+            return;
+        }
+
+        try {
+            $ticket = (new CallNextTicket)($queue, $user, $this->callMode());
+        } catch (InactiveQueueException) {
+            $this->notice = __('ui.serve_inactive');
+
+            return;
+        } catch (NoWaitingTicketsException) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        RateLimiter::hit($limiterKey, 60);
+
+        $this->lastCalledTicketId = $ticket->id;
+        $this->notice = __('ui.serve_last_called', ['code' => $ticket->code]);
+    }
+
+    public function render(): View
+    {
+        $callableQueues = $this->callableQueues();
+
+        $selectedQueue = $this->selectedQueueId === null
+            ? null
+            : $this->entity->queues()->find($this->selectedQueueId);
+
+        // A tampered/foreign selection or one the user may not call exposes no tickets.
+        if ($selectedQueue !== null && ! Gate::forUser(auth()->user())->allows('call', $selectedQueue)) {
+            $selectedQueue = null;
+        }
+
+        return view('livewire.entity.serve', [
+            'callableQueues' => $callableQueues,
+            'selectedQueue' => $selectedQueue,
+            'waitingTickets' => $selectedQueue === null
+                ? collect()
+                : $this->waitingTickets($selectedQueue),
+        ]);
+    }
+
+    /**
+     * Active queues of this entity the current user may call, in stable order.
+     *
+     * @return Collection<int, Queue>
+     */
+    protected function callableQueues(): Collection
+    {
+        $user = auth()->user();
+
+        return $this->entity->queues()
+            ->where('is_active', true)
+            ->orderBy('id')
+            ->get()
+            ->filter(fn (Queue $queue): bool => Gate::forUser($user)->allows('call', $queue))
+            ->values();
+    }
+
+    /**
+     * Waiting tickets in the same order CallNextTicket uses.
+     *
+     * @return Collection<int, Ticket>
+     */
+    protected function waitingTickets(Queue $queue): Collection
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting);
+
+        match ($this->callMode()) {
+            CallMode::PriorityOnly => $query->where('priority', '>', 0),
+            CallMode::NormalOnly => $query->where('priority', 0),
+            CallMode::Any => null,
+        };
+
+        return $query
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id')
+            ->limit(30)
+            ->get();
+    }
+
+    protected function callMode(): CallMode
+    {
+        return CallMode::tryFrom($this->mode) ?? CallMode::Any;
+    }
+}
