+<?php
+
+use App\Enums\QueuePermission;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Livewire\Entity\Serve;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+use Symfony\Component\HttpKernel\Exception\NotFoundHttpException;
+
+uses(RefreshDatabase::class);
+
+function serveMember(Entity $entity, string $role = 'owner'): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->create(['role' => $role]);
+
+    return $user;
+}
+
+test('any member can open the serve page', function () {
+    $entity = Entity::factory()->create();
+    $employee = serveMember($entity, 'employee');
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $this->get(route('entity.serve', $entity->slug))->assertOk();
+});
+
+test('mount selects the first callable queue', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    $first = Queue::factory()->for($entity)->create(['is_active' => true]);
+    Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $first->id)
+        ->assertSet('mode', 'any')
+        ->assertSet('lastCalledTicketId', null);
+});
+
+test('employee callable queues are limited to granted active queues', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    $employee = serveMember($entity, 'employee');
+    $membership = EntityMembership::where('user_id', $employee->id)->sole();
+
+    $granted = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ungranted = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $inactiveGranted = Queue::factory()->for($entity)->create(['is_active' => false]);
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $granted->id,
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $membership->id,
+        'queue_id' => $inactiveGranted->id,
+        'permissions' => [QueuePermission::Call->value],
+    ]);
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $html = Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSet('selectedQueueId', $granted->id)
+        ->html();
+
+    expect($html)->toContain($granted->name)
+        ->and($html)->not->toContain($ungranted->name)
+        ->and($html)->not->toContain($inactiveGranted->name);
+});
+
+test('waiting list follows call order, respects the mode and translates channels', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    Ticket::factory()->forQueue($queue)->create([
+        'code' => 'A001',
+        'priority' => 0,
+        'issued_at' => now()->subMinutes(5),
+        'channel' => TicketChannel::Totem,
+    ]);
+    Ticket::factory()->forQueue($queue)->create([
+        'code' => 'A002',
+        'priority' => 10,
+        'issued_at' => now()->subMinute(),
+        'channel' => TicketChannel::Printed,
+    ]);
+    Ticket::factory()->forQueue($queue)->create([
+        'code' => 'A003',
+        'priority' => 0,
+        'issued_at' => now()->subMinutes(10),
+        'channel' => TicketChannel::Virtual,
+    ]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->assertSeeInOrder(['A002', 'A003', 'A001'])
+        ->assertSee(__('ui.channel_printed'))
+        ->assertSee(__('ui.channel_virtual'))
+        ->set('mode', 'priority_only')
+        ->assertSee('A002')
+        ->assertDontSee('A001')
+        ->assertDontSee('A003')
+        ->set('mode', 'normal_only')
+        ->assertSeeInOrder(['A003', 'A001'])
+        ->assertDontSee('A002');
+});
+
+test('foreign, missing or unauthorized selected queues show only the empty state', function () {
+    $entity = Entity::factory()->create();
+    $employee = serveMember($entity, 'employee');
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $foreign = Queue::factory()->for(Entity::factory()->create())->create(['is_active' => true]);
+    $foreignTicket = Ticket::factory()->forQueue($foreign)->create(['code' => 'Z999']);
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $foreign->id)
+        ->assertSee(__('ui.serve_empty'))
+        ->assertDontSee('Z999');
+
+    $component->set('selectedQueueId', $queue->id)
+        ->assertSee(__('ui.serve_empty'));
+});
+
+test('callNext without a selection sets the empty notice without an error', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', null)
+        ->call('callNext')
+        ->assertHasNoErrors()
+        ->assertSet('notice', __('ui.serve_empty'));
+});
+
+test('callNext reports an inactive queue without mutating tickets', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => false]);
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_inactive'));
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('callNext reports no waiting tickets', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->call('callNext')
+        ->assertSet('notice', __('ui.serve_empty'));
+});
+
+test('callNext calls the next ticket and exposes the last called id', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ticket = Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->call('callNext')
+        ->assertSet('lastCalledTicketId', $ticket->id)
+        ->assertSet('notice', __('ui.serve_last_called', ['code' => 'A001']))
+        ->assertSee('A001');
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->fresh()->called_by_user_id)->toBe($owner->id);
+});
+
+test('callNext does not catch authorization failures', function () {
+    $entity = Entity::factory()->create();
+    $employee = serveMember($entity, 'employee');
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $this->actingAs($employee)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id)
+        ->call('callNext')
+        ->assertForbidden();
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('callNext rejects a foreign queue id', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    $foreign = Queue::factory()->for(Entity::factory()->create())->create(['is_active' => true]);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    try {
+        Livewire::test(Serve::class, ['entity' => $entity])
+            ->set('selectedQueueId', $foreign->id)
+            ->call('callNext');
+        $this->fail('A foreign queue should not resolve.');
+    } catch (NotFoundHttpException|ModelNotFoundException) {
+        expect(true)->toBeTrue();
+    }
+});
+
+test('successful calls are rate limited per user and entity', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    foreach (range(1, 11) as $index) {
+        Ticket::factory()->forQueue($queue)->create(['code' => 'A'.str_pad((string) $index, 3, '0', STR_PAD_LEFT)]);
+    }
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity]);
+
+    foreach (range(1, 10) as $index) {
+        $component->call('callNext')->assertHasNoErrors();
+    }
+
+    $component->call('callNext')->assertSet('notice', __('ui.serve_rate_limited'));
+
+    expect(Ticket::where('queue_id', $queue->id)->where('status', TicketStatus::Waiting)->count())->toBe(1);
+});
+
+test('callNext honours the selected call mode', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $normal = Ticket::factory()->forQueue($queue)->create(['priority' => 0, 'code' => 'A001']);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10, 'code' => 'A002']);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('mode', 'normal_only')
+        ->call('callNext')
+        ->assertSet('lastCalledTicketId', $normal->id);
+
+    expect($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('the last called ticket id is server-owned and not writable', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveMember($entity);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    expect(fn () => Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('lastCalledTicketId', 999))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
