index 0000000..60b7de8
--- /dev/null
+++ b/tests/Feature/CallNextTicketTest.php
@@ -0,0 +1,263 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function waiting(Queue $queue, int $priority = 0, ?string $issuedAt = null): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'issued_at' => $issuedAt ?? now(),
+    ]);
+}
+
+function calledTicket(Queue $queue, int $priority, string $calledAt): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt,
+        'called_by_user_id' => User::factory()->create()->id,
+    ]);
+}
+
+beforeEach(function () {
+    $this->queue = Queue::factory()->create(['is_active' => true]);
+    $this->user = User::factory()->create();
+});
+
+it('calls the highest priority ticket first', function () {
+    waiting($this->queue, 0, '2026-01-01 08:00:00');
+    $high = waiting($this->queue, 20, '2026-01-01 09:00:00');
+    waiting($this->queue, 10, '2026-01-01 07:00:00');
+
+    $called = (new CallNextTicket)($this->queue, $this->user);
+
+    expect($called->id)->toBe($high->id);
+});
+
+it('calls the oldest ticket within the same priority, then lowest id', function () {
+    $newer = waiting($this->queue, 10, '2026-01-01 09:00:00');
+    $oldA = waiting($this->queue, 10, '2026-01-01 08:00:00');
+    $oldB = waiting($this->queue, 10, '2026-01-01 08:00:00');
+
+    $action = new CallNextTicket;
+
+    expect($action($this->queue, $this->user)->id)->toBe($oldA->id);
+    expect($action($this->queue, $this->user)->id)->toBe($oldB->id);
+    expect($action($this->queue, $this->user)->id)->toBe($newer->id);
+});
+
+it('returns the updated ticket and persists the call', function () {
+    $ticket = waiting($this->queue);
+
+    $called = (new CallNextTicket)($this->queue, $this->user);
+
+    expect($called)
+        ->id->toBe($ticket->id)
+        ->status->toBe(TicketStatus::Called)
+        ->called_at->not->toBeNull()
+        ->called_by_user_id->toBe($this->user->id);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Called);
+    expect($fresh->called_by_user_id)->toBe($this->user->id);
+    expect($fresh->called_at)->not->toBeNull();
+});
+
+it('never selects tickets of other queues or already called tickets', function () {
+    $other = Queue::factory()->create(['is_active' => true]);
+    waiting($other, 50);
+    calledTicket($this->queue, 50, '2026-01-01 08:00:00');
+    $mine = waiting($this->queue, 0);
+
+    $action = new CallNextTicket;
+
+    expect($action($this->queue, $this->user)->id)->toBe($mine->id);
+    expect(fn () => $action($this->queue, $this->user))
+        ->toThrow(NoWaitingTicketsException::class);
+    expect(Ticket::query()->where('queue_id', $other->id)->first()->status)
+        ->toBe(TicketStatus::Waiting);
+});
+
+it('throws when the queue is empty', function () {
+    expect(fn () => (new CallNextTicket)($this->queue, $this->user))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('rejects an inactive queue and changes nothing', function () {
+    $ticket = waiting($this->queue);
+    $this->queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($this->queue, $this->user))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('reads the queue state from the database, not the passed instance', function () {
+    $ticket = waiting($this->queue);
+    $stale = Queue::find($this->queue->id);
+    Queue::whereKey($this->queue->id)->update(['is_active' => false]);
+
+    expect($stale->is_active)->toBeTrue();
+    expect(fn () => (new CallNextTicket)($stale, $this->user))
+        ->toThrow(InactiveQueueException::class);
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('priority_only calls only priority tickets', function () {
+    waiting($this->queue, 0, '2026-01-01 07:00:00');
+    $low = waiting($this->queue, 5, '2026-01-01 08:00:00');
+    $high = waiting($this->queue, 10, '2026-01-01 09:00:00');
+
+    $action = new CallNextTicket;
+
+    expect($action($this->queue, $this->user, CallMode::PriorityOnly)->id)->toBe($high->id);
+    expect($action($this->queue, $this->user, CallMode::PriorityOnly)->id)->toBe($low->id);
+    expect(fn () => $action($this->queue, $this->user, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('normal_only calls only normal tickets, oldest first', function () {
+    waiting($this->queue, 10, '2026-01-01 06:00:00');
+    $newer = waiting($this->queue, 0, '2026-01-01 09:00:00');
+    $older = waiting($this->queue, 0, '2026-01-01 08:00:00');
+
+    $action = new CallNextTicket;
+
+    expect($action($this->queue, $this->user, CallMode::NormalOnly)->id)->toBe($older->id);
+    expect($action($this->queue, $this->user, CallMode::NormalOnly)->id)->toBe($newer->id);
+    expect(fn () => $action($this->queue, $this->user, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('calls a normal ticket after 3 consecutive priority calls', function () {
+    $normal = waiting($this->queue, 0, '2026-01-01 06:00:00');
+    foreach (range(1, 5) as $i) {
+        waiting($this->queue, 10, '2026-01-01 07:00:0'.$i);
+    }
+
+    $action = new CallNextTicket;
+    $order = [];
+    foreach (range(1, 5) as $i) {
+        $order[] = $action($this->queue, $this->user)->priority;
+    }
+
+    expect($order)->toBe([10, 10, 10, 0, 10]);
+    expect($normal->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+it('keeps calling priority when no normal is waiting', function () {
+    foreach (range(1, 5) as $i) {
+        waiting($this->queue, 10, '2026-01-01 07:00:0'.$i);
+    }
+
+    $action = new CallNextTicket;
+    foreach (range(1, 5) as $i) {
+        expect($action($this->queue, $this->user)->priority)->toBe(10);
+    }
+});
+
+it('does not apply fairness with fewer than 3 calls in history', function () {
+    calledTicket($this->queue, 10, '2026-01-01 08:00:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:01:00');
+    waiting($this->queue, 0, '2026-01-01 06:00:00');
+    $priority = waiting($this->queue, 10, '2026-01-01 07:00:00');
+
+    expect((new CallNextTicket)($this->queue, $this->user)->id)->toBe($priority->id);
+});
+
+it('counts priority_only calls in the fairness history', function () {
+    foreach (range(1, 4) as $i) {
+        waiting($this->queue, 10, '2026-01-01 07:00:0'.$i);
+    }
+    $normal = waiting($this->queue, 0, '2026-01-01 06:00:00');
+
+    $action = new CallNextTicket;
+    foreach (range(1, 3) as $i) {
+        $action($this->queue, $this->user, CallMode::PriorityOnly);
+    }
+
+    expect($action($this->queue, $this->user)->id)->toBe($normal->id);
+});
+
+it('resets the streak after a normal call, including normal_only calls', function () {
+    calledTicket($this->queue, 10, '2026-01-01 08:00:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:01:00');
+    calledTicket($this->queue, 0, '2026-01-01 08:02:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:03:00');
+    waiting($this->queue, 0, '2026-01-01 06:00:00');
+    $priority = waiting($this->queue, 10, '2026-01-01 07:00:00');
+
+    expect((new CallNextTicket)($this->queue, $this->user)->id)->toBe($priority->id);
+});
+
+it('ignores fairness in priority_only and normal_only modes', function () {
+    foreach (range(1, 3) as $i) {
+        calledTicket($this->queue, 10, '2026-01-01 08:0'.$i.':00');
+    }
+    $priority = waiting($this->queue, 10, '2026-01-01 07:00:00');
+    waiting($this->queue, 0, '2026-01-01 06:00:00');
+
+    expect((new CallNextTicket)($this->queue, $this->user, CallMode::PriorityOnly)->id)
+        ->toBe($priority->id);
+});
+
+it('breaks called_at ties in the history by id, most recent first', function () {
+    calledTicket($this->queue, 0, '2026-01-01 08:00:00');
+    // Same called_at: the highest id is the most recent. The last 3 are
+    // [p(id4), p(id3), p(id2)] -> all priority -> fairness applies.
+    calledTicket($this->queue, 10, '2026-01-01 08:01:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:01:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:01:00');
+    $normal = waiting($this->queue, 0, '2026-01-01 06:00:00');
+    waiting($this->queue, 10, '2026-01-01 07:00:00');
+
+    expect((new CallNextTicket)($this->queue, $this->user)->id)->toBe($normal->id);
+});
+
+it('only considers the history of the given queue', function () {
+    $other = Queue::factory()->create(['is_active' => true]);
+    foreach (range(1, 3) as $i) {
+        calledTicket($other, 10, '2026-01-01 08:0'.$i.':00');
+    }
+    waiting($this->queue, 0, '2026-01-01 06:00:00');
+    $priority = waiting($this->queue, 10, '2026-01-01 07:00:00');
+
+    expect((new CallNextTicket)($this->queue, $this->user)->id)->toBe($priority->id);
+});
+
+it('skips a candidate that was called concurrently through Ticket::call', function () {
+    $first = waiting($this->queue, 10, '2026-01-01 07:00:00');
+    $second = waiting($this->queue, 10, '2026-01-01 08:00:00');
+
+    // Simulate the race: the first ticket is called right after the
+    // candidate query picks it, before its row lock is taken.
+    $raced = false;
+    Ticket::retrieved(function (Ticket $ticket) use ($first, &$raced) {
+        if (! $raced && $ticket->id === $first->id) {
+            $raced = true;
+            Ticket::query()->whereKey($first->id)->update([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $this->user->id,
+            ]);
+        }
+    });
+
+    $called = (new CallNextTicket)($this->queue, $this->user);
+
+    expect($called->id)->toBe($second->id);
+    expect($first->fresh()->status)->toBe(TicketStatus::Called);
+    expect(Ticket::where('status', TicketStatus::Called)->count())->toBe(2);
+});
