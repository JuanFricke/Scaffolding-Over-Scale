+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /** Consecutive priority calls a waiting normal ticket may sit behind. */
+    private const FAIRNESS_STREAK = 3;
+
+    /**
+     * Call the next waiting ticket of a queue (trusted caller, no authorization).
+     *
+     * @throws InactiveQueueException when the queue is inactive
+     * @throws NoWaitingTicketsException when no ticket is eligible for the mode
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read the state from the database under lock: the passed model may be stale.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $skipped = [];
+
+            while (true) {
+                $candidate = $this->candidates($lockedQueue, $mode)
+                    ->whereNotIn('id', $skipped)
+                    ->first();
+
+                if ($candidate === null) {
+                    throw new NoWaitingTicketsException('No waiting ticket is eligible to be called.');
+                }
+
+                // Ticket::call() does not lock the queue, so re-check under the row lock.
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    $skipped[] = $candidate->id;
+
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+        });
+    }
+
+    /**
+     * Waiting tickets eligible for the mode, in call order.
+     *
+     * @return Builder<Ticket>
+     */
+    private function candidates(Queue $queue, CallMode $mode): Builder
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting);
+
+        match ($mode) {
+            CallMode::PriorityOnly => $query->where('priority', '>', 0),
+            CallMode::NormalOnly => $query->where('priority', 0),
+            CallMode::Any => $this->mustServeNormal($queue)
+                ? $query->where('priority', 0)
+                : null,
+        };
+
+        return $query
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+    }
+
+    /**
+     * Fairness: the last 3 calls were all priority and a normal ticket is waiting.
+     */
+    private function mustServeNormal(Queue $queue): bool
+    {
+        $lastPriorities = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::FAIRNESS_STREAK)
+            ->pluck('priority');
+
+        if ($lastPriorities->count() < self::FAIRNESS_STREAK || $lastPriorities->contains(0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
