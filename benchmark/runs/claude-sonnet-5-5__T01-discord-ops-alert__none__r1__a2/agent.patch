new file mode 100644
index 0000000..70a7b15
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,135 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Stringable;
+use Throwable;
+
+/**
+ * Sends a human-pageable ops alert to a Discord incoming webhook.
+ *
+ * This is an explicit call, never a Monolog channel. It is a no-op when
+ * `services.discord.webhook_url` is not configured and it never throws.
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const REDACTED = '[redacted]';
+
+    private const SENSITIVE_KEY = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const BEARER = '/\bBearer\s+\S+/i';
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = null;
+
+        try {
+            $configured = config('services.discord.webhook_url');
+            $url = is_string($configured) ? trim($configured) : '';
+
+            if ($url === '') {
+                return;
+            }
+
+            $response = Http::timeout(5)
+                ->connectTimeout(3)
+                ->asJson()
+                ->post($url, ['content' => $this->buildText($title, $message, $context)]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (Throwable $e) {
+            $this->logFailure($e, $url);
+        }
+    }
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    private function buildText(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->format($this->redact((string) $key, $value));
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH);
+    }
+
+    private function redact(string $key, mixed $value): mixed
+    {
+        if (preg_match(self::SENSITIVE_KEY, $key) === 1) {
+            return self::REDACTED;
+        }
+
+        if (is_array($value)) {
+            $redacted = [];
+            foreach ($value as $k => $v) {
+                $redacted[$k] = $this->redact((string) $k, $v);
+            }
+
+            return $redacted;
+        }
+
+        if (is_string($value) && preg_match(self::BEARER, $value) === 1) {
+            return self::REDACTED;
+        }
+
+        if ($value instanceof Stringable && preg_match(self::BEARER, (string) $value) === 1) {
+            return self::REDACTED;
+        }
+
+        return $value;
+    }
+
+    private function format(mixed $value): string
+    {
+        return match (true) {
+            $value === null => 'null',
+            is_bool($value) => $value ? 'true' : 'false',
+            is_scalar($value) => (string) $value,
+            is_array($value) => (string) json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES | JSON_PARTIAL_OUTPUT_ON_ERROR),
+            $value instanceof Stringable => (string) $value,
+            is_object($value) => $value::class,
+            default => get_debug_type($value),
+        };
+    }
+
+    private function logFailure(Throwable $e, ?string $url): void
+    {
+        try {
+            Log::error('Discord ops alert failed', [
+                'exception' => $e::class,
+                'error' => $this->scrub($e->getMessage(), $url),
+            ]);
+        } catch (Throwable) {
+            // Alerting must never break the caller.
+        }
+    }
+
+    /**
+     * Strip the webhook URL (it embeds the webhook token) from a string.
+     */
+    private function scrub(string $text, ?string $url): string
+    {
+        if ($url !== null && $url !== '') {
+            $text = str_replace([$url, rawurlencode($url), urlencode($url)], self::REDACTED, $text);
+
+            $path = parse_url($url, PHP_URL_PATH);
+            if (is_string($path) && strlen($path) > 1) {
+                $text = str_replace($path, self::REDACTED, $text);
+            }
+        }
+
+        return (string) preg_replace('#https?://\S*/webhooks/\S*#i', self::REDACTED, $text);
+    }
+}
