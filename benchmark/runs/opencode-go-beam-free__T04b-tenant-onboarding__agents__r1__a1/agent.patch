+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\User;
+use Closure;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Auth;
+use Symfony\Component\HttpFoundation\Response;
+
+class CurrentEntity
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = Auth::user();
+
+        if (! $user instanceof User) {
+            return $next($request);
+        }
+
+        $entityId = session('current_entity_id');
+
+        if (empty($entityId)) {
+            $memberships = $user->memberships()->get();
+
+            if ($memberships->isEmpty()) {
+                return redirect()->route('onboarding');
+            }
+
+            if ($memberships->count() === 1) {
+                session(['current_entity_id' => $memberships->first()->entity_id]);
+                $entityId = $memberships->first()->entity_id;
+            } else {
+                return redirect()->route('entity.switcher');
+            }
+        }
+
+        $membership = $user->membershipFor((int) $entityId);
+
+        if ($membership === null) {
+            abort(403);
+        }
+
+        $entity = Entity::find($entityId);
+
+        if ($entity === null) {
+            session()->forget('current_entity_id');
+            abort(403);
+        }
+
+        $request->attributes->set('current_entity', $entity);
+        $request->attributes->set('current_entity_id', $entity->id);
+        app()->instance('current.entity', $entity);
+        app()->instance('current_entity', $entity);
+
+        return $next($request);
+    }
+}
