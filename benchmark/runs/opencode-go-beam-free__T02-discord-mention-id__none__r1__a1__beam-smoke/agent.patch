diff --git a/.env.example b/.env.example
index 2cf633c..1d88c9c 100644
--- a/.env.example
+++ b/.env.example
@@ -76,6 +76,9 @@ TELESCOPE_ENABLED=true
 # Discord ops alerts (incoming webhook). Empty = no-op. Alerts only — not a log sink.
 DISCORD_WEBHOOK_URL=
 
+# Discord user ID to ping on every ops alert (snowflake, 17-20 digits). Empty = no mention.
+DISCORD_MENTION_ID=
+
 # Hostinger / PegaFila ops (bin/pf) — never commit real secrets.
 # GitHub Actions: store the same key as repository secret HOSTINGER_API
 HOSTINGER_API=
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..16abb2d 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,45 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $base = implode("\n", $lines);
+
+        $mentionId = $this->mentionId();
+
+        if ($mentionId === null) {
+            return mb_substr($base, 0, self::MaxContentLength);
+        }
+
+        $mention = '<@'.$mentionId.'>';
+
+        $separator = "\n";
+        $maxBase = self::MaxContentLength - mb_strlen($separator) - mb_strlen($mention);
+
+        if ($maxBase < 0) {
+            $maxBase = 0;
+        }
+
+        $base = mb_substr($base, 0, $maxBase);
+
+        return $base.$separator.$mention;
+    }
+
+    private function mentionId(): ?string
+    {
+        $value = config('services.discord.mention_id');
+
+        if (is_int($value)) {
+            $id = (string) $value;
+        } elseif (is_string($value)) {
+            $id = trim($value);
+        } else {
+            return null;
+        }
+
+        if (! preg_match('/^[0-9]{17,20}$/', $id)) {
+            return null;
+        }
+
+        return $id;
     }
 
     private function safe(string $key, mixed $value): string
