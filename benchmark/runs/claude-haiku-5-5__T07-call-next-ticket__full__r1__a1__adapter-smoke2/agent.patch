+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * A normal ticket may not wait behind more than this many consecutive priority calls.
+     */
+    private const MAX_CONSECUTIVE_PRIORITY_CALLS = 3;
+
+    /**
+     * Calls the next eligible waiting ticket of the queue and marks it called.
+     *
+     * Ordering is priority (desc), issued_at (asc), id (asc). In CallMode::Any a
+     * normal ticket is forced after 3 consecutive priority calls when one waits.
+     *
+     * @throws InactiveQueueException when the queue is inactive (nothing changes)
+     * @throws NoWaitingTicketsException when no ticket is eligible for the mode
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Read the queue state under lock: the passed instance may be stale.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $eligible = $this->eligible($lockedQueue->id, $mode);
+            $skipped = [];
+
+            while (true) {
+                $candidate = (clone $eligible)
+                    ->whereNotIn('id', $skipped)
+                    ->orderByDesc('priority')
+                    ->orderBy('issued_at')
+                    ->orderBy('id')
+                    ->first();
+
+                if ($candidate === null) {
+                    throw new NoWaitingTicketsException('No waiting ticket is eligible for this call.');
+                }
+
+                // Ticket::call() does not lock the queue, so re-check under the ticket lock.
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket?->status === TicketStatus::Waiting) {
+                    break;
+                }
+
+                $skipped[] = $candidate->id;
+            }
+
+            $ticket->status = TicketStatus::Called;
+            $ticket->called_at = now();
+            $ticket->called_by_user_id = $calledBy->id;
+            $ticket->save();
+
+            return $ticket;
+        });
+    }
+
+    /**
+     * Waiting tickets of the queue allowed by the requested mode.
+     *
+     * @return Builder<Ticket>
+     */
+    private function eligible(int $queueId, CallMode $mode): Builder
+    {
+        $query = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting);
+
+        return match ($mode) {
+            CallMode::PriorityOnly => $query->where('priority', '>', 0),
+            CallMode::NormalOnly => $query->where('priority', 0),
+            CallMode::Any => $this->normalIsDue($queueId)
+                ? $query->where('priority', 0)
+                : $query,
+        };
+    }
+
+    /**
+     * True when the last 3 calls were all priority and a normal ticket is waiting.
+     */
+    private function normalIsDue(int $queueId): bool
+    {
+        $recentPriorities = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::MAX_CONSECUTIVE_PRIORITY_CALLS)
+            ->pluck('priority');
+
+        if ($recentPriorities->count() < self::MAX_CONSECUTIVE_PRIORITY_CALLS) {
+            return false;
+        }
+
+        if ($recentPriorities->contains(fn (mixed $priority): bool => (int) $priority === 0)) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
