+<?php
+
+namespace App\Enums;
+
+enum CallMode: string
+{
+    /** Full ordering, subject to the 3-priority fairness rule. */
+    case Any = 'any';
+
+    /** Only priority tickets (priority > 0); fairness ignored. */
+    case PriorityOnly = 'priority_only';
+
+    /** Only normal tickets (priority = 0); fairness ignored. */
+    case NormalOnly = 'normal_only';
+}
