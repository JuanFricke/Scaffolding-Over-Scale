+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Events\QueryExecuted;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+function waitingTicketFor(Queue $queue, int $priority, int $minutesAgo): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'issued_at' => now()->subMinutes($minutesAgo),
+    ]);
+}
+
+/**
+ * Creates already-called tickets, oldest first, so the last entry is the most recent call.
+ *
+ * @param  list<int>  $priorities
+ */
+function calledHistoryFor(Queue $queue, array $priorities, User $by): void
+{
+    foreach ($priorities as $index => $priority) {
+        Ticket::factory()->forQueue($queue)->create([
+            'priority' => $priority,
+            'status' => TicketStatus::Called,
+            'issued_at' => now()->subHours(2),
+            'called_at' => now()->subMinutes(count($priorities) - $index),
+            'called_by_user_id' => $by->id,
+        ]);
+    }
+}
+
+it('calls the highest priority first, then the oldest, then the lowest id', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $normal = waitingTicketFor($queue, 0, 9);
+    $priorityNewer = waitingTicketFor($queue, 10, 1);
+    $priorityOlder = waitingTicketFor($queue, 10, 3);
+    $vip = waitingTicketFor($queue, 20, 1);
+
+    $action = new CallNextTicket;
+
+    expect($action($queue, $attendant)->is($vip))->toBeTrue()
+        ->and($action($queue, $attendant)->is($priorityOlder))->toBeTrue()
+        ->and($action($queue, $attendant)->is($priorityNewer))->toBeTrue()
+        ->and($action($queue, $attendant)->is($normal))->toBeTrue();
+});
+
+it('breaks equal priority and issue time ties by lowest id', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $issuedAt = now()->subMinutes(5);
+
+    $first = Ticket::factory()->forQueue($queue)->create(['issued_at' => $issuedAt]);
+    Ticket::factory()->forQueue($queue)->create(['issued_at' => $issuedAt]);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($first))->toBeTrue();
+});
+
+it('calls only priority tickets in priority_only mode and ignores fairness', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledHistoryFor($queue, [10, 10, 10], $attendant);
+
+    waitingTicketFor($queue, 0, 9);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('rejects priority_only when no priority ticket waits and changes nothing', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $normal = waitingTicketFor($queue, 0, 1);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('calls only normal tickets, oldest first, in normal_only mode', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    waitingTicketFor($queue, 20, 30);
+    $newer = waitingTicketFor($queue, 0, 2);
+    $oldest = waitingTicketFor($queue, 0, 5);
+
+    $action = new CallNextTicket;
+
+    expect($action($queue, $attendant, CallMode::NormalOnly)->is($oldest))->toBeTrue()
+        ->and($action($queue, $attendant, CallMode::NormalOnly)->is($newer))->toBeTrue();
+});
+
+it('rejects normal_only when no normal ticket waits', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('rejects a call on an empty queue', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('never selects tickets from another queue', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $other = Queue::factory()->create(['is_active' => true]);
+
+    waitingTicketFor($other, 20, 10);
+    $own = waitingTicketFor($queue, 0, 1);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($own))->toBeTrue();
+});
+
+it('never calls an already called ticket again', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledHistoryFor($queue, [20], $attendant);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('marks the winner as called and returns the updated ticket', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = waitingTicketFor($queue, 0, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called)
+        ->status->toBe(TicketStatus::Called)
+        ->called_at->not->toBeNull()
+        ->called_by_user_id->toBe($attendant->id);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($attendant->id)
+        ->code->toBe($ticket->code);
+});
+
+it('rejects calling from an inactive queue, even with a stale instance', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = waitingTicketFor($queue, 0, 1);
+    $stale = Queue::query()->findOrFail($queue->id);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('restricts to normal after three consecutive priority calls', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledHistoryFor($queue, [10, 10, 20], $attendant);
+
+    $priority = waitingTicketFor($queue, 10, 5);
+    $normal = waitingTicketFor($queue, 0, 9);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($normal))->toBeTrue()
+        ->and($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('does not restrict when a normal call is among the last three', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledHistoryFor($queue, [10, 0, 10], $attendant);
+
+    $priority = waitingTicketFor($queue, 10, 5);
+    waitingTicketFor($queue, 0, 9);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($priority))->toBeTrue();
+});
+
+it('does not restrict before three calls have been made', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledHistoryFor($queue, [10, 10], $attendant);
+
+    $priority = waitingTicketFor($queue, 10, 5);
+    waitingTicketFor($queue, 0, 9);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($priority))->toBeTrue();
+});
+
+it('keeps calling priority tickets when no normal ticket waits', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledHistoryFor($queue, [10, 10, 10], $attendant);
+
+    $priority = waitingTicketFor($queue, 10, 5);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($priority))->toBeTrue();
+});
+
+it('counts priority_only calls towards the fairness streak', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicketFor($queue, 10, 6);
+    waitingTicketFor($queue, 10, 5);
+    waitingTicketFor($queue, 10, 4);
+    $normal = waitingTicketFor($queue, 0, 9);
+
+    $action = new CallNextTicket;
+    $action($queue, $attendant, CallMode::PriorityOnly);
+    $action($queue, $attendant, CallMode::PriorityOnly);
+    $action($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($action($queue, $attendant)->is($normal))->toBeTrue();
+});
+
+it('resets the priority streak after a normal call', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledHistoryFor($queue, [10, 10, 10], $attendant);
+
+    $normalSoFar = waitingTicketFor($queue, 0, 9);
+    $priority = waitingTicketFor($queue, 10, 5);
+    waitingTicketFor($queue, 0, 8);
+
+    $action = new CallNextTicket;
+
+    expect($action($queue, $attendant, CallMode::NormalOnly)->is($normalSoFar))->toBeTrue()
+        ->and($action($queue, $attendant)->is($priority))->toBeTrue();
+});
+
+it('skips a candidate that was called concurrently and calls the next one', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $raced = waitingTicketFor($queue, 0, 9);
+    $next = waitingTicketFor($queue, 0, 5);
+
+    // Simulate Ticket::call() (no queue lock) winning the race right after the
+    // candidate is picked and before it is locked.
+    $raceFired = false;
+    DB::listen(function (QueryExecuted $query) use (&$raceFired, $raced): void {
+        if ($raceFired || ! str_contains($query->sql, 'order by')) {
+            return;
+        }
+
+        $raceFired = true;
+        DB::table('tickets')->where('id', $raced->id)->update(['status' => TicketStatus::Called->value]);
+    });
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($raceFired)->toBeTrue()
+        ->and($called->is($next))->toBeTrue()
+        ->and($raced->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($raced->fresh()->called_by_user_id)->toBeNull();
+});
