 <?php
 
 use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Testing\TestResponse;
+use Livewire\Mechanisms\HandleRequests\EndpointResolver;
 use Tests\TestCase;
 
 /*
@@ -48,3 +50,29 @@ function something()
 {
     // ..
 }
+
+/**
+ * Reads the Livewire snapshot of the first component rendered in an HTML page.
+ */
+function livewireSnapshot(string $html): string
+{
+    preg_match('/wire:snapshot="([^"]+)"/', $html, $matches);
+
+    return html_entity_decode($matches[1], ENT_QUOTES);
+}
+
+/**
+ * Replays a raw Livewire update request (what a tampered browser would send).
+ *
+ * @param  array<string, mixed>  $updates
+ */
+function livewireUpdate(string $snapshot, string $method, array $updates = []): TestResponse
+{
+    return test()->withHeader('X-Livewire', '1')->postJson(EndpointResolver::updatePath(), [
+        'components' => [[
+            'snapshot' => $snapshot,
+            'updates' => $updates,
+            'calls' => [['path' => '', 'method' => $method, 'params' => []]],
+        ]],
+    ]);
+}
