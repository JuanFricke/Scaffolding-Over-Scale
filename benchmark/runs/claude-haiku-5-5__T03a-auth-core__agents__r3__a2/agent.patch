+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..dcbc43e
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,156 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rules\Password;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function fillRegisterForm(string $email = 'maria@example.com', string $password = 'Secret123', ?string $confirmation = null)
+{
+    return Livewire::test(Register::class)
+        ->set('name', 'Maria Silva')
+        ->set('email', $email)
+        ->set('password', $password)
+        ->set('password_confirmation', $confirmation ?? $password);
+}
+
+test('guests see the pt_BR register form', function () {
+    $this->get(route('register'))
+        ->assertOk()
+        ->assertSeeLivewire(Register::class)
+        ->assertSee('Criar conta')
+        ->assertSee('wire:model="password_confirmation"', escape: false);
+});
+
+test('authenticated users visiting register are redirected home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
+
+test('registering creates an unverified user, sends the verification e-mail and logs in', function () {
+    Notification::fake();
+
+    fillRegisterForm()
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'maria@example.com')->firstOrFail();
+
+    expect($user->name)->toBe('Maria Silva')
+        ->and($user->email_verified_at)->toBeNull()
+        ->and(Hash::check('Secret123', $user->password))->toBeTrue();
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+    $this->assertAuthenticatedAs($user);
+});
+
+test('registration fires the Registered event', function () {
+    Event::fake([Registered::class]);
+
+    fillRegisterForm()->call('submit')->assertHasNoErrors();
+
+    Event::assertDispatched(Registered::class);
+});
+
+test('a mismatched confirmation fails the confirmed rule on password', function () {
+    fillRegisterForm(password: 'Secret123', confirmation: 'Secret124')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('the password must meet the app-wide default policy', function () {
+    fillRegisterForm(password: 'short1A')->call('submit')->assertHasErrors(['password']);
+    fillRegisterForm(password: 'alllowercase1')->call('submit')->assertHasErrors(['password']);
+    fillRegisterForm(password: 'NoNumbersHere')->call('submit')->assertHasErrors(['password']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('the default password rule is min 8 with letters, mixed case and numbers', function () {
+    expect(Validator::make(['p' => 'Secret123'], ['p' => Password::defaults()])->passes())->toBeTrue()
+        ->and(Validator::make(['p' => 'Sec12'], ['p' => Password::defaults()])->fails())->toBeTrue()
+        ->and(Validator::make(['p' => 'secret123'], ['p' => Password::defaults()])->fails())->toBeTrue()
+        ->and(Validator::make(['p' => 'SecretABC'], ['p' => Password::defaults()])->fails())->toBeTrue();
+});
+
+test('e-mail must be unique', function () {
+    User::factory()->create(['email' => 'maria@example.com']);
+
+    fillRegisterForm()->call('submit')->assertHasErrors(['email' => 'unique']);
+
+    expect(User::count())->toBe(1);
+});
+
+test('name and e-mail are required and e-mail must be strict', function () {
+    Livewire::test(Register::class)
+        ->set('name', '')
+        ->set('email', 'not-an-email')
+        ->set('password', 'Secret123')
+        ->set('password_confirmation', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['name' => 'required', 'email' => 'email']);
+});
+
+test('registration is rate limited to five attempts per IP', function () {
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        fillRegisterForm(password: 'Secret123', confirmation: 'Mismatch123')->call('submit');
+    }
+
+    fillRegisterForm()
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee('Muitas tentativas de login');
+
+    expect(User::count())->toBe(0);
+});
+
+test('an exhausted registration limiter blocks the request even with valid data', function () {
+    RateLimiter::hit(str()->transliterate('register|127.0.0.1'), 60);
+    RateLimiter::hit(str()->transliterate('register|127.0.0.1'), 60);
+    RateLimiter::hit(str()->transliterate('register|127.0.0.1'), 60);
+    RateLimiter::hit(str()->transliterate('register|127.0.0.1'), 60);
+    RateLimiter::hit(str()->transliterate('register|127.0.0.1'), 60);
+
+    fillRegisterForm()->call('submit')->assertHasErrors(['email']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('an authenticated user cannot replay the register action through a Livewire update', function () {
+    $user = User::factory()->create();
+    $snapshot = livewireSnapshot($this->get(route('register'))->getContent());
+
+    $this->actingAs($user);
+
+    livewireUpdate($snapshot, 'submit', [
+        'name' => 'Intruder',
+        'email' => 'intruder@example.com',
+        'password' => 'Secret123',
+        'password_confirmation' => 'Secret123',
+    ])->assertRedirect(route('home'));
+
+    expect(User::where('email', 'intruder@example.com')->exists())->toBeFalse();
+    $this->assertAuthenticatedAs($user);
+});
+
+test('the passwords are cleared from the component after a failed registration', function () {
+    fillRegisterForm(password: 'Secret123', confirmation: 'Mismatch123')
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed'])
+        ->assertSet('password', '')
+        ->assertSet('password_confirmation', '');
+});
