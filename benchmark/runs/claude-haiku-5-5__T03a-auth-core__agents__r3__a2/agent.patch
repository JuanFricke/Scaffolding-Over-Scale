@@ -0,0 +1,203 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('guests see the pt_BR login form with the bound inputs', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeLivewire(Login::class)
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?')
+        ->assertSee('wire:model="email"', escape: false)
+        ->assertSee('wire:model="password"', escape: false)
+        ->assertSee('wire:model="remember"', escape: false);
+});
+
+test('authenticated users visiting login are redirected home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('valid credentials log the user in and redirect to home', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('wrong password reports auth.failed on the email field', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+
+    $this->assertGuest();
+});
+
+test('unknown e-mail reports the same auth.failed error', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'nobody@example.com')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+});
+
+test('login requires a strict e-mail address and both fields', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', '')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email', 'password' => 'required']);
+});
+
+test('remember me keeps the user signed in', function () {
+    $user = User::factory()->create(['password' => 'Secret123', 'remember_token' => null]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Secret123')
+        ->set('remember', true)
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->remember_token)->not->toBeNull();
+});
+
+test('without remember me no remember token is issued', function () {
+    $user = User::factory()->create(['password' => 'Secret123', 'remember_token' => null]);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->remember_token)->toBeNull();
+});
+
+test('five failed attempts lock the e-mail and IP for login', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+
+    for ($attempt = 0; $attempt < 5; $attempt++) {
+        Livewire::test(Login::class)
+            ->set('email', $user->email)
+            ->set('password', 'wrong-password')
+            ->call('submit')
+            ->assertHasErrors(['email' => __('auth.failed')]);
+    }
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSee('Muitas tentativas de login');
+
+    $this->assertGuest();
+});
+
+test('the lockout key ignores the case of the e-mail', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+
+    foreach ([$user->email, strtoupper($user->email), $user->email, strtoupper($user->email), $user->email] as $email) {
+        Livewire::test(Login::class)
+            ->set('email', $email)
+            ->set('password', 'wrong-password')
+            ->call('submit');
+    }
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertSee('Muitas tentativas de login');
+});
+
+test('a successful login clears the failed attempts', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+
+    for ($attempt = 0; $attempt < 4; $attempt++) {
+        Livewire::test(Login::class)->set('email', $user->email)->set('password', 'wrong-password')->call('submit');
+    }
+
+    Livewire::test(Login::class)->set('email', $user->email)->set('password', 'Secret123')->call('submit')
+        ->assertRedirect(route('home'));
+    auth()->logout();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+});
+
+test('a non-string e-mail (tampered input) never authenticates', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+    $snapshot = livewireSnapshot($this->get(route('login'))->getContent());
+
+    livewireUpdate($snapshot, 'submit', ['email' => [$user->email], 'password' => 'Secret123']);
+
+    $this->assertGuest();
+});
+
+test('an authenticated user cannot replay the login action through a Livewire update', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+    $snapshot = livewireSnapshot($this->get(route('login'))->getContent());
+
+    $this->actingAs($user);
+
+    livewireUpdate($snapshot, 'submit', ['email' => 'other@example.com', 'password' => 'Secret123'])
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('failed logins are written to the audit channel without the e-mail address', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+
+    Log::shouldReceive('channel')->with('audit')->once()->andReturnSelf();
+    Log::shouldReceive('info')->once()->with('Login failed', ['ip' => '127.0.0.1']);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+});
+
+test('the password is cleared from the component after a failed attempt', function () {
+    $user = User::factory()->create(['password' => 'Secret123']);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')])
+        ->assertSet('password', '');
+});
+
+test('the password is cleared from the component even when validation fails', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'Secret123')
+        ->call('submit')
+        ->assertHasErrors(['email'])
+        ->assertSet('password', '');
+});
