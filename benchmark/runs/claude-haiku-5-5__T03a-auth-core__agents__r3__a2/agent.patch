+++ b/tests/Feature/Auth/ConventionsTest.php
@@ -0,0 +1,24 @@
+<?php
+
+use Illuminate\Support\Facades\File;
+
+test('views never hardcode internal href or action paths', function () {
+    $offenders = collect(File::allFiles(resource_path('views')))
+        ->filter(fn ($file) => str_ends_with($file->getFilename(), '.blade.php'))
+        ->filter(fn ($file) => preg_match('/(href|action)="\//', File::get($file->getPathname())))
+        ->map(fn ($file) => $file->getRelativePathname())
+        ->values()
+        ->all();
+
+    expect($offenders)->toBe([]);
+});
+
+test('auth controllers and Livewire classes redirect with named routes only', function () {
+    $offenders = collect(File::allFiles([app_path('Http/Controllers'), app_path('Livewire')]))
+        ->filter(fn ($file) => preg_match("/redirect\(\s*['\"]\//", File::get($file->getPathname())))
+        ->map(fn ($file) => $file->getRelativePathname())
+        ->values()
+        ->all();
+
+    expect($offenders)->toBe([]);
+});
diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..c65b745
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,113 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function signedVerificationUrl(User $user): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->getKey(),
+        'hash' => sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('the notice page is shown to unverified users with a resend form', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee('Reenviar e-mail de verificação')
+        ->assertSee('action="'.route('verification.send').'"', escape: false);
+});
+
+test('the notice page redirects guests to login and verified users home', function () {
+    $this->get(route('verification.notice'))->assertRedirect(route('login'));
+
+    $this->actingAs(User::factory()->create())
+        ->get(route('verification.notice'))
+        ->assertRedirect(route('home'));
+});
+
+test('a signed link verifies the logged-in user and redirects home', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->get(signedVerificationUrl($user))
+        ->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('a link with a tampered id is rejected and verifies nobody', function () {
+    $victim = User::factory()->unverified()->create();
+    $attacker = User::factory()->unverified()->create();
+
+    $tampered = str_replace(
+        '/email/verify/'.$victim->getKey(),
+        '/email/verify/'.$attacker->getKey(),
+        signedVerificationUrl($victim),
+    );
+
+    $this->actingAs($attacker)->get($tampered)->assertForbidden();
+
+    expect($attacker->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($victim->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a validly signed link for another user is forbidden', function () {
+    $victim = User::factory()->unverified()->create();
+    $attacker = User::factory()->unverified()->create();
+
+    $this->actingAs($attacker)
+        ->get(signedVerificationUrl($victim))
+        ->assertForbidden();
+
+    expect($attacker->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($victim->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('guests cannot use a verification link', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->get(signedVerificationUrl($user))->assertRedirect(route('login'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('resending sends the verification e-mail and flashes the status', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertSessionHas('status', 'verification-link-sent');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('resending for a verified user sends nothing and redirects home', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('the resend endpoint is throttled to six requests per minute', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user);
+
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('verification.send'))->assertRedirect();
+    }
+
+    $this->post(route('verification.send'))->assertStatus(429);
+});
diff --git a/tests/Feature/Auth/ForgotPasswordTest.php b/tests/Feature/Auth/ForgotPasswordTest.php
