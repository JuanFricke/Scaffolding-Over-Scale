+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?');
+});
+
+test('the login page is English when the locale is en', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeLivewire(Login::class)
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu a senha?');
+});
+
+test('ui translation files expose the same keys in en and pt_BR', function () {
+    $en = Arr::dot(require lang_path('en/ui.php'));
+    $ptBr = Arr::dot(require lang_path('pt_BR/ui.php'));
+
+    expect(array_keys($ptBr))->toEqualCanonicalizing(array_keys($en))
+        ->and($en)->not->toBeEmpty();
+});
diff --git a/tests/Feature/Auth/LoginTest.php b/tests/Feature/Auth/LoginTest.php
