+<?php
+
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('logout is only available as POST', function () {
+    $this->actingAs(User::factory()->create())
+        ->get('/logout')
+        ->assertMethodNotAllowed();
+});
+
+test('guests cannot log out', function () {
+    $this->post(route('logout'))->assertRedirect(route('login'));
+});
+
+test('logout ends the session, regenerates the CSRF token and redirects to login', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['_token' => 'token-before-logout'])
