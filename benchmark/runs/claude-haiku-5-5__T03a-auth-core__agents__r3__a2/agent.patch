@@ -0,0 +1,50 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+
+uses(RefreshDatabase::class);
+
+test('guests see the pt_BR forgot password form', function () {
+    $this->get(route('password.request'))
+        ->assertOk()
+        ->assertSee('Enviar link de redefinição de senha')
+        ->assertSee('action="'.route('password.email').'"', escape: false);
+});
+
+test('a known e-mail sends the reset notification and flashes the status', function () {
+    Notification::fake();
+    $user = User::factory()->create(['email' => 'maria@example.com']);
+
+    $this->post(route('password.email'), ['email' => 'maria@example.com'])
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown e-mail gets the same status and sends nothing', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+});
+
+test('the e-mail must be a valid address', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors('email');
+});
+
+test('the forgot password endpoint is throttled to six requests per minute', function () {
+    for ($attempt = 0; $attempt < 6; $attempt++) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+            ->assertRedirect();
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertStatus(429);
+});
