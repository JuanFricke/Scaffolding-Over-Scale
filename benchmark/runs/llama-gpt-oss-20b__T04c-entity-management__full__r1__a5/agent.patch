+<?php
+
+use Illuminate\Database\Migrations\Migration;
+use Illuminate\Database\Schema\Blueprint;
+use Illuminate\Support\Facades\Schema;
+use Illuminate\Support\Facades\DB;
+
+class CreateEntityMembershipsTable extends Migration
+{
+    public function up(): void
+    {
+        Schema::create('entity_memberships', function (Blueprint $table) {
+            $table->id();
+            $table->foreignId('entity_id')->constrained()->cascadeOnDelete();
+            $table->foreignId('user_id')->constrained()->cascadeOnDelete();
+            $table->string('role')->default('employee');
+            $table->timestamps();
+
+            // Unique per entity-user
+            $table->unique(['entity_id', 'user_id'], 'entity_memberships_entity_user_unique');
+
+            // For MariaDB: generated column owner_seq
+            if (DB::getDriverName() === 'mysql') {
+                // MySQL supports virtual generated columns
+                $table->unsignedTinyInteger('owner_seq')->virtualAs("role = 'owner' ? 1 : NULL")->nullable();
+                $table->unique(['entity_id', 'owner_seq'], 'entity_memberships_one_owner');
+            }
+        });
+
+        // SQLite: partial unique index to enforce single owner
+        if (DB::getDriverName() === 'sqlite') {
+            DB::statement("CREATE UNIQUE INDEX entity_memberships_one_owner ON entity_memberships(entity_id) WHERE role = 'owner'");
+        }
+    }
+
+    public function down(): void
+    {
+        Schema::dropIfExists('entity_memberships');
+    }
+}
diff --git a/docs/database-schema.md b/docs/database-schema.md
index dc42ac2..595a11a 100644
--- a/docs/database-schema.md
+++ b/docs/database-schema.md
@@ -144,6 +144,11 @@ ## Main Relationships
 
 ## Modeling Notes
 
+### New Tables
+
+- **entities**: `id`, `name`, `slug` (unique, indexed), timestamps, soft deletes.
+- **entity_memberships**: `id`, `entity_id`, `user_id`, `role` (`employee` by default), timestamps, unique `(entity_id, user_id)`. Contains a generated column `owner_seq` for enforcing a single owner per entity (unique `(entity_id, owner_seq)`).
+
 - **Account vs member:** `users` is the login account (Laravel Auth); `entity_memberships` is the user's link to the entity with role.
 - **User↔entity cardinality:** `entity_memberships` is N:N by design (allows future multi-entity). In MVP, "one user per entity" rule is enforced in application; no global UK on `user_id`.
 - **Owner and circular FK:** `entities.owner_membership_id` points to the membership with `role = owner`. Since `entity_memberships.entity_id` references `entities`, the FK is circular — on bootstrap, create entity with `owner_membership_id` null, create owner membership, then fill the FK (or use deferrable constraint). Ownership transfer updates this FK and involved roles.
