+<?php
+
+namespace App\Livewire\Entity;
+
+use Livewire\Component;
+use Illuminate\Foundation\Auth\Access\AuthorizesRequests;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\Rules\Exists;
+use Illuminate\Validation\ValidationException;
+use App\Models\UserRole;
+
+class Members extends Component
+{
+    use AuthorizesRequests;
+
+    public Entity $entity;
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->entity = $entity;
+        $this->authorize('view', $entity);
+    }
+
+    public function addMember(): void
+    {
+        $this->validate(['email' => ['required', 'email', new Exists('users', 'email')]]);
+        $user = User::where('email', $this->email)->firstOrFail();
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw ValidationException::withMessages(['email' => __('validation.unique')]);
+        }
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee->value,
+        ]);
+        $this->email = '';
+        Log::info("Member added", ['entity_id' => $this->entity->id, 'user_id' => $user->id]);
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+        $this->authorize('assignRole', $membership);
+        if (!in_array($role, UserRole::manageable())) {
+            throw ValidationException::withMessages(['role' => __('validation.in')]);
+        }
+        $membership->update(['role' => $role]);
+        Log::info("Role updated", ['membership_id' => $membershipId, 'role' => $role]);
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+        $this->authorize('delete', $membership);
+        // Prevent removing last manager
+        if ($membership->role === UserRole::Admin->value) {
+            $adminCount = $this->entity->memberships()->where('role', UserRole::Admin->value)->count();
+            if ($adminCount <= 1 && $membership->role !== UserRole::Owner->value) {
+                abort(403, 'Cannot remove last manager');
+            }
+        }
+        $membership->delete();
+        Log::info("Member removed", ['membership_id' => $membershipId]);
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->get(),
+            'currentUser' => Auth::user(),
+        ]);
+    }
+}
