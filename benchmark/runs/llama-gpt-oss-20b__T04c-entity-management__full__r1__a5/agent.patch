+<?php
+
+namespace App\Livewire\Entity;
+
+use Livewire\Component;
+use Illuminate\Foundation\Auth\Access\AuthorizesRequests;
+use App\Models\Entity;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+use Illuminate\Support\Facades\Session;
+use App\Models\UserRole;
+use App\Models\EntityMembership;
+
+class Settings extends Component
+{
+    use AuthorizesRequests;
+
+    public Entity $entity;
+    public string $name = '';
+    public string $slug = '';
+    public int $targetMembershipId = 0;
+
+    public function mount(Entity $entity): void
+    {
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+        $this->authorize('manageSettings', $entity);
+    }
+
+    public function save(): void
+    {
+        $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => ['required', 'string', 'max:255', 'unique:entities,slug,' . $this->entity->id],
+        ]);
+        $this->entity->update(['name' => $this->name, 'slug' => $this->slug]);
+        Log::info("Entity settings updated", ['entity_id' => $this->entity->id]);
+    }
+
+    public function delete(): void
+    {
+        DB::transaction(function () {
+            $this->entity->memberships()->delete();
+            $this->entity->delete();
+        });
+        if (Session::get('current_entity_id') === $this->entity->id) {
+            Session::forget('current_entity_id');
+        }
+        Log::info("Entity deleted", ['entity_id' => $this->entity->id]);
+        return redirect()->route('home');
+    }
+
+    public function transfer(): void
+    {
+        $membership = EntityMembership::findOrFail($this->targetMembershipId);
+        if ($membership->entity_id !== $this->entity->id) {
+            abort(403, 'Invalid target');
+        }
+        if ($membership->role !== UserRole::Admin->value || $membership->user_id === auth()->id()) {
+            abort(403, 'Only admin other than current owner can be target');
+        }
+        DB::transaction(function () use ($membership) {
+            // Demote current owner
+            $this->entity->memberships()->where('role', UserRole::Owner->value)->update(['role' => UserRole::Admin->value]);
+            // Promote target
+            $membership->update(['role' => UserRole::Owner->value]);
+        });
+        Log::info("Ownership transferred", ['entity_id' => $this->entity->id, 'new_owner_id' => $membership->user_id]);
+        return redirect()->route('entity.dashboard', $this->entity->slug);
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.settings', [
+            'memberships' => $this->entity->memberships()->where('role', UserRole::Admin->value)->where('user_id', '!=', auth()->id())->get(),
+        ]);
+    }
+}
