+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    protected function currentEntity(): Entity
+    {
+        return Entity::query()->findOrFail($this->entity->id);
+    }
+
+    public function addMember(): void
+    {
+        $entity = $this->currentEntity();
+
+        $caller = auth()->user()?->membershipFor($entity->id);
+
+        if ($caller === null || ! in_array($caller->role, [UserRole::Owner, UserRole::Admin], true)) {
+            abort(403);
+        }
+
+        $validated = Validator::make(
+            ['email' => $this->email],
+            ['email' => ['required', 'email', 'exists:users,email']],
+        )->validate();
+
+        $target = User::where('email', $validated['email'])->firstOrFail();
+
+        $exists = EntityMembership::where('entity_id', $entity->id)
+            ->where('user_id', $target->id)
+            ->exists();
+
+        if ($exists) {
+            throw ValidationException::withMessages([
+                'email' => __('validation.unique', ['attribute' => 'email']),
+            ]);
+        }
+
+        EntityMembership::create([
+            'entity_id' => $entity->id,
+            'user_id' => $target->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->reset('email');
+    }
+
+    /**
+     * @param  mixed  $membershipId
+     */
+    public function assignRole($membershipId, string $role): void
+    {
+        $entity = $this->currentEntity();
+
+        $caller = auth()->user()?->membershipFor($entity->id);
+
+        if ($caller === null || ! in_array($caller->role, [UserRole::Owner, UserRole::Admin], true)) {
+            abort(403);
+        }
+
+        $validated = Validator::make(
+            ['role' => $role],
+            ['role' => ['required', Rule::in(['admin', 'employee'])]],
+        )->validate();
+
+        $membership = EntityMembership::where('entity_id', $entity->id)->findOrFail($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        $membership->role = UserRole::from($validated['role']);
+        $membership->save();
+    }
+
+    /**
+     * @param  mixed  $membershipId
+     */
+    public function removeMember($membershipId): void
+    {
+        $entity = $this->currentEntity();
+
+        $membership = EntityMembership::where('entity_id', $entity->id)->findOrFail($membershipId);
+
+        if ($membership->role === UserRole::Owner) {
+            abort(403);
+        }
+
+        $this->authorize('delete', $membership);
+
+        $managerCount = EntityMembership::where('entity_id', $entity->id)
+            ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+            ->count();
+
+        $isManager = in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+
+        if ($isManager && $managerCount <= 1) {
+            abort(403);
+        }
+
+        $membership->delete();
+    }
+
+    public function render(): View
+    {
+        $entity = $this->currentEntity();
+
+        return view('livewire.entity.members', [
+            'entity' => $entity,
+            'memberships' => EntityMembership::where('entity_id', $entity->id)->with('user')->get(),
+        ]);
+    }
+}
