@@ -0,0 +1,131 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public int $entityId;
+
+    public $name;
+
+    public $slug;
+
+    public $targetMembershipId;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+
+        $this->entityId = $entity->id;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    protected function currentEntity(): Entity
+    {
+        return Entity::query()->findOrFail($this->entityId);
+    }
+
+    public function save(): void
+    {
+        $entity = $this->currentEntity();
+
+        $this->authorize('manageSettings', $entity);
+
+        $validated = $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => ['required', 'string', 'max:255', Rule::unique('entities', 'slug')->ignore($entity->id)],
+        ]);
+
+        $entity->fill($validated);
+        $entity->save();
+    }
+
+    public function delete(): mixed
+    {
+        $entity = $this->currentEntity();
+
+        $this->authorize('manageSettings', $entity);
+
+        $entityId = $entity->id;
+
+        EntityMembership::where('entity_id', $entityId)->delete();
+        $entity->delete();
+
+        if ((int) session('current_entity_id') === (int) $entityId) {
+            session()->forget('current_entity_id');
+        }
+
+        return $this->redirect(route('home'));
+    }
+
+    public function transfer(): mixed
+    {
+        $entity = $this->currentEntity();
+
+        $this->authorize('manageSettings', $entity);
+
+        $owner = EntityMembership::where('entity_id', $entity->id)
+            ->where('role', UserRole::Owner)
+            ->first();
+
+        if ($owner === null) {
+            abort(403);
+        }
+
+        $target = EntityMembership::where('entity_id', $entity->id)
+            ->whereKey($this->targetMembershipId)
+            ->first();
+
+        if ($target === null) {
+            abort(403);
+        }
+
+        if ($target->role !== UserRole::Admin) {
+            abort(403);
+        }
+
+        if ($target->id === $owner->id) {
+            abort(403);
+        }
+
+        if ((int) $target->user_id === (int) auth()->id()) {
+            // The target must be another admin, not the caller phoning it in.
+            // The caller is the owner here, so this also implies target != owner.
+            // Keep the check explicit: caller must not be the target.
+            abort(403);
+        }
+
+        DB::transaction(function () use ($owner, $target) {
+            $owner->role = UserRole::Admin;
+            $owner->save();
+
+            $target->role = UserRole::Owner;
+            $target->save();
+        });
+
+        return $this->redirect(route('entity.dashboard', $entity->fresh()));
+    }
+
+    public function render(): View
+    {
+        $entity = $this->currentEntity();
+
+        return view('livewire.entity.settings', [
+            'entity' => $entity,
+            'memberships' => EntityMembership::where('entity_id', $entity->id)->with('user')->get(),
+        ]);
+    }
+}
