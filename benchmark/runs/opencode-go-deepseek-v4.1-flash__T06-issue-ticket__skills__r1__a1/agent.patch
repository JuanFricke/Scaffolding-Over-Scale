+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('queue factory creates an entity and is active by default', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity)->toBeInstanceOf(Entity::class)
+        ->and($queue->is_active)->toBeTrue()
+        ->and($queue->slug)->not->toBeEmpty()
+        ->and($queue->name)->not->toBeEmpty();
+});
+
+test('queue casts labels and exposes its entity tickets', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create([
+        'labels_i18n' => ['en' => 'Reception', 'pt_BR' => 'Recepção'],
+    ]);
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    expect($queue->fresh()->entity->is($entity))->toBeTrue()
+        ->and($queue->fresh()->labels_i18n)->toBe(['en' => 'Reception', 'pt_BR' => 'Recepção'])
+        ->and($queue->tickets()->pluck('id')->all())->toBe([$ticket->id])
+        ->and($entity->queues()->pluck('id')->all())->toBe([$queue->id]);
+});
+
+test('queue slug is unique within an entity but reusable by another entity', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->create(['slug' => 'reception']);
+
+    expect(fn () => Queue::factory()->for($entity)->create(['slug' => 'reception']))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    $other = Queue::factory()->create(['slug' => 'reception']);
+
+    expect($other->slug)->toBe('reception');
+});
