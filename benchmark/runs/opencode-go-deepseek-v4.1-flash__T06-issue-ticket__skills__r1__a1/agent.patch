+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has the required columns, unique slug per entity and defaults', function () {
+    expect(Schema::hasTable('queues'))->toBeTrue()
+        ->and(Schema::hasColumns('queues', [
+            'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('queues', 'queues_entity_id_slug_unique'))->toBeTrue();
+
+    $entity = Entity::factory()->create();
+    $id = DB::table('queues')->insertGetId([
+        'entity_id' => $entity->id,
+        'name' => 'Reception',
+        'slug' => 'reception',
+    ]);
+
+    $queue = DB::table('queues')->where('id', $id)->first();
+
+    expect((bool) $queue->is_active)->toBeTrue()
+        ->and($queue->labels_i18n)->toBeNull();
+});
+
+test('tickets table has the required columns, unique code per queue and lookup index', function () {
+    expect(Schema::hasTable('tickets'))->toBeTrue()
+        ->and(Schema::hasColumns('tickets', [
+            'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+            'issued_at', 'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_code_unique'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_status_priority_issued_at_index'))->toBeTrue();
+});
+
+test('deleting an entity cascades queues and tickets', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    Ticket::factory()->forQueue($queue)->create();
+
+    $entity->forceDelete();
+
+    expect(DB::table('queues')->where('id', $queue->id)->exists())->toBeFalse()
+        ->and(DB::table('tickets')->where('queue_id', $queue->id)->exists())->toBeFalse();
+});
+
+test('deleting a queue cascades its tickets', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    $queue->delete();
+
+    expect(Ticket::find($ticket->id))->toBeNull();
+});
