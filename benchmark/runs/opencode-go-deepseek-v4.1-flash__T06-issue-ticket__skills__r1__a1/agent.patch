+<?php
+
+namespace App\Models\Builders;
+
+use BackedEnum;
+use Illuminate\Database\Eloquent\Builder;
+
+class TicketBuilder extends Builder
+{
+    /**
+     * Fields that may still change after a ticket is issued.
+     *
+     * @var string[]
+     */
+    protected array $mutableColumns = [
+        'status',
+        'called_at',
+        'called_by_user_id',
+        'updated_at',
+    ];
+
+    /**
+     * Eloquent mass updates bypass model events, so enforce write-once here too.
+     */
+    public function update(array $values)
+    {
+        $immutable = array_diff(array_keys($values), $this->mutableColumns);
+
+        if ($immutable !== []) {
+            throw new \LogicException(
+                'Ticket fields are immutable after issuance: '.implode(', ', $immutable)
+            );
+        }
+
+        $values = array_map(
+            fn ($value) => $value instanceof BackedEnum ? $value->value : $value,
+            $values
+        );
+
+        return parent::update($values);
+    }
+}
