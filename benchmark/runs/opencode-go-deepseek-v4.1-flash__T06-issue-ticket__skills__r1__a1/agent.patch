+++ b/tests/Feature/Queue/IssueTicketTest.php
@@ -0,0 +1,85 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issuing a ticket uses the documented defaults', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
+
+test('issuing a ticket accepts a priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = (new IssueTicket)($queue, 10, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem);
+});
+
+test('issuing sequential tickets increments the code', function () {
+    $queue = Queue::factory()->create();
+    $action = new IssueTicket;
+
+    expect($action($queue)->code)->toBe('A001')
+        ->and($action($queue)->code)->toBe('A002')
+        ->and($action($queue)->code)->toBe('A003');
+});
+
+test('a negative priority is rejected without persisting', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new IssueTicket)($queue, -1))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('an inactive queue is rejected without persisting', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('a queue deactivated after it was loaded is still rejected', function () {
+    $queue = Queue::factory()->create();
+    $stale = Queue::find($queue->id);
+
+    Queue::whereKey($queue->id)->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($stale))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('a missing queue is rejected as inactive', function () {
+    $queue = Queue::factory()->create();
+    $queue->delete();
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::count())->toBe(0);
+});
