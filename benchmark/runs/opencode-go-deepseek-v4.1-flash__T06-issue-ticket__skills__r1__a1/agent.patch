new file mode 100644
index 0000000..398943c
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,158 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Builders\TicketBuilder;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+
+#[Fillable([
+    'queue_id',
+    'code',
+    'priority',
+    'channel',
+    'status',
+    'issued_at',
+    'called_at',
+    'called_by_user_id',
+])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields that may still change after a ticket is issued.
+     *
+     * @var string[]
+     */
+    protected const MUTABLE_COLUMNS = [
+        'status',
+        'called_at',
+        'called_by_user_id',
+        'updated_at',
+    ];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        static::creating(function (Ticket $ticket) {
+            if ($ticket->code === null || $ticket->code === '') {
+                $ticket->code = static::nextCode((int) $ticket->queue_id);
+            }
+        });
+
+        static::created(function (Ticket $ticket) {
+            static::advanceQueueSequence($ticket);
+        });
+
+        static::updating(function (Ticket $ticket) {
+            $immutable = array_diff(array_keys($ticket->getDirty()), self::MUTABLE_COLUMNS);
+
+            if ($immutable !== []) {
+                throw new \LogicException(
+                    'Ticket fields are immutable after issuance: '.implode(', ', $immutable)
+                );
+            }
+        });
+    }
+
+    public function newEloquentBuilder($query): TicketBuilder
+    {
+        return new TicketBuilder($query);
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Resolve the next display code for a queue.
+     *
+     * Valid codes are `A` followed by digits. The highest numeric value wins (not
+     * the lexicographically highest code), so A999 is followed by A1000. The
+     * queue keeps a high-water mark so a deleted ticket's number is never reused,
+     * and malformed legacy codes are ignored.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $highest = (int) Queue::query()->whereKey($queueId)->value('last_ticket_number');
+
+        foreach (static::query()->where('queue_id', $queueId)->pluck('code') as $code) {
+            if (preg_match('/^A(\d+)$/', (string) $code, $matches) === 1) {
+                $highest = max($highest, (int) $matches[1]);
+            }
+        }
+
+        return sprintf('A%03d', $highest + 1);
+    }
+
+    /**
+     * Move the queue's high-water mark forward without ever moving it back.
+     */
+    protected static function advanceQueueSequence(Ticket $ticket): void
+    {
+        if (preg_match('/^A(\d+)$/', (string) $ticket->code, $matches) !== 1) {
+            return;
+        }
+
+        DB::table('queues')
+            ->where('id', $ticket->queue_id)
+            ->where('last_ticket_number', '<', (int) $matches[1])
+            ->update(['last_ticket_number' => (int) $matches[1]]);
+    }
+
+    /**
+     * Call this ticket once, recording when and by whom.
+     *
+     * @throws AuthorizationException when the user is not a member of the ticket's entity
+     * @throws \LogicException when the ticket has already left the waiting state
+     */
+    public function call(User $user): void
+    {
+        DB::transaction(function () use ($user) {
+            $fresh = static::query()->whereKey($this->getKey())->lockForUpdate()->firstOrFail();
+            $queue = $fresh->queue()->firstOrFail();
+
+            if (! $user->membershipFor($queue->entity_id)) {
+                throw new AuthorizationException('You are not a member of this ticket entity.');
+            }
+
+            if ($fresh->status !== TicketStatus::Waiting) {
+                throw new \LogicException('Only waiting tickets can be called.');
+            }
+
+            $this->setRawAttributes($fresh->getAttributes(), true);
+            $this->status = TicketStatus::Called;
+            $this->called_at = now();
+            $this->called_by_user_id = $user->getKey();
+            $this->save();
+        });
+    }
+}
