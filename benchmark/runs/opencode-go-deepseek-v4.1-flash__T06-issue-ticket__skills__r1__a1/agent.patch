@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Issue a new waiting ticket into a queue.
+     *
+     * The queue is re-read and locked inside the transaction so a deactivated
+     * queue cannot issue tickets through a stale model instance.
+     */
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be zero or greater.');
+        }
+
+        $attempt = 0;
+
+        while (true) {
+            $attempt++;
+
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    $lockedQueue = Queue::query()
+                        ->whereKey($queue->getKey())
+                        ->lockForUpdate()
+                        ->first();
+
+                    if (! $lockedQueue || ! $lockedQueue->is_active) {
+                        throw new InactiveQueueException('Inactive queues cannot issue tickets.');
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $lockedQueue->id,
+                        'code' => Ticket::nextCode($lockedQueue->id),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (UniqueConstraintViolationException $exception) {
+                if ($attempt >= 5) {
+                    throw $exception;
+                }
+            }
+        }
+    }
+}
