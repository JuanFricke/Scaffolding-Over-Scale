@@ -0,0 +1,73 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Entity $entity): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->employee()->create();
+
+    return $user;
+}
+
+test('a member of the entity can call a waiting ticket once', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+    $user = memberOf($queue->entity);
+
+    $ticket->call($user);
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($user->id)
+        ->and($ticket->fresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->fresh()->called_by_user_id)->toBe($user->id);
+});
+
+test('a non-member cannot call a ticket and it stays unchanged', function () {
+    $ticket = Ticket::factory()->create();
+    $outsider = User::factory()->create();
+    EntityMembership::factory()->for(Entity::factory()->create())->for($outsider)->create();
+
+    expect(fn () => $ticket->call($outsider))
+        ->toThrow(AuthorizationException::class);
+
+    $fresh = $ticket->fresh();
+
+    expect($fresh->status)->toBe(TicketStatus::Waiting)
+        ->and($fresh->called_at)->toBeNull()
+        ->and($fresh->called_by_user_id)->toBeNull();
+});
+
+test('a ticket cannot be called twice', function () {
+    $ticket = Ticket::factory()->create();
+    $user = memberOf($ticket->queue->entity);
+
+    $ticket->call($user);
+    $calledAt = $ticket->called_at;
+    $calledBy = $ticket->called_by_user_id;
+
+    expect(fn () => $ticket->call($user))->toThrow(LogicException::class);
+
+    expect($ticket->fresh()->called_at->equalTo($calledAt))->toBeTrue()
+        ->and($ticket->fresh()->called_by_user_id)->toBe($calledBy);
+});
+
+test('a ticket that is already called cannot be called through a stale instance', function () {
+    $ticket = Ticket::factory()->create();
+    $user = memberOf($ticket->queue->entity);
+    $stale = Ticket::find($ticket->id);
+
+    $ticket->call($user);
+
+    expect(fn () => $stale->call($user))->toThrow(LogicException::class);
+});
diff --git a/tests/Feature/Queue/IssueTicketTest.php b/tests/Feature/Queue/IssueTicketTest.php
