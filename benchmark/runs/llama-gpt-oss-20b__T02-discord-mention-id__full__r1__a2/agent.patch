diff --git a/.env.example b/.env.example
index 2cf633c..6c0ae6e 100644
--- a/.env.example
+++ b/.env.example
@@ -75,6 +75,7 @@ TELESCOPE_ENABLED=true
 
 # Discord ops alerts (incoming webhook). Empty = no-op. Alerts only — not a log sink.
 DISCORD_WEBHOOK_URL=
+DISCORD_MENTION_ID=
 
 # Hostinger / PegaFila ops (bin/pf) — never commit real secrets.
 # GitHub Actions: store the same key as repository secret HOSTINGER_API
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..89c2ac3 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,6 +66,23 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
+        // Build mention if configured
+        $mentionId = config('services.discord.mention_id');
+        $mention = '';
+        if (is_string($mentionId)) {
+            $mentionId = trim($mentionId);
+            if (preg_match('/^\d{17,20}$/', $mentionId)) {
+                $mention = '<@'.$mentionId.'>';
+            }
+        }
+
+        if ($mention !== '') {
+            $content = implode("\n", $lines);
+            $maxForContent = self::MaxContentLength - mb_strlen($mention) - 1; // newline
+            $content = mb_substr($content, 0, $maxForContent);
+            return $content."\n".$mention;
+        }
+
         return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
     }
 
