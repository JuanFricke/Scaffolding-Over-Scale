--- /dev/null
+++ b/app/Livewire/Auth/Login.php
@@ -0,0 +1,57 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use Illuminate\Foundation\Auth\Guard;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Facades\Str;
+use Livewire\Component;
+use Illuminate\Foundation\Support\Facades\Hash;
+
+class Login extends Component
+{
+    public string $email = '';
+    public string $password = '';
+    public bool $remember = false;
+
+    public function mount(): void
+    {
+        if (Auth::check()) {
+            $this->redirect(route('home'));
+        }
+    }
+
+    public function submit(): void
+    {
+        $this->validate([
+            'email' => ['required', 'email'],
+            'password' => ['required'],
+            'remember' => ['boolean'],
+        ]);
+
+        $key = Str::lower($this->email) . '|' . request()->ip();
+        if (RateLimiter::tooManyAttempts('login:'.$key, 5)) {
+            $seconds = RateLimiter::availableIn('login:'.$key);
+            $this->addError('email', __('auth.throttle', ['seconds' => $seconds]));
+            return;
+        }
+
+        if (!Auth::attempt(['email' => $this->email, 'password' => $this->password], $this->remember)) {
+            RateLimiter::hit('login:'.$key, 60); // 60 seconds decay
+            $this->addError('email', __('auth.failed'));
+            return;
+        }
+
+        RateLimiter::clear('login:'.$key);
+        request()->session()->regenerate();
+        $this->redirect(route('home'));
+    }
+
+    public function render(): \
+    \Illuminate\View\View
+    {
+        return view('livewire.auth.login');
+    }
+}
