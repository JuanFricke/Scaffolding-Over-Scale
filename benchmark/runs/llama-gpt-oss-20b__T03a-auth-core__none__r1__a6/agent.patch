new file mode 100644
index 0000000..883f286
--- /dev/null
+++ b/app/Livewire/Auth/Register.php
@@ -0,0 +1,69 @@
+<?php
+
+namespace App\Livewire\Auth;
+
+use App\Models\User;
+use Illuminate\Foundation\Auth\AuthManager;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\Str;
+use Illuminate\Support\Facades\Password;
+use Livewire\Component;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Validation\Rules\Password as PasswordRule;
+
+class Register extends Component
+{
+    public string $name = '';
+    public string $email = '';
+    public string $password = '';
+    public string $password_confirmation = '';
+
+    public function mount(): void
+    {
+        if (Auth::check()) {
+            $this->redirect(route('home'));
+        }
+    }
+
+    public function submit(): void
+    {
+        $this->validate([
+            'name' => ['required', 'string', 'max:255'],
+            'email' => ['required', 'string', 'email', 'max:255', 'unique:users,email'],
+            'password' => ['required', 'confirmed', PasswordRule::defaults()],
+            'password_confirmation' => ['required'],
+        ]);
+
+        $ip = request()->ip();
+        $key = Str::transliterate('register|'.$ip);
+        if (RateLimiter::tooManyAttempts('register:'.$key, 5)) {
+            $seconds = RateLimiter::availableIn('register:'.$key);
+            $this->addError('email', __('auth.throttle', ['seconds' => $seconds]));
+            return;
+        }
+
+        // Hit the limiter on every attempt
+        RateLimiter::hit('register:'.$key, 60);
+
+        $user = User::create([
+            'name' => $this->name,
+            'email' => $this->email,
+            'password' => Hash::make($this->password),
+        ]);
+
+        // Clear after successful registration
+        RateLimiter::clear('register:'.$key);
+
+        event(new Registered($user));
+        Auth::login($user);
+        request()->session()->regenerate();
+        $this->redirect(route('home'));
+    }
+
+    public function render(): \Illuminate\View\View
+    {
+        return view('livewire.auth.register');
+    }
+}
