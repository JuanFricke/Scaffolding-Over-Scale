diff --git a/tests/Feature/LocalizationTest.php b/tests/Feature/LocalizationTest.php
new file mode 100644
index 0000000..8313109
--- /dev/null
+++ b/tests/Feature/LocalizationTest.php
@@ -0,0 +1,69 @@
+<?php
+
+use Illuminate\Support\Arr;
+
+test('the test suite runs in pt_BR with an English fallback', function () {
+    expect(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('.env.example ships the Portuguese defaults', function () {
+    $env = file_get_contents(base_path('.env.example'));
+
+    expect($env)->toContain("APP_NAME=PegaFila\n")
+        ->toContain("APP_LOCALE=pt_BR\n")
+        ->toContain("APP_FALLBACK_LOCALE=en\n");
+});
+
+test('the login page is in Portuguese by default', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Entrar')
+        ->assertSee('Senha')
+        ->assertSee('Esqueceu a senha?')
+        ->assertSee('<html lang="pt-BR">', false);
+});
+
+test('the login page is in English with locale en and shows no Portuguese', function () {
+    app()->setLocale('en');
+
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSee('Log in')
+        ->assertDontSee('Entrar')
+        ->assertDontSee('Senha')
+        ->assertDontSee('Esqueceu')
+        ->assertSee('<html lang="en">', false);
+});
+
+test('ui translations have the same keys in both locales', function () {
+    $en = array_keys(Arr::dot(require lang_path('en/ui.php')));
+    $pt = array_keys(Arr::dot(require lang_path('pt_BR/ui.php')));
+
+    expect($pt)->toEqualCanonicalizing($en);
+});
+
+test('every ui key used by views resolves in both locales', function () {
+    $files = glob(resource_path('views').'/{*,*/*,*/*/*}.blade.php', GLOB_BRACE);
+    $keys = [];
+    foreach ($files as $file) {
+        preg_match_all("/__\\('(ui\\.[a-z0-9_.]+)'/", file_get_contents($file), $m);
+        $keys = array_merge($keys, $m[1]);
+    }
+    foreach (glob(app_path('Livewire/Auth').'/*.php') as $file) {
+        preg_match_all("/__\\('(ui\\.[a-z0-9_.]+)'/", file_get_contents($file), $m);
+        $keys = array_merge($keys, $m[1]);
+    }
+
+    expect($keys)->not->toBeEmpty();
+    foreach (array_unique($keys) as $key) {
+        expect(trans($key, [], 'en'))->not->toBe($key)
+            ->and(trans($key, [], 'pt_BR'))->not->toBe($key);
+    }
+});
+
+test('password and auth language lines exist in Portuguese', function () {
+    expect(__('auth.failed'))->toStartWith('Essas credenciais')
+        ->and(__('auth.throttle', ['seconds' => 3]))->toContain('3')
+        ->and(__('passwords.sent'))->toStartWith('Enviamos');
+});
diff --git a/tests/Feature/ViewConventionsTest.php b/tests/Feature/ViewConventionsTest.php
new file mode 100644
index 0000000..c88635c
--- /dev/null
+++ b/tests/Feature/ViewConventionsTest.php
@@ -0,0 +1,34 @@
+<?php
+
+use Symfony\Component\Finder\Finder;
+
+test('views never hardcode internal hrefs or form actions', function () {
+    $offenders = [];
+    foreach ((new Finder)->files()->in(resource_path('views'))->name('*.blade.php') as $file) {
+        if (preg_match('/(href|action)\s*=\s*["\']\//i', $file->getContents())) {
+            $offenders[] = $file->getRelativePathname();
+        }
+    }
+
+    expect($offenders)->toBe([]);
+});
+
+test('auth classes redirect with named routes', function () {
+    $offenders = [];
+    $paths = [app_path('Http/Controllers'), app_path('Livewire')];
+    foreach ((new Finder)->files()->in($paths)->name('*.php') as $file) {
+        if (preg_match('/redirect\(\s*[\'"]\//', $file->getContents())) {
+            $offenders[] = $file->getRelativePathname();
+        }
+    }
+
+    expect($offenders)->toBe([]);
+});
+
+test('inputs bind with plain wire:model', function () {
+    foreach (['login', 'register'] as $view) {
+        $html = file_get_contents(resource_path("views/livewire/auth/{$view}.blade.php"));
+
+        expect($html)->not->toMatch('/wire:model\./');
+    }
+});
