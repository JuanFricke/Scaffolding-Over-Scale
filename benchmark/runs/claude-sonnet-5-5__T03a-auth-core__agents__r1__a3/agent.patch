diff --git a/tests/Feature/Auth/LoginTest.php b/tests/Feature/Auth/LoginTest.php
new file mode 100644
index 0000000..5726418
--- /dev/null
+++ b/tests/Feature/Auth/LoginTest.php
@@ -0,0 +1,138 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Models\User;
+use Illuminate\Auth\Events\Lockout;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('the login page renders for guests', function () {
+    $this->get(route('login'))
+        ->assertOk()
+        ->assertSeeLivewire(Login::class);
+});
+
+test('authenticated users are redirected from login to home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('login'))
+        ->assertRedirect(route('home'));
+});
+
+test('a user can log in and the session id is regenerated', function () {
+    $user = User::factory()->create();
+    $before = session()->getId();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+    expect(session()->getId())->not->toBe($before);
+});
+
+test('login redirects to the intended url', function () {
+    $user = User::factory()->create();
+
+    $this->get(route('home'))->assertRedirect(route('login'));
+    $this->get(route('verification.notice'))->assertRedirect(route('login'));
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('remember me sets the remember cookie', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->set('remember', true)
+        ->call('submit');
+
+    expect($user->fresh()->getRememberToken())->not->toBeEmpty();
+    $this->assertAuthenticatedAs($user);
+});
+
+test('wrong credentials raise auth.failed on email', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong-password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')])
+        ->assertSet('password', '');
+
+    $this->assertGuest();
+    expect(__('auth.failed'))->toStartWith('Essas credenciais não correspondem');
+});
+
+test('an unknown email raises the same error', function () {
+    Livewire::test(Login::class)
+        ->set('email', 'nobody@example.com')
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+});
+
+test('email and password are required and the email must be valid', function () {
+    Livewire::test(Login::class)
+        ->call('submit')
+        ->assertHasErrors(['email' => 'required', 'password' => 'required']);
+
+    Livewire::test(Login::class)
+        ->set('email', 'not-an-email')
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'email']);
+
+    $this->assertGuest();
+});
+
+test('failed attempts are rate limited per lowercase email and ip', function () {
+    Event::fake([Lockout::class]);
+    $user = User::factory()->create();
+
+    foreach (range(1, 5) as $_) {
+        Livewire::test(Login::class)
+            ->set('email', strtoupper($user->email))
+            ->set('password', 'wrong-password')
+            ->call('submit')
+            ->assertHasErrors(['email' => __('auth.failed')]);
+    }
+
+    // Locked: even the right password is refused, whatever the e-mail casing.
+    $component = Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas');
+    $this->assertGuest();
+    Event::assertDispatched(Lockout::class);
+});
+
+test('the rate limiter is cleared after a successful login', function () {
+    $user = User::factory()->create();
+    $key = str()->transliterate(str()->lower($user->email).'|127.0.0.1');
+    RateLimiter::hit($key);
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    expect(RateLimiter::attempts($key))->toBe(0);
+});
