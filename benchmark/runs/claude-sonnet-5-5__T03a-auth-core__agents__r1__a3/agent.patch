diff --git a/tests/Feature/Auth/EmailVerificationTest.php b/tests/Feature/Auth/EmailVerificationTest.php
new file mode 100644
index 0000000..45e46f4
--- /dev/null
+++ b/tests/Feature/Auth/EmailVerificationTest.php
@@ -0,0 +1,131 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\Verified;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Contracts\Auth\MustVerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\URL;
+
+uses(RefreshDatabase::class);
+
+function verificationUrl(User $user, ?string $id = null, ?string $hash = null): string
+{
+    return URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $id ?? $user->getKey(),
+        'hash' => $hash ?? sha1($user->getEmailForVerification()),
+    ]);
+}
+
+test('the user implements MustVerifyEmail', function () {
+    expect(new User)->toBeInstanceOf(MustVerifyEmail::class);
+});
+
+test('the notice page renders for unverified users', function () {
+    $this->actingAs(User::factory()->unverified()->create())
+        ->get(route('verification.notice'))
+        ->assertOk()
+        ->assertSee(route('verification.send'), false);
+});
+
+test('the notice page redirects verified users home and guests to login', function () {
+    $this->actingAs(User::factory()->create())->get(route('verification.notice'))->assertRedirect(route('home'));
+    auth()->logout();
+    $this->get(route('verification.notice'))->assertRedirect(route('login'));
+});
+
+test('a valid signed link verifies the user and redirects home', function () {
+    Event::fake([Verified::class]);
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($user))->assertRedirect(route('home'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+    Event::assertDispatched(Verified::class);
+});
+
+test('a link with a tampered id returns 403 and verifies nobody', function () {
+    $victim = User::factory()->unverified()->create();
+    $attacker = User::factory()->unverified()->create();
+
+    $this->actingAs($attacker)
+        ->get(verificationUrl($victim))
+        ->assertForbidden();
+
+    expect($victim->fresh()->hasVerifiedEmail())->toBeFalse()
+        ->and($attacker->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a link with a wrong hash returns 403', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->get(verificationUrl($user, hash: sha1('other@example.com')))->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('an unsigned link is rejected', function () {
+    $user = User::factory()->unverified()->create();
+    $url = route('verification.verify', ['id' => $user->id, 'hash' => sha1($user->email)]);
+
+    $this->actingAs($user)->get($url)->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a guest following a link is sent to login', function () {
+    $user = User::factory()->unverified()->create();
+
+    $this->get(verificationUrl($user))->assertRedirect(route('login'));
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('the verification link is throttled', function () {
+    $user = User::factory()->unverified()->create();
+    $url = verificationUrl($user, hash: 'bad');
+
+    foreach (range(1, 6) as $_) {
+        $this->actingAs($user)->get($url)->assertForbidden();
+    }
+
+    $this->actingAs($user)->get($url)->assertStatus(429);
+});
+
+test('the verification mail can be resent', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)
+        ->from(route('verification.notice'))
+        ->post(route('verification.send'))
+        ->assertRedirect(route('verification.notice'))
+        ->assertSessionHas('status');
+
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('resending for a verified user sends nothing and redirects home', function () {
+    Notification::fake();
+
+    $this->actingAs(User::factory()->create())
+        ->post(route('verification.send'))
+        ->assertRedirect(route('home'));
+
+    Notification::assertNothingSent();
+});
+
+test('resending is throttled and requires authentication', function () {
+    $this->post(route('verification.send'))->assertRedirect(route('login'));
+
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    foreach (range(1, 6) as $_) {
+        $this->actingAs($user)->post(route('verification.send'))->assertRedirect();
+    }
+
+    $this->actingAs($user)->post(route('verification.send'))->assertStatus(429);
+});
