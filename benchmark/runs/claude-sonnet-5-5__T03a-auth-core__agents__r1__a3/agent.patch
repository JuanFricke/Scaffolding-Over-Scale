diff --git a/tests/Feature/Auth/PasswordResetTest.php b/tests/Feature/Auth/PasswordResetTest.php
new file mode 100644
index 0000000..e8d6777
--- /dev/null
+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,123 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password page renders for guests', function () {
+    $this->get(route('password.request'))->assertOk();
+    expect(route('password.request', absolute: false))->toBe('/forgot-password');
+});
+
+test('a reset link is sent to an existing user', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('an unknown e-mail gets the same answer and nothing is sent', function () {
+    Notification::fake();
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertSessionHas('status', __('passwords.sent'))
+        ->assertSessionHasNoErrors();
+
+    Notification::assertNothingSent();
+    expect(__('passwords.sent'))->toStartWith('Enviamos um link');
+});
+
+test('a malformed e-mail is a validation error', function () {
+    $this->post(route('password.email'), ['email' => 'nope'])
+        ->assertSessionHasErrors('email');
+});
+
+test('forgot password is throttled at 6 requests per minute', function () {
+    foreach (range(1, 6) as $_) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertSessionHas('status');
+    }
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertStatus(429);
+});
+
+test('the reset form asks for the e-mail once', function () {
+    $html = $this->get(route('password.reset', ['token' => 'abc', 'email' => 'maria@example.com']))
+        ->assertOk()
+        ->assertSee('value="maria@example.com"', false)
+        ->getContent();
+
+    expect(substr_count($html, 'name="email"'))->toBe(1)
+        ->and(substr_count($html, 'name="token"'))->toBe(1)
+        ->and($html)->toContain('value="abc"');
+});
+
+test('a password can be reset and the remember token rotates', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old-remember-token']);
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])
+        ->assertRedirect(route('login'))
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('NewSecret123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old-remember-token')
+        ->and($user->remember_token)->not->toBeEmpty();
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('an invalid token is rejected', function () {
+    $user = User::factory()->create();
+    $hash = $user->password;
+
+    $this->from(route('password.reset', 'bad'))
+        ->post(route('password.update'), [
+            'token' => 'bad',
+            'email' => $user->email,
+            'password' => 'NewSecret123',
+            'password_confirmation' => 'NewSecret123',
+        ])
+        ->assertSessionHasErrors(['email' => __('passwords.token')]);
+
+    expect($user->fresh()->password)->toBe($hash);
+});
+
+test('an unknown e-mail is indistinguishable from an invalid token', function () {
+    $this->post(route('password.update'), [
+        'token' => 'whatever',
+        'email' => 'nobody@example.com',
+        'password' => 'NewSecret123',
+        'password_confirmation' => 'NewSecret123',
+    ])->assertSessionHasErrors(['email' => __('passwords.token')]);
+});
+
+test('the new password follows the default rule and must be confirmed', function () {
+    $user = User::factory()->create();
+    $token = Password::createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token, 'email' => $user->email,
+        'password' => 'weak', 'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+
+    $this->post(route('password.update'), [
+        'token' => $token, 'email' => $user->email,
+        'password' => 'NewSecret123', 'password_confirmation' => 'Different123',
+    ])->assertSessionHasErrors('password');
+});
diff --git a/tests/Feature/Auth/RegisterTest.php b/tests/Feature/Auth/RegisterTest.php
new file mode 100644
index 0000000..f0d4640
--- /dev/null
+++ b/tests/Feature/Auth/RegisterTest.php
@@ -0,0 +1,153 @@
+<?php
+
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\Registered;
+use Illuminate\Auth\Middleware\RedirectIfAuthenticated;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Validation\Rules\Password;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function registration(string $email = 'maria@example.com'): array
+{
+    return [
+        'name' => 'Maria Souza',
+        'email' => $email,
+        'password' => 'Secret123',
+        'password_confirmation' => 'Secret123',
+    ];
+}
+
+function fillRegistration($component, array $data)
+{
+    foreach ($data as $key => $value) {
+        $component->set($key, $value);
+    }
+
+    return $component;
+}
+
+test('the register page renders for guests', function () {
+    $this->get(route('register'))->assertOk()->assertSeeLivewire(Register::class);
+});
+
+test('authenticated users are redirected from register to home', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('register'))
+        ->assertRedirect(route('home'));
+});
+
+test('a guest can register, is logged in and gets a verification mail', function () {
+    Notification::fake();
+    $before = session()->getId();
+
+    fillRegistration(Livewire::test(Register::class), registration())
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'maria@example.com')->firstOrFail();
+    expect($user->email_verified_at)->toBeNull()
+        ->and(Hash::check('Secret123', $user->password))->toBeTrue()
+        ->and(session()->getId())->not->toBe($before);
+    $this->assertAuthenticatedAs($user);
+    Notification::assertSentTo($user, VerifyEmail::class);
+});
+
+test('the Registered event is fired', function () {
+    Event::fake([Registered::class]);
+
+    fillRegistration(Livewire::test(Register::class), registration())->call('submit');
+
+    Event::assertDispatched(Registered::class);
+});
+
+test('the e-mail is normalised to lowercase', function () {
+    fillRegistration(Livewire::test(Register::class), registration('Maria@Example.COM'))->call('submit');
+
+    expect(User::where('email', 'maria@example.com')->exists())->toBeTrue();
+});
+
+test('a mismatched confirmation fails the confirmed rule', function () {
+    fillRegistration(Livewire::test(Register::class), [...registration(), 'password_confirmation' => 'Other1234'])
+        ->call('submit')
+        ->assertHasErrors(['password' => 'confirmed']);
+
+    expect(User::count())->toBe(0);
+});
+
+test('the app-wide default password rule is applied', function () {
+    expect(Password::default())->toEqual(Password::min(8)->letters()->mixedCase()->numbers());
+
+    foreach (['Short1a', 'alllowercase1', 'ALLUPPERCASE1', 'NoDigitsHere'] as $weak) {
+        Livewire::test(Register::class)
+            ->set('name', 'Maria')
+            ->set('email', 'maria@example.com')
+            ->set('password', $weak)
+            ->set('password_confirmation', $weak)
+            ->call('submit')
+            ->assertHasErrors('password');
+    }
+
+    expect(User::count())->toBe(0);
+});
+
+test('name and strict unique e-mail are required', function () {
+    User::factory()->create(['email' => 'taken@example.com']);
+
+    Livewire::test(Register::class)->call('submit')
+        ->assertHasErrors(['name' => 'required', 'email' => 'required', 'password' => 'required']);
+
+    fillRegistration(Livewire::test(Register::class), registration('taken@example.com'))
+        ->call('submit')->assertHasErrors(['email' => 'unique']);
+
+    fillRegistration(Livewire::test(Register::class), registration('Taken@Example.com'))
+        ->call('submit')->assertHasErrors(['email' => 'unique']);
+
+    foreach (['not-an-email', 'a@@example.com', 'maria@', 'maria@localhost', 'maria @example.com'] as $bad) {
+        fillRegistration(Livewire::test(Register::class), registration($bad))
+            ->call('submit')->assertHasErrors('email');
+    }
+});
+
+test('registration is rate limited by ip', function () {
+    $key = str()->transliterate('register|127.0.0.1');
+
+    foreach (range(1, 5) as $i) {
+        fillRegistration(Livewire::test(Register::class), registration("user{$i}@example.com"))
+            ->call('submit')->assertHasNoErrors();
+    }
+    expect(RateLimiter::attempts($key))->toBe(5);
+
+    $component = fillRegistration(Livewire::test(Register::class), registration('user6@example.com'))
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    expect($component->errors()->first('email'))->toContain('Muitas tentativas');
+    expect(User::where('email', 'user6@example.com')->exists())->toBeFalse();
+});
+
+test('invalid attempts count against the limit too', function () {
+    $key = str()->transliterate('register|127.0.0.1');
+
+    foreach (range(1, 5) as $_) {
+        Livewire::test(Register::class)->call('submit')->assertHasErrors('name');
+    }
+
+    fillRegistration(Livewire::test(Register::class), registration())
+        ->call('submit')->assertHasErrors('email');
+    expect(User::count())->toBe(0);
+    RateLimiter::clear($key);
+});
+
+test('guest-only middleware is persisted for livewire update requests', function () {
+    expect(Livewire::getPersistentMiddleware())
+        ->toContain(RedirectIfAuthenticated::class);
+});
