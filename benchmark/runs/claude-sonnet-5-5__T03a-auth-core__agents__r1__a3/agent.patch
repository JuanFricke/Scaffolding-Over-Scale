@@ -0,0 +1,47 @@
+<?php
+
+namespace App\Http\Controllers\Auth;
+
+use App\Http\Controllers\Controller;
+use Illuminate\Contracts\View\View;
+use Illuminate\Foundation\Auth\EmailVerificationRequest;
+use Illuminate\Http\RedirectResponse;
+use Illuminate\Http\Request;
+
+class EmailVerificationController extends Controller
+{
+    /**
+     * Show the "verify your e-mail" notice.
+     */
+    public function notice(Request $request): View|RedirectResponse
+    {
+        return $request->user()->hasVerifiedEmail()
+            ? redirect()->route('home')
+            : view('auth.verify-email');
+    }
+
+    /**
+     * Verify the logged-in user. The request authorizes that the link's id and
+     * hash belong to that very user, otherwise it answers 403.
+     */
+    public function verify(EmailVerificationRequest $request): RedirectResponse
+    {
+        $request->fulfill();
+
+        return redirect()->route('home');
+    }
+
+    /**
+     * Resend the verification mail (nothing is sent to verified users).
+     */
+    public function send(Request $request): RedirectResponse
+    {
+        if ($request->user()->hasVerifiedEmail()) {
+            return redirect()->route('home');
+        }
+
+        $request->user()->sendEmailVerificationNotification();
+
+        return redirect()->route('verification.notice')->with('status', __('ui.verify.sent'));
+    }
+}
