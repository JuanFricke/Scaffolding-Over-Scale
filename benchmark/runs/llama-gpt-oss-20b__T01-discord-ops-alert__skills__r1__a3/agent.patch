diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..a5b7782
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,116 @@
+<?php
+
+namespace App\
+Ops;
+
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Config;
+
+/**
+ * Simple Discord ops notifier.
+ *
+ * Sends a plain text alert to a Discord webhook when configured.
+ */
+class DiscordOpsAlert
+{
+    /**
+     * Send an alert to Discord.
+     *
+     * @param string $title   Alert title
+     * @param string $message Alert body
+     * @param array  $context Optional context data
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = Config::get('services.discord.webhook_url');
+        if (empty($url)) {
+            return; // silent no-op
+        }
+
+        // Prepare payload content
+        $payload = $this->buildContent($title, $message, $context);
+
+        try {
+            $response = Http::timeout(5)->post($url, ['content' => $payload]);
+            if ($response->failed()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (\Throwable $e) {
+            // Remove webhook URL from message if present
+            $sanitized = $this->sanitizeExceptionMessage($e->getMessage(), $url);
+            Log::error('Discord ops alert exception', [
+                'exception' => $sanitized,
+            ]);
+        }
+    }
+
+    /**
+     * Build the message payload, applying truncation and redaction.
+     */
+    private function buildContent(string $title, string $message, array $context): string
+    {
+        $redactedContext = $this->redactContext($context);
+
+        $lines = [];
+        $lines[] = $title;
+        if ($message !== '') {
+            $lines[] = $message;
+        }
+
+        foreach ($redactedContext as $key => $value) {
+            $lines[] = $key . '=' . $value;
+        }
+
+        $full = implode("\n", $lines);
+
+        // Ensure we stay within Discord limit (2000). We truncate to 1800.
+        if (mb_strlen($full) > 1800) {
+            $full = mb_substr($full, 0, 1800);
+        }
+
+        return $full;
+    }
+
+    /**
+     * Recursively redact sensitive data.
+     */
+    private function redactContext(array $data): array
+    {
+        $sensitiveKeyPattern = '/^(password|token|secret|authorization|api[_-]?key|webhook)$/i';
+
+        foreach ($data as $key => $value) {
+            $isSensitiveKey = preg_match($sensitiveKeyPattern, $key) === 1;
+
+            if (is_array($value)) {
+                $redacted = $this->redactContext($value);
+                $data[$key] = json_encode($redacted, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES);
+                continue;
+            }
+
+            if (is_string($value)) {
+                if (preg_match('/Bearer\s+.+/i', $value)) {
+                    $value = '[redacted]';
+                } elseif ($isSensitiveKey) {
+                    $value = '[redacted]';
+                }
+            } elseif ($isSensitiveKey) {
+                $value = '[redacted]';
+            }
+
+            $data[$key] = $value;
+        }
+
+        return $data;
+    }
+
+    /**
+     * Sanitize exception message by removing any occurrence of the webhook URL.
+     */
+    private function sanitizeExceptionMessage(string $message, string $url): string
+    {
+        return str_replace($url, '<redacted-url>', $message);
+    }
+}
