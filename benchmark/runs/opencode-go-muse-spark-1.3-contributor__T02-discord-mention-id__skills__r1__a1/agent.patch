 # Discord ops alerts (incoming webhook). Empty = no-op. Alerts only — not a log sink.
 DISCORD_WEBHOOK_URL=
+# Optional Discord user ID to ping on every ops alert (17-20 digit snowflake). Empty = no mention.
+DISCORD_MENTION_ID=
 
