diff --git a/CHANGELOG.md b/CHANGELOG.md
index 4bd35fa..e87ff4d 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -9,12 +9,15 @@ ## [Unreleased]
 
 ### Added
 
+- Discord ops alerts: `App\Ops\DiscordOpsAlert` posts one explicit incident to the `DISCORD_WEBHOOK_URL` incoming webhook. It is a no-op when unset, redacts secrets, caps text at 1800 characters, and soft-fails by logging an error.
+- `audit` logging channel (`storage/logs/audit.log`, `info` level, 90-day retention) for "who changed what" records, and the three logging lanes documented in [`docs/ops/logging.md`](docs/ops/logging.md).
 - Database schema and Mermaid diagram in [`docs/database-schema.md`](docs/database-schema.md).
 - Business rules documentation in [`docs/business-rules.md`](docs/business-rules.md): MVP queue management, entity/subscription, roles (admin, owner, employee), tickets, priorities, fairness (3-ticket rule), deterministic call panel, and channels (Flutter totem, web TV, attendant).
 - This changelog (Keep a Changelog).
 
 ### Changed
 
+- Default log stack is now `daily` (`LOG_STACK=daily`, 14-day retention via `LOG_DAILY_DAYS`) instead of `single`. The test environment pins `LOG_STACK=daily` in `phpunit.xml`.
 - Documented architecture: PegaFilaWeb is a single repository for frontend, backend and totem API; Flutter remains only as a separate client.
 - Simplified model: ticket is single-use (one call; write-once except `called_at`/`called_by`) — removed `ticket_calls` table; ticket knows only its queue (no `totem_id`). `tickets.priority` is now an integer (higher = more prioritized).
 - Expanded financial model: `billing_accounts` (1:0..1 with entity) + `subscriptions` + `plans` isolate financial data. New tables: `payment_options` (cycle, method, discount, refund window) and `payments` (individual charges). `billing_accounts` has `cpf_cnpj`. Subscription 1:1 with `billing_account_id` (UK); history in `payments`. Added `tickets.code`, explicit unique constraints, and circular FK note for owner. Removed per-queue user access limit.
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..309e83d
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Stringable;
+use Throwable;
+
+/**
+ * Pages operations on Discord for actionable production incidents.
+ *
+ * This is an explicit call made by code that decided an incident is worth
+ * waking someone up for. It is not a Monolog channel. It never throws.
+ */
+class DiscordOpsAlert
+{
+    private const MAX_LENGTH = 1800;
+
+    private const TIMEOUT_SECONDS = 5;
+
+    private const SENSITIVE_KEY = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const BEARER = '/Bearer\s+\S+/i';
+
+    /**
+     * Send one alert to the configured webhook. No-op when no webhook is configured.
+     *
+     * @param  array<string, mixed>  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (blank($url)) {
+            return;
+        }
+
+        try {
+            $response = Http::timeout(self::TIMEOUT_SECONDS)->post($url, [
+                'content' => $this->text($title, $message, $context),
+            ]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', ['status' => $response->status()]);
+            }
+        } catch (Throwable $exception) {
+            // Exception messages often embed the URL, which carries the webhook token.
+            Log::error('Discord ops alert failed', [
+                'exception' => $exception::class,
+                'message' => str_replace($url, '[webhook-url]', $exception->getMessage()),
+            ]);
+        }
+    }
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    private function text(string $title, string $message, array $context): string
+    {
+        $lines = [$this->scrubBearer($title), $this->scrubBearer($message)];
+
+        foreach ($this->redact($context) as $key => $value) {
+            $lines[] = $key.'='.$this->render($value);
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH, 'UTF-8');
+    }
+
+    /**
+     * @param  array<array-key, mixed>  $data
+     * @return array<array-key, mixed>
+     */
+    private function redact(array $data): array
+    {
+        $redacted = [];
+
+        foreach ($data as $key => $value) {
+            $redacted[$key] = match (true) {
+                preg_match(self::SENSITIVE_KEY, (string) $key) === 1 => '[redacted]',
+                is_array($value) => $this->redact($value),
+                is_string($value) && preg_match(self::BEARER, $value) === 1 => '[redacted]',
+                default => $value,
+            };
+        }
+
+        return $redacted;
+    }
+
+    private function render(mixed $value): string
+    {
+        if (is_array($value)) {
+            return json_encode($value, JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) ?: '[unrenderable]';
+        }
+
+        return match (true) {
+            is_bool($value) => $value ? 'true' : 'false',
+            $value === null => 'null',
+            is_scalar($value), $value instanceof Stringable => (string) $value,
+            default => get_debug_type($value),
+        };
+    }
+
+    private function scrubBearer(string $text): string
+    {
+        return preg_replace(self::BEARER, 'Bearer [redacted]', $text) ?? $text;
+    }
+}
