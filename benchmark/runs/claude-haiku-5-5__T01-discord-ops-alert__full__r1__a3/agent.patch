diff --git a/tests/Feature/Ops/DiscordOpsAlertTest.php b/tests/Feature/Ops/DiscordOpsAlertTest.php
new file mode 100644
index 0000000..4a1ccc4
--- /dev/null
+++ b/tests/Feature/Ops/DiscordOpsAlertTest.php
@@ -0,0 +1,125 @@
+<?php
+
+use App\Ops\DiscordOpsAlert;
+use Illuminate\Http\Client\ConnectionException;
+use Illuminate\Http\Client\Factory;
+use Illuminate\Http\Client\Request;
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+beforeEach(function () {
+    config(['services.discord.webhook_url' => 'https://discord.com/api/webhooks/123/webhook-token']);
+    Http::fake(['*' => Http::response(status: 204)]);
+    Log::spy();
+});
+
+test('the notifier resolves from the container without constructor arguments', function () {
+    expect(app(DiscordOpsAlert::class))->toBeInstanceOf(DiscordOpsAlert::class);
+});
+
+test('does nothing when the webhook url is not configured', function (?string $url) {
+    config(['services.discord.webhook_url' => $url]);
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message', ['entity_id' => 42]);
+
+    Http::assertNothingSent();
+    Log::shouldNotHaveReceived('error');
+})->with([null, '']);
+
+test('posts a json content body to the exact configured webhook url', function () {
+    app(DiscordOpsAlert::class)->send('Queue job failed', 'Retries exhausted', ['entity_id' => 42]);
+
+    Http::assertSent(fn (Request $request) => $request->method() === 'POST'
+        && $request->url() === 'https://discord.com/api/webhooks/123/webhook-token'
+        && $request->data() === ['content' => "Queue job failed\nRetries exhausted\nentity_id=42"]);
+});
+
+test('renders one key=value line per context entry', function () {
+    app(DiscordOpsAlert::class)->send('Title', 'Message', ['queue' => 'asaas-webhooks', 'attempts' => 3, 'dry' => false, 'note' => null]);
+
+    Http::assertSent(fn (Request $request) => $request->data()['content'] === "Title\nMessage\nqueue=asaas-webhooks\nattempts=3\ndry=false\nnote=null");
+});
+
+test('truncates the text to exactly 1800 multibyte-safe characters', function () {
+    app(DiscordOpsAlert::class)->send('Title', str_repeat('ação ', 1000));
+
+    Http::assertSent(fn (Request $request) => mb_strlen($request->data()['content']) === 1800
+        && mb_check_encoding($request->data()['content'], 'UTF-8'));
+});
+
+test('redacts values whose context key looks sensitive', function () {
+    app(DiscordOpsAlert::class)->send('Webhook failed', 'Gateway rejected the call', [
+        'password' => 'hunter2',
+        'api_key' => 'k1',
+        'api-key' => 'k2',
+        'apikey' => 'k3',
+        'Authorization' => 'basic-credentials',
+        'access_token' => 't1',
+        'client_secret' => 's1',
+        'webhook' => 'https://discord.com/api/webhooks/1/2',
+        'queue' => 'asaas-webhooks',
+    ]);
+
+    Http::assertSent(fn (Request $request) => $request->data()['content'] === implode("\n", [
+        'Webhook failed',
+        'Gateway rejected the call',
+        'password=[redacted]',
+        'api_key=[redacted]',
+        'api-key=[redacted]',
+        'apikey=[redacted]',
+        'Authorization=[redacted]',
+        'access_token=[redacted]',
+        'client_secret=[redacted]',
+        'webhook=[redacted]',
+        'queue=asaas-webhooks',
+    ]));
+});
+
+test('redacts bearer credentials regardless of the key, including inside the message', function () {
+    app(DiscordOpsAlert::class)->send('Auth failed', 'Forwarded with Bearer abc123 upstream', ['header' => 'Bearer abc.def-123', 'reason' => 'expired']);
+
+    Http::assertSent(fn (Request $request) => $request->data()['content'] === "Auth failed\nForwarded with Bearer [redacted] upstream\nheader=[redacted]\nreason=expired");
+});
+
+test('redacts nested arrays recursively and renders them as json', function () {
+    app(DiscordOpsAlert::class)->send('Payload', 'Bad payload', [
+        'payload' => ['id' => 7, 'token' => 'abc', 'items' => [['secret' => 's', 'name' => 'x']]],
+    ]);
+
+    Http::assertSent(fn (Request $request) => $request->data()['content'] === 'Payload'."\n".'Bad payload'."\n".'payload={"id":7,"token":"[redacted]","items":[{"secret":"[redacted]","name":"x"}]}');
+});
+
+test('does not log anything when discord accepts the alert', function () {
+    app(DiscordOpsAlert::class)->send('Title', 'Message');
+
+    Log::shouldNotHaveReceived('error');
+});
+
+test('logs an error with the status code and does not throw when discord rejects the alert', function () {
+    Http::swap(new Factory);
+    Http::fake(['*' => Http::response('rate limited', 429)]);
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->withArgs(fn (string $message, array $context) => $message === 'Discord ops alert failed' && $context === ['status' => 429])
+        ->once();
+});
+
+test('soft-fails on transport errors and never logs the webhook url', function () {
+    Http::swap(new Factory);
+    Http::fake(fn () => throw new ConnectionException('cURL error 28: timed out for https://discord.com/api/webhooks/123/webhook-token'));
+
+    app(DiscordOpsAlert::class)->send('Title', 'Message');
+
+    Log::shouldHaveReceived('error')
+        ->withArgs(function (string $message, array $context) {
+            $logged = json_encode([$message, $context]);
+
+            return $message === 'Discord ops alert failed'
+                && $context['exception'] === ConnectionException::class
+                && ! str_contains($logged, 'webhook-token')
+                && ! str_contains($logged, 'discord.com/api/webhooks');
+        })
+        ->once();
+});
diff --git a/tests/Feature/Ops/LoggingChannelsTest.php b/tests/Feature/Ops/LoggingChannelsTest.php
new file mode 100644
index 0000000..6bf7c17
--- /dev/null
+++ b/tests/Feature/Ops/LoggingChannelsTest.php
@@ -0,0 +1,66 @@
+<?php
+
+use Illuminate\Support\Facades\Log;
+
+test('the default log stack is daily when LOG_STACK is unset', function () {
+    $previous = getenv('LOG_STACK');
+    putenv('LOG_STACK');
+    unset($_ENV['LOG_STACK'], $_SERVER['LOG_STACK']);
+
+    try {
+        $channels = require config_path('logging.php');
+    } finally {
+        putenv('LOG_STACK='.$previous);
+        $_ENV['LOG_STACK'] = $_SERVER['LOG_STACK'] = $previous;
+    }
+
+    expect($channels['channels']['stack']['channels'])->toBe(['daily']);
+});
+
+test('the stack channel is pinned to daily in the test environment', function () {
+    expect(config('logging.channels.stack.channels'))->toBe(['daily']);
+});
+
+test('the daily archive channel keeps 14 days of application logs', function () {
+    expect(config('logging.channels.daily'))
+        ->toMatchArray(['driver' => 'daily', 'days' => 14])
+        ->and(config('logging.channels.daily.path'))->toEndWith('logs/laravel.log');
+});
+
+test('the audit channel is a daily channel at info level kept for 90 days', function () {
+    expect(config('logging.channels.audit'))
+        ->toMatchArray(['driver' => 'daily', 'level' => 'info', 'days' => 90])
+        ->and(config('logging.channels.audit.path'))->toEndWith('logs/audit.log');
+});
+
+test('the audit channel writes info entries to its own rotated file', function () {
+    $path = storage_path('framework/testing/audit.log');
+    $file = storage_path('framework/testing/audit-'.now()->format('Y-m-d').'.log');
+    config(['logging.channels.audit.path' => $path]);
+    Log::forgetChannel('audit');
+
+    try {
+        Log::channel('audit')->info('Subscription status changed', ['subscription_id' => 9]);
+
+        expect(file_get_contents($file))->toContain('Subscription status changed')
+            ->toContain('subscription_id');
+    } finally {
+        @unlink($file);
+        Log::forgetChannel('audit');
+    }
+});
+
+test('there is no discord log channel', function () {
+    expect(config('logging.channels'))->not->toHaveKey('discord');
+});
+
+test('the env example documents the logging and discord keys', function () {
+    $example = file_get_contents(base_path('.env.example'));
+
+    expect($example)
+        ->toMatch('/^LOG_STACK=daily$/m')
+        ->toMatch('/^LOG_DAILY_DAYS=14$/m')
+        ->toMatch('/^LOG_AUDIT_LEVEL=info$/m')
+        ->toMatch('/^LOG_AUDIT_DAYS=90$/m')
+        ->toMatch('/^DISCORD_WEBHOOK_URL=$/m');
+});
