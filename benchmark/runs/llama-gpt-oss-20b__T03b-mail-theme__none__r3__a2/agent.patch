diff --git a/tests/Feature/MailThemeTest.php b/tests/Feature/MailThemeTest.php
new file mode 100644
index 0000000..2e6eefc
--- /dev/null
+++ b/tests/Feature/MailThemeTest.php
@@ -0,0 +1,45 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Notification;
+
+uses(RefreshDatabase::class);
+
+test('markdown mail uses the PegaFila theme in Brazilian Portuguese', function () {
+    expect(config('mail.markdown.theme'))->toBe('pegafila')
+        ->and(base_path('resources/views/vendor/mail/html/themes/pegafila.css'))->toBeFile();
+
+    $user = User::factory()->create();
+    $mail = (new ResetPassword('token-123'))->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Redefina sua senha')
+        ->and($html)->toContain('#0f7490')
+        ->and($html)->toContain('PegaFila')
+        ->and($html)->toContain('Olá!')
+        ->and($html)->toContain('Redefinir senha')
+        ->and($html)->toContain('Você recebeu esse e-mail')
+        ->and($html)->not->toContain('having trouble clicking');
+});
+
+test('the e-mail verification message is written in Brazilian Portuguese', function () {
+    $user = User::factory()->unverified()->create();
+    $mail = (new VerifyEmail)->toMail($user);
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and((string) $mail->render())->toContain('Verifique o endereço de e-mail');
+});
+
+test('requesting a reset link sends the reset notification', function () {
+    Notification::fake();
+
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+
+    $this->post(route('password.email'), ['email' => 'ana@example.com'])
+        ->assertSessionHas('status');
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
