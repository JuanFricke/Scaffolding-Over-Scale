diff --git a/tests/Feature/Entity/EntityInviteTest.php b/tests/Feature/Entity/EntityInviteTest.php
new file mode 100644
index 0000000..e7615b1
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteTest.php
@@ -0,0 +1,268 @@
+<?php
+
+use App\Livewire\Entity\PendingInvites;
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+// --- model / schema ----------------------------------------------------------
+
+test('entity_invites has the expected columns and a unique entity+email', function () {
+    expect(Schema::hasColumns('entity_invites', [
+        'id', 'entity_id', 'invited_by', 'email', 'role', 'expires_at', 'accepted_at', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'a@example.com']);
+
+    expect(fn () => EntityInvite::factory()->for($entity)->create(['email' => 'a@example.com']))
+        ->toThrow(QueryException::class);
+});
+
+test('invites cascade with their entity and keep history when the inviter is deleted', function () {
+    $inviter = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create(['invited_by' => $inviter->id]);
+
+    $inviter->delete();
+    expect($invite->fresh()->invited_by)->toBeNull();
+
+    $entity->forceDelete();
+    expect(EntityInvite::count())->toBe(0);
+});
+
+test('the factory defaults to an employee invite valid for 7 days, with an expired state', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->entity)->toBeInstanceOf(Entity::class)
+        ->and($invite->role)->toBe(UserRole::Employee)
+        ->and($invite->accepted_at)->toBeNull()
+        ->and($invite->isPending())->toBeTrue()
+        ->and($invite->expires_at->isSameDay(now()->addDays(7)))->toBeTrue()
+        ->and($invite->entity->invites->first()->is($invite))->toBeTrue();
+
+    $expired = EntityInvite::factory()->expired()->create();
+
+    expect($expired->isExpired())->toBeTrue()
+        ->and($expired->isPending())->toBeFalse()
+        ->and(EntityInvite::pending()->pluck('id')->all())->toBe([$invite->id]);
+});
+
+test('e-mails are stored trimmed and lowercase on every write path', function () {
+    $entity = Entity::factory()->create();
+
+    $created = EntityInvite::factory()->for($entity)->create(['email' => '  Mixed@Example.COM ']);
+    expect($created->fresh()->email)->toBe('mixed@example.com');
+
+    $created->update(['email' => ' Other@EXAMPLE.com']);
+    expect($created->fresh()->email)->toBe('other@example.com');
+
+    $new = new EntityInvite(['entity_id' => $entity->id, 'email' => 'UP@Example.com', 'expires_at' => now()->addDay()]);
+    $new->save();
+    expect($new->fresh()->email)->toBe('up@example.com');
+});
+
+// --- mail --------------------------------------------------------------------
+
+test('the invite mail is queued markdown using the PegaFila theme', function () {
+    $invite = EntityInvite::factory()->for(Entity::factory()->create(['name' => 'Acme']))->create(['role' => 'admin']);
+    $mail = new EntityInviteMail($invite);
+
+    expect($mail)->toBeInstanceOf(ShouldQueue::class)
+        ->and($mail->content()->markdown)->toBe('emails.entity-invite')
+        ->and(config('mail.markdown.theme'))->toBe('pegafila');
+});
+
+test('the invite mail renders in English', function () {
+    app()->setLocale('en');
+    $invite = EntityInvite::factory()->for(Entity::factory()->create(['name' => 'Acme']))->create(['role' => 'admin']);
+    $mail = new EntityInviteMail($invite);
+    $html = $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('You are invited to Acme')
+        ->and($html)->toContain('You are invited to join Acme as Admin.')
+        ->and($html)->toContain('Access the link below to sign in and accept your invite:')
+        ->and($html)->toContain('Sign in to PegaFila')
+        ->and($html)->toContain(route('login'))
+        ->and($html)->toContain($invite->expires_at->isoFormat('L'))
+        ->and($html)->toContain('Team PegaFila')
+        ->and($html)->toContain('#0f7490');
+});
+
+test('the invite mail renders in Brazilian Portuguese', function () {
+    app()->setLocale('pt_BR');
+    $invite = EntityInvite::factory()->for(Entity::factory()->create(['name' => 'Acme']))->create(['role' => 'admin']);
+    $mail = new EntityInviteMail($invite);
+    $html = $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('Você foi convidado para Acme')
+        ->and($html)->toContain('Você foi convidado para participar de Acme como Administrador.')
+        ->and($html)->toContain('Acesse o link abaixo para entrar e aceitar seu convite:')
+        ->and($html)->toContain('Entrar no PegaFila')
+        ->and($html)->toContain('Time PegaFila');
+});
+
+// --- pending invites component -------------------------------------------------
+
+function inviteeWithInvite(array $attributes = []): array
+{
+    $user = User::factory()->create(['email' => 'Invitee@Example.com']);
+    $invite = EntityInvite::factory()->create($attributes + ['email' => 'invitee@example.com', 'role' => 'admin']);
+
+    return [$user, $invite];
+}
+
+test('the list shows only the signed-in user pending invites, matched case-insensitively', function () {
+    [$user, $invite] = inviteeWithInvite();
+    $expired = EntityInvite::factory()->expired()->create(['email' => 'invitee@example.com']);
+    $accepted = EntityInvite::factory()->create(['email' => 'invitee@example.com', 'accepted_at' => now()]);
+    $other = EntityInvite::factory()->create(['email' => 'someone@example.com']);
+
+    Livewire::actingAs($user)->test(PendingInvites::class)
+        ->assertSee($invite->entity->name)
+        ->assertDontSee($expired->entity->name)
+        ->assertDontSee($accepted->entity->name)
+        ->assertDontSee($other->entity->name);
+});
+
+test('the invitee accepts: membership with the invite role, accepted_at set, tenant session set, redirect', function () {
+    [$user, $invite] = inviteeWithInvite();
+
+    Livewire::actingAs($user)->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', $invite->entity->slug));
+
+    $membership = EntityMembership::where('entity_id', $invite->entity_id)->where('user_id', $user->id)->sole();
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull()
+        ->and(session('current_entity_id'))->toBe($invite->entity_id);
+});
+
+test('accepting an already accepted invite is an idempotent no-op', function () {
+    [$user, $invite] = inviteeWithInvite();
+
+    $component = Livewire::actingAs($user)->test(PendingInvites::class)->call('accept', $invite->id);
+    $acceptedAt = $invite->fresh()->accepted_at;
+
+    $this->travel(1)->minute();
+
+    $component->call('accept', $invite->id)->assertHasNoErrors()->assertNoRedirect();
+
+    expect(EntityMembership::where('user_id', $user->id)->count())->toBe(1)
+        ->and($invite->fresh()->accepted_at->equalTo($acceptedAt))->toBeTrue();
+});
+
+test('accepting never duplicates an existing membership nor changes its role', function () {
+    [$user, $invite] = inviteeWithInvite();
+    EntityMembership::factory()->for($invite->entity)->for($user)->employee()->create();
+
+    Livewire::actingAs($user)->test(PendingInvites::class)->call('accept', $invite->id)->assertHasNoErrors();
+
+    $memberships = EntityMembership::where('user_id', $user->id)->get();
+    expect($memberships)->toHaveCount(1)
+        ->and($memberships->first()->role)->toBe(UserRole::Employee)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull();
+});
+
+test('accepting an expired invite is an error on invite and creates nothing', function () {
+    [$user, $invite] = inviteeWithInvite();
+    $invite->update(['expires_at' => now()->subSecond()]);
+
+    Livewire::actingAs($user)->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasErrors('invite')
+        ->assertNoRedirect();
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+test('only the invitee can accept or decline', function () {
+    [, $invite] = inviteeWithInvite();
+    $stranger = User::factory()->create(['email' => 'stranger@example.com']);
+
+    Livewire::actingAs($stranger)->test(PendingInvites::class)->call('accept', $invite->id)->assertForbidden();
+    Livewire::actingAs($stranger)->test(PendingInvites::class)->call('decline', $invite->id)->assertForbidden();
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and(EntityInvite::whereKey($invite->id)->exists())->toBeTrue();
+});
+
+test('an unverified account with the invited address cannot accept', function () {
+    [$user, $invite] = inviteeWithInvite();
+    $user->forceFill(['email_verified_at' => null])->save();
+
+    Livewire::actingAs($user)->test(PendingInvites::class)->call('accept', $invite->id)->assertForbidden();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('the invitee declines: the invite is deleted and no membership is created', function () {
+    [$user, $invite] = inviteeWithInvite();
+
+    Livewire::actingAs($user)->test(PendingInvites::class)
+        ->call('decline', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::whereKey($invite->id)->exists())->toBeFalse()
+        ->and(EntityMembership::count())->toBe(0);
+});
+
+// --- pages ---------------------------------------------------------------------
+
+test('the entity switcher lists the pending invites', function () {
+    [$user, $invite] = inviteeWithInvite();
+    EntityMembership::factory()->for($user)->owner()->create();
+
+    $this->actingAs($user)->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSeeText(__('ui.invites_title'))
+        ->assertSeeText($invite->entity->name)
+        ->assertSeeText(__('ui.invites_accept'))
+        ->assertSeeText(__('ui.invites_decline'));
+});
+
+test('onboarding shows the invites after the form, separated by an hr', function () {
+    [$user, $invite] = inviteeWithInvite();
+
+    $html = $this->actingAs($user)->get(route('onboarding'))->assertOk()->getContent();
+
+    expect(substr_count($html, '<hr>'))->toBe(1)
+        ->and(strpos($html, 'wire:submit.prevent="submit"'))->toBeLessThan(strpos($html, '<hr>'))
+        ->and(strpos($html, '<hr>'))->toBeLessThan(strpos($html, __('ui.invites_title')))
+        ->and($html)->toContain($invite->entity->name);
+});
+
+test('onboarding without invites renders no hr and no invites title', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('onboarding'))
+        ->assertOk()
+        ->assertDontSee('<hr', false)
+        ->assertDontSee(__('ui.invites_title'));
+});
+
+test('invite labels are localized', function () {
+    app()->setLocale('pt_BR');
+    expect(__('ui.invites_title'))->toBe('Convites pendentes')
+        ->and(__('ui.invites_accept'))->toBe('Aceitar')
+        ->and(__('ui.invites_decline'))->toBe('Recusar')
+        ->and(__('ui.role_admin'))->toBe('Administrador');
+
+    app()->setLocale('en');
+    expect(__('ui.invites_title'))->toBe('Pending invites')
+        ->and(__('ui.invites_accept'))->toBe('Accept')
+        ->and(__('ui.invites_decline'))->toBe('Decline')
+        ->and(__('ui.role_admin'))->toBe('Admin');
+});
