@@ -0,0 +1,114 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+class PendingInvites extends Component
+{
+    /**
+     * Render an <hr> before the list (only when there is something to list).
+     */
+    #[Locked]
+    public bool $separator = false;
+
+    public function mount(bool $separator = false): void
+    {
+        $this->separator = $separator;
+    }
+
+    public function accept($inviteId): void
+    {
+        $invite = $this->inviteForCurrentUser($inviteId);
+        $user = auth()->user();
+
+        $entity = DB::transaction(function () use ($invite, $user) {
+            // Re-read under lock so a double click / parallel tab cannot accept twice.
+            $invite = EntityInvite::whereKey($invite->id)->lockForUpdate()->firstOrFail();
+
+            // Idempotent: an accepted invite is a no-op, even if it has expired since.
+            if ($invite->isAccepted()) {
+                return null;
+            }
+
+            if ($invite->isExpired()) {
+                $this->addError('invite', __('ui.invites_expired'));
+
+                return null;
+            }
+
+            $entity = $invite->entity;
+            abort_if($entity === null, 404);
+
+            // Never a duplicate membership: an existing one keeps its role.
+            EntityMembership::firstOrCreate(
+                ['entity_id' => $entity->id, 'user_id' => $user->id],
+                ['role' => $invite->role->value],
+            );
+
+            $invite->update(['accepted_at' => now()]);
+
+            return $entity;
+        });
+
+        if ($entity === null) {
+            return;
+        }
+
+        Log::channel('audit')->info('Invite accepted', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+            'invite_id' => $invite->id,
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirect(route('entity.dashboard', $entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $invite = $this->inviteForCurrentUser($inviteId);
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.pending-invites', [
+            'invites' => auth()->user()->pendingInvites()->with('entity')->latest('id')->get(),
+        ]);
+    }
+
+    /**
+     * Resolve an invite from client input; only the (verified) invitee may act on it.
+     */
+    protected function inviteForCurrentUser($inviteId): EntityInvite
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        /** @var User $user */
+        $user = auth()->user();
+
+        abort_unless(
+            $user->hasVerifiedEmail() && $invite->email === Str::lower(trim($user->email)),
+            403,
+        );
+
+        return $invite;
+    }
+}
