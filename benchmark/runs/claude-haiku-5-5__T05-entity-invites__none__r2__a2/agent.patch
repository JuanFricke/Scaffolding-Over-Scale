+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Livewire\Component;
+
+/**
+ * Lists the signed-in user's pending invites and lets them accept or decline.
+ */
+class PendingInvites extends Component
+{
+    public function accept($inviteId): void
+    {
+        $entity = DB::transaction(function () use ($inviteId) {
+            // Row lock so two concurrent accepts cannot both create the membership.
+            $invite = EntityInvite::with('entity')->lockForUpdate()->findOrFail($inviteId);
+
+            $this->authorizeInvitee($invite);
+
+            // The entity may have been soft-deleted after the invite was sent.
+            abort_unless($invite->entity, 404);
+
+            if ($invite->isAccepted()) {
+                return null;
+            }
+
+            if ($invite->isExpired()) {
+                $this->addError('invite', __('ui.invite_expired'));
+
+                return null;
+            }
+
+            EntityMembership::firstOrCreate(
+                ['entity_id' => $invite->entity_id, 'user_id' => auth()->id()],
+                ['role' => $invite->role->value],
+            );
+
+            $invite->update(['accepted_at' => now()]);
+
+            Log::channel('audit')->info('Invite accepted', [
+                'entity_id' => $invite->entity_id,
+                'actor_id' => auth()->id(),
+                'invite_id' => $invite->id,
+            ]);
+
+            return $invite->entity;
+        });
+
+        if (! $entity) {
+            return;
+        }
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirect(route('entity.dashboard', $entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $invite = EntityInvite::findOrFail($inviteId);
+
+        $this->authorizeInvitee($invite);
+
+        // An accepted invite is history, not a pending decision.
+        if ($invite->isAccepted()) {
+            return;
+        }
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.pending-invites', [
+            'invites' => EntityInvite::with('entity')
+                ->forEmail((string) auth()->user()?->email)
+                ->pending()
+                ->whereHas('entity')
+                ->latest('id')
+                ->get(),
+        ]);
+    }
+
+    protected function authorizeInvitee(EntityInvite $invite): void
+    {
+        abort_unless($invite->email === strtolower(trim((string) auth()->user()?->email)), 403);
+    }
+}
