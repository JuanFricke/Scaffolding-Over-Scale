+
+test('the invitee accepts an invite, gets the role, and lands in the entity', function () {
+    $user = User::factory()->create(['email' => 'invitee@example.com']);
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+    $invite = EntityInvite::factory()->for($entity)->create([
+        'email' => 'invitee@example.com',
+        'role' => UserRole::Admin,
+    ]);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', 'acme'));
+
+    $membership = EntityMembership::where('entity_id', $entity->id)->where('user_id', $user->id)->sole();
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($invite->fresh()->isAccepted())->toBeTrue()
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('accepting matches the e-mail case-insensitively', function () {
+    $user = User::factory()->create(['email' => 'Ana@Example.com']);
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create(['email' => 'ana@example.com']);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityMembership::where('user_id', $user->id)->where('role', UserRole::Employee->value)->exists())
+        ->toBeTrue();
+});
+
+test('someone else cannot accept or decline an invite', function () {
+    $other = User::factory()->create(['email' => 'other@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => 'invitee@example.com']);
+
+    Livewire::actingAs($other)->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertForbidden();
+
+    Livewire::actingAs($other)->test(PendingInvites::class)
+        ->call('decline', $invite->id)
+        ->assertForbidden();
+
+    expect($invite->fresh()->isPending())->toBeTrue()
+        ->and(EntityMembership::count())->toBe(0);
+});
+
+test('an expired invite cannot be accepted', function () {
+    $user = User::factory()->create(['email' => 'invitee@example.com']);
+    $invite = EntityInvite::factory()->expired()->create(['email' => 'invitee@example.com']);
+
+    Livewire::actingAs($user)
+        ->test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasErrors(['invite']);
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+test('accepting an already accepted invite is a silent no-op', function () {
