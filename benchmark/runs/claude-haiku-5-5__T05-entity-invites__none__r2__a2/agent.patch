@@ -0,0 +1,63 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the invite e-mail is stored lowercase and trimmed on every write path', function () {
+    $invite = EntityInvite::factory()->create(['email' => '  Mixed.Case@Example.COM ']);
+
+    expect($invite->email)->toBe('mixed.case@example.com')
+        ->and(EntityInvite::whereKey($invite->id)->value('email'))->toBe('mixed.case@example.com');
+
+    $invite->update(['email' => ' Other@Example.com']);
+
+    expect($invite->fresh()->email)->toBe('other@example.com');
+});
+
+test('the role is cast to the user role enum and defaults to employee', function () {
+    $invite = EntityInvite::factory()->create();
+
+    expect($invite->fresh()->role)->toBe(UserRole::Employee)
+        ->and($invite->expires_at->between(now()->addDays(7)->subMinute(), now()->addDays(7)->addMinute()))->toBeTrue();
+});
+
+test('an invite is pending only while not accepted and not expired', function () {
+    expect(EntityInvite::factory()->create()->isPending())->toBeTrue()
+        ->and(EntityInvite::factory()->expired()->create()->isPending())->toBeFalse()
+        ->and(EntityInvite::factory()->create(['accepted_at' => now()])->isPending())->toBeFalse();
+
+    expect(EntityInvite::query()->pending()->count())->toBe(1);
+});
+
+test('one invite per e-mail per entity is enforced by the database', function () {
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->create(['email' => 'dup@example.com']);
+
+    expect(fn () => EntityInvite::factory()->for($entity)->create(['email' => 'DUP@example.com']))
+        ->toThrow(QueryException::class);
+
+    // The same address may be invited to another entity.
+    expect(EntityInvite::factory()->create(['email' => 'dup@example.com'])->exists)->toBeTrue();
+});
+
+test('invites are removed with their entity', function () {
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->create();
+
+    $entity->forceDelete();
+
+    expect(EntityInvite::count())->toBe(0);
+});
+
+test('the entity exposes its invites', function () {
+    $entity = Entity::factory()->create();
+    EntityInvite::factory()->for($entity)->count(2)->create();
+
+    expect($entity->invites)->toHaveCount(2)
+        ->and($entity->invites->first())->toBeInstanceOf(EntityInvite::class);
+});
