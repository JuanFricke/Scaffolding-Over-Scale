diff --git a/tests/Feature/Entity/EntityInviteMailTest.php b/tests/Feature/Entity/EntityInviteMailTest.php
new file mode 100644
index 0000000..40f6eaf
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteMailTest.php
@@ -0,0 +1,70 @@
+<?php
+
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Mail;
+
+uses(RefreshDatabase::class);
+
+test('the invite mail is queued markdown using the entity-invite view', function () {
+    $invite = EntityInvite::factory()->create();
+
+    $mail = new EntityInviteMail($invite);
+
+    expect($mail)->toBeInstanceOf(ShouldQueue::class)
+        ->and($mail->content()->markdown)->toBe('emails.entity-invite');
+});
+
+test('the invite mail is queued to the invitee', function () {
+    Mail::fake();
+
+    $invite = EntityInvite::factory()->create(['email' => 'guest@example.com']);
+
+    Mail::to($invite->email)->queue(new EntityInviteMail($invite));
+
+    Mail::assertQueued(EntityInviteMail::class, fn ($mail) => $mail->hasTo('guest@example.com'));
+});
+
+test('the invite mail renders in English with the entity, role, expiry and sign-in button', function () {
+    app()->setLocale('en');
+
+    $entity = Entity::factory()->create(['name' => 'Acme Ltda']);
+    $invite = EntityInvite::factory()->for($entity)->create(['role' => UserRole::Admin]);
+
+    $mail = new EntityInviteMail($invite);
+    $html = $mail->render();
+
+    expect($mail->envelope()->subject)->toBe('You are invited to Acme Ltda')
+        ->and($html)->toContain('Hello!')
+        ->and($html)->toContain('You are invited to Acme Ltda as Admin.')
+        ->and($html)->toContain('Access the link below to sign in and accept your invite:')
+        ->and($html)->toContain('Sign in to PegaFila')
+        ->and($html)->toContain(route('login'))
+        ->and($html)->toContain($invite->expires_at->format('d/m/Y'))
+        ->and($html)->toContain('Team PegaFila');
+
+    app()->setLocale('pt_BR');
+});
+
+test('the invite mail is written in Brazilian Portuguese', function () {
+    app()->setLocale('pt_BR');
+
