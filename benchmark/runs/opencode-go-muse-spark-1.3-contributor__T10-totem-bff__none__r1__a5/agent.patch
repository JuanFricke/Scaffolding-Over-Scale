+it('rate limits pairing attempts with the contract code', function () {
+    $ip = totemIp();
+
+    for ($i = 0; $i < 10; $i++) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'], ['REMOTE_ADDR' => $ip])
+            ->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'], ['REMOTE_ADDR' => $ip])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited']);
+});
