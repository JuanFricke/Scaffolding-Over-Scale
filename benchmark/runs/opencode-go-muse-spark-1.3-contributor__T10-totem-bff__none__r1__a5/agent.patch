@@ -0,0 +1,93 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Http\Controllers\Controller;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemJwt;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Totem pairing login: exchanges a single-use 6-digit preset code for a JWT.
+ */
+class TotemAuthController extends Controller
+{
+    public function __invoke(Request $request): JsonResponse
+    {
+        $code = $request->input('code');
+
+        if (! is_string($code) || preg_match('/^\d{6}$/', $code) !== 1) {
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $result = DB::transaction(function () use ($code) {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null
+                || ! $preset->is_active
+                || $preset->login_code_consumed_at !== null
+                || $preset->login_code_expires_at === null
+                || $preset->login_code_expires_at->isPast()) {
+                return null;
+            }
+
+            $preset->login_code_consumed_at = now();
+            $preset->save();
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()->pluck('queues.id')
+                ->map(static fn ($id): int => (int) $id)
+                ->all();
+
+            $entity = $preset->entity;
+
+            $token = TotemJwt::issue([
+                'totem_id' => $totem->id,
+                'entity_id' => $entity->getKey(),
+                'preset_id' => $preset->id,
+                'queues' => $queueIds,
+            ]);
+
+            return [$preset, $entity, $token];
+        });
+
+        if ($result === null) {
+            Log::channel('audit')->warning('Totem pairing failed', [
+                'code_suffix' => '****'.substr($code, -2),
+            ]);
+
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        [$preset, $entity, $token] = $result;
+
+        Log::channel('audit')->info('Totem paired', [
+            'preset_id' => $preset->id,
+            'entity_id' => $entity->getKey(),
+            'code_suffix' => '****'.substr($code, -2),
+        ]);
+
+        return response()->json([
+            'token' => $token,
+            'token_type' => 'Bearer',
+            'expires_in' => TotemJwt::ttl(),
+            'entity' => [
+                'slug' => $entity->slug,
+                'name' => $entity->name,
+            ],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Totem/TotemController.php b/app/Http/Controllers/Totem/TotemController.php
new file mode 100644
index 0000000..9cca882
--- /dev/null
+++ b/app/Http/Controllers/Totem/TotemController.php
@@ -0,0 +1,168 @@
+<?php
+
+namespace App\Http\Controllers\Totem;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Totem\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * Authenticated totem BFF endpoints (behind `totem.auth`).
+ *
+ * `{entity}` is a slug that must equal the token's entity (else 403).
+ * `{queue}` is a slug resolved within that entity only (else 404), and must
+ * belong to the effective queue scope (else 403).
+ */
+class TotemController extends Controller
+{
+    public function queues(Request $request, string $entity): JsonResponse
+    {
+        $context = $this->context($request, $entity);
+
+        if ($context instanceof JsonResponse) {
+            return $context;
+        }
+
+        [$tokenEntity, $scope] = $context;
+
+        $queues = Queue::query()
+            ->where('entity_id', $tokenEntity->getKey())
+            ->where('is_active', true)
+            ->whereIn('id', $scope)
+            ->orderBy('name')
+            ->get()
+            ->values();
+
+        return response()->json([
+            'entity' => [
+                'slug' => $tokenEntity->slug,
+                'name' => $tokenEntity->name,
+            ],
+            'queues' => $queues->map(static fn (Queue $queue, int $index): array => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => null,
+                'visual' => [
+                    'color' => '#0055FF',
+                    'icon' => 'ticket',
+                    'order' => $index + 1,
+                ],
+                'is_active' => true,
+            ])->all(),
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        [$tokenEntity, $queueModel] = $resolved;
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $tokenEntity->slug],
+            'queue' => [
+                'slug' => $queueModel->slug,
+                'label' => $queueModel->name,
+            ],
+            'priorities' => TotemPriorities::all(),
+        ]);
+    }
+
+    public function ticket(Request $request, string $entity, string $queue, IssueTicket $issue): JsonResponse
+    {
+        $resolved = $this->resolveQueue($request, $entity, $queue);
+
+        if ($resolved instanceof JsonResponse) {
+            return $resolved;
+        }
+
+        [, $queueModel] = $resolved;
+
+        $priority = $request->input('priority');
+
+        if (! is_int($priority) || ! TotemPriorities::isValid($priority)) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        try {
+            $ticket = $issue($queueModel->fresh(), $priority, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => [
+                'slug' => $queueModel->slug,
+                'label' => $queueModel->name,
+            ],
+            'priority' => [
+                'value' => $ticket->priority,
+                'label' => TotemPriorities::labelFor($ticket->priority),
+            ],
+            'issued_at' => $ticket->issued_at->toISOString(),
+        ], 201);
+    }
+
+    /**
+     * @return array{Entity, list<int>}|JsonResponse
+     */
+    private function context(Request $request, string $entity): array|JsonResponse
+    {
+        /** @var Entity $tokenEntity */
+        $tokenEntity = $request->attributes->get('totem_entity');
+
+        if ($entity !== $tokenEntity->slug) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        /** @var list<int> $scope */
+        $scope = $request->attributes->get('totem_queue_scope', []);
+
+        return [$tokenEntity, $scope];
+    }
+
+    /**
+     * @return array{Entity, Queue}|JsonResponse
+     */
+    private function resolveQueue(Request $request, string $entity, string $queue): array|JsonResponse
+    {
+        $context = $this->context($request, $entity);
+
+        if ($context instanceof JsonResponse) {
+            return $context;
+        }
+
+        [$tokenEntity, $scope] = $context;
+
+        $queueModel = Queue::query()
+            ->where('entity_id', $tokenEntity->getKey())
+            ->where('slug', $queue)
+            ->first();
+
+        if ($queueModel === null) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        if (! in_array((int) $queueModel->getKey(), $scope, true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        return [$tokenEntity, $queueModel];
+    }
+}
diff --git a/app/Http/Middleware/TotemAuth.php b/app/Http/Middleware/TotemAuth.php
new file mode 100644
index 0000000..1c78157
--- /dev/null
+++ b/app/Http/Middleware/TotemAuth.php
@@ -0,0 +1,110 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Authenticates totem device JWTs (`Authorization: Bearer <jwt>`).
+ *
+ * Any failure — missing/invalid/expired token, unknown or inactive totem,
+ * unknown or inactive preset, entity mismatch between claims, totem and
+ * preset — answers 401 {"code":"invalid_token"}.
+ *
+ * On success the request carries:
+ * - totem: the Totem model (last_seen_at quietly refreshed),
+ * - totem_preset: the TotemPreset model,
+ * - totem_entity: the Entity model,
+ * - totem_queue_scope: effective queue ids = intersection of the JWT
+ *   `queues` claim with the preset's current queue join, so removing a
+ *   queue from the preset takes effect immediately for existing tokens.
+ */
+class TotemAuth
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $context = $this->resolve($request);
+
+        if ($context === null) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        [$totem, $preset, $entity, $scope] = $context;
+
+        $totem->forceFill(['last_seen_at' => now()])->saveQuietly();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_preset', $preset);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_queue_scope', $scope);
+
+        return $next($request);
+    }
+
+    /**
+     * @return array{Totem, TotemPreset, Entity, list<int>}|null
+     */
+    private function resolve(Request $request): ?array
+    {
+        $token = $request->bearerToken();
+
+        if ($token === null || $token === '') {
+            return null;
+        }
+
+        $claims = TotemJwt::decode($token);
+
+        if ($claims === null) {
+            return null;
+        }
+
+        $totemId = $claims['totem_id'] ?? null;
+        $presetId = $claims['preset_id'] ?? null;
+        $entityId = $claims['entity_id'] ?? null;
+        $claimQueues = $claims['queues'] ?? null;
+
+        if (! is_numeric($totemId) || ! is_numeric($presetId) || ! is_numeric($entityId) || ! is_array($claimQueues)) {
+            return null;
+        }
+
+        $totem = Totem::query()->find($totemId);
+        $preset = TotemPreset::query()->find($presetId);
+        $entity = Entity::query()->find($entityId);
+
+        if ($totem === null || ! $totem->is_active) {
+            return null;
+        }
+
+        if ($preset === null || ! $preset->is_active) {
+            return null;
+        }
+
+        if ($entity === null) {
+            return null;
+        }
+
+        if ((int) $totem->entity_id !== (int) $entity->getKey()
+            || (int) $preset->entity_id !== (int) $entity->getKey()) {
+            return null;
+        }
+
+        $claimQueueIds = array_map(
+            static fn ($id): int => (int) $id,
+            array_filter($claimQueues, static fn ($id): bool => is_numeric($id)),
+        );
+
+        $presetQueueIds = $preset->queues()->pluck('queues.id')
+            ->map(static fn ($id): int => (int) $id)
+            ->all();
+
+        $scope = array_values(array_intersect($claimQueueIds, $presetQueueIds));
+
+        return [$totem, $preset, $entity, $scope];
+    }
+}
