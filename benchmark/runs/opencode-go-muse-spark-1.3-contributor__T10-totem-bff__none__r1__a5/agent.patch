+<?php
+
+use App\Http\Controllers\Totem\TotemAuthController;
+use App\Http\Controllers\Totem\TotemController;
+use Illuminate\Support\Facades\Route;
+
+// Totem BFF (Flutter `pegafila_totem` client). JWT scope always wins: path
+// values are validated against the token, never trusted on their own.
+Route::post('/totem/auth', TotemAuthController::class)->middleware('throttle:10,1');
+
+Route::middleware('totem.auth')->group(function () {
+    Route::get('/{entity}/queues', [TotemController::class, 'queues']);
+    Route::get('/{entity}/{queue}/priorities', [TotemController::class, 'priorities']);
+    Route::post('/{entity}/{queue}/ticket', [TotemController::class, 'ticket'])
+        ->middleware('throttle:30,1');
+});
