@@ -0,0 +1,53 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Models\TotemPreset;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Opens a pairing window for a totem preset: generates the preset's own
+ * random 6-digit code (cryptographically random, zero-padded), valid for
+ * 10 minutes. Regenerating replaces the previous code.
+ */
+class TotemPairingCode extends Command
+{
+    /**
+     * @var string
+     */
+    protected $signature = 'totem:pairing-code {preset}';
+
+    /**
+     * @var string
+     */
+    protected $description = 'Generate a 6-digit pairing code for a totem preset (valid 10 minutes)';
+
+    public function handle(): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if ($preset === null) {
+            $this->error("Totem preset [{$this->argument('preset')}] not found.");
+
+            return self::FAILURE;
+        }
+
+        $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+        $preset->forceFill([
+            'login_code' => $code,
+            'login_code_expires_at' => now()->addMinutes(10),
+            'login_code_consumed_at' => null,
+        ])->save();
+
+        $this->line($code);
+
+        Log::channel('audit')->info('Totem pairing code generated', [
+            'preset_id' => $preset->getKey(),
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        return self::SUCCESS;
+    }
+}
