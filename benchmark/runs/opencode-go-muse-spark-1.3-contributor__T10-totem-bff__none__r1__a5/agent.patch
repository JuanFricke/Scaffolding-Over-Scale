+<?php
+
+namespace App\Totem;
+
+/**
+ * Backend-owned priority levels.
+ *
+ * Single source used by both the priorities endpoint and ticket issuance
+ * validation: numeric values are stored on tickets (higher = more
+ * prioritized); labels and visuals are display-only.
+ */
+final class TotemPriorities
+{
+    /**
+     * @var list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    private const LEVELS = [
+        [
+            'value' => 0,
+            'label' => 'Normal',
+            'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+        ],
+        [
+            'value' => 10,
+            'label' => 'Prioritário',
+            'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+        ],
+        [
+            'value' => 20,
+            'label' => 'Prioridade 80+',
+            'visual' => ['color' => '#6A1B9A', 'icon' => 'elderly', 'order' => 3],
+        ],
+    ];
