+    foreach ([['priority' => 99], ['priority' => -1], ['priority' => '10'], []] as $payload) {
+        $this->postJson("/api/{$entity->slug}/{$queueA->slug}/ticket", $payload, totemAuth($token, totemIp()))
+            ->assertStatus(422)
+            ->assertExactJson(['code' => 'invalid_priority']);
+    }
+
+    expect(Ticket::query()->count())->toBe(0);
+
+    $first = $this->postJson(
+        "/api/{$entity->slug}/{$queueA->slug}/ticket",
+        ['priority' => 10],
+        totemAuth($token, totemIp())
+    );
+
+    $first->assertStatus(201);
+    expect($first->json('slug'))->toBe('A001');
+    $first->assertJson([
+        'queue' => ['slug' => $queueA->slug, 'label' => $queueA->name],
+        'priority' => ['value' => 10, 'label' => 'Prioritário'],
+    ]);
+    expect((string) Carbon::parse($first->json('issued_at')))->not->toBeEmpty();
+
+    $second = $this->postJson(
+        "/api/{$entity->slug}/{$queueA->slug}/ticket",
+        ['priority' => 0],
+        totemAuth($token, totemIp())
+    );
+
+    $second->assertStatus(201);
+    expect($second->json('slug'))->toBe('A002');
+
+    $tickets = Ticket::query()->orderBy('code')->get();
+
+    expect($tickets->pluck('channel')->all())->toBe([TicketChannel::Totem, TicketChannel::Totem])
+        ->and($tickets->pluck('priority')->all())->toBe([10, 0]);
+});
+
+it('rejects tickets for unknown, out-of-scope or inactive queues', function () {
+    [$entity, $preset, , $queueA, $queueB, $token] = totemPair(Entity::factory()->create());
+    $other = Entity::factory()->create();
+    $foreign = Queue::factory()->for($other)->create(['slug' => 'foreign']);
+
+    $this->postJson("/api/{$entity->slug}/nope/ticket", ['priority' => 0], totemAuth($token, totemIp()))
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    $this->postJson("/api/{$entity->slug}/foreign/ticket", ['priority' => 0], totemAuth($token, totemIp()))
+        ->assertStatus(404)
+        ->assertExactJson(['code' => 'queue_not_found']);
+
+    $preset->queues()->detach($queueB->id);
+    $this->postJson("/api/{$entity->slug}/{$queueB->slug}/ticket", ['priority' => 0], totemAuth($token, totemIp()))
+        ->assertStatus(403)
+        ->assertExactJson(['code' => 'forbidden']);
+    expect(Ticket::query()->count())->toBe(0);
+
+    $queueA->update(['is_active' => false]);
+    $this->postJson("/api/{$entity->slug}/{$queueA->slug}/ticket", ['priority' => 0], totemAuth($token, totemIp()))
+        ->assertStatus(422)
+        ->assertExactJson(['code' => 'inactive_queue']);
+    expect(Ticket::query()->count())->toBe(0);
+});
