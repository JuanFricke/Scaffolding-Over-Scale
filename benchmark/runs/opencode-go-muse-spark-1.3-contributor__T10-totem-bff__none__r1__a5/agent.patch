+it('answers CORS preflight for local origins only', function () {
+    $response = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'http://localhost:8081',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    expect($response->getStatusCode())->toBe(204)
+        ->and($response->headers->get('Access-Control-Allow-Origin'))->toBe('http://localhost:8081');
+
+    $denied = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => 'https://evil.example.com',
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+
+    expect($denied->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+
+    [$entity, , , , , $token] = totemPair(Entity::factory()->create());
+
+    $allowed = $this->getJson("/api/{$entity->slug}/queues", totemAuth($token, '127.0.0.2') + ['Origin' => 'https://127.0.0.1:5173']);
+    expect($allowed->headers->get('Access-Control-Allow-Origin'))->toBe('https://127.0.0.1:5173');
+
+    $plain = $this->getJson("/api/{$entity->slug}/queues", totemAuth($token, '127.0.0.3') + ['Origin' => 'https://totem.example.com']);
+    expect($plain->headers->get('Access-Control-Allow-Origin'))->toBeNull();
+
+    config(['cors.allowed_origins' => ['https://totem.example.com']]);
+
+    $extra = $this->getJson("/api/{$entity->slug}/queues", totemAuth($token, '127.0.0.4') + ['Origin' => 'https://totem.example.com']);
+    expect($extra->headers->get('Access-Control-Allow-Origin'))->toBe('https://totem.example.com');
+});
