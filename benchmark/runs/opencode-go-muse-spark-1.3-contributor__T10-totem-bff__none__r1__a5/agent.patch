+
+function totemPair(Entity $entity, array $queueOverrides = []): array
+{
+    $queueA = Queue::factory()->for($entity)->create(array_merge(['name' => 'Alpha', 'slug' => 'alpha'], $queueOverrides));
+    $queueB = Queue::factory()->for($entity)->create(['name' => 'Bravo', 'slug' => 'bravo']);
+    $preset = TotemPreset::factory()->for($entity)->create();
