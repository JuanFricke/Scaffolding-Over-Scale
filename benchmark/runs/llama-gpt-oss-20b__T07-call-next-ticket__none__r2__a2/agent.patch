+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+
+use App\Enums\TicketStatus;
+
+use Illuminate\Support\Facades\DB;
+
+/**
+ * Call the next ticket in a queue according to the specified mode.
+ *
+ * This action is a pure domain operation that does not depend on HTTP or
+ * authorization layers. It performs the following steps inside a single
+ * database transaction:
+ *   1. Locks the queue row to read its current active status.
+ *   2. Determines the fairness rule when the mode is `Any`.
+ *   3. Builds a candidate query according to the mode and the fairness
+ *      restriction (if any).
+ *   4. Loops, locking each candidate ticket and verifying it is still
+ *      waiting, then marks it as called.
+ *   5. Throws a dedicated exception if no eligible ticket is found.
+ *
+ * @throws InactiveQueueException
+ * @throws NoWaitingTicketsException
+ */
+class CallNextTicket
+{
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        // Ensure the queue is still active and lock the row.
+        $ticket = DB::transaction(function () use ($queue, $calledBy, $mode) {
+            $lockedQueue = Queue::query()->whereKey($queue->id)->lockForUpdate()->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call ticket on an inactive queue.');
+            }
+
+            $queueId = $lockedQueue->id;
+
+            // Determine if fairness applies (only relevant for CallMode::Any).
+            $fairnessEnforced = false;
+            if ($mode === CallMode::Any) {
+                $lastCalled = Ticket::query()
+                    ->where('queue_id', $queueId)
+                    ->where('status', TicketStatus::Called)
+                    ->orderByDesc('called_at')
+                    ->orderByDesc('id')
+                    ->limit(3)
+                    ->get();
+
+                if ($lastCalled->count() === 3 && $lastCalled->every(fn (Ticket $t) => $t->priority > 0)) {
+                    // At least one normal waiting ticket must exist to trigger fairness.
+                    $hasNormalWaiting = Ticket::query()
+                        ->where('queue_id', $queueId)
+                        ->where('status', TicketStatus::Waiting)
+                        ->where('priority', 0)
+                        ->exists();
+                    if ($hasNormalWaiting) {
+                        $fairnessEnforced = true;
+                    }
+                }
+            }
+
+            // Build the candidate query.
+            $query = Ticket::query()
+                ->where('queue_id', $queueId)
+                ->where('status', TicketStatus::Waiting);
+
+            if ($mode === CallMode::PriorityOnly) {
+                $query->where('priority', '>', 0);
+            } elseif ($mode === CallMode::NormalOnly) {
+                $query->where('priority', 0);
+            } elseif ($fairnessEnforced) {
+                // Only normal tickets allowed.
+                $query->where('priority', 0);
+            }
+
+            // Ordering
+            if ($mode === CallMode::NormalOnly || $fairnessEnforced) {
+                $query->orderBy('issued_at')
+                    ->orderBy('id');
+            } else {
+                $query->orderByDesc('priority')
+                    ->orderBy('issued_at')
+                    ->orderBy('id');
+            }
+
+            // Loop to handle potential race conditions.
+            while (true) {
+                $candidate = $query->lockForUpdate()->first();
+
+                if (! $candidate) {
+                    throw new NoWaitingTicketsException('No waiting tickets available for the requested mode.');
+                }
+
+                // Re-check status after acquiring lock.
+                if ($candidate->status !== TicketStatus::Waiting) {
+                    // It was called by another process; retry.
+                    continue;
+                }
+
+                // Mark as called.
+                $candidate->status = TicketStatus::Called;
+                $candidate->called_at = now();
+                $candidate->called_by_user_id = $calledBy->id;
+                $candidate->save();
+
+                return $candidate;
+            }
+        });
+
+        // After transaction, refresh the ticket to return latest state.
+        return $ticket;
+    }
+}
