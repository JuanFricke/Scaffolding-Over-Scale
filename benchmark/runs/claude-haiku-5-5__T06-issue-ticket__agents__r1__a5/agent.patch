+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has the required columns and a slug unique per entity', function () {
+    expect(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+    ]))->toBeTrue()
+        ->and(Schema::hasIndex('queues', ['entity_id', 'slug'], 'unique'))->toBeTrue();
+});
+
+test('queue factory creates its entity, an active queue and a unique slug', function () {
+    $first = Queue::factory()->create();
+    $second = Queue::factory()->create();
+
+    expect($first->entity)->toBeInstanceOf(Entity::class)
+        ->and($first->is_active)->toBeTrue()
+        ->and($first->slug)->not->toBe($second->slug);
+});
+
+test('queue is_active is cast to a boolean and labels_i18n to an array', function () {
+    $queue = Queue::factory()->create([
+        'is_active' => 0,
+        'labels_i18n' => ['pt_BR' => 'Caixa', 'en' => 'Cashier'],
+    ])->refresh();
+
+    expect($queue->is_active)->toBeFalse()
+        ->and($queue->labels_i18n)->toBe(['pt_BR' => 'Caixa', 'en' => 'Cashier']);
+});
+
+test('slug must be unique within an entity but may repeat across entities', function () {
+    $entity = Entity::factory()->create();
+    Queue::factory()->for($entity)->create(['slug' => 'caixa']);
+
+    expect(fn () => Queue::factory()->for($entity)->create(['slug' => 'caixa']))
+        ->toThrow(QueryException::class);
+
+    $other = Queue::factory()->create(['slug' => 'caixa']);
+
+    expect($other->slug)->toBe('caixa');
+});
+
+test('entity exposes its queues and deleting the entity removes them', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create();
+    Queue::factory()->create();
+
+    expect($entity->queues)->toHaveCount(1)
+        ->and($entity->queues->first()->is($queue))->toBeTrue();
+
+    $entity->forceDelete();
+
+    expect(Queue::query()->whereKey($queue->id)->exists())->toBeFalse();
+});
