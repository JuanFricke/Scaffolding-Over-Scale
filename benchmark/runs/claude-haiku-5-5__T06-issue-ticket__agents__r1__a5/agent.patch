+
+uses(RefreshDatabase::class);
+
+test('tickets table has the required columns', function () {
+    expect(Schema::hasColumns('tickets', [
+        'id', 'queue_id', 'code', 'priority', 'channel', 'status', 'issued_at',
+        'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+    ]))->toBeTrue();
+});
+
+test('tickets are unique per queue and code and indexed for waiting order', function () {
+    expect(Schema::hasIndex('tickets', ['queue_id', 'code'], 'unique'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', ['queue_id', 'status', 'priority', 'issued_at']))->toBeTrue();
+});
+
+test('the same code may repeat across different queues', function () {
+    Ticket::factory()->create(['code' => 'A001']);
+    $other = Ticket::factory()->create(['code' => 'A001']);
+
+    expect($other->code)->toBe('A001');
+});
+
+test('a duplicate code within a queue is rejected by the database', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    expect(fn () => Ticket::factory()->forQueue($queue)->create(['code' => 'A001']))
+        ->toThrow(QueryException::class);
+});
+
+test('deleting a queue deletes its tickets', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->queue->delete();
+
+    expect(Ticket::query()->whereKey($ticket->id)->exists())->toBeFalse();
+});
+
+test('deleting the user who called a ticket keeps the ticket and clears the caller', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($user)->create();
+    $ticket->call($user);
+    $user->delete();
+
+    expect($ticket->refresh()->called_by_user_id)->toBeNull()
+        ->and($ticket->status->value)->toBe('called');
+});
