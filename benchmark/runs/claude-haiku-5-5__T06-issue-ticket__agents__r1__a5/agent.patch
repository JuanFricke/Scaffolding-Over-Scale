diff --git a/app/Models/Ticket.php b/app/Models/Ticket.php
new file mode 100644
index 0000000..b2b0f8f
--- /dev/null
+++ b/app/Models/Ticket.php
@@ -0,0 +1,125 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields that may still change after issuance. Every other field is write-once.
+     */
+    private const CALL_FIELDS = ['called_at', 'called_by_user_id'];
+
+    /**
+     * Display codes are the letter A followed by digits, e.g. A001 or A1000.
+     */
+    private const CODE_PATTERN = '/^A\d+$/';
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    protected static function booted(): void
+    {
+        // Guards every model save. Query-builder bulk updates bypass model events.
+        static::updating(function (self $ticket) {
+            $changed = array_keys($ticket->getDirty());
+
+            $immutable = array_diff($changed, ['status', ...self::CALL_FIELDS, 'updated_at']);
+
+            if ($immutable !== []) {
+                throw new LogicException('Ticket fields are write-once after issuance: '.implode(', ', $immutable).'.');
+            }
+
+            if (in_array('status', $changed, true)) {
+                $fromWaiting = $ticket->getRawOriginal('status') === TicketStatus::Waiting->value;
+                $toCalled = $ticket->status === TicketStatus::Called;
+
+                if (! $fromWaiting || ! $toCalled || $ticket->called_at === null || $ticket->called_by_user_id === null) {
+                    throw new LogicException('A ticket can only move from waiting to called, recording called_at and called_by_user_id.');
+                }
+            } elseif (array_intersect(self::CALL_FIELDS, $changed) !== []) {
+                throw new LogicException('Call fields can only be written together with the waiting to called transition.');
+            }
+        });
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * The next display code for a queue: the last well-formed code by insertion
+     * order plus one, zero-padded to three digits. Malformed legacy codes are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = static::query()
+            ->where('queue_id', $queueId)
+            ->lazyByIdDesc()
+            ->pluck('code')
+            ->first(fn (string $code) => preg_match(self::CODE_PATTERN, $code) === 1);
+
+        $number = $last === null ? 0 : (int) substr($last, 1);
+
+        return sprintf('A%03d', $number + 1);
+    }
+
+    /**
+     * Call this ticket: it becomes called and records the calling user. Only
+     * members of the ticket's entity may call, and only once.
+     *
+     * @throws AuthorizationException if the user is not a member of the ticket's entity.
+     * @throws LogicException if the ticket is not waiting.
+     */
+    public function call(User $user): void
+    {
+        Gate::forUser($user)->authorize('call', $this);
+
+        DB::transaction(function () use ($user) {
+            // Lock the row, then re-read it: this instance may be stale.
+            static::query()->whereKey($this->getKey())->lockForUpdate()->firstOrFail();
+            $this->refresh();
+
+            if ($this->status !== TicketStatus::Waiting) {
+                throw new LogicException('Only waiting tickets can be called.');
+            }
+
+            $this->status = TicketStatus::Called;
+            $this->called_at = now();
+            $this->called_by_user_id = $user->id;
+            $this->save();
+        });
+    }
+}
