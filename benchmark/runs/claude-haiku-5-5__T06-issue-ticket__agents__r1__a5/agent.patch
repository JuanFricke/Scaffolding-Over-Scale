@@ -0,0 +1,63 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Attempts before giving up on a (queue_id, code) collision with a concurrent issuance.
+     */
+    private const MAX_ATTEMPTS = 3;
+
+    /**
+     * Issue a waiting ticket in the queue with the next display code.
+     *
+     * @throws InvalidArgumentException if the priority is negative.
+     * @throws InactiveQueueException if the queue is inactive, as read from the database.
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be zero or greater.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(fn () => $this->issue($queue, $priority, $channel));
+            } catch (UniqueConstraintViolationException $exception) {
+                if ($attempt === self::MAX_ATTEMPTS) {
+                    throw $exception;
+                }
+            }
+        }
+    }
+
+    private function issue(Queue $queue, int $priority, TicketChannel $channel): Ticket
+    {
+        // Lock the queue row so issuances for it serialize, and read its state from the
+        // database: the caller's instance may be stale.
+        $locked = Queue::query()->lockForUpdate()->findOrFail($queue->getKey());
+
+        if (! $locked->is_active) {
+            throw new InactiveQueueException("Queue {$locked->getKey()} is inactive.");
+        }
+
+        return Ticket::query()->create([
+            'queue_id' => $locked->getKey(),
+            'code' => Ticket::nextCode($locked->getKey()),
+            'priority' => $priority,
+            'channel' => $channel,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ]);
+    }
+}
