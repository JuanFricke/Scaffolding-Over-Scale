+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('issues a waiting ticket into an active queue', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+
+    $ticket = (new IssueTicket)($queue);
+
+    expect($ticket)
+        ->toBeInstanceOf(Ticket::class)
+        ->queue_id->toBe($queue->id)
+        ->code->toBe('A001')
+        ->status->toBe(TicketStatus::Waiting)
+        ->channel->toBe(TicketChannel::Virtual)
+        ->priority->toBe(0)
+        ->issued_at->not->toBeNull();
+});
+
+it('allocates sequential codes on the same queue', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $first = (new IssueTicket)($queue);
+    $second = (new IssueTicket)($queue);
+
+    expect($first->code)->toBe('A001');
+    expect($second->code)->toBe('A002');
+});
+
+it('continues the sequence after a ticket is deleted', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    (new IssueTicket)($queue);
+    $second = (new IssueTicket)($queue);
+    (new IssueTicket)($queue);
+
+    $second->delete();
+
+    $next = (new IssueTicket)($queue);
+
+    expect($next->code)->toBe('A004');
+});
+
+it('rejects issuing into an inactive queue', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('rejects a negative priority', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    expect(fn () => (new IssueTicket)($queue, -1))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('restarts the sequence after a malformed code', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'A-X']);
+
+    $next = (new IssueTicket)($queue);
+
+    expect($next->code)->toBe('A001');
+});
+
+it('skips a malformed latest code instead of colliding on A001', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+    Ticket::factory()->for($queue)->create(['code' => 'A-X']);
+
+    $next = (new IssueTicket)($queue);
+
+    expect($next->code)->toBe('A002');
+});
+
+it('rejects issuing with a stale active instance after deactivation', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new IssueTicket)($stale))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->count())->toBe(0);
+});
+
+it('allocates distinct codes via forQueue', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001');
+    expect($second->code)->toBe('A002');
+});
+
+it('calls a waiting ticket exactly once', function () {
+    $attendant = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($attendant)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue);
+
+    $ticket->call($attendant);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($attendant->id)
+        ->called_at->not->toBeNull();
+
+    expect(fn () => $ticket->fresh()->call($attendant))
+        ->toThrow(LogicException::class);
+});
+
+it('rejects ticket call from a non-member', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue);
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))
+        ->toThrow(AuthorizationException::class);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('continues the sequence past A999', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'A999']);
+    Ticket::factory()->for($queue)->create(['code' => 'A1000']);
+
+    $next = (new IssueTicket)($queue);
+
+    expect($next->code)->toBe('A1001');
+});
+
+it('rejects mutating immutable ticket fields after issuance', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue);
+
+    expect(fn () => $ticket->forceFill(['code' => 'A999'])->save())
+        ->toThrow(LogicException::class);
+
+    expect(fn () => $ticket->fresh()->update(['priority' => 5]))
+        ->toThrow(LogicException::class);
+});
+
+it('exposes entity queues and queue tickets relations', function () {
+    $entity = Entity::factory()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $ticket = (new IssueTicket)($queue);
+
+    expect($entity->queues)->toHaveCount(1)
+        ->and($entity->queues->first()->is($queue))->toBeTrue()
+        ->and($queue->tickets)->toHaveCount(1)
+        ->and($queue->tickets->first()->is($ticket))->toBeTrue();
+});
