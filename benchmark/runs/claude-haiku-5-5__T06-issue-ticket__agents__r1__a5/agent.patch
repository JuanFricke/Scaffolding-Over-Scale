+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('a member of the ticket entity calls a waiting ticket', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($user)->create();
+
+    $ticket->call($user);
+
+    $ticket->refresh();
+
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_by_user_id)->toBe($user->id)
+        ->and($ticket->called_at->diffInSeconds(now(), true))->toBeLessThan(5)
+        ->and($ticket->calledBy->is($user))->toBeTrue();
+});
+
+test('every membership role may call tickets of its entity', function (string $role) {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($user)->state(['role' => $role])->create();
+
+    $ticket->call($user);
+
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Called);
+})->with(['owner', 'admin', 'employee']);
+
+test('a user outside the entity cannot call and the ticket is unchanged', function () {
+    $ticket = Ticket::factory()->create();
+    $outsider = User::factory()->create();
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class);
+
+    $stored = Ticket::query()->whereKey($ticket->id)->first();
+
+    expect($stored->status)->toBe(TicketStatus::Waiting)
+        ->and($stored->called_at)->toBeNull()
+        ->and($stored->called_by_user_id)->toBeNull();
+});
+
+test('a member of another entity cannot call the ticket', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+    EntityMembership::factory()->for(Entity::factory())->for($user)->create();
+
+    expect(fn () => $ticket->call($user))->toThrow(AuthorizationException::class);
+
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a ticket can be called only once', function () {
+    $ticket = Ticket::factory()->create();
+    $first = User::factory()->create();
+    $second = User::factory()->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($first)->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($second)->create();
+    $ticket->call($first);
+
+    expect(fn () => $ticket->call($second))->toThrow(LogicException::class);
+
+    expect($ticket->refresh()->called_by_user_id)->toBe($first->id);
+});
+
+test('a stale instance cannot call a ticket another attendant already called', function () {
+    $ticket = Ticket::factory()->create();
+    $first = User::factory()->create();
+    $second = User::factory()->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($first)->create();
+    EntityMembership::factory()->for($ticket->queue->entity)->for($second)->create();
+
+    $stale = Ticket::query()->whereKey($ticket->id)->first();
+    Ticket::query()->whereKey($ticket->id)->first()->call($first);
+
+    expect(fn () => $stale->call($second))->toThrow(LogicException::class);
+
+    expect(Ticket::query()->whereKey($ticket->id)->value('called_by_user_id'))->toBe($first->id);
+});
