+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('write-once fields cannot change after issuance', function (string $field, mixed $value) {
+    $ticket = Ticket::factory()->create(['priority' => 1]);
+
+    expect(fn () => $ticket->update([$field => $value]))
+        ->toThrow(LogicException::class);
+
+    expect(Ticket::query()->whereKey($ticket->id)->value($field))
+        ->not->toBe($value);
+})->with([
+    'code' => ['code', 'Z999'],
+    'priority' => ['priority', 5],
+    'channel' => ['channel', TicketChannel::Printed],
+    'queue_id' => ['queue_id', 999],
+    'issued_at' => ['issued_at', now()->addDay()],
+]);
+
+test('a save that changes a write-once field is rejected even alongside a call field', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+    $ticket->status = TicketStatus::Called;
+    $ticket->called_at = now();
+    $ticket->called_by_user_id = $user->id;
+    $ticket->priority = 9;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->priority)->toBe(0);
+});
+
+test('call fields cannot be written without the waiting to called transition', function () {
+    $ticket = Ticket::factory()->create();
+    $ticket->called_at = now();
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+});
+
+test('the waiting to called transition must record when and by whom', function () {
+    $ticket = Ticket::factory()->create();
+    $ticket->forceFill(['status' => TicketStatus::Called, 'called_at' => now()]);
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+test('a called ticket cannot go back to waiting', function () {
+    $ticket = Ticket::factory()->create();
+    $ticket->forceFill([
+        'status' => TicketStatus::Called,
+        'called_at' => now(),
+        'called_by_user_id' => User::factory()->create()->id,
+    ])->save();
+
+    $ticket->status = TicketStatus::Waiting;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+});
+
+test('a waiting to called transition with its call fields is saved', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+
+    $ticket->forceFill([
+        'status' => TicketStatus::Called,
+        'called_at' => now(),
+        'called_by_user_id' => $user->id,
+    ])->save();
+
+    expect($ticket->refresh()->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_by_user_id)->toBe($user->id);
+});
