+++ b/tests/Feature/Queue/IssueTicketTest.php
@@ -0,0 +1,120 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+afterEach(function () {
+    // The collision test below registers a creating listener; never leak it into other tests.
+    Ticket::getEventDispatcher()->forget('eloquent.creating: '.Ticket::class);
+});
+
+test('issuing a ticket creates a waiting virtual ticket with priority 0 and the first code', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = app(IssueTicket::class)($queue);
+
+    expect($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull()
+        ->and($ticket->issued_at->diffInSeconds(now(), true))->toBeLessThan(5);
+});
+
+test('issuing keeps the requested priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = app(IssueTicket::class)($queue, 20, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(20)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and($ticket->refresh()->priority)->toBe(20)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem);
+});
+
+test('consecutive issues in a queue get consecutive codes', function () {
+    $queue = Queue::factory()->create();
+    $issue = app(IssueTicket::class);
+
+    $first = $issue($queue);
+    $second = $issue($queue);
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002');
+});
+
+test('a negative priority is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => app(IssueTicket::class)($queue, -1))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('an inactive queue is rejected and nothing is persisted', function () {
+    $queue = Queue::factory()->inactive()->create();
+
+    expect(fn () => app(IssueTicket::class)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('a queue deactivated after the caller loaded it is still rejected', function () {
+    $queue = Queue::factory()->create();
+    expect($queue->is_active)->toBeTrue();
+
+    Queue::query()->whereKey($queue->id)->update(['is_active' => false]);
+
+    expect(fn () => app(IssueTicket::class)($queue))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(0);
+});
+
+test('a code collision is retried and the ticket is issued with the next free code', function () {
+    $queue = Queue::factory()->create();
+    $attempts = 0;
+
+    Ticket::creating(function (Ticket $ticket) use (&$attempts, $queue) {
+        $attempts++;
+
+        if ($attempts === 1) {
+            // A concurrent issuance takes the code between the read and this insert.
+            Ticket::withoutEvents(fn () => Ticket::factory()->forQueue($queue)->create(['code' => $ticket->code]));
+        }
+    });
+
+    $ticket = app(IssueTicket::class)($queue);
+
+    expect($attempts)->toBe(2)
+        ->and($ticket->code)->toBe('A001')
+        ->and(Ticket::query()->where('queue_id', $queue->id)->count())->toBe(1);
+});
+
+test('issuing gives up after three colliding attempts', function () {
+    $queue = Queue::factory()->create();
+    $attempts = 0;
+
+    Ticket::creating(function (Ticket $ticket) use (&$attempts, $queue) {
+        $attempts++;
+
+        Ticket::withoutEvents(fn () => Ticket::factory()->forQueue($queue)->create(['code' => $ticket->code]));
+    });
+
+    expect(fn () => app(IssueTicket::class)($queue))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    expect($attempts)->toBe(3);
+});
