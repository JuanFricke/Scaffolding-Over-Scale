@@ -0,0 +1,69 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Support\CurrentEntity;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+class ResolveCurrentEntity
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+
+        if ($user === null) {
+            return $next($request);
+        }
+
+        $entityId = $request->session()->get('current_entity_id');
+
+        if ($entityId !== null) {
+            $entity = Entity::find($entityId);
+
+            if ($entity === null) {
+                $request->session()->forget('current_entity_id');
+            } else {
+                if ($user->membershipFor($entity->id) === null) {
+                    abort(403);
+                }
+
+                $this->setContext($request, $entity);
+
+                return $next($request);
+            }
+        }
+
+        $count = $user->memberships()->count();
+
+        if ($count === 0) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($count === 1) {
+            /** @var EntityMembership $membership */
+            $membership = $user->memberships()->first();
+            $entity = $membership->entity;
+
+            $request->session()->put('current_entity_id', $entity->id);
+            $this->setContext($request, $entity);
+
+            return $next($request);
+        }
+
+        return redirect()->route('entity.switcher');
+    }
+
+    protected function setContext(Request $request, Entity $entity): void
+    {
+        $request->attributes->set('current_entity', $entity);
+        app()->instance('current_entity', $entity);
+
+        if (app()->bound(CurrentEntity::class)) {
+            app(CurrentEntity::class)->entity = $entity;
+        }
+    }
+}
