@@ -0,0 +1,96 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+class CreateEntity extends Component
+{
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(): void
+    {
+        $this->validate();
+
+        $user = Auth::user();
+
+        $entity = null;
+
+        for ($attempt = 0; $attempt < 5; $attempt++) {
+            $slug = $this->uniqueSlug($this->name);
+
+            try {
+                $entity = DB::transaction(function () use ($slug, $user) {
+                    $created = Entity::create([
+                        'name' => $this->name,
+                        'slug' => $slug,
+                    ]);
+
+                    $created->memberships()->create([
+                        'user_id' => $user->id,
+                        'role' => UserRole::Owner,
+                    ]);
+
+                    return $created;
+                });
+
+                break;
+            } catch (QueryException $e) {
+                if ($attempt === 4) {
+                    throw $e;
+                }
+
+                $message = strtolower($e->getMessage());
+
+                if ($e->getCode() !== '23000' && ! str_contains($message, 'unique') && ! str_contains($message, 'duplicate')) {
+                    throw $e;
+                }
+            }
+        }
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $user->id,
+        ]);
+
+        session(['current_entity_id' => $entity->id]);
+
+        $this->redirect(route('entity.dashboard', $entity));
+    }
+
+    protected function uniqueSlug(string $name): string
+    {
+        $base = Str::slug($name);
+
+        if ($base === '') {
+            $base = 'entity';
+        }
+
+        $slug = $base;
+        $suffix = 1;
+
+        while (Entity::withTrashed()->where('slug', $slug)->exists()) {
+            $suffix++;
+            $slug = $base.'-'.$suffix;
+        }
+
+        return $slug;
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->layout('layouts::default-page', [
+            'title' => __('ui.onboarding_title'),
+        ]);
+    }
+}
