     /** @use HasFactory<QueueFactory> */
     use HasFactory;
 
+    /**
+     * Default ticket code prefix per priority level (Normal, Priority, 80+).
+     *
+     * @var array<int, string>
+     */
+    public const DEFAULT_PREFIX_MAP = [0 => 'N', 10 => 'P', 20 => 'E'];
+
+    /**
+     * Default prefix for a priority; values outside the map fall back by range.
+     */
+    public static function defaultPrefixFor(int $priority): string
+    {
+        return self::DEFAULT_PREFIX_MAP[$priority] ?? match (true) {
+            $priority <= 0 => self::DEFAULT_PREFIX_MAP[0],
+            $priority >= 20 => self::DEFAULT_PREFIX_MAP[20],
+            default => self::DEFAULT_PREFIX_MAP[10],
+        };
+    }
+
+    /**
+     * Ticket code prefix for a priority: the queue's custom entry, else the default.
+     */
+    public function prefixForPriority(int $priority): string
+    {
+        $map = $this->priority_prefix_map;
+
+        if (is_array($map) && isset($map[$priority]) && is_string($map[$priority])) {
+            return $map[$priority];
+        }
+
+        return self::defaultPrefixFor($priority);
+    }
+
+    /**
+     * Validate and normalize a priority -> prefix map (empty becomes null).
+     *
+     * Keys must be canonical non-negative integers, values one uppercase
+     * letter, and the effective prefixes (custom entries plus the default for
+     * the uncovered levels 0/10/20) must be unique.
+     *
+     * @return array<int, string>|null
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function normalizePriorityPrefixMap(mixed $map): ?array
+    {
+        if ($map === null || $map === []) {
+            return null;
+        }
+
+        if (! is_array($map)) {
+            throw new InvalidArgumentException('Priority prefix map must be an array.');
+        }
+
+        $normalized = [];
+
+        foreach ($map as $key => $letter) {
+            // PHP turns canonical integer string keys ("10") into ints, so
+            // anything still a string here is non-canonical ("010", "foo").
+            if (! is_int($key) || $key < 0) {
+                throw new InvalidArgumentException('Priority prefix map keys must be non-negative integers.');
+            }
+
+            if (! is_string($letter) || ! preg_match('/^[A-Z]$/D', $letter)) {
+                throw new InvalidArgumentException('Priority prefix map values must be a single uppercase letter A-Z.');
+            }
+
+            $normalized[$key] = $letter;
+        }
+
+        $effective = $normalized + self::DEFAULT_PREFIX_MAP;
+
+        if (count(array_unique($effective)) !== count($effective)) {
+            throw new InvalidArgumentException('Priority prefixes must be unique.');
+        }
+
+        ksort($normalized);
+
+        return $normalized;
+    }
+
+    protected static function booted(): void
+    {
+        static::saving(function (Queue $queue): void {
+            $queue->priority_prefix_map = self::normalizePriorityPrefixMap($queue->priority_prefix_map);
+        });
+    }
+
     /**
