diff --git a/tests/Feature/QueuePrefixTest.php b/tests/Feature/QueuePrefixTest.php
new file mode 100644
index 0000000..c0bcdb5
--- /dev/null
+++ b/tests/Feature/QueuePrefixTest.php
@@ -0,0 +1,114 @@
+<?php
+
+use App\Actions\UpdateQueue;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('resolves default prefixes with range fallback', function (int $priority, string $prefix) {
+    expect(Queue::defaultPrefixFor($priority))->toBe($prefix)
+        ->and(Queue::factory()->create()->prefixForPriority($priority))->toBe($prefix);
+})->with([
+    [0, 'N'], [10, 'P'], [20, 'E'],
+    [-5, 'N'], [1, 'P'], [9, 'P'], [11, 'P'], [19, 'P'], [21, 'E'], [99, 'E'],
+]);
+
+it('lets a custom map win and falls back to the default otherwise', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['10' => 'Y']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([10 => 'Y'])
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(20))->toBe('E');
+});
+
+it('accepts a full custom map', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => [0 => 'X', 10 => 'Y', 20 => 'Z']]);
+
+    expect($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(20))->toBe('Z');
+});
+
+it('stores an empty map as null', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->priority_prefix_map)->toBeNull()
+        ->and($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects invalid maps on save', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+
+    $queue = Queue::factory()->create();
+    $queue->priority_prefix_map = $map;
+
+    expect(fn () => $queue->save())->toThrow(InvalidArgumentException::class);
+})->with([
+    'non numeric key' => [['foo' => 'X']],
+    'negative key' => [['-1' => 'X']],
+    'non canonical key' => [['010' => 'X']],
+    'multi letter value' => [['0' => 'xx']],
+    'lowercase value' => [['0' => 'x']],
+    'digit value' => [['0' => '1']],
+    'duplicate custom' => [['0' => 'N', '10' => 'N']],
+    'merges normal with 80+' => [['0' => 'E']],
+    'collides with uncovered default' => [['0' => 'P']],
+]);
+
+function prefixMapOwner(Queue $queue): User
+{
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($queue->entity)->for($owner)->owner()->create();
+
+    return $owner;
+}
+
+it('updates, keeps and clears the map through UpdateQueue', function () {
+    $queue = Queue::factory()->create();
+    $owner = prefixMapOwner($queue);
+
+    $updated = (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X', '10' => 'Y']);
+    expect($updated->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y']);
+
+    (new UpdateQueue)($queue->fresh(), $owner, name: 'Renamed');
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y']);
+
+    (new UpdateQueue)($queue->fresh(), $owner, priorityPrefixMap: []);
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects an invalid map in UpdateQueue and leaves the queue unchanged', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X']]);
+    $owner = prefixMapOwner($queue);
+    $name = $queue->name;
+
+    try {
+        (new UpdateQueue)($queue, $owner, name: 'Changed', priorityPrefixMap: ['0' => 'E']);
+        $this->fail('Expected ValidationException');
+    } catch (ValidationException $e) {
+        expect($e->errors())->toHaveKey('priority_prefix_map');
+    }
+
+    expect($queue->fresh())
+        ->name->toBe($name)
+        ->priority_prefix_map->toBe([0 => 'X']);
+});
+
+it('denies map changes to non-owners and keeps the map out of mass assignment', function () {
+    $queue = Queue::factory()->create();
+    $outsider = User::factory()->create();
+
+    expect(fn () => (new UpdateQueue)($queue, $outsider, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    $filled = (new Queue)->fill(['priority_prefix_map' => ['0' => 'X']]);
+    expect($filled->priority_prefix_map)->toBeNull();
+
+});
diff --git a/tests/Feature/TicketDailyCodeTest.php b/tests/Feature/TicketDailyCodeTest.php
new file mode 100644
index 0000000..b116e3a
--- /dev/null
+++ b/tests/Feature/TicketDailyCodeTest.php
@@ -0,0 +1,111 @@
+<?php
+
+use App\Actions\IssueTicket;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+afterEach(fn () => Carbon::setTestNow());
+
+it('sequences prefixes independently by priority', function () {
+    $queue = Queue::factory()->create();
+    $issue = new IssueTicket;
+
+    $codes = [
+        $issue($queue)->code, $issue($queue)->code,
+        $issue($queue, 10)->code, $issue($queue, 10)->code,
+        $issue($queue, 20)->code,
+        $issue($queue, 3)->code,
+    ];
+
+    expect($codes)->toBe(['N001', 'N002', 'P001', 'P002', 'E001', 'P003']);
+});
+
+it('uses the queue custom prefixes', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => [0 => 'X', 10 => 'Y']]);
+
+    expect((new IssueTicket)($queue)->code)->toBe('X001')
+        ->and((new IssueTicket)($queue, 10)->code)->toBe('Y001')
+        ->and((new IssueTicket)($queue, 20)->code)->toBe('E001');
+});
+
+it('restarts every prefix at 001 on the next day', function () {
+    $queue = Queue::factory()->create();
+
+    Carbon::setTestNow('2026-09-28 23:59:00');
+    (new IssueTicket)($queue);
+    (new IssueTicket)($queue, 10);
+
+    Carbon::setTestNow('2026-09-29 00:01:00');
+    $normal = (new IssueTicket)($queue);
+    $priority = (new IssueTicket)($queue, 10);
+
+    expect($normal)->code->toBe('N001')
+        ->and($normal->issue_date->toDateString())->toBe('2026-09-29')
+        ->and($priority->code)->toBe('P001');
+});
+
+it('stores issue_date from the same instant as issued_at', function () {
+    $queue = Queue::factory()->create();
+    Carbon::setTestNow('2026-09-28 23:59:59');
+
+    $ticket = (new IssueTicket)($queue)->fresh();
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($ticket->issued_at->toDateString())->toBe('2026-09-28');
+});
+
+it('skips malformed codes and ignores legacy A codes', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+    expect((new IssueTicket)($queue)->code)->toBe('N001');
+
+    $other = Queue::factory()->create();
+    Ticket::factory()->for($other)->create(['code' => 'N-X']);
+    expect((new IssueTicket)($other)->code)->toBe('N001');
+
+    $third = Queue::factory()->create();
+    Ticket::factory()->for($third)->create(['code' => 'N001']);
+    Ticket::factory()->for($third)->create(['code' => 'N-X']);
+    expect((new IssueTicket)($third)->code)->toBe('N002');
+});
+
+it('does not reuse gaps and continues past 999', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'N999']);
+    Ticket::factory()->for($queue)->create(['code' => 'N1000']);
+
+    expect((new IssueTicket)($queue)->code)->toBe('N1001');
+});
+
+it('lets the factory allocate by priority and issued_at day', function () {
+    $queue = Queue::factory()->create();
+
+    $today = Ticket::factory()->forQueue($queue)->create();
+    $past = Ticket::factory()->forQueue($queue)->create(['issued_at' => '2026-09-28 10:00:00']);
+    $priority = Ticket::factory()->forQueue($queue)->create(['priority' => 10]);
+    $explicit = Ticket::factory()->forQueue($queue)->create(['code' => 'Z042']);
+
+    expect($today->code)->toBe('N001')
+        ->and($today->issue_date->toDateString())->toBe(today()->toDateString())
+        ->and($past->code)->toBe('N001')
+        ->and($past->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($priority->code)->toBe('P001')
+        ->and($explicit->code)->toBe('Z042');
+});
+
+it('allows the same code on different days but not on the same day', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'N001', 'issued_at' => '2026-09-27 10:00:00']);
+    Ticket::factory()->for($queue)->create(['code' => 'N001', 'issued_at' => '2026-09-28 10:00:00']);
+
+    expect(fn () => Ticket::factory()->for($queue)->create(['code' => 'N001', 'issued_at' => '2026-09-28 11:00:00']))
+        ->toThrow(QueryException::class);
+});
