+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Policies\QueuePolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function queuePolicyFixture(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $outsider = User::factory()->create();
+
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    $employeeMembership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    return [$entity, $owner, $admin, $employee, $outsider, $employeeMembership, $queue];
+}
+
+it('allows only owner and admin to create a queue in an entity', function () {
+    [$entity, $owner, $admin, $employee, $outsider] = queuePolicyFixture();
+    $policy = new QueuePolicy;
+
+    expect($policy->create($owner, $entity))->toBeTrue()
+        ->and($policy->create($admin, $entity))->toBeTrue()
+        ->and($policy->create($employee, $entity))->toBeFalse()
+        ->and($policy->create($outsider, $entity))->toBeFalse();
+});
+
+it('allows only owner and admin to update or manage access', function () {
+    [, $owner, $admin, $employee, $outsider, , $queue] = queuePolicyFixture();
+    $policy = new QueuePolicy;
+
+    expect($policy->update($owner, $queue))->toBeTrue()
+        ->and($policy->update($admin, $queue))->toBeTrue()
+        ->and($policy->update($employee, $queue))->toBeFalse()
+        ->and($policy->update($outsider, $queue))->toBeFalse()
+        ->and($policy->manageAccess($owner, $queue))->toBeTrue()
+        ->and($policy->manageAccess($admin, $queue))->toBeTrue()
+        ->and($policy->manageAccess($employee, $queue))->toBeFalse()
+        ->and($policy->manageAccess($outsider, $queue))->toBeFalse();
+});
+
+it('lets managers call without a grant', function (string $role) {
+    [, $owner, $admin, , , , $queue] = queuePolicyFixture();
+    $policy = new QueuePolicy;
+    $actor = $role === 'owner' ? $owner : $admin;
+
+    expect($policy->call($actor, $queue))->toBeTrue();
+})->with(['owner', 'admin']);
+
+it('lets an employee call only with a call grant on that queue', function () {
+    [$entity, , , $employee, , $employeeMembership, $queue] = queuePolicyFixture();
+    $policy = new QueuePolicy;
+
+    expect($policy->call($employee, $queue))->toBeFalse();
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $employeeMembership->id,
+        'queue_id' => $queue->id,
+        'permissions' => ['call'],
+    ]);
+
+    expect($policy->call($employee->fresh(), $queue->fresh()))->toBeTrue();
+
+    $otherQueue = Queue::factory()->for($entity)->create();
+    expect($policy->call($employee->fresh(), $otherQueue))->toBeFalse();
+});
+
+it('denies an employee when the grant has no call permission', function () {
+    [, , , $employee, , $employeeMembership, $queue] = queuePolicyFixture();
+    $policy = new QueuePolicy;
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $employeeMembership->id,
+        'queue_id' => $queue->id,
+        'permissions' => [],
+    ]);
+
+    expect($policy->call($employee->fresh(), $queue->fresh()))->toBeFalse();
+});
+
+it('denies an employee whose stored permissions are not an array', function () {
+    [, , , $employee, , $employeeMembership, $queue] = queuePolicyFixture();
+    $policy = new QueuePolicy;
+
+    $access = QueueAccess::factory()->create([
+        'entity_membership_id' => $employeeMembership->id,
+        'queue_id' => $queue->id,
+    ]);
+
+    DB::table('queue_access')
+        ->where('id', $access->id)
+        ->update(['permissions' => json_encode('call')]);
+
+    expect($policy->call($employee->fresh(), $queue->fresh()))->toBeFalse();
+});
+
+it('denies call to employees of another entity and non-members', function () {
+    [, , , , $outsider, , $queue] = queuePolicyFixture();
+    $otherEntity = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($otherOwner)->owner()->create();
+    $policy = new QueuePolicy;
+
+    expect($policy->call($otherOwner, $queue))->toBeFalse()
+        ->and($policy->call($outsider, $queue))->toBeFalse();
+});
+
+it('is auto-discovered by the gate', function () {
+    [$entity, $owner, , $employee, , $employeeMembership, $queue] = queuePolicyFixture();
+
+    expect(Gate::forUser($owner)->allows('create', [Queue::class, $entity]))->toBeTrue()
+        ->and(Gate::forUser($employee)->allows('create', [Queue::class, $entity]))->toBeFalse()
+        ->and(Gate::forUser($owner)->allows('update', $queue))->toBeTrue();
+
+    QueueAccess::factory()->create([
+        'entity_membership_id' => $employeeMembership->id,
+        'queue_id' => $queue->id,
+    ]);
+
+    expect(Gate::forUser($employee->fresh())->allows('call', $queue->fresh()))->toBeTrue();
+});
