@@ -0,0 +1,93 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Grant or revoke a membership's permissions on a queue.
+     *
+     * A non-empty permission list upserts the grant; an empty list revokes it.
+     *
+     * @param  array<int|string, mixed>  $permissions
+     *
+     * @throws AuthorizationException
+     * @throws ValidationException
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => __('The membership and queue must belong to the same entity.'),
+            ]);
+        }
+
+        $permissions = $this->validatedPermissions($permissions);
+        $context = [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+        ];
+
+        if ($permissions === []) {
+            $deleted = QueueAccess::query()
+                ->where('entity_membership_id', $targetMembership->id)
+                ->where('queue_id', $queue->id)
+                ->delete();
+
+            if ($deleted > 0) {
+                Log::channel('audit')->info('queue.access.revoked', $context);
+            }
+
+            return;
+        }
+
+        QueueAccess::query()->updateOrCreate(
+            [
+                'entity_membership_id' => $targetMembership->id,
+                'queue_id' => $queue->id,
+            ],
+            ['permissions' => $permissions],
+        );
+
+        Log::channel('audit')->info('queue.access.granted', $context);
+    }
+
+    /**
+     * @param  array<int|string, mixed>  $permissions
+     * @return list<string>
+     */
+    private function validatedPermissions(array $permissions): array
+    {
+        $allowed = array_map(
+            static fn (QueuePermission $permission): string => $permission->value,
+            QueuePermission::cases(),
+        );
+
+        foreach ($permissions as $permission) {
+            if (! is_string($permission) || ! in_array($permission, $allowed, true)) {
+                throw ValidationException::withMessages([
+                    'permissions' => __('The permissions must be known queue permissions.'),
+                ]);
+            }
+        }
+
+        return array_values($permissions);
+    }
+}
