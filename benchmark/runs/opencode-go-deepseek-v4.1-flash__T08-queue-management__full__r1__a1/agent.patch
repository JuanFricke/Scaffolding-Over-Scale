+
+    expect(Queue::query()->count())->toBe(0);
+})->with([
+    'empty' => [''],
+    'whitespace only' => ['   '],
+    'too long' => [str_repeat('a', 256)],
+]);
+
+it('rejects a duplicate slug within the same entity', function () {
+    [$entity, $owner] = ownedQueueFixture();
+
+    (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+
+    expect(fn () => (new CreateQueue)($entity, $owner, 'Atendimento Geral'))
+        ->toThrow(ValidationException::class);
+
+    expect(Queue::query()->where('entity_id', $entity->id)->count())->toBe(1);
+});
+
+it('allows the same slug in another entity', function () {
+    [$entityA, $ownerA] = ownedQueueFixture();
+    [$entityB, $ownerB] = ownedQueueFixture();
+
+    (new CreateQueue)($entityA, $ownerA, 'Atendimento Geral');
+    $queueB = (new CreateQueue)($entityB, $ownerB, 'Atendimento Geral');
+
+    expect($queueB->slug)->toBe('atendimento-geral')
+        ->and(Queue::query()->where('slug', 'atendimento-geral')->count())->toBe(2);
+});
+
+it('denies queue creation to employees, other entities and non-members', function (string $case) {
+    [$entity, $owner] = ownedQueueFixture();
+    [$otherEntity, $otherOwner] = ownedQueueFixture();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $outsider = User::factory()->create();
+
+    $actor = match ($case) {
+        'employee' => $employee,
+        'other entity' => $otherOwner,
+        'non-member' => $outsider,
+    };
+
+    expect(fn () => (new CreateQueue)($entity, $actor, 'Fila'))
+        ->toThrow(AuthorizationException::class);
+
+    expect(Queue::query()->where('entity_id', $entity->id)->count())->toBe(0);
+})->with(['employee', 'other entity', 'non-member']);
+
+it('updates name, slug and active flag independently', function () {
+    [$entity, $owner] = ownedQueueFixture();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+
+    (new UpdateQueue)($queue, $owner, name: 'Recepção');
+    expect($queue->fresh())
+        ->name->toBe('Recepção')
+        ->slug->toBe('atendimento-geral')
+        ->is_active->toBeTrue();
+
+    (new UpdateQueue)($queue, $owner, slug: 'Novo Slug');
+    expect($queue->fresh())
+        ->name->toBe('Recepção')
+        ->slug->toBe('novo-slug');
+
+    (new UpdateQueue)($queue, $owner, isActive: false);
+    expect($queue->fresh()->is_active)->toBeFalse();
+});
+
+it('allows a queue to keep its own slug on update', function () {
+    [$entity, $owner] = ownedQueueFixture();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+
+    (new UpdateQueue)($queue, $owner, name: 'Atendimento Geral 2', slug: 'atendimento-geral');
+
+    expect($queue->fresh())
+        ->name->toBe('Atendimento Geral 2')
+        ->slug->toBe('atendimento-geral');
+});
+
+it('rejects taking another queue slug in the same entity', function () {
+    [$entity, $owner] = ownedQueueFixture();
+    (new CreateQueue)($entity, $owner, 'Fila A');
+    $queueB = (new CreateQueue)($entity, $owner, 'Fila B');
+
+    expect(fn () => (new UpdateQueue)($queueB, $owner, slug: 'fila-a'))
+        ->toThrow(ValidationException::class);
+
+    expect($queueB->fresh()->slug)->toBe('fila-b');
+});
+
+it('denies queue updates to employees, other entities and non-members', function (string $case) {
+    [$entity, $owner] = ownedQueueFixture();
+    [$otherEntity, $otherOwner] = ownedQueueFixture();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $outsider = User::factory()->create();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+
+    $actor = match ($case) {
+        'employee' => $employee,
+        'other entity' => $otherOwner,
+        'non-member' => $outsider,
+    };
+
+    expect(fn () => (new UpdateQueue)($queue, $actor, name: 'Alterada'))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->name)->toBe('Atendimento Geral');
+})->with(['employee', 'other entity', 'non-member']);
+
+it('deactivates instead of deleting and keeps tickets', function () {
+    [$entity, $owner] = ownedQueueFixture();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+    $ticket = (new IssueTicket)($queue);
+
+    (new UpdateQueue)($queue, $owner, isActive: false);
+
+    expect(Queue::query()->whereKey($queue->id)->exists())->toBeTrue()
+        ->and(Ticket::query()->whereKey($ticket->id)->exists())->toBeTrue();
+
+    expect(fn () => (new IssueTicket)($queue->fresh()))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(fn () => (new CallNextTicket)($queue->fresh(), $owner))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status->value)->toBe('waiting');
+});
