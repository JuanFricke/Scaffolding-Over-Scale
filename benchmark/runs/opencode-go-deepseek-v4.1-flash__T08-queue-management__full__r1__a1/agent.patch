+        ->and(Schema::hasColumns('queue_access', [
+            'id', 'entity_membership_id', 'queue_id', 'permissions', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('queue_access', 'queue_access_entity_membership_id_queue_id_unique'))->toBeTrue();
+});
