+
+    expect($queue)
+        ->toBeInstanceOf(Queue::class)
+        ->entity_id->toBe($entity->id)
+        ->name->toBe('Atendimento Geral')
+        ->slug->toBe('atendimento-geral')
+        ->is_active->toBeTrue();
+});
+
+it('slugifies an explicit slug', function () {
+    [$entity, $owner] = ownedQueueFixture();
+
+    $queue = (new CreateQueue)($entity, $owner, 'Fila', '  Atendimento Prioritário  ');
+
+    expect($queue->slug)->toBe('atendimento-prioritario');
+});
+
+it('lets owners and admins create queues', function (string $role) {
+    $entity = Entity::factory()->create();
+    $actor = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($actor)->{$role}()->create();
+
+    $queue = (new CreateQueue)($entity, $actor, 'Fila '.$role);
+
