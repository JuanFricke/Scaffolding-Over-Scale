@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    /**
+     * Update a queue; null arguments leave the corresponding field unchanged.
+     *
+     * @throws AuthorizationException
+     * @throws ValidationException
+     */
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $attributes = [];
+
+        if ($name !== null) {
+            $name = trim($name);
+
+            Validator::make(
+                ['name' => $name],
+                ['name' => ['required', 'string', 'max:255']],
+            )->validate();
+
+            $attributes['name'] = $name;
+        }
+
+        if ($slug !== null) {
+            $slug = Str::slug($slug);
+
+            Validator::make(
+                ['slug' => $slug],
+                ['slug' => ['required', 'string', 'max:255']],
+            )->validate();
+
+            $this->ensureSlugIsAvailable($queue, $slug);
+
+            $attributes['slug'] = $slug;
+        }
+
+        if ($isActive !== null) {
+            $attributes['is_active'] = $isActive;
+        }
+
+        if ($attributes === []) {
+            return $queue;
+        }
+
+        try {
+            $queue->update($attributes);
+        } catch (QueryException $e) {
+            // The pre-check can lose a race against another update/create;
+            // surface the unique index failure as validation.
+            if (self::isUniqueViolation($e)) {
+                throw ValidationException::withMessages([
+                    'slug' => __('validation.unique', ['attribute' => 'slug']),
+                ]);
+            }
+
+            throw $e;
+        }
+
+        return $queue;
+    }
+
+    private function ensureSlugIsAvailable(Queue $queue, string $slug): void
+    {
+        $exists = Queue::query()
+            ->where('entity_id', $queue->entity_id)
+            ->where('slug', $slug)
+            ->whereKeyNot($queue->id)
+            ->exists();
+
+        if ($exists) {
+            throw ValidationException::withMessages([
+                'slug' => __('validation.unique', ['attribute' => 'slug']),
+            ]);
+        }
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
