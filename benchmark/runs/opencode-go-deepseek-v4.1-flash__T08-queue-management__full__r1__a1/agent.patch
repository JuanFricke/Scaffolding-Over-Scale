+    $membership = EntityMembership::factory()->create();
+    $fromMembership = QueueAccess::factory()->for($membership, 'membership')->create();
+
+    expect($fromQueue->membership->entity_id)->toBe($queue->entity_id)
+        ->and($fromMembership->queue->entity_id)->toBe($membership->entity_id);
+});
+
