diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..e3221eb
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,121 @@
+<?php
+
+namespace App\
+Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+
+class DiscordOpsAlert
+{
+    /**
+     * Send an alert to Discord via webhook.
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhook = config('services.discord.webhook_url');
+        if (! $webhook) {
+            return; // no webhook configured – silent no‑op
+        }
+
+        $content = $this->buildContent($title, $message, $context);
+
+        try {
+            $response = Http::timeout(5)->post($webhook, ['content' => $content]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (\Throwable $e) {
+            // Sanitize any exception message that might contain the webhook URL
+            $msg = $this->sanitizeExceptionMessage($e->getMessage(), $webhook);
+            Log::error('Discord ops alert exception', [
+                'message' => $msg,
+            ]);
+        }
+    }
+
+    /**
+     * Build the message content to send to Discord.
+     */
+    private function buildContent(string $title, string $message, array $context): string
+    {
+        $lines = [];
+        $lines[] = $title;
+        $lines[] = $message;
+
+        foreach ($context as $key => $value) {
+            $redacted = $this->redactValue($key, $value);
+            $lines[] = "$key=$redacted";
+        }
+
+        $full = implode("\n", $lines);
+        return $this->truncate($full, 1800);
+    }
+
+    /**
+     * Truncate a string to a maximum length, multibyte‑safe.
+     */
+    private function truncate(string $str, int $max): string
+    {
+        if (mb_strlen($str) <= $max) {
+            return $str;
+        }
+        return mb_substr($str, 0, $max);
+    }
+
+    /**
+     * Redact a context value based on the key and value rules.
+     */
+    private function redactValue(string $key, $value): string
+    {
+        $sensitiveKeys = [
+            'password',
+            'token',
+            'secret',
+            'authorization',
+            'api_key',
+            'api-key',
+            'apikey',
+            'webhook',
+        ];
+
+        foreach ($sensitiveKeys as $pattern) {
+            if (stripos($key, $pattern) !== false) {
+                return '[redacted]';
+            }
+        }
+
+        if (is_array($value)) {
+            return json_encode($this->redactArray($value), JSON_UNESCAPED_UNICODE);
+        }
+
+        if (is_string($value) && stripos($value, 'Bearer ') !== false) {
+            return '[redacted]';
+        }
+
+        return (string) $value;
+    }
+
+    /**
+     * Recursively redact an array according to the same rules.
+     */
+    private function redactArray(array $array): array
+    {
+        $redacted = [];
+        foreach ($array as $k => $v) {
+            $redacted[$k] = $this->redactValue($k, $v);
+        }
+        return $redacted;
+    }
+
+    /**
+     * Remove webhook URL from exception messages.
+     */
+    private function sanitizeExceptionMessage(string $message, string $webhook): string
+    {
+        return str_replace($webhook, '[redacted]', $message);
+    }
+}
