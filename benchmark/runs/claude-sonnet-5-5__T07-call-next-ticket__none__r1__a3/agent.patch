diff --git a/tests/Feature/CallNextTicketTest.php b/tests/Feature/CallNextTicketTest.php
new file mode 100644
index 0000000..d48cbe0
--- /dev/null
+++ b/tests/Feature/CallNextTicketTest.php
@@ -0,0 +1,200 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function waitingTicket(Queue $queue, int $priority = 0, ?string $issuedAt = null): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'issued_at' => $issuedAt ?? now(),
+    ]);
+}
+
+function calledTicket(Queue $queue, int $priority, string $calledAt): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt,
+        'called_by_user_id' => User::factory()->create()->id,
+    ]);
+}
+
+beforeEach(function () {
+    $this->freezeTime();
+    $this->queue = Queue::factory()->create();
+    $this->user = User::factory()->create();
+    // Each call is one second apart so called_at ordering is unambiguous.
+    $this->call = function (CallMode $mode = CallMode::Any) {
+        $this->travel(1)->seconds();
+
+        return (new CallNextTicket)($this->queue, $this->user, $mode);
+    };
+});
+
+it('calls by priority, then age, then id', function () {
+    $low = waitingTicket($this->queue, 10, '2026-01-01 09:00:00');
+    $olderHigh = waitingTicket($this->queue, 20, '2026-01-01 10:00:00');
+    $tieFirst = waitingTicket($this->queue, 20, '2026-01-01 09:30:00');
+    $tieSecond = waitingTicket($this->queue, 20, '2026-01-01 09:30:00');
+
+    expect(($this->call)()->id)->toBe($tieFirst->id);
+    expect(($this->call)()->id)->toBe($tieSecond->id);
+    expect(($this->call)()->id)->toBe($olderHigh->id);
+    expect(($this->call)()->id)->toBe($low->id);
+});
+
+it('returns the ticket already updated and persisted', function () {
+    $ticket = waitingTicket($this->queue);
+
+    $called = ($this->call)();
+
+    expect($called->id)->toBe($ticket->id)
+        ->and($called->status)->toBe(TicketStatus::Called)
+        ->and($called->called_at)->not->toBeNull()
+        ->and($called->called_by_user_id)->toBe($this->user->id);
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($this->user->id);
+});
+
+it('ignores other queues and never re-calls a called ticket', function () {
+    $other = Queue::factory()->create();
+    waitingTicket($other, 20);
+    calledTicket($this->queue, 0, '2026-01-01 08:00:00');
+
+    expect(fn () => ($this->call)())->toThrow(NoWaitingTicketsException::class);
+
+    $mine = waitingTicket($this->queue);
+    expect(($this->call)()->id)->toBe($mine->id);
+    expect(fn () => ($this->call)())->toThrow(NoWaitingTicketsException::class);
+});
+
+it('throws when nothing is eligible for the mode', function () {
+    expect(fn () => ($this->call)())->toThrow(NoWaitingTicketsException::class);
+
+    waitingTicket($this->queue, 0);
+    expect(fn () => ($this->call)(CallMode::PriorityOnly))->toThrow(NoWaitingTicketsException::class);
+
+    (new CallNextTicket)(Queue::query()->find($this->queue->id), $this->user);
+    waitingTicket($this->queue, 10);
+    expect(fn () => ($this->call)(CallMode::NormalOnly))->toThrow(NoWaitingTicketsException::class);
+});
+
+it('rejects inactive queues using fresh database state and changes nothing', function () {
+    $ticket = waitingTicket($this->queue);
+    Queue::query()->whereKey($this->queue->id)->update(['is_active' => false]);
+
+    expect($this->queue->is_active)->toBeTrue(); // stale instance
+    expect(fn () => ($this->call)())->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh())->status->toBe(TicketStatus::Waiting)->called_at->toBeNull();
+});
+
+it('priority_only and normal_only filter by kind', function () {
+    $normal = waitingTicket($this->queue, 0, '2026-01-01 08:00:00');
+    $normal2 = waitingTicket($this->queue, 0, '2026-01-01 07:00:00');
+    $p10 = waitingTicket($this->queue, 10, '2026-01-01 09:00:00');
+    $p20 = waitingTicket($this->queue, 20, '2026-01-01 10:00:00');
+
+    expect(($this->call)(CallMode::NormalOnly)->id)->toBe($normal2->id);
+    expect(($this->call)(CallMode::PriorityOnly)->id)->toBe($p20->id);
+    expect(($this->call)(CallMode::PriorityOnly)->id)->toBe($p10->id);
+    expect(($this->call)(CallMode::NormalOnly)->id)->toBe($normal->id);
+});
+
+it('forces a normal ticket after 3 consecutive priority calls, then resets', function () {
+    $normal = waitingTicket($this->queue, 0, '2026-01-01 12:00:00');
+    $normal2 = waitingTicket($this->queue, 0, '2026-01-01 12:30:00');
+    $priority = collect(range(1, 5))->map(fn ($i) => waitingTicket($this->queue, 10, "2026-01-01 0{$i}:00:00"));
+
+    expect(($this->call)()->id)->toBe($priority[0]->id);
+    expect(($this->call)()->id)->toBe($priority[1]->id);
+    expect(($this->call)()->id)->toBe($priority[2]->id);
+    expect(($this->call)()->id)->toBe($normal->id);
+    // Streak reset by the normal call: 3 more priority calls allowed.
+    expect(($this->call)()->id)->toBe($priority[3]->id);
+    expect(($this->call)()->id)->toBe($priority[4]->id);
+    expect(($this->call)()->id)->toBe($normal2->id);
+});
+
+it('keeps calling priority when the fairness rule applies but no normal waits', function () {
+    foreach (range(1, 3) as $i) {
+        calledTicket($this->queue, 10, "2026-01-01 08:0{$i}:00");
+    }
+    $p = waitingTicket($this->queue, 10);
+
+    expect(($this->call)()->id)->toBe($p->id);
+});
+
+it('counts priority_only calls in history and ignores history in priority_only mode', function () {
+    $normal = waitingTicket($this->queue, 0);
+    foreach (range(1, 4) as $i) {
+        waitingTicket($this->queue, 10, "2026-01-01 0{$i}:00:00");
+    }
+
+    ($this->call)(CallMode::PriorityOnly);
+    ($this->call)(CallMode::PriorityOnly);
+    ($this->call)(CallMode::PriorityOnly);
+    // Fairness is ignored in priority_only mode.
+    expect(($this->call)(CallMode::PriorityOnly)->priority)->toBe(10);
+    // But the history now forces a normal in any mode.
+    expect(($this->call)()->id)->toBe($normal->id);
+});
+
+it('does not apply fairness with fewer than 3 calls or a normal in the last 3', function () {
+    $normal = waitingTicket($this->queue, 0);
+    $p = waitingTicket($this->queue, 10);
+    calledTicket($this->queue, 10, '2026-01-01 08:01:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:02:00');
+
+    expect(($this->call)()->id)->toBe($p->id); // only 2 prior calls
+
+    $this->queue = Queue::factory()->create();
+    $normal = waitingTicket($this->queue, 0);
+    $p = waitingTicket($this->queue, 10);
+    calledTicket($this->queue, 10, '2026-01-01 08:01:00');
+    calledTicket($this->queue, 0, '2026-01-01 08:02:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:03:00');
+
+    expect(($this->call)()->id)->toBe($p->id);
+});
+
+it('breaks called_at ties in history by id', function () {
+    $normal = waitingTicket($this->queue, 0);
+    waitingTicket($this->queue, 10);
+    calledTicket($this->queue, 0, '2026-01-01 08:00:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:00:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:00:00');
+    calledTicket($this->queue, 10, '2026-01-01 08:00:00');
+
+    // Last 3 by (called_at desc, id desc) are all priority.
+    expect(($this->call)()->id)->toBe($normal->id);
+});
+
+it('skips a candidate that was called concurrently through Ticket::call()', function () {
+    $first = waitingTicket($this->queue, 10, '2026-01-01 08:00:00');
+    $second = waitingTicket($this->queue, 10, '2026-01-01 09:00:00');
+
+    // Simulate the race: the first candidate is called by another path
+    // between selection and locking.
+    $fired = false;
+    Ticket::retrieved(function (Ticket $t) use (&$fired, $first) {
+        if (! $fired && $t->id === $first->id && $t->status === TicketStatus::Waiting) {
+            $fired = true;
+            Ticket::query()->whereKey($first->id)->update(['status' => 'called', 'called_at' => now()]);
+        }
+    });
+
+    expect(($this->call)()->id)->toBe($second->id);
+});
