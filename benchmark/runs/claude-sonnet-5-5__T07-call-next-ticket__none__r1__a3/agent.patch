+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /** Max consecutive priority calls a waiting normal ticket may sit behind. */
+    private const FAIRNESS_WINDOW = 3;
+
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Lock the queue row and read its state from the database: the
+            // passed model may be stale. Serializes call-next and deactivation.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            // Tickets found already called (e.g. via Ticket::call(), which does
+            // not lock the queue) are skipped; this also guarantees termination.
+            $skipped = [];
+
+            while (true) {
+                $candidate = $this->pickCandidate($lockedQueue, $mode, $skipped);
+
+                if ($candidate === null) {
+                    throw new NoWaitingTicketsException('No waiting ticket is eligible to be called.');
+                }
+
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    $skipped[] = $candidate->id;
+
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+        });
+    }
+
+    /**
+     * @param  list<int>  $skipped
+     */
+    private function pickCandidate(Queue $queue, CallMode $mode, array $skipped): ?Ticket
+    {
+        $waiting = fn (): Builder => Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting->value)
+            ->whereNotIn('id', $skipped);
+
+        $normalFirst = fn (Builder $q): Builder => $q
+            ->where('priority', 0)
+            ->orderBy('issued_at')
+            ->orderBy('id');
+
+        return match ($mode) {
+            CallMode::NormalOnly => $normalFirst($waiting())->first(),
+            CallMode::PriorityOnly => $this->byFullOrdering($waiting()->where('priority', '>', 0))->first(),
+            CallMode::Any => $this->mustCallNormal($queue)
+                ? $normalFirst($waiting())->first() ?? $this->byFullOrdering($waiting())->first()
+                : $this->byFullOrdering($waiting())->first(),
+        };
+    }
+
+    private function byFullOrdering(Builder $query): Builder
+    {
+        return $query
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+    }
+
+    /**
+     * True when the last FAIRNESS_WINDOW calls in the queue were all priority
+     * tickets (calls made in any mode count).
+     */
+    private function mustCallNormal(Queue $queue): bool
+    {
+        $recent = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Called->value)
+            ->whereNotNull('called_at')
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::FAIRNESS_WINDOW)
+            ->pluck('priority');
+
+        return $recent->count() === self::FAIRNESS_WINDOW
+            && $recent->every(fn ($priority): bool => $priority > 0);
+    }
+}
