+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    public ?int $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $validated = $this->validate([
+            'name' => 'required|string|max:255',
+            'slug' => 'required|string|max:255|unique:entities,slug,'.$this->entity->id,
+        ]);
+
+        $this->entity->update($validated);
+        $this->entity->refresh();
+        $this->name = $this->entity->name;
+        $this->slug = $this->entity->slug;
+    }
+
+    public function delete(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $this->entity->memberships()->delete();
+        $this->entity->delete();
+
+        if (session('current_entity_id') === $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirect(route('home'));
+    }
+
+    public function transfer(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $target = EntityMembership::query()
+            ->where('id', $this->targetMembershipId)
+            ->where('entity_id', $this->entity->id)
+            ->first();
+
+        $callerMembership = $this->entity->memberships()
+            ->where('user_id', auth()->id())
+            ->first();
+
+        if (
+            ! $target
+            || $target->role !== UserRole::Admin
+            || $target->user_id === auth()->id()
+        ) {
+            abort(403);
+        }
+
+        DB::transaction(function () use ($target, $callerMembership) {
+            $ownerMembership = $this->entity->memberships()
+                ->where('role', UserRole::Owner->value)
+                ->first();
+
+            if (! $ownerMembership || $ownerMembership->id !== $callerMembership?->id) {
+                abort(403);
+            }
+
+            $ownerMembership->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+        });
+
+        $this->redirect(route('entity.dashboard', $this->entity));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings');
+    }
+}
