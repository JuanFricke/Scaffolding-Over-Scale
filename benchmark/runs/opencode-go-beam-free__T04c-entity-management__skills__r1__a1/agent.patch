+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $this->authorize('update', $this->entity);
+
+        $this->validate([
+            'email' => 'required|email:strict|exists:users,email',
+        ]);
+
+        $user = User::where('email', $this->email)->first();
+
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            $this->addError('email', 'This user is already a member.');
+
+            return;
+        }
+
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->email = '';
+        $this->entity->refresh();
+    }
+
+    public function assignRole($membershipId, string $role): void
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+
+        if ((int) $membership->entity_id !== (int) $this->entity->id) {
+            abort(404);
+        }
+
+        $this->authorize('assignRole', $membership);
+
+        $validator = Validator::make(
+            ['role' => $role],
+            ['role' => 'required|in:admin,employee']
+        );
+
+        if ($validator->fails()) {
+            throw new ValidationException($validator);
+        }
+
+        $membership->update(['role' => $role]);
+        $this->entity->refresh();
+    }
+
+    public function removeMember($membershipId): void
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+
+        if ((int) $membership->entity_id !== (int) $this->entity->id) {
+            abort(404);
+        }
+
+        $this->authorize('delete', $membership);
+
+        if ($membership->role === UserRole::Owner) {
+            abort(403);
+        }
+
+        $managers = $this->entity->memberships()
+            ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+            ->count();
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true) && $managers <= 1) {
+            abort(403);
+        }
+
+        $membership->delete();
+        $this->entity->refresh();
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members');
+    }
+}
