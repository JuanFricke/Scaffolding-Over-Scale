diff --git a/tests/Feature/Auth/AuthFlowTest.php b/tests/Feature/Auth/AuthFlowTest.php
new file mode 100644
index 0000000..e5595dd
--- /dev/null
+++ b/tests/Feature/Auth/AuthFlowTest.php
@@ -0,0 +1,227 @@
+<?php
+
+use App\Livewire\Auth\Login;
+use App\Livewire\Auth\Register;
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\RateLimiter;
+use Illuminate\Support\Facades\URL;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('tests run in pt_BR', function () {
+    expect(config('app.locale'))->toBe('pt_BR');
+});
+
+test('login page is localized', function () {
+    $this->get(route('login'))->assertOk()->assertSee('Entrar')->assertSee('Senha')->assertSee('Esqueceu a senha?');
+
+    app()->setLocale('en');
+    $this->get(route('login'))->assertOk()->assertSee('Log in')->assertDontSee('Entrar')->assertDontSee('Senha');
+});
+
+test('login succeeds and redirects home', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'password')
+        ->call('submit')
+        ->assertRedirect(route('home'));
+
+    $this->assertAuthenticatedAs($user);
+});
+
+test('login fails with wrong credentials', function () {
+    $user = User::factory()->create();
+
+    Livewire::test(Login::class)
+        ->set('email', $user->email)
+        ->set('password', 'wrong')
+        ->call('submit')
+        ->assertHasErrors(['email' => __('auth.failed')]);
+
+    $this->assertGuest();
+});
+
+test('login is rate limited per email and ip', function () {
+    $user = User::factory()->create();
+    $component = Livewire::test(Login::class)->set('email', strtoupper($user->email))->set('password', 'wrong');
+
+    foreach (range(1, 5) as $_) {
+        $component->call('submit');
+    }
+    $component->set('password', 'password')->call('submit')->assertHasErrors('email');
+
+    expect(collect($component->errors()->get('email'))->first())->toContain('Muitas tentativas');
+    $this->assertGuest();
+});
+
+test('authenticated users cannot see login', function () {
+    $this->actingAs(User::factory()->create())->get(route('login'))->assertRedirect(route('home'));
+});
+
+test('register creates unverified user, sends verification and logs in', function () {
+    Notification::fake();
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria')
+        ->set('email', 'maria@example.com')
+        ->set('password', 'Abcdef12')
+        ->set('password_confirmation', 'Abcdef12')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('home'));
+
+    $user = User::where('email', 'maria@example.com')->firstOrFail();
+    expect($user->hasVerifiedEmail())->toBeFalse();
+    Notification::assertSentTo($user, VerifyEmail::class);
+    $this->assertAuthenticatedAs($user);
+});
+
+test('register validates password rules, confirmation and uniqueness', function () {
+    User::factory()->create(['email' => 'taken@example.com']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'X')->set('email', 'taken@example.com')
+        ->set('password', 'abcdefgh')->set('password_confirmation', 'other')
+        ->call('submit')
+        ->assertHasErrors(['email' => 'unique', 'password' => 'confirmed']);
+
+    Livewire::test(Register::class)
+        ->set('name', 'X')->set('email', 'x@example.com')
+        ->set('password', 'abcdefgh')->set('password_confirmation', 'abcdefgh')
+        ->call('submit')
+        ->assertHasErrors('password');
+});
+
+test('register is rate limited by ip', function () {
+    $key = str()->transliterate('register|127.0.0.1');
+    foreach (range(1, 5) as $_) {
+        RateLimiter::hit($key);
+    }
+
+    Livewire::test(Register::class)
+        ->set('name', 'Maria')->set('email', 'maria@example.com')
+        ->set('password', 'Abcdef12')->set('password_confirmation', 'Abcdef12')
+        ->call('submit')
+        ->assertHasErrors('email');
+
+    expect(User::count())->toBe(0);
+});
+
+test('logout invalidates session', function () {
+    $this->actingAs(User::factory()->create())->post(route('logout'))->assertRedirect(route('login'));
+    $this->assertGuest();
+    $this->post(route('logout'))->assertRedirect(route('login'));
+});
+
+test('home requires auth and verified', function () {
+    $this->get(route('home'))->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->unverified()->create())->get(route('home'))->assertRedirect(route('verification.notice'));
+    $this->actingAs(User::factory()->create())->get(route('home'))->assertOk();
+});
+
+test('forgot password never reveals existence and is throttled', function () {
+    Notification::fake();
+    $user = User::factory()->create();
+
+    $this->from(route('password.request'))->post(route('password.email'), ['email' => $user->email])
+        ->assertSessionHas('status', __('passwords.sent'));
+    Notification::assertSentTo($user, ResetPassword::class);
+
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertSessionHas('status', __('passwords.sent'));
+    Notification::assertCount(1);
+
+    foreach (range(3, 6) as $_) {
+        $this->post(route('password.email'), ['email' => 'nobody@example.com']);
+    }
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])->assertStatus(429);
+});
+
+test('reset form has a single email input', function () {
+    $html = $this->get(route('password.reset', 'tok'))->assertOk()->getContent();
+    expect(substr_count($html, 'name="email"'))->toBe(1);
+});
+
+test('reset password rotates remember token', function () {
+    Event::fake([PasswordReset::class]);
+    $user = User::factory()->create(['remember_token' => 'old']);
+    $token = app('auth.password.broker')->createToken($user);
+
+    $this->post(route('password.update'), [
+        'token' => $token, 'email' => $user->email,
+        'password' => 'Newpass123', 'password_confirmation' => 'Newpass123',
+    ])->assertRedirect(route('login'))->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+    expect(Hash::check('Newpass123', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe('old');
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('reset password rejects bad token and weak password', function () {
+    $user = User::factory()->create();
+
+    $this->post(route('password.update'), [
+        'token' => 'bad', 'email' => $user->email,
+        'password' => 'Newpass123', 'password_confirmation' => 'Newpass123',
+    ])->assertSessionHasErrors('email');
+
+    $this->post(route('password.update'), [
+        'token' => 'bad', 'email' => $user->email,
+        'password' => 'weak', 'password_confirmation' => 'weak',
+    ])->assertSessionHasErrors('password');
+});
+
+test('email verification flow', function () {
+    $user = User::factory()->unverified()->create();
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), ['id' => $user->id, 'hash' => sha1($user->email)]);
+
+    $this->get($url)->assertRedirect(route('login'));
+    $this->actingAs($user)->get($url)->assertRedirect(route('home'));
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+});
+
+test('tampered verification link returns 403', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+    $url = URL::temporarySignedRoute('verification.verify', now()->addHour(), ['id' => $other->id, 'hash' => sha1($other->email)]);
+
+    $this->actingAs($user)->get($url)->assertForbidden();
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse()->and($other->fresh()->hasVerifiedEmail())->toBeFalse();
+
+    $this->actingAs($user)->get(route('verification.verify', ['id' => $user->id, 'hash' => sha1($user->email)]))->assertForbidden();
+});
+
+test('resend verification', function () {
+    Notification::fake();
+    $user = User::factory()->unverified()->create();
+
+    $this->actingAs($user)->from(route('verification.notice'))->post(route('verification.send'))->assertSessionHas('status');
+    Notification::assertSentTo($user, VerifyEmail::class);
+
+    $verified = User::factory()->create();
+    $this->actingAs($verified)->post(route('verification.send'))->assertRedirect(route('home'));
+    Notification::assertNotSentTo($verified, VerifyEmail::class);
+});
+
+test('views and auth classes never hardcode paths', function () {
+    $files = array_merge(
+        glob(resource_path('views/**/*.blade.php')) ?: [],
+        glob(resource_path('views/*.blade.php')) ?: [],
+        glob(resource_path('views/*/*/*.blade.php')) ?: [],
+        glob(resource_path('views/*/*/*/*.blade.php')) ?: [],
+    );
+    foreach (array_unique($files) as $file) {
+        expect(file_get_contents($file))->not->toMatch('/(href|action)=["\']\//');
+    }
+});
