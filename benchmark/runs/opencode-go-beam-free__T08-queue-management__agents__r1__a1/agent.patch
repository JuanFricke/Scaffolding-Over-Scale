--- /dev/null
+++ b/app/Actions/UpdateQueue.php
@@ -0,0 +1,100 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        $updates = [];
+
+        if ($name !== null) {
+            $name = trim($name);
+
+            if ($name === '' || mb_strlen($name) > 255) {
+                throw ValidationException::withMessages([
+                    'name' => ['The name must be between 1 and 255 characters.'],
+                ]);
+            }
+
+            $updates['name'] = $name;
+        }
+
+        if ($slug !== null) {
+            $resolvedSlug = Str::slug($slug);
+
+            if ($resolvedSlug === '') {
+                $resolvedSlug = $queue->slug;
+            }
+
+            // Allow keeping the queue's own slug.
+            if ($resolvedSlug !== $queue->slug) {
+                $exists = Queue::query()
+                    ->where('entity_id', $queue->entity_id)
+                    ->where('slug', $resolvedSlug)
+                    ->whereKeyNot($queue->id)
+                    ->exists();
+
+                if ($exists) {
+                    throw ValidationException::withMessages([
+                        'slug' => ['The slug has already been taken.'],
+                    ]);
+                }
+            }
+
+            $updates['slug'] = $resolvedSlug;
+        }
+
+        if ($isActive !== null) {
+            $updates['is_active'] = $isActive;
+        }
+
+        if ($updates === []) {
+            return $queue;
+        }
+
+        try {
+            DB::transaction(function () use ($queue, $updates): void {
+                $queue->fill($updates);
+                $queue->save();
+            });
+        } catch (QueryException $e) {
+            if ($this->isUniqueViolation($e)) {
+                throw ValidationException::withMessages([
+                    'slug' => ['The slug has already been taken.'],
+                ]);
+            }
+
+            throw $e;
+        }
+
+        return $queue->fresh();
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
