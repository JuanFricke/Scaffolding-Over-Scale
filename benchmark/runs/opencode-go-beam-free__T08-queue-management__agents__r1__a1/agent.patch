@@ -0,0 +1,69 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use App\Models\UserRole;
+
+class QueuePolicy
+{
+    public function create(User $user, Entity $entity): bool
+    {
+        return $this->isManager($user, $entity->id);
+    }
+
+    public function update(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, $queue->entity_id);
+    }
+
+    public function manageAccess(User $user, Queue $queue): bool
+    {
+        return $this->isManager($user, $queue->entity_id);
+    }
+
+    public function call(User $user, Queue $queue): bool
+    {
+        $membership = $user->membershipFor($queue->entity_id);
+
+        if (! $membership) {
+            return false;
+        }
+
+        if (in_array($membership->role, [UserRole::Owner, UserRole::Admin], true)) {
+            return true;
+        }
+
+        if ($membership->role !== UserRole::Employee) {
+            return false;
+        }
+
+        $access = QueueAccess::query()
+            ->where('entity_membership_id', $membership->id)
+            ->where('queue_id', $queue->id)
+            ->first();
+
+        if (! $access) {
+            return false;
+        }
+
+        $permissions = $access->permissions;
+
+        if (! is_array($permissions)) {
+            return false;
+        }
+
+        return in_array('call', $permissions, true);
+    }
+
+    protected function isManager(User $user, int $entityId): bool
+    {
+        $membership = $user->membershipFor($entityId);
+
+        return $membership
+            && in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+    }
+}
