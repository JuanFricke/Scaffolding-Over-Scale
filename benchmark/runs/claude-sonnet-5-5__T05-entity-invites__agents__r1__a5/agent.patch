+            ->assertHasNoErrors();
+
+        expect(EntityInvite::whereKey($invite->id)->exists())->toBeFalse()
+            ->and(EntityMembership::count())->toBe(0);
+    });
+
+    test('declining an accepted invite keeps it', function () {
+        [, $invite] = inviteeWith(['accepted_at' => now()]);
+
+        Livewire::test(PendingInvites::class)->call('decline', $invite->id);
+
+        expect(EntityInvite::whereKey($invite->id)->exists())->toBeTrue();
+    });
+
+    test('the separated flag cannot be tampered with', function () {
+        $user = User::factory()->create();
+
+        expect(fn () => Livewire::actingAs($user)->test(PendingInvites::class)->set('separated', true))
+            ->toThrow(Exception::class, 'Cannot update locked property');
+    });
+});
+
+describe('placement', function () {
+    test('onboarding shows the invites inside the box after the form, separated by an hr', function () {
+        $user = User::factory()->create(['email' => 'new@example.com']);
