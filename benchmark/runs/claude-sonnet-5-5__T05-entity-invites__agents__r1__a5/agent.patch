+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+/**
+ * Invites addressed to the signed-in user's e-mail, with accept / decline.
+ */
+class PendingInvites extends Component
+{
+    /**
+     * Render an <hr> before the list (onboarding box), only when there are invites.
+     */
+    #[Locked]
+    public bool $separated = false;
+
+    public function accept($inviteId): void
+    {
+        $invite = $this->inviteeInvite($inviteId);
+
+        // Idempotent: accepting twice is a no-op.
+        if ($invite->isAccepted()) {
+            return;
+        }
+
+        if ($invite->isExpired()) {
+            $this->addError('invite', __('ui.invites_expired'));
+
+            return;
+        }
+
+        $user = auth()->user();
+
+        $claimed = DB::transaction(function () use ($invite, $user) {
+            // Atomic claim: only one concurrent accept proceeds.
+            $claimed = EntityInvite::whereKey($invite->id)
+                ->whereNull('accepted_at')
+                ->update(['accepted_at' => now()]);
+
+            if ($claimed) {
+                // Never a duplicate membership (and never a role change for an existing member).
+                EntityMembership::firstOrCreate(
+                    ['entity_id' => $invite->entity_id, 'user_id' => $user->id],
+                    ['role' => $invite->role->value],
+                );
+            }
+
+            return $claimed;
+        });
+
+        if (! $claimed) {
+            return;
+        }
+
+        Log::channel('audit')->info('Invite accepted', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => $user->id,
+            'invite_id' => $invite->id,
+        ]);
+
+        session(['current_entity_id' => $invite->entity_id]);
+
+        $this->redirect(route('entity.dashboard', $invite->entity->slug));
+    }
+
+    public function decline($inviteId): void
+    {
+        $invite = $this->inviteeInvite($inviteId);
+
+        // An accepted invite is the record of an existing membership: keep it.
+        if ($invite->isAccepted()) {
+            return;
+        }
+
+        $invite->delete();
+
+        Log::channel('audit')->info('Invite declined', [
+            'entity_id' => $invite->entity_id,
+            'actor_id' => auth()->id(),
+            'invite_id' => $invite->id,
+        ]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.pending-invites', [
+            'invites' => EntityInvite::forEmail(auth()->user()->email)
+                ->pending()
+                ->with('entity')
+                ->latest('id')
+                ->get(),
+        ]);
+    }
+
+    /**
+     * The invite with this id, provided it is addressed to the signed-in user
+     * (the id is client-controlled, so the e-mail match is the authorization).
+     */
+    protected function inviteeInvite($inviteId): EntityInvite
+    {
+        $invite = EntityInvite::with('entity')->findOrFail($inviteId);
+
+        abort_unless($invite->email === mb_strtolower(trim(auth()->user()->email)), 403);
+
+        return $invite;
+    }
+}
