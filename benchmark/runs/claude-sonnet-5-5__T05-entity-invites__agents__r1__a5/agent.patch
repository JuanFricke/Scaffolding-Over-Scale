+        $invite->update(['expires_at' => now()->subMinute()]);
+
+        Livewire::test(PendingInvites::class)
+            ->call('accept', $invite->id)
+            ->assertSee('This invite has expired.');
+    });
+
+    test('accepting twice is an idempotent no-op', function () {
+        [$user, $invite] = inviteeWith();
+
+        $component = Livewire::test(PendingInvites::class)->call('accept', $invite->id);
+        $acceptedAt = $invite->fresh()->accepted_at;
+
+        $this->travel(1)->minute();
+        Livewire::test(PendingInvites::class)
+            ->call('accept', $invite->id)
+            ->assertHasNoErrors()
+            ->assertNoRedirect();
+
+        expect(EntityMembership::where('user_id', $user->id)->count())->toBe(1)
+            ->and($invite->fresh()->accepted_at->equalTo($acceptedAt))->toBeTrue();
+    });
+
+    test('an existing member never gets a duplicate membership or a changed role', function () {
