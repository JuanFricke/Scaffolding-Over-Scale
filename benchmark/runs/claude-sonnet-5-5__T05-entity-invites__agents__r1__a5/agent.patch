+uses(RefreshDatabase::class);
+
+describe('EntityInvite model', function () {
+    test('the table has the expected columns', function () {
+        expect(Schema::hasColumns('entity_invites', [
+            'id', 'entity_id', 'invited_by', 'email', 'role', 'expires_at', 'accepted_at', 'created_at', 'updated_at',
+        ]))->toBeTrue();
+    });
+
+    test('the factory defaults to a pending employee invite expiring in 7 days', function () {
+        $invite = EntityInvite::factory()->create();
+
+        expect($invite->entity)->toBeInstanceOf(Entity::class)
+            ->and($invite->role)->toBe(UserRole::Employee)
+            ->and($invite->accepted_at)->toBeNull()
+            ->and($invite->invited_by)->toBeNull()
+            ->and($invite->isPending())->toBeTrue()
+            ->and($invite->expires_at->between(now()->addDays(7)->subMinute(), now()->addDays(7)->addMinute()))->toBeTrue()
+            ->and(EntityInvite::factory()->create()->email)->not->toBe($invite->email);
+    });
+
+    test('the expired state is not pending', function () {
+        $invite = EntityInvite::factory()->expired()->create();
+
+        expect($invite->isExpired())->toBeTrue()
+            ->and($invite->isPending())->toBeFalse()
+            ->and(EntityInvite::pending()->count())->toBe(0);
+    });
+
+    test('accepted invites are not pending', function () {
+        EntityInvite::factory()->create(['accepted_at' => now()]);
+
+        expect(EntityInvite::pending()->count())->toBe(0);
+    });
+
+    test('the e-mail is stored lowercase and trimmed on every write path', function () {
+        $entity = Entity::factory()->create();
+
+        $created = EntityInvite::create(['entity_id' => $entity->id, 'email' => '  Foo@Example.COM ', 'expires_at' => now()->addDay()]);
+        $created->update(['email' => ' BAR@Example.com']);
+        $made = EntityInvite::factory()->for($entity)->create(['email' => "Baz@EXAMPLE.com\n"]);
+
+        expect($created->fresh()->email)->toBe('bar@example.com')
+            ->and($made->fresh()->email)->toBe('baz@example.com');
+    });
+
+    test('an e-mail is unique per entity but not across entities', function () {
+        $entity = Entity::factory()->create();
+        EntityInvite::factory()->for($entity)->create(['email' => 'a@example.com']);
+        EntityInvite::factory()->create(['email' => 'a@example.com']);
+
+        expect(fn () => EntityInvite::factory()->for($entity)->create(['email' => 'A@example.com']))
+            ->toThrow(UniqueConstraintViolationException::class);
+    });
+
+    test('casts and relations', function () {
+        $inviter = User::factory()->create();
+        $entity = Entity::factory()->create();
+        $invite = EntityInvite::factory()->for($entity)->create(['role' => 'admin', 'invited_by' => $inviter->id]);
+
+        expect($invite->fresh()->role)->toBe(UserRole::Admin)
+            ->and($invite->fresh()->expires_at)->toBeInstanceOf(DateTimeInterface::class)
+            ->and($entity->invites->pluck('id')->all())->toBe([$invite->id])
+            ->and($invite->inviter->is($inviter))->toBeTrue();
+    });
+
+    test('invites are deleted with their entity and survive their inviter', function () {
+        $inviter = User::factory()->create();
+        $invite = EntityInvite::factory()->create(['invited_by' => $inviter->id]);
+
+        $inviter->delete();
+        expect($invite->fresh()->invited_by)->toBeNull();
+
+        $invite->entity->forceDelete();
+        expect(EntityInvite::count())->toBe(0);
+    });
+});
+
+describe('EntityInviteMail', function () {
+    function renderInvite(string $locale, string $role = 'admin'): array
+    {
+        app()->setLocale($locale);
+        $invite = EntityInvite::factory()->create(['role' => $role, 'expires_at' => now()->addDays(7)]);
+        $invite->entity->update(['name' => 'Acme Ltda']);
+        $mail = new EntityInviteMail($invite->fresh());
+
+        return [$mail, $mail->render(), $invite];
+    }
+
+    test('is a queued markdown mailable', function () {
+        [$mail] = renderInvite('en');
+
+        expect($mail)->toBeInstanceOf(ShouldQueue::class)
+            ->and($mail->content()->markdown)->toBe('emails.entity-invite');
+    });
+
+    test('renders in English with the PegaFila theme', function () {
+        [$mail, $html, $invite] = renderInvite('en');
+
+        expect($mail->envelope()->subject)->toBe('You are invited to Acme Ltda')
+            ->and($html)->toContain('Hello!')
+            ->and($html)->toContain('You are invited to join Acme Ltda as Admin.')
+            ->and($html)->toContain('Access the link below to sign in and accept your invite:')
+            ->and($html)->toContain('Sign in to PegaFila')
+            ->and($html)->toContain('href="'.route('login').'"')
+            ->and($html)->toContain($invite->expires_at->isoFormat('LL'))
+            ->and($html)->toContain('Team PegaFila')
+            ->and($html)->toContain('#0f7490');
+    });
+
+    test('renders in Brazilian Portuguese', function () {
+        [$mail, $html] = renderInvite('pt_BR');
+
+        expect($mail->envelope()->subject)->toBe('Você foi convidado para Acme Ltda')
+            ->and($html)->toContain('Olá!')
+            ->and($html)->toContain('Você foi convidado para entrar em Acme Ltda como Administrador.')
+            ->and($html)->toContain('Acesse o link abaixo para entrar e aceitar seu convite:')
+            ->and($html)->toContain('Entrar no PegaFila')
+            ->and($html)->toContain('Time PegaFila');
+    });
+
+    test('translates the employee role', function () {
+        [, $html] = renderInvite('pt_BR', 'employee');
+
+        expect($html)->toContain('como Funcionário.');
+    });
+
+    test('escapes the entity name', function () {
+        app()->setLocale('en');
+        $invite = EntityInvite::factory()->create();
+        $invite->entity->update(['name' => '<script>alert(1)</script>']);
+
+        expect((new EntityInviteMail($invite->fresh()))->render())->not->toContain('<script>alert(1)</script>');
+    });
+});
+
+describe('PendingInvites', function () {
+    beforeEach(fn () => app()->setLocale('en'));
+
+    function inviteeWith(array $invite = [], string $email = 'invitee@example.com'): array
+    {
+        $user = User::factory()->create(['email' => $email]);
+        $invite = EntityInvite::factory()->create(['email' => $email] + $invite);
+        test()->actingAs($user);
+
+        return [$user, $invite];
+    }
+
+    test('lists the signed-in user pending invites case-insensitively', function () {
+        $user = User::factory()->create(['email' => 'Mixed.Case@Example.com']);
+        $mine = EntityInvite::factory()->create(['email' => 'mixed.case@example.com']);
+        $expired = EntityInvite::factory()->expired()->create(['email' => 'mixed.case@example.com']);
+        $accepted = EntityInvite::factory()->create(['email' => 'mixed.case@example.com', 'accepted_at' => now()]);
+        $others = EntityInvite::factory()->create(['email' => 'other@example.com']);
+
+        Livewire::actingAs($user)->test(PendingInvites::class)
+            ->assertSee($mine->entity->name)
+            ->assertSee('Pending invites')
+            ->assertSee('Accept')
+            ->assertSee('Decline')
+            ->assertDontSee($expired->entity->name)
+            ->assertDontSee($accepted->entity->name)
+            ->assertDontSee($others->entity->name);
+    });
+
+    test('renders nothing when there are no invites', function () {
+        $user = User::factory()->create();
+
+        Livewire::actingAs($user)->test(PendingInvites::class)
+            ->assertDontSee('Pending invites')
+            ->assertDontSeeHtml('<hr');
+    });
+
+    test('accepting creates the membership with the invite role and redirects', function () {
+        [$user, $invite] = inviteeWith(['role' => 'admin']);
+
+        Livewire::test(PendingInvites::class)
+            ->call('accept', $invite->id)
+            ->assertHasNoErrors()
+            ->assertRedirect(route('entity.dashboard', $invite->entity->slug));
+
+        $membership = EntityMembership::where('entity_id', $invite->entity_id)->where('user_id', $user->id)->sole();
+        expect($membership->role)->toBe(UserRole::Admin)
+            ->and($invite->fresh()->accepted_at)->not->toBeNull()
+            ->and(session('current_entity_id'))->toBe($invite->entity_id);
+    });
+
+    test('the invitee can reach the entity dashboard after accepting', function () {
+        [, $invite] = inviteeWith();
+
+        Livewire::test(PendingInvites::class)->call('accept', $invite->id);
+
+        $this->get(route('entity.dashboard', $invite->entity->slug))->assertOk();
+    });
+
+    test('accepting is matched on e-mail case-insensitively', function () {
+        $user = User::factory()->create(['email' => 'UPPER@example.com']);
+        $invite = EntityInvite::factory()->create(['email' => 'upper@example.com']);
+
+        Livewire::actingAs($user)->test(PendingInvites::class)
+            ->call('accept', $invite->id)
+            ->assertHasNoErrors();
+
+        expect(EntityMembership::where('user_id', $user->id)->count())->toBe(1);
+    });
+
+    test('someone else cannot accept or decline the invite', function () {
+        [, $invite] = inviteeWith();
+        $stranger = User::factory()->create();
+
+        Livewire::actingAs($stranger)->test(PendingInvites::class)
+            ->call('accept', $invite->id)
+            ->assertForbidden();
+
+        Livewire::actingAs($stranger)->test(PendingInvites::class)
+            ->call('decline', $invite->id)
+            ->assertForbidden();
+
+        expect(EntityMembership::count())->toBe(0)
+            ->and($invite->fresh()->accepted_at)->toBeNull();
+    });
+
+    test('an unknown invite id is not found', function () {
+        $user = User::factory()->create();
+        $component = Livewire::actingAs($user)->test(PendingInvites::class);
+
+        expect(fn () => $component->call('accept', 999))->toThrow(ModelNotFoundException::class);
+    });
+
+    test('an expired invite cannot be accepted', function () {
+        [$user, $invite] = inviteeWith();
+        $invite->update(['expires_at' => now()->subMinute()]);
