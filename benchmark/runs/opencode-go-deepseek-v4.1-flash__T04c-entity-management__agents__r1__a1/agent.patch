+name: Deploy Dev
+
+on:
+  push:
+    branches: [main, master]
+  workflow_dispatch:
+    inputs:
+      ref:
+        description: Git ref to deploy
+        required: false
+      skip_tests:
+        description: Skip the Pest gate
+        required: false
+        type: boolean
+        default: false
+  workflow_call:
+    inputs:
+      ref:
+        description: Git ref to deploy
+        required: false
+        type: string
+    secrets:
+      HOSTINGER_API:
+        required: true
+
+jobs:
+  tests:
+    if: ${{ github.event_name != 'workflow_dispatch' || !inputs.skip_tests }}
+    uses: ./.github/workflows/tests.yml
+
+  deploy:
+    needs: tests
+    if: ${{ always() && (needs.tests.result == 'success' || inputs.skip_tests) }}
+    runs-on: ubuntu-latest
+
+    steps:
+      - uses: actions/checkout@v4
+        with:
+          ref: ${{ inputs.ref || github.sha }}
+
+      - name: Deploy
+        run: ./bin/pf deploy
+        env:
+          HOSTINGER_API: ${{ secrets.HOSTINGER_API }}
+          PF_GIT_TOKEN: ${{ secrets.PF_GIT_TOKEN }}
+          PF_GIT_REF: ${{ inputs.ref || github.sha }}
+
+      - name: Smoke
+        run: ./bin/pf smoke
