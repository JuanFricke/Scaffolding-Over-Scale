+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|email:strict|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $this->authorize('assignRole', new EntityMembership([
+            'entity_id' => $this->entity->getKey(),
+        ]));
+
+        $validated = $this->validate();
+
+        $user = User::where('email', $validated['email'])->firstOrFail();
+
+        if ($this->entity->memberships()->where('user_id', $user->getKey())->exists()) {
+            throw ValidationException::withMessages([
+                'email' => __('ui.member_already_exists'),
+            ]);
+        }
+
+        $this->entity->memberships()->create([
+            'user_id' => $user->getKey(),
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->reset('email');
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+
+        if ((int) $membership->entity_id !== (int) $this->entity->getKey()) {
+            abort(403);
+        }
+
+        $this->authorize('assignRole', $membership);
+
+        validator(
+            ['role' => $role],
+            ['role' => ['required', Rule::in(array_column(UserRole::manageable(), 'value'))]],
+        )->validate();
+
+        if ($membership->role === UserRole::Owner) {
+            abort(403);
+        }
+
+        $membership->update(['role' => $role]);
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+
+        if ((int) $membership->entity_id !== (int) $this->entity->getKey()) {
+            abort(403);
+        }
+
+        $this->authorize('delete', $membership);
+
+        $isManager = in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+
+        if ($isManager && $this->entity->memberships()
+            ->whereIn('role', [UserRole::Owner, UserRole::Admin])
+            ->count() <= 1) {
+            abort(403);
+        }
+
+        $membership->delete();
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+        ]);
+    }
+}
