+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+test('a member can pick an entity for the session', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    Log::shouldReceive('channel')->once()->with('audit')->andReturnSelf();
+    Log::shouldReceive('info')->once();
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('a non-member cannot pick an entity and the session is untouched', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => 999])
+        ->post(route('entity.pick', $entity))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', 999);
+});
+
+test('guests are sent to login before picking', function () {
+    $entity = Entity::factory()->create();
+
+    $this->post(route('entity.pick', $entity))
+        ->assertRedirect(route('login'));
+});
+
+test('unverified users are sent to verification before picking', function () {
+    $user = User::factory()->unverified()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..a2e9dae
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,151 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('any authenticated user may create an entity', function () {
+    $user = User::factory()->create();
+
+    expect((new EntityPolicy)->create($user))->toBeTrue();
+});
+
+test('only members may view an entity', function () {
+    $entity = Entity::factory()->create();
+    $member = User::factory()->create();
+    EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $member->id,
+    ]);
+    $outsider = User::factory()->create();
+
+    $policy = new EntityPolicy;
+
+    expect($policy->view($member, $entity))->toBeTrue()
+        ->and($policy->view($outsider, $entity))->toBeFalse();
+});
+
+test('owners and admins may update and delete an entity', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id, 'user_id' => $owner->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+    EntityMembership::factory()->employee()->create(['entity_id' => $entity->id, 'user_id' => $employee->id]);
+
+    $policy = new EntityPolicy;
+
+    expect($policy->update($owner, $entity))->toBeTrue()
+        ->and($policy->delete($owner, $entity))->toBeTrue()
+        ->and($policy->update($admin, $entity))->toBeTrue()
+        ->and($policy->delete($admin, $entity))->toBeTrue()
+        ->and($policy->update($employee, $entity))->toBeFalse()
+        ->and($policy->delete($employee, $entity))->toBeFalse();
+});
+
+test('only the owner may manage settings', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id, 'user_id' => $owner->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id, 'user_id' => $admin->id]);
+
+    $policy = new EntityPolicy;
+
+    expect($policy->manageSettings($owner, $entity))->toBeTrue()
+        ->and($policy->manageSettings($admin, $entity))->toBeFalse();
+});
+
+test('any member may view an entity membership', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $member = User::factory()->create();
+    EntityMembership::factory()->employee()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $member->id,
+    ]);
+    $outsider = User::factory()->create();
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($member, $membership))->toBeTrue()
+        ->and($policy->view($outsider, $membership))->toBeFalse();
+});
+
+test('owners and admins may assign roles', function () {
+    $membership = EntityMembership::factory()->employee()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $membership->entity_id, 'user_id' => $owner->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $membership->entity_id, 'user_id' => $admin->id]);
+    EntityMembership::factory()->employee()->create(['entity_id' => $membership->entity_id, 'user_id' => $employee->id]);
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->assignRole($owner, $membership))->toBeTrue()
+        ->and($policy->assignRole($admin, $membership))->toBeTrue()
+        ->and($policy->assignRole($employee, $membership))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    $ownerMembership = EntityMembership::factory()->owner()->create();
+    $admin = User::factory()->create();
+
+    EntityMembership::factory()->admin()->create([
+        'entity_id' => $ownerMembership->entity_id,
+        'user_id' => $admin->id,
+    ]);
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($ownerMembership->user, $ownerMembership))->toBeFalse()
+        ->and($policy->delete($admin, $ownerMembership))->toBeFalse();
+});
+
+test('members may delete themselves but not other employees', function () {
+    $entity = Entity::factory()->create();
+    $employee = User::factory()->create();
+    $otherEmployee = User::factory()->create();
+
+    $membership = EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $employee->id,
+    ]);
+    $otherMembership = EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $otherEmployee->id,
+    ]);
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($employee, $membership))->toBeTrue()
+        ->and($policy->delete($employee, $otherMembership))->toBeFalse();
+});
+
+test('owners and admins may delete other members', function () {
+    $entity = Entity::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+
+    EntityMembership::factory()->admin()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $admin->id,
+    ]);
+    $employeeMembership = EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $employee->id,
+    ]);
+
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($admin, $employeeMembership))->toBeTrue();
+});
diff --git a/tests/Feature/EntitySettingsTest.php b/tests/Feature/EntitySettingsTest.php
new file mode 100644
index 0000000..33f8b09
--- /dev/null
+++ b/tests/Feature/EntitySettingsTest.php
@@ -0,0 +1,206 @@
+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function makeSettingsTestEntityWithOwner(): array
+{
+    $owner = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $owner->id,
+    ]);
+
+    return [$entity, $owner];
+}
+
+test('only the owner can open settings', function () {
+    [$entity] = makeSettingsTestEntityWithOwner();
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $admin->id,
+    ]);
+    $employee = User::factory()->create();
+    EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $employee->id,
+    ]);
+
+    $this->actingAs($admin)
+        ->get(route('entity.settings', $entity))
+        ->assertForbidden();
+
+    $this->actingAs($employee)
+        ->get(route('entity.settings', $entity))
+        ->assertForbidden();
+});
+
+test('the owner settings page shows entity fields and ownership transfer', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+
+    $this->actingAs($owner)
+        ->get(route('entity.settings', $entity))
+        ->assertOk()
+        ->assertSee(__('ui.settings_title', ['entity' => $entity->name]))
+        ->assertSee(__('ui.transfer_ownership'))
+        ->assertSee($entity->slug);
+});
+
+test('the owner saves the name and slug', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('name', 'New name')
+        ->set('slug', 'new-slug')
+        ->call('save')
+        ->assertHasNoErrors();
+
+    expect($entity->fresh()->name)->toBe('New name')
+        ->and($entity->fresh()->slug)->toBe('new-slug');
+});
+
+test('the slug is unique except for the entity itself', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+    Entity::factory()->create(['slug' => 'taken-slug']);
+
+    $component = Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity]);
+
+    $component->set('name', $entity->name)
+        ->set('slug', $entity->slug)
+        ->call('save')
+        ->assertHasNoErrors();
+
+    $component->set('slug', 'taken-slug')
+        ->call('save')
+        ->assertHasErrors(['slug' => 'unique']);
+
+    expect($entity->fresh()->slug)->toBe($entity->slug);
+});
+
+test('the bound entity cannot be swapped by the client', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+    $other = Entity::factory()->create();
+
+    expect(fn () => Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('entity', $other))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
+
+test('deleting the entity soft deletes it removes memberships and clears the session', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+
+    session(['current_entity_id' => $entity->id]);
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->call('delete')
+        ->assertRedirect(route('home'));
+
+    $this->assertSoftDeleted('entities', ['id' => $entity->id]);
+    $this->assertDatabaseMissing('entity_memberships', ['entity_id' => $entity->id]);
+
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('deleting another entity leaves the current session entity alone', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+    $current = Entity::factory()->create();
+
+    session(['current_entity_id' => $current->id]);
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->call('delete');
+
+    expect(session('current_entity_id'))->toBe($current->id);
+});
+
+test('the owner transfers ownership to an admin atomically', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+    $admin = User::factory()->create();
+    $adminMembership = EntityMembership::factory()->admin()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $admin->id,
+    ]);
+    $ownerMembership = $entity->owner;
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $adminMembership->id)
+        ->call('transfer')
+        ->assertRedirect(route('entity.dashboard', $entity));
+
+    expect($ownerMembership->fresh()->role)->toBe(UserRole::Admin)
+        ->and($adminMembership->fresh()->role)->toBe(UserRole::Owner)
+        ->and($entity->fresh()->owner->user_id)->toBe($admin->id);
+});
+
+test('ownership cannot be transferred to a non-admin', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+    $employeeMembership = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+    $ownerMembership = $entity->owner;
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $employeeMembership->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($ownerMembership->fresh()->role)->toBe(UserRole::Owner)
+        ->and($employeeMembership->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('ownership transfer without a valid target is forbidden', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->call('transfer')
+        ->assertForbidden();
+});
+
+test('ownership cannot be transferred to an admin of another entity', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+    $foreignAdmin = EntityMembership::factory()->admin()->create();
+    $ownerMembership = $entity->owner;
+
+    Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity])
+        ->set('targetMembershipId', $foreignAdmin->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($ownerMembership->fresh()->role)->toBe(UserRole::Owner)
+        ->and($foreignAdmin->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('transfer is forbidden when the owner membership has vanished', function () {
+    [$entity, $owner] = makeSettingsTestEntityWithOwner();
+    $adminMembership = EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    $ownerMembership = $entity->owner;
+
+    $component = Livewire::actingAs($owner)
+        ->test(Settings::class, ['entity' => $entity]);
+
+    $ownerMembership->delete();
+
+    $component->set('targetMembershipId', $adminMembership->id)
+        ->call('transfer')
+        ->assertForbidden();
+
+    expect($adminMembership->fresh()->role)->toBe(UserRole::Admin);
+});
