@@ -0,0 +1,50 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    /**
+     * Any member of the entity may view its memberships.
+     */
+    public function view(User $user, EntityMembership $entityMembership): bool
+    {
+        return $user->membershipFor($entityMembership->entity_id) !== null;
+    }
+
+    /**
+     * Owners and admins may assign roles.
+     */
+    public function assignRole(User $user, EntityMembership $entityMembership): bool
+    {
+        return $this->isManager($user, $entityMembership);
+    }
+
+    /**
+     * The owner can never be removed. Any member may remove themselves, and
+     * owners/admins may remove the remaining members.
+     */
+    public function delete(User $user, EntityMembership $entityMembership): bool
+    {
+        if ($entityMembership->role === UserRole::Owner) {
+            return false;
+        }
+
+        if ((int) $entityMembership->user_id === (int) $user->getKey()) {
+            return true;
+        }
+
+        return $this->isManager($user, $entityMembership);
+    }
+
+    private function isManager(User $user, EntityMembership $entityMembership): bool
+    {
+        $role = $user->membershipFor($entityMembership->entity_id)?->role;
+
+        return $role === UserRole::Owner || $role === UserRole::Admin;
+    }
+}
