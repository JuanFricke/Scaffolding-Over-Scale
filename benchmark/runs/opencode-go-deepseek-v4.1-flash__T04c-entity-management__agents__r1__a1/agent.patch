--- /dev/null
+++ b/tests/Feature/EntityDashboardTest.php
@@ -0,0 +1,74 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('the owner dashboard shows the entity welcome links and owner notice', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create(['name' => 'Acme Filas']);
+    EntityMembership::factory()->owner()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Acme Filas')
+        ->assertSee(__('ui.welcome', ['name' => $user->name]))
+        ->assertSee(__('ui.owner_notice'))
+        ->assertSee(route('entity.members', $entity), false)
+        ->assertSee(route('entity.settings', $entity), false);
+});
+
+test('a non-owner member sees the dashboard but not the settings url', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->admin()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(route('entity.members', $entity), false)
+        ->assertDontSee(route('entity.settings', $entity), false)
+        ->assertDontSee(__('ui.owner_notice'));
+});
+
+test('a non-member gets forbidden even when the session points at another entity', function () {
+    $user = User::factory()->create();
+    $homeEntity = Entity::factory()->create();
+    $otherEntity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->create([
+        'entity_id' => $homeEntity->id,
+        'user_id' => $user->id,
+    ]);
+
+    $this->actingAs($user)
+        ->withSession(['current_entity_id' => $homeEntity->id])
+        ->get(route('entity.dashboard', $otherEntity))
+        ->assertForbidden();
+});
+
+test('guests are redirected to login and unverified users to verification', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('login'));
+
+    $user = User::factory()->unverified()->create();
+    EntityMembership::factory()->owner()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
