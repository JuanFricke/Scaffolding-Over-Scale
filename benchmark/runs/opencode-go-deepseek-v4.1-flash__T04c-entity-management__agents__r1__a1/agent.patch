+
+    $this->actingAs($outsider)
+        ->get(route('entity.members', $entity))
+        ->assertForbidden();
+});
+
+test('an owner adds an existing user as an employee', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+    $invitee = User::factory()->create(['email' => 'invitee@example.com']);
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', 'invitee@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors()
+        ->assertSet('email', '');
+
+    $this->assertDatabaseHas('entity_memberships', [
+        'entity_id' => $entity->id,
+        'user_id' => $invitee->id,
+        'role' => UserRole::Employee->value,
+    ]);
+});
+
+test('an admin can add members', function () {
+    [$entity] = makeMembersTestEntityWithOwner();
+    $admin = User::factory()->create();
+    EntityMembership::factory()->admin()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $admin->id,
+    ]);
+    User::factory()->create(['email' => 'invitee@example.com']);
+
+    Livewire::actingAs($admin)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', 'invitee@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors();
+
+    $this->assertDatabaseHas('entity_memberships', [
+        'entity_id' => $entity->id,
+        'role' => UserRole::Employee->value,
+    ]);
+});
+
+test('adding a user who does not exist fails on email', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', 'nobody@example.com')
+        ->call('addMember')
+        ->assertHasErrors(['email' => 'exists']);
+});
+
+test('adding an existing member is an error on email', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+    $member = User::factory()->create(['email' => 'member@example.com']);
+    EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $member->id,
+    ]);
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', 'member@example.com')
+        ->call('addMember')
+        ->assertHasErrors(['email']);
+
+    expect($entity->memberships()->where('user_id', $member->id)->count())->toBe(1);
+});
+
+test('an employee cannot add members or assign roles', function () {
+    [$entity] = makeMembersTestEntityWithOwner();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $employee->id,
+    ]);
+    $target = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+    User::factory()->create(['email' => 'invitee@example.com']);
+
+    Livewire::actingAs($employee)
+        ->test(Members::class, ['entity' => $entity])
+        ->set('email', 'invitee@example.com')
+        ->call('addMember')
+        ->assertForbidden();
+
+    Livewire::actingAs($employee)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $target->id, UserRole::Admin->value)
+        ->assertForbidden();
+
+    expect($target->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('an owner promotes an employee to admin and demotes an admin to employee', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+    $member = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    $component = Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity]);
+
+    $component->call('assignRole', $member->id, UserRole::Admin->value)
+        ->assertHasNoErrors();
+
+    expect($member->fresh()->role)->toBe(UserRole::Admin);
+
+    $component->call('assignRole', $member->id, UserRole::Employee->value)
+        ->assertHasNoErrors();
+
+    expect($member->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('assigning the owner role is a validation error', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+    $member = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $member->id, UserRole::Owner->value)
+        ->assertHasErrors('role');
+
+    expect($member->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the owner membership cannot be assigned a different role', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+    $ownerMembership = $entity->owner;
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $ownerMembership->id, UserRole::Admin->value)
+        ->assertForbidden();
+
+    expect($ownerMembership->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('the owner cannot be removed', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+    $ownerMembership = $entity->owner;
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $ownerMembership->id)
+        ->assertForbidden();
+
+    expect($entity->memberships()->whereKey($ownerMembership->id)->exists())->toBeTrue();
+});
+
+test('the last manager cannot be removed', function () {
+    $entity = Entity::factory()->create();
+    $admin = User::factory()->create();
+    $adminMembership = EntityMembership::factory()->admin()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $admin->id,
+    ]);
+
+    Livewire::actingAs($admin)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $adminMembership->id)
+        ->assertForbidden();
+
+    expect($adminMembership->fresh())->not->toBeNull();
+});
+
+test('an owner removes another member', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+    $member = EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $member->id)
+        ->assertHasNoErrors();
+
+    $this->assertDatabaseMissing('entity_memberships', ['id' => $member->id]);
+});
+
+test('membership actions cannot touch another entity through a tampered id', function () {
+    [$entity, $owner] = makeMembersTestEntityWithOwner();
+    $foreignMembership = EntityMembership::factory()->admin()->create();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('assignRole', $foreignMembership->id, UserRole::Employee->value)
+        ->assertForbidden();
+
+    Livewire::actingAs($owner)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $foreignMembership->id)
+        ->assertForbidden();
+
+    expect($foreignMembership->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('an employee can remove themselves', function () {
+    [$entity] = makeMembersTestEntityWithOwner();
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->employee()->create([
+        'entity_id' => $entity->id,
+        'user_id' => $employee->id,
+    ]);
+
+    Livewire::actingAs($employee)
+        ->test(Members::class, ['entity' => $entity])
+        ->call('removeMember', $membership->id)
+        ->assertHasNoErrors();
+
+    $this->assertDatabaseMissing('entity_memberships', ['id' => $membership->id]);
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..90d68c1
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,92 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('entities are bound by slug and soft deleted', function () {
+    $entity = Entity::factory()->create(['name' => 'Acme', 'slug' => 'acme']);
+
+    expect($entity->getRouteKeyName())->toBe('slug')
+        ->and($entity->getRouteKey())->toBe('acme');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('entity memberships cast the role and expose their relations', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+
+    expect($membership->role)->toBe(UserRole::Admin)
+        ->and($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->entity->memberships)->toHaveCount(1);
+});
+
+test('entity membership role scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->admin()->create(['entity_id' => $entity->id]);
+    EntityMembership::factory()->employee()->create(['entity_id' => $entity->id]);
+
+    expect(EntityMembership::owner()->count())->toBe(1)
+        ->and(EntityMembership::admin()->count())->toBe(1)
+        ->and(EntityMembership::employee()->count())->toBe(1);
+});
+
+test('the database rejects a second owner per entity', function () {
+    $entity = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]);
+
+    expect(fn () => EntityMembership::factory()->owner()->create(['entity_id' => $entity->id]))
+        ->toThrow(QueryException::class);
+});
+
+test('the database rejects duplicate membership for the same user and entity', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(QueryException::class);
+});
+
+test('deleting an entity removes its memberships when force deleted', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::find($membership->id))->toBeNull();
+});
+
+test('a user exposes memberships, entities and membershipFor', function () {
+    $user = User::factory()->create();
+    $membership = EntityMembership::factory()->owner()->create(['user_id' => $user->id]);
+    $otherEntity = Entity::factory()->create();
+
+    expect($user->memberships)->toHaveCount(1)
+        ->and($user->entities)->toHaveCount(1)
+        ->and($user->entities->first()->is($membership->entity))->toBeTrue()
+        ->and($user->membershipFor($membership->entity_id))->toBeInstanceOf(EntityMembership::class)
+        ->and($user->membershipFor($otherEntity->id))->toBeNull();
+});
+
+test('membership factories provide owner admin and employee states', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee)
+        ->and(EntityMembership::factory()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('the manageable roles exclude the owner', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
