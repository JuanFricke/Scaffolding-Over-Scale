diff --git a/app/Actions/CreateQueue.php b/app/Actions/CreateQueue.php
new file mode 100644
index 0000000..126c26c
--- /dev/null
+++ b/app/Actions/CreateQueue.php
@@ -0,0 +1,88 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class CreateQueue
+{
+    /**
+     * Create an active queue within an entity.
+     *
+     * Name is trimmed (1–255 chars). Slug defaults to the slugified name; an
+     * explicit slug is also slugified. Slugs are unique per entity — duplicates
+     * (including an index collision from a concurrent creation) surface as a
+     * ValidationException, never as a raw QueryException.
+     */
+    public function __invoke(Entity $entity, User $actor, string $name, ?string $slug = null): Queue
+    {
+        Gate::forUser($actor)->authorize('create', [Queue::class, $entity]);
+
+        $name = trim($name);
+
+        if ($name === '') {
+            throw ValidationException::withMessages([
+                'name' => __('validation.required', ['attribute' => 'name']),
+            ]);
+        }
+
+        if (Str::length($name) > 255) {
+            throw ValidationException::withMessages([
+                'name' => __('validation.max.string', ['attribute' => 'name', 'max' => 255]),
+            ]);
+        }
+
+        $slug = Str::slug($slug ?? $name);
+
+        if ($slug === '') {
+            throw ValidationException::withMessages([
+                'slug' => __('validation.required', ['attribute' => 'slug']),
+            ]);
+        }
+
+        if (Queue::query()->where('entity_id', $entity->id)->where('slug', $slug)->exists()) {
+            throw ValidationException::withMessages([
+                'slug' => __('validation.unique', ['attribute' => 'slug']),
+            ]);
+        }
+
+        try {
+            return DB::transaction(function () use ($entity, $name, $slug): Queue {
+                return Queue::query()->create([
+                    'entity_id' => $entity->id,
+                    'name' => $name,
+                    'slug' => $slug,
+                    'is_active' => true,
+                ]);
+            });
+        } catch (QueryException $e) {
+            // unique(entity_id, slug) fired from a concurrent creation.
+            if (self::isUniqueViolation($e)) {
+                throw ValidationException::withMessages([
+                    'slug' => __('validation.unique', ['attribute' => 'slug']),
+                ]);
+            }
+
+            throw $e;
+        }
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
diff --git a/app/Actions/SetQueueAccess.php b/app/Actions/SetQueueAccess.php
