+
+it('rejects authorization before reporting an empty queue', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stranger = User::factory()->create();
+
+    expect(fn () => (new CallNextTicket)($queue, $stranger, CallMode::Any))
+        ->toThrow(AuthorizationException::class);
+});
