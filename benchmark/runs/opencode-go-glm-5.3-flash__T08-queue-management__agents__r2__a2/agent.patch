@@ -0,0 +1,62 @@
+<?php
+
+namespace Database\Factories;
+
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    /**
+     * Define the model's default state.
+     *
+     * Ids stay null here and are resolved in afterMaking(), so membership and
+     * queue always end up in the same entity. Explicit ids are preserved.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'entity_membership_id' => null,
+            'queue_id' => null,
+            // The single permission today: call.
+            'permissions' => [QueuePermission::Call->value],
+        ];
+    }
+
+    /**
+     * Ensure the grant pairs a membership with a queue from the same entity.
+     */
+    public function configure(): static
+    {
+        return $this->afterMaking(function (QueueAccess $access): void {
+            if ($access->entity_membership_id === null && $access->queue_id === null) {
+                $entity = Entity::factory()->create();
+                $access->entity_membership_id = EntityMembership::factory()->for($entity)->create()->id;
+                $access->queue_id = Queue::factory()->for($entity)->create()->id;
+
+                return;
+            }
+
+            if ($access->queue_id === null) {
+                $access->queue_id = Queue::factory()->for($access->membership->entity)->create()->id;
+
+                return;
+            }
+
+            if ($access->entity_membership_id === null) {
+                $access->entity_membership_id = EntityMembership::factory()
+                    ->for($access->queue->entity)
+                    ->create()->id;
+            }
+        });
+    }
+}
