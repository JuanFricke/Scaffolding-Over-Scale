@@ -0,0 +1,123 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    /**
+     * Update a queue's name, slug and active flag.
+     *
+     * Each parameter is optional: `null` leaves it unchanged. Name is trimmed
+     * (1–255 chars) and slugs are slugified, unique within the queue's entity
+     * (keeping the queue's own slug is fine); collisions — including a unique
+     * index race — surface as a ValidationException. Queues are never deleted:
+     * deactivation (`isActive: false`) retires them while tickets are
+     * preserved.
+     */
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', [Queue::class, $queue]);
+
+        $attributes = [];
+
+        if ($name !== null) {
+            $name = trim($name);
+
+            if ($name === '') {
+                throw ValidationException::withMessages([
+                    'name' => __('validation.required', ['attribute' => 'name']),
+                ]);
+            }
+
+            if (Str::length($name) > 255) {
+                throw ValidationException::withMessages([
+                    'name' => __('validation.max.string', ['attribute' => 'name', 'max' => 255]),
+                ]);
+            }
+
+            $attributes['name'] = $name;
+        }
+
+        if ($slug !== null) {
+            $slug = Str::slug($slug);
+
+            if ($slug === '') {
+                throw ValidationException::withMessages([
+                    'slug' => __('validation.required', ['attribute' => 'slug']),
+                ]);
+            }
+
+            $attributes['slug'] = $slug;
+        }
+
+        if ($isActive !== null) {
+            $attributes['is_active'] = $isActive;
+        }
+
+        if (isset($attributes['slug'])) {
+            $slugTaken = Queue::query()
+                ->where('entity_id', $queue->entity_id)
+                ->where('slug', $attributes['slug'])
+                ->whereKeyNot($queue->id)
+                ->exists();
+
+            if ($slugTaken) {
+                throw ValidationException::withMessages([
+                    'slug' => __('validation.unique', ['attribute' => 'slug']),
+                ]);
+            }
+        }
+
+        $this->apply($queue, $attributes);
+
+        return $queue->refresh();
+    }
+
+    /**
+     * @param  array<string, mixed>  $attributes
+     */
+    private function apply(Queue $queue, array $attributes): void
+    {
+        if ($attributes === []) {
+            return;
+        }
+
+        try {
+            DB::transaction(fn () => $queue->update($attributes));
+        } catch (QueryException $e) {
+            // unique(entity_id, slug) fired from a concurrent update.
+            if (self::isUniqueViolation($e)) {
+                throw ValidationException::withMessages([
+                    'slug' => __('validation.unique', ['attribute' => 'slug']),
+                ]);
+            }
+
+            throw $e;
+        }
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
