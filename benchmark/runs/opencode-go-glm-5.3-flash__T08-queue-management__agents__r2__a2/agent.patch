+
+it('slugifies an explicit slug', function () {
+    [$entity, $owner] = queueLifecycleFixtures();
+
+    $queue = (new CreateQueue)($entity, $owner, 'Suporte Técnico', slug: '  Minha Fila_2 ');
+
+    expect($queue->slug)->toBe('minha-fila-2');
+});
+
+it('allows the admin to create a queue and denies others', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = queueLifecycleFixtures();
+
+    $queue = (new CreateQueue)($entity, $admin, 'Balcao 1');
+
+    expect($queue->slug)->toBe('balcao-1');
+
+    foreach ([$employee, $stranger] as $denied) {
+        $before = Queue::query()->count();
+
+        expect(fn () => (new CreateQueue)($entity, $denied, 'Hack Queue'))
+            ->toThrow(AuthorizationException::class);
+
+        expect(Queue::query()->count())->toBe($before);
+    }
+});
+
+it('rejects a duplicate slug within the same entity but allows it in another entity', function () {
+    [$entity, $owner] = queueLifecycleFixtures();
+
+    (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+
+    expect(fn () => (new CreateQueue)($entity, $owner, 'Outra', slug: 'atendimento-geral'))
+        ->toThrow(ValidationException::class);
+
+    $otherEntity = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($otherOwner)->owner()->create();
+
+    $second = (new CreateQueue)($otherEntity, $otherOwner, 'Outra', slug: 'atendimento-geral');
+
+    expect($second->slug)->toBe('atendimento-geral')
+        ->and(Queue::query()->where('entity_id', $entity->id)->count())->toBe(1);
+});
+
+it('validates the queue name', function () {
+    [$entity, $owner] = queueLifecycleFixtures();
+
+    foreach (['   ', str_repeat('a', 256)] as $invalidName) {
+        expect(fn () => (new CreateQueue)($entity, $owner, $invalidName))
+            ->toThrow(ValidationException::class);
+    }
+
+    expect(Queue::query()->count())->toBe(0);
+});
+
+it('rejects an explicit slug that slugifies to nothing', function () {
+    [$entity, $owner] = queueLifecycleFixtures();
+
+    expect(fn () => (new CreateQueue)($entity, $owner, 'Fila Valida', slug: '!!!'))
+        ->toThrow(ValidationException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+});
+
+/* ---------- UpdateQueue ---------- */
+
+it('updates name, slug and active flag in any combination', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = queueLifecycleFixtures();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral', slug: 'atendimento-geral');
+    $other = Queue::factory()->for($entity)->create();
+
+    // Named parameters follow the documented contract; null leaves unchanged.
+    $renamedOnly = (new UpdateQueue)($queue, $owner, name: '  Novo Nome  ');
+    expect($renamedOnly->fresh())
+        ->name->toBe('Novo Nome')
+        ->slug->toBe('atendimento-geral')
+        ->is_active->toBeTrue();
+
+    $rethemed = (new UpdateQueue)($queue, $owner, slug: 'Fila do Balcao');
+    expect($rethemed->fresh()->slug)->toBe('fila-do-balcao');
+
+    $deactivated = (new UpdateQueue)($queue, $owner, isActive: false);
+    expect($deactivated->fresh()->is_active)->toBeFalse()
+        ->and($deactivated->fresh()->slug)->toBe('fila-do-balcao');
+
+    $combined = (new UpdateQueue)($queue, $admin, name: 'Final', slug: 'final', isActive: true);
+    expect($combined->fresh())
+        ->name->toBe('Final')
+        ->slug->toBe('final')
+        ->is_active->toBeTrue()
+        ->and($other->fresh()->slug === $combined->fresh()->slug)->toBeFalse();
+});
+
+it('accepts the queue keeping its own slug', function () {
+    [$entity, $owner] = queueLifecycleFixtures();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+    $original = $queue->slug;
+
+    $unchanged = (new UpdateQueue)($queue, $owner, slug: $original);
+
+    expect($unchanged->fresh()->slug)->toBe($original);
+});
+
+it('rejects taking another queue of the same entity but allows other entities', function () {
+    [$entity, $owner] = queueLifecycleFixtures();
+    $first = (new CreateQueue)($entity, $owner, 'Primeira');
+    $second = (new CreateQueue)($entity, $owner, 'Segunda');
+
+    expect(fn () => (new UpdateQueue)($second, $owner, slug: $first->slug))
+        ->toThrow(ValidationException::class);
+
+    expect($second->fresh()->slug)->toBe('segunda');
+
+    $otherEntity = Entity::factory()->create();
+    $otherOwner = User::factory()->create();
+    EntityMembership::factory()->for($otherEntity)->for($otherOwner)->owner()->create();
+    $otherQueue = (new CreateQueue)($otherEntity, $otherOwner, 'Inteira');
+
+    $taken = (new UpdateQueue)($otherQueue, $otherOwner, slug: $first->slug);
+
+    expect($taken->fresh()->slug)->toBe($first->slug);
+});
+
+it('deactivation preserves tickets and keeps issuing and calling failing', function () {
+    [$entity, $owner] = queueLifecycleFixtures();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+    $ticket = (new IssueTicket)($queue, 0);
+
+    $updated = (new UpdateQueue)($queue, $owner, isActive: false);
+
+    expect($updated->fresh()->is_active)->toBeFalse()
+        ->and($ticket->fresh()->exists)->toBeTrue()
+        ->and($ticket->fresh()->status->value)->toBe('waiting');
+
+    expect(fn () => (new IssueTicket)($updated->fresh()))
+        ->toThrow(InactiveQueueException::class);
+
+    expect(fn () => $ticket->fresh()->call($owner))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh()->status->value)->toBe('waiting');
+});
+
+it('rejects queue updates from non-managers without writing', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = queueLifecycleFixtures();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+
+    foreach ([$employee, $stranger] as $denied) {
+        expect(fn () => (new UpdateQueue)($queue, $denied, name: 'Hacked'))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect($queue->fresh()->name)->toBe('Atendimento Geral');
+});
+
+it('accepts a queue update request that changes nothing', function () {
+    [$entity, $owner] = queueLifecycleFixtures();
+    $queue = (new CreateQueue)($entity, $owner, 'Atendimento Geral');
+
+    $untouched = (new UpdateQueue)($queue, $owner);
+
+    expect($untouched->fresh())
+        ->name->toBe('Atendimento Geral')
+        ->is_active->toBeTrue();
+});
diff --git a/tests/Feature/QueuePolicyTest.php b/tests/Feature/QueuePolicyTest.php
new file mode 100644
index 0000000..2e3d38d
--- /dev/null
+++ b/tests/Feature/QueuePolicyTest.php
@@ -0,0 +1,105 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Shared fixtures: an entity with owner, admin, employee and a stranger.
+ *
+ * @return array{Entity, User, User, User, User, EntityMembership}
+ */
+function queuePolicyFixtures(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $stranger = User::factory()->create();
+
+    $employeeMem = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+
+    return [$entity, $owner, $admin, $employee, $stranger, $employeeMem];
+}
+
+it('allows only managers to create queues in an entity', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = queuePolicyFixtures();
+
+    $can = fn (User $user) => Gate::forUser($user)->allows('create', [Queue::class, $entity]);
+
+    expect($can($owner))->toBeTrue()
+        ->and($can($admin))->toBeTrue()
+        ->and($can($employee))->toBeFalse()
+        ->and($can($stranger))->toBeFalse();
+});
+
+it('allows only managers of the queue entity to update and manage access', function () {
+    [$entity, $owner, $admin, $employee, $stranger] = queuePolicyFixtures();
+    $queue = Queue::factory()->for($entity)->create();
+
+    $can = fn (User $user, string $ability) => Gate::forUser($user)->allows($ability, [Queue::class, $queue]);
+
+    foreach (['update', 'manageAccess'] as $ability) {
+        expect($can($owner, $ability))->toBeTrue()
+            ->and($can($admin, $ability))->toBeTrue()
+            ->and($can($employee, $ability))->toBeFalse()
+            ->and($can($stranger, $ability))->toBeFalse();
+    }
+});
+
+it('allows managers to call without any queue_access row', function () {
+    [$entity, $owner, $admin] = queuePolicyFixtures();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(Gate::forUser($owner)->allows('call', [Queue::class, $queue]))->toBeTrue()
+        ->and(Gate::forUser($admin)->allows('call', [Queue::class, $queue]))->toBeTrue()
+        ->and(QueueAccess::query()->exists())->toBeFalse();
+});
+
+it('allows an employee to call with a call grant on that queue', function () {
+    [$entity, , , $employee, , $employeeMem] = queuePolicyFixtures();
+    $queue = Queue::factory()->for($entity)->create();
+    $otherQueue = Queue::factory()->for($entity)->create();
+    QueueAccess::factory()->for($employeeMem, 'membership')->for($queue)->create();
+
+    expect(Gate::forUser($employee)->allows('call', [Queue::class, $queue]))->toBeTrue()
+        ->and(Gate::forUser($employee)->denies('call', [Queue::class, $otherQueue]))->toBeTrue();
+});
+
+it('denies employees without a grant and users outside the entity', function () {
+    [$entity, $owner, , $employee, $stranger, $employeeMem] = queuePolicyFixtures();
+    $queue = Queue::factory()->for($entity)->create();
+    QueueAccess::factory()->for($employeeMem, 'membership')->for($queue)->create();
+
+    expect(Gate::forUser($stranger)->denies('call', [Queue::class, $queue]))->toBeTrue();
+
+    // A foreign membership with its own grant row must not leak access here.
+    $foreignEntity = Entity::factory()->create();
+    $foreignQueue = Queue::factory()->for($foreignEntity)->create();
+    $foreignMember = User::factory()->create();
+    $foreignMembership = EntityMembership::factory()->for($foreignEntity)
+        ->for($foreignMember)->employee()->create();
+    QueueAccess::factory()->for($foreignMembership, 'membership')->for($foreignQueue)->create();
+
+    expect(Gate::forUser($foreignMember)->denies('call', [Queue::class, $queue]))->toBeTrue()
+        ->and(Gate::forUser($owner)->allows('call', [Queue::class, $foreignQueue]))->toBeFalse();
+});
+
+it('denies call when the stored permissions value is corrupted', function () {
+    [$entity, , , $employee, , $employeeMem] = queuePolicyFixtures();
+    $queue = Queue::factory()->for($entity)->create();
+
+    $access = QueueAccess::factory()->for($employeeMem, 'membership')->for($queue)->create();
+    DB::table('queue_access')->where('id', $access->id)->update(['permissions' => '"call"']);
+
+    expect(Gate::forUser($employee)->denies('call', [Queue::class, $queue]))->toBeTrue();
+});
diff --git a/tests/Feature/SetQueueAccessTest.php b/tests/Feature/SetQueueAccessTest.php
new file mode 100644
index 0000000..fcff65f
--- /dev/null
+++ b/tests/Feature/SetQueueAccessTest.php
@@ -0,0 +1,235 @@
+<?php
+
+use App\Actions\SetQueueAccess;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+use Mockery\MockInterface;
+use Psr\Log\LoggerInterface;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Shared fixtures: an entity with owner/admin/employee plus a foreign entity
+ * with its own manager.
+ *
+ * @return array<string, mixed>
+ */
+function queueAccessFixtures(): array
+{
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    $admin = User::factory()->create();
+    $employee = User::factory()->create();
+    $stranger = User::factory()->create();
+
+    $ownerMem = EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $adminMem = EntityMembership::factory()->for($entity)->for($admin)->admin()->create();
+    $employeeMem = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $foreignEntity = Entity::factory()->create();
+    $foreignOwner = User::factory()->create();
+    EntityMembership::factory()->for($foreignEntity)->for($foreignOwner)->owner()->create();
+    $foreignMembership = EntityMembership::factory()->for($foreignEntity)
+        ->for(User::factory()->create())->employee()->create();
+
+    $queue = Queue::factory()->for($entity)->create();
+
+    return [
+        'entity' => $entity,
+        'owner' => $owner,
+        'admin' => $admin,
+        'employee' => $employee,
+        'stranger' => $stranger,
+        'ownerMem' => $ownerMem,
+        'adminMem' => $adminMem,
+        'employeeMem' => $employeeMem,
+        'foreignEntity' => $foreignEntity,
+        'foreignOwner' => $foreignOwner,
+        'foreignMembership' => $foreignMembership,
+        'queue' => $queue,
+    ];
+}
+
+/**
+ * Swaps the real audit channel for a Mockery spy so audit writes can be
+ * asserted per message.
+ */
+function fakeAuditChannel(bool $setUp = true): MockInterface
+{
+    $audit = Mockery::spy(LoggerInterface::class);
+
+    if ($setUp) {
+        Log::shouldReceive('channel')->with('audit')->andReturn($audit);
+    }
+
+    return $audit;
+}
+
+/* ---------- QueueAccess factory + schema ---------- */
+
+it('factories a call grant whose membership and queue share the entity', function () {
+    $access = QueueAccess::factory()->create();
+
+    expect($access->permissions)->toBe(['call'])
+        ->and($access->membership->entity_id)->toBe($access->queue->entity_id);
+});
+
+it('factories a grant around an explicit queue', function () {
+    $fixtures = queueAccessFixtures();
+
+    $access = QueueAccess::factory()->for($fixtures['queue'])->create();
+
+    expect($access->queue->is($fixtures['queue']))->toBeTrue()
+        ->and($access->membership->entity_id)->toBe($fixtures['entity']->id);
+});
+
+it('factories a grant around an explicit membership', function () {
+    $fixtures = queueAccessFixtures();
+
+    $access = QueueAccess::factory()->for($fixtures['employeeMem'], 'membership')->create();
+
+    expect($access->membership->is($fixtures['employeeMem']))->toBeTrue()
+        ->and($access->queue->entity_id)->toBe($fixtures['entity']->id);
+});
+
+it('enforces one row per membership and queue', function () {
+    $fixtures = queueAccessFixtures();
+
+    QueueAccess::factory()->for($fixtures['employeeMem'], 'membership')->for($fixtures['queue'])->create();
+
+    expect(fn () => QueueAccess::factory()->for($fixtures['employeeMem'], 'membership')->for($fixtures['queue'])->create())
+        ->toThrow(QueryException::class);
+});
+
+it('cascades queue access rows when membership or queue is deleted', function () {
+    $fixtures = queueAccessFixtures();
+
+    $access = QueueAccess::factory()->for($fixtures['employeeMem'], 'membership')->for($fixtures['queue'])->create();
+
+    $fixtures['employeeMem']->delete();
+
+    expect(QueueAccess::query()->find($access->id))->toBeNull();
+});
+
+/* ---------- SetQueueAccess ---------- */
+
+it('grants call permission to a membership', function () {
+    $fixtures = queueAccessFixtures();
+    $audit = fakeAuditChannel();
+
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], ['call']);
+
+    $access = QueueAccess::query()->firstOrFail();
+
+    expect($access->permissions)->toBe(['call'])
+        ->and($access->entity_membership_id)->toBe($fixtures['employeeMem']->id)
+        ->and($access->queue_id)->toBe($fixtures['queue']->id);
+
+    $audit->shouldHaveReceived('info', ['queue.access.granted', [
+        'actor_id' => $fixtures['owner']->id,
+        'queue_id' => $fixtures['queue']->id,
+        'entity_membership_id' => $fixtures['employeeMem']->id,
+    ]]);
+});
+
+it('lets any manager of the entity grant access', function () {
+    $fixtures = queueAccessFixtures();
+
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], ['call']);
+    (new SetQueueAccess)($fixtures['adminMem'], $fixtures['queue'], $fixtures['admin'], ['call']);
+
+    expect(QueueAccess::query()->count())->toBe(2);
+});
+
+it('upserts instead of duplicating rows on repeated grants', function () {
+    $fixtures = queueAccessFixtures();
+
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], ['call']);
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], ['call']);
+
+    expect(QueueAccess::query()->where('entity_membership_id', $fixtures['employeeMem']->id)->count())->toBe(1)
+        ->and(QueueAccess::query()->first()->permissions)->toBe(['call']);
+});
+
+it('revokes by passing an empty permissions list', function () {
+    $fixtures = queueAccessFixtures();
+
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], ['call']);
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('revoking without an existing row changes nothing and logs nothing', function () {
+    $fixtures = queueAccessFixtures();
+    $audit = fakeAuditChannel();
+
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], []);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+
+    $audit->shouldNotHaveReceived('info', ['queue.access.revoked', [
+        'actor_id' => $fixtures['owner']->id,
+        'queue_id' => $fixtures['queue']->id,
+        'entity_membership_id' => $fixtures['employeeMem']->id,
+    ]]);
+});
+
+it('logs queue.access.revoked on the audit channel when a row is deleted', function () {
+    $fixtures = queueAccessFixtures();
+
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], ['call']);
+
+    $audit = fakeAuditChannel();
+
+    (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], []);
+
+    $audit->shouldHaveReceived('info', ['queue.access.revoked', [
+        'actor_id' => $fixtures['owner']->id,
+        'queue_id' => $fixtures['queue']->id,
+        'entity_membership_id' => $fixtures['employeeMem']->id,
+    ]]);
+});
+
+it('rejects unknown or non-string permission entries writing nothing', function () {
+    $fixtures = queueAccessFixtures();
+
+    foreach ([['manage'], ['call', 7], ['CALL'], [null]] as $bad) {
+        expect(fn () => (new SetQueueAccess)($fixtures['employeeMem'], $fixtures['queue'], $fixtures['owner'], $bad))
+            ->toThrow(ValidationException::class);
+    }
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('rejects membership and queue from different entities', function () {
+    $fixtures = queueAccessFixtures();
+
+    expect(fn () => (new SetQueueAccess)($fixtures['foreignMembership'], $fixtures['queue'], $fixtures['owner'], ['call']))
+        ->toThrow(ValidationException::class);
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
+
+it('denies non-managers, including employees granting themselves', function () {
+    $fixtures = queueAccessFixtures();
+
+    foreach ([
+        [$fixtures['employee'], $fixtures['employeeMem']],
+        [$fixtures['stranger'], $fixtures['employeeMem']],
+        [$fixtures['foreignOwner'], $fixtures['employeeMem']],
+    ] as [$actor, $membership]) {
+        expect(fn () => (new SetQueueAccess)($membership, $fixtures['queue'], $actor, ['call']))
+            ->toThrow(AuthorizationException::class);
+    }
+
+    expect(QueueAccess::query()->count())->toBe(0);
+});
