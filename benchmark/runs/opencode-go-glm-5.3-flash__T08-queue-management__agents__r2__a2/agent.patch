index 0000000..41b15f8
--- /dev/null
+++ b/app/Actions/SetQueueAccess.php
@@ -0,0 +1,112 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * Set the per-queue permissions of an entity membership on a queue.
+     *
+     * Only managers of the queue's entity may act. A non-empty permission list
+     * upserts the queue_access row; an empty list revokes it (deleting the
+     * grant). Every decision is audited on the `audit` channel — `granted` on
+     * upsert and `revoked` only when a row was actually deleted.
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', [Queue::class, $queue]);
+
+        if ((int) $targetMembership->entity_id !== (int) $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => __('validation.in', ['attribute' => 'entity membership']),
+            ]);
+        }
+
+        foreach ($permissions as $permission) {
+            if (! is_string($permission) || QueuePermission::tryFrom($permission) === null) {
+                throw ValidationException::withMessages([
+                    'permissions' => __('validation.in', ['attribute' => 'permissions']),
+                ]);
+            }
+        }
+
+        $context = [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+        ];
+
+        if ($permissions === []) {
+            $revoked = QueueAccess::query()
+                ->where('entity_membership_id', $targetMembership->id)
+                ->where('queue_id', $queue->id)
+                ->delete();
+
+            if ($revoked > 0) {
+                Log::channel('audit')->info('queue.access.revoked', $context);
+            }
+
+            return;
+        }
+
+        $this->upsert($queue, $targetMembership, array_values($permissions));
+
+        Log::channel('audit')->info('queue.access.granted', $context);
+    }
+
+    /**
+     * @param  list<string>  $permissions
+     */
+    private function upsert(Queue $queue, EntityMembership $targetMembership, array $permissions): void
+    {
+        $attributes = [
+            'entity_membership_id' => $targetMembership->id,
+            'queue_id' => $queue->id,
+        ];
+
+        try {
+            DB::transaction(function () use ($attributes, $permissions): void {
+                QueueAccess::query()->updateOrCreate($attributes, [
+                    'permissions' => $permissions,
+                ]);
+            });
+        } catch (QueryException $e) {
+            // unique(entity_membership_id, queue_id) fired from a concurrent
+            // grant: the row exists, so update it instead.
+            if (! self::isUniqueViolation($e)) {
+                throw $e;
+            }
+
+            QueueAccess::query()
+                ->where($attributes)
+                ->update(['permissions' => $permissions]);
+        }
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
