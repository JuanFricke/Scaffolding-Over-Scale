+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Route;
+
+function renderMail($notification, User $user): string
+{
+    return (string) $notification->toMail($user)->render();
+}
+
+beforeEach(function () {
+    app()->setLocale('pt_BR');
+});
+
+test('the test suite runs with the product locale and name', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('markdown mail uses the pegafila theme with the brand color', function () {
+    expect(config('mail.markdown.theme'))->toBe('pegafila')
+        ->and(file_exists(resource_path('views/vendor/mail/html/themes/pegafila.css')))->toBeTrue();
+
+    $user = User::factory()->make();
+    $html = renderMail(new ResetPassword('token'), $user);
+
+    expect($html)->toMatch('/class="button button-primary"[^>]*background-color:\s*#0f7490/i');
+});
+
+test('the reset password mail is in pt-BR', function () {
+    $user = User::factory()->make();
+    $mail = (new ResetPassword('token'))->toMail($user);
+    $html = renderMail(new ResetPassword('token'), $user);
