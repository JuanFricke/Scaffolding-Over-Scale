+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('queue belongs to entity and entity has queues', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity)->toBeInstanceOf(Entity::class)
+        ->and($queue->entity->id)->toBe($queue->entity_id)
+        ->and(Entity::query()->whereKey($queue->entity_id)->first()->queues->first()->id)->toBe($queue->id);
+});
+
+test('queues factory creates active queues with their entity', function () {
+    $a = Queue::factory()->create();
+    $b = Queue::factory()->create();
+
+    expect($a->is_active)->toBeTrue()
+        ->and($a->labels_i18n)->toBeNull()
+        ->and($a->entity_id)->not->toEqual($b->entity_id)
+        ->and($a->slug)->not->toBe($b->slug)
+        ->and($a->name)->not->toBe('');
+});
+
+test('ticket belongs to queue and records the calling user', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->queue)->toBeInstanceOf(Queue::class)
+        ->and($ticket->queue->id)->toBe($ticket->queue_id)
+        ->and($ticket->calledBy)->toBeNull();
+});
+
+test('ticket factory defaults: waiting, virtual, priority 0, issued now, next code', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    expect($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->issued_at->diffInSeconds(now()))->toBeLessThan(5)
+        ->and($ticket->code)->toBe('A001');
+});
+
+test('ticket factory allocates sequential codes per queue', function () {
+    $queue = Queue::factory()->create();
+
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $second = Ticket::factory()->forQueue($queue)->create();
+
+    expect($first->code)->toBe('A001')
+        ->and($second->code)->toBe('A002');
+});
+
+test('ticket factory keeps an explicitly given code', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X')
+        ->and(Ticket::nextCode($queue->id))->toBe('A001');
+});
+
+test('ticket factory without a queue creates its own queue', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->queue)->toBeInstanceOf(Queue::class)
+        ->and($ticket->code)->toBe('A001');
+});
+
+test('queue fillable and casts match the contract', function () {
+    $queue = Queue::factory()->make(['labels_i18n' => ['pt_BR' => ['title' => 'Fila A']]]);
+
+    expect($queue->is_active)->toBeBool()->and($queue->is_active)->toBeTrue()
+        ->and($queue->labels_i18n)->toBeArray();
+});
