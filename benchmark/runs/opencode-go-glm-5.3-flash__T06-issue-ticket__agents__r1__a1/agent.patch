+++ b/tests/Feature/Queue/TicketTest.php
@@ -0,0 +1,174 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+function ticketCode(int $digits): string
+{
+    return 'A'.str_pad((string) $digits, 3, '0', STR_PAD_LEFT);
+}
+
+test('nextCode starts at A001 for an empty queue', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+});
+
+test('nextCode follows insertion order: A001, A002, ...', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    Ticket::factory()->forQueue($queue)->create();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('nextCode does not reuse numbers of deleted tickets', function () {
+    $queue = Queue::factory()->create();
+    $first = Ticket::factory()->forQueue($queue)->create();
+    $methods = Ticket::factory()->forQueue($queue)->create();
+    $third = Ticket::factory()->forQueue($queue)->create();
+
+    $methods->delete();
+
+    $expected = ticketCode(4);
+    expect(Ticket::nextCode($queue->id))->toBe($expected)
+        ->and($first->code)->toBe('A001')
+        ->and($third->code)->toBe('A003');
+});
+
+test('nextCode skips malformed legacy codes', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($queue->id))->toBe('A001');
+
+    Ticket::factory()->forQueue($queue)->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A-ZZZ']);
+    expect(Ticket::nextCode($queue->id))->toBe('A002');
+});
+
+test('nextCode is per queue', function () {
+    $a = Queue::factory()->create();
+    $b = Queue::factory()->create();
+
+    Ticket::factory()->forQueue($a)->create();
+    Ticket::factory()->forQueue($a)->create();
+
+    expect(Ticket::nextCode($b->id))->toBe('A001');
+});
+
+test('write-once: immutable fields cannot be changed after issuance', function () {
+    $ticket = Ticket::factory()->create();
+
+    foreach ([
+        ['code' => 'A777'],
+        ['priority' => 5],
+        ['channel' => 'totem'],
+        ['issued_at' => now()->addMinute()],
+        ['queue_id' => Queue::factory()->create()->id],
+    ] as $write) {
+        try {
+            $ticket->update($write);
+            $this->fail('update with '.collect($write)->keys()->implode(',').' must throw.');
+        } catch (LogicException) {
+            $ticket->refresh();
+        }
+    }
+
+    expect($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and(Ticket::count())->toBe(1);
+});
+
+test('write-once: status, called_at and called_by_user_id can change', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+
+    $when = now();
+    $ticket->update([
+        'status' => 'called',
+        'called_at' => $when,
+        'called_by_user_id' => $user->getKey(),
+    ]);
+
+    $ticket->refresh();
+    expect($ticket->status->value)->toBe('called')
+        ->and($ticket->called_at->toDateTimeString())->toBe($when->toDateTimeString())
+        ->and($ticket->called_by_user_id)->toBe($user->getKey())
+        ->and($ticket->calledBy->id)->toBe($user->getKey());
+});
+
+function callContext(): array
+{
+    $queue = Queue::factory()->create();
+    $user = User::factory()->create();
+    DB::table('entity_memberships')->insert([
+        'entity_id' => $queue->entity_id,
+        'user_id' => $user->getKey(),
+        'role' => 'employee',
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+
+    return [$queue, Ticket::factory()->forQueue($queue)->create(), $user];
+}
+
+test('a member can call a waiting ticket exactly once', function () {
+    [, $ticket, $user] = callContext();
+
+    $ticket->call($user);
+
+    $ticket->refresh();
+    expect($ticket->status)->toBe(TicketStatus::Called)
+        ->and($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBe($user->getKey());
+});
+
+test('another entity member cannot call the ticket', function () {
+    $queue = Queue::factory()->create();
+    $stranger = User::factory()->create();
+    DB::table('entity_memberships')->insert([
+        'entity_id' => Entity::factory()->create()->id,
+        'user_id' => $stranger->getKey(),
+        'role' => 'employee',
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+    $ticket = Ticket::factory()->forQueue($queue)->create();
+
+    try {
+        $ticket->call($stranger);
+        $this->fail('call() by a foreign-entity member must throw.');
+    } catch (AuthorizationException) {
+        // expected
+    }
+
+    expect($ticket->refresh()->getRawOriginal('status'))->toBe('waiting');
+});
+
+test('calling an already-called ticket throws', function () {
+    [, $ticket, $user] = callContext();
+
+    $ticket->call($user);
+    $before = $ticket->getRawOriginal('called_at');
+
+    expect(function () use ($ticket, $user) {
+        $ticket->call($user);
+    })->toThrow(LogicException::class);
+
+    $ticket->refresh();
+    expect($ticket->getRawOriginal('called_at'))->toBe($before);
+});
