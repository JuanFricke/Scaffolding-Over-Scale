+++ b/app/Models/Ticket.php
@@ -0,0 +1,118 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+#[Fillable(['queue_id', 'code', 'priority', 'channel', 'status', 'issued_at', 'called_at', 'called_by_user_id'])]
+class Ticket extends Model
+{
+    use HasFactory;
+
+    /**
+     * Fields set at issuance and never changed afterwards. Only status,
+     * called_at, called_by_user_id (and updated_at) may change later.
+     */
+    private const IMMUTABLE = ['queue_id', 'code', 'priority', 'channel', 'issued_at'];
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public static function nextCode(int $queueId): string
+    {
+        foreach (DB::table('tickets')->where('queue_id', $queueId)->orderByDesc('id')->get(['code']) as $row) {
+            if (preg_match('/^A(\d+)$/', $row->code, $digits) === 1) {
+                return 'A'.str_pad((string) ((int) $digits[1] + 1), 3, '0', STR_PAD_LEFT);
+            }
+        }
+
+        // Nothing valid yet (or only malformed legacy codes): start the sequence.
+        return 'A001';
+    }
+
+    /**
+     * Call the ticket exactly once: marks it called, records when and who.
+     *
+     * Only members of the ticket's entity may call; the write is a single
+     * conditional update, so even a concurrent second call rejects.
+     *
+     * @throws AuthorizationException when the user does not belong to the entity
+     * @throws LogicException when the ticket is no longer waiting
+     */
+    public function call(User $user): void
+    {
+        if (! $user->membershipFor($this->queue->entity_id)) {
+            throw new AuthorizationException('User does not belong to the ticket\'s entity.');
+        }
+
+        $called = static::query()
+            ->whereKey($this->getKey())
+            ->where('status', TicketStatus::Waiting->value)
+            ->update([
+                'status' => TicketStatus::Called->value,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+                'updated_at' => now(),
+            ]);
+
+        if ($called === 0) {
+            throw new LogicException('Ticket is not waiting to be called.');
+        }
+
+        $this->refresh();
+    }
+
+    /**
+     * Write-once guard: reject saves that change immutable fields.
+     */
+    protected function guardImmutableFields(): void
+    {
+        if (! $this->exists) {
+            return;
+        }
+
+        foreach (self::IMMUTABLE as $field) {
+            if ($this->isDirty($field) && array_key_exists($field, $this->original)) {
+                throw new LogicException("Ticket field [{$field}] is write-once and cannot change after issuance.");
+            }
+        }
+    }
+
+    public function save(array $options = []): bool
+    {
+        $this->guardImmutableFields();
+
+        return parent::save($options);
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+}
