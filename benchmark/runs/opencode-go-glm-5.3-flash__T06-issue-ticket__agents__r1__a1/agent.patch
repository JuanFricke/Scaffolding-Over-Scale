+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+// UniqueConstraintViolationException extends QueryException,
+// whose constructor verifies the shape of a real query failure.
+function uniqueViolation(): UniqueConstraintViolationException
+{
+    return new UniqueConstraintViolationException('sqlite', 'insert into "tickets"', [], new RuntimeException('UNIQUE constraint failed: tickets.queue_id, tickets.code'));
+}
+
+test('issues a waiting ticket on an active queue with defaults', function () {
+    $queue = Queue::factory()->create();
+    $before = now();
+
+    $ticket = app(IssueTicket::class)->__invoke($queue);
+
+    expect($ticket->exists)->toBeTrue()
+        ->and($ticket->queue_id)->toBe($queue->id)
+        ->and($ticket->code)->toBe('A001')
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->issued_at->diffInSeconds($before))->toBeLessThan(5)
+        ->and($ticket->called_at)->toBeNull();
+});
+
+test('sequential issues grow the code by insertion', function () {
+    $queue = Queue::factory()->create();
+    $issue = app(IssueTicket::class);
+
+    expect($issue->__invoke($queue)->code)->toBe('A001')
+        ->and($issue->__invoke($queue)->code)->toBe('A002')
+        ->and(Ticket::nextCode($queue->id))->toBe('A003');
+});
+
+test('issues honor custom priority and channel', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = app(IssueTicket::class)->__invoke($queue, 10, TicketChannel::Totem);
+
+    expect($ticket->priority)->toBe(10)
+        ->and($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting);
+});
+
+test('issues reject negative priority without persisting', function () {
+    $queue = Queue::factory()->create();
+
+    expect(fn () => app(IssueTicket::class)->__invoke($queue, -1))
+        ->toThrow(InvalidArgumentException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('issues reject inactive queues without persisting', function () {
+    $queue = Queue::factory()->create();
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => app(IssueTicket::class)->__invoke($queue))
+        ->toThrow(InactiveQueueException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('issues recheck the queue state in the database, not the stale instance', function () {
+    $queue = Queue::factory()->create();
+
+    // Queue is deactivated after the caller obtained the instance.
+    Queue::query()->whereKey($queue->getKey())->update(['is_active' => false]);
+
+    expect(fn () => app(IssueTicket::class)->__invoke($queue))
+        ->toThrow(InactiveQueueException::class)
+        ->and(Ticket::count())->toBe(0);
+});
+
+test('issues retry on a unique code collision and persist exactly one ticket', function () {
+    $queue = Queue::factory()->create();
+
+    $flaky = new class extends IssueTicket
+    {
+        public int $failed = 0;
+
+        protected function storeTicket(Queue $queue, int $priority, TicketChannel $channel, string $code): Ticket
+        {
+            if (++$this->failed < 3) {
+                throw uniqueViolation();
+            }
+
+            return parent::storeTicket($queue, $priority, $channel, $code);
+        }
+    };
+
+    $ticket = $flaky->__invoke($queue);
+
+    expect($ticket->code)->toBe('A001')
+        ->and($flaky->failed)->toBe(3)
+        ->and(Ticket::count())->toBe(1);
+});
