+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('queues table has required columns and composite unique slug', function () {
+    $this->assertTrue(Schema::hasTable('queues'));
+
+    $this->assertTrue(Schema::hasColumns('queues', [
+        'id', 'entity_id', 'name', 'slug', 'is_active', 'labels_i18n', 'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('queues', 'queues_entity_id_slug_unique'));
+});
+
+test('tickets table has required columns and per-queue unique code', function () {
+    $this->assertTrue(Schema::hasTable('tickets'));
+
+    $this->assertTrue(Schema::hasColumns('tickets', [
+        'id', 'queue_id', 'code', 'priority', 'channel', 'status',
+        'issued_at', 'called_at', 'called_by_user_id', 'created_at', 'updated_at',
+    ]));
+
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_id_code_unique'));
+
+    // Calling order: filter by queue + status, then priority/issued_at.
+    $this->assertTrue(Schema::hasIndex('tickets', 'tickets_queue_id_status_priority_issued_at_index'));
+});
+
+test('deleting an entity cascades to queues and tickets', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create();
+    $entityId = $queue->entity_id;
+
+    // Soft delete keeps children.
+    Entity::find($entityId)->delete();
+    expect(Queue::count())->toBe(1)->and(Ticket::count())->toBe(1);
+
+    $deleted = Entity::withTrashed()->find($entityId);
+    $deleted->forceDelete();
+    expect(Queue::count())->toBe(0)->and(Ticket::count())->toBe(0);
+});
+
+test('deleting a queue cascades to its tickets', function () {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->queue->delete();
+
+    expect(Ticket::query()->whereKey($ticket->getKey())->exists())->toBeFalse()
+        ->and(Queue::count())->toBe(0);
+});
+
+test('is_active defaults to true and called_by_user_id is nullable', function () {
+    $out = Queue::create(['entity_id' => Entity::factory()->create()->id, 'name' => 'Sala 1', 'slug' => 'sala-1']);
+    expect($out->refresh()->is_active)->toBeTrue();
+
+    $ticket = Ticket::factory()->make();
+    $ticket->queue_id = Queue::factory()->create()->id;
+    $ticket->code = 'A-X';
+    $ticket->save();
+
+    expect($ticket->called_at)->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+
+    // Deleting the attendant leaves the ticket intact with a null call record.
+    $user = User::factory()->create();
+    DB::table('entity_memberships')->insert([
+        'user_id' => $user->getKey(),
+        'entity_id' => $ticket->queue->entity_id,
+        'role' => 'employee',
+        'created_at' => now(),
+        'updated_at' => now(),
+    ]);
+    $ticket->call($user);
+    DB::table('users')->where('id', $user->getKey())->delete();
+
+    $ticket->refresh();
+    expect($ticket->called_at)->not->toBeNull()
+        ->and($ticket->called_by_user_id)->toBeNull();
+});
