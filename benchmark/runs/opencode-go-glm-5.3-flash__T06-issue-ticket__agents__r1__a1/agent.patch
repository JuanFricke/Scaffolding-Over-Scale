+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    /**
+     * Attempts to insert a ticket before giving up on a (queue_id, code) UniqueConstraintViolationException.
+     */
+    private const MAX_ATTEMPTS = 3;
+
+    /**
+     * Issue a new ticket on the queue: "last valid code + 1" display code,
+     * waiting status, issued now.
+     *
+     * The queue state is re-read (locked) inside the transaction: a queue
+     * deactivated after the caller loaded its instance is still rejected.
+     *
+     * @throws InvalidArgumentException when priority is negative
+     * @throws InactiveQueueException when the queue is missing or inactive
+     * @throws UniqueConstraintViolationException when code allocation keeps colliding
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be zero or higher.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel): Ticket {
+                    $locked = Queue::query()
+                        ->whereKey($queue->getKey())
+                        ->lockForUpdate()
+                        ->first();
+
+                    if ($locked === null || ! $locked->is_active) {
+                        throw new InactiveQueueException(
+                            $locked === null
+                                ? "Queue [{$queue->getKey()}] no longer exists."
+                                : "Queue [{$locked->getKey()}] is inactive."
+                        );
+                    }
+
+                    return $this->storeTicket($locked, $priority, $channel, Ticket::nextCode($locked->getKey()));
+                });
+            } catch (UniqueConstraintViolationException $exception) {
+                if ($attempt >= self::MAX_ATTEMPTS) {
+                    throw $exception;
+                }
+            }
+        }
+    }
+
+    /**
+     * Persist the new ticket; separated for retry testing under concurrent issuance.
+     */
+    protected function storeTicket(Queue $queue, int $priority, TicketChannel $channel, string $code): Ticket
+    {
+        return $queue->tickets()->create([
+            'code' => $code,
+            'priority' => $priority,
+            'channel' => $channel,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+        ]);
+    }
+}
