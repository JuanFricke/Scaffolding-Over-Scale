+test('appends a user mention on its own line when a valid mention id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => '111222333444555666']);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue failed', 'Worker errored');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return $content === "Queue failed\nWorker errored\n<@111222333444555666>";
+    });
+});
+
+test('omits the mention when the mention id is null or empty', function (?string $mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $mentionId]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue failed', 'Worker errored');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([null, '']);
+
+test('ignores invalid mention ids silently', function (mixed $mentionId) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config(['services.discord.webhook_url' => $url]);
+    config(['services.discord.mention_id' => $mentionId]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Queue failed', 'Worker errored');
+
+    Http::assertSent(fn (Request $request) => ! str_contains($request['content'] ?? '', '<@'));
+})->with([
+    '@everyone',
+    '@here',
+    'abc',
+    '123',
+    "123\n@everyone",
+    "123> \n@everyone",
+    '1234567890123456',
+    '123456789012345678901',
+]);
+
+test('reserves room for the mention when truncating long alerts', function () {
