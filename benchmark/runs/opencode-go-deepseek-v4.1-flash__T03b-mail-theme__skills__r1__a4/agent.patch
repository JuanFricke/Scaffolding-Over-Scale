+
+    $mail = (new VerifyEmail)->toMail($user);
+    $html = (string) $mail->render();
+
+    expect($mail->subject)->toBe('Verifique seu endereço de e-mail')
+        ->and($mail->actionText)->toBe('Verifique o endereço de e-mail')
+        ->and($mail->actionUrl)->toContain('/email/verify/'.$user->id.'/')
+        ->and($html)->toContain('PegaFila')
+        ->toContain('Olá!')
+        ->toContain('Por favor, clique no botão abaixo para verificar seu endereço de e-mail.')
+        ->toContain('#0f7490')
+        ->not->toContain('having trouble clicking');
+});
+
+test('a signed verification link marks the logged in user as verified', function () {
+    Event::fake([Verified::class]);
+
+    $user = User::factory()->unverified()->create();
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1($user->email),
+    ]);
+
+    $response = $this->actingAs($user)->get($url);
+
+    $response->assertRedirect('/');
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeTrue();
+
+    Event::assertDispatched(Verified::class);
+});
+
+test('a signed verification link for another user is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+    $other = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $other->id,
+        'hash' => sha1($other->email),
+    ]);
+
+    $response = $this->actingAs($user)->get($url);
+
+    $response->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
+
+test('a verification link with the wrong hash is forbidden', function () {
+    $user = User::factory()->unverified()->create();
+
+    $url = URL::temporarySignedRoute('verification.verify', now()->addMinutes(60), [
+        'id' => $user->id,
+        'hash' => sha1('someone-else@example.com'),
+    ]);
+
+    $response = $this->actingAs($user)->get($url);
+
+    $response->assertForbidden();
+
+    expect($user->fresh()->hasVerifiedEmail())->toBeFalse();
+});
