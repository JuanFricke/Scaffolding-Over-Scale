diff --git a/tests/Feature/PasswordResetTest.php b/tests/Feature/PasswordResetTest.php
new file mode 100644
index 0000000..1799861
--- /dev/null
+++ b/tests/Feature/PasswordResetTest.php
@@ -0,0 +1,135 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Events\PasswordReset;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Hash;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Str;
+
+uses(RefreshDatabase::class);
+
+test('the forgot password page renders the request form', function () {
+    $response = $this->get(route('password.request'));
+
+    $response
+        ->assertOk()
+        ->assertViewIs('auth.forgot-password')
+        ->assertSee('name="email"', false)
+        ->assertSee('action="'.route('password.email').'"', false);
+});
+
+test('the forgot password request validates the email address', function () {
+    Notification::fake();
+
+    $response = $this->from('/forgot-password')->post(route('password.email'), [
+        'email' => 'not-an-email',
+    ]);
+
+    $response->assertRedirect('/forgot-password')->assertSessionHasErrors('email');
+
+    Notification::assertNothingSent();
+});
+
+test('the reset link response never reveals whether an account exists', function () {
+    Notification::fake();
+
+    $response = $this->from('/forgot-password')->post(route('password.email'), [
+        'email' => 'missing@example.com',
+    ]);
+
+    $response
+        ->assertRedirect('/forgot-password')
+        ->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertNothingSent();
+});
+
+test('the reset link is sent to an existing account', function () {
+    Notification::fake();
+
+    $user = User::factory()->create();
+
+    $response = $this->post(route('password.email'), [
+        'email' => $user->email,
+    ]);
+
+    $response->assertSessionHas('status', __('passwords.sent'));
+
+    Notification::assertSentTo($user, ResetPassword::class);
+});
+
+test('the reset password page renders a single email field for the token', function () {
+    $response = $this->get(route('password.reset', [
+        'token' => 'a-token',
+        'email' => 'person@example.com',
+    ]));
+
+    $response
+        ->assertOk()
+        ->assertViewIs('auth.reset-password')
+        ->assertSee('name="token"', false)
+        ->assertSee('value="a-token"', false)
+        ->assertSee('name="email"', false)
+        ->assertSee('value="person@example.com"', false)
+        ->assertSee('name="password"', false)
+        ->assertSee('name="password_confirmation"', false);
+});
+
+test('a valid reset updates the password and rotates the remember token', function () {
+    Event::fake([PasswordReset::class]);
+
+    $user = User::factory()->create([
+        'remember_token' => Str::random(10),
+    ]);
+    $oldRememberToken = $user->remember_token;
+    $token = Password::broker()->createToken($user);
+
+    $response = $this->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPassword1',
+        'password_confirmation' => 'NewPassword1',
+    ]);
+
+    $response
+        ->assertRedirect('/')
+        ->assertSessionHas('status', __('passwords.reset'));
+
+    $user->refresh();
+
+    expect(Hash::check('NewPassword1', $user->password))->toBeTrue()
+        ->and($user->remember_token)->not->toBe($oldRememberToken);
+
+    Event::assertDispatched(PasswordReset::class);
+});
+
+test('the reset password requires a strong confirmed password', function () {
+    $user = User::factory()->create();
+    $token = Password::broker()->createToken($user);
+
+    $response = $this->from('/reset-password/'.$token)->post(route('password.update'), [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'short',
+        'password_confirmation' => 'different',
+    ]);
+
+    $response->assertRedirect('/reset-password/'.$token)->assertSessionHasErrors('password');
+});
+
+test('an invalid reset token is rejected', function () {
+    $user = User::factory()->create();
+
+    $response = $this->from('/reset-password/bad-token')->post(route('password.update'), [
+        'token' => 'bad-token',
+        'email' => $user->email,
+        'password' => 'NewPassword1',
+        'password_confirmation' => 'NewPassword1',
+    ]);
+
+    $response->assertRedirect('/reset-password/bad-token')->assertSessionHasErrors('email');
+});
