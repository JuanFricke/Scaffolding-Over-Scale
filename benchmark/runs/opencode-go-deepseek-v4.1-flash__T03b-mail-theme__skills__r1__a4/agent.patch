+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Support\Facades\File;
+
+test('the application speaks brazilian portuguese by default', function () {
+    expect(config('app.name'))->toBe('PegaFila')
+        ->and(config('app.locale'))->toBe('pt_BR')
+        ->and(config('app.fallback_locale'))->toBe('en');
+});
+
+test('markdown mail uses the pegafila theme with the brand color', function () {
+    expect(config('mail.markdown.theme'))->toBe('pegafila');
+
+    $theme = resource_path('views/vendor/mail/html/themes/pegafila.css');
+
+    expect(File::exists($theme))->toBeTrue()
+        ->and(File::get($theme))->toContain('#0f7490');
+});
+
+test('the reset password mail is translated and carries the brand color', function () {
