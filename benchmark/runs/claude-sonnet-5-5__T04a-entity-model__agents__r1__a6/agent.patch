@@ -0,0 +1,162 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity factory builds a named entity with a unique slug', function () {
+    $a = Entity::factory()->create();
+    $b = Entity::factory()->create();
+
+    expect($a->name)->not->toBeEmpty()
+        ->and($a->slug)->not->toBe($b->slug);
+});
+
+test('entity is routed by slug and soft deleted', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->getRouteKeyName())->toBe('slug');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('entity slug is unique at the database level', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+
+    Entity::factory()->create(['slug' => 'acme']);
+})->throws(QueryException::class);
+
+test('role enum exposes the manageable roles', function () {
+    expect(UserRole::Owner->value)->toBe('owner')
+        ->and(UserRole::Admin->value)->toBe('admin')
+        ->and(UserRole::Employee->value)->toBe('employee')
+        ->and(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('membership factory creates entity and user with the employee role', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->role)->toBe(UserRole::Employee);
+});
+
+test('membership factory states set the role', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('role defaults to employee in the database', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+
+    $id = EntityMembership::query()->insertGetId([
+        'entity_id' => $entity->id,
+        'user_id' => $user->id,
+    ]);
+
+    expect(EntityMembership::find($id)->role)->toBe(UserRole::Employee);
+});
+
+test('membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('entity relations expose memberships, users and the owner', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->owner()->first())->toBeNull();
+
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+    EntityMembership::factory()->owner()->create();
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users->pluck('id')->sort()->values()->all())
+        ->toBe(collect([$owner->user_id, $employee->user_id])->sort()->values()->all())
+        ->and($entity->owner()->first()->is($owner))->toBeTrue();
+});
+
+test('user relations and membershipFor', function () {
+    $membership = EntityMembership::factory()->admin()->create();
+    $user = $membership->user;
+
+    expect($user->memberships)->toHaveCount(1)
+        ->and($user->entities->first()->is($membership->entity))->toBeTrue()
+        ->and($user->membershipFor($membership->entity_id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor($membership->entity_id + 1))->toBeNull();
+});
+
+test('a user can only join an entity once', function () {
+    $membership = EntityMembership::factory()->create();
+
+    EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]);
+})->throws(QueryException::class);
+
+test('the database rejects a second owner for the same entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    EntityMembership::factory()->owner()->for($entity)->create();
+})->throws(QueryException::class);
+
+test('the database accepts one owner per entity and many non-owners', function () {
+    $a = Entity::factory()->create();
+    $b = Entity::factory()->create();
+
+    EntityMembership::factory()->owner()->for($a)->create();
+    EntityMembership::factory()->owner()->for($b)->create();
+    EntityMembership::factory()->admin()->count(2)->for($a)->create();
+    EntityMembership::factory()->employee()->count(3)->for($a)->create();
+
+    expect(EntityMembership::query()->count())->toBe(7);
+});
+
+test('owner_seq is generated from the role', function () {
+    $owner = EntityMembership::factory()->owner()->create();
+    $admin = EntityMembership::factory()->admin()->create();
+
+    $seq = fn (EntityMembership $m) => EntityMembership::query()
+        ->selectRaw('owner_seq')->whereKey($m->id)->value('owner_seq');
+
+    expect($seq($owner))->toBe(1)
+        ->and($seq($admin))->toBeNull();
+});
+
+test('deleting an entity row cascades to memberships', function () {
+    $membership = EntityMembership::factory()->owner()->create();
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::query()->count())->toBe(0);
+});
+
+test('schema has the named indexes', function () {
+    $names = fn (string $table) => collect(Schema::getIndexes($table))->pluck('name')->all();
+
+    expect($names('entities'))->toContain('entities_slug_unique')
+        ->and($names('entity_memberships'))->toContain(
+            'entity_memberships_entity_user_unique',
+            'entity_memberships_one_owner',
+        );
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..e063dda
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,95 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function entityWithRoles(): array
+{
+    $entity = Entity::factory()->create();
+
+    return [
+        $entity,
+        'owner' => EntityMembership::factory()->owner()->for($entity)->create(),
+        'admin' => EntityMembership::factory()->admin()->for($entity)->create(),
+        'employee' => EntityMembership::factory()->employee()->for($entity)->create(),
+        'stranger' => User::factory()->create(),
+    ];
+}
+
+test('entity policy', function (string $who, array $expected) {
+    $set = entityWithRoles();
+    $entity = $set[0];
+    $user = $set[$who] instanceof User ? $set[$who] : $set[$who]->user;
+    $policy = new EntityPolicy;
+
+    expect($policy->create($user))->toBeTrue()
+        ->and($policy->view($user, $entity))->toBe($expected['view'])
+        ->and($policy->update($user, $entity))->toBe($expected['update'])
+        ->and($policy->delete($user, $entity))->toBe($expected['delete'])
+        ->and($policy->manageSettings($user, $entity))->toBe($expected['settings']);
+})->with([
+    'owner' => ['owner', ['view' => true, 'update' => true, 'delete' => true, 'settings' => true]],
+    'admin' => ['admin', ['view' => true, 'update' => true, 'delete' => true, 'settings' => false]],
+    'employee' => ['employee', ['view' => true, 'update' => false, 'delete' => false, 'settings' => false]],
+    'stranger' => ['stranger', ['view' => false, 'update' => false, 'delete' => false, 'settings' => false]],
+]);
+
+test('entity policy is discovered by the gate', function () {
+    $set = entityWithRoles();
+
+    expect(Gate::forUser($set['owner']->user)->allows('manageSettings', $set[0]))->toBeTrue()
+        ->and(Gate::forUser($set['admin']->user)->allows('manageSettings', $set[0]))->toBeFalse()
+        ->and(Gate::forUser($set['admin']->user)->allows('assignRole', $set['employee']))->toBeTrue();
+});
+
+test('membership policy view and assignRole', function (string $who, bool $view, bool $assign) {
+    $set = entityWithRoles();
+    $user = $set[$who] instanceof User ? $set[$who] : $set[$who]->user;
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($user, $set['employee']))->toBe($view)
+        ->and($policy->assignRole($user, $set['employee']))->toBe($assign);
+})->with([
+    'owner' => ['owner', true, true],
+    'admin' => ['admin', true, true],
+    'employee' => ['employee', true, false],
+    'stranger' => ['stranger', false, false],
+]);
+
+test('membership of another entity grants nothing', function () {
+    $set = entityWithRoles();
+    $other = EntityMembership::factory()->owner()->create();
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($other->user, $set['employee']))->toBeFalse()
+        ->and($policy->assignRole($other->user, $set['employee']))->toBeFalse()
+        ->and($policy->delete($other->user, $set['employee']))->toBeFalse();
+});
+
+test('membership policy delete', function () {
+    $set = entityWithRoles();
+    $policy = new EntityMembershipPolicy;
+    $other = EntityMembership::factory()->employee()->for($set[0])->create();
+
+    // The owner's membership can never be deleted, not even by the owner.
+    expect($policy->delete($set['owner']->user, $set['owner']))->toBeFalse()
+        ->and($policy->delete($set['admin']->user, $set['owner']))->toBeFalse()
+        ->and($policy->delete($set['employee']->user, $set['owner']))->toBeFalse()
+        // Self-removal.
+        ->and($policy->delete($set['employee']->user, $set['employee']))->toBeTrue()
+        ->and($policy->delete($set['admin']->user, $set['admin']))->toBeTrue()
+        // Owner/admin remove others.
+        ->and($policy->delete($set['owner']->user, $set['employee']))->toBeTrue()
+        ->and($policy->delete($set['admin']->user, $set['employee']))->toBeTrue()
+        ->and($policy->delete($set['owner']->user, $set['admin']))->toBeTrue()
+        // Employees cannot remove others; strangers cannot remove anyone.
+        ->and($policy->delete($set['employee']->user, $other))->toBeFalse()
+        ->and($policy->delete($set['stranger'], $other))->toBeFalse();
+});
