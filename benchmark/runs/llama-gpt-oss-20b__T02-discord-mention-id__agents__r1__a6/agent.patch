diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..666ceac 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,35 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $mentionId = $this->getMentionId();
+        $contentWithoutMention = implode("\n", $lines);
+        if ($mentionId !== null) {
+            $mentionLine = "<@{$mentionId}>";
+            $allowedContentLength = self::MaxContentLength - mb_strlen($mentionLine) - 1; // account for newline
+            if ($allowedContentLength < 0) {
+                $allowedContentLength = 0;
+            }
+            $content = mb_substr($contentWithoutMention, 0, $allowedContentLength) . "\n" . $mentionLine;
+        } else {
+            $content = mb_substr($contentWithoutMention, 0, self::MaxContentLength);
+        }
+        return $content;
+    }
+
+    private function getMentionId(): ?string
+    {
+        $id = config('services.discord.mention_id');
+        if (!is_string($id)) {
+            return null;
+        }
+        $trim = trim((string) $id);
+        if ($trim === '') {
+            return null;
+        }
+        if (ctype_digit($trim) && strlen($trim) >= 17 && strlen($trim) <= 20) {
+            return $trim;
+        }
+        return null;
     }
 
     private function safe(string $key, mixed $value): string
