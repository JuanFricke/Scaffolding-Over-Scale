+<?php
+
+namespace App\Policies;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\UserRole;
+use Illuminate\Auth\Access\AuthorizationException;
+
+class QueuePolicy
+{
+    /**
+     * @param \App\Models\User $actor
+     */
+{
+    public function create($actor, Entity $entity): bool
+    {
+        $membership = $actor->membershipFor($entity->id);
+        return $membership !== null && in_array($membership->role, [
+            UserRole::Owner,
+            UserRole::Admin,
+        ], true);
+    }
+
+    public function update($actor, Queue $queue): bool
+    {
+        return $this->manageAccess($actor, $queue);
+    }
+
+    public function manageAccess($actor, Queue $queue): bool
+    {
+        $membership = $actor->membershipFor($queue->entity_id);
+        return $membership !== null && in_array($membership->role, [
+            UserRole::Owner,
+            UserRole::Admin,
+        ], true);
+    }
+
+    public function call($actor, Queue $queue): bool
+    {
+        // Managers always allowed
+        $membership = $actor->membershipFor($queue->entity_id);
+        if ($membership !== null && in_array($membership->role, [
+            UserRole::Owner,
+            UserRole::Admin,
+        ], true)) {
+            return true;
+        }
+
+        // Employee with permission
+        $access = QueueAccess::where('entity_membership_id', $membership?->id)
+            ->where('queue_id', $queue->id)
+            ->first();
+
+        if ($access && is_array($access->permissions) && in_array(QueuePermission::Call->value, $access->permissions)) {
+            return true;
+        }
+
+        return false;
+    }
+}
