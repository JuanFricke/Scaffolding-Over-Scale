+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Validation\ValidationException;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Auth\Access\AuthorizationException;
+use App\Models\UserRole;
+
+class SetQueueAccess
+{
+    public function __invoke(EntityMembership $targetMembership, Queue $queue, $actor, array $permissions): void
+    {
+        // Validate permissions array contents
+        $validValues = collect(QueuePermission::cases())->map(fn($c) => $c->value)->toArray();
+        foreach ($permissions as $perm) {
+            if (! is_string($perm) || ! in_array($perm, $validValues, true)) {
+                throw ValidationException::withMessages(['permissions' => ['Invalid permission values.']]);
+            }
+        }
+
+        // Membership and queue must belong to same entity
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages(['target' => ['Membership and queue must belong to the same entity.']]);
+        }
+
+        // Actor must be manager of the queue's entity
+        $actorMembership = $actor->membershipFor($queue->entity_id);
+        if ($actorMembership === null || !in_array($actorMembership->role, [
+                UserRole::Owner,
+                UserRole::Admin,
+            ], true)) {
+            throw new AuthorizationException('Not a manager of this entity.');
+        }
+
+        $existing = QueueAccess::where('entity_membership_id', $targetMembership->id)
+            ->where('queue_id', $queue->id)
+            ->first();
+
+        if (empty($permissions)) {
+            // Revoke
+            if ($existing) {
+                $existing->delete();
+                Log::channel('audit')->info('queue.access.revoked', [
+                    'actor_id' => $actor->id,
+                    'queue_id' => $queue->id,
+                    'entity_membership_id' => $targetMembership->id,
+                ]);
+            }
+            return;
+        }
+
+        if ($existing) {
+            $existing->update(['permissions' => $permissions]);
+            Log::channel('audit')->info('queue.access.granted', [
+                'actor_id' => $actor->id,
+                'queue_id' => $queue->id,
+                'entity_membership_id' => $targetMembership->id,
+            ]);
+        } else {
+            QueueAccess::create([
+                'entity_membership_id' => $targetMembership->id,
+                'queue_id' => $queue->id,
+                'permissions' => $permissions,
+            ]);
+            Log::channel('audit')->info('queue.access.granted', [
+                'actor_id' => $actor->id,
+                'queue_id' => $queue->id,
+                'entity_membership_id' => $targetMembership->id,
+            ]);
+        }
+    }
+}
