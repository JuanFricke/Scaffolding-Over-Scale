+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\Queue;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Illuminate\Database\QueryException;
+
+class UpdateQueue
+{
+    public function __invoke(Queue $queue, $actor, ?string $name = null, ?string $slug = null, ?bool $isActive = null): Queue
+    {
+        $data = [];
+
+        if ($name !== null) {
+            $trimmed = trim($name);
+            if ($trimmed === '' || strlen($trimmed) > 255) {
+                throw ValidationException::withMessages(['name' => ['Name must be between 1 and 255 characters.']]);
+            }
+            $data['name'] = $trimmed;
+        }
+
+        if ($slug !== null) {
+            $slugVal = Str::slug(trim($slug));
+            if ($slugVal === '' || strlen($slugVal) > 255) {
+                throw ValidationException::withMessages(['slug' => ['Slug must be between 1 and 255 characters.']]);
+            }
+            $data['slug'] = $slugVal;
+        }
+
+        if ($isActive !== null) {
+            $data['is_active'] = $isActive;
+        }
+
+        if (empty($data)) {
+            return $queue;
+        }
+
+        try {
+            $queue->update($data);
+            return $queue;
+        } catch (QueryException $e) {
+            if ($this->isUniqueViolation($e)) {
+                throw ValidationException::withMessages(['slug' => ['The slug has already been taken.']]);
+            }
+            throw $e;
+        }
+    }
+
+    private function isUniqueViolation(QueryException $e): bool
+    {
+        return $e->errorInfo[0] === '23000' || str_contains($e->getMessage(), 'UNIQUE') || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
