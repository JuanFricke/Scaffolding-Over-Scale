@@ -0,0 +1,360 @@
+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+/**
+ * Waiting ticket issued `$minutesAgo` minutes ago (larger = older).
+ */
+function waitingTicketFor(Queue $queue, int $priority, int $minutesAgo): Ticket
+{
+    return Ticket::factory()->for($queue)->create([
+        'priority' => $priority,
+        'issued_at' => now()->subMinutes($minutesAgo),
+    ]);
+}
+
+/**
+ * Already called ticket; `$calledMinutesAgo` orders the call history (larger = older).
+ */
+function calledTicketFor(Queue $queue, int $priority, int $calledMinutesAgo): Ticket
+{
+    return Ticket::factory()->for($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'issued_at' => now()->subHours(5),
+        'called_at' => now()->subMinutes($calledMinutesAgo),
+    ]);
+}
+
+it('calls the oldest normal ticket when there are no priority tickets', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $older = waitingTicketFor($queue, 0, 10);
+    waitingTicketFor($queue, 0, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($older))->toBeTrue();
+});
+
+it('calls a priority ticket before an older normal ticket', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicketFor($queue, 0, 10);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('calls the higher priority value first', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicketFor($queue, 10, 10);
+    $highest = waitingTicketFor($queue, 20, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($highest))->toBeTrue();
+});
+
+it('breaks priority ties by oldest issued_at then lowest id', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $newer = waitingTicketFor($queue, 10, 1);
+    $oldest = waitingTicketFor($queue, 10, 9);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($oldest))->toBeTrue();
+    expect((new CallNextTicket)($queue, $attendant)->is($newer))->toBeTrue();
+
+    // Same issued_at: lowest id wins.
+    $sameTime = now()->subMinutes(5);
+    $first = Ticket::factory()->for($queue)->create(['priority' => 0, 'issued_at' => $sameTime]);
+    $second = Ticket::factory()->for($queue)->create(['priority' => 0, 'issued_at' => $sameTime]);
+
+    expect((new CallNextTicket)($queue, $attendant, CallMode::NormalOnly)->is($first))->toBeTrue();
+    expect((new CallNextTicket)($queue, $attendant, CallMode::NormalOnly)->is($second))->toBeTrue();
+});
+
+it('never calls tickets of other queues', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $other = Queue::factory()->create(['is_active' => true]);
+    waitingTicketFor($other, 20, 30);
+    $own = waitingTicketFor($queue, 0, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($own))->toBeTrue()
+        ->and($other->tickets()->where('status', TicketStatus::Waiting)->count())->toBe(1);
+});
+
+it('never calls an already called ticket again', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $called = calledTicketFor($queue, 20, 1);
+    $waiting = waitingTicketFor($queue, 0, 1);
+
+    $result = (new CallNextTicket)($queue, $attendant);
+
+    expect($result->is($waiting))->toBeTrue()
+        ->and($called->fresh()->called_by_user_id)->toBeNull();
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('marks the winner as called and returns the updated ticket', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $ticket = waitingTicketFor($queue, 0, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called)
+        ->toBeInstanceOf(Ticket::class)
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($attendant->id)
+        ->called_at->not->toBeNull();
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($attendant->id)
+        ->called_at->not->toBeNull()
+        ->priority->toBe(0)
+        ->code->toBe($ticket->code);
+});
+
+it('uses the full ordering by default', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicketFor($queue, 0, 10);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('rejects calling from an inactive queue and changes nothing', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+    $ticket = waitingTicketFor($queue, 0, 1);
+
+    $queue->update(['is_active' => false]);
+
+    expect(fn () => (new CallNextTicket)($stale, $attendant))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Waiting)
+        ->called_at->toBeNull()
+        ->called_by_user_id->toBeNull();
+});
+
+it('throws when the queue has no waiting tickets', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('priority_only calls only priority tickets', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicketFor($queue, 0, 30);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('priority_only throws when only normal tickets are waiting', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $normal = waitingTicketFor($queue, 0, 1);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($normal->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('priority_only ignores the fairness rule', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicketFor($queue, 10, 3);
+    calledTicketFor($queue, 10, 2);
+    calledTicketFor($queue, 10, 1);
+    waitingTicketFor($queue, 0, 30);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('normal_only calls the oldest normal ticket and ignores priority tickets', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicketFor($queue, 20, 60);
+    $newerNormal = waitingTicketFor($queue, 0, 1);
+    $olderNormal = waitingTicketFor($queue, 0, 5);
+
+    expect((new CallNextTicket)($queue, $attendant, CallMode::NormalOnly)->is($olderNormal))->toBeTrue();
+    expect((new CallNextTicket)($queue, $attendant, CallMode::NormalOnly)->is($newerNormal))->toBeTrue();
+});
+
+it('normal_only throws when only priority tickets are waiting', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('normal_only ignores the fairness rule', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicketFor($queue, 10, 3);
+    calledTicketFor($queue, 10, 2);
+    calledTicketFor($queue, 10, 1);
+    $normal = waitingTicketFor($queue, 0, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant, CallMode::NormalOnly);
+
+    expect($called->is($normal))->toBeTrue();
+});
+
+it('forces a normal call after 3 consecutive priority calls', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicketFor($queue, 10, 3);
+    calledTicketFor($queue, 20, 2);
+    calledTicketFor($queue, 10, 1);
+    waitingTicketFor($queue, 20, 30);
+    $normal = waitingTicketFor($queue, 0, 5);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($normal))->toBeTrue();
+});
+
+it('keeps calling priority tickets when no normal ticket is waiting', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicketFor($queue, 10, 3);
+    calledTicketFor($queue, 10, 2);
+    calledTicketFor($queue, 10, 1);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('does not force a normal call when fewer than 3 calls happened', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicketFor($queue, 10, 2);
+    calledTicketFor($queue, 10, 1);
+    waitingTicketFor($queue, 0, 30);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('resets the priority streak after a normal call', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    calledTicketFor($queue, 10, 4);
+    calledTicketFor($queue, 0, 3);
+    calledTicketFor($queue, 10, 2);
+    calledTicketFor($queue, 10, 1);
+    waitingTicketFor($queue, 0, 30);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('counts priority_only and normal_only calls in the fairness history', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $priorities = [
+        waitingTicketFor($queue, 10, 10),
+        waitingTicketFor($queue, 10, 9),
+        waitingTicketFor($queue, 10, 8),
+        waitingTicketFor($queue, 10, 7),
+    ];
+    $normal = waitingTicketFor($queue, 0, 30);
+
+    expect((new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly)->is($priorities[0]))->toBeTrue();
+    expect((new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly)->is($priorities[1]))->toBeTrue();
+    expect((new CallNextTicket)($queue, $attendant, CallMode::PriorityOnly)->is($priorities[2]))->toBeTrue();
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($normal))->toBeTrue();
+});
+
+it('only looks at the history of the same queue for fairness', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $other = Queue::factory()->create(['is_active' => true]);
+    calledTicketFor($other, 10, 3);
+    calledTicketFor($other, 10, 2);
+    calledTicketFor($other, 10, 1);
+    waitingTicketFor($queue, 0, 30);
+    $priority = waitingTicketFor($queue, 10, 1);
+
+    $called = (new CallNextTicket)($queue, $attendant);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('exactly-once: a ticket cannot be called twice', function () {
+    $attendant = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    waitingTicketFor($queue, 0, 1);
+
+    (new CallNextTicket)($queue, $attendant);
+
+    expect(fn () => (new CallNextTicket)($queue, $attendant))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('does not select a ticket already called through Ticket::call()', function () {
+    $attendant = User::factory()->create();
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($attendant)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create(['is_active' => true]);
+    $taken = waitingTicketFor($queue, 10, 10);
+    $remaining = waitingTicketFor($queue, 10, 1);
+
+    $taken->call($attendant);
+
+    expect((new CallNextTicket)($queue, $attendant)->is($remaining))->toBeTrue();
+});
