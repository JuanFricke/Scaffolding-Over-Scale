+<?php
+
+namespace App\Enums;
+
+enum CallMode: string
+{
+    /** Full ordering (priority, age, id) with the 3-priority fairness rule. */
+    case Any = 'any';
+
+    /** Only priority tickets (priority > 0); fairness does not apply. */
+    case PriorityOnly = 'priority_only';
+
+    /** Only normal tickets (priority = 0); fairness does not apply. */
+    case NormalOnly = 'normal_only';
+}
