+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * A normal ticket may not wait behind more than this many consecutive priority calls.
+     */
+    private const MAX_CONSECUTIVE_PRIORITY_CALLS = 3;
+
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Queue-row lock serializes calls with issuance and deactivation, so the
+            // fairness history read below cannot change while this call is in progress.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            $eligible = $this->eligibleTickets($lockedQueue->id, $mode);
+            $skipped = [];
+
+            while (true) {
+                $candidate = (clone $eligible)
+                    ->whereNotIn('id', $skipped)
+                    ->first();
+
+                if ($candidate === null) {
+                    throw new NoWaitingTicketsException('No eligible waiting ticket to call.');
+                }
+
+                // Ticket::call() does not take the queue lock, so the candidate may have been
+                // called after it was read. Re-check its status under a row lock.
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket?->status === TicketStatus::Waiting) {
+                    break;
+                }
+
+                $skipped[] = $candidate->id;
+            }
+
+            $ticket->status = TicketStatus::Called;
+            $ticket->called_at = now();
+            $ticket->called_by_user_id = $calledBy->id;
+            $ticket->save();
+
+            return $ticket;
+        });
+    }
+
+    /**
+     * Waiting tickets of the queue for the mode, in call order.
+     *
+     * @return Builder<Ticket>
+     */
+    private function eligibleTickets(int $queueId, CallMode $mode): Builder
+    {
+        $query = $this->waitingTickets($queueId);
+
+        $query = match ($mode) {
+            CallMode::PriorityOnly => $query->where('priority', '>', 0),
+            CallMode::NormalOnly => $query->where('priority', 0),
+            CallMode::Any => $this->mustCallNormal($queueId)
+                ? $query->where('priority', 0)
+                : $query,
+        };
+
+        return $query
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+    }
+
+    /**
+     * True when the last calls of the queue were all priority tickets and a normal ticket is waiting.
+     */
+    private function mustCallNormal(int $queueId): bool
+    {
+        $lastCalls = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::MAX_CONSECUTIVE_PRIORITY_CALLS)
+            ->get();
+
+        if ($lastCalls->count() < self::MAX_CONSECUTIVE_PRIORITY_CALLS) {
+            return false;
+        }
+
+        if (! $lastCalls->every(fn (Ticket $ticket): bool => $ticket->priority > 0)) {
+            return false;
+        }
+
+        return $this->waitingTickets($queueId)->where('priority', 0)->exists();
+    }
+
+    /**
+     * @return Builder<Ticket>
+     */
+    private function waitingTickets(int $queueId): Builder
+    {
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting);
+    }
+}
