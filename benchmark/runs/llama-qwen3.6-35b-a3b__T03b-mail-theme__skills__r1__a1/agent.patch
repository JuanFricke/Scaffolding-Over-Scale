diff --git a/tests/Feature/AuthPasswordResetTest.php b/tests/Feature/AuthPasswordResetTest.php
new file mode 100644
index 0000000..0b883b4
--- /dev/null
+++ b/tests/Feature/AuthPasswordResetTest.php
@@ -0,0 +1,201 @@
+<?php
+
+use App\Models\User;
+use Illuminate\Auth\Notifications\ResetPassword;
+use Illuminate\Auth\Notifications\VerifyEmail;
+use Illuminate\Support\Facades\Notification;
+use Illuminate\Support\Facades\Password;
+
+
+test('guests can see the forgot password form', function () {
+    $response = $this->get(route('password.request'));
+
+    $response->assertStatus(200)
+        ->assertSeeText(__('Forgot your password?'));
+});
+
+test('unauthenticated users cannot see the reset password form without token', function () {
+    $response = $this->get(route('password.reset', ['token' => 'invalid']));
+
+    $response->assertStatus(404);
+});
+
+test('a registered user can request a password reset link', function () {
+    $user = User::factory()->create(['email' => 'janeiro@example.com']);
+
+    $this->post(route('password.email'), ['email' => $user->email])
+        ->assertSessionHasNoErrors()
+        ->assertRedirect(route('password.request'));
+});
+
+test('a non-existent email still returns success (prevent enumeration)', function () {
+    $this->post(route('password.email'), ['email' => 'nobody@example.com'])
+        ->assertSessionHasNoErrors()
+        ->assertRedirect(route('password.request'));
+});
+
+test('requesting a reset link validates email format', function () {
+    $this->post(route('password.email'), ['email' => 'not-an-email'])
+        ->assertSessionHasErrors(['email' => 'O campo e-mail deve ser um endereço de e-mail válido.'])
+        ->assertRedirect();
+});
+
+test('a user can see the reset password form with a valid token', function () {
+    $user = User::factory()->create(['email' => 'fevereiro@example.com']);
+
+    Password::sendResetLink([
+        'email' => $user->email,
+    ]);
+
+    $token = Password::token($user);
+
+    $this->get(route('password.reset', ['token' => $token]))
+        ->assertStatus(200)
+        ->assertSee($user->email)
+        ->assertSeeText(__('Reset Password'));
+});
+
+test('a user can reset their password with a valid token', function () {
+    $user = User::factory()->create([
+        'email' => 'marco@example.com',
+        'password' => bcrypt('old-password'),
+    ]);
+
+    Password::sendResetLink([
+        'email' => $user->email,
+    ]);
+
+    $token = Password::token($user);
+
+    $this->post(route('password.update', [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPass1',
+        'password_confirmation' => 'NewPass1',
+    ]))
+        ->assertRedirect(route('password.request'))
+        ->assertSessionHas('status');
+
+    expect($user->fresh()->password)->toBeCostlyBcrypt('NewPass1');
+});
+
+test('a user cannot reset their password with a weak password', function () {
+    $user = User::factory()->create(['email' => 'abril@example.com']);
+
+    Password::sendResetLink([
+        'email' => $user->email,
+    ]);
+
+    $token = Password::token($user);
+
+    $this->post(route('password.update', [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'weak',
+        'password_confirmation' => 'weak',
+    ]))
+        ->assertSessionHasErrors([
+            'password',
+        ]);
+});
+
+test('password reset rotates the remember token', function () {
+    $user = User::factory()->create([
+        'email' => 'maio@example.com',
+        'password' => bcrypt('old-password'),
+        'remember_token' => 'original-token',
+    ]);
+
+    Password::sendResetLink([
+        'email' => $user->email,
+    ]);
+
+    $token = Password::token($user);
+
+    $this->post(route('password.update', [
+        'token' => $token,
+        'email' => $user->email,
+        'password' => 'NewPass1',
+        'password_confirmation' => 'NewPass1',
+    ]));
+
+    expect($user->fresh()->remember_token)->not->toBe('original-token');
+});
+
+test('email verification route requires authentication', function () {
+    $this->get(route('verification.verify', ['id' => 1, 'hash' => 'invalid']))
+        ->assertRedirect('/login');
+});
+
+test('verified users are redirected when visiting verify route', function () {
+    $user = User::factory()->create([
+        'email' => 'junho@example.com',
+        'email_verified_at' => now(),
+    ]);
+
+    $hash = hash('sha256', $user->email);
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->id, 'hash' => $hash]))
+        ->assertRedirect('/?verified=1');
+});
+
+test('users can verify their email with a valid hash', function () {
+    $user = User::factory()->create([
+        'email' => 'julho@example.com',
+        'email_verified_at' => null,
+    ]);
+
+    $hash = hash('sha256', $user->email);
+
+    expect($user->fresh()->email_verified_at)->toBeNull();
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => $user->id, 'hash' => $hash]))
+        ->assertRedirect('/?verified=1');
+
+    expect($user->fresh()->email_verified_at)->not->toBeNull();
+});
+
+test('users cannot verify with wrong id (unauthorized)', function () {
+    $user = User::factory()->create(['email' => 'agosto@example.com']);
+
+    $hash = hash('sha256', $user->email);
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', ['id' => 999, 'hash' => $hash]))
+        ->assertStatus(403);
+});
+
+test('users cannot verify with wrong hash (unauthorized)', function () {
+    $user = User::factory()->create(['email' => 'setembro@example.com']);
+
+    $this->actingAs($user)
+        ->get(route('verification.verify', [
+            'id' => $user->id,
+            'hash' => 'wrong-hash',
+        ]))
+        ->assertStatus(403);
+});
+
+test('ResetPassword notification uses pt-BR subject', function () {
+    $user = User::factory()->create(['email' => 'outubro@example.com']);
+
+    Password::sendResetLink([
+        'email' => $user->email,
+    ]);
+
+    Notification::assertSentTo($user, ResetPassword::class, function ($notification, $channels, $mailable) {
+        return $mailable->render()[0]['subject'] === 'Redefina sua senha';
+    });
+});
+
+test('VerifyEmail notification uses pt-BR subject', function () {
+    $user = User::factory()->create(['email' => 'novembro@example.com']);
+
+    $user->sendEmailVerificationNotification();
+
+    Notification::assertSentTo($user, VerifyEmail::class, function ($notification, $channels, $mailable) {
+        return $mailable->render()[0]['subject'] === 'Verifique seu endereço de e-mail';
+    });
+});
