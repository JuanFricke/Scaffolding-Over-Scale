+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+function memberOf(Entity $entity): User
+{
+    $user = User::factory()->create();
+    EntityMembership::factory()->employee()->create(['entity_id' => $entity->id, 'user_id' => $user->id]);
+
+    return $user;
+}
+
+test('queue factory creates an active queue with its entity and unique slug', function () {
+    $a = Queue::factory()->create();
+    $b = Queue::factory()->create();
+
+    expect($a->entity)->toBeInstanceOf(Entity::class)
+        ->and($a->is_active)->toBeTrue()
+        ->and($a->slug)->not->toBe($b->slug)
+        ->and($a->entity->queues)->toHaveCount(1);
+});
+
+test('queue slug is unique per entity but reusable across entities', function () {
+    $queue = Queue::factory()->create(['slug' => 'main']);
+
+    Queue::factory()->create(['slug' => 'main']);
+    expect(fn () => Queue::factory()->create(['entity_id' => $queue->entity_id, 'slug' => 'main']))
+        ->toThrow(QueryException::class);
+});
+
+test('queue casts labels_i18n to array', function () {
+    $queue = Queue::factory()->create(['labels_i18n' => ['en' => 'Desk', 'pt_BR' => 'Balcão']]);
+
+    expect($queue->fresh()->labels_i18n)->toBe(['en' => 'Desk', 'pt_BR' => 'Balcão']);
+});
+
+test('ticket factory defaults and casts', function () {
+    $ticket = Ticket::factory()->create()->fresh();
+
+    expect($ticket->queue)->toBeInstanceOf(Queue::class)
+        ->and($ticket->status)->toBe(TicketStatus::Waiting)
+        ->and($ticket->channel)->toBe(TicketChannel::Virtual)
+        ->and($ticket->priority)->toBe(0)
+        ->and($ticket->issued_at)->not->toBeNull()
+        ->and($ticket->called_at)->toBeNull()
+        ->and($ticket->code)->toBe('A001');
+});
+
+test('ticket factory forQueue allocates sequential codes and keeps explicit codes', function () {
+    $queue = Queue::factory()->create();
+
+    $one = Ticket::factory()->forQueue($queue)->create();
+    $two = Ticket::factory()->forQueue($queue)->create();
+    $custom = Ticket::factory()->forQueue($queue)->create(['code' => 'A-X']);
+
+    expect([$one->code, $two->code, $custom->code])->toBe(['A001', 'A002', 'A-X']);
+});
+
+test('ticket factory count allocates distinct codes', function () {
+    $queue = Queue::factory()->create();
+
+    $codes = Ticket::factory()->forQueue($queue)->count(3)->create()->pluck('code')->all();
+
+    expect($codes)->toBe(['A001', 'A002', 'A003']);
+});
+
+test('ticket code is unique per queue', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A001']);
+
+    expect(fn () => Ticket::factory()->forQueue($queue)->create(['code' => 'A001']))
+        ->toThrow(QueryException::class);
+
+    Ticket::factory()->create(['code' => 'A001']);
+});
+
+test('nextCode starts at A001 for an empty queue', function () {
+    expect(Ticket::nextCode(Queue::factory()->create()->id))->toBe('A001');
+});
+
+test('nextCode grows beyond 999 and orders by insertion, not by string', function () {
+    $queue = Queue::factory()->create();
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A999']);
+    expect(Ticket::nextCode($queue->id))->toBe('A1000');
+
+    Ticket::factory()->forQueue($queue)->create(['code' => 'A1000']);
+    expect(Ticket::nextCode($queue->id))->toBe('A1001');
+});
+
+test('nextCode does not reuse the number of a deleted middle ticket', function () {
+    $queue = Queue::factory()->create();
+    $tickets = Ticket::factory()->forQueue($queue)->count(3)->create();
+    $tickets[1]->delete();
+
+    expect(Ticket::nextCode($queue->id))->toBe('A004');
+});
+
+test('nextCode skips malformed codes', function () {
+    $only = Queue::factory()->create();
+    Ticket::factory()->forQueue($only)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($only->id))->toBe('A001');
+
+    $mixed = Queue::factory()->create();
+    Ticket::factory()->forQueue($mixed)->create(['code' => 'A001']);
+    Ticket::factory()->forQueue($mixed)->create(['code' => 'A-X']);
+    expect(Ticket::nextCode($mixed->id))->toBe('A002');
+});
+
+test('nextCode is scoped to the queue', function () {
+    Ticket::factory()->forQueue(Queue::factory()->create())->count(2)->create();
+
+    expect(Ticket::nextCode(Queue::factory()->create()->id))->toBe('A001');
+});
+
+test('tickets are write-once except status and call fields', function (string $field, mixed $value) {
+    $ticket = Ticket::factory()->create();
+
+    $ticket->{$field} = $value;
+
+    expect(fn () => $ticket->save())->toThrow(LogicException::class);
+    expect(fn () => Ticket::find($ticket->id)->update([$field => $value]))->toThrow(LogicException::class);
+})->with([
+    ['code', 'A999'],
+    ['priority', 5],
+    ['channel', TicketChannel::Printed],
+    ['issued_at', '2001-01-01 00:00:00'],
+    ['queue_id', 999],
+]);
+
+test('call fields stay writable and saving without changes is fine', function () {
+    $ticket = Ticket::factory()->create();
+    $user = User::factory()->create();
+
+    $ticket->save();
+    $ticket->update(['status' => TicketStatus::Called, 'called_at' => now(), 'called_by_user_id' => $user->id]);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+test('a member can call a waiting ticket once', function () {
+    $ticket = Ticket::factory()->create();
+    $user = memberOf($ticket->queue->entity);
+
+    $ticket->call($user);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Called)
+        ->and($fresh->called_at)->not->toBeNull()
+        ->and($fresh->called_by_user_id)->toBe($user->id)
+        ->and($fresh->calledBy->is($user))->toBeTrue();
+});
+
+test('calling twice throws and keeps the first call', function () {
+    $ticket = Ticket::factory()->create();
+    $first = memberOf($ticket->queue->entity);
+    $second = memberOf($ticket->queue->entity);
+    $ticket->call($first);
+
+    expect(fn () => $ticket->call($second))->toThrow(LogicException::class);
+    expect(fn () => Ticket::find($ticket->id)->call($second))->toThrow(LogicException::class);
+    expect($ticket->fresh()->called_by_user_id)->toBe($first->id);
+});
+
+test('a stale waiting instance cannot call an already called ticket', function () {
+    $ticket = Ticket::factory()->create();
+    $user = memberOf($ticket->queue->entity);
+    $stale = Ticket::find($ticket->id);
+    $ticket->call($user);
+
+    expect(fn () => $stale->call($user))->toThrow(LogicException::class);
+});
+
+test('a non-member cannot call and the ticket is unchanged', function () {
+    $ticket = Ticket::factory()->create();
+    $outsider = memberOf(Entity::factory()->create());
+
+    expect(fn () => $ticket->call($outsider))->toThrow(AuthorizationException::class);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Waiting)
+        ->and($fresh->called_at)->toBeNull()
+        ->and($fresh->called_by_user_id)->toBeNull();
+});
+
+test('deleting a queue cascades to its tickets and a user delete nulls called_by', function () {
+    $ticket = Ticket::factory()->create();
+    $user = memberOf($ticket->queue->entity);
+    $ticket->call($user);
+
+    $user->delete();
+    expect($ticket->fresh()->called_by_user_id)->toBeNull();
+
+    $ticket->queue->delete();
+    expect(Ticket::count())->toBe(0);
+});
+
+test('ticket enums expose the documented values', function () {
+    expect(array_column(TicketStatus::cases(), 'value'))->toBe(['waiting', 'called'])
+        ->and(array_column(TicketChannel::cases(), 'value'))->toBe(['totem', 'virtual', 'printed']);
+});
