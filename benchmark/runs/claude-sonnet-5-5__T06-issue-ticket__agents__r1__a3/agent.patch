@@ -0,0 +1,119 @@
+<?php
+
+namespace App\Models;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use Database\Factories\TicketFactory;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\Eloquent\Attributes\Fillable;
+use Illuminate\Database\Eloquent\Factories\HasFactory;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Database\Eloquent\Relations\BelongsTo;
+use Illuminate\Support\Facades\DB;
+use LogicException;
+
+#[Fillable([
+    'queue_id', 'code', 'priority', 'channel', 'status',
+    'issued_at', 'called_at', 'called_by_user_id',
+])]
+class Ticket extends Model
+{
+    /** @use HasFactory<TicketFactory> */
+    use HasFactory;
+
+    /**
+     * The only attributes that may change after issuance.
+     *
+     * @var list<string>
+     */
+    private const MUTABLE = ['status', 'called_at', 'called_by_user_id', 'updated_at'];
+
+    protected static function booted(): void
+    {
+        static::updating(function (Ticket $ticket) {
+            $frozen = array_diff(array_keys($ticket->getDirty()), self::MUTABLE);
+
+            if ($frozen !== []) {
+                throw new LogicException('A ticket is write-once after issuance; cannot change: '.implode(', ', $frozen).'.');
+            }
+        });
+    }
+
+    /**
+     * Get the attributes that should be cast.
+     *
+     * @return array<string, string>
+     */
+    protected function casts(): array
+    {
+        return [
+            'priority' => 'integer',
+            'channel' => TicketChannel::class,
+            'status' => TicketStatus::class,
+            'issued_at' => 'datetime',
+            'called_at' => 'datetime',
+        ];
+    }
+
+    public function queue(): BelongsTo
+    {
+        return $this->belongsTo(Queue::class);
+    }
+
+    public function calledBy(): BelongsTo
+    {
+        return $this->belongsTo(User::class, 'called_by_user_id');
+    }
+
+    /**
+     * Next display code for a queue: `A` + last valid sequence number + 1,
+     * zero padded to at least 3 digits.
+     *
+     * "Last" is by insertion order (id), so `A999` then `A1000` yields `A1001`.
+     * Codes not matching `A<digits>` are skipped.
+     */
+    public static function nextCode(int $queueId): string
+    {
+        $last = 0;
+
+        foreach (static::query()->where('queue_id', $queueId)->toBase()->lazyByIdDesc(100, 'id') as $row) {
+            if (preg_match('/^A(\d+)$/', $row->code, $m)) {
+                $last = (int) $m[1];
+                break;
+            }
+        }
+
+        return 'A'.str_pad((string) ($last + 1), 3, '0', STR_PAD_LEFT);
+    }
+
+    /**
+     * Call this ticket (exactly once). Only members of the ticket's entity may call.
+     *
+     * @throws AuthorizationException when the user is not a member of the entity
+     * @throws LogicException when the ticket is not waiting
+     */
+    public function call(User $user): void
+    {
+        $entityId = Queue::query()->whereKey($this->queue_id)->value('entity_id');
+
+        if ($entityId === null || ! $user->membershipFor($entityId)) {
+            throw new AuthorizationException('Only members of the ticket\'s entity may call it.');
+        }
+
+        DB::transaction(function () use ($user) {
+            // Lock the row and read status from the database, not the possibly stale model.
+            $status = static::query()->whereKey($this->getKey())->lockForUpdate()->value('status');
+
+            if ($status !== TicketStatus::Waiting) {
+                throw new LogicException('Only a waiting ticket can be called.');
+            }
+
+            $this->forceFill([
+                'status' => TicketStatus::Called,
+                'called_at' => now(),
+                'called_by_user_id' => $user->getKey(),
+            ])->save();
+        });
+    }
+}
