@@ -0,0 +1,56 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+class IssueTicket
+{
+    private const MAX_ATTEMPTS = 5;
+
+    /**
+     * Issue a waiting ticket with the queue's next display code.
+     *
+     * @throws InvalidArgumentException when priority is negative
+     * @throws InactiveQueueException when the queue is inactive in the database
+     */
+    public function __invoke(Queue $queue, int $priority = 0, TicketChannel $channel = TicketChannel::Virtual): Ticket
+    {
+        if ($priority < 0) {
+            throw new InvalidArgumentException('Ticket priority must be >= 0.');
+        }
+
+        for ($attempt = 1; ; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    // Lock + re-read: the passed model may be stale.
+                    $current = Queue::query()->whereKey($queue->getKey())->lockForUpdate()->firstOrFail();
+
+                    if (! $current->is_active) {
+                        throw new InactiveQueueException("Queue {$current->getKey()} is inactive.");
+                    }
+
+                    return Ticket::create([
+                        'queue_id' => $current->getKey(),
+                        'code' => Ticket::nextCode($current->getKey()),
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'status' => TicketStatus::Waiting,
+                        'issued_at' => now(),
+                    ]);
+                });
+            } catch (UniqueConstraintViolationException $e) {
+                if ($attempt >= self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+    }
+}
