diff --git a/.env.example b/.env.example
index 2cf633c..6c0ae6e 100644
--- a/.env.example
+++ b/.env.example
@@ -75,6 +75,7 @@ TELESCOPE_ENABLED=true
 
 # Discord ops alerts (incoming webhook). Empty = no-op. Alerts only — not a log sink.
 DISCORD_WEBHOOK_URL=
+DISCORD_MENTION_ID=
 
 # Hostinger / PegaFila ops (bin/pf) — never commit real secrets.
 # GitHub Actions: store the same key as repository secret HOSTINGER_API
diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..8688f8d 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -66,7 +66,29 @@ private function formatContent(string $title, string $message, array $context):
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $baseContent = implode("\n", $lines);
+
+        $mentionId = config('services.discord.mention_id');
+        $mention = '';
+        if ($mentionId !== null) {
+            $trimmed = trim((string) $mentionId);
+            if ($trimmed !== '' && preg_match('/^\d{17,20}$/', $trimmed)) {
+                $mention = "\n<@{$trimmed}>";
+            }
+        }
+
+        $maxLength = self::MaxContentLength;
+        if ($mention !== '') {
+            $maxBaseLength = $maxLength - strlen($mention);
+            if ($maxBaseLength < 0) {
+                $maxBaseLength = 0;
+            }
+            $content = mb_substr($baseContent, 0, $maxBaseLength) . $mention;
+        } else {
+            $content = mb_substr($baseContent, 0, $maxLength);
+        }
+
+        return $content;
     }
 
     private function safe(string $key, mixed $value): string
