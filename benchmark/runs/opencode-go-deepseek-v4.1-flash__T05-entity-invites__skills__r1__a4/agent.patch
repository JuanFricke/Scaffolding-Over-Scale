diff --git a/tests/Feature/Entity/EntityInviteTest.php b/tests/Feature/Entity/EntityInviteTest.php
new file mode 100644
index 0000000..396a7ca
--- /dev/null
+++ b/tests/Feature/Entity/EntityInviteTest.php
@@ -0,0 +1,93 @@
+<?php
+
+namespace Tests\Feature\Entity;
+
+use App\Mail\EntityInviteMail;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\Queue\ShouldQueue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entity_invites table stores normalized invites with a unique entity e-mail pair', function () {
+    expect(Schema::hasTable('entity_invites'))->toBeTrue()
+        ->and(Schema::hasColumns('entity_invites', [
+            'id', 'entity_id', 'invited_by', 'email', 'role', 'expires_at', 'accepted_at', 'created_at', 'updated_at',
+        ]))->toBeTrue()
+        ->and(Schema::hasIndex('entity_invites', 'entity_invites_entity_id_email_unique'))->toBeTrue();
+});
+
+test('the model normalizes e-mail, casts the role and defaults to a seven day expiry', function () {
+    $entity = Entity::factory()->create();
+    $inviter = User::factory()->create();
+
+    $invite = EntityInvite::create([
+        'entity_id' => $entity->id,
+        'invited_by' => $inviter->id,
+        'email' => '  Mixed.Case@Example.COM ',
+        'role' => UserRole::Admin->value,
+    ]);
+
+    expect($invite->email)->toBe('mixed.case@example.com')
+        ->and($invite->role)->toBe(UserRole::Admin)
+        ->and($invite->expires_at->between(now()->addDays(6), now()->addDays(8)))->toBeTrue()
+        ->and($invite->entity->is($entity))->toBeTrue();
+});
+
+test('the factory can create pending and expired invites', function () {
+    $invite = EntityInvite::factory()->create();
+    $expired = EntityInvite::factory()->expired()->create();
+
+    expect($invite->isPending())->toBeTrue()
+        ->and($invite->role)->toBe(UserRole::Employee)
+        ->and($expired->isExpired())->toBeTrue()
+        ->and($expired->isPending())->toBeFalse();
+});
+
+test('the invite mailable is queued and uses the markdown invite view', function () {
+    app()->setLocale('en');
+
+    $invite = EntityInvite::factory()->create([
+        'email' => 'ana@example.com',
+        'role' => UserRole::Admin->value,
+    ]);
+
+    $mail = new EntityInviteMail($invite);
+
+    expect($mail)->toBeInstanceOf(ShouldQueue::class)
+        ->and($mail->content()->markdown)->toBe('emails.entity-invite')
+        ->and($mail->envelope()->subject)->toBe('You are invited to '.$invite->entity->name);
+
+    $html = (string) $mail->render();
+
+    expect($html)->toContain($invite->entity->name)
+        ->and($html)->toContain('Admin')
+        ->and($html)->toContain('You are invited to join')
+        ->and($html)->toContain('Access the link below to sign in and accept your invite:')
+        ->and($html)->toContain('Sign in to PegaFila')
+        ->and($html)->toContain(route('login'))
+        ->and($html)->toContain($invite->expires_at->toFormattedDateString())
