+<?php
+
+namespace Tests\Feature\Entity;
+
+use App\Livewire\Entity\PendingInvites;
+use App\Models\Entity;
+use App\Models\EntityInvite;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+test('pending invites are matched case-insensitively and listed on the switcher and onboarding', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $entity = Entity::factory()->create(['name' => 'Acme']);
+    EntityInvite::factory()->for($entity)->create(['email' => 'ANA@example.com']);
+
+    $this->actingAs($user)->post(route('entity.pick', $entity->slug));
+
+    $this->actingAs($user)
+        ->withHeaders(['Accept-Language' => 'en'])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSeeText('Pending invites')
+        ->assertSeeText('Acme')
+        ->assertSeeText('Accept')
+        ->assertSeeText('Decline');
+
+    $this->actingAs($user)
+        ->withHeaders(['Accept-Language' => 'pt-BR'])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSeeText('Convites pendentes')
+        ->assertSeeText('Aceitar')
+        ->assertSeeText('Recusar');
+
+    $this->actingAs($user)
+        ->withHeaders(['Accept-Language' => 'en'])
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertSeeText('Pending invites');
+});
+
+test('the onboarding invite section renders no divider when there are no invites', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)
+        ->withHeaders(['Accept-Language' => 'en'])
+        ->get(route('onboarding'))
+        ->assertOk()
+        ->assertDontSee('<hr', false);
+});
+
+test('the invitee accepts an invite and joins with the invited role', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $entity = Entity::factory()->create();
+    $invite = EntityInvite::factory()->for($entity)->create([
+        'email' => 'ANA@example.com',
+        'role' => UserRole::Admin->value,
+    ]);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', $entity->slug));
+
+    $membership = EntityMembership::where('entity_id', $entity->id)->where('user_id', $user->id)->first();
+
+    expect($membership)->not->toBeNull()
+        ->and($membership->role)->toBe(UserRole::Admin)
+        ->and($invite->fresh()->accepted_at)->not->toBeNull()
+        ->and(session('current_entity_id'))->toBe($entity->id);
+});
+
+test('accepting never creates a duplicate membership', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->for($entity)->for($user)->employee()->create();
+    $invite = EntityInvite::factory()->for($entity)->create([
+        'email' => 'ana@example.com',
+        'role' => UserRole::Admin->value,
+    ]);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertRedirect(route('entity.dashboard', $entity->slug));
+
+    expect(EntityMembership::where('entity_id', $entity->id)->where('user_id', $user->id)->count())->toBe(1);
+});
+
+test('a non-invitee cannot accept or decline an invite', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $other = User::factory()->create(['email' => 'other@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => $user->email]);
+
+    $this->actingAs($other);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertForbidden();
+
+    Livewire::test(PendingInvites::class)
+        ->call('decline', $invite->id)
+        ->assertForbidden();
+
+    expect($invite->fresh())->not->toBeNull();
+});
+
+test('an expired invite cannot be accepted and reports an invite error', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->expired()->create(['email' => $user->email]);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasErrors('invite');
+
+    expect(EntityMembership::count())->toBe(0)
+        ->and($invite->fresh()->accepted_at)->toBeNull();
+});
+
+test('accepting an already accepted invite is an idempotent no-op', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create([
+        'email' => $user->email,
+        'accepted_at' => now(),
+    ]);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('accept', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('the invitee can decline an invite', function () {
+    $user = User::factory()->create(['email' => 'ana@example.com']);
+    $invite = EntityInvite::factory()->create(['email' => $user->email]);
+
+    $this->actingAs($user);
+
+    Livewire::test(PendingInvites::class)
+        ->call('decline', $invite->id)
+        ->assertHasNoErrors();
+
+    expect(EntityInvite::whereKey($invite->id)->exists())->toBeFalse();
+});
