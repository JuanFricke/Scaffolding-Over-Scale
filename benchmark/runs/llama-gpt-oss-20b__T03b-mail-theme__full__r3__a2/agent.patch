+<?php
+
+namespace Tests\Feature\Auth;
+
+use App\Models\User;
+use Illuminate\Support\Facades\URL;
+use Tests\TestCase;
+
+class EmailVerificationTest extends TestCase
+{
+    /** @test */
+    public function it_verifies_user_email_and_redirects()
+    {
+        $user = User::factory()->create(['email_verified_at' => null]);
+
+        $signedUrl = URL::signedRoute('verification.verify', [
+            'id' => $user->id,
+            'hash' => sha1($user->getEmailForVerification()),
+        ]);
+
+        $response = $this->actingAs($user)->get($signedUrl);
+
+        $response->assertRedirect('/');
+        $this->assertNotNull($user->fresh()->email_verified_at);
+    }
+
+    /** @test */
+    public function it_returns_403_for_invalid_hash_or_id()
+    {
+        $user = User::factory()->create(['email_verified_at' => null]);
+
+        $invalidSignedUrl = URL::signedRoute('verification.verify', [
+            'id' => $user->id + 1,
+            'hash' => sha1($user->getEmailForVerification()),
+        ]);
+
+        $response = $this->actingAs($user)->get($invalidSignedUrl);
+
+        $response->assertStatus(403);
+    }
+}
