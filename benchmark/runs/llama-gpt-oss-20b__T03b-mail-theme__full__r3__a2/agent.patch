+++ b/tests/Feature/Auth/PasswordResetTest.php
@@ -0,0 +1,68 @@
+<?php
+
+namespace Testseature\Auth;
+
+use App\Models\User;
+use App\Notifications\CustomResetPassword;
+use Illuminate\Support\Facades\Mail;
+use Illuminate\Support\Facades\Password;
+use Illuminate\Support\Facades\Hash;
+use Tests\TestCase;
+
+class PasswordResetTest extends TestCase
+{
+    /** @test */
+    public function it_sends_a_password_reset_link_email_and_stores_status()
+    {
+        Mail::fake();
+
+        $user = User::factory()->create();
+
+        $response = $this->post(route('password.email'), [
+            'email' => $user->email,
+        ]);
+
+        $response->assertRedirect();
+        $response->assertSessionHas('status', __('passwords.sent'));
+
+        Mail::assertSent(CustomResetPassword::class, function ($mail) use ($user) {
+            return $mail->hasTo($user->email) && $mail->subject === __('Reset Password');
+        });
+    }
+
+    /** @test */
+    public function it_does_not_reveal_if_user_not_found()
+    {
+        Mail::fake();
+
+        $email = 'not@exist.com';
+
+        $response = $this->post(route('password.email'), ['email' => $email]);
+
+        $response->assertRedirect();
+        $response->assertSessionHas('status', __('passwords.sent'));
+        Mail::assertNothingSent();
+    }
+
+    /** @test */
+    public function it_resets_password_when_token_is_valid()
+    {
+        Mail::fake();
+
+        $user = User::factory()->create();
+        $token = Password::createToken($user);
+
+        $newPassword = 'NewPass123';
+        $response = $this->post(route('password.update'), [
+            'token' => $token,
+            'email' => $user->email,
+            'password' => $newPassword,
+            'password_confirmation' => $newPassword,
+        ]);
+
+        $response->assertRedirect('/');
+        $response->assertSessionHas('status', __('passwords.reset'));
+
+        $this->assertTrue(Hash::check($newPassword, $user->fresh()->password));
+    }
+}
