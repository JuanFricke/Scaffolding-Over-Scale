+<?php
+
+namespace App\Support;
+
+/**
+ * Backend-owned priority levels for the totem API.
+ *
+ * Single source for GET priorities (label/visual served) and POST ticket
+ * (value validated). Labels/visuals are display-only; ordering uses the
+ * numeric value server-side. Swap this map for a DB table later
+ * (entity_priorities) without changing the API contract — enables dynamic
+ * priorities without Flutter changes.
+ *
+ * Open question per docs/api/totem.md: exact appearance/visual schema
+ * (color/icon/order set) is a placeholder.
+ */
+class TotemPriorities
+{
+    /**
+     * @return list<array{value: int, label: string, visual: array{color: string, icon: string, order: int}}>
+     */
+    public static function all(): array
+    {
+        return [
+            ['value' => 0, 'label' => 'Normal', 'visual' => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1]],
+            ['value' => 10, 'label' => 'Prioritário', 'visual' => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2]],
+            ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => ['color' => '#EF6C00', 'icon' => 'star', 'order' => 3]],
+        ];
+    }
+
+    /**
+     * @return list<int>
+     */
+    public static function values(): array
+    {
+        return array_column(self::all(), 'value');
+    }
+
+    public static function labelFor(int $value): ?string
+    {
+        foreach (self::all() as $priority) {
+            if ($priority['value'] === $value) {
+                return $priority['label'];
+            }
+        }
+
+        return null;
+    }
+}
