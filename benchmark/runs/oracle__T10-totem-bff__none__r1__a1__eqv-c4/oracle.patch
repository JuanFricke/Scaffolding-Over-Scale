@@ -0,0 +1,86 @@
+<?php
+
+namespace App\Actions;
+
+use App\Exceptions\InvalidPairingCodeException;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Resolves a 6-digit pairing code into a totem + JWT.
+ *
+ * Code is the preset's own cryptographically random 6 digits, single-use,
+ * 10-min TTL, consumed atomically. Unknown/expired/consumed/inactive all
+ * throw the same exception to avoid an oracle.
+ *
+ * TODO(billing): enforce subscription here when billing lands (currently
+ * no billing system; entity_suspended reserved in contract but never sent).
+ */
+class PairTotem
+{
+    /**
+     * @return array{token: string, totem: Totem, preset: TotemPreset}
+     *
+     * @throws InvalidPairingCodeException
+     */
+    public function __invoke(string $code): array
+    {
+        try {
+            return DB::transaction(function () use ($code): array {
+                $preset = TotemPreset::query()
+                    ->where('login_code', $code)
+                    ->lockForUpdate()
+                    ->first();
+
+                if (! $preset || ! $this->isUsable($preset)) {
+                    throw new InvalidPairingCodeException('Invalid pairing code.');
+                }
+
+                $preset->login_code_consumed_at = now();
+                $preset->save();
+
+                $totem = Totem::query()->create([
+                    'entity_id' => $preset->entity_id,
+                    'name' => $preset->name.' totem',
+                    'is_active' => true,
+                    'last_seen_at' => now(),
+                ]);
+
+                $queueIds = $preset->queues()->pluck('queues.id')->all();
+                $token = TotemJwt::issue($totem, $preset, $queueIds);
+
+                Log::channel('audit')->info('totem.pairing.success', [
+                    'preset_id' => $preset->id,
+                    'entity_id' => $preset->entity_id,
+                    'totem_id' => $totem->id,
+                ]);
+
+                return ['token' => $token, 'totem' => $totem, 'preset' => $preset];
+            });
+        } catch (InvalidPairingCodeException $e) {
+            Log::channel('audit')->info('totem.pairing.failure', ['code_hint' => substr($code, 0, 2).'****']);
+
+            throw $e;
+        }
+    }
+
+    private function isUsable(TotemPreset $preset): bool
+    {
+        if (! $preset->is_active) {
+            return false;
+        }
+
+        if ($preset->login_code_consumed_at !== null) {
+            return false;
+        }
+
+        if ($preset->login_code_expires_at === null || $preset->login_code_expires_at->isPast()) {
+            return false;
+        }
+
+        return true;
+    }
+}
