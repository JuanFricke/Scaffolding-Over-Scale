+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Requests\TotemTicketRequest;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Support\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+
+class TotemTicketController
+{
+    public function store(TotemTicketRequest $request, Entity $entity, string $queue, IssueTicket $issue): JsonResponse
+    {
+        // TODO(billing): block with 403 entity_suspended when billing lands.
+        if ((int) $entity->id !== (int) $request->attributes->get('totem_entity_id')) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $queueModel = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $queueModel) {
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        $allowedIds = array_map('intval', (array) $request->attributes->get('totem_queue_ids', []));
+
+        if (! in_array((int) $queueModel->id, $allowedIds, true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $priority = (int) $request->validated()['priority'];
+
+        try {
+            // Reuses domain issuance path: no duplicated queue rules. Transactional
+            // with server-selected code; unique(queue_id, code) retry inside.
+            $ticket = $issue($queueModel, $priority, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => ['value' => $ticket->priority, 'label' => TotemPriorities::labelFor($ticket->priority)],
+            'issued_at' => $ticket->issued_at->toIso8601String(),
+        ], 201);
+    }
+}
diff --git a/app/Http/Middleware/TotemAuthenticate.php b/app/Http/Middleware/TotemAuthenticate.php
new file mode 100644
index 0000000..ad2ed71
--- /dev/null
+++ b/app/Http/Middleware/TotemAuthenticate.php
@@ -0,0 +1,70 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Support\TotemJwt;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Validates the totem JWT. JWT scope always wins over path values.
+ *
+ * Attaches to request attributes: totem, preset, totem_entity_id,
+ * totem_preset_id, totem_queue_ids. Controllers validate {entity}/{queue}
+ * slugs against these claims (mismatch → 403).
+ *
+ * Queue scope is the intersection of the JWT claim with the live preset
+ * join, so removing a queue from the preset takes effect immediately
+ * instead of lingering until token expiry.
+ *
+ * Revocation model A: totems.is_active=false rejects everywhere (401).
+ */
+class TotemAuthenticate
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $token = $request->bearerToken();
+
+        if (! $token) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        try {
+            $claims = TotemJwt::decode($token);
+        } catch (\Throwable) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        $totem = Totem::query()->find($claims['totem_id'] ?? null);
+        $preset = TotemPreset::query()->find($claims['preset_id'] ?? null);
+
+        if (! $totem || ! $totem->is_active || ! $preset || ! $preset->is_active) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        if ((int) ($claims['entity_id'] ?? 0) !== (int) $totem->entity_id
+            || (int) $preset->entity_id !== (int) $totem->entity_id) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        // Quiet timestamp-only touch: no updated_at bump, no model events,
+        // so totem polling does not amplify writes or contend on the row.
+        Totem::query()->whereKey($totem->id)->update(['last_seen_at' => now()]);
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('preset', $preset);
+        $request->attributes->set('totem_entity_id', $totem->entity_id);
+        $request->attributes->set('totem_preset_id', $preset->id);
+
+        // Fresh join wins over the stale claim: a queue removed from the
+        // preset stops authorizing immediately (re-pair overlap kept).
+        $freshQueueIds = $preset->queues()->where('queues.entity_id', $totem->entity_id)->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+        $claimQueueIds = array_map('intval', (array) ($claims['queues'] ?? []));
+        $request->attributes->set('totem_queue_ids', array_values(array_intersect($claimQueueIds, $freshQueueIds)));
+
+        return $next($request);
+    }
+}
