+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Models\Entity;
+use App\Models\TotemPreset;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemQueueController
+{
+    public function index(Request $request, Entity $entity): JsonResponse
+    {
+        if ((int) $entity->id !== (int) $request->attributes->get('totem_entity_id')) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        /** @var TotemPreset $preset */
+        $preset = $request->attributes->get('preset');
+
+        $queues = $preset->queues()
+            ->where('queues.entity_id', $entity->id)
+            ->where('queues.is_active', true)
+            ->orderBy('queues.name')
+            ->get();
+
+        $payload = $queues->values()->map(fn ($queue, $index) => [
+            'slug' => $queue->slug,
+            'label' => $queue->name,
+            'description' => $queue->labels_i18n['description'] ?? null,
+            // Placeholder visual per docs/api/totem.md open question; order = display position.
+            'visual' => ['color' => '#0055FF', 'icon' => 'ticket', 'order' => $index + 1],
+            'is_active' => true,
+        ]);
+
+        return response()->json([
+            'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+            'queues' => $payload,
+        ]);
+    }
+}
