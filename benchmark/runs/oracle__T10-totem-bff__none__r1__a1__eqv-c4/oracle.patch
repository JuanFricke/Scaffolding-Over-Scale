@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Console\Commands;
+
+use App\Actions\GeneratePairingCode;
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\Log;
+
+#[Signature('totem:pairing-code {preset : Totem preset ID}')]
+#[Description('Open a totem pairing window: generate a single-use 6-digit code (10-min TTL)')]
+class TotemPairingCode extends Command
+{
+    /**
+     * Execute the console command.
+     */
+    public function handle(GeneratePairingCode $generate): int
+    {
+        $preset = TotemPreset::query()->find($this->argument('preset'));
+
+        if (! $preset) {
+            $this->error('Totem preset not found.');
+
+            return self::FAILURE;
+        }
+
+        $code = $generate($preset);
+
+        Log::channel('audit')->info('totem.pairing-code.generated', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+        ]);
+
+        $this->info("Pairing code for preset [{$preset->id}] {$preset->name}: {$code}");
+        $this->comment('Single-use, expires in 10 minutes. Regenerating replaces it.');
+
+        return self::SUCCESS;
+    }
+}
