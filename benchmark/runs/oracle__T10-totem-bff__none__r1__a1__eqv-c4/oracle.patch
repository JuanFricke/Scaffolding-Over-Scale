@@ -0,0 +1,39 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Database\QueryException;
+
+/**
+ * Opens (or re-opens) a pairing window for a preset.
+ *
+ * Generates the preset's own cryptographically random 6 digits, 10-min TTL,
+ * single-use. Regenerating replaces the previous code immediately.
+ */
+class GeneratePairingCode
+{
+    public function __invoke(TotemPreset $preset): string
+    {
+        for ($attempt = 0; $attempt < 5; $attempt++) {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+            try {
+                $preset->login_code = $code;
+                $preset->login_code_expires_at = now()->addMinutes(10);
+                $preset->login_code_consumed_at = null;
+                $preset->save();
+
+                return $code;
+            } catch (QueryException $e) {
+                $sqlState = $e->errorInfo[0] ?? '';
+
+                if ($sqlState !== '23000' && ! str_contains($e->getMessage(), 'UNIQUE')) {
+                    throw $e;
+                }
+            }
+        }
+
+        throw new \RuntimeException('Could not generate a unique pairing code.');
+    }
+}
