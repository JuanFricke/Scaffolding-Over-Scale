+<?php
+
+namespace App\Support;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use Illuminate\Support\Str;
+
+/**
+ * Issues and decodes totem JWTs (HS256).
+ *
+ * Claims: totem_id + entity_id + preset_id + queue scope (ids), iat, exp, jti.
+ * Revocation model A: whole-device via totems.is_active (no per-token blocklist).
+ * Re-pair overlap accepted: old JWT stays valid until exp (max 1h).
+ */
+class TotemJwt
+{
+    public static function issue(Totem $totem, TotemPreset $preset, array $queueIds): string
+    {
+        $now = time();
+        $ttl = (int) config('services.totem.jwt_ttl', 3600);
+
+        return JWT::encode([
+            'totem_id' => $totem->id,
+            'entity_id' => $preset->entity_id,
+            'preset_id' => $preset->id,
+            'queues' => array_values($queueIds),
+            'iat' => $now,
+            'exp' => $now + $ttl,
+            'jti' => (string) Str::uuid(),
+        ], self::secret(), 'HS256');
+    }
+
+    /**
+     * @return array<string, mixed>
+     */
+    public static function decode(string $token): array
+    {
+        $decoded = JWT::decode($token, new Key(self::secret(), 'HS256'));
+
+        return (array) $decoded;
+    }
+
+    public static function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret', '');
+
+        if ($secret === '') {
+            throw new \RuntimeException('TOTEM_JWT_SECRET is not configured.');
+        }
+
+        return $secret;
+    }
+
+    public static function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl', 3600);
+    }
+}
