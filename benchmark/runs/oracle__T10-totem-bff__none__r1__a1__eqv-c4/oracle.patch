+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Support\TotemPriorities;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+class TotemPriorityController
+{
+    public function index(Request $request, Entity $entity, string $queue): JsonResponse
+    {
+        if ((int) $entity->id !== (int) $request->attributes->get('totem_entity_id')) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        $queueModel = Queue::query()
+            ->where('entity_id', $entity->id)
+            ->where('slug', $queue)
+            ->first();
+
+        if (! $queueModel) {
+            // Same 404 whether the slug belongs to another entity or nowhere —
+            // never leak other entities' queues.
+            return response()->json(['code' => 'queue_not_found'], 404);
+        }
+
+        $allowedIds = array_map('intval', (array) $request->attributes->get('totem_queue_ids', []));
+
+        if (! in_array((int) $queueModel->id, $allowedIds, true)) {
+            return response()->json(['code' => 'forbidden'], 403);
+        }
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $entity->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => TotemPriorities::all(),
+        ]);
+    }
+}
