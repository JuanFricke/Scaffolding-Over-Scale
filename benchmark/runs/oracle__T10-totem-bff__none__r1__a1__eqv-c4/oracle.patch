+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Exceptions\InvalidPairingCodeException;
+use App\Http\Requests\TotemAuthRequest;
+use App\Support\TotemJwt;
+use Illuminate\Http\JsonResponse;
+
+class TotemAuthController
+{
+    public function store(TotemAuthRequest $request, PairTotem $pair): JsonResponse
+    {
+        // TODO(billing): block with 403 entity_suspended when billing lands.
+        try {
+            $result = $pair($request->validated()['code']);
+        } catch (InvalidPairingCodeException) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        return response()->json([
+            'token' => $result['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => TotemJwt::ttl(),
+            // The totem needs the entity slug for every later call
+            // (GET api/{entity}/queues); the queue endpoint returns the
+            // same pair, so this reveals nothing new.
+            'entity' => [
+                'slug' => $result['preset']->entity->slug,
+                'name' => $result['preset']->entity->name,
+            ],
+        ]);
+    }
+}
