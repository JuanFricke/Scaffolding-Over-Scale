diff --git a/app/Livewire/Entity/Members.php b/app/Livewire/Entity/Members.php
new file mode 100644
index 0000000..49f8e01
--- /dev/null
+++ b/app/Livewire/Entity/Members.php
@@ -0,0 +1,133 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|email|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    /**
+     * Add an existing user to the entity as an employee.
+     */
+    public function addMember(): void
+    {
+        $this->authorize('update', $this->entity);
+
+        $this->validate();
+
+        $user = User::where('email', $this->email)->firstOrFail();
+
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            throw ValidationException::withMessages(['email' => __('ui.member_already_exists')]);
+        }
+
+        $membership = $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee,
+        ]);
+
+        $this->audit('Member added', $membership);
+
+        $this->reset('email');
+    }
+
+    /**
+     * Change a member's role between admin and employee.
+     */
+    public function assignRole(int|string $membershipId, string $role): void
+    {
+        $membership = $this->resolveMembership($membershipId);
+
+        $this->authorize('assignRole', $membership);
+
+        // The owner's role only changes through an ownership transfer.
+        abort_if($membership->role === UserRole::Owner, 403);
+
+        Validator::make(['role' => $role], [
+            'role' => ['required', Rule::in(array_column(UserRole::manageable(), 'value'))],
+        ])->validate();
+
+        $membership->update(['role' => UserRole::from($role)]);
+
+        $this->audit('Member role changed', $membership);
+    }
+
+    public function removeMember(int|string $membershipId): void
+    {
+        $membership = $this->resolveMembership($membershipId);
+
+        $this->authorize('delete', $membership);
+
+        $managers = $this->entity->memberships()->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value]);
+
+        abort_if(
+            $membership->role === UserRole::Admin && $managers->count() <= 1,
+            403,
+        );
+
+        $membership->delete();
+
+        $this->audit('Member removed', $membership);
+
+        if ($membership->user_id === auth()->id()) {
+            if ((int) session('current_entity_id') === $this->entity->id) {
+                session()->forget('current_entity_id');
+            }
+
+            $this->redirectRoute('home');
+        }
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+            'canManage' => auth()->user()->can('update', $this->entity),
+        ]);
+    }
+
+    /**
+     * Never trust the id sent by the client: it must belong to this entity.
+     */
+    protected function resolveMembership(int|string $membershipId): EntityMembership
+    {
+        return $this->entity->memberships()->findOrFail($membershipId);
+    }
+
+    protected function audit(string $message, EntityMembership $membership): void
+    {
+        Log::channel('audit')->info($message, [
+            'actor_id' => auth()->id(),
+            'entity_id' => $this->entity->id,
+            'membership_id' => $membership->id,
+            'user_id' => $membership->user_id,
+            'role' => $membership->role->value,
+        ]);
+    }
+}
