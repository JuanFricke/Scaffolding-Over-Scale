+    $other = joined(UserRole::Employee, $owner->entity);
+
+    Livewire::actingAs($employee->user)->test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $other->id)->assertForbidden();
+
+    Livewire::actingAs($employee->user)->test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $employee->id)->assertRedirect(route('home'));
+
+    expect(EntityMembership::find($other->id))->not->toBeNull()
+        ->and(EntityMembership::find($employee->id))->toBeNull();
+});
+
+test('leaving the current entity clears it from the session', function () {
+    $owner = joined(UserRole::Owner);
+    $employee = joined(UserRole::Employee, $owner->entity);
+
+    session(['current_entity_id' => $owner->entity_id]);
+
+    Livewire::actingAs($employee->user)
+        ->test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $employee->id);
+
+    expect(session()->has('current_entity_id'))->toBeFalse();
+});
+
+// --- settings ------------------------------------------------------------
+
+test('the owner edits name and slug', function () {
+    $owner = joined(UserRole::Owner);
+
