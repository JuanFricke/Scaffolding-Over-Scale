+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Livewire\Entity\Members;
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\Eloquent\ModelNotFoundException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(fn () => $this->withoutVite());
+
+function joined(UserRole $role, ?Entity $entity = null): EntityMembership
+{
+    return EntityMembership::factory()
+        ->for($entity ?? Entity::factory()->create())
+        ->state(['role' => $role])
+        ->create();
+}
+
+// --- entity.pick ---------------------------------------------------------
+
+test('picking an entity stores it in the session, audits it and redirects to the dashboard', function () {
+    Event::fake([MessageLogged::class]);
+    $membership = joined(UserRole::Employee);
+
+    $this->actingAs($membership->user)
+        ->post(route('entity.pick', $membership->entity))
+        ->assertRedirect(route('entity.dashboard', $membership->entity))
+        ->assertSessionHas('current_entity_id', $membership->entity_id);
+
+    Event::assertDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->message === 'Entity picked'
+        && $log->context['entity_id'] === $membership->entity_id);
+});
+
+test('picking an entity the user does not belong to is forbidden and leaves the session alone', function () {
+    $mine = joined(UserRole::Owner);
+    $other = Entity::factory()->create();
+
+    $this->actingAs($mine->user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->post(route('entity.pick', $other))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->entity_id);
+});
+
+test('guests and unverified users cannot pick an entity', function () {
+    $entity = Entity::factory()->create();
+
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+
+    $unverified = User::factory()->unverified()->create();
+    joined(UserRole::Owner, $entity)->update(['user_id' => $unverified->id]);
+
+    $this->actingAs($unverified)->post(route('entity.pick', $entity))->assertRedirect(route('verification.notice'));
+});
+
+// --- dashboard -----------------------------------------------------------
+
+test('the owner dashboard shows the notice and both links', function () {
+    $owner = joined(UserRole::Owner);
+
+    $this->actingAs($owner->user)
+        ->get(route('entity.dashboard', $owner->entity))
+        ->assertOk()
+        ->assertSee($owner->entity->name)
+        ->assertSee('Você é o proprietário desta entidade.')
+        ->assertSee(route('entity.members', $owner->entity))
+        ->assertSee(route('entity.settings', $owner->entity));
+});
+
+test('the dashboard hides settings from non-owners', function (UserRole $role) {
+    $member = joined($role);
+
+    $this->actingAs($member->user)
+        ->get(route('entity.dashboard', $member->entity))
+        ->assertOk()
+        ->assertSee(route('entity.members', $member->entity))
+        ->assertDontSee(route('entity.settings', $member->entity))
+        ->assertDontSee('Você é o proprietário desta entidade.');
+})->with([UserRole::Admin, UserRole::Employee]);
+
+test('the dashboard is translated', function () {
+    app()->setLocale('en');
+    $owner = joined(UserRole::Owner);
+
+    $this->actingAs($owner->user)
+        ->get(route('entity.dashboard', $owner->entity))
+        ->assertSee('You are the owner of this entity.')
+        ->assertSee('Members');
+});
+
+test('entity pages forbid non-members even when the session points at another entity', function (string $route) {
+    $mine = joined(UserRole::Owner);
+    $other = Entity::factory()->create();
+
+    $this->actingAs($mine->user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->get(route($route, $other))
+        ->assertForbidden();
+})->with(['entity.dashboard', 'entity.members', 'entity.settings']);
+
+test('entity pages require authentication and a verified e-mail', function (string $route) {
+    $entity = Entity::factory()->create();
+
+    $this->get(route($route, $entity))->assertRedirect(route('login'));
+
+    $unverified = User::factory()->unverified()->create();
+    $this->actingAs($unverified)->get(route($route, $entity))->assertRedirect(route('verification.notice'));
+})->with(['entity.dashboard', 'entity.members', 'entity.settings']);
+
+test('a deleted entity is not found', function () {
+    $owner = joined(UserRole::Owner);
+    $owner->entity->delete();
+
+    $this->actingAs($owner->user)->get(route('entity.dashboard', $owner->entity))->assertNotFound();
+});
+
+test('settings page is owner only', function () {
+    $admin = joined(UserRole::Admin);
+    $owner = joined(UserRole::Owner, $admin->entity);
+
+    $this->actingAs($admin->user)->get(route('entity.settings', $admin->entity))->assertForbidden();
+    $this->actingAs($owner->user)->get(route('entity.settings', $admin->entity))
+        ->assertOk()->assertSee('Transferir propriedade');
+
+    Livewire::actingAs($admin->user)->test(Dashboard::class, ['entity' => $admin->entity])->assertOk();
+});
+
+// --- members -------------------------------------------------------------
+
+test('members page lists members for any member', function () {
+    $employee = joined(UserRole::Employee);
+    $owner = joined(UserRole::Owner, $employee->entity);
+
+    $this->actingAs($employee->user)
+        ->get(route('entity.members', $employee->entity))
+        ->assertOk()
+        ->assertSee($owner->user->email)
+        ->assertDontSee('wire:submit="addMember"', false);
+});
+
+test('a manager adds an existing user as employee', function (UserRole $role) {
+    $manager = joined($role);
+    $user = User::factory()->create();
+
+    Livewire::actingAs($manager->user)
+        ->test(Members::class, ['entity' => $manager->entity])
+        ->set('email', $user->email)
+        ->call('addMember')
+        ->assertHasNoErrors()
+        ->assertSet('email', '');
+
+    expect($user->membershipFor($manager->entity_id)->role)->toBe(UserRole::Employee);
+})->with([UserRole::Owner, UserRole::Admin]);
+
+test('adding validates the e-mail', function (string $email, string $rule) {
+    $owner = joined(UserRole::Owner);
+
+    Livewire::actingAs($owner->user)
+        ->test(Members::class, ['entity' => $owner->entity])
+        ->set('email', $email)
+        ->call('addMember')
+        ->assertHasErrors(['email' => $rule]);
+})->with([
+    'empty' => ['', 'required'],
+    'malformed' => ['nope', 'email'],
+    'unknown user' => ['ghost@example.com', 'exists'],
+]);
+
+test('adding a duplicate member is an error on email', function () {
+    $owner = joined(UserRole::Owner);
+
+    Livewire::actingAs($owner->user)
+        ->test(Members::class, ['entity' => $owner->entity])
+        ->set('email', $owner->user->email)
+        ->call('addMember')
+        ->assertHasErrors('email');
+
+    expect($owner->entity->memberships()->count())->toBe(1);
+});
+
+test('employees cannot add members or assign roles', function () {
+    $employee = joined(UserRole::Employee);
+    $other = joined(UserRole::Employee, $employee->entity);
+    $user = User::factory()->create();
+
+    Livewire::actingAs($employee->user)
+        ->test(Members::class, ['entity' => $employee->entity])
+        ->set('email', $user->email)
+        ->call('addMember')->assertForbidden();
+
+    Livewire::actingAs($employee->user)
+        ->test(Members::class, ['entity' => $employee->entity])
+        ->call('assignRole', $other->id, 'admin')->assertForbidden();
+
+    expect($other->fresh()->role)->toBe(UserRole::Employee)
+        ->and($user->membershipFor($employee->entity_id))->toBeNull();
+});
+
+test('a manager assigns admin and employee roles', function () {
+    $owner = joined(UserRole::Owner);
+    $member = joined(UserRole::Employee, $owner->entity);
+
+    $component = Livewire::actingAs($owner->user)->test(Members::class, ['entity' => $owner->entity]);
+
+    $component->call('assignRole', $member->id, 'admin')->assertHasNoErrors();
+    expect($member->fresh()->role)->toBe(UserRole::Admin);
+
+    $component->call('assignRole', $member->id, 'employee')->assertHasNoErrors();
+    expect($member->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('assigning any other role is a validation error on role', function (string $role) {
+    $owner = joined(UserRole::Owner);
+    $member = joined(UserRole::Employee, $owner->entity);
+
+    Livewire::actingAs($owner->user)
+        ->test(Members::class, ['entity' => $owner->entity])
+        ->call('assignRole', $member->id, $role)
+        ->assertHasErrors('role');
+
+    expect($member->fresh()->role)->toBe(UserRole::Employee);
+})->with(['owner', 'superuser', '']);
+
+test('the owner role cannot be reassigned', function () {
+    $admin = joined(UserRole::Admin);
+    $owner = joined(UserRole::Owner, $admin->entity);
+
+    Livewire::actingAs($admin->user)
+        ->test(Members::class, ['entity' => $admin->entity])
+        ->call('assignRole', $owner->id, 'employee')
+        ->assertForbidden();
+
+    expect($owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('memberships of other entities cannot be touched', function () {
+    $owner = joined(UserRole::Owner);
+    $foreign = joined(UserRole::Employee);
+
+    $component = Livewire::actingAs($owner->user)->test(Members::class, ['entity' => $owner->entity]);
+
+    expect(fn () => $component->call('assignRole', $foreign->id, 'admin'))->toThrow(ModelNotFoundException::class);
+    expect(fn () => Livewire::actingAs($owner->user)->test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $foreign->id))->toThrow(ModelNotFoundException::class);
+
+    expect($foreign->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('the bound entity cannot be swapped from the client', function () {
+    $owner = joined(UserRole::Owner);
+    $other = Entity::factory()->create();
+
+    Livewire::actingAs($owner->user)
+        ->test(Members::class, ['entity' => $owner->entity])
+        ->set('entity', $other->id);
+})->throws(Exception::class);
+
+test('removing a member deletes the membership', function () {
+    $owner = joined(UserRole::Owner);
