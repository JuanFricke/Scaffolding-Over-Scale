@@ -0,0 +1,132 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    public string $name = '';
+
+    public string $slug = '';
+
+    public $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    /**
+     * @return array<string, array<int, mixed>>
+     */
+    protected function rules(): array
+    {
+        return [
+            'name' => ['required', 'string', 'max:255'],
+            'slug' => [
+                'required', 'string', 'max:255', 'alpha_dash:ascii',
+                Rule::unique('entities', 'slug')->ignore($this->entity->id),
+            ],
+        ];
+    }
+
+    public function save(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $validated = $this->validate();
+
+        $this->entity->update($validated);
+
+        Log::channel('audit')->info('Entity settings updated', $this->context());
+
+        session()->flash('status', __('ui.settings_saved'));
+
+        // The page URL embeds the slug, so a renamed slug needs a fresh URL.
+        if ($this->entity->wasChanged('slug')) {
+            $this->redirectRoute('entity.settings', $this->entity);
+        }
+    }
+
+    public function delete(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        DB::transaction(function () {
+            $this->entity->memberships()->delete();
+            $this->entity->delete();
+        });
+
+        Log::channel('audit')->info('Entity deleted', $this->context());
+
+        if ((int) session('current_entity_id') === $this->entity->id) {
+            session()->forget('current_entity_id');
+        }
+
+        $this->redirectRoute('home');
+    }
+
+    /**
+     * Hand ownership to another admin of this entity; the current owner becomes an admin.
+     */
+    public function transfer(): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        DB::transaction(function () {
+            $owner = $this->entity->owner()->lockForUpdate()->first();
+
+            abort_unless($owner && $owner->user_id === auth()->id(), 403);
+
+            $targetId = filter_var($this->targetMembershipId, FILTER_VALIDATE_INT);
+
+            $target = $targetId === false
+                ? null
+                : $this->entity->memberships()->admin()->whereKeyNot($owner->id)->lockForUpdate()->find($targetId);
+
+            abort_unless($target, 403);
+
+            // Demote first: the unique (entity_id, owner_seq) index allows a single owner at any time.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+        });
+
+        Log::channel('audit')->info('Entity ownership transferred', $this->context() + [
+            'target_membership_id' => (int) $this->targetMembershipId,
+        ]);
+
+        $this->redirectRoute('entity.dashboard', $this->entity);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'admins' => $this->entity->memberships()->admin()->with('user')->orderBy('id')->get(),
+        ]);
+    }
+
+    /**
+     * @return array<string, int|null>
+     */
+    protected function context(): array
+    {
+        return ['actor_id' => auth()->id(), 'entity_id' => $this->entity->id];
+    }
+}
