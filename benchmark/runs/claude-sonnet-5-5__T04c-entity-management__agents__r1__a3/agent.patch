diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..c6c1a8a
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,170 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+function member(UserRole $role, ?Entity $entity = null): EntityMembership
+{
+    return EntityMembership::factory()
+        ->for($entity ?? Entity::factory()->create())
+        ->state(['role' => $role])
+        ->create();
+}
+
+test('entities bind by slug and soft delete', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+
+    expect($entity->getRouteKeyName())->toBe('slug');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('the schema carries the named indexes', function () {
+    $names = fn (string $table) => collect(Schema::getIndexes($table))->pluck('name');
+
+    expect($names('entities'))->toContain('entities_slug_unique')
+        ->and($names('entity_memberships'))
+        ->toContain('entity_memberships_entity_user_unique', 'entity_memberships_one_owner');
+});
+
+test('the role defaults to employee and is cast to the enum', function () {
+    $membership = EntityMembership::create([
+        'entity_id' => Entity::factory()->create()->id,
+        'user_id' => User::factory()->create()->id,
+    ])->refresh();
+
+    expect($membership->role)->toBe(UserRole::Employee);
+});
+
+test('a user cannot join the same entity twice', function () {
+    $membership = member(UserRole::Employee);
+
+    EntityMembership::create(['entity_id' => $membership->entity_id, 'user_id' => $membership->user_id]);
+})->throws(QueryException::class);
+
+test('the database rejects a second owner per entity', function () {
+    $owner = member(UserRole::Owner);
+
+    expect(fn () => member(UserRole::Owner, $owner->entity))->toThrow(QueryException::class);
+
+    // Another entity may have its own owner, and any number of admins/employees coexist.
+    member(UserRole::Owner);
+    member(UserRole::Admin, $owner->entity);
+    member(UserRole::Admin, $owner->entity);
+
+    expect($owner->entity->memberships()->count())->toBe(3);
+});
+
+test('deleting an entity row cascades to memberships', function () {
+    $membership = member(UserRole::Owner);
+
+    $membership->entity->forceDelete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
+
+test('relations and scopes resolve', function () {
+    $owner = member(UserRole::Owner);
+    $admin = member(UserRole::Admin, $owner->entity);
+    $employee = member(UserRole::Employee, $owner->entity);
+    $entity = $owner->entity;
+
+    expect($entity->owner->is($owner))->toBeTrue()
+        ->and($entity->memberships)->toHaveCount(3)
+        ->and($entity->users)->toHaveCount(3)
+        ->and(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id])
+        ->and($admin->user->memberships)->toHaveCount(1)
+        ->and($admin->user->entities->first()->is($entity))->toBeTrue()
+        ->and($admin->user->membershipFor($entity->id)->is($admin))->toBeTrue()
+        ->and($admin->user->membershipFor($entity->id + 100))->toBeNull();
+});
+
+test('factory states set the role', function () {
+    expect(EntityMembership::factory()->create()->role)->toBe(UserRole::Employee)
+        ->and(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('only admin and employee are manageable', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('entity policy', function (UserRole $role, bool $view, bool $update, bool $settings) {
+    $membership = member($role);
+    $user = $membership->user;
+    $entity = $membership->entity;
+    $policy = new EntityPolicy;
+
+    expect($policy->create($user))->toBeTrue()
+        ->and($policy->view($user, $entity))->toBe($view)
+        ->and($policy->update($user, $entity))->toBe($update)
+        ->and($policy->delete($user, $entity))->toBe($update)
+        ->and($policy->manageSettings($user, $entity))->toBe($settings);
+})->with([
+    'owner' => [UserRole::Owner, true, true, true],
+    'admin' => [UserRole::Admin, true, true, false],
+    'employee' => [UserRole::Employee, true, false, false],
+]);
+
+test('entity policy denies non-members everything but create', function () {
+    $stranger = User::factory()->create();
+    $entity = Entity::factory()->create();
+    $policy = new EntityPolicy;
+
+    expect($policy->create($stranger))->toBeTrue()
+        ->and($policy->view($stranger, $entity))->toBeFalse()
+        ->and($policy->update($stranger, $entity))->toBeFalse()
+        ->and($policy->delete($stranger, $entity))->toBeFalse()
+        ->and($policy->manageSettings($stranger, $entity))->toBeFalse();
+});
+
+test('membership policy', function (UserRole $actorRole, UserRole $targetRole, bool $view, bool $assign, bool $delete) {
+    $actor = member($actorRole);
+    $target = member($targetRole, $actor->entity);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($actor->user, $target))->toBe($view)
+        ->and($policy->assignRole($actor->user, $target))->toBe($assign)
+        ->and($policy->delete($actor->user, $target))->toBe($delete);
+})->with([
+    'owner on employee' => [UserRole::Owner, UserRole::Employee, true, true, true],
+    'owner on admin' => [UserRole::Owner, UserRole::Admin, true, true, true],
+    'admin on employee' => [UserRole::Admin, UserRole::Employee, true, true, true],
+    'admin on owner' => [UserRole::Admin, UserRole::Owner, true, true, false],
+    'employee on admin' => [UserRole::Employee, UserRole::Admin, true, false, false],
+    'employee on employee' => [UserRole::Employee, UserRole::Employee, true, false, false],
+]);
+
+test('membership policy lets members remove themselves but never the owner', function () {
+    $employee = member(UserRole::Employee);
+    $owner = member(UserRole::Owner);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->delete($employee->user, $employee))->toBeTrue()
+        ->and($policy->delete($owner->user, $owner))->toBeFalse();
+});
+
+test('membership policy denies non-members', function () {
+    $stranger = User::factory()->create();
+    $membership = member(UserRole::Employee);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($stranger, $membership))->toBeFalse()
+        ->and($policy->assignRole($stranger, $membership))->toBeFalse()
+        ->and($policy->delete($stranger, $membership))->toBeFalse();
+});
