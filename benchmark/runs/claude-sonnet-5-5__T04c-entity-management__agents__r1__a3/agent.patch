+        ->assertRedirect(route('entity.settings', 'novo-slug'));
+
+    expect($owner->entity->fresh())->name->toBe('Novo Nome')->slug->toBe('novo-slug');
+});
+
+test('saving without changing the slug stays on the page', function () {
+    $owner = joined(UserRole::Owner);
+
+    Livewire::actingAs($owner->user)
+        ->test(Settings::class, ['entity' => $owner->entity])
+        ->set('name', 'Outro')
+        ->call('save')
+        ->assertHasNoErrors()
+        ->assertNoRedirect();
+});
+
+test('settings validates name and slug uniqueness except itself', function () {
