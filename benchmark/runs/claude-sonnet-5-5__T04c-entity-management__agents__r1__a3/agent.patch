+
+    expect(EntityMembership::find($member->id))->toBeNull();
+});
+
+test('the owner can never be removed', function () {
+    $owner = joined(UserRole::Owner);
+    $admin = joined(UserRole::Admin, $owner->entity);
+
+    Livewire::actingAs($admin->user)
+        ->test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $owner->id)
+        ->assertForbidden();
+
+    Livewire::actingAs($owner->user)
+        ->test(Members::class, ['entity' => $owner->entity])
+        ->call('removeMember', $owner->id)
+        ->assertForbidden();
+
+    expect(EntityMembership::find($owner->id))->not->toBeNull();
+});
+
+test('the last manager cannot be removed', function () {
+    $admin = joined(UserRole::Admin);
+
+    Livewire::actingAs($admin->user)
+        ->test(Members::class, ['entity' => $admin->entity])
+        ->call('removeMember', $admin->id)
+        ->assertForbidden();
+
+    expect(EntityMembership::find($admin->id))->not->toBeNull();
+});
+
+test('employees cannot remove others but can leave', function () {
+    $owner = joined(UserRole::Owner);
