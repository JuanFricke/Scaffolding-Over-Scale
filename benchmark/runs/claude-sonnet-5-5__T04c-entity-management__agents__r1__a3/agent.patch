@@ -0,0 +1,42 @@
+<?php
+
+namespace App\Policies;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+
+class EntityMembershipPolicy
+{
+    public function view(User $user, EntityMembership $membership): bool
+    {
+        return $this->roleOf($user, $membership) !== null;
+    }
+
+    public function assignRole(User $user, EntityMembership $membership): bool
+    {
+        return $this->isManager($user, $membership);
+    }
+
+    /**
+     * The owner's membership is never deletable (ownership must be transferred first).
+     */
+    public function delete(User $user, EntityMembership $membership): bool
+    {
+        if ($membership->role === UserRole::Owner) {
+            return false;
+        }
+
+        return $membership->user_id === $user->id || $this->isManager($user, $membership);
+    }
+
+    protected function roleOf(User $user, EntityMembership $membership): ?UserRole
+    {
+        return $user->membershipFor($membership->entity_id)?->role;
+    }
+
+    protected function isManager(User $user, EntityMembership $membership): bool
+    {
+        return in_array($this->roleOf($user, $membership), [UserRole::Owner, UserRole::Admin], true);
+    }
+}
