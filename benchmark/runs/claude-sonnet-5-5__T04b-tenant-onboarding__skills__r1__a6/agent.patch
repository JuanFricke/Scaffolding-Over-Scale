@@ -0,0 +1,58 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Tenancy\TenantContext;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Resolves session('current_entity_id') into the in-request TenantContext.
+ *
+ * Must run after `auth`.
+ */
+class EnsureCurrentEntity
+{
+    public function __construct(private TenantContext $context) {}
+
+    public function handle(Request $request, Closure $next): Response
+    {
+        $user = $request->user();
+        $entityId = $request->session()->get('current_entity_id');
+
+        if ($entityId !== null) {
+            $entity = Entity::find($entityId);
+
+            if ($entity !== null) {
+                $membership = $user->membershipFor($entity->id);
+
+                abort_if($membership === null, 403);
+
+                $this->context->set($entity, $membership);
+
+                return $next($request);
+            }
+
+            // The entity was deleted since it was picked: start over.
+            $request->session()->forget('current_entity_id');
+        }
+
+        $entities = $user->entities()->limit(2)->get();
+
+        if ($entities->isEmpty()) {
+            return redirect()->route('onboarding');
+        }
+
+        if ($entities->count() > 1) {
+            return redirect()->route('entity.switcher');
+        }
+
+        $entity = $entities->first();
+        $request->session()->put('current_entity_id', $entity->id);
+        $this->context->set($entity, $user->membershipFor($entity->id));
+
+        return $next($request);
+    }
+}
diff --git a/app/Livewire/Entity/CreateEntity.php b/app/Livewire/Entity/CreateEntity.php
