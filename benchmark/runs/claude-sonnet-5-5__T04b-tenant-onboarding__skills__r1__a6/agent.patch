--- /dev/null
+++ b/app/Livewire/Entity/CreateEntity.php
@@ -0,0 +1,76 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateEntity as CreateEntityAction;
+use App\Models\Entity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Support\Str;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class CreateEntity extends Component
+{
+    /** Slug creation attempts before giving up on concurrent collisions. */
+    private const MAX_ATTEMPTS = 5;
+
+    /** Slugs that would shadow a fixed `/e/...` route. */
+    private const RESERVED_SLUGS = ['switcher'];
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public function submit(CreateEntityAction $createEntity): void
+    {
+        $this->authorize('create', Entity::class);
+
+        $validated = $this->validate();
+        $attempt = 0;
+
+        // The slug check and the insert are not atomic: a concurrent request may take
+        // the slug in between, so a unique violation means "pick the next one".
+        while (true) {
+            try {
+                $entity = $createEntity->handle(auth()->user(), $validated['name'], $this->uniqueSlug($validated['name']));
+
+                break;
+            } catch (UniqueConstraintViolationException $e) {
+                if (++$attempt >= self::MAX_ATTEMPTS) {
+                    throw $e;
+                }
+            }
+        }
+
+        session()->put('current_entity_id', $entity->id);
+
+        $this->redirectRoute('entity.dashboard', ['entity' => $entity]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.create-entity')->title(__('ui.create_entity_title'));
+    }
+
+    /**
+     * First free slug for the name: `acme-corp`, `acme-corp-2`, `acme-corp-3`...
+     */
+    protected function uniqueSlug(string $name): string
+    {
+        $base = rtrim(mb_substr(Str::slug($name), 0, 100), '-') ?: 'entity';
+
+        $slug = $base;
+        $suffix = 1;
+
+        while (
+            in_array($slug, self::RESERVED_SLUGS, true)
+            || Entity::withTrashed()->where('slug', $slug)->exists()
+        ) {
+            $slug = $base.'-'.++$suffix;
+        }
+
+        return $slug;
+    }
+}
