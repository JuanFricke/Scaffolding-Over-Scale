+        [$one, $entity] = memberOf(1);
+        $this->actingAs($one)->get('/_probe')->assertOk()->assertSee($entity->name)
+            ->assertSessionHas('current_entity_id', $entity->id);
+
+        $this->flushSession();
+
+        [$many] = memberOf(2);
