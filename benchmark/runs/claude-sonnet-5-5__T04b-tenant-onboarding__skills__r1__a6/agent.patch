+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+test('the switcher requires authentication and a verified e-mail', function () {
+    $this->get(route('entity.switcher'))->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->unverified()->create())->get(route('entity.switcher'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the switcher lists only the user entities as pick forms, the current one highlighted', function () {
+    $user = User::factory()->create();
+    $a = EntityMembership::factory()->for($user)->for(Entity::factory(['name' => 'Alpha Ltda']))->create()->entity;
+    $b = EntityMembership::factory()->for($user)->for(Entity::factory(['name' => 'Beta SA']))->create()->entity;
+    $foreign = Entity::factory(['name' => 'Foreign Inc'])->create();
+
+    $html = $this->actingAs($user)->withSession(['current_entity_id' => $b->id])
+        ->get(route('entity.switcher'))
+        ->assertOk()
+        ->assertSee('Trocar de entidade')
+        ->assertSee('Alpha Ltda')
+        ->assertSee('Beta SA')
+        ->assertDontSee('Foreign Inc')
+        ->assertSee('action="'.route('entity.pick', $a).'"', false)
+        ->assertSee('action="'.route('entity.pick', $b).'"', false)
+        ->assertDontSee(route('entity.pick', $foreign), false)
+        ->getContent();
+
+    expect(substr_count($html, 'data-current="1"'))->toBe(1)
+        ->and($html)->toMatch('/class="button is-fullwidth is-link" data-current="1">Beta SA</')
+        ->and($html)->toMatch('/class="button is-fullwidth is-light">Alpha Ltda</')
+        ->and($html)->not->toContain('class="tag');
+});
+
+test('the switcher title is translated', function () {
+    app()->setLocale('en');
+
+    $this->actingAs(User::factory()->create())->get(route('entity.switcher'))
+        ->assertSee('Switch entity')
+        ->assertDontSee('Trocar de entidade');
+});
+
+test('picking from the switcher form works end to end', function () {
+    $user = User::factory()->create();
+    EntityMembership::factory()->for($user)->create();
+    $second = EntityMembership::factory()->for($user)->create()->entity;
+
+    $this->actingAs($user)->post(route('entity.pick', $second))
+        ->assertRedirect(route('entity.dashboard', $second));
+    $this->get(route('entity.dashboard', $second))->assertOk();
+});
+
+test('the navbar links to the switcher only with more than one entity', function () {
+    $user = User::factory()->create();
+    $first = EntityMembership::factory()->for($user)->create()->entity;
+
+    $this->actingAs($user)->get(route('entity.dashboard', $first))
+        ->assertOk()
+        ->assertSee($user->name)
+        ->assertDontSee(route('entity.switcher'), false);
+
+    EntityMembership::factory()->for($user)->create();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $first))
+        ->assertSee('href="'.route('entity.switcher').'"', false)
+        ->assertSee('Trocar de entidade');
+});
+
+test('the navbar does not show the switcher link to guests', function () {
+    $this->get('/')->assertDontSee(route('entity.switcher'), false);
+});
diff --git a/tests/Feature/OnboardingTest.php b/tests/Feature/OnboardingTest.php
new file mode 100644
