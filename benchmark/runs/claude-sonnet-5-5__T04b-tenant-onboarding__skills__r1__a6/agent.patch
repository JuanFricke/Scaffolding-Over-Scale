@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class CreateEntity
+{
+    /**
+     * Create an entity and make `$owner` its one and only owner, atomically.
+     *
+     * Throws UniqueConstraintViolationException when `$slug` is taken.
+     */
+    public function handle(User $owner, string $name, string $slug): Entity
+    {
+        Gate::forUser($owner)->authorize('create', Entity::class);
+
+        $entity = DB::transaction(function () use ($owner, $name, $slug) {
+            $entity = Entity::create(['name' => $name, 'slug' => $slug]);
+
+            $entity->memberships()->create([
+                'user_id' => $owner->id,
+                'role' => UserRole::Owner,
+            ]);
+
+            return $entity;
+        });
+
+        Log::channel('audit')->info('Entity created', [
+            'entity_id' => $entity->id,
+            'actor_id' => $owner->id,
+        ]);
+
+        return $entity;
+    }
+}
