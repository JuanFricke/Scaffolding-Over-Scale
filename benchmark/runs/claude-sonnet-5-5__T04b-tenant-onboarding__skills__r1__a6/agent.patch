+<?php
+
+use App\Livewire\Entity\Dashboard;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+test('a member sees the entity name on the dashboard, whatever the role', function (string $state) {
+    $user = User::factory()->create();
+    $entity = EntityMembership::factory()->$state()->for($user)->for(Entity::factory(['name' => 'Acme Corp']))->create()->entity;
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSeeText('Acme Corp')
+        ->assertSee('wire:id', false);
+})->with(['owner', 'admin', 'employee']);
+
+test('a non-member gets 403 even with a valid session for another entity', function () {
+    $user = User::factory()->create();
+    $mine = EntityMembership::factory()->for($user)->create()->entity;
+    $other = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $mine->id])
+        ->get(route('entity.dashboard', $other))
+        ->assertForbidden();
+});
+
+test('a user without entities is sent to onboarding, not shown a dashboard', function () {
+    $this->actingAs(User::factory()->create())
+        ->get(route('entity.dashboard', Entity::factory()->create()))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('a user with a session for a foreign entity is forbidden', function () {
+    $user = User::factory()->create();
+    $entity = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => Entity::factory()->create()->id])
+        ->get(route('entity.dashboard', $entity))->assertForbidden();
+});
+
+test('the dashboard requires authentication and a verified e-mail', function () {
+    $entity = Entity::factory()->create();
+
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->unverified()->create())->get(route('entity.dashboard', $entity))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the component refuses to mount for a non-member', function () {
+    Livewire::actingAs(User::factory()->create())
+        ->test(Dashboard::class, ['entity' => Entity::factory()->create()])
+        ->assertForbidden();
+});
+
+test('the entity property cannot be tampered with from the client', function () {
+    $user = User::factory()->create();
+    $mine = EntityMembership::factory()->for($user)->create()->entity;
+    $other = Entity::factory()->create();
+
+    Livewire::actingAs($user)->test(Dashboard::class, ['entity' => $mine])
+        ->set('entity', $other->id);
+})->throws(Exception::class, 'Cannot update locked property');
+
+test('the dashboard of a soft-deleted entity is not found', function () {
+    $user = User::factory()->create();
+    $entity = EntityMembership::factory()->for($user)->create()->entity;
+    $entity->delete();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))->assertNotFound();
+});
+
+test('an entity named switcher keeps a reachable dashboard', function () {
+    $user = User::factory()->create();
+    $entity = EntityMembership::factory()->for($user)->for(Entity::factory(['slug' => 'switcher-2']))->create()->entity;
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))->assertOk();
+});
diff --git a/tests/Feature/EntityModelTest.php b/tests/Feature/EntityModelTest.php
new file mode 100644
index 0000000..df5061c
--- /dev/null
+++ b/tests/Feature/EntityModelTest.php
@@ -0,0 +1,121 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities bind routes by slug', function () {
+    expect((new Entity)->getRouteKeyName())->toBe('slug');
+});
+
+test('entity slugs are unique, even for soft-deleted entities', function () {
+    $entity = Entity::factory()->create(['slug' => 'acme']);
+    $entity->delete();
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))
+        ->toThrow(UniqueConstraintViolationException::class);
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique');
+});
+
+test('a membership defaults to the employee role and casts it to the enum', function () {
+    $membership = EntityMembership::create([
+        'entity_id' => Entity::factory()->create()->id,
+        'user_id' => User::factory()->create()->id,
+    ])->refresh();
+
+    expect($membership->role)->toBe(UserRole::Employee);
+});
+
+test('membership factory states set the role', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee)
+        ->and(EntityMembership::factory()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('membership scopes filter by role', function () {
+    $entity = Entity::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    $employee = EntityMembership::factory()->employee()->for($entity)->create();
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('manageable roles exclude the owner', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('relations connect users, memberships and entities', function () {
+    $entity = Entity::factory()->create();
+    $user = User::factory()->create();
+    $owner = EntityMembership::factory()->owner()->for($entity)->create();
+    $membership = EntityMembership::factory()->admin()->for($entity)->for($user)->create();
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users->pluck('id')->all())->toContain($user->id)
+        ->and($entity->owner()->first()->is($owner))->toBeTrue()
+        ->and($entity->owner->is($owner))->toBeTrue()
+        ->and($membership->entity->is($entity))->toBeTrue()
+        ->and($membership->user->is($user))->toBeTrue()
+        ->and($user->memberships->pluck('id')->all())->toBe([$membership->id])
+        ->and($user->entities->pluck('id')->all())->toBe([$entity->id])
+        ->and($user->membershipFor($entity->id)->is($membership))->toBeTrue()
+        ->and($user->membershipFor($entity->id + 100))->toBeNull();
+});
+
+test('soft-deleted entities leave the user entity list', function () {
+    $membership = EntityMembership::factory()->create();
+    $membership->entity->delete();
+
+    expect($membership->user->entities)->toHaveCount(0);
+});
+
+test('the database rejects a second owner per entity', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+
+    expect(fn () => EntityMembership::factory()->owner()->for($entity)->create())
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    // Promoting an existing member must fail too, not just inserts.
+    $admin = EntityMembership::factory()->admin()->for($entity)->create();
+    expect(fn () => $admin->update(['role' => UserRole::Owner]))
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('many admins, employees and owners of other entities are fine', function () {
+    $entity = Entity::factory()->create();
+    EntityMembership::factory()->owner()->for($entity)->create();
+    EntityMembership::factory()->owner()->create();
+    EntityMembership::factory()->admin()->count(2)->for($entity)->create();
+    EntityMembership::factory()->employee()->count(2)->for($entity)->create();
+
+    expect($entity->memberships()->count())->toBe(5);
+});
+
+test('a user joins an entity only once', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->for($membership->entity)->for($membership->user)->create())
+        ->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('memberships are removed when the user or entity row is deleted', function () {
+    $membership = EntityMembership::factory()->create();
+    DB::table('users')->where('id', $membership->user_id)->delete();
+    expect(EntityMembership::count())->toBe(0);
+
+    $membership = EntityMembership::factory()->create();
+    DB::table('entities')->where('id', $membership->entity_id)->delete();
+    expect(EntityMembership::count())->toBe(0);
+});
diff --git a/tests/Feature/EntityPoliciesTest.php b/tests/Feature/EntityPoliciesTest.php
new file mode 100644
index 0000000..9bbf458
--- /dev/null
+++ b/tests/Feature/EntityPoliciesTest.php
@@ -0,0 +1,94 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Gate;
+
+uses(RefreshDatabase::class);
+
+function userWithRole(Entity $entity, ?UserRole $role): User
+{
+    $user = User::factory()->create();
+
+    if ($role) {
+        EntityMembership::factory()->for($entity)->for($user)->state(['role' => $role])->create();
+    }
+
+    return $user;
+}
+
+test('policies are auto-discovered and take no constructor arguments', function () {
+    expect(Gate::getPolicyFor(Entity::class))->toBeInstanceOf(EntityPolicy::class)
+        ->and(Gate::getPolicyFor(EntityMembership::class))->toBeInstanceOf(EntityMembershipPolicy::class)
+        ->and(new EntityPolicy)->toBeObject()
+        ->and(new EntityMembershipPolicy)->toBeObject();
+});
+
+test('entity policy by role', function (?UserRole $role, bool $view, bool $update, bool $delete, bool $settings) {
+    $entity = Entity::factory()->create();
+    $user = userWithRole($entity, $role);
+    $policy = new EntityPolicy;
+
+    expect($policy->create($user))->toBeTrue()
+        ->and($policy->view($user, $entity))->toBe($view)
+        ->and($policy->update($user, $entity))->toBe($update)
+        ->and($policy->delete($user, $entity))->toBe($delete)
+        ->and($policy->manageSettings($user, $entity))->toBe($settings);
+})->with([
+    'owner' => [UserRole::Owner, true, true, true, true],
+    'admin' => [UserRole::Admin, true, true, true, false],
+    'employee' => [UserRole::Employee, true, false, false, false],
+    'outsider' => [null, false, false, false, false],
+]);
+
+test('a role in another entity grants nothing', function () {
+    $entity = Entity::factory()->create();
+    $user = userWithRole(Entity::factory()->create(), UserRole::Owner);
+
+    expect(Gate::forUser($user)->allows('view', $entity))->toBeFalse()
+        ->and(Gate::forUser($user)->allows('manageSettings', $entity))->toBeFalse();
+});
+
+test('membership policy view and assignRole by role', function (?UserRole $role, bool $view, bool $assign) {
+    $entity = Entity::factory()->create();
+    $target = EntityMembership::factory()->employee()->for($entity)->create();
+    $user = userWithRole($entity, $role);
+    $policy = new EntityMembershipPolicy;
+
+    expect($policy->view($user, $target))->toBe($view)
+        ->and($policy->assignRole($user, $target))->toBe($assign);
+})->with([
+    'owner' => [UserRole::Owner, true, true],
+    'admin' => [UserRole::Admin, true, true],
+    'employee' => [UserRole::Employee, true, false],
+    'outsider' => [null, false, false],
+]);
+
+test('membership delete rules', function (?UserRole $actor, UserRole $targetRole, bool $self, bool $allowed) {
+    $entity = Entity::factory()->create();
+    $policy = new EntityMembershipPolicy;
+
+    if ($self) {
+        $target = EntityMembership::factory()->for($entity)->state(['role' => $targetRole])->create();
+        $user = $target->user;
+    } else {
+        $target = EntityMembership::factory()->for($entity)->state(['role' => $targetRole])->create();
+        $user = userWithRole($entity, $actor);
+    }
+
+    expect($policy->delete($user, $target))->toBe($allowed);
+})->with([
+    'owner never removable, even by self' => [null, UserRole::Owner, true, false],
+    'owner never removable by an admin' => [UserRole::Admin, UserRole::Owner, false, false],
+    'admin removes self' => [null, UserRole::Admin, true, true],
+    'employee removes self' => [null, UserRole::Employee, true, true],
+    'owner removes admin' => [UserRole::Owner, UserRole::Admin, false, true],
+    'admin removes employee' => [UserRole::Admin, UserRole::Employee, false, true],
+    'employee cannot remove employee' => [UserRole::Employee, UserRole::Employee, false, false],
+    'outsider cannot remove' => [null, UserRole::Employee, false, false],
+]);
diff --git a/tests/Feature/EntitySwitcherTest.php b/tests/Feature/EntitySwitcherTest.php
