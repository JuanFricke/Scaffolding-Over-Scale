+++ b/tests/Feature/OnboardingTest.php
@@ -0,0 +1,175 @@
+<?php
+
+use App\Livewire\Entity\CreateEntity;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+test('onboarding requires authentication and a verified e-mail', function () {
+    $this->get(route('onboarding'))->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->unverified()->create())->get(route('onboarding'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('the onboarding page renders in Portuguese and English', function () {
+    $user = User::factory()->create();
+
+    $this->actingAs($user)->get(route('onboarding'))
+        ->assertOk()
+        ->assertSee('Crie sua empresa')
+        ->assertSee('<title>Crie sua entidade', false)
+        ->assertSee('wire:model="name"', false);
+
+    app()->setLocale('en');
+
+    $this->actingAs($user)->get(route('onboarding'))
+        ->assertSee('Create your company')
+        ->assertSee('<title>Create your entity', false)
+        ->assertDontSee('Crie sua empresa');
+});
+
+test('submitting creates the entity with the creator as owner, audits, sets the session and redirects', function () {
+    $user = User::factory()->create();
+    Event::fake([MessageLogged::class]);
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', ['entity' => 'acme-corp']));
+
+    $entity = Entity::firstWhere('slug', 'acme-corp');
+    expect($entity->name)->toBe('Acme Corp')
+        ->and($entity->memberships)->toHaveCount(1)
+        ->and($entity->owner->user_id)->toBe($user->id)
+        ->and($entity->owner->role)->toBe(UserRole::Owner)
+        ->and(session('current_entity_id'))->toBe($entity->id);
+
+    Event::assertDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->message === 'Entity created'
+        && $log->context === ['entity_id' => $entity->id, 'actor_id' => $user->id]);
+});
+
+test('the name is required and limited to 255 characters', function () {
+    Livewire::actingAs(User::factory()->create())->test(CreateEntity::class)
+        ->call('submit')->assertHasErrors(['name' => 'required'])
+        ->set('name', str_repeat('a', 256))->call('submit')->assertHasErrors(['name' => 'max']);
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('slugs stay unique: acme-corp, acme-corp-2, acme-corp-3', function () {
+    foreach ([1, 2, 3] as $_) {
+        Livewire::actingAs(User::factory()->create())->test(CreateEntity::class)
+            ->set('name', 'Acme Corp')->call('submit');
+    }
+
+    expect(Entity::orderBy('id')->pluck('slug')->all())->toBe(['acme-corp', 'acme-corp-2', 'acme-corp-3']);
+});
+
+test('slugs of soft-deleted entities are never reused', function () {
+    Entity::factory()->create(['slug' => 'acme-corp'])->delete();
+
+    Livewire::actingAs(User::factory()->create())->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')->call('submit');
+
+    expect(Entity::pluck('slug')->all())->toBe(['acme-corp-2']);
+});
+
+test('names that slugify to nothing or to a reserved word still get a usable slug', function () {
+    foreach (['!!!', 'Switcher'] as $name) {
+        Livewire::actingAs(User::factory()->create())->test(CreateEntity::class)
+            ->set('name', $name)->call('submit');
+    }
+
+    expect(Entity::orderBy('id')->pluck('slug')->all())->toBe(['entity', 'switcher-2']);
+});
+
+test('a very long name gets a bounded slug', function () {
+    Livewire::actingAs(User::factory()->create())->test(CreateEntity::class)
+        ->set('name', str_repeat('a', 255))->call('submit')->assertHasNoErrors();
+
+    expect(strlen(Entity::first()->slug))->toBeLessThanOrEqual(100);
+});
+
+test('it retries with a new slug when one is taken between the check and the insert', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    $component = new class extends CreateEntity
+    {
+        public int $calls = 0;
+
+        protected function uniqueSlug(string $name): string
+        {
+            // First attempt simulates the race: the "free" slug was just taken.
+            return ++$this->calls === 1 ? 'acme-corp' : parent::uniqueSlug($name);
+        }
+    };
+
+    Livewire::actingAs(User::factory()->create())->test($component)
+        ->set('name', 'Acme Corp')
+        ->call('submit')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.dashboard', ['entity' => 'acme-corp-2']));
+
+    expect(Entity::count())->toBe(2)
+        ->and(EntityMembership::count())->toBe(1);
+});
+
+test('a failed attempt leaves no half-created entity and gives up after bounded retries', function () {
+    Entity::factory()->create(['slug' => 'acme-corp']);
+
+    $component = new class extends CreateEntity
+    {
+        protected function uniqueSlug(string $name): string
+        {
+            return 'acme-corp';
+        }
+    };
+
+    expect(fn () => Livewire::actingAs(User::factory()->create())->test($component)
+        ->set('name', 'Acme Corp')->call('submit'))
+        ->toThrow(UniqueConstraintViolationException::class);
+
+    expect(Entity::count())->toBe(1)->and(EntityMembership::count())->toBe(0);
+});
+
+test('the creator is always owner: no client input can change the role', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)
+        ->set('name', 'Acme Corp')
+        ->call('submit', 'admin');
+
+    expect(Entity::first()->owner->role)->toBe(UserRole::Owner);
+
+    $component = Livewire::actingAs(User::factory()->create())->test(CreateEntity::class);
+
+    expect(fn () => $component->set('role', 'admin'))->toThrow(Exception::class);
+});
+
+test('guests cannot create entities', function () {
+    Livewire::test(CreateEntity::class)->set('name', 'Acme Corp')->call('submit')->assertForbidden();
+
+    expect(Entity::count())->toBe(0);
+});
+
+test('the new owner can open the dashboard right away', function () {
+    $user = User::factory()->create();
+
+    Livewire::actingAs($user)->test(CreateEntity::class)->set('name', 'Acme Corp')->call('submit');
+
+    $this->actingAs($user)->withSession(['current_entity_id' => Entity::first()->id])
+        ->get(route('entity.dashboard', Entity::first()))->assertOk()->assertSeeText('Acme Corp');
+});
diff --git a/tests/Feature/TenantSessionTest.php b/tests/Feature/TenantSessionTest.php
new file mode 100644
