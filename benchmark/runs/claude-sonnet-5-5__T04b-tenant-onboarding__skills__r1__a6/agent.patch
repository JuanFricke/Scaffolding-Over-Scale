@@ -0,0 +1,139 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Tenancy\TenantContext;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\Route;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->withoutVite();
+});
+
+function memberOf(int $count, ?User $user = null): array
+{
+    $user ??= User::factory()->create();
+    $entities = [];
+
+    foreach (range(1, $count) as $_) {
+        $entities[] = EntityMembership::factory()->for($user)->create()->entity;
+    }
+
+    return [$user, ...$entities];
+}
+
+test('home redirects guests to login and unverified users to verification', function () {
+    $this->get(route('home'))->assertRedirect(route('login'));
+    $this->actingAs(User::factory()->unverified()->create())->get(route('home'))
+        ->assertRedirect(route('verification.notice'));
+});
+
+test('home sends a user without entities to onboarding', function () {
+    $this->actingAs(User::factory()->create())->get(route('home'))
+        ->assertRedirect(route('onboarding'));
+});
+
+test('home sets the session and opens the dashboard for a single entity, whatever the role', function (string $state) {
+    $user = User::factory()->create();
+    $entity = EntityMembership::factory()->$state()->for($user)->create()->entity;
+
+    $this->actingAs($user)->get(route('home'))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+})->with(['owner', 'admin', 'employee']);
+
+test('home sends a user with several entities to the switcher', function () {
+    [$user] = memberOf(2);
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('entity.switcher'));
+});
+
+test('home ignores soft-deleted entities when counting', function () {
+    [$user, $kept, $deleted] = memberOf(2);
+    $deleted->delete();
+
+    $this->actingAs($user)->get(route('home'))->assertRedirect(route('entity.dashboard', $kept));
+});
+
+test('pick stores the entity in the session, audits it and redirects to its dashboard', function () {
+    [$user, , $second] = memberOf(2);
+    Event::fake([MessageLogged::class]);
+
+    $this->actingAs($user)->post(route('entity.pick', $second))
+        ->assertRedirect(route('entity.dashboard', $second))
+        ->assertSessionHas('current_entity_id', $second->id);
+
+    Event::assertDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->message === 'Entity picked'
+        && $log->context === ['entity_id' => $second->id, 'actor_id' => $user->id]);
+});
+
+test('pick on an entity the user does not belong to is forbidden and leaves the session alone', function () {
+    [$user, $mine] = memberOf(1);
+    $other = Entity::factory()->create();
+
+    $this->actingAs($user)->withSession(['current_entity_id' => $mine->id])
+        ->post(route('entity.pick', $other))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->id);
+});
+
+test('pick requires authentication and a verified e-mail', function () {
+    $entity = Entity::factory()->create();
+
