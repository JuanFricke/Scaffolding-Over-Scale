+<?php
+
+namespace Database\Factories;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+/**
+ * @extends Factory<QueueAccess>
+ */
+class QueueAccessFactory extends Factory
+{
+    protected $model = QueueAccess::class;
+
+    /**
+     * Define the model's default state.
+     *
+     * @return array<string, mixed>
+     */
+    public function definition(): array
+    {
+        return [
+            'permissions' => ['call'],
+        ];
+    }
+
+    public function configure(): static
+    {
+        return $this->afterMaking(function (QueueAccess $queueAccess): void {
+            if ($queueAccess->entity_membership_id === null && $queueAccess->queue_id === null) {
+                $entity = Entity::factory()->create();
+                $membership = EntityMembership::factory()->for($entity)->create();
+                $queue = Queue::factory()->for($entity)->create();
+
+                $queueAccess->entity_membership_id = $membership->id;
+                $queueAccess->queue_id = $queue->id;
+                $queueAccess->setRelation('membership', $membership);
+                $queueAccess->setRelation('queue', $queue);
+
+                return;
+            }
+
+            if ($queueAccess->entity_membership_id === null && $queueAccess->queue_id !== null) {
+                $queue = $queueAccess->queue ?? Queue::find($queueAccess->queue_id);
+                $entity = $queue?->entity ?? Entity::factory()->create();
+                $membership = EntityMembership::factory()->for($entity)->create();
+
+                $queueAccess->entity_membership_id = $membership->id;
+                $queueAccess->setRelation('membership', $membership);
+
+                if ($queueAccess->queue_id === null) {
+                    $queue = Queue::factory()->for($entity)->create();
+                    $queueAccess->queue_id = $queue->id;
+                    $queueAccess->setRelation('queue', $queue);
+                }
+
+                return;
+            }
+
+            if ($queueAccess->entity_membership_id !== null && $queueAccess->queue_id === null) {
+                $membership = $queueAccess->membership ?? EntityMembership::find($queueAccess->entity_membership_id);
+                $entity = $membership?->entity ?? Entity::factory()->create();
+                $queue = Queue::factory()->for($entity)->create();
+
+                $queueAccess->queue_id = $queue->id;
+                $queueAccess->setRelation('queue', $queue);
+
+                if ($queueAccess->entity_membership_id === null) {
+                    $membership = EntityMembership::factory()->for($entity)->create();
+                    $queueAccess->entity_membership_id = $membership->id;
+                    $queueAccess->setRelation('membership', $membership);
+                }
+            }
+        });
+    }
+}
