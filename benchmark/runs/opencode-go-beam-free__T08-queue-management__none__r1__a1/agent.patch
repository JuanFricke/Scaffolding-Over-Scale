@@ -0,0 +1,74 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    public function __invoke(EntityMembership $targetMembership, Queue $queue, User $actor, array $permissions): void
+    {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => 'The membership and queue must belong to the same entity.',
+            ]);
+        }
+
+        $allowed = array_map(
+            static fn (QueuePermission $permission): string => $permission->value,
+            QueuePermission::cases(),
+        );
+
+        foreach ($permissions as $permission) {
+            if (! is_string($permission) || ! in_array($permission, $allowed, true)) {
+                throw ValidationException::withMessages([
+                    'permissions' => 'Unknown permission.',
+                ]);
+            }
+        }
+
+        $existing = QueueAccess::query()
+            ->where('entity_membership_id', $targetMembership->id)
+            ->where('queue_id', $queue->id)
+            ->first();
+
+        if ($permissions === []) {
+            if ($existing !== null) {
+                $existing->delete();
+
+                Log::channel('audit')->info('queue.access.revoked', [
+                    'actor_id' => $actor->id,
+                    'queue_id' => $queue->id,
+                    'entity_membership_id' => $targetMembership->id,
+                ]);
+            }
+
+            return;
+        }
+
+        QueueAccess::query()->updateOrCreate(
+            [
+                'entity_membership_id' => $targetMembership->id,
+                'queue_id' => $queue->id,
+            ],
+            [
+                'permissions' => array_values($permissions),
+            ],
+        );
+
+        Log::channel('audit')->info('queue.access.granted', [
+            'actor_id' => $actor->id,
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+        ]);
+    }
+}
