+<?php
+
+namespace Database\Factories;
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Database\Eloquent\Factories\Factory;
+
+class TicketFactory extends Factory
+{
+    protected $model = Ticket::class;
+
+    private static ?int $queueIdForBatch = null;
+    private static array $lastCodesPerQueue = [];
+
+    public function definition(): array
+    {
+        $queue = Queue::factory();
+
+        return [
+            'queue_id' => $queue,
+            'code' => $this->getNextCode($queue),
+            'priority' => 0,
+            'channel' => TicketChannel::Virtual,
+            'status' => TicketStatus::Waiting,
+            'issued_at' => now(),
+            'called_at' => null,
+            'called_by_user_id' => null,
+        ];
+    }
+
+    public function forQueue(Queue $queue): self
+    {
+        self::$queueIdForBatch = $queue->id;
+
+        return $this->state([
+            'queue_id' => $queue->id,
+        ]);
+    }
+
+    private function getNextCode(Queue|Factory $queue): string
+    {
+        $queueId = $queue instanceof Queue ? $queue->id : null;
+
+        if (self::$queueIdForBatch !== null) {
+            $queueId = self::$queueIdForBatch;
+        }
+
+        if ($queueId === null) {
+            return 'A001';
+        }
+
+        if (!isset(self::$lastCodesPerQueue[$queueId])) {
+            self::$lastCodesPerQueue[$queueId] = 'A000';
+        }
+
+        $lastCode = self::$lastCodesPerQueue[$queueId];
+        $match = preg_match('/^A(\d+)$/', $lastCode, $matches);
+
+        if (!$match) {
+            $number = 1;
+        } else {
+            $number = (int) $matches[1] + 1;
+        }
+
+        $code = 'A' . str_pad($number, 3, '0', STR_PAD_LEFT);
+        self::$lastCodesPerQueue[$queueId] = $code;
+
+        return $code;
+    }
+}
