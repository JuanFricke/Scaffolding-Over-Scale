+<?php
+
+namespace App\Actions;
+
+use App\Enums\TicketChannel;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Support\Facades\DB;
+
+class IssueTicket
+{
+    public function __invoke(
+        Queue $queue,
+        int $priority = 0,
+        TicketChannel $channel = TicketChannel::Virtual,
+    ): Ticket {
+        if ($priority < 0) {
+            throw new \InvalidArgumentException('Priority must be non-negative');
+        }
+
+        $maxRetries = 10;
+        for ($attempt = 0; $attempt < $maxRetries; $attempt++) {
+            try {
+                return DB::transaction(function () use ($queue, $priority, $channel) {
+                    $queue = Queue::lockForUpdate()->findOrFail($queue->id);
+
+                    if (!$queue->is_active) {
+                        throw new InactiveQueueException('Queue is not active');
+                    }
+
+                    $code = Ticket::nextCode($queue->id);
+
+                    $ticket = Ticket::create([
+                        'queue_id' => $queue->id,
+                        'code' => $code,
+                        'priority' => $priority,
+                        'channel' => $channel,
+                        'issued_at' => now(),
+                    ]);
+
+                    return $ticket->fresh();
+                });
+            } catch (InactiveQueueException $e) {
+                throw $e;
+            } catch (\Exception $e) {
+                if ($attempt === $maxRetries - 1) {
+                    throw $e;
+                }
+                if (str_contains($e->getMessage(), 'UNIQUE constraint failed') ||
+                    str_contains($e->getMessage(), 'Duplicate entry')) {
+                    continue;
+                }
+                throw $e;
+            }
+        }
+    }
+}
