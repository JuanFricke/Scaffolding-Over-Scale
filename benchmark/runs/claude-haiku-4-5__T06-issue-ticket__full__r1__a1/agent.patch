+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('queue factory creates entity', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->entity)->not()->toBeNull();
+    expect($queue->entity_id)->not()->toBeNull();
+});
+
+test('queue factory slug is unique', function () {
+    $queue1 = Queue::factory()->create();
+    $queue2 = Queue::factory()->for($queue1->entity)->create();
+
+    expect($queue1->slug)->not()->toBe($queue2->slug);
+});
+
+test('queue factory is active by default', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->is_active)->toBeTrue();
+});
+
+test('ticket factory creates queue', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->queue)->not()->toBeNull();
+});
+
+test('ticket factory generates code A001', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->for($queue)->create();
+
+    expect($ticket->code)->toBe('A001');
+});
+
+test('forQueue creates sequential codes', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket1 = Ticket::factory()->forQueue($queue)->create();
+    $ticket2 = Ticket::factory()->forQueue($queue)->create();
+    $ticket3 = Ticket::factory()->forQueue($queue)->create();
+
+    expect($ticket1->code)->toBe('A001');
+    expect($ticket2->code)->toBe('A002');
+    expect($ticket3->code)->toBe('A003');
+});
+
+test('explicit code overrides auto generation', function () {
+    $queue = Queue::factory()->create();
+
+    $ticket = Ticket::factory()->for($queue)->create(['code' => 'A-X']);
+
+    expect($ticket->code)->toBe('A-X');
+});
+
+test('ticket factory sets issued_at to now', function () {
+    $before = now();
+    $ticket = Ticket::factory()->create();
+    $after = now();
+
+    expect($ticket->issued_at->timestamp)->toBeGreaterThanOrEqual($before->timestamp);
+    expect($ticket->issued_at->timestamp)->toBeLessThanOrEqual($after->timestamp);
+});
+
+test('ticket factory defaults are correct', function () {
+    $queue = Queue::factory()->create();
+    $ticket = Ticket::factory()->for($queue)->create();
+
+    expect($ticket->channel->value)->toBe('virtual');
+    expect($ticket->status->value)->toBe('waiting');
+    expect($ticket->priority)->toBe(0);
+    expect($ticket->called_at)->toBeNull();
+    expect($ticket->called_by_user_id)->toBeNull();
+});
