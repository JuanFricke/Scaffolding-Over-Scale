@@ -0,0 +1,40 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('calls waiting ticket', function () {
+    $user = User::factory()->create();
+    $ticket = Ticket::factory()->create(['status' => TicketStatus::Waiting]);
+
+    $ticket->call($user);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->status)->toBe(TicketStatus::Called);
+    expect($fresh->called_by_user_id)->toBe($user->id);
+    expect($fresh->called_at)->not()->toBeNull();
+});
+
+test('rejects calling already called ticket', function () {
+    $user = User::factory()->create();
+    $ticket = Ticket::factory()->create(['status' => TicketStatus::Called]);
+
+    expect(fn () => $ticket->call($user))
+        ->toThrow(LogicException::class);
+});
+
+test('records call timestamp', function () {
+    $user = User::factory()->create();
+    $ticket = Ticket::factory()->create();
+    $before = now();
+
+    $ticket->call($user);
+
+    $fresh = $ticket->fresh();
+    expect($fresh->called_at->timestamp)->toBeGreaterThanOrEqual($before->timestamp);
+    expect($fresh->called_at->timestamp)->toBeLessThanOrEqual(now()->timestamp);
+});
