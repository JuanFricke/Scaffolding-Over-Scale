+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('generates first code A001 for empty queue', function () {
+    $queue = Queue::factory()->create();
+
+    $code = Ticket::nextCode($queue->id);
+
+    expect($code)->toBe('A001');
+});
+
+test('generates sequential codes with numeric order', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+    Ticket::factory()->for($queue)->create(['code' => 'A002']);
+    Ticket::factory()->for($queue)->create(['code' => 'A003']);
+
+    $code = Ticket::nextCode($queue->id);
+
+    expect($code)->toBe('A004');
+});
+
+test('continues past 999 without zero padding', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A999']);
+
+    $code = Ticket::nextCode($queue->id);
+
+    expect($code)->toBe('A1000');
+});
+
+test('skips malformed legacy codes', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A-X']);
+
+    $code = Ticket::nextCode($queue->id);
+
+    expect($code)->toBe('A001');
+});
+
+test('handles mixed malformed and valid codes', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+    Ticket::factory()->for($queue)->create(['code' => 'A-X']);
+
+    $code = Ticket::nextCode($queue->id);
+
+    expect($code)->toBe('A002');
+});
+
+test('respects insertion order not string order', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+    Ticket::factory()->for($queue)->create(['code' => 'A999']);
+
+    $code = Ticket::nextCode($queue->id);
+
+    expect($code)->toBe('A1000');
+});
diff --git a/tests/Unit/TicketImmutabilityTest.php b/tests/Unit/TicketImmutabilityTest.php
new file mode 100644
index 0000000..2a73042
--- /dev/null
+++ b/tests/Unit/TicketImmutabilityTest.php
@@ -0,0 +1,78 @@
+<?php
+
+use App\Enums\TicketStatus;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('prevents code modification', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['code' => 'A999']))
+        ->toThrow(LogicException::class);
+});
+
+test('prevents priority modification', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['priority' => 10]))
+        ->toThrow(LogicException::class);
+});
+
+test('prevents channel modification', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['channel' => 'totem']))
+        ->toThrow(LogicException::class);
+});
+
+test('prevents issued_at modification', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['issued_at' => now()->addDay()]))
+        ->toThrow(LogicException::class);
+});
+
+test('prevents queue_id modification', function () {
+    $ticket = Ticket::factory()->create();
+
+    expect(fn () => $ticket->update(['queue_id' => 999]))
+        ->toThrow(LogicException::class);
+});
+
+test('allows status modification', function () {
+    $ticket = Ticket::factory()->create(['status' => TicketStatus::Waiting]);
+
+    $ticket->update(['status' => TicketStatus::Called]);
+
+    expect($ticket->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+test('allows called_at modification', function () {
+    $ticket = Ticket::factory()->create();
+    $time = now()->addHour();
+
+    $ticket->update(['called_at' => $time]);
+
+    expect($ticket->fresh()->called_at->toDateTimeString())->toBe($time->toDateTimeString());
+});
+
+test('allows called_by_user_id modification', function () {
+    $user = \App\Models\User::factory()->create();
+    $ticket = Ticket::factory()->create();
+
+    $ticket->update(['called_by_user_id' => $user->id]);
+
+    expect($ticket->fresh()->called_by_user_id)->toBe($user->id);
+});
+
+test('allows updated_at to be modified', function () {
+    $ticket = Ticket::factory()->create();
+    $original = $ticket->updated_at;
+
+    sleep(1);
+    $ticket->touch();
+
+    expect($ticket->fresh()->updated_at)->not()->toBe($original);
+});
