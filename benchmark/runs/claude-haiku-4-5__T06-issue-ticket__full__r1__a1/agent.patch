+<?php
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+test('issues ticket with default parameters', function () {
+    $queue = Queue::factory()->create();
+    $action = new IssueTicket();
+
+    $ticket = $action($queue);
+
+    expect($ticket)->toBeInstanceOf(Ticket::class);
+    expect($ticket->queue_id)->toBe($queue->id);
+    expect($ticket->status)->toBe(TicketStatus::Waiting);
+    expect($ticket->channel)->toBe(TicketChannel::Virtual);
+    expect($ticket->priority)->toBe(0);
+    expect($ticket->code)->toBe('A001');
+    expect($ticket->issued_at)->not()->toBeNull();
+    expect($ticket->called_at)->toBeNull();
+    expect($ticket->called_by_user_id)->toBeNull();
+});
+
+test('issues ticket with custom priority', function () {
+    $queue = Queue::factory()->create();
+    $action = new IssueTicket();
+
+    $ticket = $action($queue, priority: 10);
+
+    expect($ticket->priority)->toBe(10);
+});
+
+test('issues ticket with custom channel', function () {
+    $queue = Queue::factory()->create();
+    $action = new IssueTicket();
+
+    $ticket = $action($queue, channel: TicketChannel::Totem);
+
+    expect($ticket->channel)->toBe(TicketChannel::Totem);
+});
+
+test('rejects negative priority', function () {
+    $queue = Queue::factory()->create();
+    $action = new IssueTicket();
+
+    expect(fn () => $action($queue, priority: -1))
+        ->toThrow(InvalidArgumentException::class);
+});
+
+test('rejects inactive queue', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $action = new IssueTicket();
+
+    expect(fn () => $action($queue))
+        ->toThrow(InactiveQueueException::class);
+});
+
+test('rechecks queue active state even if instance is active', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $action = new IssueTicket();
+
+    Queue::where('id', $queue->id)->update(['is_active' => false]);
+
+    expect(fn () => $action($queue))
+        ->toThrow(InactiveQueueException::class);
+});
+
+test('generates sequential codes for concurrent issuance', function () {
+    $queue = Queue::factory()->create();
+    $action = new IssueTicket();
+
+    $ticket1 = $action($queue);
+    $ticket2 = $action($queue);
+    $ticket3 = $action($queue);
+
+    expect($ticket1->code)->toBe('A001');
+    expect($ticket2->code)->toBe('A002');
+    expect($ticket3->code)->toBe('A003');
+});
+
+test('retries on unique constraint violation', function () {
+    $queue = Queue::factory()->create();
+    $action = new IssueTicket();
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+
+    $ticket = $action($queue);
+
+    expect($ticket->code)->toBe('A002');
+});
+
+test('persists nothing on rejection', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $action = new IssueTicket();
+
+    try {
+        $action($queue);
+    } catch (InactiveQueueException) {
+    }
+
+    expect(Ticket::count())->toBe(0);
+});
+
+test('allocates code only if issuance succeeds', function () {
+    $queue = Queue::factory()->create(['is_active' => false]);
+    $action = new IssueTicket();
+
+    $count = Ticket::count();
+
+    try {
+        $action($queue);
+    } catch (InactiveQueueException) {
+    }
+
+    expect(Ticket::count())->toBe($count);
+});
