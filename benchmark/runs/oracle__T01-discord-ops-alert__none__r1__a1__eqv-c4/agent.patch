diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..78c2de9
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,98 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+/**
+ * Thin Discord incoming-webhook client for operational alerts only.
+ *
+ * Does not replace application logs. Call when a notable ops event occurs, e.g.:
+ *
+ *     app(DiscordOpsAlert::class)->send('Queue failed', 'asaas-webhooks job errored', [
+ *         'job' => $jobClass,
+ *     ]);
+ *
+ * Unconfigured (empty DISCORD_WEBHOOK_URL) is a silent no-op.
+ */
+class DiscordOpsAlert
+{
+    private const int MaxContentLength = 1800;
+
+    private const string SecretKeyPattern = '/password|token|secret|authorization|api[_-]?key|webhook/i';
+
+    private const string BearerLikePattern = '/Bearer\s+\S+/i';
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $url = config('services.discord.webhook_url');
+
+        if (! is_string($url) || $url === '') {
+            return;
+        }
+
+        $content = $this->formatContent($title, $message, $context);
+
+        try {
+            $response = Http::timeout(3)
+                ->asJson()
+                ->post($url, ['content' => $content]);
+
+            if ($response->failed()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (Throwable $e) {
+            Log::error('Discord ops alert failed', [
+                'error' => str_replace($url, '[redacted]', $e->getMessage()),
+            ]);
+        }
+    }
+
+    /**
+     * @param  array<string, mixed>  $context
+     */
+    private function formatContent(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($context as $key => $value) {
+            $lines[] = $key.'='.$this->safe((string) $key, $value);
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+    }
+
+    private function safe(string $key, mixed $value): string
+    {
+        if (preg_match(self::SecretKeyPattern, $key)) {
+            return '[redacted]';
+        }
+
+        if (is_array($value)) {
+            $nested = [];
+
+            foreach ($value as $nestedKey => $nestedValue) {
+                $nested[(string) $nestedKey] = $this->safe((string) $nestedKey, $nestedValue);
+            }
+
+            return json_encode($nested, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[unserializable]';
+        }
+
+        if (is_string($value) && preg_match(self::BearerLikePattern, $value)) {
+            return '[redacted]';
+        }
+
+        if (is_scalar($value) || $value === null) {
+            return (string) $value;
+        }
+
+        return json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[unserializable]';
+    }
+}
