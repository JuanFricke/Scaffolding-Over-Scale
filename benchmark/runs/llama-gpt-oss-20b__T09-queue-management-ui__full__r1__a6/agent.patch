+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Models\Entity;
+use App\Models\Ticket;
+use App\Enums\TicketStatus;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Validation\ValidationException;
+use Livewire\Component;
+
+class Serve extends Component
+{
+    public Entity $entity;
+    public ?int $selectedQueueId = null;
+    public string $mode = CallMode::Any->value;
+    public ?int $lastCalledTicketId = null;
+    public ?string $notice = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->entity = $entity;
+        $callableQueues = $this->getCallableQueues();
+        $this->selectedQueueId = $callableQueues->first()?->id;
+    }
+
+    public function getCallableQueues()
+    {
+        $queues = $this->entity->queues()->where('is_active', true)->get();
+        $user = auth()->user();
+        return $queues->filter(fn ($q) => Gate::forUser($user)->allows('call', $q));
+    }
+
+    public function getWaitingTicketsProperty(): \
+    \Illuminate\Database\Eloquent\Collection
+    {
+        if (! $this->selectedQueueId) {
+            return collect();
+        }
+        try {
+            $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+        } catch (\Throwable) {
+            return collect();
+        }
+        if (! Gate::forUser(auth()->user())->allows('call', $queue)) {
+            return collect();
+        }
+        $query = Ticket::query()->where('queue_id', $queue->id)->where('status', TicketStatus::Waiting);
+        match ($this->mode) {
+            CallMode::PriorityOnly->value => $query->where('priority', '>', 0),
+            CallMode::NormalOnly->value => $query->where('priority', 0),
+            default => $query,
+        };
+        return $query->orderByDesc('priority')->orderBy('issued_at')->orderBy('id')->limit(30)->get();
+    }
+
+    public function callNext(): void
+    {
+        if (! $this->selectedQueueId) {
+            $this->notice = __('ui.serve_empty');
+            return;
+        }
+        try {
+            $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+            $ticket = app(CallNextTicket::class)($queue, auth()->user(), CallMode::from($this->mode));
+            $this->lastCalledTicketId = $ticket->id;
+            $this->notice = __('ui.serve_last_called', ['code' => $ticket->code]);
+        } catch (\App\Exceptions\InactiveQueueException $e) {
+            $this->notice = __('ui.serve_inactive');
+        } catch (\App\Exceptions\NoWaitingTicketsException $e) {
+            $this->notice = __('ui.serve_empty');
+        }
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.serve');
+    }
+}
