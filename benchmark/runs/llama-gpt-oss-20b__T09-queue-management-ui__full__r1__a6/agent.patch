+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateQueue;
+use App\Actions\SetQueueAccess;
+use App\Actions\UpdateQueue;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\UserRole;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Component;
+
+class Queues extends Component
+{
+    public Entity $entity;
+    public string $name = '';
+    public bool $creating = false;
+    public ?int $viewingQueueId = null;
+    public bool $confirmingToggle = false;
+    public ?int $editingQueueId = null;
+    public string $renameName = '';
+    public ?int $accessQueueId = null;
+    public bool $managingAccess = false;
+
+    public function mount(Entity $entity): void
+    {
+        $this->entity = $entity;
+    }
+
+    public function getAccessQueueProperty(): ?Queue
+    {
+        if (! $this->accessQueueId) {
+            return null;
+        }
+        return $this->entity->queues()->findOrFail($this->accessQueueId);
+    }
+
+    public function getAccessGrantsProperty(): \
+    \Illuminate\Database\Eloquent\Collection
+    {
+        $queue = $this->getAccessQueueProperty();
+        if (! $queue) {
+            return collect();
+        }
+        return $this->entity->memberships()->with(['queueAccesses' => fn($q)=>$q->where('queue_id', $queue->id)])->get();
+    }
+
+    // Create modal
+    public function openCreate(): void
+    {
+        $this->creating = true;
+        $this->name = '';
+        $this->dispatchBrowserEvent('open-modal', ['id' => 'createQueueModal']);
+    }
+
+    public function closeCreate(): void
+    {
+        $this->creating = false;
+        $this->name = '';
+        $this->dispatchBrowserEvent('close-modal', ['id' => 'createQueueModal']);
+    }
+
+    public function create(): void
+    {
+        try {
+            $queue = app(CreateQueue::class)($this->entity, auth()->user(), $this->name);
+            $this->name = '';
+            $this->creating = false;
+            $this->dispatchBrowserEvent('close-modal', ['id' => 'createQueueModal']);
+        } catch (ValidationException $e) {
+            foreach ($e->errors() as $field => $messages) {
+                foreach ($messages as $msg) {
+                    $this->addError($field, $msg);
+                }
+            }
+        }
+    }
+
+    // Detail modal
+    public function openQueue(int $id): void
+    {
+        $this->viewingQueueId = $id;
+        $this->dispatchBrowserEvent('open-modal', ['id' => 'queueDetailsModal']);
+    }
+
+    public function closeQueue(): void
+    {
+        $this->viewingQueueId = null;
+        $this->editingQueueId = null;
+        $this->renameName = '';
+        $this->confirmingToggle = false;
+        $this->dispatchBrowserEvent('close-modal', ['id' => 'queueDetailsModal']);
+    }
+
+    // Rename
+    public function startRename(int $id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+        $this->editingQueueId = $id;
+        $this->renameName = $queue->name;
+        $this->dispatchBrowserEvent('open-modal', ['id' => 'renameQueueModal']);
+    }
+
+    public function cancelRename(): void
+    {
+        $this->editingQueueId = null;
+        $this->renameName = '';
+        $this->dispatchBrowserEvent('close-modal', ['id' => 'renameQueueModal']);
+    }
+
+    public function rename(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->editingQueueId);
+        $slug = Str::slug($this->renameName);
+        try {
+            app(UpdateQueue::class)($queue, auth()->user(), $this->renameName, $slug);
+            $this->editingQueueId = null;
+            $this->renameName = '';
+            $this->dispatchBrowserEvent('close-modal', ['id' => 'renameQueueModal']);
+        } catch (ValidationException $e) {
+            foreach ($e->errors() as $field => $messages) {
+                foreach ($messages as $msg) {
+                    $this->addError($field, $msg);
+                }
+            }
+        }
+    }
+
+    // Toggle active
+    public function confirmToggle(): void
+    {
+        $this->confirmingToggle = true;
+    }
+
+    public function cancelToggle(): void
+    {
+        $this->confirmingToggle = false;
+    }
+
+    public function toggleActive(int $id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+        $newStatus = !$queue->is_active;
+        try {
+            app(UpdateQueue::class)($queue, auth()->user(), null, null, $newStatus);
+            $this->confirmingToggle = false;
+        } catch (ValidationException $e) {
+            $this->addError('toggle', 'Unable to toggle status');
+            $this->confirmingToggle = false;
+        }
+    }
+
+    // Access modal
+    public function openAccess(int $id): void
+    {
+        $this->accessQueueId = $id;
+        $this->managingAccess = true;
+        $this->dispatchBrowserEvent('open-modal', ['id' => 'accessQueueModal']);
+    }
+
+    public function closeAccess(): void
+    {
+        $this->accessQueueId = null;
+        $this->managingAccess = false;
+        $this->dispatchBrowserEvent('close-modal', ['id' => 'accessQueueModal']);
+    }
+
+    public function grantAccess(int $membershipId): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+        $queue = $this->getAccessQueueProperty();
+        try {
+            app(SetQueueAccess::class)($membership, $queue, auth()->user(), [QueuePermission::Call]);
+        } catch (ValidationException $e) {
+            $this->addError('grant', 'Unable to grant access');
+        }
+    }
+
+    public function revokeAccess(int $membershipId): void
+    {
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+        $queue = $this->getAccessQueueProperty();
+        try {
+            app(SetQueueAccess::class)($membership, $queue, auth()->user(), []);
+        } catch (ValidationException $e) {
+            $this->addError('revoke', 'Unable to revoke access');
+        }
+    }
+
+    public function render()
+    {
+        return view('livewire.entity.queues');
+    }
+}
