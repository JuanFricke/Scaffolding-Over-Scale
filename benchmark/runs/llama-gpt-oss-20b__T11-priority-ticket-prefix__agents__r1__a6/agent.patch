+    private function validatePriorityPrefixMap(array $map): array
+    {
+        // Keys must be non-negative integers in canonical form
+        foreach ($map as $key => $value) {
+            $keyStr = (string)$key;
+            if (!ctype_digit($keyStr)) {
+                throw ValidationException::withMessages(['priority_prefix_map' => 'Keys must be non-negative integers in canonical form.']);
+            }
+            if ($keyStr !== '0' && str_starts_with($keyStr, '0')) {
+                throw ValidationException::withMessages(['priority_prefix_map' => 'Keys must be in canonical form without leading zeros.']);
+            }
+        }
+
+        // Values must be one uppercase letter
+        foreach ($map as $value) {
+            if (!is_string($value) || !preg_match('/^[A-Z]$/', $value)) {
+                throw ValidationException::withMessages(['priority_prefix_map' => 'Values must be a single uppercase letter.']);
+            }
+        }
+
+        // Ensure prefixes are unique across custom entries and default fallbacks
+        $custom = array_values($map);
+        $used = $custom;
+
+        $default = [0 => 'N', 10 => 'P', 20 => 'E'];
+        foreach ([0, 10, 20] as $lvl) {
+            $key = (string)$lvl;
+            if (!array_key_exists($key, $map)) {
+                $used[] = $default[$lvl];
+            }
+        }
+
+        // No further checks needed for other priorities because the default for 1-19 is 'P', which is already included if not overridden.
+
+        // Ensure uniqueness
+        if (count($used) !== count(array_unique($used))) {
+            throw ValidationException::withMessages(['priority_prefix_map' => 'Prefixes must be unique across custom and default mappings.']);
+        }
+
+        return $map;
+    }
 }
