@@ -0,0 +1,80 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Queue;
+use App\Models\User;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+class UpdateQueue
+{
+    public function __invoke(
+        Queue $queue,
+        User $actor,
+        ?string $name = null,
+        ?string $slug = null,
+        ?bool $isActive = null,
+    ): Queue {
+        Gate::forUser($actor)->authorize('update', $queue);
+
+        if ($name !== null) {
+            $name = trim($name);
+
+            if ($name === '' || mb_strlen($name) > 255) {
+                throw ValidationException::withMessages(['name' => 'Queue name must be 1-255 characters.']);
+            }
+
+            $queue->name = $name;
+        }
+
+        if ($slug !== null) {
+            $slug = Str::slug(trim($slug));
+
+            if ($slug === '' || mb_strlen($slug) > 255) {
+                throw ValidationException::withMessages(['slug' => 'Queue slug must be 1-255 characters.']);
+            }
+
+            if ($slug !== $queue->slug
+                && Queue::query()
+                    ->where('entity_id', $queue->entity_id)
+                    ->where('slug', $slug)
+                    ->whereKeyNot($queue->id)
+                    ->exists()) {
+                throw ValidationException::withMessages(['slug' => 'This slug is already in use.']);
+            }
+
+            $queue->slug = $slug;
+        }
+
+        if ($isActive !== null) {
+            $queue->is_active = $isActive;
+        }
+
+        try {
+            $queue->save();
+        } catch (QueryException $e) {
+            if (! self::isUniqueViolation($e)) {
+                throw $e;
+            }
+
+            throw ValidationException::withMessages(['slug' => 'This slug is already in use.']);
+        }
+
+        return $queue;
+    }
+
+    private static function isUniqueViolation(QueryException $e): bool
+    {
+        $sqlState = $e->errorInfo[0] ?? (string) $e->getCode();
+
+        if ($sqlState === '23000') {
+            return true;
+        }
+
+        return str_contains($e->getMessage(), 'UNIQUE')
+            || str_contains($e->getMessage(), 'Duplicate');
+    }
+}
