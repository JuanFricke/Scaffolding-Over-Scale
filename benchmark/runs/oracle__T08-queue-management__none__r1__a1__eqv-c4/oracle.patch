@@ -0,0 +1,83 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\QueuePermission;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use App\Models\User;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Validation\ValidationException;
+
+class SetQueueAccess
+{
+    /**
+     * @param  array<int, QueuePermission|string>  $permissions
+     */
+    public function __invoke(
+        EntityMembership $targetMembership,
+        Queue $queue,
+        User $actor,
+        array $permissions,
+    ): void {
+        Gate::forUser($actor)->authorize('manageAccess', $queue);
+
+        if ($targetMembership->entity_id !== $queue->entity_id) {
+            throw ValidationException::withMessages([
+                'entity_membership_id' => 'Membership and queue must belong to the same entity.',
+            ]);
+        }
+
+        $values = [];
+
+        foreach ($permissions as $permission) {
+            $value = $permission instanceof QueuePermission ? $permission->value : $permission;
+
+            if (! is_string($value) || QueuePermission::tryFrom($value) === null) {
+                $display = is_string($value) ? $value : get_debug_type($permission);
+
+                throw ValidationException::withMessages([
+                    'permissions' => "Unknown queue permission: {$display}.",
+                ]);
+            }
+
+            $values[] = $value;
+        }
+
+        $values = array_values(array_unique($values));
+
+        if ($values === []) {
+            $deleted = QueueAccess::query()
+                ->where('entity_membership_id', $targetMembership->id)
+                ->where('queue_id', $queue->id)
+                ->delete();
+
+            if ($deleted > 0) {
+                Log::channel('audit')->info('queue.access.revoked', [
+                    'queue_id' => $queue->id,
+                    'entity_membership_id' => $targetMembership->id,
+                    'actor_id' => $actor->id,
+                ]);
+            }
+
+            return;
+        }
+
+        QueueAccess::query()->updateOrCreate(
+            [
+                'entity_membership_id' => $targetMembership->id,
+                'queue_id' => $queue->id,
+            ],
+            ['permissions' => $values],
+        );
+
+        Log::channel('audit')->info('queue.access.granted', [
+            'queue_id' => $queue->id,
+            'entity_membership_id' => $targetMembership->id,
+            'actor_id' => $actor->id,
+            'permissions' => $values,
+        ]);
+    }
+}
