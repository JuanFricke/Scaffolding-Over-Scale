@@ -0,0 +1,45 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Validator;
+use Illuminate\Validation\Rule;
+use Illuminate\Validation\ValidationException;
+
+class AssignRole
+{
+    /**
+     * Set a member's role to admin or employee. Ownership only moves through TransferOwnership.
+     *
+     * @throws ValidationException when the role is not manageable
+     */
+    public function handle(User $actor, EntityMembership $membership, string $role): EntityMembership
+    {
+        Gate::forUser($actor)->authorize('assignRole', $membership);
+
+        $validated = Validator::make(['role' => $role], [
+            'role' => ['required', Rule::enum(UserRole::class)->only(UserRole::manageable())],
+        ])->validate();
+
+        // The owner keeps the role until ownership is transferred.
+        abort_if($membership->role === UserRole::Owner, 403);
+
+        $from = $membership->role;
+        $membership->update(['role' => $validated['role']]);
+
+        Log::channel('audit')->info('Entity member role changed', [
+            'entity_id' => $membership->entity_id,
+            'membership_id' => $membership->id,
+            'from' => $from->value,
+            'to' => $validated['role'],
+            'actor_id' => $actor->id,
+        ]);
+
+        return $membership;
+    }
+}
