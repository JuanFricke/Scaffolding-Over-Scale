+<?php
+
+use App\Livewire\Entity\Settings;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create(['name' => 'Acme', 'slug' => 'acme']);
+    $this->owner = joinEntity($this->entity, UserRole::Owner);
+    $this->admin = joinEntity($this->entity, UserRole::Admin);
+    $this->employee = joinEntity($this->entity, UserRole::Employee);
+});
+
+function settings(EntityMembership $as)
+{
+    return Livewire::actingAs($as->user)->test(Settings::class, ['entity' => $as->entity]);
+}
+
+test('the page renders for the owner only', function () {
+    $this->withoutVite();
+
+    $this->actingAs($this->owner->user)
+        ->get(route('entity.settings', $this->entity))
+        ->assertOk()
+        ->assertSee('Transferir propriedade')
+        ->assertSee($this->admin->user->email);
+
+    foreach ([$this->admin, $this->employee] as $other) {
+        $this->actingAs($other->user)->get(route('entity.settings', $this->entity))->assertForbidden();
+    }
+});
+
+test('the section title is translated', function () {
+    $this->withoutVite();
+    app()->setLocale('en');
+
+    $this->actingAs($this->owner->user)->get(route('entity.settings', $this->entity))->assertSee('Transfer ownership');
+});
+
+test('non-owners are refused at mount, even with the session on another entity', function () {
+    $mine = joinEntity(Entity::factory()->create(), UserRole::Owner);
+
+    Livewire::actingAs($this->admin->user)->test(Settings::class, ['entity' => $this->entity])->assertForbidden();
+    $this->withSession(['current_entity_id' => $mine->entity_id]);
+    Livewire::actingAs($mine->user)
+        ->test(Settings::class, ['entity' => $this->entity])
+        ->assertForbidden();
+});
+
+test('mount fills the form with the entity data', function () {
+    settings($this->owner)->assertSet('name', 'Acme')->assertSet('slug', 'acme');
+});
+
+test('save edits name and slug and follows the new slug', function () {
+    settings($this->owner)
+        ->set('name', 'Acme Ltda')
+        ->set('slug', 'acme-ltda')
+        ->call('save')
+        ->assertHasNoErrors()
+        ->assertRedirect(route('entity.settings', 'acme-ltda'));
+
+    expect($this->entity->fresh())->name->toBe('Acme Ltda')->slug->toBe('acme-ltda');
+});
+
+test('save with the same slug stays on the page', function () {
+    settings($this->owner)->set('name', 'Acme 2')->call('save')->assertHasNoErrors()->assertNoRedirect();
+
+    expect($this->entity->fresh()->name)->toBe('Acme 2');
+});
+
+test('save validates name and slug', function (string $name, string $slug, string $field) {
+    Entity::factory()->create(['slug' => 'taken']);
+
+    settings($this->owner)->set('name', $name)->set('slug', $slug)->call('save')->assertHasErrors($field);
+
+    expect($this->entity->fresh()->slug)->toBe('acme');
+})->with([
+    'empty name' => ['', 'acme', 'name'],
+    'empty slug' => ['Acme', '', 'slug'],
+    'taken slug' => ['Acme', 'taken', 'slug'],
+    'slug with spaces' => ['Acme', 'not a slug', 'slug'],
+    'uppercase slug' => ['Acme', 'Acme', 'slug'],
+]);
+
+test('a deleted entity still holds its slug', function () {
+    Entity::factory()->create(['slug' => 'gone'])->delete();
+
+    settings($this->owner)->set('slug', 'gone')->call('save')->assertHasErrors('slug');
+});
+
+test('save is refused when the caller lost ownership in the meantime', function () {
+    $component = settings($this->owner);
+    $this->owner->update(['role' => UserRole::Admin]);
+
+    $component->set('name', 'Hacked')->call('save')->assertForbidden();
+
+    expect($this->entity->fresh()->name)->toBe('Acme');
+});
+
+test('delete soft-deletes the entity, drops memberships and clears the session', function () {
+    $this->withSession(['current_entity_id' => $this->entity->id]);
+
+    settings($this->owner)->call('delete')->assertRedirect(route('home'));
+
+    expect(Entity::find($this->entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($this->entity->id))->not->toBeNull()
+        ->and(EntityMembership::count())->toBe(0)
+        ->and(session('current_entity_id'))->toBeNull();
+});
+
+test('delete keeps the session when another entity is current', function () {
+    $this->withSession(['current_entity_id' => 12345]);
+
+    settings($this->owner)->call('delete');
+
+    expect(session('current_entity_id'))->toBe(12345);
+});
+
+test('delete is refused once the caller is no longer the owner', function () {
+    $component = settings($this->owner);
+    $this->owner->update(['role' => UserRole::Admin]);
+
+    $component->call('delete')->assertForbidden();
+
+    expect(Entity::find($this->entity->id))->not->toBeNull();
+});
+
+test('transfer moves ownership to an admin atomically', function () {
+    settings($this->owner)
+        ->set('targetMembershipId', $this->admin->id)
+        ->call('transfer')
+        ->assertRedirect(route('entity.dashboard', $this->entity));
+
+    expect($this->owner->fresh()->role)->toBe(UserRole::Admin)
+        ->and($this->admin->fresh()->role)->toBe(UserRole::Owner)
+        ->and($this->entity->memberships()->owner()->count())->toBe(1);
+});
+
+test('transfer accepts the id as a string from the select', function () {
+    settings($this->owner)->set('targetMembershipId', (string) $this->admin->id)->call('transfer')->assertRedirect();
+
+    expect($this->admin->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('transfer refuses anyone who is not an admin of this entity', function (callable $target) {
+    $id = $target($this);
+
+    settings($this->owner)->set('targetMembershipId', $id)->call('transfer')->assertForbidden();
+
+    expect($this->owner->fresh()->role)->toBe(UserRole::Owner);
+})->with([
+    'employee' => [fn ($t) => $t->employee->id],
+    'the owner itself' => [fn ($t) => $t->owner->id],
+    'admin of another entity' => [fn () => joinEntity(Entity::factory()->create(), UserRole::Admin)->id],
+    'unknown id' => [fn () => 999999],
+    'null' => [fn () => null],
+    'garbage' => [fn () => 'abc'],
+    'array' => [fn () => [1, 2]],
+]);
+
+test('transfer is refused to non-owners', function () {
+    $component = settings($this->owner);
+    $this->owner->update(['role' => UserRole::Admin]);
+    $this->admin->update(['role' => UserRole::Owner]);
+
+    $component->set('targetMembershipId', $this->owner->id)->call('transfer')->assertForbidden();
+
+    expect($this->admin->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('transfer is refused when the owner row vanished', function () {
+    $component = settings($this->owner);
+    $this->owner->delete();
+
+    $component->set('targetMembershipId', $this->admin->id)->call('transfer')->assertForbidden();
+
+    expect($this->admin->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('the bound entity cannot be swapped from the client', function () {
+    $other = Entity::factory()->create();
+
+    expect(fn () => settings($this->owner)->set('entity', $other->id))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
