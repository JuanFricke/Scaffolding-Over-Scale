+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\AddMember;
+use App\Actions\AssignRole;
+use App\Actions\RemoveMember;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Members extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|email|exists:users,email')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+    }
+
+    public function addMember(AddMember $addMember): void
+    {
+        $this->authorize('update', $this->entity);
+
+        $this->validate();
+
+        $addMember->handle(auth()->user(), $this->entity, User::where('email', $this->email)->firstOrFail());
+
+        $this->reset('email');
+    }
+
+    public function assignRole(AssignRole $assignRole, mixed $membershipId, string $role): void
+    {
+        $assignRole->handle(auth()->user(), $this->membership($membershipId), $role);
+    }
+
+    public function removeMember(RemoveMember $removeMember, mixed $membershipId): void
+    {
+        $membership = $this->membership($membershipId);
+
+        $removeMember->handle(auth()->user(), $membership);
+
+        // Leaving on one's own: nothing left to see here.
+        if ($membership->user_id === auth()->id()) {
+            session()->forget('current_entity_id');
+
+            $this->redirectRoute('home');
+        }
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', [
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+            'roles' => UserRole::manageable(),
+        ]);
+    }
+
+    /**
+     * Resolve the membership inside this entity; anything else is a forged id.
+     */
+    protected function membership(mixed $membershipId): EntityMembership
+    {
+        $id = filter_var($membershipId, FILTER_VALIDATE_INT);
+
+        $membership = $id === false ? null : $this->entity->memberships()->find($id);
+
+        abort_if($membership === null, 403);
+
+        return $membership;
+    }
+}
diff --git a/app/Livewire/Entity/Settings.php b/app/Livewire/Entity/Settings.php
new file mode 100644
index 0000000..cc15cce
--- /dev/null
+++ b/app/Livewire/Entity/Settings.php
@@ -0,0 +1,89 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\DeleteEntity;
+use App\Actions\TransferOwnership;
+use App\Actions\UpdateEntity;
+use App\Models\Entity;
+use Illuminate\Contracts\View\View;
+use Illuminate\Validation\Rule;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Settings extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    public string $slug = '';
+
+    /**
+     * Raw client input, never validated into an error: anything that is not an admin of this
+     * entity (other than the caller) is a 403 in TransferOwnership.
+     */
+    public $targetMembershipId = null;
+
+    protected function rules(): array
+    {
+        return [
+            'slug' => ['required', 'string', 'max:255', 'alpha_dash:ascii', 'lowercase', Rule::unique('entities', 'slug')->ignore($this->entity)],
+        ];
+    }
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(UpdateEntity $updateEntity): void
+    {
+        $this->authorize('manageSettings', $this->entity);
+
+        $this->validate();
+
+        $slugChanged = $this->slug !== $this->entity->slug;
+
+        $updateEntity->handle(auth()->user(), $this->entity, $this->name, $this->slug);
+
+        // The page URL carries the old slug.
+        if ($slugChanged) {
+            $this->redirectRoute('entity.settings', $this->entity);
+
+            return;
+        }
+
+        session()->flash('status', __('ui.settings_saved'));
+    }
+
+    public function delete(DeleteEntity $deleteEntity): void
+    {
+        $deleteEntity->handle(auth()->user(), $this->entity);
+
+        $this->redirectRoute('home');
+    }
+
+    public function transfer(TransferOwnership $transferOwnership): void
+    {
+        $transferOwnership->handle(auth()->user(), $this->entity, $this->targetMembershipId);
+
+        $this->redirectRoute('entity.dashboard', $this->entity);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', [
+            'admins' => $this->entity->memberships()->admin()->with('user')->orderBy('id')->get(),
+        ]);
+    }
+}
