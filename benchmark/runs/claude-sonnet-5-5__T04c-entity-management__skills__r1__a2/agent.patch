@@ -0,0 +1,43 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class RemoveMember
+{
+    /**
+     * Remove a member; the owner and the last manager (owner/admin) can never be removed.
+     */
+    public function handle(User $actor, EntityMembership $membership): void
+    {
+        Gate::forUser($actor)->authorize('delete', $membership);
+
+        DB::transaction(function () use ($membership) {
+            $isManager = in_array($membership->role, [UserRole::Owner, UserRole::Admin], true);
+
+            $otherManagers = EntityMembership::query()
+                ->where('entity_id', $membership->entity_id)
+                ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+                ->whereKeyNot($membership->id)
+                ->lockForUpdate()
+                ->exists();
+
+            abort_if($isManager && ! $otherManagers, 403);
+
+            $membership->delete();
+        });
+
+        Log::channel('audit')->info('Entity member removed', [
+            'entity_id' => $membership->entity_id,
+            'membership_id' => $membership->id,
+            'user_id' => $membership->user_id,
+            'actor_id' => $actor->id,
+        ]);
+    }
+}
diff --git a/app/Actions/TransferOwnership.php b/app/Actions/TransferOwnership.php
new file mode 100644
index 0000000..102e7da
--- /dev/null
+++ b/app/Actions/TransferOwnership.php
@@ -0,0 +1,44 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+use Illuminate\Support\Facades\Log;
+
+class TransferOwnership
+{
+    /**
+     * Hand ownership to another admin of the entity; the former owner becomes an admin.
+     * Anything other than an admin of this entity (other than the owner) is a 403.
+     */
+    public function handle(User $actor, Entity $entity, mixed $targetMembershipId): void
+    {
+        Gate::forUser($actor)->authorize('manageSettings', $entity);
+
+        $targetId = filter_var($targetMembershipId, FILTER_VALIDATE_INT);
+        abort_if($targetId === false, 403);
+
+        DB::transaction(function () use ($actor, $entity, $targetId) {
+            $owner = $entity->memberships()->owner()->lockForUpdate()->first();
+            abort_if($owner === null || $owner->user_id !== $actor->id, 403);
+
+            $target = $entity->memberships()->admin()->whereKey($targetId)->lockForUpdate()->first();
+            abort_if($target === null, 403);
+
+            // Demote first: the unique owner index never sees two owners.
+            $owner->update(['role' => UserRole::Admin]);
+            $target->update(['role' => UserRole::Owner]);
+
+            Log::channel('audit')->info('Entity ownership transferred', [
+                'entity_id' => $entity->id,
+                'from_membership_id' => $owner->id,
+                'to_membership_id' => $target->id,
+                'actor_id' => $actor->id,
+            ]);
+        });
+    }
+}
