+beforeEach(fn () => $this->withoutVite());
+
+test('the owner sees the entity, a welcome, the owner notice and both links', function () {
+    $entity = Entity::factory()->create(['name' => 'Clinica Sol']);
+    $owner = joinEntity($entity, UserRole::Owner)->user;
+
+    $this->actingAs($owner)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee('Clinica Sol')
+        ->assertSee('Bem-vindo(a), '.e($owner->name), false)
+        ->assertSee('Você é o proprietário desta entidade.')
+        ->assertSee(route('entity.members', $entity))
+        ->assertSee(route('entity.settings', $entity));
+});
+
+test('the notice is translated', function () {
+    app()->setLocale('en');
+    $entity = Entity::factory()->create();
+    $owner = joinEntity($entity, UserRole::Owner)->user;
+
+    $this->actingAs($owner)->get(route('entity.dashboard', $entity))
+        ->assertSee('You are the owner of this entity.')
+        ->assertSee('Members');
+});
+
+test('admins and employees never see the settings url or the owner notice', function (UserRole $role) {
+    $entity = Entity::factory()->create();
+    $user = joinEntity($entity, $role)->user;
+
+    $this->actingAs($user)
+        ->get(route('entity.dashboard', $entity))
+        ->assertOk()
+        ->assertSee(route('entity.members', $entity))
+        ->assertDontSee(route('entity.settings', $entity))
+        ->assertDontSee('Você é o proprietário desta entidade.');
+})->with([UserRole::Admin, UserRole::Employee]);
+
+test('a non-member gets 403 even when the session points at an entity they belong to', function () {
+    $entity = Entity::factory()->create();
+    $mine = joinEntity(Entity::factory()->create(), UserRole::Owner);
+
+    $this->actingAs($mine->user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->get(route('entity.dashboard', $entity))
+        ->assertForbidden();
+});
+
+test('guests are sent to login and unknown or deleted entities are 404', function () {
+    $entity = Entity::factory()->create();
+    $owner = joinEntity($entity, UserRole::Owner)->user;
+
+    $this->get(route('entity.dashboard', $entity))->assertRedirect(route('login'));
+
+    $entity->delete();
+    $this->actingAs($owner)->get(route('entity.dashboard', $entity))->assertNotFound();
+});
+
+test('unverified users are sent to verification', function () {
+    $entity = Entity::factory()->create();
+    $user = joinEntity($entity, UserRole::Owner)->user;
+    $user->forceFill(['email_verified_at' => null])->save();
+
+    $this->actingAs($user)->get(route('entity.dashboard', $entity))->assertRedirect(route('verification.notice'));
+});
diff --git a/tests/Feature/EntityMembersTest.php b/tests/Feature/EntityMembersTest.php
new file mode 100644
index 0000000..6cb43ae
--- /dev/null
+++ b/tests/Feature/EntityMembersTest.php
@@ -0,0 +1,162 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Features\SupportLockedProperties\CannotUpdateLockedPropertyException;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = joinEntity($this->entity, UserRole::Owner);
+    $this->admin = joinEntity($this->entity, UserRole::Admin);
+    $this->employee = joinEntity($this->entity, UserRole::Employee);
+});
+
+function members(EntityMembership $as)
+{
+    return Livewire::actingAs($as->user)->test(Members::class, ['entity' => $as->entity]);
+}
+
+test('the page lists members with their roles', function () {
+    $this->withoutVite();
+
+    $this->actingAs($this->employee->user)
+        ->get(route('entity.members', $this->entity))
+        ->assertOk()
+        ->assertSee($this->owner->user->email)
+        ->assertSee('Proprietário')
+        ->assertSee($this->admin->user->name);
+});
+
+test('non-members get 403 on the page and on mount', function () {
+    $stranger = joinEntity(Entity::factory()->create(), UserRole::Owner);
+
+    $this->actingAs($stranger->user)
+        ->withSession(['current_entity_id' => $stranger->entity_id])
+        ->get(route('entity.members', $this->entity))
+        ->assertForbidden();
+
+    Livewire::actingAs($stranger->user)->test(Members::class, ['entity' => $this->entity])->assertForbidden();
+});
+
+test('owner and admin add an existing user as employee', function (string $who) {
+    $user = User::factory()->create(['email' => 'novo@example.com']);
+
+    members($this->$who)
+        ->set('email', 'novo@example.com')
+        ->call('addMember')
+        ->assertHasNoErrors()
+        ->assertSet('email', '');
+
+    expect($this->entity->memberships()->where('user_id', $user->id)->first()->role)->toBe(UserRole::Employee);
+})->with(['owner', 'admin']);
+
+test('adding validates the e-mail', function (string $email) {
+    members($this->owner)->set('email', $email)->call('addMember')->assertHasErrors('email');
+})->with(['', 'not-an-email', 'ghost@example.com']);
+
+test('adding a duplicate member is an error on email', function () {
+    members($this->owner)
+        ->set('email', $this->employee->user->email)
+        ->call('addMember')
+        ->assertHasErrors('email');
+
+    expect($this->entity->memberships()->count())->toBe(3);
+});
+
+test('employees cannot add or assign', function () {
+    $user = User::factory()->create(['email' => 'novo@example.com']);
+
+    members($this->employee)->set('email', 'novo@example.com')->call('addMember')->assertForbidden();
+    members($this->employee)->call('assignRole', $this->admin->id, 'employee')->assertForbidden();
+
+    expect($this->entity->memberships()->where('user_id', $user->id)->exists())->toBeFalse()
+        ->and($this->admin->fresh()->role)->toBe(UserRole::Admin);
+});
+
+test('roles can be assigned between admin and employee', function () {
+    members($this->owner)->call('assignRole', $this->employee->id, 'admin')->assertHasNoErrors();
+    expect($this->employee->fresh()->role)->toBe(UserRole::Admin);
+
+    members($this->admin)->call('assignRole', $this->employee->id, 'employee')->assertHasNoErrors();
+    expect($this->employee->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('only admin and employee are accepted as roles', function (string $role) {
+    members($this->owner)->call('assignRole', $this->employee->id, $role)->assertHasErrors('role');
+
+    expect($this->employee->fresh()->role)->toBe(UserRole::Employee)
+        ->and($this->entity->memberships()->owner()->count())->toBe(1);
+})->with(['owner', 'superuser', '']);
+
+test('the owner role cannot be changed through assignRole', function () {
+    members($this->admin)->call('assignRole', $this->owner->id, 'employee')->assertForbidden();
+
+    expect($this->owner->fresh()->role)->toBe(UserRole::Owner);
+});
+
+test('forged membership ids are refused', function () {
+    $foreign = joinEntity(Entity::factory()->create(), UserRole::Employee);
+
+    members($this->owner)->call('assignRole', $foreign->id, 'admin')->assertForbidden();
+    members($this->owner)->call('removeMember', $foreign->id)->assertForbidden();
+    members($this->owner)->call('removeMember', 999999)->assertForbidden();
+    members($this->owner)->call('removeMember', ['1', '2'])->assertForbidden();
+
+    expect($foreign->fresh()->role)->toBe(UserRole::Employee);
+});
+
+test('owner and admin remove members', function () {
+    members($this->owner)->call('removeMember', $this->admin->id)->assertHasNoErrors();
+    members($this->owner)->call('removeMember', $this->employee->id);
+
+    expect($this->entity->memberships()->count())->toBe(1);
+});
+
+test('the owner is never removed', function () {
+    members($this->admin)->call('removeMember', $this->owner->id)->assertForbidden();
+    members($this->owner)->call('removeMember', $this->owner->id)->assertForbidden();
+
+    expect($this->owner->fresh())->not->toBeNull();
+});
+
+test('the last manager is never removed', function () {
+    // Defensive: with the owner row gone, the lone admin is the last manager.
+    $this->owner->delete();
+
+    members($this->admin)->call('removeMember', $this->admin->id)->assertForbidden();
+
+    expect($this->admin->fresh())->not->toBeNull();
+});
+
+test('employees cannot remove others but may leave', function () {
+    members($this->employee)->call('removeMember', $this->admin->id)->assertForbidden();
+
+    members($this->employee)
+        ->call('removeMember', $this->employee->id)
+        ->assertRedirect(route('home'));
+
+    expect($this->employee->fresh())->toBeNull()
+        ->and($this->admin->fresh())->not->toBeNull();
+});
+
+test('leaving clears the current entity from the session', function () {
+    $this->withSession(['current_entity_id' => $this->entity->id]);
+
+    members($this->employee)->call('removeMember', $this->employee->id);
+
+    expect(session('current_entity_id'))->toBeNull();
+});
+
+test('the entity cannot be swapped from the client', function () {
+    $other = Entity::factory()->create();
+
+    expect(fn () => members($this->owner)->set('entity', $other->id))
+        ->toThrow(CannotUpdateLockedPropertyException::class);
+});
diff --git a/tests/Feature/EntityModelsTest.php b/tests/Feature/EntityModelsTest.php
new file mode 100644
index 0000000..cf6f015
--- /dev/null
+++ b/tests/Feature/EntityModelsTest.php
@@ -0,0 +1,112 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Database\QueryException;
+use Illuminate\Database\UniqueConstraintViolationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+
+uses(RefreshDatabase::class);
+
+test('entities bind routes by slug and soft delete', function () {
+    $entity = Entity::factory()->create();
+
+    expect($entity->getRouteKeyName())->toBe('slug');
+
+    $entity->delete();
+
+    expect(Entity::find($entity->id))->toBeNull()
+        ->and(Entity::withTrashed()->find($entity->id))->not->toBeNull();
+});
+
+test('entity slug is unique', function () {
+    Entity::factory()->create(['slug' => 'acme']);
+
+    expect(fn () => Entity::factory()->create(['slug' => 'acme']))->toThrow(UniqueConstraintViolationException::class);
+    expect(collect(Schema::getIndexes('entities'))->pluck('name'))->toContain('entities_slug_unique');
+});
+
+test('membership factory creates its entity and user as an employee', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect($membership->entity)->toBeInstanceOf(Entity::class)
+        ->and($membership->user)->toBeInstanceOf(User::class)
+        ->and($membership->role)->toBe(UserRole::Employee);
+});
+
+test('membership factory states set the role', function () {
+    expect(EntityMembership::factory()->owner()->create()->role)->toBe(UserRole::Owner)
+        ->and(EntityMembership::factory()->admin()->create()->role)->toBe(UserRole::Admin)
+        ->and(EntityMembership::factory()->employee()->create()->role)->toBe(UserRole::Employee);
+});
+
+test('role scopes filter memberships', function () {
+    $entity = Entity::factory()->create();
+    $owner = joinEntity($entity, UserRole::Owner);
+    $admin = joinEntity($entity, UserRole::Admin);
+    $employee = joinEntity($entity, UserRole::Employee);
+
+    expect(EntityMembership::owner()->pluck('id')->all())->toBe([$owner->id])
+        ->and(EntityMembership::admin()->pluck('id')->all())->toBe([$admin->id])
+        ->and(EntityMembership::employee()->pluck('id')->all())->toBe([$employee->id]);
+});
+
+test('manageable roles exclude the owner', function () {
+    expect(UserRole::manageable())->toBe([UserRole::Admin, UserRole::Employee]);
+});
+
+test('entity and user relations resolve memberships', function () {
+    $entity = Entity::factory()->create();
+    $owner = joinEntity($entity, UserRole::Owner);
+    $employee = joinEntity($entity, UserRole::Employee);
+
+    expect($entity->memberships)->toHaveCount(2)
+        ->and($entity->users->pluck('id')->sort()->values()->all())->toBe([$owner->user_id, $employee->user_id])
+        ->and($entity->owner()->first()->id)->toBe($owner->id)
+        ->and($owner->user->memberships)->toHaveCount(1)
+        ->and($owner->user->entities->first()->id)->toBe($entity->id)
+        ->and($owner->user->membershipFor($entity->id)->id)->toBe($owner->id)
+        ->and($owner->user->membershipFor($entity->id + 1))->toBeNull();
+});
+
+test('a user cannot join the same entity twice', function () {
+    $membership = EntityMembership::factory()->create();
+
+    expect(fn () => EntityMembership::factory()->create([
+        'entity_id' => $membership->entity_id,
+        'user_id' => $membership->user_id,
+    ]))->toThrow(UniqueConstraintViolationException::class);
+});
+
+test('the database rejects a second owner in the same entity', function () {
+    $entity = Entity::factory()->create();
+    joinEntity($entity, UserRole::Owner);
+
+    expect(fn () => joinEntity($entity, UserRole::Owner))->toThrow(QueryException::class);
+
+    // Another entity may have its own owner, and any number of admins/employees coexist.
+    joinEntity(Entity::factory()->create(), UserRole::Owner);
+    joinEntity($entity, UserRole::Admin);
+    joinEntity($entity, UserRole::Admin);
+    joinEntity($entity, UserRole::Employee);
+
+    expect($entity->memberships()->count())->toBe(4);
+});
+
+test('the one-owner index and generated column exist', function () {
+    expect(collect(Schema::getIndexes('entity_memberships'))->pluck('name'))
+        ->toContain('entity_memberships_one_owner')
+        ->toContain('entity_memberships_entity_user_unique')
+        ->and(Schema::hasColumn('entity_memberships', 'owner_seq'))->toBeTrue();
+});
+
+test('memberships are deleted with the entity or the user', function () {
+    $membership = EntityMembership::factory()->create();
+
+    $membership->user->delete();
+
+    expect(EntityMembership::count())->toBe(0);
+});
diff --git a/tests/Feature/EntityPickTest.php b/tests/Feature/EntityPickTest.php
