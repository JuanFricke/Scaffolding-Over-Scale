+<?php
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Log;
+
+uses(RefreshDatabase::class);
+
+test('a member picks an entity: session set, audit logged, redirected to the dashboard', function () {
+    $entity = Entity::factory()->create();
+    $user = joinEntity($entity, UserRole::Employee)->user;
+
+    Log::shouldReceive('channel')->with('audit')->once()->andReturnSelf();
+    Log::shouldReceive('info')->once()->withArgs(fn ($message, $context) => $context['entity_id'] === $entity->id && $context['user_id'] === $user->id);
+
+    $this->actingAs($user)
+        ->post(route('entity.pick', $entity))
+        ->assertRedirect(route('entity.dashboard', $entity))
+        ->assertSessionHas('current_entity_id', $entity->id);
+});
+
+test('a non-member gets 403 and the session stays untouched', function () {
+    $entity = Entity::factory()->create();
+    $mine = joinEntity(Entity::factory()->create(), UserRole::Owner);
+
+    $this->actingAs($mine->user)
+        ->withSession(['current_entity_id' => $mine->entity_id])
+        ->post(route('entity.pick', $entity))
+        ->assertForbidden()
+        ->assertSessionHas('current_entity_id', $mine->entity_id);
+});
+
+test('guests and unverified users cannot pick', function () {
+    $entity = Entity::factory()->create();
+    $unverified = User::factory()->unverified()->create();
+    joinEntity($entity, UserRole::Owner)->user;
+
+    $this->post(route('entity.pick', $entity))->assertRedirect(route('login'));
+    $this->actingAs($unverified)->post(route('entity.pick', $entity))->assertRedirect(route('verification.notice'));
+});
+
+test('picking a deleted entity is a 404', function () {
+    $entity = Entity::factory()->create();
+    $user = joinEntity($entity, UserRole::Owner)->user;
+    $entity->delete();
+
+    $this->actingAs($user)->post(route('entity.pick', $entity))->assertNotFound();
+});
diff --git a/tests/Feature/EntityPolicyTest.php b/tests/Feature/EntityPolicyTest.php
new file mode 100644
index 0000000..f3622e7
--- /dev/null
+++ b/tests/Feature/EntityPolicyTest.php
@@ -0,0 +1,88 @@
+<?php
+
+use App\Models\Entity;
+use App\Models\User;
+use App\Models\UserRole;
+use App\Policies\EntityMembershipPolicy;
+use App\Policies\EntityPolicy;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    $this->entity = Entity::factory()->create();
+    $this->owner = joinEntity($this->entity, UserRole::Owner);
+    $this->admin = joinEntity($this->entity, UserRole::Admin);
+    $this->employee = joinEntity($this->entity, UserRole::Employee);
+    $this->outsider = User::factory()->create();
+    $this->policy = new EntityPolicy;
+    $this->memberships = new EntityMembershipPolicy;
+});
+
+test('anyone authenticated may create an entity', function () {
+    expect($this->policy->create($this->outsider))->toBeTrue();
+});
+
+test('any member may view the entity, a non-member may not', function () {
+    expect($this->policy->view($this->owner->user, $this->entity))->toBeTrue()
+        ->and($this->policy->view($this->admin->user, $this->entity))->toBeTrue()
+        ->and($this->policy->view($this->employee->user, $this->entity))->toBeTrue()
+        ->and($this->policy->view($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('owner and admin may update and delete the entity', function () {
+    foreach (['update', 'delete'] as $ability) {
+        expect($this->policy->$ability($this->owner->user, $this->entity))->toBeTrue()
+            ->and($this->policy->$ability($this->admin->user, $this->entity))->toBeTrue()
+            ->and($this->policy->$ability($this->employee->user, $this->entity))->toBeFalse()
+            ->and($this->policy->$ability($this->outsider, $this->entity))->toBeFalse();
+    }
+});
+
+test('only the owner manages settings', function () {
+    expect($this->policy->manageSettings($this->owner->user, $this->entity))->toBeTrue()
+        ->and($this->policy->manageSettings($this->admin->user, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($this->employee->user, $this->entity))->toBeFalse()
+        ->and($this->policy->manageSettings($this->outsider, $this->entity))->toBeFalse();
+});
+
+test('a membership of another entity grants nothing here', function () {
+    $other = joinEntity(Entity::factory()->create(), UserRole::Owner)->user;
+
+    expect($this->policy->view($other, $this->entity))->toBeFalse()
+        ->and($this->memberships->view($other, $this->employee))->toBeFalse()
+        ->and($this->memberships->assignRole($other, $this->employee))->toBeFalse();
+});
+
+test('any member may view a membership of the entity', function () {
+    expect($this->memberships->view($this->employee->user, $this->owner))->toBeTrue()
+        ->and($this->memberships->view($this->outsider, $this->owner))->toBeFalse();
+});
+
+test('owner and admin may assign roles', function () {
+    expect($this->memberships->assignRole($this->owner->user, $this->employee))->toBeTrue()
+        ->and($this->memberships->assignRole($this->admin->user, $this->employee))->toBeTrue()
+        ->and($this->memberships->assignRole($this->employee->user, $this->admin))->toBeFalse()
+        ->and($this->memberships->assignRole($this->outsider, $this->employee))->toBeFalse();
+});
+
+test('the owner membership can never be deleted', function () {
+    expect($this->memberships->delete($this->owner->user, $this->owner))->toBeFalse()
+        ->and($this->memberships->delete($this->admin->user, $this->owner))->toBeFalse();
+});
+
+test('members may remove themselves, otherwise only owner or admin may delete', function () {
+    expect($this->memberships->delete($this->employee->user, $this->employee))->toBeTrue()
+        ->and($this->memberships->delete($this->admin->user, $this->admin))->toBeTrue()
+        ->and($this->memberships->delete($this->admin->user, $this->employee))->toBeTrue()
+        ->and($this->memberships->delete($this->owner->user, $this->admin))->toBeTrue()
+        ->and($this->memberships->delete($this->employee->user, $this->admin))->toBeFalse()
+        ->and($this->memberships->delete($this->outsider, $this->employee))->toBeFalse();
+});
+
+test('the policies are registered with the gate', function () {
+    expect($this->owner->user->can('manageSettings', $this->entity))->toBeTrue()
+        ->and($this->admin->user->can('manageSettings', $this->entity))->toBeFalse()
+        ->and($this->owner->user->can('assignRole', $this->employee))->toBeTrue()
+        ->and($this->owner->user->can('delete', $this->owner))->toBeFalse();
+});
diff --git a/tests/Feature/EntitySettingsTest.php b/tests/Feature/EntitySettingsTest.php
new file mode 100644
