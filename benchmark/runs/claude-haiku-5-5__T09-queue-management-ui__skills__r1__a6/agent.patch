+
+test('an employee who tampers the selection to an ungranted queue is refused and sees nothing', function () {
+    $entity = Entity::factory()->create();
+    serveOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+    $ticket = Ticket::factory()->forQueue($queue)->create();
