+<?php
+
+test('the English and Portuguese interface strings define the same keys', function () {
+    $en = array_keys(require lang_path('en/ui.php'));
+    $ptBr = array_keys(require lang_path('pt_BR/ui.php'));
+
+    expect($en)->toEqualCanonicalizing($ptBr);
+});
+
+test('the queue management and serve screens have translations in both locales', function () {
+    $keys = [
+        'queues_title', 'queues_create', 'queues_details', 'queues_rename', 'queues_deactivate',
+        'queues_reactivate', 'queues_access_button', 'queues_toggle_title', 'queues_toggle_message',
+        'serve_call_next', 'serve_last_called', 'serve_empty', 'serve_inactive', 'serve_rate_limited',
+        'channel_totem', 'channel_virtual', 'channel_printed',
+        'members_tab_members', 'members_tab_invites', 'nav_queues', 'nav_serve',
+    ];
+
+    foreach (['en', 'pt_BR'] as $locale) {
+        foreach ($keys as $key) {
+            expect(__("ui.{$key}", [], $locale))->not->toBe("ui.{$key}");
+        }
+    }
+});
