diff --git a/tests/Feature/Entity/MembersTabsTest.php b/tests/Feature/Entity/MembersTabsTest.php
new file mode 100644
index 0000000..ea85542
--- /dev/null
+++ b/tests/Feature/Entity/MembersTabsTest.php
@@ -0,0 +1,77 @@
+<?php
+
+use App\Livewire\Entity\Members;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Livewire\Livewire;
+
+uses(RefreshDatabase::class);
+
+function membersTabsOwner(Entity $entity): User
+{
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    return $owner;
+}
+
+test('the members page opens on the members tab without the invite form', function () {
+    $entity = Entity::factory()->create();
+    $owner = membersTabsOwner($entity);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->assertSet('activeTab', 'members')
+        ->assertSee('role="tablist"', false)
+        ->assertSee(__('ui.members_tab_members'))
+        ->assertSee(__('ui.members_tab_invites'))
+        ->assertSee(__('ui.members_list_title'))
+        ->assertDontSee(__('ui.members_invite_title'))
+        ->assertDontSee('name="inviteEmail"', false)
+        ->assertDontSee(__('ui.invites_title'));
+});
+
+test('the invites tab shows the invite form and pending invites only', function () {
+    $entity = Entity::factory()->create();
+    $owner = membersTabsOwner($entity);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('setActiveTab', 'invites')
+        ->assertSet('activeTab', 'invites')
+        ->assertSee(__('ui.members_invite_title'))
+        ->assertSee('name="inviteEmail"', false)
+        ->assertSee(__('ui.invites_title'))
+        ->assertDontSee($owner->email);
+});
+
+test('switching back to the members tab hides the invite form', function () {
+    $entity = Entity::factory()->create();
+    $owner = membersTabsOwner($entity);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('setActiveTab', 'invites')
+        ->call('setActiveTab', 'members')
+        ->assertSet('activeTab', 'members')
+        ->assertDontSee(__('ui.members_invite_title'));
+});
+
+test('an unknown tab name is ignored', function () {
+    $entity = Entity::factory()->create();
+    $owner = membersTabsOwner($entity);
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    Livewire::test(Members::class, ['entity' => $entity])
+        ->call('setActiveTab', 'invites')
+        ->call('setActiveTab', 'settings')
+        ->assertSet('activeTab', 'invites')
+        ->call('setActiveTab', '')
+        ->assertSet('activeTab', 'invites');
+});
