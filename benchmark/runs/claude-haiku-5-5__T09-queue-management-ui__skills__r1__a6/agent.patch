+
+test('successful calls are rate limited per user and entity', function () {
+    $entity = Entity::factory()->create();
+    $owner = serveOwner($entity);
+    $queue = Queue::factory()->for($entity)->create();
+    foreach (range(1, 11) as $_) {
+        Ticket::factory()->forQueue($queue)->create();
+    }
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    $component = Livewire::test(Serve::class, ['entity' => $entity])
+        ->set('selectedQueueId', $queue->id);
+
+    for ($i = 0; $i < 10; $i++) {
+        $component->call('callNext')->assertHasNoErrors();
+    }
+
+    expect(Ticket::query()->where('status', TicketStatus::Waiting)->count())->toBe(1);
+
+    $component->call('callNext')
+        ->assertSet('notice', __('ui.serve_rate_limited'));
+
+    expect(Ticket::query()->where('status', TicketStatus::Waiting)->count())->toBe(1);
+});
