+    $queue = Queue::factory()->for($entity)->create(['name' => 'Caixa']);
+    $employee = User::factory()->create();
+    $membership = EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+
+    $this->actingAs($owner)->post(route('entity.pick', $entity->slug));
+
+    // A refused call leaves the Livewire snapshot unusable, so each attempt
+    // mounts a fresh component as the owner (running any owner-only setup
+    // steps first) and then calls as the employee.
+    $refused = function (string $method, array $args, array $ownerSteps = []) use ($entity, $owner, $employee): void {
+        $this->actingAs($owner);
+        $component = Livewire::test(Queues::class, ['entity' => $entity]);
+
+        foreach ($ownerSteps as [$step, $stepArgs]) {
+            $component->call($step, ...$stepArgs);
+        }
+
+        $this->actingAs($employee);
+        $component->call($method, ...$args)->assertForbidden();
+    };
+
+    $refused('create', []);
+    $refused('openQueue', [$queue->id]);
+    $refused('startRename', [$queue->id]);
+    $refused('rename', [], [['startRename', [$queue->id]]]);
+    $refused('confirmToggle', [], [['openQueue', [$queue->id]]]);
+    $refused('toggleActive', [$queue->id]);
+    $refused('openAccess', [$queue->id]);
+    $refused('grantAccess', [$membership->id], [['openAccess', [$queue->id]]]);
+    $refused('revokeAccess', [$membership->id], [['openAccess', [$queue->id]]]);
+
+    expect($queue->fresh())
+        ->name->toBe('Caixa')
+        ->is_active->toBeTrue()
+        ->and(Queue::query()->count())->toBe(1)
+        ->and(QueueAccess::query()->count())->toBe(0);
