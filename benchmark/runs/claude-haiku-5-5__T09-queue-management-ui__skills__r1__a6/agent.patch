diff --git a/app/Livewire/Entity/Queues.php b/app/Livewire/Entity/Queues.php
new file mode 100644
index 0000000..7ab311c
--- /dev/null
+++ b/app/Livewire/Entity/Queues.php
@@ -0,0 +1,255 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CreateQueue;
+use App\Actions\SetQueueAccess;
+use App\Actions\UpdateQueue;
+use App\Enums\QueuePermission;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\QueueAccess;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Queues extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    #[Validate('required|string|max:255')]
+    public string $name = '';
+
+    /**
+     * Whether the create modal is open. Client-writable flag — every action
+     * re-authorizes server-side, so opening it proves nothing.
+     */
+    public bool $creating = false;
+
+    /**
+     * Queue shown in the detail modal. Untrusted client state — always
+     * re-resolved scoped to the entity before use.
+     */
+    public ?int $viewingQueueId = null;
+
+    /**
+     * Whether the toggle-confirmation modal is open for the viewed queue.
+     */
+    public bool $confirmingToggle = false;
+
+    /**
+     * Queue whose name is being edited in the detail modal.
+     */
+    public ?int $editingQueueId = null;
+
+    #[Validate('required|string|max:255')]
+    public string $renameName = '';
+
+    /**
+     * Queue whose access grants are shown. Untrusted client state — always
+     * re-resolved scoped to the entity (see accessQueue()).
+     */
+    public ?int $accessQueueId = null;
+
+    public bool $managingAccess = false;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('create', [Queue::class, $entity]);
+
+        $this->entity = $entity;
+    }
+
+    public function openCreate(): void
+    {
+        $this->authorize('create', [Queue::class, $this->entity]);
+
+        $this->creating = true;
+        $this->resetValidation('name');
+    }
+
+    public function closeCreate(): void
+    {
+        $this->reset('name', 'creating');
+        $this->resetValidation('name');
+    }
+
+    public function create(): void
+    {
+        $this->authorize('create', [Queue::class, $this->entity]);
+
+        $this->validateOnly('name');
+
+        try {
+            (new CreateQueue)($this->entity, auth()->user(), $this->name);
+        } catch (ValidationException $e) {
+            $this->addError('name', $this->firstMessage($e));
+
+            return;
+        }
+
+        $this->closeCreate();
+    }
+
+    public function openQueue(int $id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+
+        $this->authorize('update', $queue);
+
+        $this->viewingQueueId = $queue->id;
+        $this->resetNested();
+    }
+
+    public function closeQueue(): void
+    {
+        $this->viewingQueueId = null;
+        $this->resetNested();
+    }
+
+    public function startRename(int $id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+
+        $this->authorize('update', $queue);
+
+        $this->editingQueueId = $queue->id;
+        $this->renameName = $queue->name;
+        $this->resetValidation('renameName');
+    }
+
+    public function cancelRename(): void
+    {
+        $this->reset('editingQueueId', 'renameName');
+        $this->resetValidation('renameName');
+    }
+
+    public function rename(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->editingQueueId ?? 0);
+
+        $this->authorize('update', $queue);
+
+        $this->validateOnly('renameName');
+
+        try {
+            (new UpdateQueue)($queue, auth()->user(), name: $this->renameName, slug: Str::slug($this->renameName));
+        } catch (ValidationException $e) {
+            $this->addError('renameName', $this->firstMessage($e));
+
+            return;
+        }
+
+        $this->cancelRename();
+    }
+
+    public function confirmToggle(): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->viewingQueueId ?? 0);
+
+        $this->authorize('update', $queue);
+
+        $this->confirmingToggle = true;
+    }
+
+    public function cancelToggle(): void
+    {
+        $this->confirmingToggle = false;
+    }
+
+    public function toggleActive(int $id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+
+        $this->authorize('update', $queue);
+
+        (new UpdateQueue)($queue, auth()->user(), isActive: ! $queue->is_active);
+
+        $this->confirmingToggle = false;
+    }
+
+    public function openAccess(int $id): void
+    {
+        $queue = $this->entity->queues()->findOrFail($id);
+
+        $this->authorize('manageAccess', $queue);
+
+        $this->accessQueueId = $queue->id;
+        $this->managingAccess = true;
+    }
+
+    public function closeAccess(): void
+    {
+        $this->reset('accessQueueId', 'managingAccess');
+    }
+
+    /**
+     * Grant the call permission on the open access queue (audited by SetQueueAccess).
+     */
+    public function grantAccess(int $membershipId): void
+    {
+        $this->setAccess($membershipId, [QueuePermission::Call]);
+    }
+
+    /**
+     * Revoke every queue permission of the membership on the open access queue.
+     */
+    public function revokeAccess(int $membershipId): void
+    {
+        $this->setAccess($membershipId, []);
+    }
+
+    public function render(): View
+    {
+        $accessQueue = $this->accessQueue();
+
+        return view('livewire.entity.queues', [
+            'queues' => $this->entity->queues()->orderBy('name')->get(),
+            'viewingQueue' => $this->viewingQueue(),
+            'accessQueue' => $accessQueue,
+            'accessGrants' => $accessQueue
+                ? QueueAccess::query()->where('queue_id', $accessQueue->id)->get()
+                : collect(),
+            'memberships' => $this->entity->memberships()->with('user')->orderBy('id')->get(),
+        ]);
+    }
+
+    private function setAccess(int $membershipId, array $permissions): void
+    {
+        $queue = $this->entity->queues()->findOrFail($this->accessQueueId ?? 0);
+        $membership = $this->entity->memberships()->findOrFail($membershipId);
+
+        (new SetQueueAccess)($membership, $queue, auth()->user(), $permissions);
+    }
+
+    private function viewingQueue(): ?Queue
+    {
+        return $this->viewingQueueId === null
+            ? null
+            : $this->entity->queues()->find($this->viewingQueueId);
+    }
+
+    private function accessQueue(): ?Queue
+    {
+        return $this->accessQueueId === null
+            ? null
+            : $this->entity->queues()->find($this->accessQueueId);
+    }
+
+    private function resetNested(): void
+    {
+        $this->reset('editingQueueId', 'renameName', 'confirmingToggle', 'accessQueueId', 'managingAccess');
+        $this->resetValidation('renameName');
+    }
+
+    private function firstMessage(ValidationException $e): string
+    {
+        return (string) collect($e->errors())->flatten()->first();
+    }
+}
diff --git a/app/Livewire/Entity/Serve.php b/app/Livewire/Entity/Serve.php
new file mode 100644
index 0000000..6a2c160
--- /dev/null
+++ b/app/Livewire/Entity/Serve.php
@@ -0,0 +1,175 @@
+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\RateLimiter;
+use Livewire\Attributes\Layout;
+use Livewire\Attributes\Locked;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+#[Layout('layouts::default-page')]
+class Serve extends Component
+{
+    #[Locked]
+    public Entity $entity;
+
+    /**
+     * Queue being served. Untrusted client state — always re-resolved scoped
+     * to the entity and checked against the call permission before use.
+     */
+    public ?int $selectedQueueId = null;
+
+    #[Validate('required|in:any,priority_only,normal_only')]
+    public string $mode = 'any';
+
+    /**
+     * Last ticket this session called. Server-only: the client may read it
+     * but never write it.
+     */
+    #[Locked]
+    public ?int $lastCalledTicketId = null;
+
+    public ?string $notice = null;
+
+    /**
+     * Successful calls allowed per user and entity within the decay window.
+     */
+    private const CALLS_PER_MINUTE = 10;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+
+        $this->entity = $entity;
+        $this->selectedQueueId = $this->callableQueues()->first()?->id;
+    }
+
+    /**
+     * Call the next ticket of the selected queue. Authorization and call
+     * ordering live in CallNextTicket; this only maps its outcomes to notices.
+     */
+    public function callNext(): void
+    {
+        if ($this->selectedQueueId === null) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        $this->validateOnly('mode');
+
+        $queue = $this->entity->queues()->findOrFail($this->selectedQueueId);
+
+        $this->authorize('call', $queue);
+
+        $limiterKey = 'serve-call:'.$this->entity->id.':'.auth()->id();
+
+        if (RateLimiter::tooManyAttempts($limiterKey, self::CALLS_PER_MINUTE)) {
+            $this->notice = __('ui.serve_rate_limited');
+
+            return;
+        }
+
+        try {
+            $ticket = (new CallNextTicket)($queue, auth()->user(), CallMode::from($this->mode));
+        } catch (InactiveQueueException) {
+            $this->notice = __('ui.serve_inactive');
+
+            return;
+        } catch (NoWaitingTicketsException) {
+            $this->notice = __('ui.serve_empty');
+
+            return;
+        }
+
+        RateLimiter::hit($limiterKey, 60);
+
+        $this->lastCalledTicketId = $ticket->id;
+        $this->notice = __('ui.serve_last_called', ['code' => $ticket->code]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.serve', [
+            'queues' => $this->callableQueues(),
+            'tickets' => $this->waitingTickets($this->selectedQueue()),
+        ]);
+    }
+
+    /**
+     * Active queues of the entity the current user may call.
+     *
+     * @return Collection<int, Queue>
+     */
+    private function callableQueues(): Collection
+    {
+        $user = auth()->user();
+
+        return $this->entity->queues()
+            ->where('is_active', true)
+            ->orderBy('name')
+            ->get()
+            ->filter(fn (Queue $queue) => $user->can('call', $queue))
+            ->values();
+    }
+
+    /**
+     * The selected queue, or null when it is foreign, inactive or not callable.
+     */
+    private function selectedQueue(): ?Queue
+    {
+        if ($this->selectedQueueId === null) {
+            return null;
+        }
+
+        $queue = $this->entity->queues()->find($this->selectedQueueId);
+
+        if ($queue === null || ! $queue->is_active || ! auth()->user()->can('call', $queue)) {
+            return null;
+        }
+
+        return $queue;
+    }
+
+    /**
+     * Waiting tickets in call order, filtered by the current mode.
+     *
+     * @return Collection<int, Ticket>
+     */
+    private function waitingTickets(?Queue $queue): Collection
+    {
+        if ($queue === null) {
+            return collect();
+        }
+
+        $query = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting);
+
+        $mode = CallMode::tryFrom($this->mode) ?? CallMode::Any;
+
+        if ($mode === CallMode::PriorityOnly) {
+            $query->where('priority', '>', 0);
+        } elseif ($mode === CallMode::NormalOnly) {
+            $query->where('priority', 0);
+        }
+
+        return $query
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id')
+            ->limit(30)
+            ->get();
+    }
+}
diff --git a/docs/business-rules.md b/docs/business-rules.md
index 9059895..a42b68b 100644
--- a/docs/business-rules.md
+++ b/docs/business-rules.md
@@ -102,7 +102,7 @@ ### Ticket
 
 **Immutability enforcement:** the write-once rule is enforced on the `Ticket` model (`updating` hook), so it applies to Eloquent saves only — mass updates through the query builder (`Ticket::query()->update(...)`) bypass it and must not be used on issued tickets.
 
-**Single-ticket call (scope note):** `Ticket::call()` marks one waiting ticket as `called` (exactly-once). Deterministic call-next selection (priority + age + 3-ticket fairness) is implemented by `App\Actions\CallNextTicket` with the three call-panel modes below (`any` applies fairness; `priority_only`/`normal_only` ignore it). Both call paths enforce the **same effective queue authorization rule** (`QueuePolicy::call`): owner/admin bypass without a grant row, employees require a `queue_access.call` grant for that queue, non-members are denied with no ticket mutation. HTTP/Livewire panels remain future work.
+**Single-ticket call (scope note):** `Ticket::call()` marks one waiting ticket as `called` (exactly-once). Deterministic call-next selection (priority + age + 3-ticket fairness) is implemented by `App\Actions\CallNextTicket` with the three call-panel modes below (`any` applies fairness; `priority_only`/`normal_only` ignore it). Both call paths enforce the **same effective queue authorization rule** (`QueuePolicy::call`): owner/admin bypass without a grant row, employees require a `queue_access.call` grant for that queue, non-members are denied with no ticket mutation. The attendant panel (`App\Livewire\Entity\Serve`, route `entity.serve`) calls `CallNextTicket` through this same rule: an unauthorized queue is a 403 with no change, an inactive queue or an empty queue shows a notice, and successful calls are rate-limited to 10 per minute per user and entity.
 
 ### Priority
 
