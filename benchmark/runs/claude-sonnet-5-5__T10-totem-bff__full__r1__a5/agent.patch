+<?php
+
+use App\Totem\TotemToken;
+use Firebase\JWT\JWT;
+
+function forgeJwt(array $overrides = [], ?string $secret = null, string $alg = 'HS256'): string
+{
+    $claims = array_merge([
+        'totem_id' => 1, 'entity_id' => 1, 'preset_id' => 1, 'queues' => [1],
+        'iat' => now()->timestamp, 'exp' => now()->timestamp + 60, 'jti' => 'x',
+    ], $overrides);
+
+    return JWT::encode($claims, $secret ?? config('services.totem.jwt_secret'), $alg);
+}
+
+it('uses the configured secret and ttl', function () {
+    expect(strlen((string) config('services.totem.jwt_secret')))->toBeGreaterThanOrEqual(32)
+        ->and(config('services.totem.jwt_ttl'))->toBe(3600);
+});
+
+it('round-trips claims', function () {
+    $claims = TotemToken::parse(TotemToken::issue(5, 6, 7, [8, 9]));
+
+    expect($claims)->toMatchArray(['totem_id' => 5, 'entity_id' => 6, 'preset_id' => 7, 'queues' => [8, 9]]);
+});
+
+it('rejects tampered, foreign-secret, expired, unsigned and incomplete tokens', function () {
+    $valid = TotemToken::issue(1, 1, 1, [1]);
+    [$h, $p, $s] = explode('.', $valid);
+
+    expect(TotemToken::parse($valid))->not->toBeNull()
+        ->and(TotemToken::parse("$h.$p.".strrev($s)))->toBeNull()
+        ->and(TotemToken::parse(forgeJwt([], str_repeat('x', 40))))->toBeNull()
+        ->and(TotemToken::parse(forgeJwt(['exp' => now()->timestamp - 1])))->toBeNull()
+        ->and(TotemToken::parse(forgeJwt([], str_repeat((string) config('services.totem.jwt_secret'), 2), 'HS512')))->toBeNull()
+        ->and(TotemToken::parse(rtrim($h.'.'.$p, '.').'.'))->toBeNull()
+        ->and(TotemToken::parse('garbage'))->toBeNull()
+        ->and(TotemToken::parse(forgeJwt(['queues' => 'all'])))->toBeNull()
+        ->and(TotemToken::parse(forgeJwt(['totem_id' => '1'])))->toBeNull();
+});
+
+it('expires after the ttl following the app clock', function () {
+    $token = TotemToken::issue(1, 1, 1, []);
+
+    $this->travel(3599)->seconds();
+    expect(TotemToken::parse($token))->not->toBeNull();
+
+    $this->travel(2)->seconds();
+    expect(TotemToken::parse($token))->toBeNull();
+});
+
+it('fails loudly when the secret is not configured', function () {
+    config(['services.totem.jwt_secret' => null]);
+
+    TotemToken::parse('a.b.c');
+})->throws(RuntimeException::class);
