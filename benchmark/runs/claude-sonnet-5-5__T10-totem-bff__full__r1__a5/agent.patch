+        ->and($preset->login_code_expires_at->between(now()->addMinutes(9), now()->addMinutes(10)->addSecond()))->toBeTrue();
+
+    expect(Artisan::output())->toContain('Pairing code: '.$preset->login_code);
+});
+
+it('replaces the previous code on regeneration', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '000001']);
+    $other = TotemPreset::factory()->create(['login_code' => '000002']);
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    expect($preset->fresh()->login_code)->not->toBe('000001')
+        ->and($other->fresh()->login_code)->toBe('000002');
+});
+
+it('zero-pads codes', function () {
+    $preset = TotemPreset::factory()->create();
+
+    // random_int is not injectable; across many windows a short code would surface as a length bug.
+    foreach (range(1, 30) as $ignored) {
+        $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+        expect($preset->fresh()->login_code)->toHaveLength(6);
+    }
+});
+
+it('fails for an unknown preset id', function () {
+    $this->artisan('totem:pairing-code', ['preset' => 9999])
+        ->expectsOutputToContain('not found')
+        ->assertFailed();
+
+    $this->artisan('totem:pairing-code', ['preset' => 'abc'])->assertFailed();
+});
+
+it('writes an audit log without the code', function () {
+    Event::fake([MessageLogged::class]);
+    $preset = TotemPreset::factory()->create();
+
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+    $code = $preset->fresh()->login_code;
+
+    Event::assertDispatched(MessageLogged::class, fn (MessageLogged $log) => $log->message === 'totem.pairing.opened'
+        && $log->context['preset_id'] === $preset->id
+        && ! str_contains(json_encode($log->context), $code));
+});
diff --git a/tests/Feature/Totem/TotemAuthTest.php b/tests/Feature/Totem/TotemAuthTest.php
new file mode 100644
index 0000000..cdc23de
--- /dev/null
+++ b/tests/Feature/Totem/TotemAuthTest.php
@@ -0,0 +1,139 @@
+<?php
+
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemToken;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Log\Events\MessageLogged;
+use Illuminate\Support\Facades\Event;
+use Illuminate\Support\Facades\RateLimiter;
+
+uses(RefreshDatabase::class);
+
+it('pairs with a valid code and returns a scoped JWT plus the entity', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+    $preset->queues()->attach($queue->id);
+
+    $response = $this->postJson('/api/totem/auth', ['code' => $preset->login_code]);
+
+    $response->assertOk()
+        ->assertJsonPath('token_type', 'Bearer')
+        ->assertJsonPath('expires_in', 3600)
+        ->assertJsonPath('entity', ['slug' => $preset->entity->slug, 'name' => $preset->entity->name]);
+
+    $totem = Totem::sole();
+    expect($totem->entity_id)->toBe($preset->entity_id)
+        ->and($totem->is_active)->toBeTrue()
+        ->and($totem->last_seen_at)->not->toBeNull()
+        ->and($preset->fresh()->login_code_consumed_at)->not->toBeNull();
+
+    $claims = TotemToken::parse($response->json('token'));
+    expect($claims)->toMatchArray([
+        'totem_id' => $totem->id,
+        'entity_id' => $preset->entity_id,
+        'preset_id' => $preset->id,
+        'queues' => [$queue->id],
+    ])->and($claims['exp'] - $claims['iat'])->toBe(3600)
+        ->and($claims['jti'])->not->toBeEmpty();
+});
+
+it('rejects a code that is not exactly 6 digits', function (mixed $code) {
+    $this->postJson('/api/totem/auth', ['code' => $code])
+        ->assertStatus(400)
+        ->assertExactJson(['code' => 'invalid_code_format']);
+})->with(['', null, '12345', '1234567', 'abc123', '12 456', '１２３４５６', [['123456']], true]);
+
+it('rejects a missing code', function () {
+    $this->postJson('/api/totem/auth')->assertStatus(400)->assertExactJson(['code' => 'invalid_code_format']);
+});
+
+it('answers the same 401 for expired, consumed and inactive presets', function () {
+    $states = [
+        'expired' => ['login_code_expires_at' => now()->subSecond()],
+        'no expiry' => ['login_code_expires_at' => null],
+        'consumed' => ['login_code_consumed_at' => now()->subMinute()],
+        'inactive' => ['is_active' => false],
+    ];
+
+    foreach ($states as $label => $state) {
+        $preset = TotemPreset::factory()->create($state);
+
+        $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+            ->assertStatus(401)
+            ->assertExactJson(['code' => 'invalid_pairing_code']);
+    }
+
+    expect(Totem::count())->toBe(0);
+});
+
+it('answers 401 for an unknown code', function () {
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+});
+
+it('makes a code single-use', function () {
+    $preset = TotemPreset::factory()->create();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])
+        ->assertStatus(401)
+        ->assertExactJson(['code' => 'invalid_pairing_code']);
+
+    expect(Totem::count())->toBe(1);
+});
+
+it('replaces the old code when a window is reopened', function () {
+    $preset = TotemPreset::factory()->create(['login_code' => '111111']);
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    $this->postJson('/api/totem/auth', ['code' => '111111'])->assertStatus(401);
+    $this->postJson('/api/totem/auth', ['code' => $preset->fresh()->login_code])->assertOk();
+});
+
+it('pairs a code reopened after consumption', function () {
+    $preset = TotemPreset::factory()->create(['login_code_consumed_at' => now()]);
+    $this->artisan('totem:pairing-code', ['preset' => $preset->id])->assertSuccessful();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->fresh()->login_code])->assertOk();
+});
+
+it('throttles pairing to 10 requests per minute with a JSON 429', function () {
+    RateLimiter::clear('totem-auth');
+
+    foreach (range(1, 10) as $ignored) {
+        $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401);
+    }
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])
+        ->assertStatus(429)
+        ->assertExactJson(['code' => 'rate_limited'])
+        ->assertHeader('Retry-After');
+});
+
+it('audit-logs pairing success and failure without the full code', function () {
+    Event::fake([MessageLogged::class]);
+    $preset = TotemPreset::factory()->create(['login_code' => '482913']);
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'])->assertStatus(401);
+    $this->postJson('/api/totem/auth', ['code' => '482913'])->assertOk();
+    $this->postJson('/api/totem/auth', ['code' => '48'])->assertStatus(400);
+
+    $logs = collect(Event::dispatched(MessageLogged::class))->map(fn ($args) => $args[0])
+        ->filter(fn ($log) => str_starts_with($log->message, 'totem.pairing'));
+
+    expect($logs->pluck('message')->all())->toBe(['totem.pairing.failed', 'totem.pairing.succeeded', 'totem.pairing.failed'])
+        ->and($logs->last()->context['reason'])->toBe('invalid_code_format')
+        ->and($logs->map(fn ($log) => json_encode($log->context))->implode(' '))->not->toContain('482913')
+        ->and($logs[1]->context['preset_id'])->toBe($preset->id);
+});
+
+it('does not pair for a soft-deleted entity', function () {
+    $preset = TotemPreset::factory()->create();
+    $preset->entity->delete();
+
+    $this->postJson('/api/totem/auth', ['code' => $preset->login_code])->assertStatus(401);
+    expect(Totem::count())->toBe(0);
+});
diff --git a/tests/Feature/Totem/TotemCorsTest.php b/tests/Feature/Totem/TotemCorsTest.php
new file mode 100644
index 0000000..3e37283
--- /dev/null
+++ b/tests/Feature/Totem/TotemCorsTest.php
@@ -0,0 +1,62 @@
+<?php
+
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('answers the preflight for localhost origins', function (string $origin) {
+    $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+        'HTTP_ACCESS_CONTROL_REQUEST_HEADERS' => 'content-type,authorization',
+    ])->assertNoContent()
+        ->assertHeader('Access-Control-Allow-Origin', $origin)
+        ->assertHeaderMissing('Access-Control-Allow-Credentials');
+})->with([
+    'http://localhost:8081',
+    'http://localhost',
+    'https://localhost:3000',
+    'http://127.0.0.1:5000',
+    'https://127.0.0.1',
+]);
+
+it('sends no allow-origin for other origins', function (string $origin) {
+    $preflight = $this->call('OPTIONS', '/api/totem/auth', [], [], [], [
+        'HTTP_ORIGIN' => $origin,
+        'HTTP_ACCESS_CONTROL_REQUEST_METHOD' => 'POST',
+    ]);
+    $preflight->assertHeaderMissing('Access-Control-Allow-Origin');
+
+    $this->postJson('/api/totem/auth', ['code' => '000000'], ['Origin' => $origin])
+        ->assertStatus(401)
+        ->assertHeaderMissing('Access-Control-Allow-Origin');
+})->with([
+    'https://evil.example',
+    'http://localhost.evil.example',
+    'http://evil.example:8081',
+    'http://127.0.0.1.evil.example',
+    'http://localhost:abc',
+    'null',
+]);
+
+it('adds allow-origin to real responses, including errors', function () {
+    $this->postJson('/api/totem/auth', ['code' => 'x'], ['Origin' => 'http://localhost:8081'])
+        ->assertStatus(400)
+        ->assertHeader('Access-Control-Allow-Origin', 'http://localhost:8081');
+});
+
+it('allows the optional TOTEM_WEB_ORIGIN', function () {
+    $config = require base_path('config/cors.php');
+    expect($config['allowed_origins'])->toBe([])
+        ->and($config['supports_credentials'])->toBeFalse()
+        ->and($config['paths'])->toBe(['api/*']);
+
+    putenv('TOTEM_WEB_ORIGIN=https://totem.example.com/');
+    $_ENV['TOTEM_WEB_ORIGIN'] = $_SERVER['TOTEM_WEB_ORIGIN'] = 'https://totem.example.com/';
+    try {
+        expect((require base_path('config/cors.php'))['allowed_origins'])->toBe(['https://totem.example.com']);
+    } finally {
+        putenv('TOTEM_WEB_ORIGIN');
+        unset($_ENV['TOTEM_WEB_ORIGIN'], $_SERVER['TOTEM_WEB_ORIGIN']);
+    }
+});
diff --git a/tests/Feature/Totem/TotemEndpointsTest.php b/tests/Feature/Totem/TotemEndpointsTest.php
new file mode 100644
index 0000000..0fff972
--- /dev/null
+++ b/tests/Feature/Totem/TotemEndpointsTest.php
@@ -0,0 +1,248 @@
+<?php
+
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\Totem;
+use App\Totem\TotemToken;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+// ---- totem.auth middleware ------------------------------------------------
+
+it('rejects calls without a valid bearer token', function () {
+    $t = pairedTotem();
+    $url = "/api/{$t['entity']->slug}/queues";
+
+    $this->getJson($url)->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+    $this->getJson($url, ['Authorization' => 'Bearer nope'])->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+    $this->getJson($url, ['Authorization' => 'Basic '.$t['token']])->assertStatus(401);
+    $this->getJson($url, ['Authorization' => 'Bearer '.substr($t['token'], 0, -3).'abc'])->assertStatus(401);
+});
+
+it('rejects an expired token', function () {
+    $t = pairedTotem();
+    $this->travel(3601)->seconds();
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])
+        ->assertStatus(401)->assertExactJson(['code' => 'invalid_token']);
+});
+
+it('rejects tokens whose totem, preset or entity is gone, inactive or mismatched', function () {
+    $other = Entity::factory()->create();
+    $cases = [
+        'totem inactive' => fn ($t) => $t['totem']->update(['is_active' => false]),
+        'totem deleted' => fn ($t) => $t['totem']->delete(),
+        'preset inactive' => fn ($t) => $t['preset']->update(['is_active' => false]),
+        'preset deleted' => fn ($t) => $t['preset']->delete(),
+        'entity soft-deleted' => fn ($t) => $t['entity']->delete(),
+        'totem of another entity' => fn ($t) => $t['totem']->update(['entity_id' => $other->id]),
+        'preset of another entity' => fn ($t) => $t['preset']->update(['entity_id' => $other->id]),
+    ];
+
+    foreach ($cases as $label => $break) {
+        $t = pairedTotem();
+        $break($t);
+
+        $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])
+            ->assertStatus(401)
+            ->assertExactJson(['code' => 'invalid_token']);
+    }
+});
+
+it('rejects a token whose claims mix entities', function () {
+    $t = pairedTotem();
+    $other = Entity::factory()->create();
+    $token = TotemToken::issue($t['totem']->id, $other->id, $t['preset']->id, []);
+
+    $this->getJson("/api/{$other->slug}/queues", ['Authorization' => 'Bearer '.$token])->assertStatus(401);
+});
+
+it('quietly updates last_seen_at', function () {
+    $t = pairedTotem();
+    $updatedAt = $t['totem']->updated_at->toDateTimeString();
+    $this->travel(5)->minutes();
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])->assertOk();
+
+    $totem = $t['totem']->fresh();
+    expect($totem->last_seen_at->toDateTimeString())->toBe(now()->toDateTimeString())
+        ->and($totem->updated_at->toDateTimeString())->toBe($updatedAt);
+});
+
+// ---- GET queues -----------------------------------------------------------
+
+it('lists only active scoped queues of the entity ordered by name with 1-based visual order', function () {
+    $entity = Entity::factory()->create(['slug' => 'loja', 'name' => 'Loja']);
+    $beta = Queue::factory()->for($entity)->create(['name' => 'Beta', 'slug' => 'beta']);
+    $alpha = Queue::factory()->for($entity)->create(['name' => 'Alpha', 'slug' => 'alpha']);
+    $inactive = Queue::factory()->for($entity)->create(['name' => 'Aaa', 'is_active' => false]);
+    $notInPreset = Queue::factory()->for($entity)->create(['name' => 'Zeta']);
+    $foreign = Queue::factory()->create(['name' => 'Foreign']);
+    $t = pairedTotem([$beta, $alpha, $inactive, $foreign]);
+
+    $response = $this->getJson('/api/'.$t['entity']->slug.'/queues', $t['headers']);
+
+    $response->assertOk()
+        ->assertJsonPath('entity', ['slug' => $t['entity']->slug, 'name' => $t['entity']->name])
+        ->assertJsonCount(2, 'queues')
+        ->assertJsonPath('queues.0.slug', 'alpha')
+        ->assertJsonPath('queues.0.label', 'Alpha')
+        ->assertJsonPath('queues.0.visual.order', 1)
+        ->assertJsonPath('queues.0.is_active', true)
+        ->assertJsonPath('queues.1.slug', 'beta')
+        ->assertJsonPath('queues.1.visual.order', 2)
+        ->assertJsonStructure(['queues' => [['slug', 'label', 'description', 'visual' => ['color', 'icon', 'order'], 'is_active']]]);
+});
+
+it('applies the preset removal immediately to existing tokens (intersection)', function () {
+    $t = pairedTotem();
+
+    $t['preset']->queues()->detach($t['queues'][0]->id);
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])
+        ->assertOk()->assertJsonCount(1, 'queues')->assertJsonPath('queues.0.slug', 'beta');
+});
+
+it('does not widen the scope when a queue is added to the preset after pairing', function () {
+    $t = pairedTotem();
+    $added = Queue::factory()->for($t['entity'])->create(['slug' => 'added']);
+    $t['preset']->queues()->attach($added->id);
+
+    $this->getJson("/api/{$t['entity']->slug}/queues", $t['headers'])->assertJsonCount(2, 'queues');
+    $this->getJson("/api/{$t['entity']->slug}/added/priorities", $t['headers'])
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+});
+
+it('returns 403 when the path entity is not the token entity', function () {
+    $t = pairedTotem();
+    $other = Entity::factory()->create();
+
+    $this->getJson("/api/{$other->slug}/queues", $t['headers'])->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+    $this->getJson('/api/nope/alpha/priorities', $t['headers'])->assertStatus(403);
+    $this->postJson("/api/{$other->slug}/alpha/ticket", ['priority' => 0], $t['headers'])->assertStatus(403);
+});
+
+// ---- GET priorities ---------------------------------------------------------
+
+it('lists the backend-owned priorities', function () {
+    $t = pairedTotem();
+
+    $this->getJson("/api/{$t['entity']->slug}/alpha/priorities", $t['headers'])
+        ->assertOk()
+        ->assertExactJson([
+            'entity' => ['slug' => $t['entity']->slug],
+            'queue' => ['slug' => 'alpha', 'label' => 'Alpha'],
+            'priorities' => [
+                ['value' => 0, 'label' => 'Normal', 'visual' => TicketPriority::Normal->visual()],
+                ['value' => 10, 'label' => 'Prioritário', 'visual' => TicketPriority::Priority->visual()],
+                ['value' => 20, 'label' => 'Prioridade 80+', 'visual' => TicketPriority::Priority80->visual()],
+            ],
+        ]);
+});
+
+it('answers 404 queue_not_found for unknown slugs and other entities slugs', function () {
+    $t = pairedTotem();
+    $foreign = Queue::factory()->create(['slug' => 'foreign']);
+
+    foreach (['missing', 'foreign'] as $slug) {
+        $this->getJson("/api/{$t['entity']->slug}/{$slug}/priorities", $t['headers'])
+            ->assertStatus(404)->assertExactJson(['code' => 'queue_not_found']);
+        $this->postJson("/api/{$t['entity']->slug}/{$slug}/ticket", ['priority' => 0], $t['headers'])
+            ->assertStatus(404)->assertExactJson(['code' => 'queue_not_found']);
+    }
+});
+
+it('resolves a queue slug within the token entity even when another entity reuses it', function () {
+    $t = pairedTotem();
+    Queue::factory()->create(['slug' => 'alpha', 'name' => 'Other alpha']);
+
+    $this->getJson("/api/{$t['entity']->slug}/alpha/priorities", $t['headers'])
+        ->assertOk()->assertJsonPath('queue.label', 'Alpha');
+});
+
+it('answers 403 for a queue of the entity outside the scope', function () {
+    $t = pairedTotem();
+    Queue::factory()->for($t['entity'])->create(['slug' => 'hidden']);
+
+    $this->getJson("/api/{$t['entity']->slug}/hidden/priorities", $t['headers'])
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+    $this->postJson("/api/{$t['entity']->slug}/hidden/ticket", ['priority' => 0], $t['headers'])
+        ->assertStatus(403)->assertExactJson(['code' => 'forbidden']);
+    expect(Ticket::count())->toBe(0);
+});
+
+it('answers 422 inactive_queue for priorities of an inactive queue', function () {
+    $t = pairedTotem();
+    $t['queues'][0]->update(['is_active' => false]);
+
+    $this->getJson("/api/{$t['entity']->slug}/alpha/priorities", $t['headers'])
+        ->assertStatus(422)->assertExactJson(['code' => 'inactive_queue']);
+});
+
+// ---- POST ticket -------------------------------------------------------------
+
+it('issues sequential totem tickets', function () {
+    $t = pairedTotem();
+    $url = "/api/{$t['entity']->slug}/alpha/ticket";
+
+    $first = $this->postJson($url, ['priority' => 10], $t['headers']);
+    $first->assertCreated()
+        ->assertJsonPath('slug', 'A001')
+        ->assertJsonPath('queue', ['slug' => 'alpha', 'label' => 'Alpha'])
+        ->assertJsonPath('priority', ['value' => 10, 'label' => 'Prioritário']);
+    expect(Carbon\Carbon::parse($first->json('issued_at'))->diffInSeconds(now(), true))->toBeLessThan(5)
+        ->and($first->json('issued_at'))->toEndWith('Z');
+
+    $this->postJson($url, ['priority' => 0], $t['headers'])->assertCreated()->assertJsonPath('slug', 'A002');
+    $this->postJson("/api/{$t['entity']->slug}/beta/ticket", ['priority' => 20], $t['headers'])
+        ->assertCreated()->assertJsonPath('slug', 'A001')->assertJsonPath('priority.label', 'Prioridade 80+');
+
+    $ticket = Ticket::query()->where('queue_id', $t['queues'][0]->id)->orderBy('id')->first();
+    expect($ticket->channel)->toBe(TicketChannel::Totem)
+        ->and($ticket->priority)->toBe(10)
+        ->and(Ticket::count())->toBe(3);
+});
+
+it('rejects priorities outside the backend-owned set and creates nothing', function (mixed $priority) {
+    $t = pairedTotem();
+
+    $this->postJson("/api/{$t['entity']->slug}/alpha/ticket", ['priority' => $priority], $t['headers'])
+        ->assertStatus(422)->assertExactJson(['code' => 'invalid_priority']);
+
+    expect(Ticket::count())->toBe(0);
+})->with([5, -1, 99, 'high', null, 10.5, true, [[10]], '010']);
+
+it('rejects a missing priority', function () {
+    $t = pairedTotem();
+
+    $this->postJson("/api/{$t['entity']->slug}/alpha/ticket", [], $t['headers'])
+        ->assertStatus(422)->assertExactJson(['code' => 'invalid_priority']);
+});
+
+it('answers 422 inactive_queue on issuance and creates nothing', function () {
+    $t = pairedTotem();
+    $t['queues'][0]->update(['is_active' => false]);
+
+    $this->postJson("/api/{$t['entity']->slug}/alpha/ticket", ['priority' => 0], $t['headers'])
+        ->assertStatus(422)->assertExactJson(['code' => 'inactive_queue']);
+
+    expect(Ticket::count())->toBe(0);
+});
+
+it('throttles issuance to 30 per minute per totem', function () {
+    $t = pairedTotem();
+    $other = pairedTotem();
+
+    foreach (range(1, 30) as $ignored) {
+        $this->postJson("/api/{$t['entity']->slug}/alpha/ticket", ['priority' => 0], $t['headers'])->assertCreated();
+    }
+
+    $this->postJson("/api/{$t['entity']->slug}/alpha/ticket", ['priority' => 0], $t['headers'])
+        ->assertStatus(429)->assertExactJson(['code' => 'rate_limited']);
+
+    $this->postJson("/api/{$other['entity']->slug}/alpha/ticket", ['priority' => 0], $other['headers'])->assertCreated();
+});
diff --git a/tests/Feature/Totem/TotemModelsTest.php b/tests/Feature/Totem/TotemModelsTest.php
new file mode 100644
index 0000000..c31ce30
