+<?php
+
+namespace App\Console\Commands;
+
+use App\Actions\OpenTotemPairing;
+use App\Models\TotemPreset;
+use Illuminate\Console\Attributes\Description;
+use Illuminate\Console\Attributes\Signature;
+use Illuminate\Console\Command;
+
+#[Signature('totem:pairing-code {preset : Totem preset id}')]
+#[Description('Open a pairing window for a totem preset and print its 6-digit code')]
+class TotemPairingCode extends Command
+{
+    public function handle(OpenTotemPairing $openPairing): int
+    {
+        $preset = ctype_digit((string) $this->argument('preset'))
+            ? TotemPreset::query()->find((int) $this->argument('preset'))
+            : null;
+
+        if ($preset === null) {
+            $this->error('Totem preset not found.');
+
+            return self::FAILURE;
+        }
+
+        $openPairing($preset);
+
+        $this->line("Pairing code: {$preset->login_code}");
+        $this->line('Expires at '.$preset->login_code_expires_at->toDateTimeString().' (single use).');
+
+        return self::SUCCESS;
+    }
+}
