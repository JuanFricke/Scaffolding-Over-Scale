new file mode 100644
index 0000000..2184608
--- /dev/null
+++ b/app/Totem/TotemToken.php
@@ -0,0 +1,93 @@
+<?php
+
+namespace App\Totem;
+
+use Firebase\JWT\JWT;
+use Firebase\JWT\Key;
+use RuntimeException;
+use Throwable;
+
+/**
+ * HS256 JWT for a paired totem. Secret and TTL come from config
+ * (services.totem.jwt_secret / jwt_ttl).
+ */
+class TotemToken
+{
+    private const ALGORITHM = 'HS256';
+
+    private const REQUIRED_CLAIMS = ['totem_id', 'entity_id', 'preset_id', 'queues', 'iat', 'exp', 'jti'];
+
+    /**
+     * Token lifetime in seconds.
+     */
+    public static function ttl(): int
+    {
+        return (int) config('services.totem.jwt_ttl', 3600);
+    }
+
+    /**
+     * @param  list<int>  $queueIds
+     */
+    public static function issue(int $totemId, int $entityId, int $presetId, array $queueIds): string
+    {
+        $now = now()->timestamp;
+
+        return JWT::encode([
+            'totem_id' => $totemId,
+            'entity_id' => $entityId,
+            'preset_id' => $presetId,
+            'queues' => array_values($queueIds),
+            'iat' => $now,
+            'exp' => $now + self::ttl(),
+            'jti' => bin2hex(random_bytes(16)),
+        ], self::secret(), self::ALGORITHM);
+    }
+
+    /**
+     * Verified claims, or null when the token is malformed, tampered with,
+     * expired or lacks a claim.
+     *
+     * @return array{totem_id: int, entity_id: int, preset_id: int, queues: list<int>, iat: int, exp: int, jti: string}|null
+     */
+    public static function parse(string $jwt): ?array
+    {
+        // Misconfiguration must surface as an error, not as a quiet 401.
+        $key = new Key(self::secret(), self::ALGORITHM);
+
+        // Follow Carbon's clock so tests (and travel()) control expiry.
+        $previous = JWT::$timestamp;
+        JWT::$timestamp = now()->timestamp;
+
+        try {
+            $claims = (array) JWT::decode($jwt, $key);
+        } catch (Throwable) {
+            return null;
+        } finally {
+            JWT::$timestamp = $previous;
+        }
+
+        foreach (self::REQUIRED_CLAIMS as $claim) {
+            if (! array_key_exists($claim, $claims)) {
+                return null;
+            }
+        }
+
+        if (! is_int($claims['totem_id']) || ! is_int($claims['entity_id']) || ! is_int($claims['preset_id'])
+            || ! is_array($claims['queues']) || array_filter($claims['queues'], 'is_int') !== $claims['queues']) {
+            return null;
+        }
+
+        return $claims;
+    }
+
+    private static function secret(): string
+    {
+        $secret = (string) config('services.totem.jwt_secret');
+
+        if ($secret === '') {
+            throw new RuntimeException('TOTEM_JWT_SECRET is not configured.');
+        }
+
+        return $secret;
+    }
+}
