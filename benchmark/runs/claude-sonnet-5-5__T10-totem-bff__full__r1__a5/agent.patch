@@ -0,0 +1,41 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\PairTotem;
+use App\Http\Controllers\Controller;
+use App\Totem\TotemToken;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+
+class TotemAuthController extends Controller
+{
+    public function store(Request $request, PairTotem $pairTotem): JsonResponse
+    {
+        $code = $request->input('code');
+        $code = is_int($code) ? (string) $code : $code;
+
+        if (! is_string($code) || ! preg_match('/^\d{6}$/D', $code)) {
+            Log::channel('audit')->warning('totem.pairing.failed', [
+                'reason' => 'invalid_code_format',
+                'ip' => $request->ip(),
+            ]);
+
+            return response()->json(['code' => 'invalid_code_format'], 400);
+        }
+
+        $paired = $pairTotem($code, $request->ip());
+
+        if ($paired === null) {
+            return response()->json(['code' => 'invalid_pairing_code'], 401);
+        }
+
+        return response()->json([
+            'token' => $paired['token'],
+            'token_type' => 'Bearer',
+            'expires_in' => TotemToken::ttl(),
+            'entity' => $paired['entity'],
+        ]);
+    }
+}
diff --git a/app/Http/Controllers/Api/TotemQueueController.php b/app/Http/Controllers/Api/TotemQueueController.php
new file mode 100644
index 0000000..9155816
--- /dev/null
+++ b/app/Http/Controllers/Api/TotemQueueController.php
@@ -0,0 +1,132 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Actions\IssueTicket;
+use App\Enums\TicketChannel;
+use App\Enums\TicketPriority;
+use App\Exceptions\InactiveQueueException;
+use App\Http\Controllers\Controller;
+use App\Models\Entity;
+use App\Models\Queue;
+use Illuminate\Http\JsonResponse;
+use Illuminate\Http\Request;
+
+/**
+ * The totem's three data calls. Runs behind `totem.auth`, which sets the
+ * request's totem entity and effective queue scope.
+ */
+class TotemQueueController extends Controller
+{
+    /** Presentation defaults until queues carry their own visual settings. */
+    private const QUEUE_COLOR = '#0055FF';
+
+    private const QUEUE_ICON = 'ticket';
+
+    public function index(Request $request, string $entity): JsonResponse
+    {
+        $entityModel = $this->entity($request, $entity);
+
+        $queues = Queue::query()
+            ->where('entity_id', $entityModel->id)
+            ->where('is_active', true)
+            ->whereIn('id', $request->attributes->get('totem_queue_ids'))
+            ->orderBy('name')
+            ->orderBy('id')
+            ->get()
+            ->values()
+            ->map(fn (Queue $queue, int $position): array => [
+                'slug' => $queue->slug,
+                'label' => $queue->name,
+                'description' => null,
+                'visual' => ['color' => self::QUEUE_COLOR, 'icon' => self::QUEUE_ICON, 'order' => $position + 1],
+                'is_active' => true,
+            ]);
+
+        return response()->json([
+            'entity' => ['slug' => $entityModel->slug, 'name' => $entityModel->name],
+            'queues' => $queues,
+        ]);
+    }
+
+    public function priorities(Request $request, string $entity, string $queue): JsonResponse
+    {
+        $entityModel = $this->entity($request, $entity);
+        $queueModel = $this->queue($request, $entityModel, $queue);
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'entity' => ['slug' => $entityModel->slug],
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priorities' => array_map(fn (TicketPriority $priority): array => [
+                'value' => $priority->value,
+                'label' => $priority->label(),
+                'visual' => $priority->visual(),
+            ], TicketPriority::cases()),
+        ]);
+    }
+
+    public function ticket(Request $request, string $entity, string $queue, IssueTicket $issueTicket): JsonResponse
+    {
+        $entityModel = $this->entity($request, $entity);
+        $queueModel = $this->queue($request, $entityModel, $queue);
+
+        $priority = TicketPriority::fromInput($request->input('priority'));
+
+        if ($priority === null) {
+            return response()->json(['code' => 'invalid_priority'], 422);
+        }
+
+        if (! $queueModel->is_active) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        try {
+            $ticket = $issueTicket($queueModel, $priority->value, TicketChannel::Totem);
+        } catch (InactiveQueueException) {
+            return response()->json(['code' => 'inactive_queue'], 422);
+        }
+
+        return response()->json([
+            'slug' => $ticket->code,
+            'queue' => ['slug' => $queueModel->slug, 'label' => $queueModel->name],
+            'priority' => ['value' => $priority->value, 'label' => $priority->label()],
+            'issued_at' => $ticket->issued_at->utc()->toIso8601ZuluString(),
+        ], 201);
+    }
+
+    /**
+     * The path entity must be the token's entity.
+     */
+    private function entity(Request $request, string $slug): Entity
+    {
+        $entity = $request->attributes->get('totem_entity');
+
+        if ($entity->slug !== $slug) {
+            abort(response()->json(['code' => 'forbidden'], 403));
+        }
+
+        return $entity;
+    }
+
+    /**
+     * Resolve the queue slug within the entity only, then enforce the scope.
+     */
+    private function queue(Request $request, Entity $entity, string $slug): Queue
+    {
+        $queue = Queue::query()->where('entity_id', $entity->id)->where('slug', $slug)->first();
+
+        if ($queue === null) {
+            abort(response()->json(['code' => 'queue_not_found'], 404));
+        }
+
+        if (! in_array($queue->id, $request->attributes->get('totem_queue_ids'), true)) {
+            abort(response()->json(['code' => 'forbidden'], 403));
+        }
+
+        return $queue;
+    }
+}
diff --git a/app/Http/Middleware/AuthenticateTotem.php b/app/Http/Middleware/AuthenticateTotem.php
new file mode 100644
index 0000000..4ed89d1
--- /dev/null
+++ b/app/Http/Middleware/AuthenticateTotem.php
@@ -0,0 +1,50 @@
+<?php
+
+namespace App\Http\Middleware;
+
+use App\Models\Entity;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemToken;
+use Closure;
+use Illuminate\Http\Request;
+use Symfony\Component\HttpFoundation\Response;
+
+/**
+ * Authenticates a paired totem from its Bearer JWT and re-validates the
+ * server-side state on every call. On success the request carries:
+ *  - totem        App\Models\Totem
+ *  - totem_entity App\Models\Entity
+ *  - totem_queue_ids  list<int> effective scope (JWT queues ∩ preset's current queues)
+ */
+class AuthenticateTotem
+{
+    public function handle(Request $request, Closure $next): Response
+    {
+        $claims = ($jwt = $request->bearerToken()) ? TotemToken::parse($jwt) : null;
+
+        $totem = $claims ? Totem::query()->find($claims['totem_id']) : null;
+        $preset = $claims ? TotemPreset::query()->find($claims['preset_id']) : null;
+        $entity = $claims ? Entity::query()->find($claims['entity_id']) : null;
+
+        if ($claims === null
+            || $totem === null || ! $totem->is_active
+            || $preset === null || ! $preset->is_active
+            || $entity === null
+            || $totem->entity_id !== $entity->id
+            || $preset->entity_id !== $entity->id) {
+            return response()->json(['code' => 'invalid_token'], 401);
+        }
+
+        // Plain update: no model events and no updated_at churn on every call.
+        Totem::query()->whereKey($totem->id)->toBase()->update(['last_seen_at' => now()]);
+
+        $presetQueueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+
+        $request->attributes->set('totem', $totem);
+        $request->attributes->set('totem_entity', $entity);
+        $request->attributes->set('totem_queue_ids', array_values(array_intersect($claims['queues'], $presetQueueIds)));
+
+        return $next($request);
+    }
+}
