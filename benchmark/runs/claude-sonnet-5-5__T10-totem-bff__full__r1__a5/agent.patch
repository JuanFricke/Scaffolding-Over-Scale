+<?php
+
+use App\Models\Entity;
+use App\Models\Queue;
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+it('builds a preset with its own entity and a ready 6-digit pairing code', function () {
+    $preset = TotemPreset::factory()->create();
+
+    expect($preset->entity)->toBeInstanceOf(Entity::class)
+        ->and($preset->login_code)->toMatch('/^\d{6}$/')
+        ->and($preset->login_code_consumed_at)->toBeNull()
+        ->and($preset->is_active)->toBeTrue()
+        ->and($preset->login_code_expires_at->between(now()->addMinutes(9), now()->addMinutes(10)->addSecond()))->toBeTrue();
+});
+
+it('gives every factory preset a distinct code', function () {
+    $codes = TotemPreset::factory()->count(20)->create()->pluck('login_code');
+
+    expect($codes->unique())->toHaveCount(20);
+});
+
+it('does not serialize the login code', function () {
+    expect(TotemPreset::factory()->create()->toArray())->not->toHaveKey('login_code');
+});
+
+it('attaches and detaches queues through the join table', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue->id);
+    expect($preset->queues()->pluck('queues.id')->all())->toBe([$queue->id])
+        ->and(DB::table('totem_preset_queue')->where('preset_id', $preset->id)->count())->toBe(1);
+
+    $preset->queues()->detach($queue->id);
+    expect($preset->queues()->count())->toBe(0);
+});
+
+it('rejects attaching the same queue twice (composite primary key)', function () {
+    $preset = TotemPreset::factory()->create();
+    $queue = Queue::factory()->for($preset->entity)->create();
+
+    $preset->queues()->attach($queue->id);
+    $preset->queues()->attach($queue->id);
+})->throws(QueryException::class);
+
+it('exposes totems and presets on the entity and cascades on delete', function () {
+    $entity = Entity::factory()->create();
+    Totem::factory()->for($entity)->create();
+    TotemPreset::factory()->for($entity)->create();
+
+    expect($entity->totems)->toHaveCount(1)
+        ->and($entity->totemPresets)->toHaveCount(1);
+
+    $entity->forceDelete();
+
+    expect(Totem::count())->toBe(0)->and(TotemPreset::count())->toBe(0);
+});
+
+it('enforces a unique login code across presets', function () {
+    TotemPreset::factory()->create(['login_code' => '123456']);
+    TotemPreset::factory()->create(['login_code' => '123456']);
+})->throws(QueryException::class);
+
+it('creates an active totem without a last_seen_at', function () {
+    $totem = Totem::factory()->create();
+
+    expect($totem->is_active)->toBeTrue()->and($totem->last_seen_at)->toBeNull();
+});
