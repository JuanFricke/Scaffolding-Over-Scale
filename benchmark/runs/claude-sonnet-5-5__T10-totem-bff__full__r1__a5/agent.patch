@@ -0,0 +1,48 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\TotemPreset;
+use Illuminate\Database\QueryException;
+use Illuminate\Support\Facades\Log;
+use RuntimeException;
+
+/**
+ * Opens a pairing window: a fresh single-use 6-digit code valid for 10 minutes.
+ * Invoked from the operator console (totem:pairing-code), so there is no
+ * request user to authorize here.
+ */
+class OpenTotemPairing
+{
+    public const TTL_MINUTES = 10;
+
+    public function __invoke(TotemPreset $preset): TotemPreset
+    {
+        // login_code is unique across presets: retry on the rare collision.
+        for ($attempt = 1; ; $attempt++) {
+            $code = str_pad((string) random_int(0, 999999), 6, '0', STR_PAD_LEFT);
+
+            try {
+                $preset->forceFill([
+                    'login_code' => $code,
+                    'login_code_expires_at' => now()->addMinutes(self::TTL_MINUTES),
+                    'login_code_consumed_at' => null,
+                ])->save();
+                break;
+            } catch (QueryException $e) {
+                if ($attempt >= 5) {
+                    throw new RuntimeException('Could not allocate a unique pairing code.', 0, $e);
+                }
+            }
+        }
+
+        // The code itself is a credential: never logged.
+        Log::channel('audit')->info('totem.pairing.opened', [
+            'preset_id' => $preset->id,
+            'entity_id' => $preset->entity_id,
+            'expires_at' => $preset->login_code_expires_at->toIso8601String(),
+        ]);
+
+        return $preset;
+    }
+}
diff --git a/app/Actions/PairTotem.php b/app/Actions/PairTotem.php
new file mode 100644
index 0000000..c60f00c
--- /dev/null
+++ b/app/Actions/PairTotem.php
@@ -0,0 +1,93 @@
+<?php
+
+namespace App\Actions;
+
+use App\Models\Totem;
+use App\Models\TotemPreset;
+use App\Totem\TotemToken;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+
+/**
+ * Exchanges a pairing code for a totem device row and a signed JWT.
+ * Public endpoint (the code is the credential), so no policy applies.
+ */
+class PairTotem
+{
+    /**
+     * @return array{token: string, entity: array{slug: string, name: string}}|null null when the code cannot be used
+     */
+    public function __invoke(string $code, ?string $ip = null): ?array
+    {
+        $result = DB::transaction(function () use ($code): array {
+            $preset = TotemPreset::query()
+                ->where('login_code', $code)
+                ->lockForUpdate()
+                ->first();
+
+            if ($preset === null) {
+                return ['failure' => 'unknown_code', 'preset_id' => null];
+            }
+
+            $entity = $preset->entity;
+            $failure = match (true) {
+                $entity === null => 'entity_missing',
+                ! $preset->is_active => 'inactive_preset',
+                $preset->login_code_consumed_at !== null => 'consumed_code',
+                $preset->login_code_expires_at === null || $preset->login_code_expires_at->isPast() => 'expired_code',
+                default => null,
+            };
+
+            if ($failure !== null) {
+                return ['failure' => $failure, 'preset_id' => $preset->id];
+            }
+
+            // Conditional update keeps single-use even where row locks are a no-op (SQLite).
+            $consumed = TotemPreset::query()
+                ->whereKey($preset->id)
+                ->whereNull('login_code_consumed_at')
+                ->update(['login_code_consumed_at' => now()]);
+
+            if ($consumed === 0) {
+                return ['failure' => 'consumed_code', 'preset_id' => $preset->id];
+            }
+
+            $totem = Totem::query()->create([
+                'entity_id' => $preset->entity_id,
+                'name' => $preset->name,
+                'is_active' => true,
+                'last_seen_at' => now(),
+            ]);
+
+            $queueIds = $preset->queues()->pluck('queues.id')->map(fn ($id) => (int) $id)->all();
+
+            return [
+                'token' => TotemToken::issue($totem->id, $preset->entity_id, $preset->id, $queueIds),
+                'entity' => ['slug' => $entity->slug, 'name' => $entity->name],
+                'totem_id' => $totem->id,
+                'preset_id' => $preset->id,
+                'entity_id' => $preset->entity_id,
+            ];
+        });
+
+        if (isset($result['failure'])) {
+            // Same 401 for every reason (no oracle); the reason lives only here. Code never logged.
+            Log::channel('audit')->warning('totem.pairing.failed', [
+                'reason' => $result['failure'],
+                'preset_id' => $result['preset_id'],
+                'ip' => $ip,
+            ]);
+
+            return null;
+        }
+
+        Log::channel('audit')->info('totem.pairing.succeeded', [
+            'totem_id' => $result['totem_id'],
+            'preset_id' => $result['preset_id'],
+            'entity_id' => $result['entity_id'],
+            'ip' => $ip,
+        ]);
+
+        return ['token' => $result['token'], 'entity' => $result['entity']];
+    }
+}
