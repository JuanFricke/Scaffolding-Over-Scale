+<?php
+
+namespace App\Enums;
+
+/**
+ * Backend-owned ticket priority levels: the single source for the totem
+ * priorities endpoint and for validating the priority sent on issuance.
+ * Higher value = more prioritized (stored in tickets.priority).
+ */
+enum TicketPriority: int
+{
+    case Normal = 0;
+    case Priority = 10;
+    case Priority80 = 20;
+
+    public function label(): string
+    {
+        return match ($this) {
+            self::Normal => 'Normal',
+            self::Priority => 'Prioritário',
+            self::Priority80 => 'Prioridade 80+',
+        };
+    }
+
+    /**
+     * Presentation-only hints for the totem UI.
+     *
+     * @return array{color: string, icon: string, order: int}
+     */
+    public function visual(): array
+    {
+        return match ($this) {
+            self::Normal => ['color' => '#2E7D32', 'icon' => 'person', 'order' => 1],
+            self::Priority => ['color' => '#C62828', 'icon' => 'priority', 'order' => 2],
+            self::Priority80 => ['color' => '#6A1B9A', 'icon' => 'elderly', 'order' => 3],
+        };
+    }
+
+    /**
+     * Strictly resolve a client-supplied value (int, or integer string).
+     */
+    public static function fromInput(mixed $value): ?self
+    {
+        if (! is_int($value) && ! is_string($value)) {
+            return null;
+        }
+
+        $int = filter_var($value, FILTER_VALIDATE_INT);
+
+        return $int === false ? null : self::tryFrom($int);
+    }
+}
