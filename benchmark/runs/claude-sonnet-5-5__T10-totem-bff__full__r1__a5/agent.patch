+<?php
+
+/*
+|--------------------------------------------------------------------------
+| Cross-Origin Resource Sharing
+|--------------------------------------------------------------------------
+|
+| Only the totem API (api/*) answers CORS. The totem's web build runs on a
+| local static server in development, so loopback origins are allowed on any
+| port, plus an optional explicit origin (TOTEM_WEB_ORIGIN). Every other origin
+| gets no Access-Control-Allow-Origin header. No credentials (Bearer token only).
+|
+*/
+
+return [
+
+    'paths' => ['api/*'],
+
+    'allowed_methods' => ['*'],
+
+    'allowed_origins' => array_values(array_filter([
+        rtrim((string) env('TOTEM_WEB_ORIGIN', ''), '/'),
+    ])),
+
+    'allowed_origins_patterns' => ['#^https?://(localhost|127\.0\.0\.1)(:\d+)?$#'],
+
+    'allowed_headers' => ['*'],
+
+    'exposed_headers' => [],
+
+    'max_age' => 600,
+
+    'supports_credentials' => false,
+
+];
