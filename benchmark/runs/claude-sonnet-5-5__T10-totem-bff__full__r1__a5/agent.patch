+/**
+ * A paired totem: entity, preset with the given queues attached, totem row and a valid JWT.
+ *
+ * @param  iterable<Queue>|null  $queues  defaults to two active queues (alpha, beta); the entity is theirs
+ * @return array{entity: Entity, preset: TotemPreset, totem: Totem, queues: Collection<int, Queue>, token: string, headers: array<string, string>}
+ */
+function pairedTotem(?iterable $queues = null): array
+{
+    $queues = $queues === null ? null : collect($queues);
+    $entity = $queues?->first()?->entity ?? Entity::factory()->create();
+    $queues ??= collect([
+        Queue::factory()->for($entity)->create(['name' => 'Alpha', 'slug' => 'alpha']),
+        Queue::factory()->for($entity)->create(['name' => 'Beta', 'slug' => 'beta']),
+    ]);
+
+    $preset = TotemPreset::factory()->for($entity)->create();
+    $preset->queues()->attach($queues->pluck('id')->all());
+    $totem = Totem::factory()->for($entity)->create();
+    $token = TotemToken::issue($totem->id, $entity->id, $preset->id, $queues->pluck('id')->all());
+
+    return compact('entity', 'preset', 'totem', 'queues', 'token') + ['headers' => ['Authorization' => 'Bearer '.$token]];
+}
