 });
+
+test('appends a discord mention when mention_id is configured', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '123456789012345678',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert title', 'Alert message');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return str_contains($content, 'Alert title')
+            && str_contains($content, 'Alert message')
+            && str_ends_with(trim($content), '<@123456789012345678>');
+    });
+});
+
+test('does not add mention when mention_id is null', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => null,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert title', 'Alert message');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+});
+
+test('does not add mention when mention_id is empty string', function () {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => '',
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert title', 'Alert message');
+
+    Http::assertSent(function (Request $request) {
+        $content = $request['content'] ?? '';
+
+        return ! str_contains($content, '<@');
+    });
+});
+
+test('validates mention_id as 17-20 digit discord snowflake', function (?string $id, bool $shouldMention) {
+    $url = 'https://discord.test/api/webhooks/123/secret-token';
+    config([
+        'services.discord.webhook_url' => $url,
+        'services.discord.mention_id' => $id,
+    ]);
+
+    Http::fake([
+        $url => Http::response('', 204),
+    ]);
+
+    (new DiscordOpsAlert)->send('Alert', 'Message');
+
+    Http::assertSent(function (Request $request) use ($shouldMention) {
+        $content = $request['content'] ?? '';
+
+        if ($shouldMention) {
+            return str_contains($content, '<@');
+        }
+
+        return ! str_contains($content, '<@');
+    });
+})->with([
+    'valid 17 digits' => ['12345678901234567', true],
+    'valid 18 digits' => ['123456789012345678', true],
+    'valid 19 digits' => ['1234567890123456789', true],
+    'valid 20 digits' => ['12345678901234567890', true],
+    'too short 16 digits' => ['1234567890123456', false],
+    'too long 21 digits' => ['123456789012345678901', false],
+    'non-numeric' => ['abc123def456789012', false],
+    'contains whitespace' => ['123 456789012345678', false],
+    '@mention format' => ['@123456789012345678', false],
+    '@everyone' => ['@everyone', false],
+    '@here' => ['@here', false],
+    'with newline' => ["123456789012345678\n@everyone", false],
+]);
+
