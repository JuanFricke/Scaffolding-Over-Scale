diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
index 78c2de9..2745f6e 100644
--- a/app/Ops/DiscordOpsAlert.php
+++ b/app/Ops/DiscordOpsAlert.php
@@ -25,6 +25,8 @@ class DiscordOpsAlert
 
     private const string BearerLikePattern = '/Bearer\s+\S+/i';
 
+    private const string SnowflakePattern = '/^\d{17,20}$/';
+
     /**
      * @param  array<string, mixed>  $context
      */
@@ -60,13 +62,26 @@ public function send(string $title, string $message, array $context = []): void
      */
     private function formatContent(string $title, string $message, array $context): string
     {
+        $mention = $this->formatMention();
+
         $lines = [$title, $message];
 
         foreach ($context as $key => $value) {
             $lines[] = $key.'='.$this->safe((string) $key, $value);
         }
 
-        return mb_substr(implode("\n", $lines), 0, self::MaxContentLength);
+        $baseContent = implode("\n", $lines);
+
+        if ($mention === '') {
+            return mb_substr($baseContent, 0, self::MaxContentLength);
+        }
+
+        $mentionWithNewline = "\n".$mention;
+        $mentionLength = mb_strlen($mentionWithNewline);
+        $maxBaseLength = self::MaxContentLength - $mentionLength;
+        $truncatedContent = mb_substr($baseContent, 0, $maxBaseLength);
+
+        return $truncatedContent.$mentionWithNewline;
     }
 
     private function safe(string $key, mixed $value): string
@@ -95,4 +110,36 @@ private function safe(string $key, mixed $value): string
 
         return json_encode($value, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) ?: '[unserializable]';
     }
+
+    private function formatMention(): string
+    {
+        $mentionId = config('services.discord.mention_id');
+
+        if (! $mentionId) {
+            return '';
+        }
+
+        $validatedId = $this->validateSnowflake($mentionId);
+
+        return $validatedId ? '<@'.$validatedId.'>' : '';
+    }
+
+    private function validateSnowflake(mixed $value): ?string
+    {
+        if (is_int($value)) {
+            $value = (string) $value;
+        }
+
+        if (! is_string($value)) {
+            return null;
+        }
+
+        $value = trim($value);
+
+        if (preg_match(self::SnowflakePattern, $value)) {
+            return $value;
+        }
+
+        return null;
+    }
 }
