+<?php
+
+use App\Actions\IssueTicket;
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Schema;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+it('resolves the default prefix from priority levels and ranges', function () {
+    $queue = Queue::factory()->create();
+
+    expect(Queue::DEFAULT_PREFIX_MAP)->toBe([0 => 'N', 10 => 'P', 20 => 'E'])
+        ->and(Queue::defaultPrefixFor(0))->toBe('N')
+        ->and(Queue::defaultPrefixFor(10))->toBe('P')
+        ->and(Queue::defaultPrefixFor(20))->toBe('E')
+        ->and(Queue::defaultPrefixFor(-1))->toBe('N')
+        ->and(Queue::defaultPrefixFor(5))->toBe('P')
+        ->and(Queue::defaultPrefixFor(19))->toBe('P')
+        ->and(Queue::defaultPrefixFor(99))->toBe('E')
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(10))->toBe('P')
+        ->and($queue->prefixForPriority(20))->toBe('E')
+        ->and($queue->prefixForPriority(5))->toBe('P')
+        ->and($queue->prefixForPriority(99))->toBe('E');
+});
+
+it('prefers custom map entries and falls back to the default for uncovered priorities', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => [10 => 'Y'],
+    ]);
+
+    expect($queue->prefixForPriority(10))->toBe('Y')
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(20))->toBe('E')
+        ->and($queue->prefixForPriority(5))->toBe('P');
+});
+
+it('casts the priority prefix map to an array', function () {
+    $queue = Queue::factory()->create([
+        'priority_prefix_map' => [0 => 'X', 10 => 'Y', 20 => 'Z'],
+    ]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z']);
+});
+
+it('normalizes an empty map to null on every save', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+
+    $queue->priority_prefix_map = [0 => 'X'];
+    $queue->save();
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+
+    $queue->priority_prefix_map = [];
+    $queue->save();
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('does not mass assign the priority prefix map', function () {
+    $queue = Queue::factory()->create();
+
+    $queue->update(['priority_prefix_map' => [0 => 'X']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('rejects invalid priority prefix maps on save', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+})->with([
+    'non numeric key' => [['foo' => 'X']],
+    'negative key' => [[-1 => 'X']],
+    'leading zero key' => [['010' => 'X']],
+    'trailing newline key' => [["1\n" => 'X']],
+    'lowercase value' => [[0 => 'xx']],
+    'trailing newline value' => [[0 => "A\n"]],
+    'multiple letters' => [[0 => 'NN']],
+    'non letter value' => [[0 => '1']],
+    'duplicate custom levels' => [[0 => 'N', 10 => 'N']],
+    'custom level merges with default 80+' => [[0 => 'E']],
+    'duplicate extra levels' => [[5 => 'X', 30 => 'X']],
+]);
+
+it('accepts valid custom maps', function (array $map) {
+    $queue = Queue::factory()->create(['priority_prefix_map' => $map]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe($map);
+})->with([
+    'all levels' => [[0 => 'X', 10 => 'Y', 20 => 'Z']],
+    'partial map' => [[10 => 'Y']],
+    'extra level' => [[5 => 'X']],
+    'same as defaults' => [[0 => 'N', 10 => 'P', 20 => 'E']],
+]);
+
+it('validates the map whenever an existing queue is saved', function () {
+    $queue = Queue::factory()->create();
+
+    $queue->priority_prefix_map = [0 => 'N', 10 => 'N'];
+
+    expect(fn () => $queue->save())->toThrow(InvalidArgumentException::class)
+        ->and($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('updates, preserves and clears the priority prefix map through UpdateQueue', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create(['name' => 'Geral']);
+
+    $updated = (new UpdateQueue)($queue, $owner, priorityPrefixMap: [0 => 'X']);
+
+    expect($updated->fresh()->priority_prefix_map)->toBe([0 => 'X'])
+        ->and($updated->fresh()->prefixForPriority(0))->toBe('X');
+
+    $renamed = (new UpdateQueue)($updated->fresh(), $owner, name: 'Geral Novo');
+
+    expect($renamed->fresh()->priority_prefix_map)->toBe([0 => 'X'])
+        ->and($renamed->fresh()->name)->toBe('Geral Novo');
+
+    $cleared = (new UpdateQueue)($renamed->fresh(), $owner, priorityPrefixMap: []);
+
+    expect($cleared->fresh()->priority_prefix_map)->toBeNull()
+        ->and($cleared->fresh()->prefixForPriority(0))->toBe('N');
+});
+
+it('rejects an invalid map without changing the queue', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $queue = Queue::factory()->for($entity)->create([
+        'name' => 'Original',
+        'priority_prefix_map' => [0 => 'X'],
+    ]);
+
+    try {
+        (new UpdateQueue)(
+            $queue,
+            $owner,
+            name: 'Changed',
+            priorityPrefixMap: [0 => 'N', 10 => 'N'],
+        );
+
+        $this->fail('Expected a ValidationException.');
+    } catch (ValidationException $e) {
+        expect($e->errors())->toHaveKey('priority_prefix_map');
+    }
+
+    $fresh = $queue->fresh();
+
+    expect($fresh->name)->toBe('Original')
+        ->and($fresh->priority_prefix_map)->toBe([0 => 'X']);
+});
+
+it('authorizes before validating the priority prefix map', function () {
+    $entity = Entity::factory()->create();
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $queue = Queue::factory()->for($entity)->create();
+
+    expect(fn () => (new UpdateQueue)(
+        $queue,
+        $employee,
+        priorityPrefixMap: [0 => 'N', 10 => 'N'],
+    ))->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('issues codes with the custom map from the factory', function () {
+    $queue = Queue::factory()->create([
+        'is_active' => true,
+        'priority_prefix_map' => [0 => 'X', 10 => 'Y', 20 => 'Z'],
+    ]);
+
+    $normal = (new IssueTicket)($queue, 0);
+    $priority = (new IssueTicket)($queue, 10);
+    $eightyPlus = (new IssueTicket)($queue, 20);
+
+    expect($normal->code)->toBe('X001')
+        ->and($priority->code)->toBe('Y001')
+        ->and($eightyPlus->code)->toBe('Z001');
+});
+
+it('adds the priority prefix map column and daily ticket unique index', function () {
+    expect(Schema::hasColumn('queues', 'priority_prefix_map'))->toBeTrue()
+        ->and(Schema::hasColumn('tickets', 'issue_date'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_code_issue_date_unique'))->toBeTrue()
+        ->and(Schema::hasIndex('tickets', 'tickets_queue_id_code_unique'))->toBeFalse();
+});
+
+it('enforces the daily unique index at the database level', function () {
+    $queue = Queue::factory()->create();
+
+    Ticket::factory()->create([
+        'queue_id' => $queue->id,
+        'code' => 'N001',
+        'issued_at' => '2026-09-28 10:00:00',
+    ]);
+
+    expect(fn () => Ticket::factory()->create([
+        'queue_id' => $queue->id,
+        'code' => 'N001',
+        'issued_at' => '2026-09-28 11:00:00',
+    ]))->toThrow(QueryException::class);
+
+    $nextDay = Ticket::factory()->create([
+        'queue_id' => $queue->id,
+        'code' => 'N001',
+        'issued_at' => '2026-09-29 10:00:00',
+    ]);
+
+    expect($nextDay->issue_date->toDateString())->toBe('2026-09-29');
+});
