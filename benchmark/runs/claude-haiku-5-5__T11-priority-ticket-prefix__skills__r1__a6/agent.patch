diff --git a/tests/Feature/QueuePriorityPrefixTest.php b/tests/Feature/QueuePriorityPrefixTest.php
new file mode 100644
index 0000000..c37f309
--- /dev/null
+++ b/tests/Feature/QueuePriorityPrefixTest.php
@@ -0,0 +1,111 @@
+<?php
+
+use App\Models\Queue;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+
+uses(RefreshDatabase::class);
+
+it('derives the default prefix from the priority level and range', function () {
+    expect(Queue::defaultPrefixFor(0))->toBe('N')
+        ->and(Queue::defaultPrefixFor(10))->toBe('P')
+        ->and(Queue::defaultPrefixFor(20))->toBe('E')
+        ->and(Queue::defaultPrefixFor(5))->toBe('P')
+        ->and(Queue::defaultPrefixFor(15))->toBe('P')
+        ->and(Queue::defaultPrefixFor(25))->toBe('E')
+        ->and(Queue::defaultPrefixFor(-3))->toBe('N');
+});
+
+it('uses the default prefixes when the queue has no custom map', function () {
+    $queue = Queue::factory()->create();
+
+    expect($queue->priority_prefix_map)->toBeNull()
+        ->and($queue->prefixForPriority(0))->toBe('N')
+        ->and($queue->prefixForPriority(10))->toBe('P')
+        ->and($queue->prefixForPriority(12))->toBe('P')
+        ->and($queue->prefixForPriority(20))->toBe('E');
+});
+
+it('lets a custom map win per priority and keeps defaults for uncovered levels', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '5' => 'W']]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBe([0 => 'X', 5 => 'W'])
+        ->and($queue->prefixForPriority(0))->toBe('X')
+        ->and($queue->prefixForPriority(5))->toBe('W')
+        ->and($queue->prefixForPriority(10))->toBe('P')
+        ->and($queue->prefixForPriority(20))->toBe('E');
+});
+
+it('accepts a full custom map and a swapped one', function () {
+    $full = Queue::factory()->create(['priority_prefix_map' => ['0' => 'X', '10' => 'Y', '20' => 'Z']]);
+    $swapped = Queue::factory()->create(['priority_prefix_map' => ['0' => 'E', '20' => 'N']]);
+
+    expect($full->prefixForPriority(10))->toBe('Y')
+        ->and($full->prefixForPriority(20))->toBe('Z')
+        ->and($swapped->prefixForPriority(0))->toBe('E')
+        ->and($swapped->prefixForPriority(10))->toBe('P')
+        ->and($swapped->prefixForPriority(20))->toBe('N');
+});
+
+it('stores an empty map as null on every save', function () {
+    $queue = Queue::factory()->create(['priority_prefix_map' => []]);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+
+    $queue->priority_prefix_map = ['10' => 'Y'];
+    $queue->save();
+    $queue->priority_prefix_map = [];
+    $queue->save();
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
+
+it('is not mass-assignable', function () {
+    expect((new Queue)->isFillable('priority_prefix_map'))->toBeFalse();
+});
+
+it('rejects invalid map keys', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+})->with([
+    'non numeric key' => [['foo' => 'X']],
+    'negative key' => [['-1' => 'X']],
+    'leading zero key' => [['010' => 'X']],
+    'decimal key' => [['1.5' => 'X']],
+]);
+
+it('rejects values that are not exactly one uppercase letter', function (mixed $value) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => ['0' => $value]]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+})->with([
+    'two letters' => ['xx'],
+    'lowercase' => ['x'],
+    'digit' => ['1'],
+    'empty' => [''],
+    'integer' => [5],
+]);
+
+it('rejects effective prefixes that repeat a letter', function (array $map) {
+    expect(fn () => Queue::factory()->create(['priority_prefix_map' => $map]))
+        ->toThrow(InvalidArgumentException::class);
+
+    expect(Queue::query()->count())->toBe(0);
+})->with([
+    'normal and priority share a letter' => [['0' => 'N', '10' => 'N']],
+    'normal merges with 80+ default' => [['0' => 'E']],
+    'priority merges with 80+ default' => [['10' => 'E']],
+    'custom merges with uncovered normal default' => [['5' => 'N']],
+    'custom entries repeat' => [['0' => 'X', '5' => 'X']],
+]);
+
+it('re-validates the map whenever the queue is saved', function () {
+    $queue = Queue::factory()->create();
+
+    $queue->priority_prefix_map = ['0' => 'N', '10' => 'N'];
+
+    expect(fn () => $queue->save())->toThrow(InvalidArgumentException::class);
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
