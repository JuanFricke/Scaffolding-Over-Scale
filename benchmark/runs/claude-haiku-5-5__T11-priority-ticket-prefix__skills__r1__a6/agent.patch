+<?php
+
+use App\Actions\IssueTicket;
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+afterEach(fn () => Carbon::setTestNow());
+
+it('sequences each priority prefix independently', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    $normalFirst = (new IssueTicket)($queue, 0);
+    $normalSecond = (new IssueTicket)($queue, 0);
+    $priorityFirst = (new IssueTicket)($queue, 10);
+    $priority80 = (new IssueTicket)($queue, 20);
+    $prioritySecond = (new IssueTicket)($queue, 10);
+
+    expect([$normalFirst->code, $normalSecond->code])->toBe(['N001', 'N002'])
+        ->and([$priorityFirst->code, $prioritySecond->code])->toBe(['P001', 'P002'])
+        ->and($priority80->code)->toBe('E001');
+});
+
+it('maps priorities between and above the levels by range', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    expect((new IssueTicket)($queue, 5)->code)->toBe('P001')
+        ->and((new IssueTicket)($queue, 15)->code)->toBe('P002')
+        ->and((new IssueTicket)($queue, 25)->code)->toBe('E001');
+});
+
+it('ignores legacy A codes when allocating the normal sequence', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Ticket::factory()->for($queue)->create(['code' => 'A001']);
+
+    expect((new IssueTicket)($queue)->code)->toBe('N001');
+});
+
+it('uses the queue custom prefix map when present', function () {
+    $queue = Queue::factory()->create([
+        'is_active' => true,
+        'priority_prefix_map' => ['0' => 'X', '10' => 'Y'],
+    ]);
+
+    expect((new IssueTicket)($queue, 0)->code)->toBe('X001')
+        ->and((new IssueTicket)($queue, 10)->code)->toBe('Y001')
+        ->and((new IssueTicket)($queue, 20)->code)->toBe('E001');
+});
+
+it('restarts every prefix at 001 on the next day', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Carbon::setTestNow('2026-10-28 10:00:00');
+    (new IssueTicket)($queue, 0);
+    (new IssueTicket)($queue, 0);
+    (new IssueTicket)($queue, 10);
+
+    Carbon::setTestNow('2026-10-29 09:00:00');
+    $normal = (new IssueTicket)($queue, 0);
+    $priority = (new IssueTicket)($queue, 10);
+
+    expect($normal->code)->toBe('N001')
+        ->and($normal->issue_date->toDateString())->toBe('2026-10-29')
+        ->and($priority->code)->toBe('P001')
+        ->and($priority->issue_date->toDateString())->toBe('2026-10-29');
+});
+
+it('does not split the sequence at midnight', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Carbon::setTestNow('2026-10-28 23:59:59');
+    $late = (new IssueTicket)($queue, 0);
+
+    Carbon::setTestNow('2026-10-29 00:00:00');
+    $early = (new IssueTicket)($queue, 0);
+
+    expect($late->code)->toBe('N001')
+        ->and($late->issue_date->toDateString())->toBe('2026-10-28')
+        ->and($early->code)->toBe('N001')
+        ->and($early->issue_date->toDateString())->toBe('2026-10-29');
+});
+
+it('keeps the code day, issued_at and issue_date on the same instant', function () {
+    $queue = Queue::factory()->create(['is_active' => true]);
+
+    Carbon::setTestNow('2026-10-28 23:59:59.500');
+    $ticket = (new IssueTicket)($queue, 0);
+
+    expect($ticket->code)->toBe('N001')
+        ->and($ticket->issue_date->toDateString())->toBe('2026-10-28')
+        ->and($ticket->issued_at->toDateTimeString())->toBe('2026-10-28 23:59:59');
+});
