+++ b/tests/Feature/TicketIssueDateMigrationTest.php
@@ -0,0 +1,62 @@
+<?php
+
+use App\Models\Queue;
+use Illuminate\Database\QueryException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Artisan;
+use Illuminate\Support\Facades\DB;
+
+uses(RefreshDatabase::class);
+
+/**
+ * @return array<string, mixed>
+ */
+function legacyTicket(int $queueId, string $code, string $issuedAt): array
+{
+    return [
+        'queue_id' => $queueId,
+        'code' => $code,
+        'priority' => 0,
+        'channel' => 'virtual',
+        'status' => 'waiting',
+        'issued_at' => $issuedAt,
+        'created_at' => $issuedAt,
+        'updated_at' => $issuedAt,
+    ];
+}
+
+it('backfills issue_date from issued_at and then requires it', function () {
+    Artisan::call('migrate:rollback', ['--step' => 1]);
+
+    $queue = Queue::factory()->create();
+    DB::table('tickets')->insert([
+        legacyTicket($queue->id, 'A001', '2026-09-27 23:30:00'),
+        legacyTicket($queue->id, 'A002', '2026-09-28 08:00:00'),
+    ]);
+
+    Artisan::call('migrate', ['--force' => true]);
+
+    expect(DB::table('tickets')->orderBy('id')->pluck('issue_date')->all())
+        ->toBe(['2026-09-27', '2026-09-28']);
+
+    expect(fn () => DB::table('tickets')->insert([
+        legacyTicket($queue->id, 'N001', '2026-10-29 10:00:00'),
+    ]))->toThrow(QueryException::class);
+});
+
+it('keys unique codes per queue and issue date', function () {
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create();
+
+    DB::table('tickets')->insert([
+        array_merge(legacyTicket($queue->id, 'N001', '2026-10-28 10:00:00'), ['issue_date' => '2026-10-28']),
+        array_merge(legacyTicket($queue->id, 'N001', '2026-10-29 10:00:00'), ['issue_date' => '2026-10-29']),
+        array_merge(legacyTicket($other->id, 'N001', '2026-10-29 10:00:00'), ['issue_date' => '2026-10-29']),
+    ]);
+
+    expect(fn () => DB::table('tickets')->insert([
+        array_merge(legacyTicket($queue->id, 'N001', '2026-10-29 11:00:00'), ['issue_date' => '2026-10-29']),
+    ]))->toThrow(QueryException::class);
+
+    expect(DB::table('tickets')->count())->toBe(3);
+});
diff --git a/tests/Feature/UpdateQueuePrefixMapTest.php b/tests/Feature/UpdateQueuePrefixMapTest.php
new file mode 100644
index 0000000..8fc9c4b
--- /dev/null
+++ b/tests/Feature/UpdateQueuePrefixMapTest.php
@@ -0,0 +1,92 @@
+<?php
+
+use App\Actions\CreateQueue;
+use App\Actions\UpdateQueue;
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\User;
+use Illuminate\Auth\Access\AuthorizationException;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Validation\ValidationException;
+
+uses(RefreshDatabase::class);
+
+function prefixMapOwner(Entity $entity): User
+{
+    $owner = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($owner)->owner()->create();
+
+    return $owner;
+}
+
+it('stores a custom priority prefix map for owner and admin', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixMapOwner($entity);
+    $queue = (new CreateQueue)($entity, $owner, 'Geral', 'geral');
+
+    $updated = (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X', '10' => 'Y', '20' => 'Z']);
+
+    expect($updated->priority_prefix_map)->toBe([0 => 'X', 10 => 'Y', 20 => 'Z'])
+        ->and($queue->fresh()->prefixForPriority(10))->toBe('Y');
+});
+
+it('leaves the map unchanged when the parameter is omitted', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixMapOwner($entity);
+    $queue = (new CreateQueue)($entity, $owner, 'Geral', 'geral');
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X']);
+
+    (new UpdateQueue)($queue->fresh(), $owner, name: 'Renomeada');
+
+    expect($queue->fresh()->name)->toBe('Renomeada')
+        ->and($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+});
+
+it('clears back to the default map when given an empty array', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixMapOwner($entity);
+    $queue = (new CreateQueue)($entity, $owner, 'Geral', 'geral');
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X']);
+
+    (new UpdateQueue)($queue->fresh(), $owner, priorityPrefixMap: []);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull()
+        ->and($queue->fresh()->prefixForPriority(0))->toBe('N');
+});
+
+it('rejects an invalid map with a validation error and leaves the queue unchanged', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixMapOwner($entity);
+    $queue = (new CreateQueue)($entity, $owner, 'Geral', 'geral');
+    (new UpdateQueue)($queue, $owner, priorityPrefixMap: ['0' => 'X']);
+
+    $error = null;
+
+    try {
+        (new UpdateQueue)($queue->fresh(), $owner, name: 'Outra', priorityPrefixMap: ['0' => 'N', '10' => 'N']);
+    } catch (ValidationException $e) {
+        $error = $e;
+    }
+
+    expect($error?->errors())->toHaveKey('priority_prefix_map');
+    expect($queue->fresh()->name)->toBe('Geral')
+        ->and($queue->fresh()->priority_prefix_map)->toBe([0 => 'X']);
+});
+
+it('rejects a map change from employees and non-members', function () {
+    $entity = Entity::factory()->create();
+    $owner = prefixMapOwner($entity);
+    $queue = (new CreateQueue)($entity, $owner, 'Geral', 'geral');
+
+    $employee = User::factory()->create();
+    EntityMembership::factory()->for($entity)->for($employee)->employee()->create();
+    $outsider = User::factory()->create();
+
+    expect(fn () => (new UpdateQueue)($queue, $employee, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect(fn () => (new UpdateQueue)($queue, $outsider, priorityPrefixMap: ['0' => 'X']))
+        ->toThrow(AuthorizationException::class);
+
+    expect($queue->fresh()->priority_prefix_map)->toBeNull();
+});
