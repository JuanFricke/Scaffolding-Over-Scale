+<?php
+
+use App\Models\Queue;
+use App\Models\Ticket;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+afterEach(fn () => Carbon::setTestNow());
+
+it('defaults issue_date to the date of issued_at', function () {
+    $ticket = Ticket::factory()->create(['issued_at' => '2026-09-28 10:00:00']);
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-09-28');
+});
+
+it('defaults issue_date to today when no issued_at is given', function () {
+    Carbon::setTestNow('2026-10-29 12:00:00');
+
+    $ticket = Ticket::factory()->create();
+
+    expect($ticket->issue_date->toDateString())->toBe('2026-10-29');
+});
+
+it('allocates the code for the ticket priority and its own day', function () {
+    $queue = Queue::factory()->create();
+    Carbon::setTestNow('2026-10-29 09:00:00');
+    Ticket::factory()->forQueue($queue)->create();
+
+    $backdated = Ticket::factory()->forQueue($queue)->create([
+        'issued_at' => '2026-09-28 10:00:00',
+    ]);
+    $priority = Ticket::factory()->forQueue($queue)->create([
+        'priority' => 10,
+        'issued_at' => '2026-09-28 11:00:00',
+    ]);
+
+    expect($backdated->code)->toBe('N001')
+        ->and($backdated->issue_date->toDateString())->toBe('2026-09-28')
+        ->and($priority->code)->toBe('P001')
+        ->and($priority->issue_date->toDateString())->toBe('2026-09-28');
+});
+
+it('keeps an explicit code', function () {
+    $ticket = Ticket::factory()->create(['code' => 'A999']);
+
+    expect($ticket->code)->toBe('A999');
+});
diff --git a/tests/Feature/TicketIssueDateMigrationTest.php b/tests/Feature/TicketIssueDateMigrationTest.php
new file mode 100644
