+     * Default display letter for a priority, without any queue customization.
+     */
+    public static function defaultPrefixFor(int $priority): string
+    {
+        return self::DEFAULT_PREFIX_MAP[$priority] ?? match (true) {
+            $priority <= 0 => 'N',
+            $priority >= 20 => 'E',
+            default => 'P',
+        };
+    }
+
+    /**
+     * Validate a custom priority prefix map and return it in storage form.
+     *
+     * Keys are canonical non-negative integers and values one uppercase letter.
+     * Effective prefixes must be unique: the custom entries plus the default
+     * for each of the 0/10/20 levels the map does not cover. An empty map is
+     * stored as null.
+     *
+     * @param  array<array-key, mixed>|null  $map
+     * @return array<int, string>|null
+     *
+     * @throws InvalidArgumentException
+     */
+    public static function normalizePrefixMap(?array $map): ?array
+    {
+        if ($map === null || $map === []) {
+            return null;
+        }
+
+        foreach ($map as $priority => $letter) {
+            $key = (string) $priority;
+
+            if (! preg_match('/^(0|[1-9]\d*)$/', $key) || (string) (int) $key !== $key) {
+                throw new InvalidArgumentException("Priority \"{$key}\" must be a non-negative integer.");
+            }
+
+            if (! is_string($letter) || ! preg_match('/^[A-Z]$/', $letter)) {
+                throw new InvalidArgumentException("Prefix for priority {$key} must be one uppercase letter A-Z.");
+            }
+        }
+
+        $effective = array_values($map);
+
+        foreach (self::DEFAULT_PREFIX_MAP as $level => $default) {
+            if (! array_key_exists($level, $map)) {
+                $effective[] = $default;
+            }
+        }
+
+        if (count(array_unique($effective)) !== count($effective)) {
+            throw new InvalidArgumentException('Priority prefixes must be unique within a queue.');
+        }
