+<?php
+
+use App\Actions\CallNextTicket;
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Events\QueryExecuted;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Carbon;
+
+uses(RefreshDatabase::class);
+
+beforeEach(function () {
+    // Freeze time so issued_at/called_at timestamps are deterministic.
+    Carbon::setTestNow('2026-02-01 10:00:00');
+});
+
+afterEach(function () {
+    Carbon::setTestNow();
+});
+
+function waitingTicketIn(Queue $queue, array $attributes = []): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create($attributes);
+}
+
+function calledTicketIn(Queue $queue, int $priority, Carbon $calledAt): Ticket
+{
+    return Ticket::factory()->forQueue($queue)->create([
+        'priority' => $priority,
+        'status' => TicketStatus::Called,
+        'called_at' => $calledAt,
+        'called_by_user_id' => User::factory(),
+    ]);
+}
+
+it('calls the oldest waiting normal ticket by default', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    $oldest = waitingTicketIn($queue, ['issued_at' => now()->subMinutes(3)]);
+    waitingTicketIn($queue, ['issued_at' => now()->subMinutes(2)]);
+    waitingTicketIn($queue, ['issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($oldest))->toBeTrue();
+});
+
+it('returns the ticket with the call fields already applied', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+    waitingTicketIn($queue, ['issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called)
+        ->status->toBe(TicketStatus::Called)
+        ->called_at->toEqual(now())
+        ->called_by_user_id->toBe($user->id)
+        ->and($called->fresh()->status)->toBe(TicketStatus::Called);
+});
+
+it('orders by higher priority first', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    $higher = waitingTicketIn($queue, ['priority' => 10, 'issued_at' => now()]);
+    waitingTicketIn($queue, ['priority' => 5, 'issued_at' => now()->subMinutes(2)]);
+    waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(3)]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($higher))->toBeTrue();
+});
+
+it('orders by oldest issued_at within the same priority', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    $older = waitingTicketIn($queue, ['priority' => 5, 'issued_at' => now()->subMinutes(2)]);
+    waitingTicketIn($queue, ['priority' => 5, 'issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($older))->toBeTrue();
+});
+
+it('tie-breaks by lowest id when priority and issued_at are equal', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    $first = waitingTicketIn($queue, ['priority' => 5, 'issued_at' => now()->subMinute()]);
+    $second = waitingTicketIn($queue, ['priority' => 5, 'issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($first))->toBeTrue();
+    expect($second->id)->toBeGreaterThan($first->id);
+});
+
+it('never selects waiting tickets of another queue', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+    $other = Queue::factory()->create();
+
+    waitingTicketIn($other, ['issued_at' => now()->subHour()]);
+
+    expect(fn () => (new CallNextTicket)($queue, $user))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($other->tickets->sole()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('never calls an already called ticket again', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+    $only = waitingTicketIn($queue, ['issued_at' => now()]);
+
+    (new CallNextTicket)($queue, $user);
+
+    expect(fn () => (new CallNextTicket)($queue, $user))
+        ->toThrow(NoWaitingTicketsException::class);
+
+    expect($only->fresh())
+        ->status->toBe(TicketStatus::Called)
+        ->called_by_user_id->toBe($user->id);
+});
+
+it('skips a called ticket and picks the next waiting one', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    calledTicketIn($queue, 10, now()->subMinutes(2));
+    $waiting = waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($waiting))->toBeTrue();
+});
+
+it('throws when the queue has no waiting tickets', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    expect(fn () => (new CallNextTicket)($queue, $user))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('priority_only ignores normal tickets', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subHour()]);
+    $priority = waitingTicketIn($queue, ['priority' => 5, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $user, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('priority_only keeps the full ordering among priority tickets', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    waitingTicketIn($queue, ['priority' => 5, 'issued_at' => now()->subMinutes(2)]);
+    $oldestTop = waitingTicketIn($queue, ['priority' => 10, 'issued_at' => now()->subMinute()]);
+    waitingTicketIn($queue, ['priority' => 10, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $user, CallMode::PriorityOnly);
+
+    expect($called->is($oldestTop))->toBeTrue();
+});
+
+it('priority_only throws when only normal tickets wait', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()]);
+
+    expect(fn () => (new CallNextTicket)($queue, $user, CallMode::PriorityOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('normal_only ignores priority tickets', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    waitingTicketIn($queue, ['priority' => 10, 'issued_at' => now()->subHour()]);
+    $normal = waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $user, CallMode::NormalOnly);
+
+    expect($called->is($normal))->toBeTrue();
+});
+
+it('normal_only calls the oldest normal ticket', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    $oldest = waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subMinutes(2)]);
+    waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subMinute()]);
+
+    $called = (new CallNextTicket)($queue, $user, CallMode::NormalOnly);
+
+    expect($called->is($oldest))->toBeTrue();
+});
+
+it('normal_only throws when only priority tickets wait', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    waitingTicketIn($queue, ['priority' => 10, 'issued_at' => now()]);
+
+    expect(fn () => (new CallNextTicket)($queue, $user, CallMode::NormalOnly))
+        ->toThrow(NoWaitingTicketsException::class);
+});
+
+it('forces the oldest normal ticket after three consecutive priority calls', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    calledTicketIn($queue, 10, now()->subMinutes(3));
+    calledTicketIn($queue, 10, now()->subMinutes(2));
+    calledTicketIn($queue, 5, now()->subMinute());
+
+    $priority = waitingTicketIn($queue, ['priority' => 20, 'issued_at' => now()]);
+    $normal = waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subHour()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($normal))->toBeTrue();
+    expect($priority->fresh()->status)->toBe(TicketStatus::Waiting);
+});
+
+it('keeps full ordering after fewer than three consecutive priority calls', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    calledTicketIn($queue, 10, now()->subMinutes(2));
+    calledTicketIn($queue, 10, now()->subMinute());
+
+    $priority = waitingTicketIn($queue, ['priority' => 20, 'issued_at' => now()]);
+    waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subHour()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('resumes full ordering when a normal call breaks the streak', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    calledTicketIn($queue, 10, now()->subMinutes(3));
+    calledTicketIn($queue, 10, now()->subMinutes(2));
+    calledTicketIn($queue, 0, now()->subMinute());
+
+    $priority = waitingTicketIn($queue, ['priority' => 20, 'issued_at' => now()]);
+    waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subHour()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('keeps calling priority tickets when no normal is waiting', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    calledTicketIn($queue, 10, now()->subMinutes(3));
+    calledTicketIn($queue, 10, now()->subMinutes(2));
+    calledTicketIn($queue, 5, now()->subMinute());
+
+    $priority = waitingTicketIn($queue, ['priority' => 20, 'issued_at' => now()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('counts calls made in restricted modes in the fairness history', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    // Three priority calls via priority_only...
+    waitingTicketIn($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(5)]);
+    waitingTicketIn($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(4)]);
+    waitingTicketIn($queue, ['priority' => 10, 'issued_at' => now()->subMinutes(3)]);
+
+    (new CallNextTicket)($queue, $user, CallMode::PriorityOnly);
+    (new CallNextTicket)($queue, $user, CallMode::PriorityOnly);
+    (new CallNextTicket)($queue, $user, CallMode::PriorityOnly);
+
+    // ...then Any must hand the turn to the waiting normal ticket.
+    waitingTicketIn($queue, ['priority' => 20, 'issued_at' => now()->subMinutes(2)]);
+    $normal = waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subHour()]);
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($called->is($normal))->toBeTrue();
+});
+
+it('ignores fairness in priority_only mode', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    calledTicketIn($queue, 10, now()->subMinutes(3));
+    calledTicketIn($queue, 10, now()->subMinutes(2));
+    calledTicketIn($queue, 5, now()->subMinute());
+
+    $priority = waitingTicketIn($queue, ['priority' => 20, 'issued_at' => now()]);
+    waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subHour()]);
+
+    $called = (new CallNextTicket)($queue, $user, CallMode::PriorityOnly);
+
+    expect($called->is($priority))->toBeTrue();
+});
+
+it('ignores fairness in normal_only mode', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    calledTicketIn($queue, 10, now()->subMinutes(3));
+    calledTicketIn($queue, 10, now()->subMinutes(2));
+    calledTicketIn($queue, 5, now()->subMinute());
+
+    $normal = waitingTicketIn($queue, ['priority' => 0, 'issued_at' => now()->subHour()]);
+
+    $called = (new CallNextTicket)($queue, $user, CallMode::NormalOnly);
+
+    expect($called->is($normal))->toBeTrue();
+});
+
+it('rejects calling from an inactive queue and changes nothing', function () {
+    $user = User::factory()->create();
+    $queue = Queue::factory()->create(['is_active' => true]);
+    $stale = Queue::query()->findOrFail($queue->id);
+
+    $queue->update(['is_active' => false]);
+    $ticket = waitingTicketIn($queue, ['issued_at' => now()]);
+
+    expect(fn () => (new CallNextTicket)($stale, $user))
+        ->toThrow(InactiveQueueException::class);
+
+    expect($ticket->fresh())
+        ->status->toBe(TicketStatus::Waiting)
+        ->called_at->toBeNull()
+        ->called_by_user_id->toBeNull();
+});
+
+it('skips a candidate called concurrently after the candidates were listed', function () {
+    $user = User::factory()->create();
+    $concurrentAttendant = User::factory()->create();
+    $queue = Queue::factory()->create();
+
+    $raced = waitingTicketIn($queue, ['issued_at' => now()->subMinutes(2)]);
+    $next = waitingTicketIn($queue, ['issued_at' => now()->subMinute()]);
+    waitingTicketIn($queue, ['issued_at' => now()]);
+
+    // Simulate Ticket::call() winning the race between the moment the
+    // candidate list is built and the candidate row is locked (it does not
+    // take the queue lock). The tamper runs once, right after the action's
+    // candidate listing query, inside the same transaction.
+    $tampered = false;
+    DB::listen(function (QueryExecuted $query) use (&$tampered, $raced, $concurrentAttendant): void {
+        if ($tampered || ! str_contains($query->sql, 'select "id" from "tickets"')) {
+            return;
+        }
+
+        $tampered = true;
+
+        Ticket::query()->whereKey($raced->id)->update([
+            'status' => TicketStatus::Called->value,
+            'called_at' => now(),
+            'called_by_user_id' => $concurrentAttendant->id,
+        ]);
+    });
+
+    $called = (new CallNextTicket)($queue, $user);
+
+    expect($tampered)
+        ->toBeTrue()
+        ->and($called->is($next))->toBeTrue()
+        ->and($called->called_by_user_id)->toBe($user->id)
+        ->and($raced->fresh()->called_by_user_id)->toBe($concurrentAttendant->id);
+});
