index 0000000..0a1665c
--- /dev/null
+++ b/app/Actions/CallNextTicket.php
@@ -0,0 +1,163 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /**
+     * Call the next waiting ticket of a queue, deterministically.
+     *
+     * Candidates are waiting tickets of the given queue ordered by higher
+     * priority first, then oldest `issued_at`, then lowest id. `Any` applies
+     * the fairness rule (a normal ticket cannot wait behind 3 consecutive
+     * priority calls); `PriorityOnly`/`NormalOnly` restrict the pool and
+     * ignore fairness.
+     *
+     * Caller is trusted: no authorization happens here. The queue row is
+     * locked (state read fresh from the database, not from the possibly
+     * stale model instance) and each candidate row is locked and re-checked
+     * before the call, so a ticket already called concurrently through
+     * `Ticket::call()` — which does not lock the queue — is skipped.
+     *
+     * @throws InactiveQueueException when the queue is inactive
+     * @throws NoWaitingTicketsException when no ticket is eligible for the mode
+     */
+    public function __invoke(
+        Queue $queue,
+        User $calledBy,
+        CallMode $mode = CallMode::Any,
+    ): Ticket {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Lock the queue row so the state check and candidate selection
+            // are serialized against issuance, deactivation and other
+            // call-next transactions.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call the next ticket of an inactive queue.');
+            }
+
+            foreach (self::candidateIds($lockedQueue->id, $mode) as $candidateId) {
+                // Lock the candidate row and re-check it: Ticket::call() does
+                // not lock the queue row, so a waiting candidate may have been
+                // called concurrently since the list above was built.
+                $ticket = Ticket::query()
+                    ->whereKey($candidateId)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+
+            throw new NoWaitingTicketsException(sprintf(
+                'No waiting ticket is eligible to call in queue [%s] with mode [%s].',
+                $lockedQueue->id,
+                $mode->value,
+            ));
+        });
+    }
+
+    /**
+     * Ordered waiting candidate ids for the mode, best candidate first.
+     *
+     * @return list<int>
+     */
+    private static function candidateIds(int $queueId, CallMode $mode): array
+    {
+        $candidates = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting);
+
+        $ordered = match ($mode) {
+            CallMode::PriorityOnly => $candidates
+                ->where('priority', '>', 0)
+                ->orderByDesc('priority')
+                ->orderBy('issued_at')
+                ->orderBy('id'),
+            CallMode::NormalOnly => $candidates
+                ->where('priority', 0)
+                ->orderBy('issued_at')
+                ->orderBy('id'),
+            CallMode::Any => self::applyFairness($candidates, $queueId),
+        };
+
+        return $ordered->pluck('id')->all();
+    }
+
+    /**
+     * Full ordering, restricted to normal tickets when fairness demands it.
+     *
+     * Fairness: when the last 3 tickets called in the queue (most recent
+     * first by `called_at`, then by `id`) are all priority tickets and at
+     * least one normal ticket is waiting, only normal tickets are eligible —
+     * the oldest normal is called. Any mode of call feeds this history, and
+     * a normal call naturally resets the streak. Without a waiting normal,
+     * priority tickets keep being called.
+     *
+     * @param  Builder<Ticket>  $candidates
+     * @return Builder<Ticket>
+     */
+    private static function applyFairness($candidates, int $queueId)
+    {
+        if (self::fairnessRestrictsToNormals($queueId)) {
+            return $candidates
+                ->where('priority', 0)
+                ->orderBy('issued_at')
+                ->orderBy('id');
+        }
+
+        return $candidates
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id');
+    }
+
+    /**
+     * Whether the fairness rule forces the next call to be a normal ticket.
+     */
+    private static function fairnessRestrictsToNormals(int $queueId): bool
+    {
+        $lastCalledPriorities = Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(3)
+            ->pluck('priority');
+
+        $threeConsecutivePriorityCalls = $lastCalledPriorities->count() === 3
+            && $lastCalledPriorities->every(fn (mixed $priority): bool => (int) $priority > 0);
+
+        if (! $threeConsecutivePriorityCalls) {
+            return false;
+        }
+
+        return Ticket::query()
+            ->where('queue_id', $queueId)
+            ->where('status', TicketStatus::Waiting)
+            ->where('priority', 0)
+            ->exists();
+    }
+}
