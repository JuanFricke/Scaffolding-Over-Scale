+<?php
+
+namespace App\Http\Controllers;
+
+use App\Http\Controllers\Controller;
+
+use App\Models\Entity;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Redirect;
+
+class EntityPickController extends Controller
+{
+    public function pick(Request $request, Entity $entity)
+    {
+        $user = $request->user();
+        if (! $entity->memberships()->where('user_id', $user->id)->exists()) {
+            abort(403);
+        }
+        session(['current_entity_id' => $entity->id]);
+        Log::channel('audit')->info('Entity picked', [
+            'user_id' => $user->id,
+            'entity_id' => $entity->id,
+        ]);
+        return Redirect::route('entity.dashboard', $entity);
+    }
+}
