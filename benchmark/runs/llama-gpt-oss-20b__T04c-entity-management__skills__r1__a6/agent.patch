+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Log;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+use App\Models\User;
+
+class Members extends Component
+{
+    public Entity $entity;
+    #[Validate('required|email:strict')]
+    public string $email = '';
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('view', $entity);
+        $this->entity = $entity;
+    }
+
+    public function addMember(): void
+    {
+        $validated = $this->validate();
+        $user = \
+            \
+            \App\Models\User::where('email', $validated['email'])->first();
+        if (! $user) {
+            $this->addError('email', __('validation.exists', ['attribute' => 'email']));
+            return;
+        }
+        if ($this->entity->memberships()->where('user_id', $user->id)->exists()) {
+            $this->addError('email', __('validation.unique', ['attribute' => 'email']));
+            return;
+        }
+        $this->entity->memberships()->create([
+            'user_id' => $user->id,
+            'role' => UserRole::Employee->value,
+        ]);
+        Log::channel('audit')->info('Member added', [
+            'user_id' => Auth::id(),
+            'entity_id' => $this->entity->id,
+            'member_user_id' => $user->id,
+        ]);
+    }
+
+    public function assignRole(int $membershipId, string $role): void
+    {
+        if (! in_array($role, array_map(fn($r) => $r->value, UserRole::manageable()))) {
+            $this->addError('role', __('validation.in', ['attribute' => 'role']));
+            return;
+        }
+        $membership = EntityMembership::findOrFail($membershipId);
+        $this->authorize('assignRole', $membership);
+        $membership->role = $role;
+        $membership->save();
+        Log::channel('audit')->info('Member role assigned', [
+            'user_id' => Auth::id(),
+            'membership_id' => $membershipId,
+            'new_role' => $role,
+        ]);
+    }
+
+    public function removeMember(int $membershipId): void
+    {
+        $membership = EntityMembership::findOrFail($membershipId);
+        $this->authorize('delete', $membership);
+        // Prevent removing owner
+        if ($membership->role === UserRole::Owner->value) {
+            abort(403);
+        }
+        // Prevent removing last manager
+        $managerCount = $this->entity->memberships()
+            ->whereIn('role', [UserRole::Owner->value, UserRole::Admin->value])
+            ->count();
+        if ($membership->role === UserRole::Admin->value && $managerCount <= 1) {
+            abort(403);
+        }
+        $membership->delete();
+        Log::channel('audit')->info('Member removed', [
+            'user_id' => Auth::id(),
+            'membership_id' => $membershipId,
+        ]);
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.members', ['entity' => $this->entity]);
+    }
+}
