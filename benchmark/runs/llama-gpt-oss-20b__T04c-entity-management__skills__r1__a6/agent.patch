+<?php
+
+namespace App\Livewire\Entity;
+
+use App\Models\Entity;
+
+use App\Models\Entity;
+use App\Models\EntityMembership;
+use App\Models\UserRole;
+use Illuminate\Contracts\View\View;
+use Illuminate\Support\Facades\Auth;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Redirect;
+use Illuminate\Support\Facades\Session;
+use Illuminate\Support\Facades\DB;
+use Livewire\Attributes\Validate;
+use Livewire\Component;
+
+class Settings extends Component
+{
+    public Entity $entity;
+        public string $name = '';
+    public string $slug = '';
+    public ?int $targetMembershipId = null;
+
+    public function mount(Entity $entity): void
+    {
+        $this->authorize('manageSettings', $entity);
+        $this->entity = $entity;
+        $this->name = $entity->name;
+        $this->slug = $entity->slug;
+    }
+
+    public function save(): void
+    {
+        $validated = $this->validate([
+            'name' => 'required|string|max:255',
+            'slug' => 'required|string|max:255|unique:entities,slug,' . $this->entity->id,
+        ]);
+        $this->entity->update([
+            'name' => $validated['name'],
+            'slug' => $validated['slug'],
+        ]);
+        Log::channel('audit')->info('Entity updated', [
+            'user_id' => Auth::id(),
+            'entity_id' => $this->entity->id,
+        ]);
+        $this->redirect(route('entity.dashboard', $this->entity));
+    }
+
+    public function delete(): void
+    {
+        $entityId = $this->entity->id;
+        $this->entity->delete();
+        $this->entity->memberships()->delete();
+        if (session('current_entity_id') === $entityId) {
+            session()->forget('current_entity_id');
+        }
+        Log::channel('audit')->info('Entity deleted', [
+            'user_id' => Auth::id(),
+            'entity_id' => $entityId,
+        ]);
+        return redirect()->route('home');
+    }
+
+    public function transfer(): void
+    {
+        $membership = EntityMembership::findOrFail($this->targetMembershipId);
+        if ($membership->entity_id !== $this->entity->id) {
+            abort(403);
+        }
+        if ($membership->role !== UserRole::Admin->value) {
+            abort(403);
+        }
+        if ($membership->user_id === Auth::id()) {
+            abort(403);
+        }
+        DB::transaction(function () use ($membership) {
+            $currentOwner = $this->entity->memberships()->where('role', UserRole::Owner->value)->first();
+            $currentOwner->role = UserRole::Admin->value;
+            $currentOwner->save();
+            $membership->role = UserRole::Owner->value;
+            $membership->save();
+        });
+        Log::channel('audit')->info('Entity ownership transferred', [
+            'user_id' => Auth::id(),
+            'entity_id' => $this->entity->id,
+            'new_owner_user_id' => $membership->user_id,
+        ]);
+        $this->redirect(route('entity.dashboard', $this->entity));
+    }
+
+    public function render(): View
+    {
+        return view('livewire.entity.settings', ['entity' => $this->entity]);
+    }
+}
