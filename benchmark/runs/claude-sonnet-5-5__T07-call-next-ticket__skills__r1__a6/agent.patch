index 0000000..ed92b9a
--- /dev/null
+++ b/app/Actions/CallNextTicket.php
@@ -0,0 +1,113 @@
+<?php
+
+namespace App\Actions;
+
+use App\Enums\CallMode;
+use App\Enums\TicketStatus;
+use App\Exceptions\InactiveQueueException;
+use App\Exceptions\NoWaitingTicketsException;
+use App\Models\Queue;
+use App\Models\Ticket;
+use App\Models\User;
+use Illuminate\Database\Eloquent\Builder;
+use Illuminate\Support\Facades\DB;
+
+class CallNextTicket
+{
+    /** Consecutive priority calls after which a waiting normal ticket goes next. */
+    private const FAIRNESS_STREAK = 3;
+
+    /**
+     * Call the next waiting ticket of the queue for the requested mode.
+     *
+     * Trusted caller: no authorization here. Throws InactiveQueueException
+     * when the queue is inactive and NoWaitingTicketsException when no
+     * ticket is eligible for the mode.
+     */
+    public function __invoke(Queue $queue, User $calledBy, CallMode $mode = CallMode::Any): Ticket
+    {
+        return DB::transaction(function () use ($queue, $calledBy, $mode): Ticket {
+            // Lock the queue row and read state from the DB, not from the
+            // (possibly stale) passed instance.
+            $lockedQueue = Queue::query()
+                ->whereKey($queue->id)
+                ->lockForUpdate()
+                ->firstOrFail();
+
+            if (! $lockedQueue->is_active) {
+                throw new InactiveQueueException('Cannot call a ticket from an inactive queue.');
+            }
+
+            // Ticket::call() does not lock the queue, so a candidate may be
+            // called concurrently: re-check under a row lock and move on.
+            $skipped = [];
+
+            while ($candidate = $this->pick($lockedQueue, $mode, $skipped)) {
+                $ticket = Ticket::query()
+                    ->whereKey($candidate->id)
+                    ->lockForUpdate()
+                    ->first();
+
+                if ($ticket === null || $ticket->status !== TicketStatus::Waiting) {
+                    $skipped[] = $candidate->id;
+
+                    continue;
+                }
+
+                $ticket->status = TicketStatus::Called;
+                $ticket->called_at = now();
+                $ticket->called_by_user_id = $calledBy->id;
+                $ticket->save();
+
+                return $ticket;
+            }
+
+            throw new NoWaitingTicketsException('No waiting ticket is eligible to be called.');
+        });
+    }
+
+    /**
+     * @param  list<int>  $skipped
+     */
+    private function pick(Queue $queue, CallMode $mode, array $skipped): ?Ticket
+    {
+        $waiting = fn (): Builder => Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Waiting)
+            ->whereNotIn('id', $skipped);
+
+        $query = match ($mode) {
+            CallMode::PriorityOnly => $waiting()->where('priority', '>', 0),
+            CallMode::NormalOnly => $waiting()->where('priority', 0),
+            CallMode::Any => $this->mustCallNormal($queue, $waiting())
+                ? $waiting()->where('priority', 0)
+                : $waiting(),
+        };
+
+        return $query
+            ->orderByDesc('priority')
+            ->orderBy('issued_at')
+            ->orderBy('id')
+            ->first();
+    }
+
+    /**
+     * Fairness: the last 3 calls were all priority and a normal ticket waits.
+     *
+     * @param  Builder<Ticket>  $waiting
+     */
+    private function mustCallNormal(Queue $queue, Builder $waiting): bool
+    {
+        $recent = Ticket::query()
+            ->where('queue_id', $queue->id)
+            ->where('status', TicketStatus::Called)
+            ->orderByDesc('called_at')
+            ->orderByDesc('id')
+            ->limit(self::FAIRNESS_STREAK)
+            ->pluck('priority');
+
+        return $recent->count() === self::FAIRNESS_STREAK
+            && $recent->every(fn (int $priority): bool => $priority > 0)
+            && (clone $waiting)->where('priority', 0)->exists();
+    }
+}
