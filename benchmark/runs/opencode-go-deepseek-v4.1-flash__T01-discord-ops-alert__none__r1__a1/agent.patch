diff --git a/app/Ops/DiscordOpsAlert.php b/app/Ops/DiscordOpsAlert.php
new file mode 100644
index 0000000..e8ece44
--- /dev/null
+++ b/app/Ops/DiscordOpsAlert.php
@@ -0,0 +1,143 @@
+<?php
+
+namespace App\Ops;
+
+use Illuminate\Support\Facades\Http;
+use Illuminate\Support\Facades\Log;
+use Throwable;
+
+class DiscordOpsAlert
+{
+    /**
+     * Discord rejects messages longer than 2000 characters. Leave a little
+     * headroom for any future formatting added around the message.
+     */
+    private const MAX_LENGTH = 1800;
+
+    /**
+     * Send one human-pageable alert to the configured Discord webhook.
+     */
+    public function send(string $title, string $message, array $context = []): void
+    {
+        $webhookUrl = config('services.discord.webhook_url');
+
+        if ($webhookUrl === null || $webhookUrl === '') {
+            return;
+        }
+
+        try {
+            $response = Http::timeout(5)
+                ->asJson()
+                ->post($webhookUrl, [
+                    'content' => $this->format($title, $message, $context),
+                ]);
+
+            if (! $response->successful()) {
+                Log::error('Discord ops alert failed', [
+                    'status' => $response->status(),
+                ]);
+            }
+        } catch (Throwable $exception) {
+            Log::error('Discord ops alert failed', [
+                'error' => $this->scrub($exception->getMessage(), $webhookUrl),
+            ]);
+        }
+    }
+
+    /**
+     * Build the Discord message text, including redacted context lines.
+     */
+    private function format(string $title, string $message, array $context): string
+    {
+        $lines = [$title, $message];
+
+        foreach ($this->redact($context) as $key => $value) {
+            $lines[] = $key.'='.$this->stringify($value);
+        }
+
+        return mb_substr(implode("\n", $lines), 0, self::MAX_LENGTH, 'UTF-8');
+    }
+
+    /**
+     * Redact sensitive keys and bearer credentials recursively.
+     */
+    private function redact(array $context): array
+    {
+        $redacted = [];
+
+        foreach ($context as $key => $value) {
+            if ($this->isSensitiveKey((string) $key)) {
+                $redacted[$key] = '[redacted]';
+
+                continue;
+            }
+
+            if (is_array($value)) {
+                $redacted[$key] = $this->redact($value);
+
+                continue;
+            }
+
+            if (is_string($value) && $this->containsBearerCredential($value)) {
+                $redacted[$key] = '[redacted]';
+
+                continue;
+            }
+
+            $redacted[$key] = $value;
+        }
+
+        return $redacted;
+    }
+
+    private function isSensitiveKey(string $key): bool
+    {
+        return preg_match(
+            '/password|token|secret|authorization|api[\s_-]?key|webhook/i',
+            $key,
+        ) === 1;
+    }
+
+    private function containsBearerCredential(string $value): bool
+    {
+        return preg_match('/bearer\s+\S+/i', $value) === 1;
+    }
+
+    private function stringify(mixed $value): string
+    {
+        if (is_array($value)) {
+            $encoded = json_encode($value);
+
+            return $encoded === false ? '[unserializable]' : $encoded;
+        }
+
+        if (is_bool($value)) {
+            return $value ? 'true' : 'false';
+        }
+
+        if ($value === null) {
+            return 'null';
+        }
+
+        if (is_scalar($value)) {
+            return (string) $value;
+        }
+
+        $encoded = json_encode($value);
+
+        return $encoded === false ? '[unserializable]' : $encoded;
+    }
+
+    /**
+     * Keep the webhook token out of log files, including exception messages
+     * that often echo the request URL.
+     */
+    private function scrub(string $message, string $webhookUrl): string
+    {
+        if ($webhookUrl === '') {
+            return $message;
+        }
+
+        return str_replace($webhookUrl, '[redacted]', $message);
+    }
+}
